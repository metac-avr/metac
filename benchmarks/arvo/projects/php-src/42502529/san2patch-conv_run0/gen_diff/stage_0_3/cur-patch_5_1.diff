--- a/Zend/zend_hash.c
+++ b/Zend/zend_hash.c
@@ -1829 +1829,2 @@ ZEND_API void ZEND_FASTCALL zend_hash_graceful_reverse_destroy(HashTable *ht)
-		p--;
+// FIXME: Crash CWE-416: Use After Free
+ 		p--;
@@ -1831 +1832,7 @@ ZEND_API void ZEND_FASTCALL zend_hash_graceful_reverse_destroy(HashTable *ht)
-		_zend_hash_del_el(ht, HT_IDX_TO_HASH(idx), p);
+		if (Z_REFCOUNTED(p->val) && (GC_FLAGS(Z_COUNTED(p->val)) & GC_IMMUTABLE)) {
+			_zend_hash_del_el(ht, HT_IDX_TO_HASH(idx), p);
+		} else if (Z_REFCOUNTED(p->val) && !(GC_FLAGS(Z_COUNTED(p->val)) & GC_PURPLE)) {
+			continue;
+		} else {
+			_zend_hash_del_el(ht, HT_IDX_TO_HASH(idx), p);
+		}
