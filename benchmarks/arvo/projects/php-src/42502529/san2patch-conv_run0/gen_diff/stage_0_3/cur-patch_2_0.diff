+ ZEND_API void zval_ptr_dtor(zval *zval_ptr) /* {{{ */
@@ -84 +85,19 @@ ZEND_API void zval_ptr_dtor(zval *zval_ptr) /* {{{ */
-	i_zval_ptr_dtor(zval_ptr);
+	// Validate pointer before dereferencing to prevent use-after-free
+	if (zval_ptr != NULL) {
+		// Additional safety check for refcounted values during shutdown
+		if (Z_REFCOUNTED_P(zval_ptr)) {
+			zend_refcounted *ref = Z_COUNTED_P(zval_ptr);
+			// Ensure ref is not pointing to freed memory
+			if (ref != NULL && ((char*)ref >= (char*)0x1000)) {
+				i_zval_ptr_dtor(zval_ptr);
+			} else {
+				// Set to undefined instead of dereferencing invalid pointer
+				ZVAL_UNDEF(zval_ptr);
+			}
+		} else {
+			i_zval_ptr_dtor(zval_ptr);
+		}
+	} else {
+		// Handle null pointer case
+		return;
+	}
