diff --git a/Zend/zend_hash.c b/Zend/zend_hash.c
index 8ee292106a6..f7b660f1462 100644
--- a/Zend/zend_hash.c
+++ b/Zend/zend_hash.c
@@ -1352,3 +1352,8 @@ static zend_always_inline void _zend_hash_del_el_ex(HashTable *ht, uint32_t idx,
-		ZVAL_COPY_VALUE(&tmp, &p->val);
-		ZVAL_UNDEF(&p->val);
-		ht->pDestructor(&tmp);
+		/* Prevent UAF by checking if p->val points to valid memory */
+		if (&p->val && Z_TYPE(p->val) != IS_UNDEF) {
+			ZVAL_COPY_VALUE(&tmp, &p->val);
+			ZVAL_UNDEF(&p->val);
+			ht->pDestructor(&tmp);
+		} else {
+			ZVAL_UNDEF(&p->val);
+		}
