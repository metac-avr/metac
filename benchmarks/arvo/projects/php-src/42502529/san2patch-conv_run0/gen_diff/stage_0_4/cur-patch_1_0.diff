+	if (zval_ptr != NULL) {
+		/* Validate that the zval is not already destroyed */
+		if (Z_REFCOUNTED_P(zval_ptr)) {
+			zend_refcounted *ref = Z_COUNTED_P(zval_ptr);
+			if (ref != NULL && GC_REFCount(ref) > 0) {
+				i_zval_ptr_dtor(zval_ptr);
+			} else {
+				/* Clear the zval to prevent use-after-free */
+				ZVAL_UNDEF(zval_ptr);
+			}
+		} else {
+			i_zval_ptr_dtor(zval_ptr);
+		}
+	} else {
+		/* Handle NULL pointer gracefully */
+		return;
+	}
