diff --git a/Zend/zend_hash.c b/Zend/zend_hash.c
index 24c4ced4b43..bbde1b931c7 100644
--- a/Zend/zend_hash.c
+++ b/Zend/zend_hash.c
@@ -1750,4 +1750,8 @@ ZEND_API void ZEND_FASTCALL zend_array_destroy(HashTable *ht)
-
-			do {
-				i_zval_ptr_dtor(zv);
-			} while (++zv != end);
+// FIXME: Crash CWE-416: Use After Free
+ 
+			while (zv != end) {
+				if (zv) {
+					i_zval_ptr_dtor(zv);
+				}
+				zv++;
+			}
@@ -1759,3 +1763,6 @@ ZEND_API void ZEND_FASTCALL zend_array_destroy(HashTable *ht)
-				do {
-					i_zval_ptr_dtor(&p->val);
-				} while (++p != end);
+				while (p != end) {
+					if (p) {
+						i_zval_ptr_dtor(&p->val);
+					}
+					p++;
+				}
@@ -1763,4 +1770,6 @@ ZEND_API void ZEND_FASTCALL zend_array_destroy(HashTable *ht)
-				do {
-					i_zval_ptr_dtor(&p->val);
-					if (EXPECTED(p->key)) {
-						zend_string_release_ex(p->key, 0);
+				while (p != end) {
+					if (p && Z_TYPE(p->val) != IS_UNDEF) {
+						i_zval_ptr_dtor(&p->val);
+						if (EXPECTED(p->key)) {
+							zend_string_release_ex(p->key, 0);
+						}
@@ -1768 +1777,2 @@ ZEND_API void ZEND_FASTCALL zend_array_destroy(HashTable *ht)
-				} while (++p != end);
+					p++;
+				}
@@ -1770,2 +1780,2 @@ ZEND_API void ZEND_FASTCALL zend_array_destroy(HashTable *ht)
-				do {
-					if (EXPECTED(Z_TYPE(p->val) != IS_UNDEF)) {
+				while (p != end) {
+					if (p && EXPECTED(Z_TYPE(p->val) != IS_UNDEF)) {
@@ -1777 +1787,2 @@ ZEND_API void ZEND_FASTCALL zend_array_destroy(HashTable *ht)
-				} while (++p != end);
+					p++;
+				}
