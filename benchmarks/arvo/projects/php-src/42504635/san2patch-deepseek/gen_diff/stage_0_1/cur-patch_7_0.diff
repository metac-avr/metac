diff --git a/Zend/zend_execute.c b/Zend/zend_execute.c
index dce0f32e835..04f50141427 100644
--- a/Zend/zend_execute.c
+++ b/Zend/zend_execute.c
@@ -1410,0 +1411,5 @@ static zend_always_inline int zend_binary_op(zval *ret, zval *op1, zval *op2 OPL
+	if (opcode == ZEND_CONCAT && op1 && Z_TYPE_P(op1) == IS_STRING && Z_REFCOUNTED_P(op1) && Z_REFCOUNT_P(op1) > 1) {
+		zend_string *str = zend_string_copy(Z_STR_P(op1));
+		zend_string_release(str);
+	}
+
