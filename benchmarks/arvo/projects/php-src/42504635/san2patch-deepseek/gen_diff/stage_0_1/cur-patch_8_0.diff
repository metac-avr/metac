diff --git a/Zend/zend_execute.c b/Zend/zend_execute.c
index dce0f32e835..6d76af58cbb 100644
--- a/Zend/zend_execute.c
+++ b/Zend/zend_execute.c
@@ -1410,0 +1411,6 @@ static zend_always_inline int zend_binary_op(zval *ret, zval *op1, zval *op2 OPL
+	if (opcode == ZEND_CONCAT && op1 && Z_TYPE_P(op1) == IS_STRING && Z_REFCOUNTED_P(op1) && Z_REFCOUNT_P(op1) > 1) {
+		zend_string *str = Z_STR_P(op1);
+		GC_ADDREF(str);
+		zend_string_release(str);
+	}
+
diff --git a/Zend/zend_hash.c b/Zend/zend_hash.c
index 24c4ced4b43..5c9ed72dd32 100644
--- a/Zend/zend_hash.c
+++ b/Zend/zend_hash.c
@@ -1752 +1752,14 @@ ZEND_API void ZEND_FASTCALL zend_array_destroy(HashTable *ht)
-				i_zval_ptr_dtor(zv);
+				if (Z_TYPE_P(zv) == IS_STRING) {
+					zend_string *str = Z_STR_P(zv);
+					if (!ZSTR_IS_INTERNED(str)) {
+						if (GC_REFCOUNT(str) == 1) {
+							zend_string_release(str);
+						} else {
+							GC_DELREF(str);
+						}
+					} else {
+						zend_string_release(str);
+					}
+				} else {
+					zval_ptr_dtor(zv);
+				}
@@ -1760 +1773 @@ ZEND_API void ZEND_FASTCALL zend_array_destroy(HashTable *ht)
-					i_zval_ptr_dtor(&p->val);
+					zval_ptr_dtor(&p->val);
@@ -1764 +1777 @@ ZEND_API void ZEND_FASTCALL zend_array_destroy(HashTable *ht)
-					i_zval_ptr_dtor(&p->val);
+					zval_ptr_dtor(&p->val);
@@ -1772 +1785 @@ ZEND_API void ZEND_FASTCALL zend_array_destroy(HashTable *ht)
-						i_zval_ptr_dtor(&p->val);
+						zval_ptr_dtor(&p->val);
