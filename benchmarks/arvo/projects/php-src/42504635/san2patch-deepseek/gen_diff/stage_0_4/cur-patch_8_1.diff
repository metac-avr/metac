@@ -1752 +1752,14 @@ ZEND_API void ZEND_FASTCALL zend_array_destroy(HashTable *ht)
-				i_zval_ptr_dtor(zv);
+				if (EXPECTED(Z_TYPE_P(zv) == IS_STRING)) {
+					zend_string *str = Z_STR_P(zv);
+					if (EXPECTED(GC_REFCOUNT(str) > 0)) {
+						GC_ADDREF(str);
+						zval_ptr_dtor(zv);
+						if (--GC_REFCOUNT(str) == 0) {
+							zend_string_free(str);
+						}
+					} else {
+						ZVAL_UNDEF(zv);
+					}
+				} else {
+					i_zval_ptr_dtor(zv);
+				}
