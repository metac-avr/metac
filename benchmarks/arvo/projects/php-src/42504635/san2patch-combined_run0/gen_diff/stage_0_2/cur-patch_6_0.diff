diff --git a/Zend/zend_variables.c b/Zend/zend_variables.c
index 06483d581df..270234609d8 100644
--- a/Zend/zend_variables.c
+++ b/Zend/zend_variables.c
@@ -55,0 +56 @@ ZEND_API void ZEND_FASTCALL rc_dtor_func(zend_refcounted *p)
+	if (p == NULL) return;
@@ -57 +58 @@ ZEND_API void ZEND_FASTCALL rc_dtor_func(zend_refcounted *p)
-	zend_rc_dtor_func[GC_TYPE(p)](p);
+zend_rc_dtor_func[GC_TYPE(p)](p);
@@ -65,3 +66,5 @@ static void ZEND_FASTCALL zend_string_destroy(zend_string *str)
-	ZEND_ASSERT(GC_REFCOUNT(str) == 0);
-	ZEND_ASSERT(!(GC_FLAGS(str) & IS_STR_PERSISTENT));
-	efree(str);
+	/* Fixed CWE-825: Expired Pointer Dereference - Ensure GC_REFCOUNT is checked before accessing */
+	if (GC_REFCOUNT(str) == 0) {
+		ZEND_ASSERT(!(GC_FLAGS(str) & IS_STR_PERSISTENT));
+		efree(str);
+	}
@@ -77 +79,0 @@ static void ZEND_FASTCALL zend_reference_destroy(zend_reference *ref)
