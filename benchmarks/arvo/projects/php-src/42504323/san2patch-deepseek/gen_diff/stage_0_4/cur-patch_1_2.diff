diff --git a/Zend/zend_opcode.c b/Zend/zend_opcode.c
index ad41b9f699d..eaeab36a0a4 100644
--- a/Zend/zend_opcode.c
+++ b/Zend/zend_opcode.c
@@ -966 +966,56 @@ static void zend_calc_live_ranges(
-	free_alloca(last_use, use_heap);
+ZEND_API void pass_two(zend_op_array *op_array)
+{
+	zend_op *opline, *end;
+
+	if (!ZEND_USER_CODE(op_array->type)) {
+		return;
+	}
+	if (CG(compiler_options) & ZEND_COMPILE_EXTENDED_STMT) {
+		zend_ulong extended_info = 0;
+
+		for (opline = op_array->opcodes; opline < op_array->opcodes + op_array->last; opline++) {
+			if (opline->opcode == ZEND_EXT_STMT) {
+				if (opline->extended_value) {
+					extended_info = opline->extended_value;
+				} else if (extended_info) {
+					opline->extended_value = extended_info;
+				}
+			}
+		}
+	}
+
+	if (CG(compiler_options) & ZEND_COMPILE_HANDLE_OP_ARRAY) {
+		if (op_array->last > 0) {
+			op_array->fn_flags |= ZEND_ACC_DONE_PASS_TWO;
+		}
+		return;
+	}
+
+	if (CG(context).vars_size != op_array->last_var) {
+		op_array->vars = erealloc(op_array->vars, sizeof(zval) * op_array->last_var);
+		CG(context).vars_size = op_array->last_var;
+	}
+
+	op_array->opcodes = (zend_op *) erealloc(op_array->opcodes, sizeof(zend_op) * op_array->last);
+	if (op_array->literals) {
+		op_array->literals = (zval*)erealloc(op_array->literals, sizeof(zval) * op_array->last_literal);
+	}
+	CG(context).opcodes_size = op_array->last;
+	CG(context).literals_size = op_array->last_literal;
+
+	op_array->fn_flags |= ZEND_ACC_DONE_PASS_TWO;
+
+	opline = op_array->opcodes;
+	end = opline + op_array->last;
+	while (opline < end) {
+		if (opline->op1_type == IS_CONST) {
+			ZEND_PASS_TWO_UPDATE_CONSTANT(opline->op1);
+		}
+		if (opline->op2_type == IS_CONST) {
+			ZEND_PASS_TWO_UPDATE_CONSTANT(opline->op2);
+		}
+		if (opline->result_type == IS_CONST) {
+			ZEND_PASS_TWO_UPDATE_CONSTANT(opline->result);
+		}
+		opline++;
+	}
@@ -971 +1025,0 @@ ZEND_API void zend_recalc_live_ranges(
-	/* We assume that we never create live-ranges where there were none before. */
@@ -977,11 +1031 @@ ZEND_API void zend_recalc_live_ranges(
-}
-
-ZEND_API void pass_two(zend_op_array *op_array)
-{
-	zend_op *opline, *end;
-
-	if (!ZEND_USER_CODE(op_array->type)) {
-		return;
-	}
-	if (CG(compiler_options) & ZEND_COMPILE_EXTENDED_STMT) {
-		zend_update_extended_stmts(op_array);
+}		zend_update_extended_stmts(op_array);
