diff --git a/Zend/zend_opcode.c b/Zend/zend_opcode.c
index ad41b9f699d..9871afc759f 100644
--- a/Zend/zend_opcode.c
+++ b/Zend/zend_opcode.c
@@ -966,3 +965,0 @@ static void zend_calc_live_ranges(
-	free_alloca(last_use, use_heap);
-}
-
@@ -976,9 +973,13 @@ ZEND_API void zend_recalc_live_ranges(
-	zend_calc_live_ranges(op_array, needs_live_range);
-}
-
-ZEND_API void pass_two(zend_op_array *op_array)
-{
-	zend_op *opline, *end;
-
-	if (!ZEND_USER_CODE(op_array->type)) {
-		return;
+	uint32_t max_var = 0;
+	zend_op *opline;
+	zend_op *end = op_array->opcodes + op_array->last;
+	for (opline = op_array->opcodes; opline < end; opline++) {
+		if (opline->op1_type == IS_VAR && opline->op1.var > max_var) {
+			max_var = opline->op1.var;
+		}
+		if (opline->op2_type == IS_VAR && opline->op2.var > max_var) {
+			max_var = opline->op2.var;
+		}
+		if (opline->result_type == IS_VAR && opline->result.var > max_var) {
+			max_var = opline->result.var;
+		}
@@ -986,2 +987,3 @@ ZEND_API void pass_two(zend_op_array *op_array)
-	if (CG(compiler_options) & ZEND_COMPILE_EXTENDED_STMT) {
-		zend_update_extended_stmts(op_array);
+	op_array->last_var = max_var;
+	zend_calc_live_ranges(op_array, needs_live_range);
+}		zend_update_extended_stmts(op_array);
