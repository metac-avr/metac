diff --git a/Zend/zend_opcode.c b/Zend/zend_opcode.c
index ad41b9f699d..9a249ce32df 100644
--- a/Zend/zend_opcode.c
+++ b/Zend/zend_opcode.c
@@ -975,0 +976,22 @@ ZEND_API void zend_recalc_live_ranges(
+	uint32_t max_var = op_array->last_var;
+	for (uint32_t i = 0; i < op_array->last; i++) {
+		zend_op *opline = &op_array->opcodes[i];
+		if (opline->op1_type == IS_VAR) {
+			uint32_t var = opline->op1.var;
+			if (var < max_var) {
+				max_var = var;
+			}
+		}
+		if (opline->op2_type == IS_VAR) {
+			uint32_t var = opline->op2.var;
+			if (var < max_var) {
+				max_var = var;
+			}
+		}
+		if (opline->result_type == IS_VAR) {
+			uint32_t var = opline->result.var;
+			if (var < max_var) {
+				max_var = var;
+			}
+		}
+	}
