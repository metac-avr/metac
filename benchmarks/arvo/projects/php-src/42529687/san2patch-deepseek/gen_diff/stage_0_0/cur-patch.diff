diff --git a/Zend/zend_vm_execute.h b/Zend/zend_vm_execute.h
index c352902bbe9..86738854966 100644
--- a/Zend/zend_vm_execute.h
+++ b/Zend/zend_vm_execute.h
@@ -3258,16 +3258,22 @@ static ZEND_OPCODE_HANDLER_RET ZEND_FASTCALL ZEND_HANDLE_EXCEPTION_SPEC_HANDLER(
-		switch (throw_op->opcode) {
-			case ZEND_ADD_ARRAY_ELEMENT:
-			case ZEND_ADD_ARRAY_UNPACK:
-			case ZEND_ROPE_INIT:
-			case ZEND_ROPE_ADD:
-				break; /* exception while building structures, live range handling will free those */
-
-			case ZEND_FETCH_CLASS:
-			case ZEND_DECLARE_ANON_CLASS:
-				break; /* return value is zend_class_entry pointer */
-
-			default:
-				/* smart branch opcodes may not initialize result */
-				if (!zend_is_smart_branch(throw_op)) {
-					zval_ptr_dtor_nogc(EX_VAR(throw_op->result.var));
-				}
+		zval *result = EX_VAR(throw_op->result.var);
+		if (UNEXPECTED(Z_TYPE_P(result) == IS_UNDEF)) {
+			/* Result slot was not initialized; do not destroy it. */
+		} else {
+			switch (throw_op->opcode) {
+				case ZEND_ADD_ARRAY_ELEMENT:
+				case ZEND_ADD_ARRAY_UNPACK:
+				case ZEND_ROPE_INIT:
+				case ZEND_ROPE_ADD:
+					break; /* exception while building structures, live range handling will free those */
+
+				case ZEND_FETCH_CLASS:
+				case ZEND_DECLARE_ANON_CLASS:
+					break; /* return value is zend_class_entry pointer */
+
+				default:
+// FIXME: Crash CWE-825: Expired Pointer Dereference
+ 				/* smart branch opcodes may not initialize result */
+					if (!zend_is_smart_branch(throw_op)) {
+						zval_ptr_dtor_nogc(result);
+					}
+			}
