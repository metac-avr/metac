diff --git a/Zend/zend_vm_execute.h b/Zend/zend_vm_execute.h
index c352902bbe9..bfcb4e13d50 100644
--- a/Zend/zend_vm_execute.h
+++ b/Zend/zend_vm_execute.h
@@ -3235 +3235,7 @@ static ZEND_OPCODE_HANDLER_RET ZEND_FASTCALL ZEND_HANDLE_EXCEPTION_SPEC_HANDLER(
-					zval_ptr_dtor(EX_VAR(EX(func)->op_array.opcodes[i].op1.var));
+					zval *var_ptr = EX_VAR(EX(func)->op_array.opcodes[i].op1.var);
+					if (var_ptr) {
+						ZVAL_DEREF(var_ptr);
+						if (Z_REFCOUNTED_P(var_ptr) && !Z_ISREF_P(var_ptr)) {
+							zval_ptr_dtor(var_ptr);
+						}
+					}
@@ -3270 +3276,2 @@ static ZEND_OPCODE_HANDLER_RET ZEND_FASTCALL ZEND_HANDLE_EXCEPTION_SPEC_HANDLER(
-				/* smart branch opcodes may not initialize result */
+// FIXME: Crash CWE-825: Expired Pointer Dereference
+ 				/* smart branch opcodes may not initialize result */
@@ -3272 +3279,8 @@ static ZEND_OPCODE_HANDLER_RET ZEND_FASTCALL ZEND_HANDLE_EXCEPTION_SPEC_HANDLER(
-					zval_ptr_dtor_nogc(EX_VAR(throw_op->result.var));
+					zval *result_var = EX_VAR(throw_op->result.var);
+					if (result_var && Z_REFCOUNTED_P(result_var)) {
+						GC_PROTECT_RECURSION_P(result_var);
+						if (!GC_IS_RECURSIVE_P(result_var)) {
+							zval_ptr_dtor_nogc(result_var);
+						}
+						GC_UNPROTECT_RECURSION_P(result_var);
+					}
