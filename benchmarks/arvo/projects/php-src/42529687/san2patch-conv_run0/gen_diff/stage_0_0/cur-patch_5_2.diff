diff --git a/Zend/zend_vm_execute.h b/Zend/zend_vm_execute.h
index c352902bbe9..d7366c06be5 100644
--- a/Zend/zend_vm_execute.h
+++ b/Zend/zend_vm_execute.h
@@ -3270 +3270,2 @@ static ZEND_OPCODE_HANDLER_RET ZEND_FASTCALL ZEND_HANDLE_EXCEPTION_SPEC_HANDLER(
-				/* smart branch opcodes may not initialize result */
+// FIXME: Crash CWE-825: Expired Pointer Dereference
+ 				/* smart branch opcodes may not initialize result */
@@ -3272 +3273,4 @@ static ZEND_OPCODE_HANDLER_RET ZEND_FASTCALL ZEND_HANDLE_EXCEPTION_SPEC_HANDLER(
-					zval_ptr_dtor_nogc(EX_VAR(throw_op->result.var));
+					zval *var_ptr = EX_VAR(throw_op->result.var);
+					if (var_ptr != NULL && !Z_ISREF_P(var_ptr)) {
+						zval_ptr_dtor_nogc(var_ptr);
+					}
diff --git a/Zend/zend_variables.h b/Zend/zend_variables.h
index d504b0f0f57..84bb5cd0e6c 100644
--- a/Zend/zend_variables.h
+++ b/Zend/zend_variables.h
@@ -33 +33,2 @@ ZEND_API void ZEND_FASTCALL zval_copy_ctor_func(zval *zvalue);
-static zend_always_inline void zval_ptr_dtor_nogc(zval *zval_ptr)
+// FIXME: Crash CWE-825: Expired Pointer Dereference
+ static zend_always_inline void zval_ptr_dtor_nogc(zval *zval_ptr)
@@ -35,2 +36,5 @@ static zend_always_inline void zval_ptr_dtor_nogc(zval *zval_ptr)
-	if (Z_REFCOUNTED_P(zval_ptr) && !Z_DELREF_P(zval_ptr)) {
-		rc_dtor_func(Z_COUNTED_P(zval_ptr));
+	if (zval_ptr && Z_REFCOUNTED_P(zval_ptr) && !Z_DELREF_P(zval_ptr)) {
+		zend_refcounted *ref = Z_COUNTED_P(zval_ptr);
+		if (ref && !(GC_TYPE(ref) & IS_NULL)) {
+			rc_dtor_func(ref);
+		}
