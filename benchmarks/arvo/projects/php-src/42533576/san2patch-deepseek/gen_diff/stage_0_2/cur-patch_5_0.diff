diff --git a/Zend/zend_vm_execute.h b/Zend/zend_vm_execute.h
index 4714ab37101..771ae3c5171 100644
--- a/Zend/zend_vm_execute.h
+++ b/Zend/zend_vm_execute.h
@@ -3228,0 +3229,11 @@ static ZEND_OPCODE_HANDLER_RET ZEND_FASTCALL ZEND_HANDLE_EXCEPTION_SPEC_HANDLER(
+	uint32_t max_args = 0;
+	if (EX(func)->op_array.fn_flags & ZEND_ACC_HAS_TYPE_HINTS) {
+		if (EX(call)) {
+			max_args = ZEND_CALL_NUM_ARGS(EX(call));
+		}
+	} else {
+		max_args = EX(func)->op_array.num_args;
+	}
+	if (EX_NUM_ARGS() > max_args) {
+		EX_NUM_ARGS() = max_args;
+	}
