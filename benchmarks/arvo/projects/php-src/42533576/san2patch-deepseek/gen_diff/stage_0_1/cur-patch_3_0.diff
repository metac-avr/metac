@@ -4343,3 +4343,9 @@ static void cleanup_unfinished_calls(zend_execute_data *execute_data, uint32_t o
-			}
-
-			zend_vm_stack_free_args(EX(call));
+				if (!(ZEND_CALL_INFO(call) & ZEND_CALL_TOP)) {
+					uint32_t num_args = ZEND_CALL_NUM_ARGS(call);
