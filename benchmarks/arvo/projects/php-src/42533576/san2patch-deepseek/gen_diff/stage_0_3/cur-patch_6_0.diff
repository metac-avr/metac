+// FIXME: Crash CWE-825: Expired Pointer Dereference
+ 	145,146,147,148,149,150,151,152,153,154,155,156,157,158,159,160,
@@ -313 +314,16 @@ static zend_uchar zend_user_opcodes[256] = {0,
-#define SPEC_RULE_OP_DATA      0x00040000
+
+static zend_always_inline bool zend_gc_ptr_is_valid(zend_gc_refcount *gc) {
+	if (UNEXPECTED(!gc)) {
+		return false;
+	}
+	return zend_gc_validate_ptr(gc);
+}
+
+static zend_always_inline void zval_ptr_dtor_nogc(zval *zval_ptr) {
+	if (EXPECTED(Z_REFCOUNTED_P(zval_ptr))) {
+		zend_gc_refcount *gc = Z_COUNTED_P(zval_ptr);
+		if (EXPECTED(zend_gc_ptr_is_valid(gc)) && !Z_DELREF_P(zval_ptr)) {
+			rc_dtor_func(gc);
+		}
+	}
+}#define SPEC_RULE_OP_DATA      0x00040000
