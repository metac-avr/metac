diff --git a/Zend/zend_types.h b/Zend/zend_types.h
index 888c35482a4..078edbcdb3d 100644
--- a/Zend/zend_types.h
+++ b/Zend/zend_types.h
@@ -1256,8 +1255,0 @@ static zend_always_inline uint32_t zval_set_refcount_p(zval* pz, uint32_t rc) {
-	return GC_SET_REFCOUNT(Z_COUNTED_P(pz), rc);
-}
-
-static zend_always_inline uint32_t zval_addref_p(zval* pz) {
-	ZEND_ASSERT(Z_REFCOUNTED_P(pz));
-	return GC_ADDREF(Z_COUNTED_P(pz));
-}
-
@@ -1266,12 +1258,6 @@ static zend_always_inline uint32_t zval_delref_p(zval* pz) {
-	return GC_DELREF(Z_COUNTED_P(pz));
-}
-
-#if SIZEOF_SIZE_T == 4
-# define ZVAL_COPY_VALUE_EX(z, v, gc, t)				\
-	do {												\
-		uint32_t _w2 = v->value.ww.w2;					\
-		Z_COUNTED_P(z) = gc;							\
-		z->value.ww.w2 = _w2;							\
-		Z_TYPE_INFO_P(z) = t;							\
-	} while (0)
-#elif SIZEOF_SIZE_T == 8
+	zend_refcounted *rc = Z_COUNTED_P(pz);
+	if (rc != NULL && GC_TYPE(rc) != 0) {
+		return GC_DELREF(rc);
+	}
+	return 0;
+}#elif SIZEOF_SIZE_T == 8
