diff --git a/Zend/zend_hash.c b/Zend/zend_hash.c
index a52a7fc9691..54cc7c2fe82 100644
--- a/Zend/zend_hash.c
+++ b/Zend/zend_hash.c
@@ -1780,6 +1780,10 @@ ZEND_API void ZEND_FASTCALL zend_array_destroy(HashTable *ht)
-	}
-	SET_INCONSISTENT(HT_DESTROYED);
-	efree(HT_GET_DATA_ADDR(ht));
-free_ht:
-	zend_hash_iterators_remove(ht);
-	FREE_HASHTABLE(ht);
+    }
+    SET_INCONSISTENT(HT_DESTROYED);
+    /* Check for active JIT references before freeing */
+    if (ht->u.flags & HASH_FLAG_JIT_TRACKED) {
+        zend_jit_unregister_array(ht);
+    }
+    efree(HT_GET_DATA_ADDR(ht));
+ free_ht:
+    zend_hash_iterators_remove(ht);
+    FREE_HASHTABLE(ht);
@@ -1790 +1794 @@ ZEND_API void ZEND_FASTCALL zend_hash_clean(HashTable *ht)
