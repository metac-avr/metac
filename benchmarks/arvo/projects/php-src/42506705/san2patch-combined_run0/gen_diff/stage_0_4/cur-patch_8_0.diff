+    }
+    SET_INCONSISTENT(HT_DESTROYED);
+    /* Ensure no active JIT references before deallocation */
+    if (ht->u.v.flags & (HASH_FLAG_PACKED | HASH_FLAG_UNPACKED)) {
+        zend_jit_release_array_references(ht);
+    }
+    efree(HT_GET_DATA_ADDR(ht));
+ free_ht:
+    zend_hash_iterators_remove(ht);
+    FREE_HASHTABLE(ht);
