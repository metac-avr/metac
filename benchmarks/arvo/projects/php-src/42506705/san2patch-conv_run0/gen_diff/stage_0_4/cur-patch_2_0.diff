diff --git a/Zend/zend_vm_execute.h b/Zend/zend_vm_execute.h
index 6a6476b2ce5..e54f7c3d816 100644
--- a/Zend/zend_vm_execute.h
+++ b/Zend/zend_vm_execute.h
@@ -20640,3 +20640,9 @@ static ZEND_OPCODE_HANDLER_RET ZEND_FASTCALL ZEND_INIT_ARRAY_SPEC_TMP_UNUSED_HAN
-		/* Explicitly initialize array as not-packed if flag is set */
-		if (opline->extended_value & ZEND_ARRAY_NOT_PACKED) {
-			zend_hash_real_init_mixed(Z_ARRVAL_P(array));
+		/* Defensive check for valid array reference to prevent use-after-free */
