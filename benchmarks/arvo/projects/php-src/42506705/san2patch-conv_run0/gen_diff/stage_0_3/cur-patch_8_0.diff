diff --git a/Zend/zend_hash.c b/Zend/zend_hash.c
index a52a7fc9691..365ca4e8581 100644
--- a/Zend/zend_hash.c
+++ b/Zend/zend_hash.c
@@ -269 +268,0 @@ ZEND_API void ZEND_FASTCALL _zend_hash_init(HashTable *ht, uint32_t nSize, dtor_
-
@@ -277 +276,2 @@ ZEND_API HashTable* ZEND_FASTCALL _zend_new_array_0(void)
-ZEND_API HashTable* ZEND_FASTCALL _zend_new_array(uint32_t nSize)
+// FIXME: Crash CWE-416: Use After Free
+ ZEND_API HashTable* ZEND_FASTCALL _zend_new_array(uint32_t nSize)
@@ -280 +280 @@ ZEND_API HashTable* ZEND_FASTCALL _zend_new_array(uint32_t nSize)
-	_zend_hash_init_int(ht, nSize, ZVAL_PTR_DTOR, 0);
+	_zend_hash_init_int(ht, nSize > 0 ? nSize : HT_MIN_SIZE, ZVAL_PTR_DTOR, 0);
diff --git a/Zend/zend_vm_execute.h b/Zend/zend_vm_execute.h
index 6a6476b2ce5..e271dbdafcc 100644
--- a/Zend/zend_vm_execute.h
+++ b/Zend/zend_vm_execute.h
@@ -59827,5 +59827,11 @@ ZEND_API void zend_execute(zend_op_array *op_array, zval *return_value)
-	i_init_code_execute_data(execute_data, op_array, return_value);
-	ZEND_OBSERVER_FCALL_BEGIN(execute_data);
-	zend_execute_ex(execute_data);
-	/* Observer end handlers are called from ZEND_RETURN */
-	zend_vm_stack_free_call_frame(execute_data);
+// FIXME: Crash CWE-416: Use After Free
+	/* Prevent use-after-free by validating execute_data state before use */
+	if (EXPECTED(execute_data != NULL && !EG(exception))) {
+		i_init_code_execute_data(execute_data, op_array, return_value);
+		ZEND_OBSERVER_FCALL_BEGIN(execute_data);
+		zend_execute_ex(execute_data);
+		/* Observer end handlers are called from ZEND_RETURN */
+		zend_vm_stack_free_call_frame(execute_data);
+	} else {
+		if (execute_data) zend_vm_stack_free_call_frame(execute_data);
+	}
