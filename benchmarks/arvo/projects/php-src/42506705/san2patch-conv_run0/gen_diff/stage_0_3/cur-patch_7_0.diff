diff --git a/Zend/zend_hash.c b/Zend/zend_hash.c
index a52a7fc9691..a8641dc8714 100644
--- a/Zend/zend_hash.c
+++ b/Zend/zend_hash.c
@@ -269 +268,0 @@ ZEND_API void ZEND_FASTCALL _zend_hash_init(HashTable *ht, uint32_t nSize, dtor_
-
@@ -277 +276,2 @@ ZEND_API HashTable* ZEND_FASTCALL _zend_new_array_0(void)
-ZEND_API HashTable* ZEND_FASTCALL _zend_new_array(uint32_t nSize)
+// FIXME: Crash CWE-416: Use After Free
+ ZEND_API HashTable* ZEND_FASTCALL _zend_new_array(uint32_t nSize)
@@ -279 +279,3 @@ ZEND_API HashTable* ZEND_FASTCALL _zend_new_array(uint32_t nSize)
-	HashTable *ht = emalloc(sizeof(HashTable));
+	HashTable *ht;
+	if (nSize == 0) nSize = HT_MIN_SIZE;
