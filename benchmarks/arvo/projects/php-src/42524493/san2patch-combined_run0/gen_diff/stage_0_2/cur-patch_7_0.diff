diff --git a/Zend/zend_types.h b/Zend/zend_types.h
index c341ffa0b4d..0d247a4ba31 100644
--- a/Zend/zend_types.h
+++ b/Zend/zend_types.h
@@ -1301 +1301,5 @@ static zend_always_inline uint32_t zval_refcount_p(const zval* pz) {
-	return GC_REFCOUNT(Z_COUNTED_P(pz));
+	if (pz == NULL) return 0;
+	if (!Z_REFCOUNTED_P(pz)) return 0;
+	zend_refcounted_h *counted = Z_COUNTED_P(pz);
+	if (counted == NULL) return 0;
+	return GC_REFCOUNT(counted);
@@ -1312 +1316 @@ static zend_always_inline uint32_t zval_addref_p(zval* pz) {
-}
+}}
