+	zend_refcounted_h *counted = Z_COUNTED_P(pz);
+	if (counted == NULL) {
+		return 0;
+	}
+	return GC_REFCOUNT(counted);
@@ -1312 +1316,2 @@ static zend_always_inline uint32_t zval_addref_p(zval* pz) {
-}
