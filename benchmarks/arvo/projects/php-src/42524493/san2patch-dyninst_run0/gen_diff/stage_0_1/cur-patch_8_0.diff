diff --git a/Zend/zend_execute_API.c b/Zend/zend_execute_API.c
index c1a5e31f7e6..16e0efab659 100644
--- a/Zend/zend_execute_API.c
+++ b/Zend/zend_execute_API.c
@@ -216 +216,6 @@ static int zval_call_destructor(zval *zv) /* {{{ */
-		return ZEND_HASH_APPLY_REMOVE;
+		zend_object *obj = Z_OBJ_P(zv);
+		if (obj && !(GC_FLAGS(obj) & IS_OBJ_DESTRUCTOR_CALLED)) {
+			return ZEND_HASH_APPLY_REMOVE;
+		} else {
+			return ZEND_HASH_APPLY_KEEP;
+		}
diff --git a/Zend/zend_types.h b/Zend/zend_types.h
index c341ffa0b4d..a99fb189056 100644
--- a/Zend/zend_types.h
+++ b/Zend/zend_types.h
@@ -1301 +1301,5 @@ static zend_always_inline uint32_t zval_refcount_p(const zval* pz) {
