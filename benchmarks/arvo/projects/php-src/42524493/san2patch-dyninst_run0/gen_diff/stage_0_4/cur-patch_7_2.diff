diff --git a/Zend/zend_types.h b/Zend/zend_types.h
index c341ffa0b4d..e7462caf7fe 100644
--- a/Zend/zend_types.h
+++ b/Zend/zend_types.h
@@ -1301 +1301,7 @@ static zend_always_inline uint32_t zval_refcount_p(const zval* pz) {
-	return GC_REFCOUNT(Z_COUNTED_P(pz));
+	/* Validate pointer before dereferencing to prevent use-after-free */
+	if (!pz || !Z_REFCOUNTED_P(pz)) return 0;
+	zend_refcounted_h *counted = Z_COUNTED_P(pz);
+	if (!counted) return 0;
+	/* Additional safety check for freed memory */
+	if ((uintptr_t)counted == (uintptr_t)0xdeadbeef) return 0;
+	return GC_REFCOUNT(counted);
@@ -1311,0 +1318 @@ static zend_always_inline uint32_t zval_addref_p(zval* pz) {
+
