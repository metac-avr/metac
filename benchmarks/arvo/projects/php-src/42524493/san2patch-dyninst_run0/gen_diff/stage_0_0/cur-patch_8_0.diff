diff --git a/Zend/zend_operators.c b/Zend/zend_operators.c
index c4fce74ebbb..dcabb108749 100644
--- a/Zend/zend_operators.c
+++ b/Zend/zend_operators.c
@@ -2052,2 +2052,8 @@ has_op2_string:;
-				/* op1_string will be used as the result, so we should not free it */
-				i_zval_ptr_dtor(result);
+				/* Safely handle object destruction to prevent use-after-free */
+				if (result && !Z_IS_REFCOUNTED_P(result)) {
+					/* Object is not refcounted, safe to destroy */
+					i_zval_ptr_dtor(result);
+				} else if (result && Z_IS_REFCOUNTED_P(result) && Z_REFCOUNT_P(result) > 0) {
+					/* Object is refcounted and has references, safe to destroy */
+					i_zval_ptr_dtor(result);
+				}
@@ -2070 +2076,6 @@ has_op2_string:;
-				i_zval_ptr_dtor(result);
+				/* Safely handle object destruction in alternate path */
+				if (result && !Z_IS_REFCOUNTED_P(result)) {
+					i_zval_ptr_dtor(result);
+				} else if (result && Z_IS_REFCOUNTED_P(result) && Z_REFCOUNT_P(result) > 0) {
+					i_zval_ptr_dtor(result);
+				}
diff --git a/Zend/zend_variables.c b/Zend/zend_variables.c
index 27e09d7db22..e793da8db6f 100644
--- a/Zend/zend_variables.c
+++ b/Zend/zend_variables.c
@@ -56,2 +56,4 @@ ZEND_API void ZEND_FASTCALL rc_dtor_func(zend_refcounted *p)
-	ZEND_ASSERT(GC_TYPE(p) <= IS_CONSTANT_AST);
-	zend_rc_dtor_func[GC_TYPE(p)](p);
+	if (p && GC_TYPE(p) <= IS_CONSTANT_AST) {
+		ZEND_ASSERT(GC_TYPE(p) <= IS_CONSTANT_AST);
+		zend_rc_dtor_func[GC_TYPE(p)](p);
+	}
