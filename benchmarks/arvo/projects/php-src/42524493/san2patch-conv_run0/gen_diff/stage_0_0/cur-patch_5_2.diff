+	if (!Z_REFCOUNTED_P(pz)) return 0;
+	zend_refcounted *counted = Z_COUNTED_P(pz);
+	if (counted && GC_REFCOUNT(counted) == 0) return 0;
+	return GC_REFCOUNT(counted);
