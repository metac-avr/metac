diff --git a/Zend/zend_execute_API.c b/Zend/zend_execute_API.c
index c1a5e31f7e6..895a2e99dfb 100644
--- a/Zend/zend_execute_API.c
+++ b/Zend/zend_execute_API.c
@@ -216 +216,9 @@ static int zval_call_destructor(zval *zv) /* {{{ */
-		return ZEND_HASH_APPLY_REMOVE;
+		/* Check if object is still valid before accessing refcount */
+		if (EG(objects_store).object_buckets && 
+		    (zend_object *)Z_OBJ_P(zv) >= EG(objects_store).object_buckets &&
+		    (zend_object *)Z_OBJ_P(zv) < EG(objects_store).object_buckets + EG(objects_store).top &&
+		    (zend_object *)Z_OBJ_P(zv) != NULL) {
+			return ZEND_HASH_APPLY_REMOVE;
+		} else {
+			return ZEND_HASH_APPLY_KEEP;
+		}
