diff --git a/Zend/zend_hash.c b/Zend/zend_hash.c
index a8571af75c9..e9d9eaded3b 100644
--- a/Zend/zend_hash.c
+++ b/Zend/zend_hash.c
@@ -2167,0 +2168,9 @@ ZEND_API void ZEND_FASTCALL zend_hash_reverse_apply(HashTable *ht, apply_func_t
+			if (UNEXPECTED(Z_TYPE(p->val) == IS_OBJECT) &&
+			    (Z_OBJ_HANDLER(p->val, dtor_obj) == zend_objects_destroy_object ||
+			     Z_OBJ_HANDLER(p->val, dtor_obj) == zend_objects_store_del)) {
+				zend_object *obj = Z_OBJ(p->val);
+				if (UNEXPECTED(!obj || zend_objects_store_is_free(obj))) {
+					_zend_hash_del_el(ht, HT_IDX_TO_HASH(idx), p);
+					continue;
+				}
+			}
