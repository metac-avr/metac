diff --git a/Zend/zend_hash.c b/Zend/zend_hash.c
index a8571af75c9..6d1ce34096b 100644
--- a/Zend/zend_hash.c
+++ b/Zend/zend_hash.c
@@ -2167,0 +2168,8 @@ ZEND_API void ZEND_FASTCALL zend_hash_reverse_apply(HashTable *ht, apply_func_t
+			if (UNEXPECTED(Z_TYPE(p->val) == IS_OBJECT)) {
+				zend_object *obj = Z_OBJ(p->val);
+				if (UNEXPECTED(GC_TYPE(obj) == IS_OBJECT &&
