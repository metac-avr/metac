diff --git a/Zend/zend_hash.c b/Zend/zend_hash.c
index 680263b5cb0..0c4f5bbc2a6 100644
--- a/Zend/zend_hash.c
+++ b/Zend/zend_hash.c
@@ -1433,5 +1433,8 @@ static zend_always_inline void _zend_hash_del_el(HashTable *ht, uint32_t idx, Bu
-
-	_zend_hash_del_el_ex(ht, idx, p, prev);
-	if (p->key) {
-		zend_string_release(p->key);
-		p->key = NULL;
+	// Verify bucket pointer validity before dereferencing to prevent UAF
+	Bucket *current_bucket = &ht->arData[idx];
+	if (p == current_bucket) {
+		_zend_hash_del_el_ex(ht, idx, p, prev);
+		if (p->key) {
+			zend_string_release(p->key);
+			p->key = NULL;
+		}
@@ -2154 +2157,2 @@ ZEND_API void ZEND_FASTCALL zend_hash_reverse_apply(HashTable *ht, apply_func_t
-			if (result & ZEND_HASH_APPLY_REMOVE) {
+// FIXME: Crash CWE-416: Use After Free
+ 			if (result & ZEND_HASH_APPLY_REMOVE) {
@@ -2156 +2160,4 @@ ZEND_API void ZEND_FASTCALL zend_hash_reverse_apply(HashTable *ht, apply_func_t
-				_zend_hash_del_el(ht, HT_IDX_TO_HASH(idx), p);
+				/* Validate that the hash table hasn't been reallocated */
+				if (ht->nNumUsed > idx && (ht->arData + idx)->h == p->h) {
+					_zend_hash_del_el(ht, HT_IDX_TO_HASH(idx), p);
+				}
