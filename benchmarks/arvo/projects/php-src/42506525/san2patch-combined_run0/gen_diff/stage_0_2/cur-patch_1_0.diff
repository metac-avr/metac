+++ b/Zend/zend_hash.c
@@ -1433,5 +1433,7 @@ static zend_always_inline void _zend_hash_del_el(HashTable *ht, uint32_t idx, Bu
-
-	_zend_hash_del_el_ex(ht, idx, p, prev);
