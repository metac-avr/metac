diff --git a/Zend/zend_hash.c b/Zend/zend_hash.c
index 680263b5cb0..aaa9dcb45c2 100644
--- a/Zend/zend_hash.c
+++ b/Zend/zend_hash.c
@@ -1433,0 +1434,3 @@ static zend_always_inline void _zend_hash_del_el(HashTable *ht, uint32_t idx, Bu
+	if (ht->nInternalPointer == idx) {
+		ht->nInternalPointer = Z_NEXT(p->val);
+	}
@@ -2145,0 +2149,6 @@ ZEND_API void ZEND_FASTCALL zend_hash_reverse_apply(HashTable *ht, apply_func_t
