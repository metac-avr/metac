diff --git a/Zend/zend_hash.c b/Zend/zend_hash.c
index 680263b5cb0..9e062a3a798 100644
--- a/Zend/zend_hash.c
+++ b/Zend/zend_hash.c
@@ -1432,0 +1433,6 @@ static zend_always_inline void _zend_hash_del_el(HashTable *ht, uint32_t idx, Bu
+	// Prevent use-after-free by validating bucket state
+	if (ht->u.flags & HASH_FLAG_PACKED) {
+		if (idx >= ht->nNumUsed) return;
+	} else {
+		if (!p || p->key == HT_DELETED_KEY) return;
+	}
@@ -2154 +2160,2 @@ ZEND_API void ZEND_FASTCALL zend_hash_reverse_apply(HashTable *ht, apply_func_t
-			if (result & ZEND_HASH_APPLY_REMOVE) {
+// FIXME: Crash CWE-416: Use After Free
+ 			if (result & ZEND_HASH_APPLY_REMOVE) {
@@ -2156 +2163,3 @@ ZEND_API void ZEND_FASTCALL zend_hash_reverse_apply(HashTable *ht, apply_func_t
-				_zend_hash_del_el(ht, HT_IDX_TO_HASH(idx), p);
+				if (p >= ht->arData && p < ht->arData + ht->nNumUsed) {  // Validate pointer range
+					_zend_hash_del_el(ht, HT_IDX_TO_HASH(idx), p);
+				}
