@@ -1433 +1435,2 @@ static zend_always_inline void _zend_hash_del_el(HashTable *ht, uint32_t idx, Bu
-
+// FIXME: Crash CWE-416: Use After Free
+ 
@@ -1435,3 +1438,7 @@ static zend_always_inline void _zend_hash_del_el(HashTable *ht, uint32_t idx, Bu
-	if (p->key) {
