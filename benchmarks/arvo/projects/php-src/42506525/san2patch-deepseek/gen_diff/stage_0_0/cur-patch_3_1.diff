-				ZVAL_COPY_VALUE(zv, pData);
+	if ((flag & (HASH_ADD_NEW|HASH_ADD_NEXT)) != (HASH_ADD_NEW|HASH_ADD_NEXT)
+	 && h < ht->nNumUsed) {
+		zv = ht->arPacked + h;
+		if (Z_TYPE_P(zv) != IS_UNDEF) {
+			if (flag & HASH_LOOKUP) {
@@ -1035,2 +1024,0 @@ static zend_always_inline zval *_zend_hash_index_add_or_update_i(HashTable *ht,
-			} else { /* we have to keep the order :( */
-				goto convert_to_hash;
@@ -1038,12 +1026,3 @@ static zend_always_inline zval *_zend_hash_index_add_or_update_i(HashTable *ht,
-		} else if (EXPECTED(h < ht->nTableSize)) {
-add_to_packed:
-			zv = ht->arPacked + h;
-			/* incremental initialization of empty Buckets */
-			if ((flag & (HASH_ADD_NEW|HASH_ADD_NEXT)) != (HASH_ADD_NEW|HASH_ADD_NEXT)) {
-				if (h > ht->nNumUsed) {
-					zval *q = ht->arPacked + ht->nNumUsed;
-					while (q != zv) {
-						ZVAL_UNDEF(q);
-						q++;
-					}
-				}
+replace:
+			if (flag & HASH_ADD) {
+				return NULL;
@@ -1051,6 +1030,2 @@ static zend_always_inline zval *_zend_hash_index_add_or_update_i(HashTable *ht,
-			ht->nNextFreeElement = ht->nNumUsed = h + 1;
-			ht->nNumOfElements++;
-			if (flag & HASH_LOOKUP) {
-				ZVAL_NULL(zv);
-			} else {
-				ZVAL_COPY_VALUE(zv, pData);
+			if (ht->pDestructor) {
+				ht->pDestructor(zv);
@@ -1058 +1033 @@ static zend_always_inline zval *_zend_hash_index_add_or_update_i(HashTable *ht,
-
+			ZVAL_COPY_VALUE(zv, pData);
@@ -1060,7 +1035,14 @@ static zend_always_inline zval *_zend_hash_index_add_or_update_i(HashTable *ht,
