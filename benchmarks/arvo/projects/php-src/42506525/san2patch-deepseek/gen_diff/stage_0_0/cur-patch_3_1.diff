-		           (ht->nTableSize >> 1) < ht->nNumOfElements) {
-			zend_hash_packed_grow(ht);
-			goto add_to_packed;
-		} else {
-			if (ht->nNumUsed >= ht->nTableSize) {
-				ht->nTableSize += ht->nTableSize;
+		} else { /* we have to keep the order :( */
+			goto convert_to_hash;
+		}
+	} else if (EXPECTED(h < ht->nTableSize)) {
+add_to_packed:
+		zv = ht->arPacked + h;
+		/* incremental initialization of empty Buckets */
+		if ((flag & (HASH_ADD_NEW|HASH_ADD_NEXT)) != (HASH_ADD_NEW|HASH_ADD_NEXT)) {
+			if (h > ht->nNumUsed) {
+				zval *q = ht->arPacked + ht->nNumUsed;
+				while (q != zv) {
+					ZVAL_UNDEF(q);
+					q++;
+				}
@@ -1068,2 +1049,0 @@ static zend_always_inline zval *_zend_hash_index_add_or_update_i(HashTable *ht,
-convert_to_hash:
-			zend_hash_packed_to_hash(ht);
@@ -1071,4 +1051,6 @@ static zend_always_inline zval *_zend_hash_index_add_or_update_i(HashTable *ht,
