+
+		return zv;
+	} else if ((h >> 1) < ht->nTableSize &&
+	           (ht->nTableSize >> 1) < ht->nNumOfElements) {
+		zend_hash_packed_grow(ht);
+		goto add_to_packed;
@@ -1078,9 +1065,18 @@ static zend_always_inline zval *_zend_hash_index_add_or_update_i(HashTable *ht,
-		if ((flag & HASH_ADD_NEW) == 0 || ZEND_DEBUG) {
