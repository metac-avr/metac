-		if (h < ht->nTableSize) {
-			zend_hash_real_init_packed_ex(ht);
-			goto add_to_packed;
+		ht->nNextFreeElement = ht->nNumUsed = h + 1;
+		ht->nNumOfElements++;
+		if (flag & HASH_LOOKUP) {
+			ZVAL_NULL(zv);
+		} else {
+			ZVAL_COPY_VALUE(zv, pData);
@@ -1076 +1058,6 @@ static zend_always_inline zval *_zend_hash_index_add_or_update_i(HashTable *ht,
