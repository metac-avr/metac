--- a/Zend/zend_hash.c
+++ b/Zend/zend_hash.c
@@ -1019,15 +1019,5 @@ static zend_always_inline zval *_zend_hash_index_add_or_update_i(HashTable *ht,
-		if ((flag & (HASH_ADD_NEW|HASH_ADD_NEXT)) != (HASH_ADD_NEW|HASH_ADD_NEXT)
-		 && h < ht->nNumUsed) {
-			zv = ht->arPacked + h;
-			if (Z_TYPE_P(zv) != IS_UNDEF) {
-				if (flag & HASH_LOOKUP) {
-					return zv;
-				}
-replace:
-				if (flag & HASH_ADD) {
-					return NULL;
-				}
-				if (ht->pDestructor) {
-					ht->pDestructor(zv);
