diff --git a/Zend/zend_hash.c b/Zend/zend_hash.c
index 680263b5cb0..77c8393d1e9 100644
--- a/Zend/zend_hash.c
+++ b/Zend/zend_hash.c
@@ -1061,0 +1062 @@ static zend_always_inline zval *_zend_hash_index_add_or_update_i(HashTable *ht,
+			uint32_t old_num_used = ht->nNumUsed;
@@ -1062,0 +1064,3 @@ static zend_always_inline zval *_zend_hash_index_add_or_update_i(HashTable *ht,
+			if (UNEXPECTED(ht->nNumUsed != old_num_used)) {
+				return NULL;
+			}
@@ -1237,3 +1241,8 @@ static void ZEND_FASTCALL zend_hash_do_resize(HashTable *ht)
-		HT_SET_DATA_ADDR(ht, new_data);
-		memcpy(ht->arData, old_buckets, sizeof(Bucket) * ht->nNumUsed);
