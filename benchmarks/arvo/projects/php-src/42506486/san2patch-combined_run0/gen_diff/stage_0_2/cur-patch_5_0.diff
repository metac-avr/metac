diff --git a/Zend/zend_hash.c b/Zend/zend_hash.c
index 8ee292106a6..1a494e42dc8 100644
--- a/Zend/zend_hash.c
+++ b/Zend/zend_hash.c
@@ -1352,3 +1352,8 @@ static zend_always_inline void _zend_hash_del_el_ex(HashTable *ht, uint32_t idx,
-		ZVAL_COPY_VALUE(&tmp, &p->val);
-		ZVAL_UNDEF(&p->val);
-		ht->pDestructor(&tmp);
+		// Validate pointer before accessing to prevent use-after-free
+		if (p && Z_TYPE(p->val) != IS_UNDEF) {
+			ZVAL_COPY_VALUE(&tmp, &p->val);
+			ZVAL_UNDEF(&p->val);
+			ht->pDestructor(&tmp);
+		} else {
+			ZVAL_UNDEF(&p->val);
+		}
@@ -1829 +1834,2 @@ ZEND_API void ZEND_FASTCALL zend_hash_graceful_reverse_destroy(HashTable *ht)
-		p--;
+// FIXME: Crash CWE-825: Expired Pointer Dereference
+ 		p--;
@@ -1830,0 +1837,3 @@ ZEND_API void ZEND_FASTCALL zend_hash_graceful_reverse_destroy(HashTable *ht)
+		if (Z_COUNTED(p->val) && GC_REFCOUNT(Z_COUNTED(p->val)) > 0) {
+			GC_DELREF(Z_COUNTED(p->val));
+		}
