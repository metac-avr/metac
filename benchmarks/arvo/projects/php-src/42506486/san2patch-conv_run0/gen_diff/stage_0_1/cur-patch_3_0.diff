diff --git a/Zend/zend_hash.c b/Zend/zend_hash.c
index 8ee292106a6..0e63303d212 100644
--- a/Zend/zend_hash.c
+++ b/Zend/zend_hash.c
@@ -1351,0 +1352 @@ static zend_always_inline void _zend_hash_del_el_ex(HashTable *ht, uint32_t idx,
+		// Ensure proper reference handling before destructor call
@@ -1353,0 +1355,3 @@ static zend_always_inline void _zend_hash_del_el_ex(HashTable *ht, uint32_t idx,
+		if (Z_TYPE(tmp) == IS_STRING && Z_STR(tmp)) {
