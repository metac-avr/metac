index 4a1232198fc..0b9d04b4391 100644
--- a/Zend/zend_types.h
+++ b/Zend/zend_types.h
@@ -1185 +1185,5 @@ static zend_always_inline uint32_t zend_gc_delref(zend_refcounted_h *p) {
-	return --(p->refcount);
+	if (UNEXPECTED(--(p->refcount) == 0)) {
+		p->u.type_info |= GC_IMMUTABLE;
+		zend_gc_decref(p);
+	}
+	return p->refcount;
