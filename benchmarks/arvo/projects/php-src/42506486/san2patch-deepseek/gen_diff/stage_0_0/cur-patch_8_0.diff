diff --git a/Zend/zend_types.h b/Zend/zend_types.h
index 4a1232198fc..2787d2810a0 100644
--- a/Zend/zend_types.h
+++ b/Zend/zend_types.h
@@ -1185 +1185,5 @@ static zend_always_inline uint32_t zend_gc_delref(zend_refcounted_h *p) {
-	return --(p->refcount);
+	uint32_t rc = --(p->refcount);
+	if (UNEXPECTED(rc == 0)) {
+		p->u.type_info |= GC_IMMUTABLE;
+	}
+	return rc;
