diff --git a/Zend/Optimizer/dfa_pass.c b/Zend/Optimizer/dfa_pass.c
index 9eddbde3b71..e814a3e9eda 100644
--- a/Zend/Optimizer/dfa_pass.c
+++ b/Zend/Optimizer/dfa_pass.c
@@ -193,0 +194,22 @@ static void zend_ssa_remove_nops(zend_op_array *op_array, zend_ssa *ssa, zend_op
+		uint32_t first_early_binding_opline = (uint32_t)-1;
+		uint32_t *early_binding_opline_nums = NULL;
+		uint32_t early_binding_count = 0;
+		uint32_t current_opline_num;
+
+		/* cache early binding opline numbers before compacting */
+		if (op_array->fn_flags & ZEND_ACC_EARLY_BINDING) {
+			current_opline_num = ctx->script->first_early_binding_opline;
+			ZEND_ASSERT(op_array == &ctx->script->main_op_array);
+			while (current_opline_num != (uint32_t)-1) {
+				early_binding_count++;
+				current_opline_num = op_array->opcodes[current_opline_num].result.opline_num;
+			}
+			early_binding_opline_nums = emalloc(early_binding_count * sizeof(uint32_t));
+			current_opline_num = ctx->script->first_early_binding_opline;
+			early_binding_count = 0;
+			while (current_opline_num != (uint32_t)-1) {
+				early_binding_opline_nums[early_binding_count++] = current_opline_num;
+				current_opline_num = op_array->opcodes[current_opline_num].result.opline_num;
+			}
+		}
+
@@ -238,9 +260,18 @@ static void zend_ssa_remove_nops(zend_op_array *op_array, zend_ssa *ssa, zend_op
-		/* update early binding list */
-		if (op_array->fn_flags & ZEND_ACC_EARLY_BINDING) {
-			uint32_t *opline_num = &ctx->script->first_early_binding_opline;
-
-			ZEND_ASSERT(op_array == &ctx->script->main_op_array);
-			do {
-				*opline_num -= shiftlist[*opline_num];
-				opline_num = &op_array->opcodes[*opline_num].result.opline_num;
-			} while (*opline_num != (uint32_t)-1);
+		/* update early binding list using cached indices */
+		if (early_binding_opline_nums) {
+			uint32_t k;
+			uint32_t previous_mapped = (uint32_t)-1;
+
+			for (k = 0; k < early_binding_count; k++) {
+				uint32_t mapped = early_binding_opline_nums[k] - shiftlist[early_binding_opline_nums[k]];
+				if (k == 0) {
+					ctx->script->first_early_binding_opline = mapped;
+				} else {
+					op_array->opcodes[previous_mapped].result.opline_num = mapped;
+				}
+				previous_mapped = mapped;
+			}
+			if (early_binding_count > 0) {
+				op_array->opcodes[previous_mapped].result.opline_num = (uint32_t)-1;
+			}
+			efree(early_binding_opline_nums);
