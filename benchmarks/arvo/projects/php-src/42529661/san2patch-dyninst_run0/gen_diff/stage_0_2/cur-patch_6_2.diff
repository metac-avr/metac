diff --git a/ext/opcache/jit/zend_jit_helpers.c b/ext/opcache/jit/zend_jit_helpers.c
index 7c80de916aa..109e9f12cae 100644
--- a/ext/opcache/jit/zend_jit_helpers.c
+++ b/ext/opcache/jit/zend_jit_helpers.c
@@ -2494,0 +2495,6 @@ static void ZEND_FASTCALL zend_jit_array_free(HashTable *ht)
+		/* Check if JIT is actively using this HashTable before freeing */
+		if (ht->u.flags & HASH_FLAG_JIT_TRACE_USED) {
+			/* Mark for deferred cleanup instead of immediate free */
+			ht->u.flags |= HASH_FLAG_JIT_DEFERRED_FREE;
+			return;
+		}
