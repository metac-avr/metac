-			if (op1_type == IS_INDIRECT) {
-				zv = Z_INDIRECT_P(zv);
-				op1_type = Z_TYPE_P(zv);
-				flags |= IS_TRACE_INDIRECT;
-			}
-			if (op1_type == IS_REFERENCE) {
