diff --git a/Zend/zend_vm_execute.h b/Zend/zend_vm_execute.h
index 2ba23ff65bb..580902be386 100644
--- a/Zend/zend_vm_execute.h
+++ b/Zend/zend_vm_execute.h
@@ -58975 +58975,9 @@ ZEND_API void zend_execute(zend_op_array *op_array, zval *return_value)
-	i_init_code_execute_data(execute_data, op_array, return_value);
+	if (UNEXPECTED(Z_TYPE_P(return_value) != IS_ARRAY)) {
+		ZVAL_UNDEF(return_value);
+		array_init(return_value);
+	} else if (UNEXPECTED(Z_ARRVAL_P(return_value) == NULL || GC_REFCOUNT(Z_ARRVAL_P(return_value)) == 0 || GC_REFCOUNT(Z_ARRVAL_P(return_value)) == GC_EXPIRED)) {
+		zend_array_destroy(Z_ARRVAL_P(return_value));
+		ZVAL_UNDEF(return_value);
+		array_init(return_value);
+	}
+ 	i_init_code_execute_data(execute_data, op_array, return_value);
