diff --git a/Zend/zend_hash.c b/Zend/zend_hash.c
index 8ee292106a6..777122d7a34 100644
--- a/Zend/zend_hash.c
+++ b/Zend/zend_hash.c
@@ -1680,0 +1681,17 @@ ZEND_API void ZEND_FASTCALL zend_array_destroy(HashTable *ht)
+
+ZEND_API void ZEND_FASTCALL zend_hash_destroy(HashTable *ht)
+{
+	Bucket *p, *end;
+
+	if (HT_FLAGS(ht) & HASH_FLAG_PACKED) {
+		goto free_ht;
+	}
+
+	end = HT_GET_HASH_SIZE(ht);
+	for (p = ht->arData; p != end; p++) {
+		if (p->key) {
+			zend_string_release(p->key);
+		}
+		if (Z_TYPE(p->val) != IS_UNDEF) {
+			zval_ptr_dtor(&p->val);
+		}
@@ -1682,2 +1698,0 @@ ZEND_API void ZEND_FASTCALL zend_array_destroy(HashTable *ht)
-	SET_INCONSISTENT(HT_DESTROYED);
-	efree(HT_GET_DATA_ADDR(ht));
@@ -1684,0 +1700 @@ ZEND_API void ZEND_FASTCALL zend_array_destroy(HashTable *ht)
+	SET_INCONSISTENT(HT_DESTROYED);
@@ -1685,0 +1702 @@ ZEND_API void ZEND_FASTCALL zend_array_destroy(HashTable *ht)
+	efree(HT_GET_DATA_ADDR(ht));
@@ -1688,5 +1704,0 @@ ZEND_API void ZEND_FASTCALL zend_array_destroy(HashTable *ht)
-
-ZEND_API void ZEND_FASTCALL zend_hash_clean(HashTable *ht)
-{
-	Bucket *p, *end;
-
