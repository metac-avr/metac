diff --git a/Zend/zend_hash.c b/Zend/zend_hash.c
index 8ee292106a6..933bda135d1 100644
--- a/Zend/zend_hash.c
+++ b/Zend/zend_hash.c
@@ -1682,0 +1683,4 @@ ZEND_API void ZEND_FASTCALL zend_array_destroy(HashTable *ht)
+	/* Clear GC references before freeing to prevent use-after-free */
+	if (ht->u.flags & HASH_FLAG_APPLY_PROTECTION) {
+		ht->u.flags &= ~HASH_FLAG_INITIALIZED;
+	}
@@ -1684 +1688 @@ ZEND_API void ZEND_FASTCALL zend_array_destroy(HashTable *ht)
-free_ht:
+ free_ht:
