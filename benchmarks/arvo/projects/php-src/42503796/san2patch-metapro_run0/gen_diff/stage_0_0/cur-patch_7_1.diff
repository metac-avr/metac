diff --git a/Zend/zend_hash.c b/Zend/zend_hash.c
index 8ee292106a6..72552d6890e 100644
--- a/Zend/zend_hash.c
+++ b/Zend/zend_hash.c
@@ -1680,0 +1681,8 @@ ZEND_API void ZEND_FASTCALL zend_array_destroy(HashTable *ht)
+ZEND_API void ZEND_FASTCALL zend_hash_destroy(HashTable *ht)
+{
+	Bucket *p, *end;
+
+	if (EXPECTED(ht->u.flags & HASH_FLAG_PACKED)) {
+		 zend_hash_packed_destroy(ht);
+	} else {
+		zend_hash_destroy_ex(ht);
@@ -1682,0 +1691,4 @@ ZEND_API void ZEND_FASTCALL zend_array_destroy(HashTable *ht)
+	/* Clear GC references before freeing to prevent use-after-free */
+	if (ht->u.flags & 0x04) {  /* HASH_FLAG_APPLY_PROTECTION */
+		ht->u.flags &= ~0x01;   /* HASH_FLAG_INITIALIZED */
+	}
@@ -1688,5 +1699,0 @@ ZEND_API void ZEND_FASTCALL zend_array_destroy(HashTable *ht)
-
-ZEND_API void ZEND_FASTCALL zend_hash_clean(HashTable *ht)
-{
