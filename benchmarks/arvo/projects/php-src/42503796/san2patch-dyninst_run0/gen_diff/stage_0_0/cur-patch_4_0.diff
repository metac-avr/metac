diff --git a/Zend/zend_vm_execute.h b/Zend/zend_vm_execute.h
index 2ba23ff65bb..dcc340d82f7 100644
--- a/Zend/zend_vm_execute.h
+++ b/Zend/zend_vm_execute.h
@@ -58975,5 +58975,9 @@ ZEND_API void zend_execute(zend_op_array *op_array, zval *return_value)
-	i_init_code_execute_data(execute_data, op_array, return_value);
-	ZEND_OBSERVER_FCALL_BEGIN(execute_data);
-	zend_execute_ex(execute_data);
-	/* Observer end handlers are called from ZEND_RETURN */
-	zend_vm_stack_free_call_frame(execute_data);
+// FIXME: Crash CWE-416: Use After Free
+	/* Add guard against use-after-free by validating execute_data */
+	if (execute_data != NULL) {
+		i_init_code_execute_data(execute_data, op_array, return_value);
+		ZEND_OBSERVER_FCALL_BEGIN(execute_data);
+		zend_execute_ex(execute_data);
+		/* Observer end handlers are called from ZEND_RETURN */
+		zend_vm_stack_free_call_frame(execute_data);
+	}
diff --git a/Zend/zend_hash.c b/Zend/zend_hash.c
index 8ee292106a6..e9de6373e59 100644
--- a/Zend/zend_hash.c
+++ b/Zend/zend_hash.c
@@ -1682,0 +1683,2 @@ ZEND_API void ZEND_FASTCALL zend_array_destroy(HashTable *ht)
+	/* Set destroyed flag to prevent UAF */
+	ht->u.flags |= HASH_FLAG_DESTROYED;
@@ -1684 +1686 @@ ZEND_API void ZEND_FASTCALL zend_array_destroy(HashTable *ht)
-free_ht:
+ free_ht:
