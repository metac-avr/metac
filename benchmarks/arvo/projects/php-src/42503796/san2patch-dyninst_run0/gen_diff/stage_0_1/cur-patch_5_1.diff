diff --git a/Zend/zend_vm_execute.h b/Zend/zend_vm_execute.h
index 2ba23ff65bb..c8e691ceaf4 100644
--- a/Zend/zend_vm_execute.h
+++ b/Zend/zend_vm_execute.h
@@ -58974,0 +58975 @@ ZEND_API void zend_execute(zend_op_array *op_array, zval *return_value)
+// FIXME: Crash CWE-825: Expired Pointer Dereference
@@ -58977 +58978,8 @@ ZEND_API void zend_execute(zend_op_array *op_array, zval *return_value)
-	zend_execute_ex(execute_data);
+	zend_try {
+		zend_execute_ex(execute_data);
+	} zend_catch {
+		/* Handle expired pointer dereference */
+		if (EG(exception) == NULL) {
+			zend_throw_error(NULL, "Expired pointer dereference detected");
+		}
+	} zend_end_try();
