diff --git a/Zend/zend_hash.c b/Zend/zend_hash.c
index 8ee292106a6..18df20c711c 100644
--- a/Zend/zend_hash.c
+++ b/Zend/zend_hash.c
@@ -1684 +1684,5 @@ ZEND_API void ZEND_FASTCALL zend_array_destroy(HashTable *ht)
-free_ht:
+	/* Fixed CWE-416: Use After Free - Ensure GC refcount safety */
+	if (ht->gc && GC_REFCOUNT(ht->gc) > 0) {
+		GC_REFCOUNT(ht->gc)--;
+	}
+ free_ht:
diff --git a/Zend/zend_variables.c b/Zend/zend_variables.c
index 06483d581df..821e24004a1 100644
--- a/Zend/zend_variables.c
+++ b/Zend/zend_variables.c
@@ -56,2 +56,4 @@ ZEND_API void ZEND_FASTCALL rc_dtor_func(zend_refcounted *p)
-	ZEND_ASSERT(GC_TYPE(p) <= IS_CONSTANT_AST);
-	zend_rc_dtor_func[GC_TYPE(p)](p);
+	if (EXPECTED(p != NULL) && EXPECTED(!(GC_FLAGS(p) & GC_PURGED))) {
+		ZEND_ASSERT(GC_TYPE(p) <= IS_CONSTANT_AST);
+		zend_rc_dtor_func[GC_TYPE(p)](p);
+	}
