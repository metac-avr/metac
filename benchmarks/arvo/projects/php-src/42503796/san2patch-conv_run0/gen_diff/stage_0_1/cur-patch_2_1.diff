--- a/Zend/zend_types.h
+++ b/Zend/zend_types.h
@@ -1145,2 +1144,0 @@ extern ZEND_API bool zend_rc_debug;
-		GC_ADD_FLAGS(p, GC_PERSISTENT_LOCAL); \
-	} while (0)
@@ -1151 +1149 @@ extern ZEND_API bool zend_rc_debug;
-	do { } while (0)
+	_do { } while (0)
@@ -1153,0 +1152,5 @@ extern ZEND_API bool zend_rc_debug;
+// Function to check if HashTable is valid
+static inline int HT_IS_VALID(HashTable *ht) {
+	return ht != NULL;
+}
+
@@ -1154,0 +1158,3 @@ static zend_always_inline uint32_t zend_gc_refcount(const zend_refcounted_h *p)
+	if (p == NULL) {
+		return 0;
+	}
