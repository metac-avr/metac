diff --git a/Zend/zend_hash.c b/Zend/zend_hash.c
index 8ee292106a6..fafc613b8f8 100644
--- a/Zend/zend_hash.c
+++ b/Zend/zend_hash.c
@@ -1680,0 +1681,13 @@ ZEND_API void ZEND_FASTCALL zend_array_destroy(HashTable *ht)
+zend_hash_destroy(HashTable *ht)
+{
+	Bucket *p, *end;
+
+	IS_CONSISTENT(ht);
+	HT_ASSERT_RC1(ht);
+
+	if (ht->nNumUsed) {
+		end = ht->arData + ht->nNumUsed;
+		for (p = ht->arData; p != end; p++) {
+			if (Z_TYPE(p->val) == IS_UNDEF) continue;
+			_zval_dtor_func(&p->val ZEND_FILE_LINE_CC);
+		}
@@ -1684,3 +1697,6 @@ ZEND_API void ZEND_FASTCALL zend_array_destroy(HashTable *ht)
-free_ht:
-	zend_hash_iterators_remove(ht);
-	FREE_HASHTABLE(ht);
+	
+	// Fixed CWE-416: Use After Free - Validate pointer before cleanup
+	if (ht && HT_IS_VALID(ht)) {
+		zend_hash_iterators_remove(ht);
+		FREE_HASHTABLE(ht);
+	}
@@ -1688,5 +1703,0 @@ ZEND_API void ZEND_FASTCALL zend_array_destroy(HashTable *ht)
-
-ZEND_API void ZEND_FASTCALL zend_hash_clean(HashTable *ht)
-{
-	Bucket *p, *end;
