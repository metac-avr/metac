diff --git a/Zend/zend_hash.c b/Zend/zend_hash.c
index 8ee292106a6..74315a8d50c 100644
--- a/Zend/zend_hash.c
+++ b/Zend/zend_hash.c
@@ -1680,0 +1681,16 @@ ZEND_API void ZEND_FASTCALL zend_array_destroy(HashTable *ht)
+ZEND_API void ZEND_FASTCALL zend_hash_destroy(HashTable *ht)
+{
+	Bucket *p, *end;
+
+	IS_CONSISTENT(ht);
+
+	if (!(HT_FLAGS(ht) & HASH_FLAG_PACKED)) {
+		HT_HASH_RESET(ht);
+	}
+	end = ht->arData + ht->nNumUsed;
+	for (p = ht->arData; p != end; p++) {
+		if (Z_TYPE(p->val) == IS_UNDEF) continue;
+		_ht_val_ptr_dtor_wrapper(&p->val ZEND_FILE_LINE_CC);
+	}
+	if (ht->nNumUsed) {
+		PEFREE(ht->arData);
@@ -1683,0 +1700,2 @@ ZEND_API void ZEND_FASTCALL zend_array_destroy(HashTable *ht)
+	/* Fixed CWE-416: Use After Free - Reset GC flags to prevent reuse */
+	GC_TYPE_INFO(&(ht->gc)) = 0;
@@ -1688,5 +1705,0 @@ ZEND_API void ZEND_FASTCALL zend_array_destroy(HashTable *ht)
-
-ZEND_API void ZEND_FASTCALL zend_hash_clean(HashTable *ht)
-{
-	Bucket *p, *end;
-
