diff --git a/Zend/zend_hash.c b/Zend/zend_hash.c
index 8ee292106a6..35d272a7909 100644
--- a/Zend/zend_hash.c
+++ b/Zend/zend_hash.c
@@ -1680,0 +1681,22 @@ ZEND_API void ZEND_FASTCALL zend_array_destroy(HashTable *ht)
+ZEND_API void ZEND_FASTCALL zend_hash_destroy(HashTable *ht)
+{
+	Bucket *p, *end;
+
+	if (EXPECTED(ht->nNumOfElements == 0)) {
+		goto free_ht;
+	}
+
+	IS_CONSISTENT(ht);
+	HT_ASSERT_RC1(ht);
+
+	end = HT_GET_DATA_ADDR(ht) + ht->nNumUsed;
+	for (p = HT_GET_DATA_ADDR(ht); p != end; p++) {
+		if (Z_TYPE(p->val) == IS_UNDEF) continue;
+		_zval_ptr_dtor(&p->val ZEND_FILE_LINE_CC);
+		if (UNEXPECTED(ZEND_HASH_GET_APPLY_COUNT(ht) > 0)) {
+			/* If hash is not destroyed, we can't destroy key. */
+			break;
+		}
+		if (p->key) {
+			pefree((char*)p->key, HT_IS_PERSISTENT(ht));
+		}
@@ -1681,0 +1704,2 @@ ZEND_API void ZEND_FASTCALL zend_array_destroy(HashTable *ht)
