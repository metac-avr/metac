diff --git a/Zend/zend_hash.c b/Zend/zend_hash.c
index 8ee292106a6..9a62a06a9cd 100644
--- a/Zend/zend_hash.c
+++ b/Zend/zend_hash.c
@@ -1684 +1684,3 @@ ZEND_API void ZEND_FASTCALL zend_array_destroy(HashTable *ht)
-free_ht:
+	/* Fixed CWE-416: Use After Free - Clear GC info before freeing */
+	GC_REMOVE_FROM_BUFFER(ht);
+ free_ht:
diff --git a/Zend/zend_variables.c b/Zend/zend_variables.c
index 06483d581df..b170567e864 100644
--- a/Zend/zend_variables.c
+++ b/Zend/zend_variables.c
@@ -56,2 +56,4 @@ ZEND_API void ZEND_FASTCALL rc_dtor_func(zend_refcounted *p)
-	ZEND_ASSERT(GC_TYPE(p) <= IS_CONSTANT_AST);
-	zend_rc_dtor_func[GC_TYPE(p)](p);
+	if (p && !((GC_FLAGS(p) & GC_IMMUTABLE) && GC_REFCOUNT(p) == 0)) {
+		ZEND_ASSERT(GC_TYPE(p) <= IS_CONSTANT_AST);
+		zend_rc_dtor_func[GC_TYPE(p)](p);
+	}
