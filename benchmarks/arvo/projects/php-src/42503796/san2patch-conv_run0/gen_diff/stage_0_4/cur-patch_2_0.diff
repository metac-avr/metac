-free_ht:
@@ -1686 +1684,6 @@ ZEND_API void ZEND_FASTCALL zend_array_destroy(HashTable *ht)
-	FREE_HASHTABLE(ht);
+	efree(HT_GET_DATA_ADDR(ht));
+// FIXME: Crash CWE-825: Expired Pointer Dereference
+ free_ht:
+	if (EXPECTED(ht != NULL)) {
+		FREE_HASHTABLE(ht);
+	}
