diff --git a/Zend/zend_variables.h b/Zend/zend_variables.h
index ea3fd9c5efc..0d39f9f4b9a 100644
--- a/Zend/zend_variables.h
+++ b/Zend/zend_variables.h
@@ -34,2 +34,4 @@ static zend_always_inline void zval_ptr_dtor_nogc(zval *zval_ptr)
