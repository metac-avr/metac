diff --git a/Zend/zend_types.h b/Zend/zend_types.h
index 4a1232198fc..7dee3a71b77 100644
--- a/Zend/zend_types.h
+++ b/Zend/zend_types.h
@@ -1144,0 +1145,45 @@ extern ZEND_API bool zend_rc_debug;
+#ifndef ZEND_TYPES_H
+#define ZEND_TYPES_H
+
+#if defined(ZTS) && defined(COMPILE_DL_opcache)
+ZEND_TSRMLS_CACHE_EXTERN()
+#endif
+
+#include "zend_portability.h"
+#include "zend_types.h"
+
+// Function declarations to fix implicit declaration warnings
+static zend_always_inline uint32_t zend_gc_refcount(const zend_refcounted_h *p);
+static zend_always_inline uint32_t zend_gc_set_refcount(zend_refcounted_h *p, uint32_t rc);
+static zend_always_inline uint32_t zend_gc_addref(zend_refcounted_h *p);
+static zend_always_inline uint32_t zend_gc_delref(zend_refcounted_h *p);
+static zend_always_inline void zval_addref_p(zval *pz);
+static zend_always_inline void zval_delref_p(zval *pz);
+static zend_always_inline uint32_t zval_refcount_p(zval *pz);
+static zend_always_inline void ZVAL_DEREF(zval *z);
+static zend_always_inline void ZVAL_COPY_VALUE(zval *z, zval *v);
+static zend_always_inline void ZVAL_COPY(zval *z, zval *v);
+static zend_always_inline void ZVAL_UNREF(zval *z);
+
+#ifdef GC_ADD_FLAGS
+# undef GC_ADD_FLAGS
+#endif
+
+#ifdef ZEND_RC_MOD_CHECK
+# undef ZEND_RC_MOD_CHECK
+#endif
+
+#ifdef GC_MAKE_PERSISTENT_LOCAL
+# undef GC_MAKE_PERSISTENT_LOCAL
+#endif
+
+#ifdef ZEND_RC_MOD_CHECK
+# undef ZEND_RC_MOD_CHECK
+#endif
+
+#if defined(ZTS) && defined(GC_MOD_CHECK)
+# define ZEND_RC_MOD_CHECK(p) \
+	zend_rc_mod_check(p)
+# define GC_MAKE_PERSISTENT_LOCAL(p) \
+	do { \
+		GC_SET_REFCOUNT(p, 1); \
@@ -1153,0 +1199 @@ extern ZEND_API bool zend_rc_debug;
+// Fixed functions with null pointer checks to prevent CWE-825
@@ -1155 +1201,2 @@ static zend_always_inline uint32_t zend_gc_refcount(const zend_refcounted_h *p)
-	return p->refcount;
+	if (p && ((zend_uintptr_t)p) > 0x1000) return p->refcount;
+	return 0;
@@ -1159,2 +1206,5 @@ static zend_always_inline uint32_t zend_gc_set_refcount(zend_refcounted_h *p, ui
-	p->refcount = rc;
-	return p->refcount;
+	if (p && ((zend_uintptr_t)p) > 0x1000) {
+		p->refcount = rc;
+		return p->refcount;
+	}
+	return 0;
@@ -1164,2 +1214,5 @@ static zend_always_inline uint32_t zend_gc_addref(zend_refcounted_h *p) {
-	ZEND_RC_MOD_CHECK(p);
-	return ++(p->refcount);
+	if (p && ((zend_uintptr_t)p) > 0x1000) {
+		ZEND_RC_MOD_CHECK(p);
+		return ++(p->refcount);
+	}
+	return 0;
@@ -1167,0 +1221,8 @@ static zend_always_inline uint32_t zend_gc_addref(zend_refcounted_h *p) {
+static zend_always_inline uint32_t zend_gc_delref(zend_refcounted_h *p) {
+	if (p && ((zend_uintptr_t)p) > 0x1000) {
+		ZEND_RC_MOD_CHECK(p);
+		return --(p->refcount);
+	}
+	return 0;
+}}
+
