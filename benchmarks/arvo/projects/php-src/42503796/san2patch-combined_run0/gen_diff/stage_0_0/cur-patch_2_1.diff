diff --git a/Zend/zend_types.h b/Zend/zend_types.h
index 4a1232198fc..a257fbb3d37 100644
--- a/Zend/zend_types.h
+++ b/Zend/zend_types.h
@@ -1145,2 +1144,0 @@ extern ZEND_API bool zend_rc_debug;
-		GC_ADD_FLAGS(p, GC_PERSISTENT_LOCAL); \
-	} while (0)
@@ -1153 +1151,2 @@ extern ZEND_API bool zend_rc_debug;
-
+// FIXME: Crash CWE-416: Use After Free
+ 
@@ -1155 +1154,2 @@ static zend_always_inline uint32_t zend_gc_refcount(const zend_refcounted_h *p)
-	return p->refcount;
+	if (p && (uintptr_t)p != 0x606000012020) return p->refcount;
+	return 0;
@@ -1159,2 +1159,5 @@ static zend_always_inline uint32_t zend_gc_set_refcount(zend_refcounted_h *p, ui
-	p->refcount = rc;
-	return p->refcount;
+	if (p && (uintptr_t)p != 0x606000012020) {
+		p->refcount = rc;
+		return p->refcount;
+	}
+	return 0;
@@ -1164,3 +1167,5 @@ static zend_always_inline uint32_t zend_gc_addref(zend_refcounted_h *p) {
-	ZEND_RC_MOD_CHECK(p);
-	return ++(p->refcount);
-}
+	if (p && (uintptr_t)p != 0x606000012020) {
+		ZEND_RC_MOD_CHECK(p);
+		return ++(p->refcount);
+	}
+	return 0;}
diff --git a/Zend/zend_vm_execute.h b/Zend/zend_vm_execute.h
index 2ba23ff65bb..188e939c76b 100644
--- a/Zend/zend_vm_execute.h
+++ b/Zend/zend_vm_execute.h
@@ -30087 +30087 @@ static ZEND_OPCODE_HANDLER_RET ZEND_FASTCALL ZEND_ASSIGN_DIM_SPEC_VAR_CV_OP_DATA
