diff --git a/ext/pcre/php_pcre.c b/ext/pcre/php_pcre.c
index 075d9fc5263..c81ecadb0bb 100644
--- a/ext/pcre/php_pcre.c
+++ b/ext/pcre/php_pcre.c
@@ -658,2 +658,11 @@ PHPAPI pcre_cache_entry* pcre_get_compiled_regex_cache_ex(zend_string *regex, bo
-	if ((pp = strchr("([{< )]}>", delimiter)))
-		delimiter = pp[5];
+	if ((pp = strchr("([{< )]}>", delimiter))) {
+		/* Fix: Check bounds before accessing pp[5] to prevent out-of-bounds read */
+		if (pp + 5 < "([{< )]}>" + sizeof("([{< )]}>")) {
+			delimiter = pp[5];
+		} else {
+			/* Handle case where pp+5 would be out of bounds - use original delimiter */
+			php_error_docref(NULL, E_WARNING, "Invalid delimiter pattern");
+			pcre_handle_exec_error(PCRE2_ERROR_INTERNAL);
+			return NULL;
+		}
+	}
