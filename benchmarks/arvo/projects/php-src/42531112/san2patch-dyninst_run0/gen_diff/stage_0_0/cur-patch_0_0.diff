diff --git a/ext/pcre/php_pcre.c b/ext/pcre/php_pcre.c
index 075d9fc5263..ccdf485aa58 100644
--- a/ext/pcre/php_pcre.c
+++ b/ext/pcre/php_pcre.c
@@ -658,2 +658,10 @@ PHPAPI pcre_cache_entry* pcre_get_compiled_regex_cache_ex(zend_string *regex, bo
-	if ((pp = strchr("([{< )]}>", delimiter)))
-		delimiter = pp[5];
+	if ((pp = strchr("([{< )]}>", delimiter))) {
+		/* Check bounds before accessing pp[5] to prevent out-of-bounds read */
+		if (pp - "([{< )]}>" < 5) {
+			delimiter = pp[5];
+		} else {
+			/* Handle case where delimiter is at position >= 5 in the string */
+			php_error_docref(NULL, E_WARNING, "Invalid delimiter");
+			return NULL;
+		}
+	}
