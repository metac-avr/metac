@@ -5164 +5164,2 @@ static zend_never_inline bool ZEND_FASTCALL zend_fe_reset_iterator(zval *array_p
-	if (UNEXPECTED(!iter) || UNEXPECTED(EG(exception))) {
+// FIXME: Crash CWE-825: Expired Pointer Dereference
+ 	if (UNEXPECTED(!iter) || UNEXPECTED(EG(exception))) {
@@ -5166 +5167,5 @@ static zend_never_inline bool ZEND_FASTCALL zend_fe_reset_iterator(zval *array_p
-			OBJ_RELEASE(&iter->std);
+			if (iter->funcs && iter->funcs->dtor && iter->internal_data.ptr) {
+				iter->funcs->dtor(iter);
+			} else {
+				OBJ_RELEASE(&iter->std);
+			}
