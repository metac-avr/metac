diff --git a/Zend/zend_types.h b/Zend/zend_types.h
index 8f012868dda..ab36a17bfdb 100644
--- a/Zend/zend_types.h
+++ b/Zend/zend_types.h
@@ -1346,3 +1346,7 @@ static zend_always_inline uint32_t zend_gc_delref(zend_refcounted_h *p) {
-	ZEND_ASSERT(p->refcount > 0);
-	ZEND_RC_MOD_CHECK(p);
-	return --(p->refcount);
+	// Add null check to prevent expired pointer dereference vulnerability
+	if (p && !(p->u.type_info & GC_IMMUTABLE)) {
+		ZEND_ASSERT(p->refcount > 0);
+		ZEND_RC_MOD_CHECK(p);
+		return --(p->refcount);
+	}
+	return 0;
