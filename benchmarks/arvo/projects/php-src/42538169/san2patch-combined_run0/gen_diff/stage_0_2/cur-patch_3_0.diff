+++ b/Zend/zend_types.h
@@ -1345,0 +1346,4 @@ static zend_always_inline uint32_t zend_gc_delref(zend_refcounted_h *p) {
+	// Check if pointer is valid before dereferencing to prevent expired pointer dereference
+	if (p == NULL || (p->u.type_info & GC_IMMUTABLE)) {
+		return 0;
+	}
