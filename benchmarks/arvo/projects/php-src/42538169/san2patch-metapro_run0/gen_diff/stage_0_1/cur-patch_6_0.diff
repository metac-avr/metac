diff --git a/Zend/zend_execute.c b/Zend/zend_execute.c
index 733ce54dc24..3aa48787081 100644
--- a/Zend/zend_execute.c
+++ b/Zend/zend_execute.c
@@ -5166 +5166,4 @@ static zend_never_inline bool ZEND_FASTCALL zend_fe_reset_iterator(zval *array_p
-			OBJ_RELEASE(&iter->std);
+			/* Check if iterator object is still valid before releasing */
+			if (!(GC_FLAGS(&iter->std) & IS_OBJ_FREE_CALLED)) {
+				OBJ_RELEASE(&iter->std);
+			}
@@ -5179 +5182,4 @@ static zend_never_inline bool ZEND_FASTCALL zend_fe_reset_iterator(zval *array_p
-			OBJ_RELEASE(&iter->std);
+			/* Validate object before release to prevent expired pointer dereference */
+			if (!(GC_FLAGS(&iter->std) & IS_OBJ_FREE_CALLED)) {
+				OBJ_RELEASE(&iter->std);
+			}
@@ -5188 +5194,4 @@ static zend_never_inline bool ZEND_FASTCALL zend_fe_reset_iterator(zval *array_p
-		OBJ_RELEASE(&iter->std);
+		/* Ensure object validity check before accessing freed memory */
+		if (!(GC_FLAGS(&iter->std) & IS_OBJ_FREE_CALLED)) {
+			OBJ_RELEASE(&iter->std);
+		}
