diff --git a/Zend/zend_types.h b/Zend/zend_types.h
index 8f012868dda..2900b8b6a69 100644
--- a/Zend/zend_types.h
+++ b/Zend/zend_types.h
@@ -1346,3 +1346,6 @@ static zend_always_inline uint32_t zend_gc_delref(zend_refcounted_h *p) {
-	ZEND_ASSERT(p->refcount > 0);
-	ZEND_RC_MOD_CHECK(p);
-	return --(p->refcount);
+	if (p && (p->u.type_info & ~GC_TYPE_MASK) != 0) {
+		ZEND_ASSERT(p->refcount > 0);
+		ZEND_RC_MOD_CHECK(p);
+		return --(p->refcount);
+	}
+	return 0;
@@ -1358,0 +1362 @@ static zend_always_inline uint32_t zend_gc_delref_ex(zend_refcounted_h *p, uint3
+
