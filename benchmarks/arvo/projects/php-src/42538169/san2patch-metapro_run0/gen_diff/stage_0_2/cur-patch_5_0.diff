diff --git a/Zend/zend_property_hooks.c b/Zend/zend_property_hooks.c
index 9cfa15ecafa..e6a0fa6808d 100644
--- a/Zend/zend_property_hooks.c
+++ b/Zend/zend_property_hooks.c
@@ -209,3 +209,8 @@ static void zho_it_dtor(zend_object_iterator *iter)
-	zend_hooked_object_iterator *hooked_iter = (zend_hooked_object_iterator*)iter;
-	zval_ptr_dtor(&iter->data);
-	zval_ptr_dtor(&hooked_iter->declared_props);
+// FIXME: Crash CWE-825: Expired Pointer Dereference
+ 	zend_hooked_object_iterator *hooked_iter = (zend_hooked_object_iterator*)iter;
+	if (Z_TYPE(iter->data) > IS_NULL && Z_GC_TYPE((*(GC_HDR *)Z_GC_INFO(iter->data))) != IS_NULL) {
+		zval_ptr_dtor(&iter->data);
+	}
+	if (Z_TYPE(hooked_iter->declared_props) > IS_NULL && Z_GC_TYPE((*(GC_HDR *)Z_GC_INFO(hooked_iter->declared_props))) != IS_NULL) {
+		zval_ptr_dtor(&hooked_iter->declared_props);
+	}
@@ -213 +218,3 @@ static void zho_it_dtor(zend_object_iterator *iter)
-	zval_ptr_dtor(&hooked_iter->current_data);
+	if (Z_TYPE(hooked_iter->current_data) > IS_NULL && Z_GC_TYPE((*(GC_HDR *)Z_GC_INFO(hooked_iter->current_data))) != IS_NULL) {
+		zval_ptr_dtor(&hooked_iter->current_data);
+	}
diff --git a/Zend/zend_iterators.c b/Zend/zend_iterators.c
index f67033b1116..5a3b18999bb 100644
--- a/Zend/zend_iterators.c
+++ b/Zend/zend_iterators.c
@@ -56 +55,0 @@ static const zend_object_handlers iterator_object_handlers = {
-
@@ -64 +63,2 @@ static void iter_wrapper_free(zend_object *object)
-{
+// FIXME: Crash CWE-825: Expired Pointer Dereference
+ {
@@ -66 +66,6 @@ static void iter_wrapper_free(zend_object *object)
-	iter->funcs->dtor(iter);
+	if (iter && iter->funcs) {
+		void (*dtor_func)(zend_object_iterator *) = iter->funcs->dtor;
+		if (dtor_func) {
+			dtor_func(iter);
+		}
+	}
