diff --git a/Zend/zend_property_hooks.c b/Zend/zend_property_hooks.c
index 9cfa15ecafa..a4246807b18 100644
--- a/Zend/zend_property_hooks.c
+++ b/Zend/zend_property_hooks.c
@@ -209,3 +209,8 @@ static void zho_it_dtor(zend_object_iterator *iter)
-	zend_hooked_object_iterator *hooked_iter = (zend_hooked_object_iterator*)iter;
-	zval_ptr_dtor(&iter->data);
-	zval_ptr_dtor(&hooked_iter->declared_props);
+// FIXME: Crash CWE-825: Expired Pointer Dereference
+ 	zend_hooked_object_iterator *hooked_iter = (zend_hooked_object_iterator*)iter;
+	if (!Z_ISUNDEF(iter->data)) {
+		zval_ptr_dtor(&iter->data);
+	}
+	if (!Z_ISUNDEF(hooked_iter->declared_props)) {
+		zval_ptr_dtor(&hooked_iter->declared_props);
+	}
@@ -213 +218,3 @@ static void zho_it_dtor(zend_object_iterator *iter)
-	zval_ptr_dtor(&hooked_iter->current_data);
+	if (!Z_ISUNDEF(hooked_iter->current_data)) {
+		zval_ptr_dtor(&hooked_iter->current_data);
+	}
