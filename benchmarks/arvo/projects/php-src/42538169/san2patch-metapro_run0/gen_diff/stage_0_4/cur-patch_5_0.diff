diff --git a/Zend/zend_types.h b/Zend/zend_types.h
index 8f012868dda..d0b2ca8c997 100644
--- a/Zend/zend_types.h
+++ b/Zend/zend_types.h
@@ -1345,0 +1346,4 @@ static zend_always_inline uint32_t zend_gc_delref(zend_refcounted_h *p) {
+	/* Fix for CWE-825: Expired Pointer Dereference - validate pointer before dereferencing */
+	if (p == NULL || (uintptr_t)p < 0x1000) {  // Basic sanity check for invalid pointers
+		return 0;
+	}
