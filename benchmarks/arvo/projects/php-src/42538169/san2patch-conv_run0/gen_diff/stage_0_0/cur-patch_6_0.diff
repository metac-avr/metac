diff --git a/Zend/zend_variables.c b/Zend/zend_variables.c
index 27e09d7db22..018143f31e4 100644
--- a/Zend/zend_variables.c
+++ b/Zend/zend_variables.c
@@ -74,2 +74,4 @@ static void ZEND_FASTCALL zend_reference_destroy(zend_reference *ref)
-	i_zval_ptr_dtor(&ref->val);
-	efree_size(ref, sizeof(zend_reference));
+i_zval_ptr_dtor(&ref->val);
+	if (ref != NULL && !GC_IS_RECURSIVE((zend_refcounted*)ref)) {
+		efree_size(ref, sizeof(zend_reference));
+	}
@@ -82 +84,2 @@ static void ZEND_FASTCALL zend_empty_destroy(zend_reference *ref)
-ZEND_API void zval_ptr_dtor(zval *zval_ptr) /* {{{ */
+// FIXME: Crash CWE-825: Expired Pointer Dereference
+ ZEND_API void zval_ptr_dtor(zval *zval_ptr) /* {{{ */
@@ -84 +87,8 @@ ZEND_API void zval_ptr_dtor(zval *zval_ptr) /* {{{ */
-	i_zval_ptr_dtor(zval_ptr);
+	if (zval_ptr != NULL && Z_REFCOUNTED_P(zval_ptr)) {
+		zend_refcounted *ref = Z_COUNTED_P(zval_ptr);
+		if (!GC_IS_RECURSIVE(ref)) {
+			i_zval_ptr_dtor(zval_ptr);
+		}
+	} else if (zval_ptr != NULL) {
+		i_zval_ptr_dtor(zval_ptr);
+	}
@@ -90,6 +100 @@ ZEND_API void zval_internal_ptr_dtor(zval *zval_ptr) /* {{{ */
-	if (Z_REFCOUNTED_P(zval_ptr)) {
-		zend_refcounted *ref = Z_COUNTED_P(zval_ptr);
-
-		if (GC_DELREF(ref) == 0) {
-			if (Z_TYPE_P(zval_ptr) == IS_STRING) {
-				zend_string *str = (zend_string*)ref;
+	if (Z_REFCOUNTED_P(zval_ptr)) {				zend_string *str = (zend_string*)ref;
