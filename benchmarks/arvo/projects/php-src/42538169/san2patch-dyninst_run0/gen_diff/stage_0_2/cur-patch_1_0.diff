diff --git a/Zend/zend_types.h b/Zend/zend_types.h
index 8f012868dda..f4a954f4f24 100644
--- a/Zend/zend_types.h
+++ b/Zend/zend_types.h
@@ -1345,0 +1346,2 @@ static zend_always_inline uint32_t zend_gc_delref(zend_refcounted_h *p) {
+	// FIXME: Crash CWE-825: Expired Pointer Dereference
+	if (!p || (uintptr_t)p == (uintptr_t)0xdeadbeef) return 0; // Additional check for expired/invalid pointer
diff --git a/Zend/zend_property_hooks.c b/Zend/zend_property_hooks.c
index 9cfa15ecafa..53d9b1c5acf 100644
--- a/Zend/zend_property_hooks.c
+++ b/Zend/zend_property_hooks.c
@@ -210,6 +210,22 @@ static void zho_it_dtor(zend_object_iterator *iter)
-	zval_ptr_dtor(&iter->data);
-	zval_ptr_dtor(&hooked_iter->declared_props);
-	zval_ptr_dtor_nogc(&hooked_iter->current_key);
-	zval_ptr_dtor(&hooked_iter->current_data);
-	if (hooked_iter->dynamic_prop_it != (uint32_t) -1) {
-		zend_hash_iterator_del(hooked_iter->dynamic_prop_it);
+	if (iter) {
+		ZVAL_DEREF(&iter->data);
+		if (Z_OBJ(iter->data)) {
+			zval_ptr_dtor(&iter->data);
+		}
+	}
+	if (hooked_iter) {
+		ZVAL_DEREF(&hooked_iter->declared_props);
+		if (Z_OBJ(hooked_iter->declared_props)) {
+			zval_ptr_dtor(&hooked_iter->declared_props);
+		}
+		ZVAL_DEREF(&hooked_iter->current_key);
+		if (Z_OBJ(hooked_iter->current_key)) {
+			zval_ptr_dtor_nogc(&hooked_iter->current_key);
+		}
+		ZVAL_DEREF(&hooked_iter->current_data);
+		if (Z_OBJ(hooked_iter->current_data)) {
+			zval_ptr_dtor(&hooked_iter->current_data);
+		}
+		if (hooked_iter->dynamic_prop_it != (uint32_t) -1) {
+			zend_hash_iterator_del(hooked_iter->dynamic_prop_it);
+		}
