diff --git a/Zend/zend_types.h b/Zend/zend_types.h
index 8f012868dda..85cb29cd739 100644
--- a/Zend/zend_types.h
+++ b/Zend/zend_types.h
@@ -1345,0 +1346,7 @@ static zend_always_inline uint32_t zend_gc_delref(zend_refcounted_h *p) {
+	// Patched CWE-825: Validate pointer before dereferencing to prevent expired pointer access
+	if (p == NULL) {
+		return 0;
+	}
+	if (p->u.type_info & GC_IMMUTABLE) {
+		return 0;
+	}
