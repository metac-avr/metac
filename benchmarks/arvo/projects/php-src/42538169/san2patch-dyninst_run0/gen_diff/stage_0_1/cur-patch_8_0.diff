+++ b/Zend/zend_execute.c
@@ -5166 +5166,4 @@ static zend_never_inline bool ZEND_FASTCALL zend_fe_reset_iterator(zval *array_p
-			OBJ_RELEASE(&iter->std);
+			zend_object *obj = &iter->std;
+			if (obj && !(GC_FLAGS(obj->gc) & GC_IMMEDIATE)) {
+				OBJ_RELEASE(obj);
+			}
@@ -5179 +5182,4 @@ static zend_never_inline bool ZEND_FASTCALL zend_fe_reset_iterator(zval *array_p
-			OBJ_RELEASE(&iter->std);
+			zend_object *obj = &iter->std;
+			if (obj && !(GC_FLAGS(obj->gc) & GC_IMMEDIATE)) {
+				OBJ_RELEASE(obj);
+			}
@@ -5188 +5194,4 @@ static zend_never_inline bool ZEND_FASTCALL zend_fe_reset_iterator(zval *array_p
