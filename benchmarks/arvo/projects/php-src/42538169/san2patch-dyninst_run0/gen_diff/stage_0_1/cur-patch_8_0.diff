diff --git a/Zend/zend_types.h b/Zend/zend_types.h
index 8f012868dda..534098bfa45 100644
--- a/Zend/zend_types.h
+++ b/Zend/zend_types.h
@@ -1345,0 +1346,7 @@ static zend_always_inline uint32_t zend_gc_delref(zend_refcounted_h *p) {
+	// Security fix for CWE-825: Check if pointer is valid before accessing refcount
+	if (!p) {
+		return 0;
+	}
+	if (p->u.type_info & GC_FREE_TAG) {
+		return 0;
+	}
