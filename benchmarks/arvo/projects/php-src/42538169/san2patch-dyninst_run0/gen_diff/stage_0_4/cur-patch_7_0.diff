+++ b/Zend/zend_objects_API.c
@@ -192 +192,2 @@ ZEND_API void ZEND_FASTCALL zend_objects_store_del(zend_object *object) /* {{{ *
-			GC_ADD_FLAGS(object, IS_OBJ_FREE_CALLED);
