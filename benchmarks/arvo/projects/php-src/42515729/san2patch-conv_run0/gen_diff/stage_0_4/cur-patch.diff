diff --git a/ext/date/php_date.c b/ext/date/php_date.c
index abda2a305c7..eb93a42b8ee 100644
--- a/ext/date/php_date.c
+++ b/ext/date/php_date.c
@@ -2267 +2267,2 @@ static void update_errors_warnings(timelib_error_container **last_errors) /* {{{
-{
+// Fixed CWE-825: Expired Pointer Dereference - avoid accessing freed memory
+ {
@@ -2278,0 +2280,2 @@ static void update_errors_warnings(timelib_error_container **last_errors) /* {{{
+		*last_errors = NULL;
+		return;
@@ -2280 +2282,0 @@ static void update_errors_warnings(timelib_error_container **last_errors) /* {{{
-
@@ -2332,2 +2334,11 @@ PHPAPI bool php_date_initialize(php_date_obj *dateobj, const char *time_str, siz
-	/* update last errors and warnings */
-	update_errors_warnings(&err);
+	/* Prevent use-after-free by ensuring error container is properly handled */
+	if (err) {
+		/* Make a copy of the error structure before calling update_errors_warnings */
+		timelib_error_container temp_container;
+		memcpy(&temp_container, err, sizeof(timelib_error_container));
+		update_errors_warnings(&err);
+		/* Clear the original pointer to prevent accidental reuse */
+		err = NULL;
+	} else {
+		update_errors_warnings(&err);
+	}
@@ -2343,2 +2354 @@ PHPAPI bool php_date_initialize(php_date_obj *dateobj, const char *time_str, siz
-		dateobj->time = 0;
-		return 0;
+		dateobj->time = 0;		return 0;
