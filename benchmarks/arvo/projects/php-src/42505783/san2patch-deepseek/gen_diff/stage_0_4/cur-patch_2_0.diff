diff --git a/ext/opcache/jit/zend_jit_helpers.c b/ext/opcache/jit/zend_jit_helpers.c
index 3653f9dc286..002c4ab5b89 100644
--- a/ext/opcache/jit/zend_jit_helpers.c
+++ b/ext/opcache/jit/zend_jit_helpers.c
@@ -1994,0 +1995 @@ static void ZEND_FASTCALL zend_jit_assign_to_typed_prop(zval *property_val, zend
+	zend_bool protect_value = 0;
@@ -2012 +2013,6 @@ static void ZEND_FASTCALL zend_jit_assign_to_typed_prop(zval *property_val, zend
-	ZVAL_COPY(&tmp, value);
+// Keep a reference for the JIT helper by incrementing refcount before any possible free.
+	if (Z_TYPE_P(value) == IS_STRING && Z_REFCOUNTED_P(value)) {
+		GC_ADDREF(Z_STR_P(value));
+		protect_value = 1;
+	}
+ 	ZVAL_COPY(&tmp, value);
@@ -2018,0 +2025,3 @@ static void ZEND_FASTCALL zend_jit_assign_to_typed_prop(zval *property_val, zend
+		if (protect_value) {
+			zend_string_release(Z_STR_P(value));
+		}
@@ -2022,0 +2032,3 @@ static void ZEND_FASTCALL zend_jit_assign_to_typed_prop(zval *property_val, zend
+	if (protect_value) {
+		zend_string_release(Z_STR_P(value));
+	}
