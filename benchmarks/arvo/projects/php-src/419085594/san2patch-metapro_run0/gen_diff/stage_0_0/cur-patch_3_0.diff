diff --git a/Zend/zend_execute.c b/Zend/zend_execute.c
index 7879f0ad984..0562a015894 100644
--- a/Zend/zend_execute.c
+++ b/Zend/zend_execute.c
@@ -1412,0 +1413,2 @@ static zend_always_inline int zend_binary_op(zval *ret, zval *op1, zval *op2 OPL
+	zval op1_copy, op2_copy;
+	int result;
@@ -1414 +1416,9 @@ static zend_always_inline int zend_binary_op(zval *ret, zval *op1, zval *op2 OPL
-	return zend_binary_ops[opcode - ZEND_ADD](ret, op1, op2);
+	ZVAL_COPY(&op1_copy, op1);
+	ZVAL_COPY(&op2_copy, op2);
+
+	result = zend_binary_ops[opcode - ZEND_ADD](ret, &op1_copy, &op2_copy);
+
+	zval_ptr_dtor(&op1_copy);
+	zval_ptr_dtor(&op2_copy);
+
+	return result;
diff --git a/Zend/zend_vm_execute.h b/Zend/zend_vm_execute.h
