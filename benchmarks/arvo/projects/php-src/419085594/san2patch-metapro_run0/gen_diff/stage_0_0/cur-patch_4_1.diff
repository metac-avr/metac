diff --git a/Zend/zend_execute.c b/Zend/zend_execute.c
index 7879f0ad984..78034e9ea03 100644
--- a/Zend/zend_execute.c
+++ b/Zend/zend_execute.c
@@ -1412,0 +1413 @@ static zend_always_inline int zend_binary_op(zval *ret, zval *op1, zval *op2 OPL
+	zval *op1_ptr, *op2_ptr;
@@ -1414 +1415,26 @@ static zend_always_inline int zend_binary_op(zval *ret, zval *op1, zval *op2 OPL
-	return zend_binary_ops[opcode - ZEND_ADD](ret, op1, op2);
+	if (Z_REFCOUNTED_P(op1)) {
+		op1_ptr = (zval*)emalloc(sizeof(zval));
+		ZVAL_COPY(op1_ptr, op1);
+	} else {
+		op1_ptr = op1;
+	}
+
+	if (Z_REFCOUNTED_P(op2)) {
+		op2_ptr = (zval*)emalloc(sizeof(zval));
+		ZVAL_COPY(op2_ptr, op2);
+	} else {
+		op2_ptr = op2;
+	}
+
+	int result = zend_binary_ops[opcode - ZEND_ADD](ret, op1_ptr, op2_ptr);
+
+	if (Z_REFCOUNTED_P(op1) && op1_ptr != op1) {
+		zval_ptr_dtor(op1_ptr);
+		efree(op1_ptr);
+	}
+	if (Z_REFCOUNTED_P(op2) && op2_ptr != op2) {
+		zval_ptr_dtor(op2_ptr);
+		efree(op2_ptr);
+	}
+
+	return result;
diff --git a/Zend/zend_vm_execute.h b/Zend/zend_vm_execute.h
index 2ba23ff65bb..1535bfa2cca 100644
--- a/Zend/zend_vm_execute.h
+++ b/Zend/zend_vm_execute.h
@@ -45992,0 +45993,2 @@ static ZEND_OPCODE_HANDLER_RET ZEND_FASTCALL ZEND_ASSIGN_DIM_OP_SPEC_CV_UNUSED_H
+			ZVAL_DEREF(var_ptr);
+			Z_TRY_ADDREF_P(var_ptr);
