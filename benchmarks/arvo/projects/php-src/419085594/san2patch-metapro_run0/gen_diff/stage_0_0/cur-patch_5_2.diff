diff --git a/Zend/zend_execute.c b/Zend/zend_execute.c
index 7879f0ad984..89f65224228 100644
--- a/Zend/zend_execute.c
+++ b/Zend/zend_execute.c
@@ -1412,0 +1413,3 @@ static zend_always_inline int zend_binary_op(zval *ret, zval *op1, zval *op2 OPL
+	zval temp_op1, temp_op2;
+	zval *use_op1 = op1;
+	zval *use_op2 = op2;
@@ -1414 +1417,10 @@ static zend_always_inline int zend_binary_op(zval *ret, zval *op1, zval *op2 OPL
-	return zend_binary_ops[opcode - ZEND_ADD](ret, op1, op2);
+	if (Z_REFCOUNT_P(op1) <= 1) {
+		ZVAL_COPY_VALUE(&temp_op1, op1);
+		use_op1 = &temp_op1;
+	}
+	if (Z_REFCOUNT_P(op2) <= 1) {
+		ZVAL_COPY_VALUE(&temp_op2, op2);
+		use_op2 = &temp_op2;
+	}
+
+	return zend_binary_ops[opcode - ZEND_ADD](ret, use_op1, use_op2);
diff --git a/Zend/zend_vm_execute.h b/Zend/zend_vm_execute.h
index 2ba23ff65bb..ea606fa2b6c 100644
--- a/Zend/zend_vm_execute.h
+++ b/Zend/zend_vm_execute.h
@@ -45992,0 +45993,3 @@ static ZEND_OPCODE_HANDLER_RET ZEND_FASTCALL ZEND_ASSIGN_DIM_OP_SPEC_CV_UNUSED_H
+			zval temp_val;
+			ZVAL_COPY(&temp_val, var_ptr);
+			var_ptr = &temp_val;
