diff --git a/Zend/zend_execute.c b/Zend/zend_execute.c
index 7879f0ad984..22524667ec7 100644
--- a/Zend/zend_execute.c
+++ b/Zend/zend_execute.c
@@ -1414 +1414,11 @@ static zend_always_inline int zend_binary_op(zval *ret, zval *op1, zval *op2 OPL
-	return zend_binary_ops[opcode - ZEND_ADD](ret, op1, op2);
+	/* Create temporary copies to avoid accessing freed memory */
+	zval temp_op1, temp_op2;
+	ZVAL_COPY(&temp_op1, op1);
+	ZVAL_COPY(&temp_op2, op2);
+
+	int result = zend_binary_ops[opcode - ZEND_ADD](ret, &temp_op1, &temp_op2);
+	
+	zval_ptr_dtor(&temp_op1);
+	zval_ptr_dtor(&temp_op2);
+	
+	return result;
diff --git a/Zend/zend_operators.c b/Zend/zend_operators.c
index 4d3fe724769..c8d56eea847 100644
--- a/Zend/zend_operators.c
+++ b/Zend/zend_operators.c
@@ -1894,5 +1894,6 @@ ZEND_API zend_result ZEND_FASTCALL concat_function(zval *result, zval *op1, zval
-	 	if (UNEXPECTED(Z_TYPE_P(op1) != IS_STRING)) {
-	 		if (Z_ISREF_P(op1)) {
-	 			op1 = Z_REFVAL_P(op1);
-	 			if (Z_TYPE_P(op1) == IS_STRING) break;
-	 		}
+		if (UNEXPECTED(Z_TYPE_P(op1) != IS_STRING)) {
+			zval *safe_op1 = op1;
+			if (Z_ISREF_P(op1)) {
+				safe_op1 = Z_REFVAL_P(op1);
+				if (Z_TYPE_P(safe_op1) == IS_STRING) break;
+			}
@@ -1900 +1901 @@ ZEND_API zend_result ZEND_FASTCALL concat_function(zval *result, zval *op1, zval
-			ZVAL_STR(&op1_copy, zval_get_string_func(op1));
+			ZVAL_STR(&op1_copy, zval_get_string_func(safe_op1));
