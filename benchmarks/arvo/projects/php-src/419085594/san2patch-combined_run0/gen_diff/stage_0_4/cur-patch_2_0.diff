diff --git a/Zend/zend_vm_execute.h b/Zend/zend_vm_execute.h
index 2ba23ff65bb..e8ed8f1ba39 100644
--- a/Zend/zend_vm_execute.h
+++ b/Zend/zend_vm_execute.h
@@ -46004 +46004,2 @@ static ZEND_OPCODE_HANDLER_RET ZEND_FASTCALL ZEND_ASSIGN_DIM_OP_SPEC_CV_UNUSED_H
-				}
+// FIXME: Crash CWE-416: Use After Free
+ 				}
@@ -46006 +46007,4 @@ static ZEND_OPCODE_HANDLER_RET ZEND_FASTCALL ZEND_ASSIGN_DIM_OP_SPEC_CV_UNUSED_H
-			zend_binary_op(var_ptr, var_ptr, value OPLINE_CC);
+			zval *temp_var_ptr = var_ptr;
+			Z_TRY_ADDREF_P(temp_var_ptr);
+			zend_binary_op(var_ptr, temp_var_ptr, value OPLINE_CC);
+			Z_TRY_DELREF_P(temp_var_ptr);
diff --git a/Zend/zend_execute.c b/Zend/zend_execute.c
index 7879f0ad984..f6f325f9022 100644
--- a/Zend/zend_execute.c
+++ b/Zend/zend_execute.c
@@ -1414 +1414,10 @@ static zend_always_inline int zend_binary_op(zval *ret, zval *op1, zval *op2 OPL
-	return zend_binary_ops[opcode - ZEND_ADD](ret, op1, op2);
+	zval temp_op1;
+	zval temp_op2;
+	ZVAL_COPY_VALUE(&temp_op1, op1);
+	ZVAL_COPY_VALUE(&temp_op2, op2);
+	Z_TRY_ADDREF(temp_op1);
+	Z_TRY_ADDREF(temp_op2);
+	int result = zend_binary_ops[opcode - ZEND_ADD](ret, &temp_op1, &temp_op2);
+	zval_ptr_dtor(&temp_op1);
+	zval_ptr_dtor(&temp_op2);
+	return result;
