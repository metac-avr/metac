diff --git a/Zend/zend_vm_execute.h b/Zend/zend_vm_execute.h
index 2ba23ff65bb..9b3253aa353 100644
--- a/Zend/zend_vm_execute.h
+++ b/Zend/zend_vm_execute.h
@@ -45992,0 +45993,5 @@ static ZEND_OPCODE_HANDLER_RET ZEND_FASTCALL ZEND_ASSIGN_DIM_OP_SPEC_CV_UNUSED_H
+// Fixed CWE-416: Use After Free by ensuring zval is copied before operations
+			ZVAL_DEREF(var_ptr); // Ensure we're working with the actual value, not a reference
+			zval temp_val;
+			ZVAL_COPY(&temp_val, var_ptr); // Create a local copy to prevent use-after-free
+			var_ptr = &temp_val;
