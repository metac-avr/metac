diff --git a/Zend/zend_hash.c b/Zend/zend_hash.c
index 8ee292106a6..ef2a79a4c93 100644
--- a/Zend/zend_hash.c
+++ b/Zend/zend_hash.c
@@ -1682,0 +1683,8 @@ ZEND_API void ZEND_FASTCALL zend_array_destroy(HashTable *ht)
+	
+	/* Mark all buckets as undefined before freeing to prevent use-after-free */
+	p = ht->arData;
+	end = p + ht->nNumUsed;
+	do {
+		ZVAL_UNDEF(&p->val);
+	} while (++p != end);
