diff --git a/Zend/zend_vm_execute.h b/Zend/zend_vm_execute.h
index 2ba23ff65bb..78a993dc1bf 100644
--- a/Zend/zend_vm_execute.h
+++ b/Zend/zend_vm_execute.h
@@ -45977 +45977 @@ static ZEND_OPCODE_HANDLER_RET ZEND_FASTCALL ZEND_ASSIGN_DIM_OP_SPEC_CV_UNUSED_H
-		dim = NULL;
+ 		dim = NULL;
@@ -46006 +46006,5 @@ static ZEND_OPCODE_HANDLER_RET ZEND_FASTCALL ZEND_ASSIGN_DIM_OP_SPEC_CV_UNUSED_H
-			zend_binary_op(var_ptr, var_ptr, value OPLINE_CC);
+			/* Add defensive check to prevent UAF - copy value before operation */
+			zval temp_value;
+			ZVAL_COPY(&temp_value, value);
+			zend_binary_op(var_ptr, var_ptr, &temp_value OPLINE_CC);
+			zval_ptr_dtor(&temp_value);
