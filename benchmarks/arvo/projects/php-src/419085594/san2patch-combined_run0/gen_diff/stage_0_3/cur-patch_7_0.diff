diff --git a/Zend/zend_operators.c b/Zend/zend_operators.c
index 4d3fe724769..f16e313be90 100644
--- a/Zend/zend_operators.c
+++ b/Zend/zend_operators.c
@@ -1894,5 +1894,12 @@ ZEND_API zend_result ZEND_FASTCALL concat_function(zval *result, zval *op1, zval
-	 	if (UNEXPECTED(Z_TYPE_P(op1) != IS_STRING)) {
-	 		if (Z_ISREF_P(op1)) {
-	 			op1 = Z_REFVAL_P(op1);
-	 			if (Z_TYPE_P(op1) == IS_STRING) break;
-	 		}
+		if (UNEXPECTED(Z_TYPE_P(op1) != IS_STRING)) {
+			if (Z_ISREF_P(op1)) {
+				op1 = Z_REFVAL_P(op1);
+				if (Z_TYPE_P(op1) == IS_STRING) break;
+			}
+			/* Verify op1 is not freed/invalid before object operation */
+			if (UNEXPECTED(Z_COUNTED_P(op1) && GC_IS_RECURSIVE(Z_COUNTED_P(op1)))) {
+				if (orig_op1 != result) {
+					ZVAL_UNDEF(result);
+				}
+				return FAILURE;
+			}
diff --git a/Zend/zend_execute.c b/Zend/zend_execute.c
index 7879f0ad984..eee3d1f4f9a 100644
--- a/Zend/zend_execute.c
+++ b/Zend/zend_execute.c
@@ -412 +412,5 @@ static zend_always_inline zval *_get_op_data_zval_ptr_r(int op_type, znode_op no
-			return RT_CONSTANT(opline + 1, node);
+			zval *const_val = RT_CONSTANT(opline + 1, node);
+			if (const_val) {
+				if (Z_REFCOUNTED_P(const_val)) Z_ADDREF_P(const_val);
+			}
+			return const_val;
