diff --git a/Zend/zend_execute.c b/Zend/zend_execute.c
index 7879f0ad984..74ba6699839 100644
--- a/Zend/zend_execute.c
+++ b/Zend/zend_execute.c
@@ -1414 +1414,4 @@ static zend_always_inline int zend_binary_op(zval *ret, zval *op1, zval *op2 OPL
-	return zend_binary_ops[opcode - ZEND_ADD](ret, op1, op2);
+	if (opcode >= ZEND_ADD && opcode <= ZEND_POW) {
+		return zend_binary_ops[opcode - ZEND_ADD](ret, op1, op2);
+	}
+	return FAILURE;
diff --git a/Zend/zend_vm_execute.h b/Zend/zend_vm_execute.h
index 2ba23ff65bb..bca2ca3a686 100644
--- a/Zend/zend_vm_execute.h
+++ b/Zend/zend_vm_execute.h
@@ -45992,0 +45993,8 @@ static ZEND_OPCODE_HANDLER_RET ZEND_FASTCALL ZEND_ASSIGN_DIM_OP_SPEC_CV_UNUSED_H
+			// Ensure var_ptr is valid before proceeding to prevent use-after-free
+			if (UNEXPECTED(Z_TYPE_P(var_ptr) == IS_NULL || Z_TYPE_P(var_ptr) == IS_UNDEF)) {
+				ZVAL_EMPTY_STRING(var_ptr);
+			} else if (Z_REFCOUNTED_P(var_ptr) && UNEXPECTED(GC_DELREF(Z_COUNTED_P(var_ptr)) == 0)) {
+				// If refcount reaches zero, reinitialize to prevent dangling pointer
+				GC_ADDREF(Z_COUNTED_P(var_ptr));
+				ZVAL_EMPTY_STRING(var_ptr);
+			}
