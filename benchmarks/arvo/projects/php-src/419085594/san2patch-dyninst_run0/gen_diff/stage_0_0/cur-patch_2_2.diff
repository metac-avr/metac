diff --git a/Zend/zend_execute.c b/Zend/zend_execute.c
index 7879f0ad984..e0f879c1238 100644
--- a/Zend/zend_execute.c
+++ b/Zend/zend_execute.c
@@ -1414 +1414,5 @@ static zend_always_inline int zend_binary_op(zval *ret, zval *op1, zval *op2 OPL
-	return zend_binary_ops[opcode - ZEND_ADD](ret, op1, op2);
+	int result = FAILURE;
+	if (opcode >= ZEND_ADD && opcode <= ZEND_POW) {
+		result = zend_binary_ops[opcode - ZEND_ADD](ret, op1, op2);
+	}
+	return result;
