diff --git a/Zend/zend_vm_execute.h b/Zend/zend_vm_execute.h
index 2ba23ff65bb..9e3d65eccea 100644
--- a/Zend/zend_vm_execute.h
+++ b/Zend/zend_vm_execute.h
@@ -46004 +46004,2 @@ static ZEND_OPCODE_HANDLER_RET ZEND_FASTCALL ZEND_ASSIGN_DIM_OP_SPEC_CV_UNUSED_H
-				}
+// FIXME: Crash CWE-416: Use After Free
+ 				}
@@ -46006 +46007,7 @@ static ZEND_OPCODE_HANDLER_RET ZEND_FASTCALL ZEND_ASSIGN_DIM_OP_SPEC_CV_UNUSED_H
-			zend_binary_op(var_ptr, var_ptr, value OPLINE_CC);
+			
+			// Validate zval before accessing to prevent use-after-free
+			zval *safe_var_ptr = var_ptr;
+			if (UNEXPECTED(Z_TYPE_P(safe_var_ptr) == IS_NULL || Z_TYPE_P(safe_var_ptr) == IS_UNDEF)) {
+				ZVAL_EMPTY_STRING(safe_var_ptr);
+			}
+			zend_binary_op(safe_var_ptr, safe_var_ptr, value OPLINE_CC);
diff --git a/Zend/zend_operators.c b/Zend/zend_operators.c
index 4d3fe724769..624778e373d 100644
--- a/Zend/zend_operators.c
+++ b/Zend/zend_operators.c
@@ -1894,5 +1894,10 @@ ZEND_API zend_result ZEND_FASTCALL concat_function(zval *result, zval *op1, zval
-	 	if (UNEXPECTED(Z_TYPE_P(op1) != IS_STRING)) {
-	 		if (Z_ISREF_P(op1)) {
-	 			op1 = Z_REFVAL_P(op1);
-	 			if (Z_TYPE_P(op1) == IS_STRING) break;
-	 		}
+		if (UNEXPECTED(Z_TYPE_P(op1) != IS_STRING)) {
+			if (Z_ISREF_P(op1)) {
+				op1 = Z_REFVAL_P(op1);
+				if (Z_TYPE_P(op1) == IS_STRING) break;
+			}
+			/* Validate op1 before proceeding to prevent use-after-free */
+			if (UNEXPECTED(!op1 || Z_TYPE_P(op1) == IS_NULL)) {
+				ZVAL_EMPTY_STRING(result);
+				return SUCCESS;
+			}
