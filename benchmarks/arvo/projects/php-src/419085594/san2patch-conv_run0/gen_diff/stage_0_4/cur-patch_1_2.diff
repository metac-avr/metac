+	static zend_opcode_handler_ret ZEND_ASSIGN_DIM_OP_SPEC_CV_CONST_HANDLER(ZEND_OPCODE_HANDLER_ARGS)
+{
+	zend_op *opline = EX(opline);
+	zval *container = GET_OP1_CV_PTR(BP_VAR_RW);
