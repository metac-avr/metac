+	zval *value;
+	zval *var_ptr;
+
@@ -46006 +46014,6 @@ static ZEND_OPCODE_HANDLER_RET ZEND_FASTCALL ZEND_ASSIGN_DIM_OP_SPEC_CV_UNUSED_H
-			zend_binary_op(var_ptr, var_ptr, value OPLINE_CC);
+			
+			zval temp_container;
+			ZVAL_COPY(&temp_container, var_ptr);
+			zend_binary_op(&temp_container, &temp_container, value OPLINE_CC);
+			zval_ptr_dtor(var_ptr);
+			ZVAL_COPY_VALUE(var_ptr, &temp_container);
@@ -46046,0 +46060,3 @@ static ZEND_OPCODE_HANDLER_RET ZEND_FASTCALL ZEND_ASSIGN_DIM_OP_SPEC_CV_UNUSED_H
+	ZEND_VM_NEXT_OPCODE();
+}
