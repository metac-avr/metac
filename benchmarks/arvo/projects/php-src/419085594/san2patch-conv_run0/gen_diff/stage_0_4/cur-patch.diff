diff --git a/Zend/zend_execute.c b/Zend/zend_execute.c
index 7879f0ad984..1ab9ed69e21 100644
--- a/Zend/zend_execute.c
+++ b/Zend/zend_execute.c
@@ -1411 +1411 @@ static zend_always_inline int zend_binary_op(zval *ret, zval *op1, zval *op2 OPL
-	/* size_t cast makes GCC to better optimize 64-bit PIC code */
+	/* size_t cast makes GCC to better optimize 644-bit PIC code */
@@ -1413,0 +1414,8 @@ static zend_always_inline int zend_binary_op(zval *ret, zval *op1, zval *op2 OPL
+	/* Add safety checks to prevent use-after-free vulnerabilities */
+	if (!op1 || !op2) {
+		return FAILURE;
+	}
+	if (Z_REFCOUNT_P(op1) <= 0 || Z_REFCOUNT_P(op2) <= 0) {
+		return FAILURE;
+	}
+
diff --git a/Zend/zend_operators.c b/Zend/zend_operators.c
index 4d3fe724769..4eb7b8e83db 100644
--- a/Zend/zend_operators.c
+++ b/Zend/zend_operators.c
@@ -1894,5 +1894,11 @@ ZEND_API zend_result ZEND_FASTCALL concat_function(zval *result, zval *op1, zval
-	 	if (UNEXPECTED(Z_TYPE_P(op1) != IS_STRING)) {
-	 		if (Z_ISREF_P(op1)) {
-	 			op1 = Z_REFVAL_P(op1);
-	 			if (Z_TYPE_P(op1) == IS_STRING) break;
-	 		}
+		if (UNEXPECTED(Z_TYPE_P(op1) != IS_STRING)) {
+			if (Z_ISREF_P(op1)) {
+				op1 = Z_REFVAL_P(op1);
+				if (Z_TYPE_P(op1) == IS_STRING) break;
+			}
+			if (UNEXPECTED(Z_REFCOUNTED_P(op1) && Z_REFCOUNT_P(op1) <= 0)) {
+				if (orig_op1 != result) {
+					ZVAL_UNDEF(result);
+				}
+				return FAILURE;
+			}
