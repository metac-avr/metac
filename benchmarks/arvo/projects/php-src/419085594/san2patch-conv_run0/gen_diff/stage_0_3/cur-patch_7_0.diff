diff --git a/Zend/zend_execute.c b/Zend/zend_execute.c
index 7879f0ad984..fb8286cac4f 100644
--- a/Zend/zend_execute.c
+++ b/Zend/zend_execute.c
@@ -1413,0 +1414,8 @@ static zend_always_inline int zend_binary_op(zval *ret, zval *op1, zval *op2 OPL
+	if (UNEXPECTED(!op1 || !op2)) {
+		return FAILURE;
+	}
+	
+	if (UNEXPECTED(opcode < ZEND_ADD || opcode > ZEND_POW)) {
+		return FAILURE;
+	}
+
diff --git a/Zend/zend_vm_execute.h b/Zend/zend_vm_execute.h
index 2ba23ff65bb..6bcf91c49d5 100644
--- a/Zend/zend_vm_execute.h
+++ b/Zend/zend_vm_execute.h
@@ -46004 +46004,12 @@ static ZEND_OPCODE_HANDLER_RET ZEND_FASTCALL ZEND_ASSIGN_DIM_OP_SPEC_CV_UNUSED_H
-				}
+// FIXME: Crash CWE-416: Use After Free
+ 				}
+			}
+			/* Validate zval before concatenation to prevent use-after-free */
+			if (value && Z_TYPE_P(value) == IS_STRING) {
+				zend_binary_op(var_ptr, var_ptr, value OPLINE_CC);
+			} else {
+				/* Fallback for invalid values */
+				zval temp_value;
+				ZVAL_STRING(&temp_value, "");
+				zend_binary_op(var_ptr, var_ptr, &temp_value OPLINE_CC);
+				zval_dtor(&temp_value);
@@ -46006 +46016,0 @@ static ZEND_OPCODE_HANDLER_RET ZEND_FASTCALL ZEND_ASSIGN_DIM_OP_SPEC_CV_UNUSED_H
-			zend_binary_op(var_ptr, var_ptr, value OPLINE_CC);
