diff --git a/Zend/zend_execute.c b/Zend/zend_execute.c
index 7879f0ad984..4aef7b39c76 100644
--- a/Zend/zend_execute.c
+++ b/Zend/zend_execute.c
@@ -1413,0 +1414,7 @@ static zend_always_inline int zend_binary_op(zval *ret, zval *op1, zval *op2 OPL
+	if (UNEXPECTED(op1 == NULL || op2 == NULL || 
+	               (opcode >= ZEND_ADD && opcode <= ZEND_POW && 
+	                zend_binary_ops[opcode - ZEND_ADD] == concat_function))) {
+		if (op1 && (Z_TYPE_P(op1) == IS_UNDEF || Z_TYPE_P(op1) == IS_NULL)) return FAILURE;
+		if (op2 && (Z_TYPE_P(op2) == IS_UNDEF || Z_TYPE_P(op2) == IS_NULL)) return FAILURE;
+	}
+
