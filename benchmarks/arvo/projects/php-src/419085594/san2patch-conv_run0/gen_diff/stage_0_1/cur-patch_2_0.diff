diff --git a/Zend/zend_execute.c b/Zend/zend_execute.c
index 7879f0ad984..5b40a4c9a8e 100644
--- a/Zend/zend_execute.c
+++ b/Zend/zend_execute.c
@@ -1412,0 +1413,11 @@ static zend_always_inline int zend_binary_op(zval *ret, zval *op1, zval *op2 OPL
+	zval op1_tmp, op2_tmp;
+	int status;
+
+	if (opcode == ZEND_CONCAT) {
+		ZVAL_DUP(&op1_tmp, op1);
+		ZVAL_DUP(&op2_tmp, op2);
+		status = zend_binary_ops[opcode - ZEND_ADD](ret, &op1_tmp, &op2_tmp);
+		zval_ptr_dtor(&op1_tmp);
+		zval_ptr_dtor(&op2_tmp);
+		return status;
+	}
diff --git a/Zend/zend_vm_execute.h b/Zend/zend_vm_execute.h
index 2ba23ff65bb..4de18ea4cea 100644
--- a/Zend/zend_vm_execute.h
+++ b/Zend/zend_vm_execute.h
@@ -46006 +46006,4 @@ static ZEND_OPCODE_HANDLER_RET ZEND_FASTCALL ZEND_ASSIGN_DIM_OP_SPEC_CV_UNUSED_H
-			zend_binary_op(var_ptr, var_ptr, value OPLINE_CC);
+			zval temp_result;
+			ZVAL_UNDEF(&temp_result);
+			zend_binary_op(&temp_result, var_ptr, value OPLINE_CC);
+			ZVAL_COPY_VALUE(var_ptr, &temp_result);
