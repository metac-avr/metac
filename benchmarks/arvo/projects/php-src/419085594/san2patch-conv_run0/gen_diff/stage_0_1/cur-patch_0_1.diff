diff --git a/Zend/zend_execute.c b/Zend/zend_execute.c
index 7879f0ad984..06519c5075c 100644
--- a/Zend/zend_execute.c
+++ b/Zend/zend_execute.c
@@ -1413,0 +1414,11 @@ static zend_always_inline int zend_binary_op(zval *ret, zval *op1, zval *op2 OPL
+	if (opcode == ZEND_CONCAT) {
+		zval op1_copy, op2_copy;
+		int result;
+		ZVAL_COPY(&op1_copy, op1);
+		ZVAL_COPY(&op2_copy, op2);
+		result = concat_function(ret, &op1_copy, &op2_copy);
+		zval_ptr_dtor(&op1_copy);
+		zval_ptr_dtor(&op2_copy);
+		return result;
+	}
+
