diff --git a/Zend/zend_execute.c b/Zend/zend_execute.c
index 7879f0ad984..4a871e22ce1 100644
--- a/Zend/zend_execute.c
+++ b/Zend/zend_execute.c
@@ -1412,0 +1413,10 @@ static zend_always_inline int zend_binary_op(zval *ret, zval *op1, zval *op2 OPL
+	zval temp_op1, temp_op2;
+
+	if (opcode - ZEND_ADD == ZEND_CONCAT - ZEND_ADD) {
+		ZVAL_COPY(&temp_op1, op1);
+		ZVAL_COPY(&temp_op2, op2);
+		int res = concat_function(ret, &temp_op1, &temp_op2);
+		zval_ptr_dtor(&temp_op1);
+		zval_ptr_dtor(&temp_op2);
+		return res;
+	}
