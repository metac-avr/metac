diff --git a/Zend/zend_attributes.c b/Zend/zend_attributes.c
index af00117369a..1dd862fdbe0 100644
--- a/Zend/zend_attributes.c
+++ b/Zend/zend_attributes.c
@@ -291 +291 @@ ZEND_API zend_result zend_get_attribute_object(zval *obj, zend_class_entry *attr
-
+ 
@@ -292,0 +293,11 @@ ZEND_API zend_result zend_get_attribute_object(zval *obj, zend_class_entry *attr
+		/* Process and release all string keys before destroying the array */
+		zend_string *str_key;
+		zend_ulong num_key;
+		zval *entry;
+		ZEND_HASH_FOREACH_KEY_VAL(named_params, num_key, str_key, entry) {
+			if (str_key) {
+				zend_string_release(str_key);
+			}
+			zval_ptr_dtor(entry);
+		} ZEND_HASH_FOREACH_END();
+		zend_hash_clean(named_params);
