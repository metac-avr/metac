diff --git a/ext/reflection/php_reflection.c b/ext/reflection/php_reflection.c
index f4386babef8..5d83c362f16 100644
--- a/ext/reflection/php_reflection.c
+++ b/ext/reflection/php_reflection.c
@@ -6770,5 +6769,0 @@ ZEND_METHOD(ReflectionAttribute, newInstance)
-		if (!(flags & ZEND_ATTRIBUTE_IS_REPEATABLE)) {
-			if (zend_is_attribute_repeated(attr->attributes, attr->data)) {
-				zend_throw_error(NULL, "Attribute \"%s\" must not be repeated", ZSTR_VAL(attr->data->name));
-				RETURN_THROWS();
-			}
@@ -6778,0 +6774 @@ ZEND_METHOD(ReflectionAttribute, newInstance)
+	zend_bool is_valid_attr = 1;
@@ -6783,0 +6780,16 @@ ZEND_METHOD(ReflectionAttribute, newInstance)
+	if (Z_TYPE(obj) == IS_OBJECT && Z_OBJ(obj)) {
+		zend_object *obj_ptr = Z_OBJ(obj);
+		if (obj_ptr->ce && obj_ptr->ce->name) {
+			zend_string *name_check = obj_ptr->ce->name;
+			if (name_check && GC_TYPE(name_check) != IS_STRING) {
+				is_valid_attr = 0;
+			}
+		}
+	}
+
+	if (!is_valid_attr) {
+		zval_ptr_dtor(&obj);
+		zend_throw_error(NULL, "Invalid attribute object reference");
+		RETURN_THROWS();
+	}
+
@@ -6790,2 +6802 @@ ZEND_METHOD(ReflectionEnum, __construct)
-	if (EG(exception)) {
-		RETURN_THROWS();
+	if (EG(exception)) {		RETURN_THROWS();
