@@ -1839 +1861 @@ ZEND_API void ZEND_FASTCALL zend_array_destroy(HashTable *ht)
-					if (EXPECTED(p->key)) {
+					if (EXPECTED(p->key) && ZSTR_IS_VALID(p->key)) {
@@ -1847 +1869 @@ ZEND_API void ZEND_FASTCALL zend_array_destroy(HashTable *ht)
-						if (EXPECTED(p->key)) {
