diff --git a/ext/reflection/php_reflection.c b/ext/reflection/php_reflection.c
index f4386babef8..bea1cb7cc06 100644
--- a/ext/reflection/php_reflection.c
+++ b/ext/reflection/php_reflection.c
@@ -6770,5 +6770,20 @@ ZEND_METHOD(ReflectionAttribute, newInstance)
-		if (!(flags & ZEND_ATTRIBUTE_IS_REPEATABLE)) {
-			if (zend_is_attribute_repeated(attr->attributes, attr->data)) {
-				zend_throw_error(NULL, "Attribute \"%s\" must not be repeated", ZSTR_VAL(attr->data->name));
-				RETURN_THROWS();
-			}
+ZEND_METHOD(ReflectionAttribute, newInstance)
+{
+	zend_reflection_attribute *attr = Z_REFLECTION_ATTR_P(getThis());
+	zend_class_entry *ce;
+
+	if (attr->data->flags & ZEND_ATTRIBUTE_IS_INSTANCEOF) {
+		ce = zend_lookup_class(attr->data->name);
+	} else {
+		ce = zend_hash_find_ptr(EG(class_table), attr->data->name);
+	}
+
+	if (!ce) {
+		zend_throw_error(NULL, "Class \"%s\" does not exist", ZSTR_VAL(attr->data->name));
+		RETURN_THROWS();
+	}
+
+	if (!(attr->data->flags & ZEND_ATTRIBUTE_IS_REPEATABLE)) {
+		if (zend_is_attribute_repeated(attr->attributes, attr->data)) {
+			zend_throw_error(NULL, "Attribute \"%s\" must not be repeated", ZSTR_VAL(attr->data->name));
+			RETURN_THROWS();
@@ -6778,0 +6794 @@ ZEND_METHOD(ReflectionAttribute, newInstance)
+	zend_object *attr_obj;
@@ -6783,0 +6800,10 @@ ZEND_METHOD(ReflectionAttribute, newInstance)
+	attr_obj = Z_OBJ(obj);
+	if (attr_obj && attr_obj->ce) {
+		zend_string *class_name = attr_obj->ce->name;
+		if (class_name && !ZSTR_IS_INTERNED(class_name)) {
+			if (GC_DELREF(class_name) == 0) {
+				zend_string_release(class_name);
+			}
+		}
+	}
+	
@@ -6785,7 +6811 @@ ZEND_METHOD(ReflectionAttribute, newInstance)
-}
-
-ZEND_METHOD(ReflectionEnum, __construct)
-{
-	reflection_class_object_ctor(INTERNAL_FUNCTION_PARAM_PASSTHRU, 0);
-	if (EG(exception)) {
-		RETURN_THROWS();
+}		RETURN_THROWS();
