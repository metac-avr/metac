+		} else if (HT_IS_WITHOUT_HOLES(ht)) {
+			do {
+				i_zval_ptr_dtor(&p->val);
+				if (EXPECTED(p->key)) {
+					zend_string_release_ex(p->key, 0);
+				}
+			} while (++p != end);
+		} else {
+			do {
+				if (EXPECTED(Z_TYPE(p->val) != IS_UNDEF)) {
@@ -1842,11 +1870,2 @@ ZEND_API void ZEND_FASTCALL zend_array_destroy(HashTable *ht)
-				} while (++p != end);
-			} else {
-				do {
-					if (EXPECTED(Z_TYPE(p->val) != IS_UNDEF)) {
-						i_zval_ptr_dtor(&p->val);
-						if (EXPECTED(p->key)) {
-							zend_string_release_ex(p->key, 0);
-						}
-					}
-				} while (++p != end);
-			}
+				}
+			} while (++p != end);
@@ -1853,0 +1873,2 @@ ZEND_API void ZEND_FASTCALL zend_array_destroy(HashTable *ht)
+	}
+}
