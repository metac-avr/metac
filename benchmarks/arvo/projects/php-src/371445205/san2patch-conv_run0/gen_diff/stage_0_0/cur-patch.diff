+	if (UNEXPECTED(HT_HAS_ITERATORS(ht))) {
+		zend_hash_iterators_reset_all(ht);
+	}
+
+	if (HT_IS_PACKED(ht)) {
+		Bucket *p = ht->arPacked;
+		Bucket *end = p + ht->nNumUsed;
+
+		do {
+			if (Z_TYPE_P(p) != IS_UNDEF) {
+				i_zval_ptr_dtor(p);
+			}
+		} while (++p != end);
+		zend_hash_reset_packed(ht);
+	} else {
+		Bucket *p = ht->arData;
+		Bucket *end = p + ht->nNumUsed;
+
+		if (HT_HAS_STATIC_KEYS_ONLY(ht)) {
+			do {
+				i_zval_ptr_dtor(&p->val);
