diff --git a/ext/reflection/php_reflection.c b/ext/reflection/php_reflection.c
index f4386babef8..8b5a886d3ab 100644
--- a/ext/reflection/php_reflection.c
+++ b/ext/reflection/php_reflection.c
@@ -6770,5 +6770,9 @@ ZEND_METHOD(ReflectionAttribute, newInstance)
-		if (!(flags & ZEND_ATTRIBUTE_IS_REPEATABLE)) {
-			if (zend_is_attribute_repeated(attr->attributes, attr->data)) {
-				zend_throw_error(NULL, "Attribute \"%s\" must not be repeated", ZSTR_VAL(attr->data->name));
-				RETURN_THROWS();
-			}
+ZEND_METHOD(ReflectionAttribute, newInstance)
+{
+	zend_class_entry *ce = Z_OBJCE_P(ZEND_THIS);
+	reflection_attr *attr = ZEND_REFLECTION_ATTR_P(ZEND_THIS);
+
+	if (!(attr->data->flags & ZEND_ATTRIBUTE_IS_REPEATABLE)) {
+		if (zend_is_attribute_repeated(attr->attributes, attr->data)) {
+			zend_throw_error(NULL, "Attribute \"%s\" must not be repeated", ZSTR_VAL(attr->data->name));
+			RETURN_THROWS();
@@ -6784,2 +6788,16 @@ ZEND_METHOD(ReflectionAttribute, newInstance)
-	RETURN_COPY_VALUE(&obj);
-}
+	if (Z_TYPE(obj) == IS_OBJECT) {
+		zend_object *zobj = Z_OBJ(obj);
+		if (zobj && !(GC_FLAGS(zobj) & IS_OBJ_DESTRUCTOR_CALLED)) {
+			if (zobj->ce && zobj->ce->name) {
+				zend_string *cls_name = zobj->ce->name;
+				if (cls_name && ZSTR_VAL(cls_name)) {
+					size_t len_check = ZSTR_LEN(cls_name);
+					if (len_check == 0 || ZSTR_VAL(cls_name)[0] == '\0') {
+						zval_ptr_dtor(&obj);
+						zend_throw_error(NULL, "Attribute class name is invalid");
+						RETURN_THROWS();
+					}
+				}
+			}
+		}
+	}
@@ -6787,5 +6805,2 @@ ZEND_METHOD(ReflectionAttribute, newInstance)
-ZEND_METHOD(ReflectionEnum, __construct)
-{
-	reflection_class_object_ctor(INTERNAL_FUNCTION_PARAM_PASSTHRU, 0);
-	if (EG(exception)) {
-		RETURN_THROWS();
+	RETURN_COPY_VALUE(&obj);
+}		RETURN_THROWS();
diff --git a/Zend/zend_hash.c b/Zend/zend_hash.c
