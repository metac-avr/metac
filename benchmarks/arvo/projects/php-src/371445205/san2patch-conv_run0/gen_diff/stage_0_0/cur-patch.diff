-			Bucket *end = p + ht->nNumUsed;
+		} static void zend_hash_clean_impl(HashTable *ht)
+{
+	if (UNEXPECTED(ht->nNumOfElements == 0)) {
+		return;
+	}
@@ -1832,6 +1834,32 @@ ZEND_API void ZEND_FASTCALL zend_array_destroy(HashTable *ht)
-			if (HT_HAS_STATIC_KEYS_ONLY(ht)) {
