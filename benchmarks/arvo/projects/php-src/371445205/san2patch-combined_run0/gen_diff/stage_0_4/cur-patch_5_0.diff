diff --git a/ext/reflection/php_reflection.c b/ext/reflection/php_reflection.c
index f4386babef8..e26f6a9180c 100644
--- a/ext/reflection/php_reflection.c
+++ b/ext/reflection/php_reflection.c
@@ -6770,5 +6769,0 @@ ZEND_METHOD(ReflectionAttribute, newInstance)
-		if (!(flags & ZEND_ATTRIBUTE_IS_REPEATABLE)) {
-			if (zend_is_attribute_repeated(attr->attributes, attr->data)) {
-				zend_throw_error(NULL, "Attribute \"%s\" must not be repeated", ZSTR_VAL(attr->data->name));
-				RETURN_THROWS();
-			}
@@ -6777,0 +6773 @@ ZEND_METHOD(ReflectionAttribute, newInstance)
+	// FIXME: Crash CWE-825: Expired Pointer Dereference
@@ -6780,2 +6776,14 @@ ZEND_METHOD(ReflectionAttribute, newInstance)
-	if (SUCCESS != zend_get_attribute_object(&obj, ce, attr->data, attr->scope, attr->filename)) {
-		RETURN_THROWS();
+	// Create a local copy to avoid use-after-free
+	zend_attribute local_attr;
+	if (attr->data) {
+		local_attr = *attr->data;
+		local_attr.name = zend_string_copy(attr->data->name);
+		if (SUCCESS != zend_get_attribute_object(&obj, ce, &local_attr, attr->scope, attr->filename)) {
+			zend_string_release(local_attr.name);
+			RETURN_THROWS();
+		}
+		zend_string_release(local_attr.name);
+	} else {
+		if (SUCCESS != zend_get_attribute_object(&obj, ce, attr->data, attr->scope, attr->filename)) {
+			RETURN_THROWS();
+		}
@@ -6783 +6790,0 @@ ZEND_METHOD(ReflectionAttribute, newInstance)
-
@@ -6790,2 +6797 @@ ZEND_METHOD(ReflectionEnum, __construct)
-	if (EG(exception)) {
-		RETURN_THROWS();
+	if (EG(exception)) {		RETURN_THROWS();
