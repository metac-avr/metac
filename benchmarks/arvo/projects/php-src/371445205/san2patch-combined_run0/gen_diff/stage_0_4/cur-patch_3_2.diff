diff --git a/ext/reflection/php_reflection.c b/ext/reflection/php_reflection.c
index f4386babef8..1f672fe536c 100644
--- a/ext/reflection/php_reflection.c
+++ b/ext/reflection/php_reflection.c
@@ -6770,5 +6770,19 @@ ZEND_METHOD(ReflectionAttribute, newInstance)
-		if (!(flags & ZEND_ATTRIBUTE_IS_REPEATABLE)) {
-			if (zend_is_attribute_repeated(attr->attributes, attr->data)) {
-				zend_throw_error(NULL, "Attribute \"%s\" must not be repeated", ZSTR_VAL(attr->data->name));
-				RETURN_THROWS();
-			}
+static void reflection_attribute_get_constructor(INTERNAL_FUNCTION_PARAMETERS)
+{
+	zend_reflection_attribute *attr = NULL;
+	zend_class_entry *ce = NULL;
+
+	if (zend_parse_parameters_throw(ZEND_NUM_ARGS(), "O", &attr, reflection_attribute_ptr) == FAILURE) {
+		return;
+	}
+
+	ce = zend_lookup_class_ex(attr->data->name, NULL, ZEND_FETCH_CLASS_TRAIT);
+	if (!ce) {
+		zend_throw_error(NULL, "Class \"%s\" does not exist", ZSTR_VAL(attr->data->name));
+		RETURN_THROWS();
+	}
+
+	if (!(flags & ZEND_ATTRIBUTE_IS_REPEATABLE)) {
+		if (zend_is_attribute_repeated(attr->attributes, attr->data)) {
+			zend_throw_error(NULL, "Attribute \"%s\" must not be repeated", ZSTR_VAL(attr->data->name));
+			RETURN_THROWS();
@@ -6777,0 +6792 @@ ZEND_METHOD(ReflectionAttribute, newInstance)
+	// Fixed: Crash CWE-825: Expired Pointer Dereference
@@ -6780 +6795,4 @@ ZEND_METHOD(ReflectionAttribute, newInstance)
-	if (SUCCESS != zend_get_attribute_object(&obj, ce, attr->data, attr->scope, attr->filename)) {
+	// Clone the attribute data to prevent use-after-free
+	zend_attribute *cloned_attr = zend_attribute_clone(attr->data);
+	if (SUCCESS != zend_get_attribute_object(&obj, ce, cloned_attr, attr->scope, attr->filename)) {
+		zend_attribute_destroy(cloned_attr);
@@ -6783,0 +6802,2 @@ ZEND_METHOD(ReflectionAttribute, newInstance)
+	// Clean up the cloned attribute after use
+	zend_attribute_destroy(cloned_attr);
@@ -6785,7 +6805 @@ ZEND_METHOD(ReflectionAttribute, newInstance)
-}
