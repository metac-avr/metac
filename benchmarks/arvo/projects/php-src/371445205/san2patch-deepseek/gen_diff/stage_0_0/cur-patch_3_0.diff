diff --git a/ext/reflection/php_reflection.c b/ext/reflection/php_reflection.c
index f4386babef8..b1f7a86fc45 100644
--- a/ext/reflection/php_reflection.c
+++ b/ext/reflection/php_reflection.c
@@ -6783,0 +6784,21 @@ ZEND_METHOD(ReflectionAttribute, newInstance)
+	zend_string *name = Z_STR_P(zend_hash_str_find_ptr(Z_OBJPROP_P(&obj), "name", sizeof("name")-1));
+	if (name != NULL) {
+		zend_string *name_copy = zend_string_copy(name);
+		ZVAL_STR(zend_hash_str_update(Z_OBJPROP_P(&obj), "name", sizeof("name")-1), name_copy);
+	}
+
+	zval *arguments = zend_hash_str_find(Z_OBJPROP_P(&obj), "arguments", sizeof("arguments")-1);
+	if (arguments != NULL && Z_TYPE_P(arguments) == IS_ARRAY) {
+		ZEND_HASH_FOREACH_STR_KEY_VAL(Z_ARRVAL_P(arguments), str_key, val) {
+			if (str_key != NULL) {
+				zend_string *arg_name_copy = zend_string_copy(str_key);
+				zend_hash_update(Z_ARRVAL_P(arguments), arg_name_copy, val);
+				zend_string_release(str_key);
+			}
+			if (Z_TYPE_P(val) == IS_STRING) {
+				zend_string *arg_val_copy = zend_string_copy(Z_STR_P(val));
+				ZVAL_STR(val, arg_val_copy);
+			}
+		} ZEND_HASH_FOREACH_END();
+	}
+
@@ -6790,2 +6811 @@ ZEND_METHOD(ReflectionEnum, __construct)
-	if (EG(exception)) {
-		RETURN_THROWS();
+	if (EG(exception)) {		RETURN_THROWS();
