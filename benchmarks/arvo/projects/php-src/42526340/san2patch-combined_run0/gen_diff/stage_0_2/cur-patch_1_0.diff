diff --git a/Zend/zend_types.h b/Zend/zend_types.h
index df9bff9015e..ed56788ee69 100644
--- a/Zend/zend_types.h
+++ b/Zend/zend_types.h
@@ -1251,7 +1250,0 @@ extern ZEND_API bool zend_rc_debug;
-		GC_ADD_FLAGS(p, GC_PERSISTENT_LOCAL); \
-	} while (0)
-#else
-# define ZEND_RC_MOD_CHECK(p) \
-	do { } while (0)
-# define GC_MAKE_PERSISTENT_LOCAL(p) \
-	do { } while (0)
@@ -1259 +1252,2 @@ extern ZEND_API bool zend_rc_debug;
-
+// FIXME: Crash CWE-825: Expired Pointer Dereference
+ 
@@ -1261 +1255,2 @@ static zend_always_inline uint32_t zend_gc_refcount(const zend_refcounted_h *p)
-	return p->refcount;
+	if (p && (GC_FLAGS(p) & GC_PURGEABLE)) return 0;
+	return p ? p->refcount : 0;
@@ -1271,2 +1266 @@ static zend_always_inline uint32_t zend_gc_addref(zend_refcounted_h *p) {
-	return ++(p->refcount);
-}
+	return ++(p->refcount;}
diff --git a/Zend/zend_objects_API.c b/Zend/zend_objects_API.c
index 80f5b747db7..304114c7a8f 100644
--- a/Zend/zend_objects_API.c
+++ b/Zend/zend_objects_API.c
@@ -202,3 +202,9 @@ ZEND_API void ZEND_FASTCALL zend_objects_store_del(zend_object *object) /* {{{ *
-		ptr = ((char*)object) - object->handlers->offset;
-		GC_REMOVE_FROM_BUFFER(object);
-		efree(ptr);
+// Fixed: Prevent use-after-free by marking object as destroyed before freeing and adding null checks
+		GC_ADD_FLAGS(object, IS_OBJ_DESTRUCTOR_CALLED | IS_OBJ_FREE_CALLED);
+		if (object->handlers) {
+			ptr = ((char*)object) - object->handlers->offset;
+			GC_REMOVE_FROM_BUFFER(object);
+			efree(ptr);
+		} else {
+			GC_REMOVE_FROM_BUFFER(object);
+		}
