diff --git a/Zend/zend_execute_API.c b/Zend/zend_execute_API.c
index 9efe205abe0..fc4e0038eb3 100644
--- a/Zend/zend_execute_API.c
+++ b/Zend/zend_execute_API.c
@@ -215,0 +216,4 @@ static int zval_call_destructor(zval *zv) /* {{{ */
+		zend_object *obj = Z_OBJ_P(zv);
+		if (GC_DELREF(obj) < 0) {
+			return ZEND_HASH_APPLY_REMOVE;
+		}
diff --git a/Zend/zend_objects_API.c b/Zend/zend_objects_API.c
index 80f5b747db7..929b1054a5b 100644
--- a/Zend/zend_objects_API.c
+++ b/Zend/zend_objects_API.c
@@ -195,0 +196,6 @@ ZEND_API void ZEND_FASTCALL zend_objects_store_del(zend_object *object) /* {{{ *
+		
+		/* Clear destructor flag and remove from queues before freeing */
+		if (OBJ_FLAGS(object) & IS_OBJ_DESTRUCTOR_CALLED) {
+			OBJ_FLAGS(object) &= ~IS_OBJ_DESTRUCTOR_CALLED;
+		}
+		
