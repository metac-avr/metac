+	return 0;
@@ -1273,0 +1267,5 @@ static zend_always_inline uint32_t zend_gc_addref(zend_refcounted_h *p) {
+static zend_always_inline uint32_t zend_gc_delref(zend_refcounted_h *p) {
+	if (p) return --(p->refcount);
+	return 0;
+}}
