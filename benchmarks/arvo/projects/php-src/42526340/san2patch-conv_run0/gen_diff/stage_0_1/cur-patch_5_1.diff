--- a/Zend/zend_types.h
+++ b/Zend/zend_types.h
@@ -1251,8 +1250,0 @@ extern ZEND_API bool zend_rc_debug;
-		GC_ADD_FLAGS(p, GC_PERSISTENT_LOCAL); \
-	} while (0)
-#else
-# define ZEND_RC_MOD_CHECK(p) \
-	do { } while (0)
-# define GC_MAKE_PERSISTENT_LOCAL(p) \
-	do { } while (0)
-#endif
@@ -1261 +1253 @@ static zend_always_inline uint32_t zend_gc_refcount(const zend_refcounted_h *p)
-	return p->refcount;
+	return p ? p->refcount : 0;
@@ -1265,2 +1257,2 @@ static zend_always_inline uint32_t zend_gc_set_refcount(zend_refcounted_h *p, ui
-	p->refcount = rc;
-	return p->refcount;
