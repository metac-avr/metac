diff --git a/Zend/zend_types.h b/Zend/zend_types.h
index df9bff9015e..77f9d691281 100644
--- a/Zend/zend_types.h
+++ b/Zend/zend_types.h
@@ -1310 +1310,5 @@ static zend_always_inline uint32_t zval_refcount_p(const zval* pz) {
-	return GC_REFCOUNT(Z_COUNTED_P(pz));
+	zend_refcounted_h *counted = Z_COUNTED_P(pz);
+	if (!counted) {
+		return 0;
+	}
+	return GC_REFCOUNT(counted);
@@ -1320,0 +1325 @@ static zend_always_inline uint32_t zval_addref_p(zval* pz) {
+
diff --git a/Zend/zend_vm_execute.h b/Zend/zend_vm_execute.h
index eb7ef1624b9..68c738ae0ce 100644
--- a/Zend/zend_vm_execute.h
+++ b/Zend/zend_vm_execute.h
@@ -3270 +3270,2 @@ static ZEND_OPCODE_HANDLER_RET ZEND_FASTCALL ZEND_HANDLE_EXCEPTION_SPEC_HANDLER(
-				/* smart branch opcodes may not initialize result */
+// FIXME: Crash CWE-825: Expired Pointer Dereference
+ 				/* smart branch opcodes may not initialize result */
@@ -3272 +3273,7 @@ static ZEND_OPCODE_HANDLER_RET ZEND_FASTCALL ZEND_HANDLE_EXCEPTION_SPEC_HANDLER(
-					zval_ptr_dtor_nogc(EX_VAR(throw_op->result.var));
+					zval *result_var = EX_VAR(throw_op->result.var);
+					if (result_var) {
+						zend_refcounted *ref = Z_COUNTED_P(result_var);
+						if (ref && GC_TYPE(ref) != 0) {
+							zval_ptr_dtor_nogc(result_var);
+						}
+					}
