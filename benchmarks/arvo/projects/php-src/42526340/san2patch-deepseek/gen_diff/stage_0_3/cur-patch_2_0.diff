diff --git a/Zend/zend.c b/Zend/zend.c
index 54e9a85808c..20cb7a1ff8e 100644
--- a/Zend/zend.c
+++ b/Zend/zend.c
@@ -1262 +1262,2 @@ void zend_call_destructors(void) /* {{{ */
-{
+
+ {
@@ -1263,0 +1265,9 @@ void zend_call_destructors(void) /* {{{ */
+		zend_objects_store_mark_destructed(&EG(objects_store));
+		zend_hash_internal_pointer_reset_ex(&EG(symbol_table), &EG(symbol_table).nInternalPointer);
+		while (zend_hash_has_more_elements_ex(&EG(symbol_table), &EG(symbol_table).nInternalPointer) == SUCCESS) {
+			zval *zv = zend_hash_get_current_data_ex(&EG(symbol_table), &EG(symbol_table).nInternalPointer);
+			if (Z_TYPE_P(zv) == IS_OBJECT && Z_OBJ_HANDLER_P(zv, dtor_obj) == NULL) {
+				ZVAL_UNDEF(zv);
+			}
+			zend_hash_move_forward_ex(&EG(symbol_table), &EG(symbol_table).nInternalPointer);
+		}
diff --git a/Zend/zend_hash.c b/Zend/zend_hash.c
