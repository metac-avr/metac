diff --git a/Zend/zend_execute_API.c b/Zend/zend_execute_API.c
index 7b9f8b849dc..38571db593d 100644
--- a/Zend/zend_execute_API.c
+++ b/Zend/zend_execute_API.c
@@ -391 +391,5 @@ void shutdown_executor(void) /* {{{ */
-	zend_shutdown_executor_values(fast_shutdown);
+	/* Guard against use-after-free by validating executor state before cleanup */
+	zend_bool executor_valid = (EG(symbol_table).nTableSize > 0) || (EG(function_table).nTableSize > 0);
+	if (executor_valid) {
+		zend_shutdown_executor_values(fast_shutdown);
+	}
diff --git a/Zend/zend_objects_API.c b/Zend/zend_objects_API.c
index 80f5b747db7..f556ffc7d19 100644
--- a/Zend/zend_objects_API.c
+++ b/Zend/zend_objects_API.c
@@ -202,3 +202,8 @@ ZEND_API void ZEND_FASTCALL zend_objects_store_del(zend_object *object) /* {{{ *
-		ptr = ((char*)object) - object->handlers->offset;
-		GC_REMOVE_FROM_BUFFER(object);
-		efree(ptr);
+// FIXME: Crash CWE-416: Use After Free
+ 		if (GC_TYPE(object) != IS_NULL && object->handlers) {  // Additional safety check
+			ptr = ((char*)object) - object->handlers->offset;
+			GC_REMOVE_FROM_BUFFER(object);
+			efree(ptr);
+		} else {
+			GC_REMOVE_FROM_BUFFER(object);
+		}
