-
-ZEND_API void zval_internal_ptr_dtor(zval *zval_ptr) /* {{{ */
-{
-	if (Z_REFCOUNTED_P(zval_ptr)) {
-		zend_refcounted *ref = Z_COUNTED_P(zval_ptr);
-
-		if (GC_DELREF(ref) == 0) {
