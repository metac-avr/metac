diff --git a/Zend/zend_variables.c b/Zend/zend_variables.c
index 06483d581df..918d309cb10 100644
--- a/Zend/zend_variables.c
+++ b/Zend/zend_variables.c
@@ -56,0 +57,7 @@ ZEND_API void ZEND_FASTCALL rc_dtor_func(zend_refcounted *p)
+	if (UNEXPECTED(GC_TYPE(p) == IS_OBJECT)) {
+		zend_object *obj = (zend_object*)p;
+		if (UNEXPECTED(GC_FLAGS(obj) & GC_FLAGS_DTOR_CALLED)) {
+			return; /* Prevent double destruction and UAF */
+		}
+		GC_SET_FLAGS(obj, GC_FLAGS(obj) | GC_FLAGS_DTOR_CALLED);
+	}
