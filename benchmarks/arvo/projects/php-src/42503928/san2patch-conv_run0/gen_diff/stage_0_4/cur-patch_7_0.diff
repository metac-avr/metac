diff --git a/Zend/zend_variables.c b/Zend/zend_variables.c
index 06483d581df..dd112a7c90c 100644
--- a/Zend/zend_variables.c
+++ b/Zend/zend_variables.c
@@ -56,0 +57,8 @@ ZEND_API void ZEND_FASTCALL rc_dtor_func(zend_refcounted *p)
+	/* Validate object is not already freed before accessing */
+	if (GC_TYPE(p) == IS_OBJECT) {
+		zend_object *obj = (zend_object*)p;
+		/* Check if object memory is valid before proceeding */
+		if (UNEXPECTED((zend_uintptr_t)obj < 0x1000)) {
+			return; /* Invalid pointer - likely already freed */
+		}
+	}
