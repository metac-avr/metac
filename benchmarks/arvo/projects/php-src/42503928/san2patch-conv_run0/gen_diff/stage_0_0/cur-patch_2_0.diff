diff --git a/Zend/zend_execute_API.c b/Zend/zend_execute_API.c
index 7b9f8b849dc..670eb85947c 100644
--- a/Zend/zend_execute_API.c
+++ b/Zend/zend_execute_API.c
@@ -391 +391,6 @@ void shutdown_executor(void) /* {{{ */
-	zend_shutdown_executor_values(fast_shutdown);
+	/* Safely shutdown executor values by checking for valid object store */
+	if (EG(objects_store).top > 0 && EG(objects_store).object_buckets != NULL) {
