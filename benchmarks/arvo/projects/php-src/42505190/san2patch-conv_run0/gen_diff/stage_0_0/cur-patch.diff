diff --git a/Zend/zend_vm_execute.h b/Zend/zend_vm_execute.h
index 2ba23ff65bb..b3f532d2bc2 100644
--- a/Zend/zend_vm_execute.h
+++ b/Zend/zend_vm_execute.h
@@ -58978 +58978 @@ ZEND_API void zend_execute(zend_op_array *op_array, zval *return_value)
-	/* Observer end handlers are called from ZEND_RETURN */
+	/* Cleanup frame after execution to prevent dangling pointers */
diff --git a/Zend/zend_hash.c b/Zend/zend_hash.c
index 8ee292106a6..fdf4642cf07 100644
--- a/Zend/zend_hash.c
+++ b/Zend/zend_hash.c
@@ -1682,0 +1683,5 @@ ZEND_API void ZEND_FASTCALL zend_array_destroy(HashTable *ht)
+	
+	/* Zero out critical fields to prevent dangling pointer access */
+	if (ht->arData) {
+		memset(ht->arData, 0, HT_USED_SIZE(ht));
+	}
