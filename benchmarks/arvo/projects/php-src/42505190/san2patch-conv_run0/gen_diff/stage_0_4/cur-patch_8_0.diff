diff --git a/Zend/zend_vm_execute.h b/Zend/zend_vm_execute.h
index 2ba23ff65bb..1d6445e1353 100644
--- a/Zend/zend_vm_execute.h
+++ b/Zend/zend_vm_execute.h
@@ -58975,5 +58975,14 @@ ZEND_API void zend_execute(zend_op_array *op_array, zval *return_value)
-	i_init_code_execute_data(execute_data, op_array, return_value);
-	ZEND_OBSERVER_FCALL_BEGIN(execute_data);
-	zend_execute_ex(execute_data);
-	/* Observer end handlers are called from ZEND_RETURN */
-	zend_vm_stack_free_call_frame(execute_data);
+	/* Prevent use-after-free by validating pointers before use */
+	zend_bool valid_pointers = (execute_data != NULL) && (op_array != NULL);
+	if (valid_pointers) {
+	  	i_init_code_execute_data(execute_data, op_array, return_value);
+		ZEND_OBSERVER_FCALL_BEGIN(execute_data);
+		zend_execute_ex(execute_data);
+		/* Observer end handlers are called from ZEND_RETURN */
+		zend_vm_stack_free_call_frame(execute_data);
+	} else {
+		/* Clean up allocated resources on invalid pointers */
+		if (execute_data != NULL) {
+			zend_vm_stack_free_call_frame(execute_data);
+		}
+	}
