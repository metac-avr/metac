diff --git a/Zend/zend_hash.c b/Zend/zend_hash.c
index 8ee292106a6..0d4dfe68f03 100644
--- a/Zend/zend_hash.c
+++ b/Zend/zend_hash.c
@@ -1683 +1683,6 @@ ZEND_API void ZEND_FASTCALL zend_array_destroy(HashTable *ht)
-	efree(HT_GET_DATA_ADDR(ht));
+	/* Atomic operation to safely free memory and prevent race conditions */
+	void *data_addr = HT_GET_DATA_ADDR(ht);
+	if (data_addr != NULL) {
+		__atomic_store_n(&ht->arData, NULL, __ATOMIC_RELEASE);
+		efree(data_addr);
+	}
