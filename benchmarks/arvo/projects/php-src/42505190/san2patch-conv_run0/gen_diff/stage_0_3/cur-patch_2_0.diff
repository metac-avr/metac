diff --git a/Zend/zend_hash.c b/Zend/zend_hash.c
index 8ee292106a6..a2349367e89 100644
--- a/Zend/zend_hash.c
+++ b/Zend/zend_hash.c
@@ -1683 +1683,6 @@ ZEND_API void ZEND_FASTCALL zend_array_destroy(HashTable *ht)
-	efree(HT_GET_DATA_ADDR(ht));
+	/* Prevent use-after-free by ensuring data is not accessed after freeing */
+	volatile void *temp_data = HT_GET_DATA_ADDR(ht);
+	if (temp_data != NULL) {
+		HT_GET_DATA_ADDR(ht) = NULL;  /* Nullify pointer before freeing */
+		efree((void*)temp_data);
+	}
