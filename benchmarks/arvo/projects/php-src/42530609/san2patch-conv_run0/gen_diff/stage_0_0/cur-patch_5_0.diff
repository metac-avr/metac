--- a/Zend/zend_vm_execute.h
+++ b/Zend/zend_vm_execute.h
@@ -3201 +3201,8 @@ static zend_never_inline ZEND_OPCODE_HANDLER_RET ZEND_FASTCALL zend_dispatch_try
-			ZVAL_UNDEF(EX(return_value));
+			zend_object *obj = Z_OBJ_P(EX(return_value));
