diff --git a/Zend/zend_variables.c b/Zend/zend_variables.c
index 27e09d7db22..5e09f7819fd 100644
--- a/Zend/zend_variables.c
+++ b/Zend/zend_variables.c
@@ -56,2 +56,4 @@ ZEND_API void ZEND_FASTCALL rc_dtor_func(zend_refcounted *p)
-	ZEND_ASSERT(GC_TYPE(p) <= IS_CONSTANT_AST);
-	zend_rc_dtor_func[GC_TYPE(p)](p);
+	if (p && !(GC_FLAGS(p) & (GC_MARKED|GC_IMM destruct))) {
+		ZEND_ASSERT(GC_TYPE(p) <= IS_CONSTANT_AST);
+		zend_rc_dtor_func[GC_TYPE(p)](p);
+	}
diff --git a/Zend/zend_execute.c b/Zend/zend_execute.c
index fbad44d2f2c..cacb6f924d6 100644
--- a/Zend/zend_execute.c
+++ b/Zend/zend_execute.c
@@ -3880 +3880,5 @@ static zend_always_inline void i_free_compiled_variables(zend_execute_data *exec
-		i_zval_ptr_dtor(cv);
+		if (Z_TYPE_P(cv) == IS_REFERENCE && Z_REF_P(cv) && !(GC_FLAGS(Z_REF_P(cv)) & GC_FREE)) {
+			i_zval_ptr_dtor(cv);
+		} else if (Z_TYPE_P(cv) != IS_REFERENCE) {
+			i_zval_ptr_dtor(cv);
+		}
