diff --git a/Zend/zend_variables.c b/Zend/zend_variables.c
index 27e09d7db22..95f87386d05 100644
--- a/Zend/zend_variables.c
+++ b/Zend/zend_variables.c
@@ -47 +47 @@ static const zend_rc_dtor_func_t zend_rc_dtor_func[] = {
-	[IS_ARRAY] =        (zend_rc_dtor_func_t)zend_array_destroy,
+[IS_ARRAY] =        (zend_rc_dtor_func_t)zend_array_destroy,
@@ -56,0 +57,14 @@ ZEND_API void ZEND_FASTCALL rc_dtor_func(zend_refcounted *p)
+	/* Fix for CWE-416: Use After Free - Clear dangling references before object destruction */
+	if (GC_TYPE(p) == IS_OBJECT && EG(current_execute_data)) {
+		zend_execute_data *ex = EG(current_execute_data);
+		while (ex && ex->CVs) {
+			int i;
+			for (i = 0; i < ex->func->op_array.last_var; i++) {
+				zval **cv = &EX_CVs(ex)[i];
+				if (*cv && Z_TYPE_PP(*cv) == IS_OBJECT && Z_OBJ_PP(*cv) == (zend_object*)p) {
+					*cv = NULL;
+				}
+			}
+			ex = ex->prev_execute_data;
+		}
+	}
@@ -67,2 +81 @@ static void ZEND_FASTCALL zend_string_destroy(zend_string *str)
-	efree(str);
-}
+	efree(str);}
diff --git a/Zend/zend_objects_API.c b/Zend/zend_objects_API.c
index 80f5b747db7..eb1f0fb1e26 100644
--- a/Zend/zend_objects_API.c
+++ b/Zend/zend_objects_API.c
@@ -201,0 +202,13 @@ ZEND_API void ZEND_FASTCALL zend_objects_store_del(zend_object *object) /* {{{ *
+// Prevent use-after-free by clearing references before efree()
+		if (EG(current_execute_data)) {
+			zend_execute_data *ex = EG(current_execute_data);
+			if (ex->CVs) {
+				uint32_t i;
+				for (i = 0; i < ex->nested_calls; i++) {
+					if (ex->CVs[i] && Z_TYPE_P((zval*)ex->CVs[i]) == IS_OBJECT && 
+					    Z_OBJ_P((zval*)ex->CVs[i]) == object) {
+						ex->CVs[i] = NULL;
+					}
+				}
+			}
+		}
