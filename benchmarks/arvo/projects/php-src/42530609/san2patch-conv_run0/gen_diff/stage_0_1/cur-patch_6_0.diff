+				if (EG(current_execute_data)->CVs[i] == (zval*)object) {
+					EG(current_execute_data)->CVs[i] = NULL;
+				}
+			}
+		}
@@ -203,0 +212 @@ ZEND_API void ZEND_FASTCALL zend_objects_store_del(zend_object *object) /* {{{ *
+		ptr = ((char*)object) - object->handlers->offset;
