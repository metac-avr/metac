diff --git a/Zend/zend_vm_execute.h b/Zend/zend_vm_execute.h
index feeb1f6f6b0..403cd17f425 100644
--- a/Zend/zend_vm_execute.h
+++ b/Zend/zend_vm_execute.h
@@ -1115,0 +1116,13 @@ static zend_never_inline ZEND_OPCODE_HANDLER_RET ZEND_FASTCALL zend_leave_helper
+		/* Validate object references before freeing compiled variables to prevent use-after-free */
+		zend_object **objects = (zend_object**)execute_data->func->op_array.vars;
+		uint32_t num_vars = execute_data->func->op_array.last_var;
+		for (uint32_t i = 0; i < num_vars; i++) {
+			zval *var = ZEND_CALL_VAR_NUM(execute_data, i);
+			if (Z_TYPE_P(var) == IS_OBJECT && Z_OBJ_P(var) != NULL) {
+				zend_object *obj = Z_OBJ_P(var);
+				/* Check if object is still valid before proceeding */
+				if (obj->gc.refcount > 0) {
+					continue;
+				}
+			}
+		}
