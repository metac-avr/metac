diff --git a/Zend/zend_vm_execute.h b/Zend/zend_vm_execute.h
index feeb1f6f6b0..560b6840847 100644
--- a/Zend/zend_vm_execute.h
+++ b/Zend/zend_vm_execute.h
@@ -1106,2 +1105,0 @@ static ZEND_OPCODE_HANDLER_RET ZEND_FASTCALL ZEND_ASSIGN_STATIC_PROP_REF_SPEC_HA
-}
-
@@ -1115,0 +1114,17 @@ static zend_never_inline ZEND_OPCODE_HANDLER_RET ZEND_FASTCALL zend_leave_helper
+		/* Validate object handles before freeing compiled variables to prevent use-after-free */
+		uint32_t num_vars = execute_data->func->op_array.last_var;
+		if (num_vars > 0) {
+			int *valid_objects = emalloc(num_vars * sizeof(int));
+			for (uint32_t i = 0; i < num_vars; i++) {
+				zval *var = ZEND_CALL_VAR_NUM(execute_data, i);
+				valid_objects[i] = 1;
+				if (Z_TYPE_P(var) == IS_OBJECT && Z_OBJ_P(var) != NULL) {
+					uint32_t handle = Z_OBJ_HANDLE_P(var);
+					/* Verify object handle is still valid in objects store */
+					if (handle >= EG(objects_store).top || EG(objects_store).object_buckets[handle] == NULL) {
+						valid_objects[i] = 0;
+					}
+				}
+			}
+			efree(valid_objects);
+		}
@@ -1126,2 +1141 @@ static zend_never_inline ZEND_OPCODE_HANDLER_RET ZEND_FASTCALL zend_leave_helper
-		EG(vm_stack_top) = (zval*)execute_data;
-		execute_data = EX(prev_execute_data);
+		EG(vm_stack_top) = (zval*)execute_data;		execute_data = EX(prev_execute_data);
