diff --git a/Zend/zend_variables.c b/Zend/zend_variables.c
index 27e09d7db22..86579e9ca3d 100644
--- a/Zend/zend_variables.c
+++ b/Zend/zend_variables.c
@@ -47 +47 @@ static const zend_rc_dtor_func_t zend_rc_dtor_func[] = {
-	[IS_ARRAY] =        (zend_rc_dtor_func_t)zend_array_destroy,
+[IS_ARRAY] =        (zend_rc_dtor_func_t)zend_array_destroy,
@@ -56,2 +56,4 @@ ZEND_API void ZEND_FASTCALL rc_dtor_func(zend_refcounted *p)
-	ZEND_ASSERT(GC_TYPE(p) <= IS_CONSTANT_AST);
-	zend_rc_dtor_func[GC_TYPE(p)](p);
+	if (p && GC_TYPE(p) <= IS_CONSTANT_AST) {
+		zend_rc_dtor_func_t func = zend_rc_dtor_func[GC_TYPE(p)];
+		if (func) func(p);
+	}
diff --git a/Zend/zend_objects_API.c b/Zend/zend_objects_API.c
index 80f5b747db7..9ba3c952e08 100644
--- a/Zend/zend_objects_API.c
+++ b/Zend/zend_objects_API.c
@@ -202,4 +202,11 @@ ZEND_API void ZEND_FASTCALL zend_objects_store_del(zend_object *object) /* {{{ *
-		ptr = ((char*)object) - object->handlers->offset;
-		GC_REMOVE_FROM_BUFFER(object);
-		efree(ptr);
-		ZEND_OBJECTS_STORE_ADD_TO_FREE_LIST(handle);
+		// FIXME: Crash CWE-416: Use After Free
+		// Add safety check to ensure object is valid before accessing
+		if (object && GC_TYPE(object) != IS_NULL) {
+			ptr = ((char*)object) - object->handlers->offset;
+			GC_REMOVE_FROM_BUFFER(object);
+			efree(ptr);
+			ZEND_OBJECTS_STORE_ADD_TO_FREE_LIST(handle);
+		} else {
+			// Object already invalidated, skip freeing
+			ZEND_OBJECTS_STORE_ADD_TO_FREE_LIST(handle);
+		}
