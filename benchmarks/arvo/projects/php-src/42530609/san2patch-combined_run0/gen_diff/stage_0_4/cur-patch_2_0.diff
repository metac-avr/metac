diff --git a/Zend/zend_variables.c b/Zend/zend_variables.c
index 27e09d7db22..92b3e599516 100644
--- a/Zend/zend_variables.c
+++ b/Zend/zend_variables.c
@@ -64,4 +64,4 @@ static void ZEND_FASTCALL zend_string_destroy(zend_string *str)
-	ZEND_ASSERT(!ZSTR_IS_INTERNED(str));
-	ZEND_ASSERT(GC_REFCOUNT(str) == 0);
-	ZEND_ASSERT(!(GC_FLAGS(str) & IS_STR_PERSISTENT));
-	efree(str);
+ZEND_ASSERT(!ZSTR_IS_INTERNED(str));
+ZEND_ASSERT(GC_REFCOUNT(str) == 0);
+ZEND_ASSERT(!(GC_FLAGS(str) & IS_STR_PERSISTENT));
+efree(str);
@@ -74 +74,4 @@ static void ZEND_FASTCALL zend_reference_destroy(zend_reference *ref)
-	i_zval_ptr_dtor(&ref->val);
+	// Validate reference before use to prevent expired pointer dereference
+	if (ref && GC_REFCOUNT(ref) > 0) {
+		i_zval_ptr_dtor(&ref->val);
+	}
diff --git a/Zend/zend_vm_execute.h b/Zend/zend_vm_execute.h
index feeb1f6f6b0..bf3e58f96a7 100644
--- a/Zend/zend_vm_execute.h
+++ b/Zend/zend_vm_execute.h
@@ -3272,6 +3272,9 @@ static ZEND_OPCODE_HANDLER_RET ZEND_FASTCALL ZEND_HANDLE_EXCEPTION_SPEC_HANDLER(
-					zval_ptr_dtor_nogc(EX_VAR(throw_op->result.var));
-				}
-		}
-	}
-
-	ZEND_VM_TAIL_CALL(zend_dispatch_try_catch_finally_helper_SPEC(current_try_catch_offset, throw_op_num ZEND_OPCODE_HANDLER_ARGS_PASSTHRU_CC));
+                    zval_ptr_dtor_nogc(EX_VAR(throw_op->result.var));
+                }
+        }
+// FIXME: Crash CWE-825: Expired Pointer Dereference
+        // Clear references to prevent dangling pointer access
+        if (EX_VAR(throw_op->result.var)) {
+            EX_VAR(throw_op->result.var) = NULL;
+        }
+        ZEND_VM_TAIL_CALL(zend_dispatch_try_catch_finally_helper_SPEC(current_try_catch_offset, throw_op_num ZEND_OPCODE_HANDLER_ARGS_PASSTHRU_CC));
