diff --git a/Zend/zend_variables.c b/Zend/zend_variables.c
index 27e09d7db22..982c4a99c45 100644
--- a/Zend/zend_variables.c
+++ b/Zend/zend_variables.c
@@ -47 +47 @@ static const zend_rc_dtor_func_t zend_rc_dtor_func[] = {
-	[IS_ARRAY] =        (zend_rc_dtor_func_t)zend_array_destroy,
+[IS_ARRAY] =        (zend_rc_dtor_func_t)zend_array_destroy,
@@ -56,2 +56,4 @@ ZEND_API void ZEND_FASTCALL rc_dtor_func(zend_refcounted *p)
-	ZEND_ASSERT(GC_TYPE(p) <= IS_CONSTANT_AST);
-	zend_rc_dtor_func[GC_TYPE(p)](p);
+	if (p != NULL) {
+		ZEND_ASSERT(GC_TYPE(p) <= IS_CONSTANT_AST);
+		zend_rc_dtor_func[GC_TYPE(p)](p);
+	}
diff --git a/Zend/zend_execute.c b/Zend/zend_execute.c
index fbad44d2f2c..f52545a7194 100644
--- a/Zend/zend_execute.c
+++ b/Zend/zend_execute.c
@@ -3880 +3880,12 @@ static zend_always_inline void i_free_compiled_variables(zend_execute_data *exec
-		i_zval_ptr_dtor(cv);
+		if (EXPECTED(cv != NULL)) {
+			if (Z_REFCOUNTED_P(cv) && Z_COUNTED_P(cv)) {
+				zend_refcounted *ref = Z_COUNTED_P(cv);
+				if ((ref != NULL) && ((uintptr_t)ref > 4096)) {
+					i_zval_ptr_dtor(cv);
+				} else {
+					ZVAL_UNDEF(cv);
+				}
+			} else {
+				i_zval_ptr_dtor(cv);
+			}
+		}
