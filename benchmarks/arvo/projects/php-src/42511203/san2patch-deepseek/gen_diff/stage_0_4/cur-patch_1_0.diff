diff --git a/Zend/zend_execute.h b/Zend/zend_execute.h
index 278afc9c10f..791001d5554 100644
--- a/Zend/zend_execute.h
+++ b/Zend/zend_execute.h
@@ -155,0 +156,3 @@ static zend_always_inline zval* zend_assign_to_variable(zval *variable_ptr, zval
+			if (UNEXPECTED(!zend_wrong_assign_to_variable_reference(variable_ptr, value, value_type))) {
+				return &EG(uninitialized_zval);
+			}
diff --git a/Zend/zend_vm_execute.h b/Zend/zend_vm_execute.h
index 2ba23ff65bb..8ffaaeb9569 100644
--- a/Zend/zend_vm_execute.h
+++ b/Zend/zend_vm_execute.h
@@ -23833,0 +23834 @@ static ZEND_OPCODE_HANDLER_RET ZEND_FASTCALL ZEND_ASSIGN_SPEC_VAR_CONST_RETVAL_U
+	zval *orig_variable_ptr;
@@ -23837 +23838,2 @@ static ZEND_OPCODE_HANDLER_RET ZEND_FASTCALL ZEND_ASSIGN_SPEC_VAR_CONST_RETVAL_U
-	variable_ptr = _get_zval_ptr_ptr_var(opline->op1.var EXECUTE_DATA_CC);
+ 	variable_ptr = _get_zval_ptr_ptr_var(opline->op1.var EXECUTE_DATA_CC);
+	orig_variable_ptr = variable_ptr;
@@ -23839 +23841,7 @@ static ZEND_OPCODE_HANDLER_RET ZEND_FASTCALL ZEND_ASSIGN_SPEC_VAR_CONST_RETVAL_U
-	value = zend_assign_to_variable(variable_ptr, value, IS_CONST, EX_USES_STRICT_TYPES());
+	zend_wrong_assign_to_variable_reference(variable_ptr, value EXECUTE_DATA_CC);
+	variable_ptr = _get_zval_ptr_ptr_var(opline->op1.var EXECUTE_DATA_CC);
+	if (UNEXPECTED(variable_ptr != orig_variable_ptr)) {
+		zend_assign_to_variable(variable_ptr, value, IS_CONST, EX_USES_STRICT_TYPES());
+	} else {
+		value = zend_assign_to_variable(variable_ptr, value, IS_CONST, EX_USES_STRICT_TYPES());
+	}
