diff --git a/Zend/zend_execute.h b/Zend/zend_execute.h
index 278afc9c10f..9bd378879a0 100644
--- a/Zend/zend_execute.h
+++ b/Zend/zend_execute.h
@@ -154,0 +155,9 @@ static zend_always_inline zval* zend_assign_to_variable(zval *variable_ptr, zval
+			
+			/* Check if the variable_ptr points to valid memory before proceeding */
+			if (UNEXPECTED(Z_REFCOUNTED_P(variable_ptr) && GC_REFCOUNT(Z_COUNTED_P(variable_ptr)) == 0)) {
+				/* Memory has been freed, avoid use-after-free */
+				ZVAL_UNDEF(variable_ptr);
+				zend_copy_to_variable(variable_ptr, value, value_type);
+				return variable_ptr;
+			}
+			
diff --git a/Zend/zend_vm_execute.h b/Zend/zend_vm_execute.h
index 2ba23ff65bb..f92f322e68f 100644
--- a/Zend/zend_vm_execute.h
+++ b/Zend/zend_vm_execute.h
@@ -27157,0 +27158 @@ static ZEND_OPCODE_HANDLER_RET ZEND_FASTCALL ZEND_ASSIGN_REF_SPEC_VAR_VAR_HANDLE
+// FIXME: Crash CWE-416: Use After Free
@@ -27163 +27164,4 @@ static ZEND_OPCODE_HANDLER_RET ZEND_FASTCALL ZEND_ASSIGN_REF_SPEC_VAR_VAR_HANDLE
-		zend_assign_to_variable_reference(variable_ptr, value_ptr);
