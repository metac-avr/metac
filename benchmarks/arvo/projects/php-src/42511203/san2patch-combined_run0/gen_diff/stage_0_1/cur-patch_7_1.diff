diff --git a/Zend/zend_execute.c b/Zend/zend_execute.c
index 7879f0ad984..f776e308fc9 100644
--- a/Zend/zend_execute.c
+++ b/Zend/zend_execute.c
@@ -571,2 +571,4 @@ static zend_never_inline ZEND_COLD zval *zend_wrong_assign_to_variable_reference
-	/* Use IS_TMP_VAR instead of IS_VAR to avoid ISREF check */
-	Z_TRY_ADDREF_P(value_ptr);
+	/* Validate that value_ptr is a valid reference before refcount increment */
+	if (value_ptr && Z_ISREF_P(value_ptr)) {
+		Z_TRY_ADDREF_P(value_ptr);
+	}
diff --git a/Zend/zend_vm_execute.h b/Zend/zend_vm_execute.h
index 2ba23ff65bb..74093369f61 100644
--- a/Zend/zend_vm_execute.h
+++ b/Zend/zend_vm_execute.h
@@ -27158 +27158,2 @@ static ZEND_OPCODE_HANDLER_RET ZEND_FASTCALL ZEND_ASSIGN_REF_SPEC_VAR_VAR_HANDLE
-			   UNEXPECTED(!Z_ISREF_P(value_ptr))) {
+// FIXME: Crash CWE-416: Use After Free
+ 			   UNEXPECTED(!Z_ISREF_P(value_ptr))) {
@@ -27160,2 +27161,18 @@ static ZEND_OPCODE_HANDLER_RET ZEND_FASTCALL ZEND_ASSIGN_REF_SPEC_VAR_VAR_HANDLE
-		variable_ptr = zend_wrong_assign_to_variable_reference(
-			variable_ptr, value_ptr OPLINE_CC EXECUTE_DATA_CC);
+		if (value_ptr != NULL && !Z_ISREF_P(value_ptr)) {
+			zend_bool is_valid = 1;
+			if (Z_TYPE_P(value_ptr) == IS_ARRAY) {
+				zend_array *arr = Z_ARR_P(value_ptr);
+				if (arr && GC_REFCOUNT(arr) == 0) {
+					is_valid = 0;
+				}
+			}
+			if (is_valid) {
+				variable_ptr = zend_wrong_assign_to_variable_reference(
+					variable_ptr, value_ptr OPLINE_CC EXECUTE_DATA_CC);
+			} else {
+				variable_ptr = &EG(uninitialized_zval);
+			}
+		} else {
+			variable_ptr = zend_wrong_assign_to_variable_reference(
+				variable_ptr, value_ptr OPLINE_CC EXECUTE_DATA_CC);
+		}
