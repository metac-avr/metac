diff --git a/Zend/zend_execute.c b/Zend/zend_execute.c
index 7879f0ad984..0d4c731d9e4 100644
--- a/Zend/zend_execute.c
+++ b/Zend/zend_execute.c
@@ -571,2 +571,9 @@ static zend_never_inline ZEND_COLD zval *zend_wrong_assign_to_variable_reference
-	/* Use IS_TMP_VAR instead of IS_VAR to avoid ISREF check */
-	Z_TRY_ADDREF_P(value_ptr);
+	/* Prevent UAF by checking reference validity before refcount operation */
+	if (Z_TYPE_P(value_ptr) == IS_REFERENCE) {
+		zend_reference *ref = Z_REF_P(value_ptr);
+		if (ref && ref->gc.refcount > 0) {
+			Z_TRY_ADDREF_P(value_ptr);
+		}
+	} else {
+		Z_TRY_ADDREF_P(value_ptr);
+	}
diff --git a/Zend/zend_vm_execute.h b/Zend/zend_vm_execute.h
index 2ba23ff65bb..97bd22372e9 100644
--- a/Zend/zend_vm_execute.h
+++ b/Zend/zend_vm_execute.h
@@ -27157,0 +27158 @@ static ZEND_OPCODE_HANDLER_RET ZEND_FASTCALL ZEND_ASSIGN_REF_SPEC_VAR_VAR_HANDLE
+// FIXME: Crash CWE-416: Use After Free
@@ -27160,2 +27161,11 @@ static ZEND_OPCODE_HANDLER_RET ZEND_FASTCALL ZEND_ASSIGN_REF_SPEC_VAR_VAR_HANDLE
-		variable_ptr = zend_wrong_assign_to_variable_reference(
-			variable_ptr, value_ptr OPLINE_CC EXECUTE_DATA_CC);
+		if (value_ptr && Z_REFCOUNTED_P(value_ptr)) {
+			if (GC_REFCOUNT(Z_COUNTED_P(value_ptr)) > 0) {
+				variable_ptr = zend_wrong_assign_to_variable_reference(
+					variable_ptr, value_ptr OPLINE_CC EXECUTE_DATA_CC);
+			} else {
+				variable_ptr = &EG(uninitialized_zval);
+			}
+		} else {
+			variable_ptr = zend_wrong_assign_to_variable_reference(
+				variable_ptr, value_ptr OPLINE_CC EXECUTE_DATA_CC);
+		}
