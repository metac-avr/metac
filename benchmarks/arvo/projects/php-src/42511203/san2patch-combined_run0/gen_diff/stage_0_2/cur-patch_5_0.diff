diff --git a/Zend/zend_execute.c b/Zend/zend_execute.c
index 7879f0ad984..f1c0023447f 100644
--- a/Zend/zend_execute.c
+++ b/Zend/zend_execute.c
@@ -570,0 +571,4 @@ static zend_never_inline ZEND_COLD zval *zend_wrong_assign_to_variable_reference
+	/* Validate pointers before use to prevent expired pointer dereference */
+	if (UNEXPECTED(variable_ptr == NULL || value_ptr == NULL)) {
+		return &EG(uninitialized_zval);
+	}
diff --git a/Zend/zend_vm_execute.h b/Zend/zend_vm_execute.h
index 2ba23ff65bb..f835e819c16 100644
--- a/Zend/zend_vm_execute.h
+++ b/Zend/zend_vm_execute.h
@@ -23839,3 +23839,6 @@ static ZEND_OPCODE_HANDLER_RET ZEND_FASTCALL ZEND_ASSIGN_SPEC_VAR_CONST_RETVAL_U
-	value = zend_assign_to_variable(variable_ptr, value, IS_CONST, EX_USES_STRICT_TYPES());
-	if (UNEXPECTED(0)) {
-		ZVAL_COPY(EX_VAR(opline->result.var), value);
+	/* Prevent use-after-free by checking pointer validity */
+	if (variable_ptr && Z_TYPE_P(variable_ptr) != IS_UNDEF) {
+		value = zend_assign_to_variable(variable_ptr, value, IS_CONST, EX_USES_STRICT_TYPES());
+		if (UNEXPECTED(0)) {
+			ZVAL_COPY(EX_VAR(opline->result.var), value);
+		}
