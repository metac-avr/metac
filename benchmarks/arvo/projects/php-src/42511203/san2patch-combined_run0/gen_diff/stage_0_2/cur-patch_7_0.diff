diff --git a/Zend/zend_variables.c b/Zend/zend_variables.c
index 06483d581df..dd25795c1e5 100644
--- a/Zend/zend_variables.c
+++ b/Zend/zend_variables.c
@@ -57 +57,3 @@ ZEND_API void ZEND_FASTCALL rc_dtor_func(zend_refcounted *p)
-	zend_rc_dtor_func[GC_TYPE(p)](p);
+	if (p != NULL) {
+		zend_rc_dtor_func[GC_TYPE(p)](p);
+	}
diff --git a/Zend/zend_execute.c b/Zend/zend_execute.c
index 7879f0ad984..18b504f6d9f 100644
--- a/Zend/zend_execute.c
+++ b/Zend/zend_execute.c
@@ -571,0 +572,5 @@ static zend_never_inline ZEND_COLD zval *zend_wrong_assign_to_variable_reference
+	/* Check if value_ptr is a valid reference before adding refcount */
+	if (UNEXPECTED(value_ptr && Z_TYPE_P(value_ptr) == IS_REFERENCE && 
+		   Z_REF_P(value_ptr) && Z_REF_P(value_ptr)->gc.refcount == 0)) {
+		return &EG(uninitialized_zval);
+	}
