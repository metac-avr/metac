diff --git a/Zend/zend_execute.c b/Zend/zend_execute.c
index 7879f0ad984..bf452af07f4 100644
--- a/Zend/zend_execute.c
+++ b/Zend/zend_execute.c
@@ -573 +573,6 @@ static zend_never_inline ZEND_COLD zval *zend_wrong_assign_to_variable_reference
-	return zend_assign_to_variable(variable_ptr, value_ptr, IS_TMP_VAR, EX_USES_STRICT_TYPES());
+	/* Check if pointers are valid to prevent use-after-free vulnerability */
+	if (variable_ptr && value_ptr) {
+		return zend_assign_to_variable(variable_ptr, value_ptr, IS_TMP_VAR, EX_USES_STRICT_TYPES());
+	} else {
+		return &EG(uninitialized_zval);
+	}
diff --git a/Zend/zend_vm_execute.h b/Zend/zend_vm_execute.h
index 2ba23ff65bb..196130d43d4 100644
--- a/Zend/zend_vm_execute.h
+++ b/Zend/zend_vm_execute.h
@@ -23839,3 +23839,6 @@ static ZEND_OPCODE_HANDLER_RET ZEND_FASTCALL ZEND_ASSIGN_SPEC_VAR_CONST_RETVAL_U
-	value = zend_assign_to_variable(variable_ptr, value, IS_CONST, EX_USES_STRICT_TYPES());
-	if (UNEXPECTED(0)) {
-		ZVAL_COPY(EX_VAR(opline->result.var), value);
+	/* Validate pointers before use to prevent use-after-free */
+	if (EXPECTED(variable_ptr != NULL)) {
+		value = zend_assign_to_variable(variable_ptr, value, IS_CONST, EX_USES_STRICT_TYPES());
+		if (UNEXPECTED(0)) {
+			ZVAL_COPY(EX_VAR(opline->result.var), value);
+		}
