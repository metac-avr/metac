diff --git a/Zend/zend_execute.c b/Zend/zend_execute.c
index 7879f0ad984..ee72d0f2baa 100644
--- a/Zend/zend_execute.c
+++ b/Zend/zend_execute.c
@@ -573 +573,6 @@ static zend_never_inline ZEND_COLD zval *zend_wrong_assign_to_variable_reference
-	return zend_assign_to_variable(variable_ptr, value_ptr, IS_TMP_VAR, EX_USES_STRICT_TYPES());
+	/* Validate variable_ptr is not null and has valid reference count to prevent use-after-free */
+	if (variable_ptr && (!Z_REFCOUNTED_P(variable_ptr) || Z_REFCOUNT_P(variable_ptr) > 0)) {
+		return zend_assign_to_variable(variable_ptr, value_ptr, IS_TMP_VAR, EX_USES_STRICT_TYPES());
+	} else {
+		return &EG(uninitialized_zval);
+	}
diff --git a/Zend/zend_execute.h b/Zend/zend_execute.h
index 278afc9c10f..b11f2ad797a 100644
--- a/Zend/zend_execute.h
+++ b/Zend/zend_execute.h
@@ -154,0 +155,6 @@ static zend_always_inline zval* zend_assign_to_variable(zval *variable_ptr, zval
+			
+			/* Validate memory is not freed before accessing reference counted data */
+			if (UNEXPECTED(!variable_ptr || (Z_REFCOUNTED_P(variable_ptr) && !GC_REFCOUNT(Z_COUNTED_P(variable_ptr))))) {
+				return variable_ptr;
+			}
+			
