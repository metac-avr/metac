diff --git a/Zend/zend_execute.c b/Zend/zend_execute.c
index 7879f0ad984..b59a3bcc09c 100644
--- a/Zend/zend_execute.c
+++ b/Zend/zend_execute.c
@@ -572,0 +573,4 @@ static zend_never_inline ZEND_COLD zval *zend_wrong_assign_to_variable_reference
+	/* Add safety check to prevent accessing freed memory */
+	if (variable_ptr == NULL || Z_TYPE_P(variable_ptr) == IS_UNDEF) {
+		return &EG(uninitialized_zval);
+	}
diff --git a/Zend/zend_execute.h b/Zend/zend_execute.h
index 278afc9c10f..66ac097df55 100644
--- a/Zend/zend_execute.h
+++ b/Zend/zend_execute.h
@@ -154,0 +155,10 @@ static zend_always_inline zval* zend_assign_to_variable(zval *variable_ptr, zval
+			
+			/* Add safety check to prevent use-after-free */
+			if (UNEXPECTED(Z_REFCOUNTED_P(variable_ptr))) {
+				zend_refcounted *check_ptr = Z_COUNTED_P(variable_ptr);
+				if (UNEXPECTED(!check_ptr || GC_REFCOUNT(check_ptr) == 0)) {
+					/* Memory already freed, avoid accessing it */
+					return variable_ptr;
+				}
+			}
+			
