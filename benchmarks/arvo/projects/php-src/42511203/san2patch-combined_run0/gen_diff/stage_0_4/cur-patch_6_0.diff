diff --git a/Zend/zend_execute.c b/Zend/zend_execute.c
index 7879f0ad984..7b559aa9edd 100644
--- a/Zend/zend_execute.c
+++ b/Zend/zend_execute.c
@@ -573 +573,6 @@ static zend_never_inline ZEND_COLD zval *zend_wrong_assign_to_variable_reference
-	return zend_assign_to_variable(variable_ptr, value_ptr, IS_TMP_VAR, EX_USES_STRICT_TYPES());
+	/* Check if variable_ptr is valid before assignment to prevent use-after-free */
+	if (variable_ptr && !Z_ISUNDEF_P(variable_ptr)) {
+		return zend_assign_to_variable(variable_ptr, value_ptr, IS_TMP_VAR, EX_USES_STRICT_TYPES());
+	} else {
+		return &EG(uninitialized_zval);
+	}
diff --git a/Zend/zend_execute.h b/Zend/zend_execute.h
index 278afc9c10f..04ce28cd2de 100644
--- a/Zend/zend_execute.h
+++ b/Zend/zend_execute.h
@@ -154,0 +155,7 @@ static zend_always_inline zval* zend_assign_to_variable(zval *variable_ptr, zval
+			
+			/* Check if variable_ptr points to valid memory before accessing */
+			if (UNEXPECTED(Z_REFCOUNTED_P(variable_ptr) && GC_REFCOUNT(Z_COUNTED_P(variable_ptr)) <= 0)) {
+				/* Skip assignment if memory is already freed */
+				return variable_ptr;
+			}
+			
