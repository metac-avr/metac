diff --git a/Zend/zend_execute.h b/Zend/zend_execute.h
index 278afc9c10f..9af338f068b 100644
--- a/Zend/zend_execute.h
+++ b/Zend/zend_execute.h
@@ -156,7 +156,10 @@ static zend_always_inline zval* zend_assign_to_variable(zval *variable_ptr, zval
-			zend_copy_to_variable(variable_ptr, value, value_type);
-			if (GC_DELREF(garbage) == 0) {
-				rc_dtor_func(garbage);
-			} else { /* we need to split */
-				/* optimized version of GC_ZVAL_CHECK_POSSIBLE_ROOT(variable_ptr) */
-				if (UNEXPECTED(GC_MAY_LEAK(garbage))) {
-					gc_possible_root(garbage);
+			/* Ensure garbage pointer is valid before operations */
+			if (garbage != NULL) {
+				zend_copy_to_variable(variable_ptr, value, value_type);
+				if (GC_DELREF(garbage) == 0) {
+					rc_dtor_func(garbage);
+				} else { /* we need to split */
+					/* optimized version of GC_ZVAL_CHECK_POSSIBLE_ROOT(variable_ptr) */
+					if (UNEXPECTED(GC_MAY_LEAK(garbage))) {
+						gc_possible_root(garbage);
+					}
@@ -163,0 +167 @@ static zend_always_inline zval* zend_assign_to_variable(zval *variable_ptr, zval
+				return variable_ptr;
@@ -164,0 +169 @@ static zend_always_inline zval* zend_assign_to_variable(zval *variable_ptr, zval
+			/* Return early if garbage is NULL to prevent use-after-free */
diff --git a/Zend/zend_execute.c b/Zend/zend_execute.c
index 7879f0ad984..84de490cffe 100644
--- a/Zend/zend_execute.c
+++ b/Zend/zend_execute.c
@@ -572,0 +573,4 @@ static zend_never_inline ZEND_COLD zval *zend_wrong_assign_to_variable_reference
+	/* Add safety check to ensure pointers are valid before use */
+	if (!variable_ptr || !value_ptr) {
+		return &EG(uninitialized_zval);
+	}
