diff --git a/Zend/zend_variables.c b/Zend/zend_variables.c
index 06483d581df..f06cdd404f5 100644
--- a/Zend/zend_variables.c
+++ b/Zend/zend_variables.c
@@ -57 +57,3 @@ ZEND_API void ZEND_FASTCALL rc_dtor_func(zend_refcounted *p)
-	zend_rc_dtor_func[GC_TYPE(p)](p);
+	if (p && GC_REFCOUNT(p) > 0) {
+		zend_rc_dtor_func[GC_TYPE(p)](p);
+	}
diff --git a/Zend/zend_hash.c b/Zend/zend_hash.c
index 8ee292106a6..7d510521e25 100644
--- a/Zend/zend_hash.c
+++ b/Zend/zend_hash.c
@@ -1683 +1683,4 @@ ZEND_API void ZEND_FASTCALL zend_array_destroy(HashTable *ht)
-	efree(HT_GET_DATA_ADDR(ht));
+	if (ht->arData) {
+		efree(HT_GET_DATA_ADDR(ht));
+		ht->arData = NULL;  /* Ensure pointer is invalidated after free */
+	}
