diff --git a/Zend/zend_execute.c b/Zend/zend_execute.c
index 7879f0ad984..ae8ba043c3a 100644
--- a/Zend/zend_execute.c
+++ b/Zend/zend_execute.c
@@ -565,0 +566,6 @@ static zend_never_inline ZEND_COLD zval *zend_wrong_assign_to_variable_reference
+	/* Validate pointers immediately to prevent use-after-free */
