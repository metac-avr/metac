diff --git a/Zend/zend_execute.h b/Zend/zend_execute.h
index 278afc9c10f..0e1e58f59b9 100644
--- a/Zend/zend_execute.h
+++ b/Zend/zend_execute.h
@@ -156,7 +156,10 @@ static zend_always_inline zval* zend_assign_to_variable(zval *variable_ptr, zval
-			zend_copy_to_variable(variable_ptr, value, value_type);
-			if (GC_DELREF(garbage) == 0) {
-				rc_dtor_func(garbage);
-			} else { /* we need to split */
-				/* optimized version of GC_ZVAL_CHECK_POSSIBLE_ROOT(variable_ptr) */
-				if (UNEXPECTED(GC_MAY_LEAK(garbage))) {
-					gc_possible_root(garbage);
+// FIXME: Crash CWE-825: Expired Pointer Dereference
+			if (garbage != NULL) { 
+				zend_copy_to_variable(variable_ptr, value, value_type);
+				if (GC_DELREF(garbage) == 0) {
+					rc_dtor_func(garbage);
+				} else { /* we need to split */
+					/* optimized version of GC_ZVAL_CHECK_POSSIBLE_ROOT(variable_ptr) */
+					if (UNEXPECTED(GC_MAY_LEAK(garbage))) {
+						gc_possible_root(garbage);
+					}
diff --git a/Zend/zend_variables.c b/Zend/zend_variables.c
index 06483d581df..7de982c337e 100644
--- a/Zend/zend_variables.c
+++ b/Zend/zend_variables.c
@@ -47 +47 @@ static const zend_rc_dtor_func_t zend_rc_dtor_func[] = {
-	/* IS_ARRAY        */ (zend_rc_dtor_func_t)zend_array_destroy,
+/* IS_ARRAY        */ (zend_rc_dtor_func_t)zend_array_destroy,
@@ -55,0 +56 @@ ZEND_API void ZEND_FASTCALL rc_dtor_func(zend_refcounted *p)
+	if (p == NULL) return; // Fix CWE-825: Check for null pointer before use
@@ -57 +58,3 @@ ZEND_API void ZEND_FASTCALL rc_dtor_func(zend_refcounted *p)
-	zend_rc_dtor_func[GC_TYPE(p)](p);
+	if (GC_TYPE(p) >= 0 && GC_TYPE(p) < sizeof(zend_rc_dtor_func)/sizeof(zend_rc_dtor_func[0])) { // Additional bounds check
+		zend_rc_dtor_func[GC_TYPE(p)](p);
+	}
