diff --git a/Zend/zend_types.h b/Zend/zend_types.h
index fe551c38820..5a08033c6f2 100644
--- a/Zend/zend_types.h
+++ b/Zend/zend_types.h
@@ -1209,3 +1208,0 @@ static zend_always_inline uint32_t zval_set_refcount_p(zval* pz, uint32_t rc) {
-	return GC_SET_REFCOUNT(Z_COUNTED_P(pz), rc);
-}
-
@@ -1219,12 +1216,6 @@ static zend_always_inline uint32_t zval_delref_p(zval* pz) {
-	return GC_DELREF(Z_COUNTED_P(pz));
-}
-
-#if SIZEOF_SIZE_T == 4
-# define ZVAL_COPY_VALUE_EX(z, v, gc, t)				\
-	do {												\
-		uint32_t _w2 = v->value.ww.w2;					\
-		Z_COUNTED_P(z) = gc;							\
-		z->value.ww.w2 = _w2;							\
-		Z_TYPE_INFO_P(z) = t;							\
-	} while (0)
-#elif SIZEOF_SIZE_T == 8
+	zend_refcounted *ref = Z_COUNTED_P(pz);
+	if (ref && ref != (zend_refcounted *)0xdeadbeef) {
+		return GC_DELREF(ref);
+	}
+	return 0;
+}#elif SIZEOF_SIZE_T == 8
