@@ -1209,4 +1209,2 @@ static zend_always_inline uint32_t zval_set_refcount_p(zval* pz, uint32_t rc) {
-	return GC_SET_REFCOUNT(Z_COUNTED_P(pz), rc);
-}
-
-static zend_always_inline uint32_t zval_addref_p(zval* pz) {
+static zend_always_inline uint32_t zval_addref_p(zval* pz)
+{
@@ -1217,14 +1215,10 @@ static zend_always_inline uint32_t zval_addref_p(zval* pz) {
