-
-	zend_error(E_WARNING, "Undefined variable $%s", ZSTR_VAL(cv));
+	// Use safer error reporting to avoid expired pointer dereference
+	zend_string *cv = NULL;
+	if (execute_data && EX(func) && EX(func)->op_array.vars &&
