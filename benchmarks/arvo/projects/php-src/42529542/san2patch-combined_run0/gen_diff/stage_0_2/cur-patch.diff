+		cv = EX(func)->op_array.vars[EX_VAR_TO_NUM(var)];
+	}
+	
+	if (cv && ZSTR_VAL(cv)) {
+		zend_error(E_WARNING, "Undefined variable $%s", ZSTR_VAL(cv));
