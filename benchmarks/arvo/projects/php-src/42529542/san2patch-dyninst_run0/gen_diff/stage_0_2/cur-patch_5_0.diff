diff --git a/Zend/zend_execute_API.c b/Zend/zend_execute_API.c
index feeff659bd5..27698a5a90b 100644
--- a/Zend/zend_execute_API.c
+++ b/Zend/zend_execute_API.c
@@ -653 +653,9 @@ ZEND_API uint32_t zend_get_executed_lineno(void) /* {{{ */
-			return EG(opline_before_exception)->lineno;
+			/* Prevent out-of-bounds read by checking pointer validity */
+			zend_op* exception_opline = EG(opline_before_exception);
+			if (exception_opline &&
+			    (uintptr_t)exception_opline >= 0x1000 && 
+			    (uintptr_t)exception_opline < (uintptr_t)-0x1000) {
+				return exception_opline->lineno;
+			} else {
+				return 0;
+			}
