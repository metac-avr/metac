-		zend_binop_error("+", op1, op2);
-		if (result != op1) {
+	if (UNEXPECTED(zendi_try_convert_scalar_to_number(safe_op1, &op1_copy) == FAILURE)
+			|| UNEXPECTED(zendi_try_convert_scalar_to_number(safe_op2, &op2_copy) == FAILURE)) {
+		zend_binop_error("+", safe_op1, safe_op2);
+		if (result != safe_op1) {
@@ -1070 +1077 @@ static zend_never_inline zend_result ZEND_FASTCALL add_function_slow(zval *resul
-	if (result == op1) {
+	if (result == safe_op1) {
