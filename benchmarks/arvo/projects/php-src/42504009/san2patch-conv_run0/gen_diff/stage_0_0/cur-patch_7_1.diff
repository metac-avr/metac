diff --git a/Zend/zend_operators.c b/Zend/zend_operators.c
index 4d3fe724769..210e243f40f 100644
--- a/Zend/zend_operators.c
+++ b/Zend/zend_operators.c
@@ -1052,3 +1052,10 @@ static zend_never_inline zend_result ZEND_FASTCALL add_function_slow(zval *resul
-	ZVAL_DEREF(op1);
