-	if (add_function_fast(result, op1, op2) == SUCCESS) {
+	zval *safe_op1 = op1;
+	zval *safe_op2 = op2;
+	
+	if (!safe_op1 || !safe_op2) {
+		return FAILURE;
+	}
+	
+	ZVAL_DEREF(safe_op1);
+	ZVAL_DEREF(safe_op2);
+	if (add_function_fast(result, safe_op1, safe_op2) == SUCCESS) {
@@ -1061,4 +1068,4 @@ static zend_never_inline zend_result ZEND_FASTCALL add_function_slow(zval *resul
