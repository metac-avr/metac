diff --git a/Zend/zend_operators.c b/Zend/zend_operators.c
index 4d3fe724769..c74692104e8 100644
--- a/Zend/zend_operators.c
+++ b/Zend/zend_operators.c
@@ -1028 +1028,14 @@ static zend_always_inline zend_result add_function_fast(zval *result, zval *op1,
-	zend_uchar type_pair = TYPE_PAIR(Z_TYPE_P(op1), Z_TYPE_P(op2));
+	zend_uchar type_pair;
+
+	if (UNEXPECTED(Z_TYPE_P(op1) == IS_UNDEF) || UNEXPECTED(Z_TYPE_P(op2) == IS_UNDEF)) {
+		return FAILURE;
+	}
+	if (UNEXPECTED(!Z_REFCOUNTED_P(op1)) || UNEXPECTED(!Z_REFCOUNTED_P(op2))) {
+		if (UNEXPECTED(Z_ISREF_P(op1))) {
+			ZVAL_DEREF(op1);
+		}
+		if (UNEXPECTED(Z_ISREF_P(op2))) {
+			ZVAL_DEREF(op2);
+		}
+	}
+	type_pair = TYPE_PAIR(Z_TYPE_P(op1), Z_TYPE_P(op2));
