@@ -10184,0 +10185,17 @@ static ZEND_OPCODE_HANDLER_RET ZEND_FASTCALL ZEND_NEW_SPEC_CONST_UNUSED_HANDLER(
+	if (ce == zend_ce_reflection_enum_backed_case) {
+		zval rv;
+		zval *backing_value = zend_read_property(NULL, Z_OBJ_P(result), ZEND_STRL("backingValue"), 1, &rv);
+		if (backing_value && !Z_ISUNDEF_P(backing_value)) {
+			zval *stored = zend_hash_find(&Z_OBJ_P(result)->properties_info, Z_STR_KNOWN(ZEND_STR_BACKING_VALUE));
+			if (stored) {
+				zval_ptr_dtor(stored);
+				ZVAL_COPY(stored, backing_value);
+			} else {
+				zval tmp;
+				ZVAL_COPY(&tmp, backing_value);
+				zend_update_property(NULL, Z_OBJ_P(result), ZEND_STRL("backingValue"), &tmp);
+				zval_ptr_dtor(&tmp);
+			}
+		}
+	}
