+    if (!ht || HT_IS_DESTROYED(ht)) {
+        return NULL;
+    }
+    return zend_hash_lookup(ht, offset_key);
+// FIXME: Crash CWE-416: Use After Free
+ 
@@ -761,2 +766,6 @@ static zval* ZEND_FASTCALL zend_jit_fetch_dim_w_helper(zend_array *ht, zval *dim
