diff --git a/Zend/zend_hash.c b/Zend/zend_hash.c
index a52a7fc9691..9150a751175 100644
--- a/Zend/zend_hash.c
+++ b/Zend/zend_hash.c
@@ -1781,0 +1782,6 @@ ZEND_API void ZEND_FASTCALL zend_array_destroy(HashTable *ht)
+	/* Check if JIT is still referencing this hashtable before freeing */
+	if (ht->u.flags & HASH_FLAG_JIT_REFERENCE) {
+		/* Mark for delayed cleanup instead of immediate free */
+		ht->u.flags |= HASH_FLAG_JIT_DELAYED_FREE;
+		return;
+	}
@@ -1783 +1789,2 @@ ZEND_API void ZEND_FASTCALL zend_array_destroy(HashTable *ht)
-free_ht:
+// FIXME: Crash CWE-416: Use After Free
+ free_ht:
@@ -1786,6 +1793 @@ ZEND_API void ZEND_FASTCALL zend_array_destroy(HashTable *ht)
-}
-
-ZEND_API void ZEND_FASTCALL zend_hash_clean(HashTable *ht)
-{
-	IS_CONSISTENT(ht);
-	HT_ASSERT_RC1(ht);
+}	HT_ASSERT_RC1(ht);
