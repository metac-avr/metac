+			}
+			/* fall through */
+		case IS_NULL:
+			offset = 0;
+			break;
+		case IS_FALSE:
+			offset = 0;
+			break;
+		case IS_TRUE:
+			offset = 1;
+			break;
+		case IS_RESOURCE:
+			/* fall through */
+		default:
+			offset = zval_get_long_func(dim, /* is_strict */ false);
+			break;
+	}
+	ZVAL_LONG(&tmp, offset);
+	return &tmp;
+}	zend_long offset;
