-		goto num_index;
-	}
-	return zend_hash_lookup(ht, offset_key);
-
-num_index:
-	ZEND_HASH_INDEX_LOOKUP(ht, hval, retval);
-	return retval;
-}
-
-static zend_never_inline zend_long zend_check_string_offset(zval *dim/*, int type*/)
+static zend_never_inline zval* zend_check_string_offset(zval *dim/*, int type*/)
@@ -767,0 +759,33 @@ static zend_never_inline zend_long zend_check_string_offset(zval *dim/*, int typ
+	zval tmp;
+
+try_again:
+	switch(Z_TYPE_P(dim)) {
+		case IS_LONG:
+			offset = Z_LVAL_P(dim);
+			break;
+		case IS_DOUBLE:
+			offset = (zend_long)Z_DVAL_P(dim);
+			break;
+		case IS_STRING:
+			if (IS_LONG == is_numeric_string(Z_STRVAL_P(dim), Z_STRLEN_P(dim), &offset, NULL, -1)) {
