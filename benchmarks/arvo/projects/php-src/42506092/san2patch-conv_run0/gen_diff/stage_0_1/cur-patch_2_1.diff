@@ -768,0 +760,30 @@ static zend_never_inline zend_long zend_check_string_offset(zval *dim/*, int typ
+try_again:
+	switch(Z_TYPE_P(dim)) {
+		case IS_LONG:
+			return Z_LVAL_P(dim);
+		case IS_DOUBLE:
+			return zend_dval_to_lval(Z_DVAL_P(dim));
+		case IS_STRING:
+			{
+				zend_uchar type;
+				zend_long lval;
+				
