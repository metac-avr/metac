@@ -768,0 +760,26 @@ static zend_never_inline zend_long zend_check_string_offset(zval *dim/*, int typ
+try_again:
+	switch(Z_TYPE_P(dim)) {
+		case IS_LONG:
+			offset = Z_LVAL_P(dim);
+			break;
+		case IS_DOUBLE:
+			offset = (zend_long)Z_DVAL_P(dim);
