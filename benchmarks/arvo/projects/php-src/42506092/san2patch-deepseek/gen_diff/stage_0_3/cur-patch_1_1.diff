@@ -757,0 +758,12 @@ static zval* ZEND_FASTCALL zend_jit_fetch_dim_w_helper(zend_array *ht, zval *dim
+
+	if (Z_TYPE_P(dim) == IS_DOUBLE) {
+		hval = zend_dval_to_lval_safe(Z_DVAL_P(dim));
