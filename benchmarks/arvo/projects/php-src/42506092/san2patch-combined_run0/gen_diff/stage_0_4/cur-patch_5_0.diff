diff --git a/Zend/zend_execute.h b/Zend/zend_execute.h
index d13087a5b02..c8b22dc5887 100644
--- a/Zend/zend_execute.h
+++ b/Zend/zend_execute.h
@@ -156,9 +156,10 @@ static zend_always_inline zval* zend_assign_to_variable(zval *variable_ptr, zval
-			zend_copy_to_variable(variable_ptr, value, value_type);
-			if (GC_DELREF(garbage) == 0) {
-				rc_dtor_func(garbage);
-			} else { /* we need to split */
-				/* optimized version of GC_ZVAL_CHECK_POSSIBLE_ROOT(variable_ptr) */
-				if (UNEXPECTED(GC_MAY_LEAK(garbage))) {
-					gc_possible_root(garbage);
-				}
-			}
+// FIXME: Crash CWE-416: Use After Free
+                        if (GC_DELREF(garbage) != 0) {
+                                zend_copy_to_variable(variable_ptr, value, value_type);
+                                /* optimized version of GC_ZVAL_CHECK_POSSIBLE_ROOT(variable_ptr) */
+                                if (UNEXPECTED(GC_MAY_LEAK(garbage))) {
+                                        gc_possible_root(garbage);
+                                }
+                        } else {
+                                rc_dtor_func(garbage);
+                        }
diff --git a/Zend/zend_vm_execute.h b/Zend/zend_vm_execute.h
index acf98a2f74a..9631b64e6b4 100644
--- a/Zend/zend_vm_execute.h
+++ b/Zend/zend_vm_execute.h
@@ -23867,3 +23867,9 @@ static ZEND_OPCODE_HANDLER_RET ZEND_FASTCALL ZEND_ASSIGN_SPEC_VAR_CONST_RETVAL_U
-	value = zend_assign_to_variable(variable_ptr, value, IS_CONST, EX_USES_STRICT_TYPES());
-	if (UNEXPECTED(0)) {
-		ZVAL_COPY(EX_VAR(opline->result.var), value);
+	/* Check for valid memory reference before accessing to prevent use-after-free */
+	if (variable_ptr && !ZVAL_IS_NULL(variable_ptr)) {
+		value = zend_assign_to_variable(variable_ptr, value, IS_CONST, EX_USES_STRICT_TYPES());
+		if (UNEXPECTED(0)) {
+			ZVAL_COPY(EX_VAR(opline->result.var), value);
+		}
+		zval_ptr_dtor_nogc(EX_VAR(opline->op1.var));
+	} else {
+		zval_ptr_dtor_nogc(EX_VAR(opline->op1.var));
@@ -23871 +23876,0 @@ static ZEND_OPCODE_HANDLER_RET ZEND_FASTCALL ZEND_ASSIGN_SPEC_VAR_CONST_RETVAL_U
-	zval_ptr_dtor_nogc(EX_VAR(opline->op1.var));
