index e1f24b6229d..f9b3f2d22bc 100644
--- a/ext/opcache/jit/zend_jit_helpers.c
+++ b/ext/opcache/jit/zend_jit_helpers.c
@@ -756,9 +755,0 @@ static zval* ZEND_FASTCALL zend_jit_fetch_dim_w_helper(zend_array *ht, zval *dim
-		goto num_index;
-	}
-	return zend_hash_lookup(ht, offset_key);
-
-num_index:
-	ZEND_HASH_INDEX_LOOKUP(ht, hval, retval);
-	return retval;
-}
-
@@ -768,0 +760,29 @@ static zend_never_inline zend_long zend_check_string_offset(zval *dim/*, int typ
+try_again:
+	switch(Z_TYPE_P(dim)) {
+		case IS_LONG:
+			return Z_LVAL_P(dim);
+		case IS_DOUBLE:
+			return zend_dval_to_lval(Z_DVAL_P(dim));
+		case IS_STRING:
+			if (IS_STR_WITH_LEN(Z_STR_P(dim))) {
+				offset = ZEND_STRTOL(Z_STRVAL_P(dim), NULL, 10);
+				if (offset == ZEND_LONG_MIN || offset == ZEND_LONG_MAX) {
+					return 0;
+				}
+				return offset;
+			}
+			/* break missing intentionally */
+		case IS_NULL:
+			return 0;
+		case IS_FALSE:
+			return 0;
+		case IS_TRUE:
+			return 1;
+		case IS_REFERENCE:
+			dim = Z_REFVAL_P(dim);
+			goto try_again;
+		default:
+			return zval_get_long_func(dim, /* is_strict */ false);
+	}
+}	zend_long offset;
