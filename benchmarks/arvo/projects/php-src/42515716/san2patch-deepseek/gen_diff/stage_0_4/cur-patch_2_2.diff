+		return 0;
@@ -2281,2 +2308,53 @@ static void update_errors_warnings(timelib_error_container **last_errors) /* {{{
-	timelib_error_container_dtor(*last_errors);
-	*last_errors = NULL;
+	if (timezone_object) {
+		php_date_obj *tzobj = Z_DATE_OBJ_P(timezone_object);
+		switch (tzobj->type) {
+			case TIMELIB_ZONETYPE_ID:
+				type = TIMELIB_ZONETYPE_ID;
+				tzi = tzobj->tzi.tz;
+				break;
+			case TIMELIB_ZONETYPE_OFFSET:
+				type = TIMELIB_ZONETYPE_OFFSET;
+				new_offset = tzobj->tzi.utc_offset;
+				break;
+			case TIMELIB_ZONETYPE_ABBR:
+				type = TIMELIB_ZONETYPE_ABBR;
+				new_abbr = tzobj->tzi.abbr;
+				break;
+		}
+	} else if (dateobj->time->tz_info) {
+		type = TIMELIB_ZONETYPE_ID;
+		tzi = dateobj->time->tz_info;
+	} else {
+		type = TIMELIB_ZONETYPE_OFFSET;
+		new_offset = dateobj->time->z;
+	}
+
+	now = timelib_time_ctor();
+	now->zone_type = type;
+	switch (type) {
+		case TIMELIB_ZONETYPE_ID:
+			now->tz_info = tzi;
+			break;
+		case TIMELIB_ZONETYPE_OFFSET:
+			now->z = new_offset;
+			break;
+		case TIMELIB_ZONETYPE_ABBR:
+			now->abbr = new_abbr;
+			break;
+	}
+
+	php_date_get_current_time_with_fraction(&sec, &usec);
+	timelib_unixtime2local(now, (timelib_sll) sec);
+	php_date_set_time_fraction(now, usec);
+
+	if (!format) {
+		options = TIMELIB_NO_CLONE;
+	}
+	if (flags & PHP_DATE_INIT_FORMAT) {
+		timelib_fill_holes(dateobj->time, now, options);
+	}
+	timelib_update_ts(dateobj->time, tzi);
+
+	timelib_time_dtor(now);
+
+	return 1;
