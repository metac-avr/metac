+	char *new_abbr = NULL;
+	timelib_sll new_offset = 0;
+	time_t sec;
+	suseconds_t usec;
+	int options = 0;
+
+	if (dateobj->time) {
+		timelib_time_dtor(dateobj->time);
+		dateobj->time = NULL;
@@ -2273,2 +2283,8 @@ static void update_errors_warnings(timelib_error_container **last_errors) /* {{{
