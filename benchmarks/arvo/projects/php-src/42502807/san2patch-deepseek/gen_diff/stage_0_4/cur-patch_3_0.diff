--- a/Zend/Optimizer/zend_optimizer.c
+++ b/Zend/Optimizer/zend_optimizer.c
@@ -1077,5 +1077,16 @@ static void zend_redo_pass_two(zend_op_array *op_array)
-		op_array->opcodes = (zend_op *) erealloc(op_array->opcodes,
-			ZEND_MM_ALIGNED_SIZE_EX(sizeof(zend_op) * op_array->last, 16) +
-			sizeof(zval) * op_array->last_literal);
-		memcpy(((char*)op_array->opcodes) + ZEND_MM_ALIGNED_SIZE_EX(sizeof(zend_op) * op_array->last, 16),
-			op_array->literals, sizeof(zval) * op_array->last_literal);
+		size_t opcode_size, literal_size, total_size;
+		if (ZEND_MM_ALIGNED_SIZE_EX(sizeof(zend_op) * op_array->last, 16) > SIZE_MAX - sizeof(zval) * op_array->last_literal) {
+			zend_error_noreturn(E_ERROR, "Invalid op_array size");
+		}
+		opcode_size = ZEND_MM_ALIGNED_SIZE_EX(sizeof(zend_op) * op_array->last, 16);
+		literal_size = sizeof(zval) * op_array->last_literal;
+		total_size = opcode_size + literal_size;
+		if (total_size < opcode_size || total_size < literal_size) {
+			zend_error_noreturn(E_ERROR, "Invalid op_array size");
+		}
+		op_array->opcodes = (zend_op *) erealloc(op_array->opcodes, total_size);
+		if (UNEXPECTED(!op_array->opcodes)) {
+			zend_error_noreturn(E_ERROR, "Out of memory");
+		}
+		memcpy(((char*)op_array->opcodes) + opcode_size,
+			op_array->literals, literal_size);
@@ -1083 +1094 @@ static void zend_redo_pass_two(zend_op_array *op_array)
-		op_array->literals = (zval*)(((char*)op_array->opcodes) + ZEND_MM_ALIGNED_SIZE_EX(sizeof(zend_op) * op_array->last, 16));
+		op_array->literals = (zval*)(((char*)op_array->opcodes) + opcode_size);
@@ -1188,5 +1199,16 @@ static void zend_redo_pass_two_ex(zend_op_array *op_array, zend_ssa *ssa)
