diff --git a/Zend/zend_hash.c b/Zend/zend_hash.c
index 6e809c87341..0256d5dc0df 100644
--- a/Zend/zend_hash.c
+++ b/Zend/zend_hash.c
@@ -296 +296 @@ ZEND_API HashTable* ZEND_FASTCALL zend_new_pair(zval *val1, zval *val2)
-	return ht;
+return ht;
@@ -305,2 +305,12 @@ ZEND_API void ZEND_FASTCALL zend_hash_packed_grow(HashTable *ht)
-	ht->nTableSize += ht->nTableSize;
-	HT_SET_DATA_ADDR(ht, perealloc2(HT_GET_DATA_ADDR(ht), HT_PACKED_SIZE_EX(ht->nTableSize, HT_MIN_MASK), HT_PACKED_USED_SIZE(ht), GC_FLAGS(ht) & IS_ARRAY_PERSISTENT));
+	uint32_t old_size = ht->nTableSize;
+	uint32_t new_size = ht->nTableSize + ht->nTableSize;
+	if (new_size < old_size || new_size > HT_MAX_SIZE) {
+		zend_error_noreturn(E_ERROR, "Integer overflow detected in hash table growth");
+	}
+	ht->nTableSize = new_size;
+	size_t data_size = HT_PACKED_SIZE_EX(ht->nTableSize, HT_MIN_MASK);
+	size_t used_size = HT_PACKED_USED_SIZE(ht);
+	if (data_size < used_size) {
+		zend_error_noreturn(E_ERROR, "Buffer size calculation error in hash table growth");
+	}
+	HT_SET_DATA_ADDR(ht, perealloc2(HT_GET_DATA_ADDR(ht), data_size, used_size, GC_FLAGS(ht) & IS_ARRAY_PERSISTENT));
@@ -316 +325,0 @@ ZEND_API void ZEND_FASTCALL zend_hash_real_init(HashTable *ht, bool packed)
