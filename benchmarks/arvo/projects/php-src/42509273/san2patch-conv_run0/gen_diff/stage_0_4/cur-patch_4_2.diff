diff --git a/Zend/zend_gc.c b/Zend/zend_gc.c
index de7353013f0..5a771cc5f2e 100644
--- a/Zend/zend_gc.c
+++ b/Zend/zend_gc.c
@@ -1485,0 +1486,6 @@ ZEND_API int zend_gc_collect_cycles(void)
+static ZEND_COLD zend_ulong zend_gc_collect_cycles(void)
+{
+	zend_gc_stack stack;
+	uint32_t count;
+	zend_ulong freed = 0;
+	zend_long gc_flags = 0;
@@ -1487,3 +1493,3 @@ ZEND_API int zend_gc_collect_cycles(void)
-		if (GC_G(gc_active)) {
-			return 0;
-		}
+	if (GC_G(gc_active)) {
+		return 0;
+	}
@@ -1491,3 +1497,3 @@ ZEND_API int zend_gc_collect_cycles(void)
-		GC_TRACE("Collecting cycles");
-		GC_G(gc_runs)++;
-		GC_G(gc_active) = 1;
+	GC_TRACE("Collecting cycles");
+	GC_G(gc_runs)++;
+	GC_G(gc_active) = 1;
@@ -1495,4 +1501,4 @@ ZEND_API int zend_gc_collect_cycles(void)
-		GC_TRACE("Marking roots");
-		gc_mark_roots(&stack);
-		GC_TRACE("Scanning roots");
-		gc_scan_roots(&stack);
+	GC_TRACE("Marking roots");
+	gc_mark_roots(&stack);
+	GC_TRACE("Scanning roots");
+	gc_scan_roots(&stack);
@@ -1500,2 +1506,2 @@ ZEND_API int zend_gc_collect_cycles(void)
-		GC_TRACE("Collecting roots");
-		count = gc_collect_roots(&gc_flags, &stack);
+	GC_TRACE("Collecting roots");
+	count = gc_collect_roots(&gc_flags, &stack);
@@ -1503,5 +1509,6 @@ ZEND_API int zend_gc_collect_cycles(void)
-		if (!GC_G(num_roots)) {
-			/* nothing to free */
-			GC_TRACE("Nothing to free");
-			gc_stack_free(&stack);
-			GC_G(gc_active) = 0;
+	if (!GC_G(num_roots)) {
+		/* nothing to free */
+		GC_TRACE("Nothing to free");
+		gc_stack_free(&stack);
+		return 0;
+	}			GC_G(gc_active) = 0;
