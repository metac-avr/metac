diff --git a/Zend/zend_gc.c b/Zend/zend_gc.c
index de7353013f0..810f4883624 100644
--- a/Zend/zend_gc.c
+++ b/Zend/zend_gc.c
@@ -891,20 +891,34 @@ static void gc_mark_grey(zend_refcounted *ref, gc_stack *stack)
-			if (Z_TYPE_P(zv) == IS_INDIRECT) {
-				zv = Z_INDIRECT_P(zv);
-			}
-			if (Z_REFCOUNTED_P(zv)) {
-				ref = Z_COUNTED_P(zv);
-				GC_DELREF(ref);
-				if (!GC_REF_CHECK_COLOR(ref, GC_GREY)) {
-					GC_REF_SET_COLOR(ref, GC_GREY);
-					p++;
-					while (--n) {
-						zv = &p->val;
-						if (Z_TYPE_P(zv) == IS_INDIRECT) {
-							zv = Z_INDIRECT_P(zv);
-						}
-						if (Z_REFCOUNTED_P(zv)) {
-							zend_refcounted *ref = Z_COUNTED_P(zv);
-							GC_DELREF(ref);
-							if (!GC_REF_CHECK_COLOR(ref, GC_GREY)) {
-								GC_REF_SET_COLOR(ref, GC_GREY);
-								GC_STACK_PUSH(ref);
+			if (zv && (Z_TYPE_FLAGS_P(zv) & (IS_TYPE_MASK|IS_TYPE_CONSTANT)) != 0) {
+				if (Z_TYPE_P(zv) == IS_INDIRECT) {
+					zv = Z_INDIRECT_P(zv);
+					if (!zv || (Z_TYPE_FLAGS_P(zv) & (IS_TYPE_MASK|IS_TYPE_CONSTANT)) == 0) {
+						p++;
+						continue;
+					}
+				}
+				if (Z_REFCOUNTED_P(zv)) {
+					ref = Z_COUNTED_P(zv);
+					GC_DELREF(ref);
+					if (!GC_REF_CHECK_COLOR(ref, GC_GREY)) {
+						GC_REF_SET_COLOR(ref, GC_GREY);
+						p++;
+						while (--n) {
+							zv = &p->val;
+							if (!zv || (Z_TYPE_FLAGS_P(zv) & (IS_TYPE_MASK|IS_TYPE_CONSTANT)) == 0) {
+								p++;
+								continue;
+							}
+							if (Z_TYPE_P(zv) == IS_INDIRECT) {
+								zv = Z_INDIRECT_P(zv);
+								if (!zv || (Z_TYPE_FLAGS_P(zv) & (IS_TYPE_MASK|IS_TYPE_CONSTANT)) == 0) {
+									p++;
+									continue;
+								}
+							}
+							if (Z_REFCOUNTED_P(zv)) {
+								zend_refcounted *ref = Z_COUNTED_P(zv);
+								GC_DELREF(ref);
+								if (!GC_REF_CHECK_COLOR(ref, GC_GREY)) {
+									GC_REF_SET_COLOR(ref, GC_GREY);
+									GC_STACK_PUSH(ref);
+								}
