@@ -1434,25 +1434,10 @@ ZEND_API zend_result ZEND_FASTCALL zend_hash_del_ind(HashTable *ht, zend_string
-		if ((p->key == key) ||
-			(p->h == h &&
-		     p->key &&
-		     zend_string_equal_content(p->key, key))) {
-			if (Z_TYPE(p->val) == IS_INDIRECT) {
-				zval *data = Z_INDIRECT(p->val);
-
-				if (UNEXPECTED(Z_TYPE_P(data) == IS_UNDEF)) {
-					return FAILURE;
-				} else {
-					if (ht->pDestructor) {
-						zval tmp;
-						ZVAL_COPY_VALUE(&tmp, data);
-						ZVAL_UNDEF(data);
-						ht->pDestructor(&tmp);
-					} else {
-						ZVAL_UNDEF(data);
-					}
-					HT_FLAGS(ht) |= HASH_FLAG_HAS_EMPTY_IND;
