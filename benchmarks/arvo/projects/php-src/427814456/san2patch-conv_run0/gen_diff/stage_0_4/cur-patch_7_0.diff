diff --git a/Zend/zend_hash.c b/Zend/zend_hash.c
index 8ee292106a6..b5654d48cc4 100644
--- a/Zend/zend_hash.c
+++ b/Zend/zend_hash.c
@@ -1446 +1446,2 @@ ZEND_API zend_result ZEND_FASTCALL zend_hash_del_ind(HashTable *ht, zend_string
