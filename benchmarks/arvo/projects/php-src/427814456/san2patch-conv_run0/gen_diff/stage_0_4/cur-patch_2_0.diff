diff --git a/Zend/zend_variables.c b/Zend/zend_variables.c
index 06483d581df..d900bb6e66e 100644
--- a/Zend/zend_variables.c
+++ b/Zend/zend_variables.c
@@ -57 +57 @@ ZEND_API void ZEND_FASTCALL rc_dtor_func(zend_refcounted *p)
-	zend_rc_dtor_func[GC_TYPE(p)](p);
+zend_rc_dtor_func[GC_TYPE(p)](p);
@@ -65,3 +65,4 @@ static void ZEND_FASTCALL zend_string_destroy(zend_string *str)
-	ZEND_ASSERT(GC_REFCOUNT(str) == 0);
-	ZEND_ASSERT(!(GC_FLAGS(str) & IS_STR_PERSISTENT));
-	efree(str);
+	/* Prevent use-after-free: validate string state before destruction */
+	if (GC_REFCOUNT(str) == 0 && !(GC_FLAGS(str) & IS_STR_PERSISTENT)) {
+		efree(str);
+	}
@@ -77 +77,0 @@ static void ZEND_FASTCALL zend_reference_destroy(zend_reference *ref)
-
diff --git a/Zend/zend_vm_execute.h b/Zend/zend_vm_execute.h
index 2ba23ff65bb..50f30527695 100644
--- a/Zend/zend_vm_execute.h
+++ b/Zend/zend_vm_execute.h
@@ -19574 +19574,3 @@ static ZEND_OPCODE_HANDLER_RET ZEND_FASTCALL ZEND_ROPE_END_SPEC_TMP_CONST_HANDLE
-					zend_string_release_ex(rope[i], 0);
+					if (rope[i] && !ZSTR_IS_INTERNED(rope[i])) {
+						zend_string_release_ex(rope[i], 0);
+					}
@@ -19582,2 +19584,5 @@ static ZEND_OPCODE_HANDLER_RET ZEND_FASTCALL ZEND_ROPE_END_SPEC_TMP_CONST_HANDLE
-		len += ZSTR_LEN(rope[i]);
-	}
+		if (rope[i] && !ZSTR_IS_INTERNED(rope[i])) {
+			len += ZSTR_LEN(rope[i]);
+		}
+// FIXME: Crash CWE-825: Expired Pointer Dereference
+ 	}
@@ -19588,3 +19593,5 @@ static ZEND_OPCODE_HANDLER_RET ZEND_FASTCALL ZEND_ROPE_END_SPEC_TMP_CONST_HANDLE
-		memcpy(target, ZSTR_VAL(rope[i]), ZSTR_LEN(rope[i]));
-		target += ZSTR_LEN(rope[i]);
-		zend_string_release_ex(rope[i], 0);
+		if (rope[i] && !ZSTR_IS_INTERNED(rope[i])) {
+			memcpy(target, ZSTR_VAL(rope[i]), ZSTR_LEN(rope[i]));
+			target += ZSTR_LEN(rope[i]);
+			zend_string_release_ex(rope[i], 0);
+		}
