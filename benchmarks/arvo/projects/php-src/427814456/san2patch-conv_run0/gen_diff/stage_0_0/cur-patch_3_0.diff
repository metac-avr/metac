+		if (rope[i]) {
+			len += ZSTR_LEN(rope[i]);
+		}
@@ -19588,3 +19593,6 @@ static ZEND_OPCODE_HANDLER_RET ZEND_FASTCALL ZEND_ROPE_END_SPEC_TMP_CONST_HANDLE
