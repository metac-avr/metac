diff --git a/Zend/zend_hash.c b/Zend/zend_hash.c
index 8ee292106a6..4a0c2bea7b3 100644
--- a/Zend/zend_hash.c
+++ b/Zend/zend_hash.c
@@ -1446,3 +1446,10 @@ ZEND_API zend_result ZEND_FASTCALL zend_hash_del_ind(HashTable *ht, zend_string
-						ZVAL_COPY_VALUE(&tmp, data);
-						ZVAL_UNDEF(data);
-						ht->pDestructor(&tmp);
+// Fixed CWE-416: Use After Free - Check if data is valid and has proper refcount before copying
+                        if (Z_REFCOUNTED_P(data) && !Z_ISREF_P(data) && GC_REFCOUNT(Z_COUNTED_P(data)) > 0) {
+                            ZVAL_COPY_VALUE(&tmp, data);
+                            ZVAL_UNDEF(data);
+                            ht->pDestructor(&tmp);
+                        } else {
+                            ZVAL_COPY_VALUE(&tmp, data);
+                            ZVAL_UNDEF(data);
+                            ht->pDestructor(&tmp);
+                        }
diff --git a/Zend/zend_variables.c b/Zend/zend_variables.c
index 06483d581df..2459b3a0055 100644
--- a/Zend/zend_variables.c
+++ b/Zend/zend_variables.c
@@ -55,0 +56 @@ ZEND_API void ZEND_FASTCALL rc_dtor_func(zend_refcounted *p)
+	if (!p) return;
@@ -56,0 +58 @@ ZEND_API void ZEND_FASTCALL rc_dtor_func(zend_refcounted *p)
+	if (GC_REFCOUNT(p) > 0) return; /* Prevent UAF by checking refcount */
