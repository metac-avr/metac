-						if (UNEXPECTED(EG(exception))) {
-							*failed = 1;
+						if (Z_STR_P(op) && !ZSTR_IS_INTERNED(Z_STR_P(op))) {
+							zend_incompatible_string_to_long_error(Z_STR_P(op));
