diff --git a/Zend/zend_operators.c b/Zend/zend_operators.c
index 4d3fe724769..101fdb58a1c 100644
--- a/Zend/zend_operators.c
+++ b/Zend/zend_operators.c
@@ -371 +371,2 @@ static zend_never_inline zend_long ZEND_FASTCALL zendi_try_get_long(zval *op, bo
-					lval = zend_dval_to_lval_cap(dval);
+// FIXME: Crash CWE-416: Use After Free
+ 					lval = zend_dval_to_lval_cap(dval);
@@ -373,3 +374,5 @@ static zend_never_inline zend_long ZEND_FASTCALL zendi_try_get_long(zval *op, bo
