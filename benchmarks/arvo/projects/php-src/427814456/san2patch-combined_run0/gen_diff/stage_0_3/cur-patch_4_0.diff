diff --git a/Zend/zend_vm_execute.h b/Zend/zend_vm_execute.h
index 2ba23ff65bb..be0c6d0d0d1 100644
--- a/Zend/zend_vm_execute.h
+++ b/Zend/zend_vm_execute.h
@@ -689 +689,11 @@ static zend_never_inline ZEND_OPCODE_HANDLER_RET ZEND_FASTCALL zend_bw_and_helpe
-		op_2 = ZVAL_UNDEFINED_OP2();
+		/* Validate string pointer before use to prevent use-after-free */
+		zend_bool valid_op2 = 1;
+		if (op_2 && Z_TYPE_P(op_2) == IS_STRING) {
+			zend_string *str_check = Z_STR_P(op_2);
+			if (!str_check || GC_REFCOUNT(str_check) == 0) {
+				valid_op2 = 0;
+			}
+		}
+		if (valid_op2) {
+			op_2 = ZVAL_UNDEFINED_OP2();
+		}
