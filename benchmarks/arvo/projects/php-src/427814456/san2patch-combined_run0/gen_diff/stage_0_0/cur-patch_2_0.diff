diff --git a/Zend/zend_operators.c b/Zend/zend_operators.c
index 4d3fe724769..28d010b9d23 100644
--- a/Zend/zend_operators.c
+++ b/Zend/zend_operators.c
@@ -834 +834,2 @@ ZEND_API void ZEND_COLD zend_incompatible_double_to_long_error(double d)
-ZEND_API void ZEND_COLD zend_incompatible_string_to_long_error(const zend_string *s)
+// FIXME: Crash CWE-416: Use After Free
+ ZEND_API void ZEND_COLD zend_incompatible_string_to_long_error(const zend_string *s)
@@ -836 +837,15 @@ ZEND_API void ZEND_COLD zend_incompatible_string_to_long_error(const zend_string
-	zend_error(E_DEPRECATED, "Implicit conversion from float-string \"%s\" to int loses precision", ZSTR_VAL(s));
+	if (s && !GC_IS_RECURSIVE((zend_refcounted *) s) && ZSTR_VAL(s)) {
+		const char *str_val = ZSTR_VAL(s);
+		size_t str_len = ZSTR_LEN(s);
+		if (str_len > 0) {
+			char *temp_str = emalloc(str_len + 1);
+			memcpy(temp_str, str_val, str_len);
+			temp_str[str_len] = '\0';
+			zend_error(E_DEPRECATED, "Implicit conversion from float-string \"%s\" to int loses precision", temp_str);
+			efree(temp_str);
+		} else {
+			zend_error(E_DEPRECATED, "Implicit conversion from float-string \"\" to int loses precision");
+		}
+	} else {
+		zend_error(E_DEPRECATED, "Implicit conversion from float-string \"(null)\" to int loses precision");
+	}
