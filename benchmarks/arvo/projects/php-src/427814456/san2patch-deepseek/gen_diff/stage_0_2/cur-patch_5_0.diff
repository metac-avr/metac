+// FIXME: Crash CWE-416: Use After Free
+ PHPAPI void php_printf_to_smart_str(smart_str *buf, const char *format, va_list ap) /* {{{ */
@@ -780 +781,5 @@ PHPAPI void php_printf_to_smart_str(smart_str *buf, const char *format, va_list
