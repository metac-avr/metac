diff --git a/ext/date/php_date.c b/ext/date/php_date.c
index 229d9890251..2a97a93cd0a 100644
--- a/ext/date/php_date.c
+++ b/ext/date/php_date.c
@@ -2320,21 +2320,42 @@ PHPAPI bool php_date_initialize(php_date_obj *dateobj, const char *time_str, siz
-			time_str = "now";
-			time_str_len = sizeof("now") - 1;
-		}
-		dateobj->time = timelib_strtotime(time_str, time_str_len, &err, DATE_TIMEZONEDB, php_date_parse_tzfile_wrapper);
-	}
-
-	/* update last errors and warnings */
-	update_errors_warnings(err);
-
-	/* If called from a constructor throw an exception */
-	if ((flags & PHP_DATE_INIT_CTOR) && err && err->error_count) {
-		/* spit out the first library error message, at least */
-		zend_throw_exception_ex(NULL, 0, "Failed to parse time string (%s) at position %d (%c): %s", time_str,
-			err->error_messages[0].position, err->error_messages[0].character, err->error_messages[0].message);
-	}
-	if (err && err->error_count) {
-		timelib_time_dtor(dateobj->time);
-		dateobj->time = 0;
-		return 0;
-	}
-
+            time_str = "now";
+            time_str_len = sizeof("now") - 1;
+        }
+        dateobj->time = timelib_strtotime(time_str, time_str_len, &err, DATE_TIMEZONEDB, php_date_parse_tzfile_wrapper);
+    }
+
+    /* Process errors immediately if constructor call */
+    if ((flags & PHP_DATE_INIT_CTOR) && err && err->error_count) {
+        /* Create local copies of error data before cleanup */
+        char error_char = err->error_messages[0].character;
+        int error_pos = err->error_messages[0].position;
+        size_t msg_len = strlen(err->error_messages[0].message);
+        size_t time_len = strlen(time_str);
+        char *error_msg = emalloc(msg_len + 1);
+        char *local_time_str = emalloc(time_len + 1);
+        
+        memcpy(error_msg, err->error_messages[0].message, msg_len + 1);
+        memcpy(local_time_str, time_str, time_len + 1);
+        
+        /* update last errors and warnings */
+        update_errors_warnings(err);
+        
+        /* spit out the first library error message, at least */
+        zend_throw_exception_ex(NULL, 0, "Failed to parse time string (%s) at position %d (%c): %s", local_time_str,
+            error_pos, error_char, error_msg);
+            
+        efree(error_msg);
+        efree(local_time_str);
+    } else {
+        /* update last errors and warnings */
+        update_errors_warnings(err);
+    }
+ 
+    /* If called from a constructor throw an exception */
+    if ((flags & PHP_DATE_INIT_CTOR) && err && err->error_count) {
+        /* Exception already thrown above */
+    }
+    if (err && err->error_count) {
+        timelib_time_dtor(dateobj->time);
+        dateobj->time = 0;
+        return 0;
+    }
