diff --git a/ext/date/php_date.c b/ext/date/php_date.c
index 229d9890251..1504c34c495 100644
--- a/ext/date/php_date.c
+++ b/ext/date/php_date.c
@@ -2316,0 +2317,18 @@ PHPAPI bool php_date_initialize(php_date_obj *dateobj, const char *time_str, siz
+static int php_date_initialize(php_date_obj *dateobj, const char *time_str, size_t time_str_len, const char *format, zval *timezone_object, int flags)
+{
+	timelib_time   *now;
+	timelib_tzinfo *tzi = NULL;
+	timelib_error_container *err = NULL;
+	int type = TIMELIB_ZONETYPE_ID, new_dst = 0;
+	char *new_abbr = NULL;
+	timelib_sll new_offset = 0;
+	time_t sec;
+	suseconds_t usec;
+	int options = 0;
+
+	if (dateobj->time) {
+		timelib_time_dtor(dateobj->time);
+		dateobj->time = NULL;
+	}
+
+	if (format) {
@@ -2338 +2356,74 @@ PHPAPI bool php_date_initialize(php_date_obj *dateobj, const char *time_str, siz
-		return 0;
+	}
+	if (err) {
+		timelib_error_container_dtor(err);
+	}
+
+	if (timezone_object) {
+		php_date_obj *tzobj = Z_PHPDATE_P(timezone_object);
+		type = tzobj->time->zone_type;
+		switch (type) {
+			case TIMELIB_ZONETYPE_ID:
+				new_abbr = estrdup(tzobj->time->tz_info->name);
+				break;
+			case TIMELIB_ZONETYPE_OFFSET:
+				new_offset = tzobj->time->z;
+				break;
+			case TIMELIB_ZONETYPE_ABBR:
+				new_abbr = estrdup(tzobj->time->tz_abbr);
+				if (strcmp(tzobj->time->tz_abbr, "UTC") == 0) {
+					type = TIMELIB_ZONETYPE_OFFSET;
+					new_offset = 0;
+				}
+				break;
+		}
+	} else if (dateobj->time->tz_info) {
+		type = TIMELIB_ZONETYPE_ID;
+	} else {
+		type = TIMELIB_ZONETYPE_OFFSET;
+	}
+
+	now = timelib_time_ctor();
+	now->zone_type = type;
+	switch (type) {
+		case TIMELIB_ZONETYPE_ID:
+			if (timezone_object && Z_PHPDATE_P(timezone_object)->time->tz_info) {
+				now->tz_info = Z_PHPDATE_P(timezone_object)->time->tz_info;
+			} else {
+				now->tz_info = dateobj->time->tz_info;
+			}
+			break;
+		case TIMELIB_ZONETYPE_OFFSET:
+			now->z = new_offset;
+			break;
+		case TIMELIB_ZONETYPE_ABBR:
+			now->tz_abbr = new_abbr;
+			break;
+	}
+
+	php_date_get_current_time_with_fraction(&sec, &usec);
+	timelib_unixtime2local(now, (timelib_sll) sec);
+	php_date_set_time_fraction(now, usec);
+
+	if (!format) {
+		options = TIMELIB_NO_CLONE;
+	}
+	if (flags & PHP_DATE_INIT_FORMAT) {
+		options |= TIMELIB_NO_CLONE;
+	}
+	timelib_fill_holes(dateobj->time, now, options);
+
+	timelib_update_ts(dateobj->time, tzi);
+	dateobj->time->zone_type = type;
+	if (type == TIMELIB_ZONETYPE_ABBR) {
+		dateobj->time->tz_abbr = new_abbr;
+		new_abbr = NULL;
+	}
+	dateobj->time->z = new_offset;
+
+	timelib_time_dtor(now);
+	if (new_abbr) {
+		efree(new_abbr);
+	}
+
+	return 1;
+}		return 0;
