+            time_str = "now";
+            time_str_len = sizeof("now") - 1;
+        }
+        dateobj->time = timelib_strtotime(time_str, time_str_len, &err, DATE_TIMEZONEDB, php_date_parse_tzfile_wrapper);
+    }
+
+    /* Copy error information before freeing */
+    int error_count = 0;
+    char *error_message = NULL;
+    int error_position = 0;
+    char error_character = 0;
+    
+    if (err) {
+        error_count = err->error_count;
+        if (err->error_count > 0 && err->error_messages) {
+            error_message = estrdup(err->error_messages[0].message);
+            error_position = err->error_messages[0].position;
+            error_character = err->error_messages[0].character;
+        }
+    }
+    
+    /* update last errors and warnings */
+    update_errors_warnings(err);
+    // Fixed: Access copied error info instead of freed memory
+    
+    /* If called from a constructor throw an exception */
+    if ((flags & PHP_DATE_INIT_CTOR) && error_count > 0) {
