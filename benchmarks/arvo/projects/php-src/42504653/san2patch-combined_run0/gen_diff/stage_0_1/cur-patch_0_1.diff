diff --git a/Zend/zend_types.h b/Zend/zend_types.h
index 4a1232198fc..3d5d5a5a19e 100644
--- a/Zend/zend_types.h
+++ b/Zend/zend_types.h
@@ -1209,3 +1208,0 @@ static zend_always_inline uint32_t zval_set_refcount_p(zval* pz, uint32_t rc) {
-	return GC_SET_REFCOUNT(Z_COUNTED_P(pz), rc);
-}
-
@@ -1216,0 +1214 @@ static zend_always_inline uint32_t zval_addref_p(zval* pz) {
+/* Crash CWE-416: Use After Free */
@@ -1219,12 +1217,5 @@ static zend_always_inline uint32_t zval_delref_p(zval* pz) {
-	return GC_DELREF(Z_COUNTED_P(pz));
-}
-
-#if SIZEOF_SIZE_T == 4
-# define ZVAL_COPY_VALUE_EX(z, v, gc, t)				\
-	do {												\
-		uint32_t _w2 = v->value.ww.w2;					\
-		Z_COUNTED_P(z) = gc;							\
-		z->value.ww.w2 = _w2;							\
-		Z_TYPE_INFO_P(z) = t;							\
-	} while (0)
-#elif SIZEOF_SIZE_T == 8
+	if (EXPECTED(pz != NULL) && EXPECTED(Z_COUNTED_P(pz) != NULL)) {
+		return GC_DELREF(Z_COUNTED_P(pz));
+	}
+	return 0;
+}#elif SIZEOF_SIZE_T == 8
diff --git a/ext/opcache/jit/zend_jit_vm_helpers.c b/ext/opcache/jit/zend_jit_vm_helpers.c
index d48e2782566..613b69cb73c 100644
--- a/ext/opcache/jit/zend_jit_vm_helpers.c
+++ b/ext/opcache/jit/zend_jit_vm_helpers.c
@@ -861,0 +862 @@ zend_jit_trace_stop ZEND_FASTCALL zend_jit_trace_execute(zend_execute_data *ex,
+		/* Validate execute_data before accessing to prevent use-after-free */
@@ -862,0 +864,7 @@ zend_jit_trace_stop ZEND_FASTCALL zend_jit_trace_execute(zend_execute_data *ex,
+			/* Check if execute_data is valid to prevent dereferencing freed memory */
+			if (execute_data == NULL || prev_execute_data == NULL) {
+				stop = ZEND_JIT_TRACE_STOP_ERROR;
+				halt = ZEND_JIT_TRACE_HALT;
+				break;
+			}
+		}
@@ -875 +883,2 @@ zend_jit_trace_stop ZEND_FASTCALL zend_jit_trace_execute(zend_execute_data *ex,
-			execute_data = EG(current_execute_data);
+		}
+#endif			execute_data = EG(current_execute_data);
