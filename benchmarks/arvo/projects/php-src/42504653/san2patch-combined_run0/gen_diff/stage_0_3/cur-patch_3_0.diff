@@ -862,0 +864,9 @@ zend_jit_trace_stop ZEND_FASTCALL zend_jit_trace_execute(zend_execute_data *ex,
+			/* Check for expired pointer before proceeding */
+			if (execute_data && execute_data->This.ptr) {
+				zend_object *obj = Z_OBJ(execute_data->This);
+				if (obj && GC_DELREF(obj) < 0) {
