-		if (UNEXPECTED(execute_data != prev_execute_data)) {
+// FIXME: Crash CWE-416: Use After Free
+ 		if (UNEXPECTED(execute_data != prev_execute_data)) {
+			/* Validate execute_data pointers to prevent use-after-free */
+			if (UNEXPECTED(ZEND_GC_REFCOUNTED_P(EX_VAR(opline->op1.var)))) {
