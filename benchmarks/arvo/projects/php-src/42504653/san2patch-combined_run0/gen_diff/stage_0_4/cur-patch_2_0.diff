+					// Handle null case to prevent dereferencing
+					goto assign_dim_error;
+				}
@@ -30065,3 +30072,4 @@ static ZEND_OPCODE_HANDLER_RET ZEND_FASTCALL ZEND_ASSIGN_DIM_SPEC_VAR_CV_OP_DATA
