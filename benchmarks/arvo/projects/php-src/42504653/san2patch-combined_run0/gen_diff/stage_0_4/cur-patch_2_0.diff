@@ -862 +862,7 @@ zend_jit_trace_stop ZEND_FASTCALL zend_jit_trace_execute(zend_execute_data *ex,
-		if (UNEXPECTED(execute_data != prev_execute_data)) {
+// FIXME: Crash CWE-416: Use After Free
+ 		if (UNEXPECTED(execute_data != prev_execute_data)) {
+			/* Prevent use-after-free by checking if the zval is still valid before reference counting */
