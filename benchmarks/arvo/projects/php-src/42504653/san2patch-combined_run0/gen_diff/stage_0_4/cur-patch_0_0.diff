+++ b/ext/opcache/jit/zend_jit_vm_helpers.c
@@ -862 +862,10 @@ zend_jit_trace_stop ZEND_FASTCALL zend_jit_trace_execute(zend_execute_data *ex,
-		if (UNEXPECTED(execute_data != prev_execute_data)) {
+// FIXME: Crash CWE-416: Use After Free
+ 		if (UNEXPECTED(execute_data != prev_execute_data)) {
+			/* Validate execute_data before proceeding to prevent use-after-free */
+			if (execute_data && ZEND_GC_IS_REFCOUNTED_P(EX_VAR(opline->result.var))) {
+				zend_refcounted *ref = Z_COUNTED_P(EX_VAR(opline->result.var));
+				if (ref && GC_HAS destructors(ref)) {
+					/* Safe to proceed with reference counting */
+					zend_gc_delref(ref);
+				}
+			}
