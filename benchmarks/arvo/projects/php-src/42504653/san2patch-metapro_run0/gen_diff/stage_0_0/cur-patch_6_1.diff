+++ b/Zend/zend_vm_execute.h
@@ -29955 +29955,6 @@ static ZEND_OPCODE_HANDLER_RET ZEND_FASTCALL ZEND_ASSIGN_DIM_SPEC_VAR_CV_OP_DATA
-
+		zval *op1_val = EX_VAR(opline->op1.var);
+		if (op1_val && Z_TYPE_P(op1_val) != IS_UNDEF) {
+			zval_ptr_dtor_nogc(op1_val);
