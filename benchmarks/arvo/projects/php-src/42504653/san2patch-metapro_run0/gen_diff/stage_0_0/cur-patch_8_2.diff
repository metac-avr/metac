+++ b/Zend/zend_vm_execute.h
@@ -29955 +29955,7 @@ static ZEND_OPCODE_HANDLER_RET ZEND_FASTCALL ZEND_ASSIGN_DIM_SPEC_VAR_CV_OP_DATA
-
+// FIXME: Crash CWE-825: Expired Pointer Dereference
+		zval *op1_val = EX_VAR(opline->op1.var);
+		if (EXPECTED(op1_val != NULL) && EXPECTED(Z_TYPE_P(op1_val) > IS_UNDEF)) {
+			zval_ptr_dtor_nogc(op1_val);
+		}
+	} else {
+		zval_ptr_dtor_nogc(EX_VAR(opline->op1.var));
@@ -29957 +29962,0 @@ static ZEND_OPCODE_HANDLER_RET ZEND_FASTCALL ZEND_ASSIGN_DIM_SPEC_VAR_CV_OP_DATA
-	zval_ptr_dtor_nogc(EX_VAR(opline->op1.var));
