diff --git a/ext/opcache/jit/zend_jit_vm_helpers.c b/ext/opcache/jit/zend_jit_vm_helpers.c
index d48e2782566..4ab8de27c51 100644
--- a/ext/opcache/jit/zend_jit_vm_helpers.c
+++ b/ext/opcache/jit/zend_jit_vm_helpers.c
@@ -861,0 +862 @@ zend_jit_trace_stop ZEND_FASTCALL zend_jit_trace_execute(zend_execute_data *ex,
+// FIXME: Crash CWE-825: Expired Pointer Dereference
@@ -862,0 +864,14 @@ zend_jit_trace_stop ZEND_FASTCALL zend_jit_trace_execute(zend_execute_data *ex,
+			/* Check for expired pointers before JIT continuation */
+			if (execute_data && execute_data->This.u1.v.type == IS_ARRAY) {
+				zend_array *arr = Z_ARR(execute_data->This);
+				if (GC_REFCOUNT(arr) > 0 && !((GC_FLAGS(arr) & GC_IMMUTABLE) || (GC_FLAGS(arr) & GC_PERSISTENT))) {
+					/* Valid reference count, continue safely */
+				} else {
+					/* Array has been freed or is invalid */
+					stop = ZEND_JIT_TRACE_STOP_RETURN;
+					opline = NULL;
+					halt = ZEND_JIT_TRACE_HALT;
+					break;
+				}
+			}
+		}
@@ -874,0 +890 @@ zend_jit_trace_stop ZEND_FASTCALL zend_jit_trace_execute(zend_execute_data *ex,
+
