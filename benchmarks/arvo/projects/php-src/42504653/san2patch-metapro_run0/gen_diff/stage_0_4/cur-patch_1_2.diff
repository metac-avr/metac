diff --git a/Zend/zend_hash.c b/Zend/zend_hash.c
index 8ee292106a6..01b3b11c693 100644
--- a/Zend/zend_hash.c
+++ b/Zend/zend_hash.c
@@ -1680,0 +1681,24 @@ ZEND_API void ZEND_FASTCALL zend_array_destroy(HashTable *ht)
+ZEND_API void ZEND_FASTCALL zend_hash_destroy(HashTable *ht)
+{
+	Bucket *p, *end;
+
+	IS_CONSISTENT(ht);
+	HT_ASSERT_RC1(ht);
+
+	if (ht->nNumUsed) {
+		if (HT_HAS_STATIC_KEYS_ONLY(ht)) {
+			for (p = ht->arData, end = p + ht->nNumUsed; p != end; p++) {
+				if (Z_TYPE(p->val) == IS_UNDEF) continue;
+				if (Z_TYPE(p->val) <= IS_FALSE) continue;
+				zval_ptr_dtor_nogc(&p->val);
+			}
+		} else {
+			for (p = ht->arData, end = p + ht->nNumUsed; p != end; p++) {
+				if (Z_TYPE(p->val) == IS_UNDEF) continue;
+				if (Z_TYPE(p->val) <= IS_FALSE) continue;
+				zval_ptr_dtor_nogc(&p->val);
+				if (p->key) {
+					zend_string_release(p->key);
+				}
+			}
+		}
@@ -1688,5 +1711,0 @@ ZEND_API void ZEND_FASTCALL zend_array_destroy(HashTable *ht)
-
-ZEND_API void ZEND_FASTCALL zend_hash_clean(HashTable *ht)
