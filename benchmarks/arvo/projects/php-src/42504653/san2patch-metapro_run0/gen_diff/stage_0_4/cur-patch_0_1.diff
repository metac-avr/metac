diff --git a/Zend/zend_hash.c b/Zend/zend_hash.c
index 8ee292106a6..652e94c6cc3 100644
--- a/Zend/zend_hash.c
+++ b/Zend/zend_hash.c
@@ -1680,0 +1681,21 @@ ZEND_API void ZEND_FASTCALL zend_array_destroy(HashTable *ht)
+ZEND_API void ZEND_FASTCALL zend_hash_destroy(HashTable *ht)
+{
+	Bucket *p, *end;
+
+	IS_CONSISTENT(ht);
+	HT_ASSERT_RC1(ht);
+	zend_hash_iterators_remove(ht);
+
+	if (ht->nNumUsed) {
+		p = ht->arData;
+		end = p + ht->nNumUsed;
+		do {
+			if (Z_TYPE(p->val) == IS_UNDEF) continue;
+			_ht->nNumUsed = 0;
+			_ht->nInternalPointer = 0;
+		} while (++p != end);
+	}
+	if (EXPECTED(ht->nTableMask == (uint32_t)-1)) {
+		pefree(ht->arData, ht->u.flags & HASH_FLAG_PERSISTENT);
+	} else {
+		pefree(HT_GET_DATA_ADDR(ht), ht->u.flags & HASH_FLAG_PERSISTENT);
@@ -1684 +1705 @@ ZEND_API void ZEND_FASTCALL zend_array_destroy(HashTable *ht)
-free_ht:
+	// Fixed CWE-416: Use After Free by ensuring ht is not accessed after freeing
@@ -1688,5 +1708,0 @@ ZEND_API void ZEND_FASTCALL zend_array_destroy(HashTable *ht)
-
-ZEND_API void ZEND_FASTCALL zend_hash_clean(HashTable *ht)
-{
-	Bucket *p, *end;
