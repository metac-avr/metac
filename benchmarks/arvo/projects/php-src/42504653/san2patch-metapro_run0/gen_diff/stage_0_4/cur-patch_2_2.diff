+++ b/Zend/zend_hash.c
@@ -1680,0 +1681,14 @@ ZEND_API void ZEND_FASTCALL zend_array_destroy(HashTable *ht)
+ZEND_API void ZEND_FASTCALL zend_hash_destroy(HashTable *ht)
+{
+	Bucket *p, *end;
+
+	IS_CONSISTENT(ht);
+	HT_ASSERT_RC1(ht);
+
+	if (ht->nNumUsed) {
+		p = ht->arData;
+		end = p + ht->nNumUsed;
+		do {
+			if (Z_TYPE(p->val) == IS_UNDEF) continue;
+			zval_ptr_dtor(&p->val);
+		} while (++p != end);
@@ -1688,5 +1701,0 @@ ZEND_API void ZEND_FASTCALL zend_array_destroy(HashTable *ht)
