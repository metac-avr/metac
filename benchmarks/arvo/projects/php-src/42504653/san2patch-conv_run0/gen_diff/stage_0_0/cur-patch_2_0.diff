@@ -862,0 +864,8 @@ zend_jit_trace_stop ZEND_FASTCALL zend_jit_trace_execute(zend_execute_data *ex,
+			/* Add safety check for freed memory access */
+			if (UNEXPECTED(ZEND_GC_TYPE((zend_refcounted*)execute_data) == IS_UNDEF)) {
