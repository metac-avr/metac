@@ -861,0 +862 @@ zend_jit_trace_stop ZEND_FASTCALL zend_jit_trace_execute(zend_execute_data *ex,
+// FIXME: Crash CWE-825: Expired Pointer Dereference
@@ -862,0 +864,10 @@ zend_jit_trace_stop ZEND_FASTCALL zend_jit_trace_execute(zend_execute_data *ex,
+			/* Validate execute_data pointer before use to prevent use-after-free */
+			if (execute_data && ZEND_GC_HAS_CHILDREN(Z_OBJ(execute_data->This))) {
+				/* Ensure the object is still valid */
+				zend_object *obj = Z_OBJ(execute_data->This);
+				if (obj->gc.refcount <= 0) {
+					/* Object has been freed, skip processing */
+					continue;
+				}
+			}
+		}
