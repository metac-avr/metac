@@ -1683,2 +1683 @@ ZEND_API void ZEND_FASTCALL zend_array_destroy(HashTable *ht)
-	efree(HT_GET_DATA_ADDR(ht));
-free_ht:
+	/* Remove iterators first to prevent dangling pointer access */
@@ -1685,0 +1685,5 @@ ZEND_API void ZEND_FASTCALL zend_array_destroy(HashTable *ht)
