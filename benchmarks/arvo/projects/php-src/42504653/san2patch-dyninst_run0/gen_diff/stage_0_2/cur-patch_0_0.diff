-
-static zend_always_inline void zend_gc_try_delref(zend_refcounted_h *p) {
-	if (!(p->u.type_info & GC_IMMUTABLE)) {
-		ZEND_RC_MOD_CHECK(p);
-		--p->refcount;
-	}
-}
-
@@ -1185,10 +1176,6 @@ static zend_always_inline uint32_t zend_gc_delref(zend_refcounted_h *p) {
-	return --(p->refcount);
