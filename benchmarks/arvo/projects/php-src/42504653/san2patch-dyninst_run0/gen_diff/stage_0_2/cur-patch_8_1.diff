diff --git a/Zend/zend_hash.c b/Zend/zend_hash.c
index 8ee292106a6..2522df0761c 100644
--- a/Zend/zend_hash.c
+++ b/Zend/zend_hash.c
@@ -1683,2 +1683 @@ ZEND_API void ZEND_FASTCALL zend_array_destroy(HashTable *ht)
-	efree(HT_GET_DATA_ADDR(ht));
-free_ht:
+	/* Prevent use-after-free by clearing iterators before memory deallocation */
@@ -1685,0 +1685,6 @@ ZEND_API void ZEND_FASTCALL zend_array_destroy(HashTable *ht)
+	/* Add null check before freeing memory */
+	void *data_addr = HT_GET_DATA_ADDR(ht);
+	if (data_addr) {
+		efree(data_addr);
+	}
+ free_ht:
