diff --git a/Zend/zend_types.h b/Zend/zend_types.h
index 4a1232198fc..ea596430e3c 100644
--- a/Zend/zend_types.h
+++ b/Zend/zend_types.h
@@ -1181 +1181,2 @@ static zend_always_inline void zend_gc_try_delref(zend_refcounted_h *p) {
-
+// FIXME: Crash CWE-416: Use After Free
+ 
@@ -1183,3 +1184,7 @@ static zend_always_inline uint32_t zend_gc_delref(zend_refcounted_h *p) {
-	ZEND_ASSERT(p->refcount > 0);
-	ZEND_RC_MOD_CHECK(p);
-	return --(p->refcount);
+	/* Validate pointer before use to prevent use-after-free */
+	if (__builtin_expect(!!(p), 1)) {
+		ZEND_ASSERT(p->refcount > 0);
+		ZEND_RC_MOD_CHECK(p);
+		return --(p->refcount);
+	}
+	return 0;
@@ -1193 +1197,0 @@ static zend_always_inline uint32_t zend_gc_addref_ex(zend_refcounted_h *p, uint3
-
