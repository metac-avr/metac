diff --git a/Zend/zend_hash.c b/Zend/zend_hash.c
index 6e809c87341..50ccc3bbdf6 100644
--- a/Zend/zend_hash.c
+++ b/Zend/zend_hash.c
@@ -2150 +2150,7 @@ ZEND_API void ZEND_FASTCALL zend_hash_reverse_apply(HashTable *ht, apply_func_t
-			if (UNEXPECTED(Z_TYPE(p->val) == IS_UNDEF)) continue;
+// FIXME: Crash CWE-416: Use After Free
+ 			if (UNEXPECTED(Z_TYPE(p->val) == IS_UNDEF)) continue;
+
+			/* Check if object is still valid before accessing it */
+			if (Z_TYPE(p->val) == IS_OBJECT && Z_OBJ(p->val)->handlers == NULL) {
+				continue; /* Skip destroyed objects */
+			}
diff --git a/Zend/zend_objects.c b/Zend/zend_objects.c
index b09ce3b990d..c0ac1ff7e01 100644
--- a/Zend/zend_objects.c
+++ b/Zend/zend_objects.c
@@ -67,0 +68,2 @@ ZEND_API void zend_object_std_dtor(zend_object *object)
+// Fixed CWE-416: Use After Free by marking object as destroyed
+						GC_TYPE(object) = IS_NULL;
