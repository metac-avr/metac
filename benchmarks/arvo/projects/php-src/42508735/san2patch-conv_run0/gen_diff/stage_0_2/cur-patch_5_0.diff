diff --git a/Zend/zend_types.h b/Zend/zend_types.h
index 151afadec22..14a6abf2da7 100644
--- a/Zend/zend_types.h
+++ b/Zend/zend_types.h
@@ -1231 +1231 @@ static zend_always_inline uint32_t zval_refcount_p(const zval* pz) {
-#if ZEND_DEBUG
+	#if ZEND_DEBUG
@@ -1233,2 +1233,6 @@ static zend_always_inline uint32_t zval_refcount_p(const zval* pz) {
-#endif
-	return GC_REFCOUNT(Z_COUNTED_P(pz));
+	#endif
+	zend_refcounted_h *ref = Z_COUNTED_P(pz);
+	if (UNEXPECTED(GC_REFCOUNT(ref) == 0xDEADBEEF)) {
+		return 0;
+	}
+	return GC_REFCOUNT(ref);
