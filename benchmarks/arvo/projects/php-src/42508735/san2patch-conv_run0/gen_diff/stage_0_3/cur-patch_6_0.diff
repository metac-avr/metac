diff --git a/Zend/zend_generators.c b/Zend/zend_generators.c
index a5fcad31dfe..bfd6aa81990 100644
--- a/Zend/zend_generators.c
+++ b/Zend/zend_generators.c
@@ -425,0 +426,4 @@ static zend_object *zend_generator_create(zend_class_entry *class_type) /* {{{ *
+	/* Initialize GC info to prevent use-after-free during shutdown */
+	GC_SET_REFCOUNT(&generator->std, 1);
+	GC_TYPE_INFO(&generator->std) = IS_OBJECT | ((IS_OBJ_DESTRUCTOR_CALLED | IS_OBJ_FREE_CALLED) << GC_FLAGS_SHIFT);
+
