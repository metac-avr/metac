diff --git a/Zend/zend_types.h b/Zend/zend_types.h
index 151afadec22..f8a0ae1057b 100644
--- a/Zend/zend_types.h
+++ b/Zend/zend_types.h
@@ -1175,8 +1174,0 @@ extern ZEND_API bool zend_rc_debug;
-		GC_ADD_FLAGS(p, GC_PERSISTENT_LOCAL); \
-	} while (0)
-#else
-# define ZEND_RC_MOD_CHECK(p) \
-	do { } while (0)
-# define GC_MAKE_PERSISTENT_LOCAL(p) \
-	do { } while (0)
-#endif
@@ -1184,0 +1177,3 @@ static zend_always_inline uint32_t zend_gc_refcount(const zend_refcounted_h *p)
+	if (p == NULL) {
+		return 0;
+	}
@@ -1188,0 +1184,3 @@ static zend_always_inline uint32_t zend_gc_set_refcount(zend_refcounted_h *p, ui
+	if (p == NULL) {
+		return 0;
+	}
@@ -1194,0 +1193,3 @@ static zend_always_inline uint32_t zend_gc_addref(zend_refcounted_h *p) {
+	if (p == NULL) {
+		return 0;
+	}
@@ -1197,0 +1199,8 @@ static zend_always_inline uint32_t zend_gc_addref(zend_refcounted_h *p) {
+static zend_always_inline uint32_t zend_gc_delref(zend_refcounted_h *p) {
+	ZEND_RC_MOD_CHECK(p);
+	if (p == NULL) {
+		return 0;
+	}
+	return --(p->refcount);
+}}
+
