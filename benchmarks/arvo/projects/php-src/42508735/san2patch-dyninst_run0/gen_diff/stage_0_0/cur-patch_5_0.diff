+// FIXME: Crash CWE-416: Use After Free
+                if (object->handlers && object->handlers->offset <= sizeof(zend_object)) {  // Validate offset to prevent invalid memory access
+                        ptr = ((char*)object) - object->handlers->offset;
+                        GC_REMOVE_FROM_BUFFER(object);
+                        efree(ptr);
+                        ZEND_OBJECTS_STORE_ADD_TO_FREE_LIST(handle);
+                } else {
+                        GC_REMOVE_FROM_BUFFER(object);
+                        efree(object);  // Fallback free if handlers are invalid
+                        ZEND_OBJECTS_STORE_ADD_TO_FREE_LIST(handle);
+                }
