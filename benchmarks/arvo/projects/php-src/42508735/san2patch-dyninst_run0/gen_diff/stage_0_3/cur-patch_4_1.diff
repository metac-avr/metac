diff --git a/Zend/zend_types.h b/Zend/zend_types.h
index 151afadec22..63ddb711f59 100644
--- a/Zend/zend_types.h
+++ b/Zend/zend_types.h
@@ -1234 +1234,4 @@ static zend_always_inline uint32_t zval_refcount_p(const zval* pz) {
-	return GC_REFCOUNT(Z_COUNTED_P(pz));
+	if (!pz) return 0;
+	zend_refcounted_h* counted = Z_COUNTED_P(pz);
+	if (!counted || (GC_FLAGS(counted) & GC_FREE_FLAG)) return 0;
+	return GC_REFCOUNT(counted);
