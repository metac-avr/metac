diff --git a/Zend/zend_hash.c b/Zend/zend_hash.c
index 6e809c87341..cb1324a5697 100644
--- a/Zend/zend_hash.c
+++ b/Zend/zend_hash.c
@@ -2150 +2150,3 @@ ZEND_API void ZEND_FASTCALL zend_hash_reverse_apply(HashTable *ht, apply_func_t
-			if (UNEXPECTED(Z_TYPE(p->val) == IS_UNDEF)) continue;
+// FIXME: Crash CWE-416: Use After Free
+ 			if (UNEXPECTED(Z_TYPE(p->val) == IS_UNDEF)) continue;
+			if (UNEXPECTED(Z_OBJ(p->val) && !(Z_OBJ(p->val)->gc.u.flags & 0x01))) continue;
diff --git a/Zend/zend_generators.c b/Zend/zend_generators.c
