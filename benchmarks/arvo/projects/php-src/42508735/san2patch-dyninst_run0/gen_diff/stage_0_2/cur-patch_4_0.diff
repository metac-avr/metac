+					zend_array_destroy(object->properties);
@@ -65,3 +65,6 @@ ZEND_API void zend_object_std_dtor(zend_object *object)
-					zend_property_info *prop_info = zend_get_property_info_for_slot(object, p);
-					if (ZEND_TYPE_IS_SET(prop_info->type)) {
-						ZEND_REF_DEL_TYPE_SOURCE(Z_REF_P(p), prop_info);
+						zend_property_info *prop_info = zend_get_property_info_for_slot(object, p);
+						if (ZEND_TYPE_IS_SET(prop_info->type)) {
+							ZEND_REF_DEL_TYPE_SOURCE(Z_REF_P(p), prop_info);
+// Mark object as destroyed to prevent GC access
+							GC_TYPE_INFO_SET(object, IS_NULL, GC_FLAGS(object));
+ 						}
@@ -69 +71,0 @@ ZEND_API void zend_object_std_dtor(zend_object *object)
-				}
