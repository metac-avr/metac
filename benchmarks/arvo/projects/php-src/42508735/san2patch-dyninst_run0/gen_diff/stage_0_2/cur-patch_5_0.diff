diff --git a/Zend/zend_hash.c b/Zend/zend_hash.c
index 6e809c87341..ed2ae1d7c99 100644
--- a/Zend/zend_hash.c
+++ b/Zend/zend_hash.c
@@ -2150 +2150,6 @@ ZEND_API void ZEND_FASTCALL zend_hash_reverse_apply(HashTable *ht, apply_func_t
-			if (UNEXPECTED(Z_TYPE(p->val) == IS_UNDEF)) continue;
+// FIXME: Crash CWE-825: Expired Pointer Dereference
+ 			if (UNEXPECTED(Z_TYPE(p->val) == IS_UNDEF)) continue;
+
+			if (UNEXPECTED(Z_TYPE(p->val) == IS_OBJECT && !Z_OBJ(p->val)->gc)) {
+				continue;
+			}
diff --git a/Zend/zend_objects.c b/Zend/zend_objects.c
index b09ce3b990d..9b82fd535ab 100644
--- a/Zend/zend_objects.c
+++ b/Zend/zend_objects.c
@@ -54 +54 @@ ZEND_API void zend_object_std_dtor(zend_object *object)
-				zend_array_destroy(object->properties);
+					zend_array_destroy(object->properties);
@@ -65,3 +65,8 @@ ZEND_API void zend_object_std_dtor(zend_object *object)
-					zend_property_info *prop_info = zend_get_property_info_for_slot(object, p);
-					if (ZEND_TYPE_IS_SET(prop_info->type)) {
-						ZEND_REF_DEL_TYPE_SOURCE(Z_REF_P(p), prop_info);
+						zend_property_info *prop_info = zend_get_property_info_for_slot(object, p);
+						if (ZEND_TYPE_IS_SET(prop_info->type)) {
+							ZEND_REF_DEL_TYPE_SOURCE(Z_REF_P(p), prop_info);
+// Prevent dangling pointer by clearing reference
+							if (Z_REFCOUNTED_P(p)) {
+								ZVAL_UNDEF(p);
+							}
+ 						}
@@ -69 +73,0 @@ ZEND_API void zend_object_std_dtor(zend_object *object)
-				}
