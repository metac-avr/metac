diff --git a/Zend/zend_vm_execute.h b/Zend/zend_vm_execute.h
index 63a3112405b..5484a02e1aa 100644
--- a/Zend/zend_vm_execute.h
+++ b/Zend/zend_vm_execute.h
@@ -3071 +3071,9 @@ static zend_never_inline ZEND_OPCODE_HANDLER_RET ZEND_FASTCALL zend_dispatch_try
-		ZEND_VM_TAIL_CALL(zend_leave_helper_SPEC(ZEND_OPCODE_HANDLER_ARGS_PASSTHRU));
+		/* Add safety check for expired pointer before tail call */
+		zend_execute_data *safe_prev_execute_data = EX(prev_execute_data);
