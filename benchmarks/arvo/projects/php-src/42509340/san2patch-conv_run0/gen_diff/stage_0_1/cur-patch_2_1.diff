diff --git a/Zend/zend_vm_execute.h b/Zend/zend_vm_execute.h
index 63a3112405b..706b8afbf50 100644
--- a/Zend/zend_vm_execute.h
+++ b/Zend/zend_vm_execute.h
@@ -1170 +1170,3 @@ static zend_never_inline ZEND_OPCODE_HANDLER_RET ZEND_FASTCALL zend_leave_helper
-			i_free_compiled_variables(execute_data);
+			if (execute_data != NULL && EX(prev_execute_data) != NULL) {
+				i_free_compiled_variables(execute_data);
+			}
@@ -3071 +3073,8 @@ static zend_never_inline ZEND_OPCODE_HANDLER_RET ZEND_FASTCALL zend_dispatch_try
-		ZEND_VM_TAIL_CALL(zend_leave_helper_SPEC(ZEND_OPCODE_HANDLER_ARGS_PASSTHRU));
+		/* Validate pointer before use to prevent expired pointer dereference */
+		if (EX(prev_execute_data)) {
+			ZEND_VM_TAIL_CALL(zend_leave_helper_SPEC(ZEND_OPCODE_HANDLER_ARGS_PASSTHRU));
+		} else {
+			/* Clear invalid pointer to prevent use-after-free */
+			EX(prev_execute_data) = NULL;
+			ZEND_VM_TAIL_CALL(zend_leave_helper_SPEC(ZEND_OPCODE_HANDLER_ARGS_PASSTHRU));
+		}
@@ -54571 +54580,3 @@ ZEND_API void execute_ex(zend_execute_data *ex)
-			i_free_compiled_variables(execute_data);
+			if (execute_data != NULL && EX(prev_execute_data) != NULL) {
+				i_free_compiled_variables(execute_data);
+			}
