diff --git a/Zend/zend_vm_execute.h b/Zend/zend_vm_execute.h
index 797ac66c96d..7849891096b 100644
--- a/Zend/zend_vm_execute.h
+++ b/Zend/zend_vm_execute.h
@@ -40110,6 +40110,8 @@ static ZEND_OPCODE_HANDLER_RET ZEND_FASTCALL ZEND_FETCH_OBJ_W_SPEC_CV_CONST_HAND
-	property = RT_CONSTANT(opline, opline->op2);
-	result = EX_VAR(opline->result.var);
-	zend_fetch_property_address(
-		result, container, IS_CV, property, IS_CONST,
-		((IS_CONST == IS_CONST) ? CACHE_ADDR(opline->extended_value & ~ZEND_FETCH_OBJ_FLAGS) : NULL),
-		BP_VAR_W, opline->extended_value & ZEND_FETCH_OBJ_FLAGS, 1 OPLINE_CC EXECUTE_DATA_CC);
+	if (EXPECTED(Z_TYPE_P(container) == IS_OBJECT && Z_OBJ_P(container))) {
+		property = RT_CONSTANT(opline, opline->op2);
+		result = EX_VAR(opline->result.var);
+		zend_fetch_property_address(
+			result, container, IS_CV, property, IS_CONST,
+			((IS_CONST == IS_CONST) ? CACHE_ADDR(opline->extended_value & ~ZEND_FETCH_OBJ_FLAGS) : NULL),
+			BP_VAR_W, opline->extended_value & ZEND_FETCH_OBJ_FLAGS, 1 OPLINE_CC EXECUTE_DATA_CC);
+	}
diff --git a/Zend/zend_object_handlers.c b/Zend/zend_object_handlers.c
index dab57807796..b3df2003c97 100644
--- a/Zend/zend_object_handlers.c
+++ b/Zend/zend_object_handlers.c
@@ -1067,0 +1068,4 @@ ZEND_API zval *zend_std_get_property_ptr_ptr(zend_object *zobj, zend_string *nam
+			/* Prevent use-after-free by checking object validity */
+			if (UNEXPECTED(zobj->gc.refcount == 0)) {
+				return &EG(error_zval);
+			}
