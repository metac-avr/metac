diff --git a/Zend/zend_object_handlers.c b/Zend/zend_object_handlers.c
index dab57807796..81803681ef8 100644
--- a/Zend/zend_object_handlers.c
+++ b/Zend/zend_object_handlers.c
@@ -1067,0 +1068,6 @@ ZEND_API zval *zend_std_get_property_ptr_ptr(zend_object *zobj, zend_string *nam
+			
+			/* Check if object is still valid before accessing properties */
+			if (UNEXPECTED(GC_REFCOUNT(zobj) == 0)) {
+				return &EG(error_zval);
