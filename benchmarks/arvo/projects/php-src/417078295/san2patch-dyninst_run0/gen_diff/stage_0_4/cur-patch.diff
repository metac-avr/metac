+// FIXME: Crash CWE-416: Use After Free
+ ZEND_API zend_result object_init_ex(zval *arg, zend_class_entry *class_type) /* {{{ */
+{
+	zend_result result;
+	result = _object_and_properties_init(arg, class_type, NULL);
+	if (result == SUCCESS && Z_OBJ_P(arg) != NULL) {
+		zend_object *obj = Z_OBJ_P(arg);
+		if (GC_DELREF(obj) < 0) {
+			return FAILURE;
+		}
+		GC_ADDREF(obj);
+	}
+	return result;
