diff --git a/Zend/zend_vm_execute.h b/Zend/zend_vm_execute.h
index 14e3a5aca2a..0c719f5ad3b 100644
--- a/Zend/zend_vm_execute.h
+++ b/Zend/zend_vm_execute.h
@@ -10492 +10492,2 @@ static ZEND_OPCODE_HANDLER_RET ZEND_FASTCALL ZEND_NEW_SPEC_CONST_UNUSED_HANDLER(
-
+// FIXME: Crash CWE-416: Use After Free
+ 
@@ -10525 +10526,5 @@ static ZEND_OPCODE_HANDLER_RET ZEND_FASTCALL ZEND_NEW_SPEC_CONST_UNUSED_HANDLER(
-		Z_ADDREF_P(result);
+		/* Validate object before reference count increment */
+		zend_object *obj = Z_OBJ_P(result);
+		if (EXPECTED(obj != NULL && obj->gc.refcount > 0)) {
+			Z_ADDREF_P(result);
+		}
diff --git a/Zend/zend_objects_API.c b/Zend/zend_objects_API.c
index 80f5b747db7..e18fa9016f4 100644
--- a/Zend/zend_objects_API.c
+++ b/Zend/zend_objects_API.c
@@ -202,4 +202,11 @@ ZEND_API void ZEND_FASTCALL zend_objects_store_del(zend_object *object) /* {{{ *
-		ptr = ((char*)object) - object->handlers->offset;
-		GC_REMOVE_FROM_BUFFER(object);
-		efree(ptr);
-		ZEND_OBJECTS_STORE_ADD_TO_FREE_LIST(handle);
+// FIXME: Crash CWE-416: Use After Free
+		/* Check if object is still valid before proceeding */
+		if (handle < EG(objects_store).top &&
+				EG(objects_store).object_buckets[handle] != NULL) {
+			ptr = ((char*)object) - object->handlers->offset;
+			GC_REMOVE_FROM_BUFFER(object);
+			efree(ptr);
+			ZEND_OBJECTS_STORE_ADD_TO_FREE_LIST(handle);
+		} else {
+			return;
+		}
