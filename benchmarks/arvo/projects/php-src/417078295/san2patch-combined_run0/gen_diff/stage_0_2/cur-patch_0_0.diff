diff --git a/Zend/zend_vm_execute.h b/Zend/zend_vm_execute.h
index 14e3a5aca2a..7232ce5371b 100644
--- a/Zend/zend_vm_execute.h
+++ b/Zend/zend_vm_execute.h
@@ -10525 +10525,4 @@ static ZEND_OPCODE_HANDLER_RET ZEND_FASTCALL ZEND_NEW_SPEC_CONST_UNUSED_HANDLER(
-		Z_ADDREF_P(result);
+		/* Check if result object is still valid before incrementing reference */
+		if (Z_OBJ_P(result) && Z_OBJ_P(result)->gc.refcount > 0) {
+			Z_ADDREF_P(result);
+		}
diff --git a/Zend/zend_objects_API.c b/Zend/zend_objects_API.c
index 80f5b747db7..3f8ac643b8a 100644
--- a/Zend/zend_objects_API.c
+++ b/Zend/zend_objects_API.c
@@ -202,3 +202,8 @@ ZEND_API void ZEND_FASTCALL zend_objects_store_del(zend_object *object) /* {{{ *
-		ptr = ((char*)object) - object->handlers->offset;
-		GC_REMOVE_FROM_BUFFER(object);
-		efree(ptr);
+// Fixed CWE-825: Expired Pointer Dereference by adding null check before accessing object->handlers
+		if (object && object->handlers) {
+			ptr = ((char*)object) - object->handlers->offset;
+			GC_REMOVE_FROM_BUFFER(object);
+			efree(ptr);
+		} else {
+			GC_REMOVE_FROM_BUFFER(object);
+		}
