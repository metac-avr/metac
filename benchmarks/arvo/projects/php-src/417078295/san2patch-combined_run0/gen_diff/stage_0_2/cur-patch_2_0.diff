diff --git a/Zend/zend_vm_execute.h b/Zend/zend_vm_execute.h
index 14e3a5aca2a..85759ab7e07 100644
--- a/Zend/zend_vm_execute.h
+++ b/Zend/zend_vm_execute.h
@@ -10525 +10525,5 @@ static ZEND_OPCODE_HANDLER_RET ZEND_FASTCALL ZEND_NEW_SPEC_CONST_UNUSED_HANDLER(
-		Z_ADDREF_P(result);
+		/* Add safety check for valid object reference before incrementing */
+		zend_object *obj = Z_OBJ_P(result);
+		if (obj && !(GC_FLAGS(obj) & GC_IMMUTABLE)) {
+			Z_ADDREF_P(result);
+		}
diff --git a/Zend/zend_objects_API.c b/Zend/zend_objects_API.c
index 80f5b747db7..5fa0e4ed73d 100644
--- a/Zend/zend_objects_API.c
+++ b/Zend/zend_objects_API.c
@@ -202,3 +202,8 @@ ZEND_API void ZEND_FASTCALL zend_objects_store_del(zend_object *object) /* {{{ *
-		ptr = ((char*)object) - object->handlers->offset;
-		GC_REMOVE_FROM_BUFFER(object);
-		efree(ptr);
+// Fixed CWE-825: Expired Pointer Dereference by checking object validity before access
+		if (IS_OBJ_VALID(object)) {
+			ptr = ((char*)object) - object->handlers->offset;
+			GC_REMOVE_FROM_BUFFER(object);
+			efree(ptr);
+		} else {
+			GC_REMOVE_FROM_BUFFER(object);
+		}
