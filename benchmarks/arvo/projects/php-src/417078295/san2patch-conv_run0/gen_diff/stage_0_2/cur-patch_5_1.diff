@@ -40398 +40398,10 @@ static ZEND_OPCODE_HANDLER_RET ZEND_FASTCALL ZEND_BIND_STATIC_SPEC_CV_HANDLER(ZE
-				ZVAL_COPY(&ref->val, get_zval_ptr_deref(opline->op2_type, opline->op2, BP_VAR_R));
+				zval *op2_val = get_zval_ptr_deref(opline->op2_type, opline->op2, BP_VAR_R);
+				if (op2_val) {
+					if (Z_REFCOUNTED_P(op2_val)) {
+						ZVAL_COPY(&ref->val, op2_val);
+					} else {
+						ZVAL_COPY_VALUE(&ref->val, op2_val);
+					}
+				} else {
+					ZVAL_UNDEF(&ref->val);
+				}
@@ -40406 +40415,3 @@ static ZEND_OPCODE_HANDLER_RET ZEND_FASTCALL ZEND_BIND_STATIC_SPEC_CV_HANDLER(ZE
-			Z_ADDREF_P(value);
+			if (value && Z_REFCOUNTED_P(value)) {
+				Z_ADDREF_P(value);
+			}
@@ -40414 +40425,9 @@ static ZEND_OPCODE_HANDLER_RET ZEND_FASTCALL ZEND_BIND_STATIC_SPEC_CV_HANDLER(ZE
-		ZVAL_COPY(variable_ptr, value);
+		if (value) {
+			if (Z_REFCOUNTED_P(value)) {
+				ZVAL_COPY(variable_ptr, value);
+			} else {
+				ZVAL_COPY_VALUE(variable_ptr, value);
+			}
+		} else {
+			ZVAL_UNDEF(variable_ptr);
+		}
