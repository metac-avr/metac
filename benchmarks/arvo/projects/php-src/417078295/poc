<?php

class Foo {
    public function __destruct() {
        throw new Exception('__destruct() called');
    }
}

function bar() {
    echo "bar() called\n";
    return 42;
}

function foo(bool $throw) {
    if ($throw) {
        $a = new Foo();
    }
    static $a =($a);
}

try {
    foo(true);
} catch (Exception $e) {
    echo $e->getMessage(), "\n";
}
foo(false);

?>