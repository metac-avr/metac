@@ -3274,0 +3299,14 @@ static ZEND_OPCODE_HANDLER_RET ZEND_FASTCALL ZEND_HANDLE_EXCEPTION_SPEC_HANDLER(
+// FIXME: Crash CWE-825: Expired Pointer Dereference
+ 	}
+
+	if (EX(func) && EX(func)->op_array.last_live_range) {
+		uint32_t i;
+		for (i = 0; i < EX(func)->op_array.last_live_range; i++) {
+			const zend_live_range *range = &EX(func)->op_array.live_range[i];
+			if (range->start <= throw_op_num && throw_op_num < range->end) {
+				zval *var_ptr = EX_VAR_NUM(range->var);
+				if (var_ptr && Z_TYPE_P(var_ptr) != IS_UNDEF) {
+					ZVAL_UNDEF(var_ptr);
+				}
+			}
+		}
