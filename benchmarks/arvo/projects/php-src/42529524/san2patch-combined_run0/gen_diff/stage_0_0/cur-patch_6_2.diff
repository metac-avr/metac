--- a/Zend/zend_vm_execute.h
+++ b/Zend/zend_vm_execute.h
@@ -3272,8 +3271,0 @@ static ZEND_OPCODE_HANDLER_RET ZEND_FASTCALL ZEND_HANDLE_EXCEPTION_SPEC_HANDLER(
-					zval_ptr_dtor_nogc(EX_VAR(throw_op->result.var));
-				}
-		}
-	}
-
-	ZEND_VM_TAIL_CALL(zend_dispatch_try_catch_finally_helper_SPEC(current_try_catch_offset, throw_op_num ZEND_OPCODE_HANDLER_ARGS_PASSTHRU_CC));
-}
-
@@ -3282,0 +3275 @@ static ZEND_OPCODE_HANDLER_RET ZEND_FASTCALL ZEND_USER_OPCODE_SPEC_HANDLER(ZEND_
+
@@ -3284,0 +3278,31 @@ static ZEND_OPCODE_HANDLER_RET ZEND_FASTCALL ZEND_USER_OPCODE_SPEC_HANDLER(ZEND_
+	if (UNEXPECTED(zend_user_opcode_handlers[opline->opcode] == NULL)) {
+		ZEND_VM_ABORT();
+	}
+
+	ret = zend_user_opcode_handlers[opline->opcode](execute_data);
+
+	switch (ret) {
+		case ZEND_USER_OPCODE_CONTINUE:
+			ZEND_VM_CONTINUE();
+			break;
+		case ZEND_USER_OPCODE_RETURN:
+			ZEND_VM_RETURN();
+			break;
+		case ZEND_USER_OPCODE_ENTER:
+			ZEND_VM_ENTER();
+			break;
+		case ZEND_USER_OPCODE_LEAVE:
+			ZEND_VM_LEAVE();
+			break;
+		case ZEND_USER_OPCODE_DISPATCH:
+			ZEND_VM_DISPATCH(opline->opcode, opline);
+			break;
+		case ZEND_USER_OPCODE_DISPATCH_TO:
+			ZEND_VM_DISPATCH((uint8_t)(ret & 0xff), opline);
+			break;
+		default:
+			zend_error(E_ERROR, "Invalid return code from user opcode handler: %d", ret);
+			break;
+	}
+}	int ret;
+
