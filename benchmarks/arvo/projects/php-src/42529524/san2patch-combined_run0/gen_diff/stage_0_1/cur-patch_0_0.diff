diff --git a/Zend/zend_execute.c b/Zend/zend_execute.c
index 1819d0b671d..cdbfc652249 100644
--- a/Zend/zend_execute.c
+++ b/Zend/zend_execute.c
@@ -4495 +4495,3 @@ static void cleanup_live_vars(zend_execute_data *execute_data, uint32_t op_num,
-					zval_ptr_dtor_nogc(var);
+					if (var && Z_TYPE_P(var) != IS_UNDEF) {
+						zval_ptr_dtor_nogc(var);
+					}
@@ -4498,4 +4500,5 @@ static void cleanup_live_vars(zend_execute_data *execute_data, uint32_t op_num,
