@@ -1368,3 +1367,0 @@ static zend_always_inline uint32_t zval_set_refcount_p(zval* pz, uint32_t rc) {
-	return GC_SET_REFCOUNT(Z_COUNTED_P(pz), rc);
-}
-
@@ -1375,0 +1373 @@ static zend_always_inline uint32_t zval_addref_p(zval* pz) {
+// FIXME: Crash CWE-825: Expired Pointer Dereference
@@ -1378,12 +1376,6 @@ static zend_always_inline uint32_t zval_delref_p(zval* pz) {
-	return GC_DELREF(Z_COUNTED_P(pz));
-}
-
-#if SIZEOF_SIZE_T == 4
-# define ZVAL_COPY_VALUE_EX(z, v, gc, t)				\
-	do {												\
-		uint32_t _w2 = v->value.ww.w2;					\
-		Z_COUNTED_P(z) = gc;							\
-		z->value.ww.w2 = _w2;							\
-		Z_TYPE_INFO_P(z) = t;							\
-	} while (0)
-#elif SIZEOF_SIZE_T == 8
+	zend_refcounted* counted = Z_COUNTED_P(pz);
+	if (counted != NULL) {
+		return GC_DELREF(counted);
+	}
+	return 0;
+}#elif SIZEOF_SIZE_T == 8
