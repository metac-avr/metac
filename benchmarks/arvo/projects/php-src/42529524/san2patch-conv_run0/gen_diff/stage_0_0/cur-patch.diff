diff --git a/Zend/zend_variables.h b/Zend/zend_variables.h
index d504b0f0f57..81a1a900bb7 100644
--- a/Zend/zend_variables.h
+++ b/Zend/zend_variables.h
@@ -33 +33,2 @@ ZEND_API void ZEND_FASTCALL zval_copy_ctor_func(zval *zvalue);
-static zend_always_inline void zval_ptr_dtor_nogc(zval *zval_ptr)
+// FIXME: Crash CWE-825: Expired Pointer Dereference
+ static zend_always_inline void zval_ptr_dtor_nogc(zval *zval_ptr)
@@ -35,2 +36,4 @@ static zend_always_inline void zval_ptr_dtor_nogc(zval *zval_ptr)
-	if (Z_REFCOUNTED_P(zval_ptr) && !Z_DELREF_P(zval_ptr)) {
-		rc_dtor_func(Z_COUNTED_P(zval_ptr));
+	if (zval_ptr && Z_REFCOUNTED_P(zval_ptr)) {
+		if (!Z_DELREF_P(zval_ptr)) {
+			rc_dtor_func(Z_COUNTED_P(zval_ptr));
+		}
diff --git a/Zend/zend_vm_execute.h b/Zend/zend_vm_execute.h
index c352902bbe9..27f9d3beb67 100644
--- a/Zend/zend_vm_execute.h
+++ b/Zend/zend_vm_execute.h
@@ -3190 +3190,7 @@ static zend_never_inline ZEND_OPCODE_HANDLER_RET ZEND_FASTCALL zend_dispatch_try
-		zend_observer_fcall_end(execute_data, NULL);
+// FIXME: Crash CWE-825: Expired Pointer Dereference
+ 		/* Add null check for execute_data to prevent expired pointer dereference */
+		if (execute_data != NULL) {
+ 			zend_observer_fcall_end(execute_data, NULL);
+		} else {
+			zend_observer_fcall_end(EG(current_execute_data), NULL);
+		}
