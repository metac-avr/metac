diff --git a/tree.c b/tree.c
index 50b6763b..29d98c7f 100644
--- a/tree.c
+++ b/tree.c
@@ -2094 +2094,20 @@ xmlFreePropList(xmlAttrPtr cur) {
-        xmlFreeProp(cur);
+        /* Use safe property freeing with dictionary awareness */
+        if (cur->name != NULL) {
+            /* Check if the property name is dictionary allocated */
+            if ((cur->parent != NULL) && (cur->parent->doc != NULL) && 
+                (cur->parent->doc->dict != NULL)) {
+                if (xmlDictOwns(cur->parent->doc->dict, cur->name)) {
+                    /* Mark as dictionary-owned to prevent individual free */
+                    ((xmlAttrPtr)cur)->name = NULL;
+                    xmlFreeProp(cur);
+                    /* Restore for potential later cleanup by dict */
+                    ((xmlAttrPtr)cur)->name = (const xmlChar *)cur->name;
+                } else {
+                    xmlFreeProp(cur);
+                }
+            } else {
+                xmlFreeProp(cur);
+            }
+        } else {
+            xmlFreeProp(cur);
+        }
