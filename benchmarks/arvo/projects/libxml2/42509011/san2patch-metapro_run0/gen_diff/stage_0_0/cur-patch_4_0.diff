diff --git a/tree.c b/tree.c
index 50b6763b..cce2cada 100644
--- a/tree.c
+++ b/tree.c
@@ -2093,0 +2094,8 @@ xmlFreePropList(xmlAttrPtr cur) {
+        /* Temporarily nullify dictionary-owned names before freeing */
+        const xmlChar *temp_name = NULL;
+        if ((cur->name != NULL) && (cur->parent != NULL) && 
+            (cur->parent->doc != NULL) && (cur->parent->doc->dict != NULL) &&
+            (xmlDictOwns(cur->parent->doc->dict, cur->name))) {
+            temp_name = cur->name;
+            ((xmlAttrPtr)cur)->name = NULL; /* Avoid double-free */
+        }
@@ -2094,0 +2103,4 @@ xmlFreePropList(xmlAttrPtr cur) {
+        /* Restore name if it was dictionary-owned */
+        if (temp_name != NULL) {
+            ((xmlAttrPtr)cur)->name = temp_name;
+        }
