diff --git a/tree.c b/tree.c
index 50b6763b..316b7713 100644
--- a/tree.c
+++ b/tree.c
@@ -1251 +1251 @@ xmlFreeDoc(xmlDocPtr cur) {
-    }
+     }
@@ -1256,4 +1256,8 @@ xmlFreeDoc(xmlDocPtr cur) {
