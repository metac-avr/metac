+    if ((dict != NULL) && (cur->version != NULL) && (!xmlDictOwns(dict, cur->version)))
+        xmlFree((char *)cur->version);
+    if ((dict != NULL) && (cur->name != NULL) && (!xmlDictOwns(dict, cur->name)))
+        xmlFree((char *)cur->name);
