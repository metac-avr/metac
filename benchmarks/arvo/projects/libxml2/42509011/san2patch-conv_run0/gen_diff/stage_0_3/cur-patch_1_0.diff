diff --git a/tree.c b/tree.c
index 50b6763b..1f6c3cf2 100644
--- a/tree.c
+++ b/tree.c
@@ -1251 +1251 @@ xmlFreeDoc(xmlDocPtr cur) {
-    }
+     }
