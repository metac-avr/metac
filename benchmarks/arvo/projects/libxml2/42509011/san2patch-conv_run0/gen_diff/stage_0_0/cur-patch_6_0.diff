diff --git a/tree.c b/tree.c
index 50b6763b..f2eb1577 100644
--- a/tree.c
+++ b/tree.c
@@ -3724,3 +3724,19 @@ xmlFreeNodeList(xmlNodePtr cur) {
-		 (cur->type == XML_XINCLUDE_END)) &&
-		(cur->properties != NULL))
-		xmlFreePropList(cur->properties);
+// FIXME: Crash CWE-763: Release of Invalid Pointer or Reference
+ 		 (cur->type == XML_XINCLUDE_END)) &&
+		(cur->properties != NULL)) {
+		/* Skip freeing properties that are dictionary-managed */
+		xmlAttrPtr prop = cur->properties;
+		while (prop != NULL) {
+		    xmlAttrPtr next = prop->next;
+		    /* Check if property name/content is dictionary-managed before freeing */
+		    if (prop->name && !xmlDictOwns(prop->doc->dict, prop->name)) {
+		        DICT_FREE(prop->name);
+		    }
+		    if (prop->children && prop->children->content && 
+		        !xmlDictOwns(prop->doc->dict, prop->children->content)) {
+		        DICT_FREE(prop->children->content);
+		    }
+		    xmlFreeProp(prop);
+		    prop = next;
+		}
+	    }
