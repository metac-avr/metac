diff --git a/tree.c b/tree.c
index 50b6763b..5bc7af91 100644
--- a/tree.c
+++ b/tree.c
@@ -3724,3 +3724,17 @@ xmlFreeNodeList(xmlNodePtr cur) {
-		 (cur->type == XML_XINCLUDE_END)) &&
-		(cur->properties != NULL))
-		xmlFreePropList(cur->properties);
+// FIXME: Crash CWE-763: Release of Invalid Pointer or Reference
+ 		 (cur->type == XML_XINCLUDE_END)) &&
+		(cur->properties != NULL)) {
+		/* Modified to properly handle dictionary-managed properties */
+		xmlAttrPtr prop = cur->properties;
+		while (prop != NULL) {
+		    xmlAttrPtr next = prop->next;
+		    /* Only free property if it's not managed by dictionary */
+		    if (prop->doc && prop->doc->dict) {
+		        xmlFreeProp(prop);
+		    } else {
+		        /* Fallback for non-dictionary cases */
+		        xmlFreeProp(prop);
+		    }
+		    prop = next;
+		}
+	    }
