@@ -2087,0 +2088,14 @@ xmlNewDocProp(xmlDocPtr doc, const xmlChar *name, const xmlChar *value) {
+static void
+xmlFreeAttribute(xmlAttrPtr cur) {
+    if (cur == NULL) return;
+
+    if (cur->name != NULL)
+        xmlFree((void *) cur->name);
+    if ((cur->children != NULL) && (cur->children->type == XML_TEXT_NODE))
+        xmlFree((void *) cur->children->content);
+    if (cur->children != NULL)
+        xmlFreeNodeList(cur->children);
+
+    xmlFree(cur);
+}
