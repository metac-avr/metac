+        xmlFree((char *)cur->name);
+    else if (cur->name && dict != NULL && xmlDictOwns(dict, cur->name) != 0)
+        ; /* Dictionary-managed string - do nothing */
+    if (cur->encoding && (dict == NULL || xmlDictOwns(dict, cur->encoding) == 0))
