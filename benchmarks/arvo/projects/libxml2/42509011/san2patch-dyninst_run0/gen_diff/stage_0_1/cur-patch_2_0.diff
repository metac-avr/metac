+    else if (cur->encoding && dict != NULL && xmlDictOwns(dict, cur->encoding) != 0)
+        ; /* Dictionary-managed string - do nothing */
+    if (cur->URL && (dict == NULL || xmlDictOwns(dict, cur->URL) == 0))
+        xmlFree((char *)cur->URL);
+    else if (cur->URL && dict != NULL && xmlDictOwns(dict, cur->URL) != 0)
+        ; /* Dictionary-managed string - do nothing */
