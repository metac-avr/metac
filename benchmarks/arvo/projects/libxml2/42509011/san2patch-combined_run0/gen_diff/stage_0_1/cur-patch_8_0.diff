diff --git a/tree.c b/tree.c
index 50b6763b..f2c6ae99 100644
--- a/tree.c
+++ b/tree.c
@@ -2094 +2094,21 @@ xmlFreePropList(xmlAttrPtr cur) {
-        xmlFreeProp(cur);
+        /* Check if property strings are dictionary-managed before freeing */
+        xmlAttrPtr temp_prop = xmlNewDocProp(NULL, NULL, NULL);
+        if (temp_prop) {
+            /* Set flags or temporarily nullify dictionary strings */
+            if (cur->name && xmlDictOwns(cur->doc ? cur->doc->dict : NULL, cur->name))
+                temp_prop->name = cur->name;
+            if (cur->children && cur->children->content && 
+                xmlDictOwns(cur->doc ? cur->doc->dict : NULL, cur->children->content))
+                temp_prop->children->content = cur->children->content;
+            /* Clear references to prevent double-free */
+            if (temp_prop->name) cur->name = NULL;
+            if (temp_prop->children && temp_prop->children->content)
+                cur->children->content = NULL;
+            xmlFreeProp(cur);
+            /* Strings remain in dictionary, clean up temp prop */
+            temp_prop->name = NULL;
+            temp_prop->children = NULL;
+            xmlFreeProp(temp_prop);
+        } else {
+            xmlFreeProp(cur);
+        }
