diff --git a/xinclude.c b/xinclude.c
index 180e70b5..f9aee503 100644
--- a/xinclude.c
+++ b/xinclude.c
@@ -2539,0 +2540 @@ xmlXIncludeProcessFlagsData(xmlDocPtr doc, int flags, void *data) {
+    int status;
@@ -2546 +2547,4 @@ xmlXIncludeProcessFlagsData(xmlDocPtr doc, int flags, void *data) {
