diff --git a/xinclude.c b/xinclude.c
index 180e70b5..073e8acb 100644
--- a/xinclude.c
+++ b/xinclude.c
@@ -2520,0 +2521,13 @@ xmlXIncludeProcessTreeFlagsData(xmlNodePtr tree, int flags, void *data) {
+    /* Clean up potential dangling pointers before context destruction */
+    {
+        xmlNodePtr iter;
+        for (iter = tree; iter != NULL; iter = iter->next) {
+            if (iter->children && iter->children->parent == iter)
+                iter->children->parent = NULL;
+            if (iter->next && iter->next->prev == iter)
+                iter->next->prev = NULL;
+            if (iter->prev && iter->prev->next == iter)
+                iter->prev->next = NULL;
+        }
+    }
+
diff --git a/tree.c b/tree.c
index 8077348a..0bb426f7 100644
--- a/tree.c
+++ b/tree.c
@@ -3752,0 +3753,3 @@ xmlFreeNodeList(xmlNodePtr cur) {
+	
+	/* Ensure no dangling pointers remain after freeing */
+	memset(cur, 0, sizeof(xmlNode));
