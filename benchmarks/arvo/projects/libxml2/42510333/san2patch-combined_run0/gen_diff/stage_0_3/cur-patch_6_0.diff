diff --git a/xinclude.c b/xinclude.c
index 180e70b5..13d67327 100644
--- a/xinclude.c
+++ b/xinclude.c
@@ -2520,0 +2521,17 @@ xmlXIncludeProcessTreeFlagsData(xmlNodePtr tree, int flags, void *data) {
+    /* Clear potentially dangling pointers before freeing context */
+    if (tree != NULL) {
+        xmlNodePtr cur = tree;
+        while (cur != NULL) {
+            if (cur->children != NULL && cur->children->parent == cur) {
+                cur->children->parent = NULL;
+            }
+            if (cur->next != NULL && cur->next->prev == cur) {
+                cur->next->prev = NULL;
+            }
+            if (cur->prev != NULL && cur->prev->next == cur) {
+                cur->prev->next = NULL;
+            }
+            cur = cur->next;
+        }
+    }
+
diff --git a/tree.c b/tree.c
index 8077348a..0741af2e 100644
--- a/tree.c
+++ b/tree.c
@@ -3753,0 +3754,6 @@ xmlFreeNodeList(xmlNodePtr cur) {
+	/* Clear pointers to prevent use-after-free */
+	cur->parent = NULL;
+	cur->children = NULL;
+	cur->next = NULL;
+	cur->prev = NULL;
+
