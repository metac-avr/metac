diff --git a/xinclude.c b/xinclude.c
index 180e70b5..20739d07 100644
--- a/xinclude.c
+++ b/xinclude.c
@@ -2462,3 +2462,5 @@ xmlXIncludeDoProcess(xmlXIncludeCtxtPtr ctxt, xmlDocPtr doc, xmlNodePtr tree,
-	if ((ctxt->incTab[i]->inc != NULL) ||
-	    (ctxt->incTab[i]->emptyFb != 0))	/* (empty fallback) */
-	    xmlXIncludeIncludeNode(ctxt, i);
+	if (i >= 0 && i < ctxt->incMax && ctxt->incTab[i] != NULL) {
+	    if ((ctxt->incTab[i]->inc != NULL) ||
+	        (ctxt->incTab[i]->emptyFb != 0))	/* (empty fallback) */
+	        xmlXIncludeIncludeNode(ctxt, i);
+	}
@@ -2474,2 +2476 @@ xmlXIncludeDoProcess(xmlXIncludeCtxtPtr ctxt, xmlDocPtr doc, xmlNodePtr tree,
- * @ctxt:  an XInclude processing context
- * @flags: a set of xmlParserOption used for parsing XML includes
