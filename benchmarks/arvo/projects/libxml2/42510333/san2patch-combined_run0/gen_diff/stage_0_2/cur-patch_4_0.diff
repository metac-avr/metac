diff --git a/tree.c b/tree.c
index 8077348a..4bd53627 100644
--- a/tree.c
+++ b/tree.c
@@ -3749,2 +3749,5 @@ xmlFreeNodeList(xmlNodePtr cur) {
-		(cur->type != XML_COMMENT_NODE))
-		DICT_FREE(cur->name)
+		(cur->type != XML_COMMENT_NODE)) {
+		xmlChar *name_to_free = cur->name;  /* Store pointer for safe freeing */
