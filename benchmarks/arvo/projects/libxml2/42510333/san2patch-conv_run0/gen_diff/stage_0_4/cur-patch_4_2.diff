+                   (cur->type != XML_HTML_DOCUMENT_NODE) &&
+                   (cur->type != XML_DTD_NODE) &&
+                   (cur->type != XML_ENTITY_REF_NODE)) {
+                cur = cur->children;
+            }
+        }
+    }
+}            depth += 1;
