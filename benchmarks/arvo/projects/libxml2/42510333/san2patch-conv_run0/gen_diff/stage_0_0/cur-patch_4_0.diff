diff --git a/xinclude.c b/xinclude.c
index 180e70b5..c8246f24 100644
--- a/xinclude.c
+++ b/xinclude.c
@@ -2546 +2546,5 @@ xmlXIncludeProcessFlagsData(xmlDocPtr doc, int flags, void *data) {
