diff --git a/xinclude.c b/xinclude.c
index 180e70b5..6ebecd7b 100644
--- a/xinclude.c
+++ b/xinclude.c
@@ -2515 +2515,5 @@ xmlXIncludeProcessTreeFlagsData(xmlNodePtr tree, int flags, void *data) {
-    ctxt->base = xmlStrdup((xmlChar *)tree->doc->URL);
+    // Initialize base to NULL first to prevent use-after-free
+    ctxt->base = NULL;
+    if (tree->doc && tree->doc->URL) {
+        ctxt->base = xmlStrdup((xmlChar *)tree->doc->URL);
+    }
diff --git a/tree.c b/tree.c
index 8077348a..bbf98bd1 100644
--- a/tree.c
+++ b/tree.c
@@ -3701,0 +3702,9 @@ xmlFreeNodeList(xmlNodePtr cur) {
+    /* Sever all connections before freeing to avoid use-after-free */
+    if (cur->parent != NULL) {
+        xmlNodePtr parent = cur->parent;
+        if (parent->children == cur)
+            parent->children = cur->next;
+        if (parent->last == cur)
+            parent->last = cur->prev;
+        cur->parent = NULL;
+    }
