--- a/tree.c
+++ b/tree.c
@@ -3699 +3699 @@ xmlFreeNodeList(xmlNodePtr cur) {
-	xmlFreeNsList((xmlNsPtr) cur);
+xmlFreeNsList((xmlNsPtr) cur);
@@ -3701,0 +3702,2 @@ xmlFreeNodeList(xmlNodePtr cur) {
+    /* Guard against use-after-free vulnerability */
+    if (cur == NULL || cur->type == XML_NULL_NODE) return;
@@ -3703,0 +3706,7 @@ xmlFreeNodeList(xmlNodePtr cur) {
+        /* Validate node integrity before traversal */
+        if (cur->children != NULL) {
+            /* Check if child node points back to valid parent */
+            if (cur->children->parent != cur && 
+                cur->type != XML_DOCUMENT_NODE &&
+                cur->type != XML_HTML_DOCUMENT_NODE) break;
+        }
