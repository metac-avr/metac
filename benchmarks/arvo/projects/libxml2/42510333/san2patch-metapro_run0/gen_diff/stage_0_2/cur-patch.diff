diff --git a/xinclude.c b/xinclude.c
index 180e70b5..f09c2a3a 100644
--- a/xinclude.c
+++ b/xinclude.c
@@ -1985,6 +1985,13 @@ xmlXIncludeLoadFallback(xmlXIncludeCtxtPtr ctxt, xmlNodePtr fallback, int nr) {
-	xmlXIncludeFreeContext(newctxt);
-
-	ctxt->incTab[nr]->inc = xmlDocCopyNodeList(ctxt->doc,
-	                                           fallback->children);
-        if (ctxt->incTab[nr]->inc == NULL)
-            ctxt->incTab[nr]->emptyFb = 1;
+// FIXME: Crash CWE-416: Use After Free
+ 	xmlXIncludeFreeContext(newctxt);
+
+	/* Add null check after context free to prevent accessing freed memory */
+	if (fallback != NULL && fallback->children != NULL) {
+	    ctxt->incTab[nr]->inc = xmlDocCopyNodeList(ctxt->doc,
+	                                               fallback->children);
+            if (ctxt->incTab[nr]->inc == NULL)
+                ctxt->incTab[nr]->emptyFb = 1;
+	} else {
+	    ctxt->incTab[nr]->inc = NULL;
+	    ctxt->incTab[nr]->emptyFb = 1;
+	}
diff --git a/tree.c b/tree.c
index 8077348a..1765222a 100644
--- a/tree.c
+++ b/tree.c
@@ -4429,0 +4430,5 @@ xmlStaticCopyNodeList(xmlNodePtr node, xmlDocPtr doc, xmlNodePtr parent) {
+	/* Clear node references to prevent use-after-free */
+	if (node->type != XML_DTD_NODE) {
+	    node->next = NULL;
+	    node->prev = NULL;
+	}
