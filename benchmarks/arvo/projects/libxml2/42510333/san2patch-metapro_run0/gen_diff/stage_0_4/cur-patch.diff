diff --git a/xinclude.c b/xinclude.c
index 180e70b5..e89a1437 100644
--- a/xinclude.c
+++ b/xinclude.c
@@ -2539,0 +2540 @@ xmlXIncludeProcessFlagsData(xmlDocPtr doc, int flags, void *data) {
+    int result = -1;
@@ -2546 +2547,8 @@ xmlXIncludeProcessFlagsData(xmlDocPtr doc, int flags, void *data) {
-    return(xmlXIncludeProcessTreeFlagsData(tree, flags, data));
+    
+    /* Create a temporary reference to prevent use-after-free during processing */
+    xmlNodePtr temp_ref = tree;
+    if (temp_ref != NULL) {
+        result = xmlXIncludeProcessTreeFlagsData(temp_ref, flags, data);
+    }
+    
+    return(result);
diff --git a/tree.c b/tree.c
index 8077348a..75b2fa00 100644
--- a/tree.c
+++ b/tree.c
@@ -3751 +3751,7 @@ xmlFreeNodeList(xmlNodePtr cur) {
-	    xmlFree(cur);
+	    
+	    /* Validate node before freeing to prevent use-after-free */
+	    if (cur != NULL) {
+	        /* Clear all pointers to prevent dangling references */
+	        memset(cur, 0, sizeof(xmlNode));
+	        xmlFree(cur);
+	    }
