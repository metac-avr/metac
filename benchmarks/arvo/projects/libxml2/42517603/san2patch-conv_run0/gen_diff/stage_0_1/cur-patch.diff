diff --git a/xinclude.c b/xinclude.c
index 855ede3b..b7b54bb5 100644
--- a/xinclude.c
+++ b/xinclude.c
@@ -2468,0 +2469,5 @@ xmlXIncludeProcessNode(xmlXIncludeCtxtPtr ctxt, xmlNodePtr node) {
