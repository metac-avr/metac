+    /* Validate node pointer before accessing it - Fix for CWE-416 Use After Free */
+    if (ref->elem == NULL || 
+        (ref->elem->type != XML_ELEMENT_NODE && 
+         ref->elem->type != XML_TEXT_NODE && 
+         ref->elem->type != XML_CDATA_SECTION_NODE && 
+         ref->elem->type != XML_ENTITY_REF_NODE && 
+         ref->elem->type != XML_ENTITY_NODE && 
+         ref->elem->type != XML_PI_NODE && 
+         ref->elem->type != XML_COMMENT_NODE && 
+         ref->elem->type != XML_DOCUMENT_NODE && 
+         ref->elem->type != XML_HTML_DOCUMENT_NODE && 
+         ref->elem->type != XML_XINCLUDE_START && 
+         ref->elem->type != XML_XINCLUDE_END))
+        return(-1);
