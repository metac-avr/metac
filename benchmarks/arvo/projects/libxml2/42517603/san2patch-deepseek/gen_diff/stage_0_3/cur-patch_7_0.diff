@@ -2054,0 +2055,12 @@ xmlXIncludeIncludeNode(xmlXIncludeCtxtPtr ctxt, xmlXIncludeRefPtr ref) {
+    /*
+     * Guard: if xmlTextReaderRead() has already invalidated/freed the
