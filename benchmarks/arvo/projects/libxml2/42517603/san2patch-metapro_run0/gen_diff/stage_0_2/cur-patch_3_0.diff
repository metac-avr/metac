diff --git a/xinclude.c b/xinclude.c
index 855ede3b..b296f5f3 100644
--- a/xinclude.c
+++ b/xinclude.c
@@ -2050 +2050,3 @@ xmlXIncludeIncludeNode(xmlXIncludeCtxtPtr ctxt, xmlXIncludeRefPtr ref) {
