diff --git a/xinclude.c b/xinclude.c
index 855ede3b..be0ccf2b 100644
--- a/xinclude.c
+++ b/xinclude.c
@@ -2050 +2050 @@ xmlXIncludeIncludeNode(xmlXIncludeCtxtPtr ctxt, xmlXIncludeRefPtr ref) {
-	return(-1);
+ 	return(-1);
@@ -2095 +2095 @@ xmlXIncludeIncludeNode(xmlXIncludeCtxtPtr ctxt, xmlXIncludeRefPtr ref) {
-	xmlFreeNode(cur);
+	if (cur != NULL) xmlFreeNode(cur);
@@ -2110 +2110 @@ xmlXIncludeIncludeNode(xmlXIncludeCtxtPtr ctxt, xmlXIncludeRefPtr ref) {
