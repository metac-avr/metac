diff --git a/xinclude.c b/xinclude.c
index 855ede3b..9f1ba6fa 100644
--- a/xinclude.c
+++ b/xinclude.c
@@ -2050 +2050 @@ xmlXIncludeIncludeNode(xmlXIncludeCtxtPtr ctxt, xmlXIncludeRefPtr ref) {
-	return(-1);
+ 	return(-1);
@@ -2053,0 +2054,2 @@ xmlXIncludeIncludeNode(xmlXIncludeCtxtPtr ctxt, xmlXIncludeRefPtr ref) {
+    if ((cur->doc == NULL) || (cur->name == NULL))
+        return(-1);
diff --git a/xmlreader.c b/xmlreader.c
index 9c2da90e..5e834739 100644
--- a/xmlreader.c
+++ b/xmlreader.c
@@ -1364,3 +1364,20 @@ xmlTextReaderRead(xmlTextReaderPtr reader) {
-                    oldnode = NULL;
-		xmlUnlinkNode(tmp);
-		xmlTextReaderFreeNode(reader, tmp);
+                     oldnode = NULL;
+		/* Add reference counting check before freeing */
+		int can_free = 1;
+		#ifdef LIBXML_XINCLUDE_ENABLED
+		if (reader->xincTab != NULL) {
+		    /* Check if node is in use by XInclude processing */
+		    for (int i = 0; i < reader->xincMax; i++) {
+		        if (reader->xincTab[i] == tmp) {
+			    can_free = 0;
+			    break;
+		        }
+		    }
+		}
+		#endif
+		if (can_free) {
+		    xmlUnlinkNode(tmp);
+		    xmlTextReaderFreeNode(reader, tmp);
+		} else {
+		    tmp->extra |= NODE_IS_PRESERVED;
+		}
