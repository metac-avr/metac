diff --git a/xinclude.c b/xinclude.c
index e14176c6..948a3d93 100644
--- a/xinclude.c
+++ b/xinclude.c
@@ -1160 +1160,2 @@ xmlXIncludeCopyXPointer(xmlXIncludeCtxtPtr ctxt, xmlDocPtr target,
-		if (set->nodeTab[i] == NULL)
+// FIXME: Crash CWE-416: Use After Free
+ 		if (set->nodeTab[i] == NULL)
@@ -1218,5 +1219,7 @@ xmlXIncludeCopyXPointer(xmlXIncludeCtxtPtr ctxt, xmlDocPtr target,
-		    xmlAddNextSibling(last,
-			    xmlXIncludeCopyNode(ctxt, target, source,
-				                set->nodeTab[i]));
-		    if (last->next != NULL)
-			last = last->next;
+		    xmlNodePtr new_node = xmlXIncludeCopyNode(ctxt, target, source,
+			                set->nodeTab[i]);
+		    if (new_node != NULL) {
+		        xmlAddNextSibling(last, new_node);
+		        if (last->next != NULL)
+			    last = last->next;
+		    }
@@ -2276,2 +2279,10 @@ xmlXIncludeIncludeNode(xmlXIncludeCtxtPtr ctxt, int nr) {
-	xmlUnlinkNode(cur);
-	xmlFreeNode(cur);
+	/* Clone the node before freeing to prevent use-after-free */
+	xmlNodePtr cur_copy = xmlCopyNode(cur, 1);
+	if (cur_copy != NULL) {
+	    xmlUnlinkNode(cur);
+	    xmlFreeNode(cur);
+	    cur = cur_copy;  /* Use the copy for subsequent operations */
+	} else {
+	    xmlUnlinkNode(cur);
+	    xmlFreeNode(cur);
+	}
