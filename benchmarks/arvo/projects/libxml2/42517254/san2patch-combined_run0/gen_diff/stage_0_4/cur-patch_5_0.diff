+		if (set->nodeTab[i] != NULL && set->nodeTab[i]->type == 0) continue;
@@ -1178,0 +1182,2 @@ xmlXIncludeCopyXPointer(xmlXIncludeCtxtPtr ctxt, xmlDocPtr target,
