--- a/xinclude.c
+++ b/xinclude.c
@@ -2275 +2275,2 @@ xmlXIncludeIncludeNode(xmlXIncludeCtxtPtr ctxt, int nr) {
-         */
+// FIXME: Crash CWE-416: Use After Free
+          */
@@ -2277 +2278,2 @@ xmlXIncludeIncludeNode(xmlXIncludeCtxtPtr ctxt, int nr) {
