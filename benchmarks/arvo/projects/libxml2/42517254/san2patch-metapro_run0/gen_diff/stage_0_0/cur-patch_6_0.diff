+	/* xmlFreeNode(cur); - Moved to after processing completion */
@@ -2504 +2506 @@ xmlXIncludeDoProcess(xmlXIncludeCtxtPtr ctxt, xmlDocPtr doc, xmlNodePtr tree,
-            (ctxt->incTab[i]->xptr != NULL) ||
+             (ctxt->incTab[i]->xptr != NULL) ||
@@ -2508,0 +2511,16 @@ xmlXIncludeDoProcess(xmlXIncludeCtxtPtr ctxt, xmlDocPtr doc, xmlNodePtr tree,
+    /* Defer freeing nodes until after processing is complete to avoid use-after-free */
+    for (i = ctxt->incBase; i < ctxt->incNr; i++) {
+        if (ctxt->incTab[i] != NULL && ctxt->incTab[i]->curInst != NULL) {
+            xmlNodePtr cur = ctxt->incTab[i]->curInst;
+            while (cur != NULL) {
+                xmlNodePtr next = cur->next;
+                if (cur->type == XML_ELEMENT_NODE || cur->type == XML_TEXT_NODE) {
+                    xmlUnlinkNode(cur);
+                    xmlFreeNode(cur);
+                }
+                cur = next;
+            }
+            ctxt->incTab[i]->curInst = NULL;
+        }
+    }
+
@@ -2512,6 +2530 @@ xmlXIncludeDoProcess(xmlXIncludeCtxtPtr ctxt, xmlDocPtr doc, xmlNodePtr tree,
