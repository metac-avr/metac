diff --git a/xinclude.c b/xinclude.c
index e14176c6..db63b42b 100644
--- a/xinclude.c
+++ b/xinclude.c
@@ -1159,0 +1160 @@ xmlXIncludeCopyXPointer(xmlXIncludeCtxtPtr ctxt, xmlDocPtr target,
+		// Fixed CWE-416: Use After Free - Added null check before accessing node
@@ -1178,0 +1180,2 @@ xmlXIncludeCopyXPointer(xmlXIncludeCtxtPtr ctxt, xmlDocPtr target,
+			    /* Added validation to prevent use-after-free */
+			    if (cur == NULL) break;
@@ -1213,0 +1217,2 @@ xmlXIncludeCopyXPointer(xmlXIncludeCtxtPtr ctxt, xmlDocPtr target,
+		/* Defensive check to validate node before copying */
+		if (set->nodeTab[i] == NULL) continue;
@@ -1218,2 +1223,4 @@ xmlXIncludeCopyXPointer(xmlXIncludeCtxtPtr ctxt, xmlDocPtr target,
-		    xmlAddNextSibling(last,
-			    xmlXIncludeCopyNode(ctxt, target, source,
+		    /* Additional safety check before node operations */
+		    if (set->nodeTab[i] != NULL) {
+		        xmlAddNextSibling(last,
+			        xmlXIncludeCopyNode(ctxt, target, source,
@@ -1221,2 +1228,3 @@ xmlXIncludeCopyXPointer(xmlXIncludeCtxtPtr ctxt, xmlDocPtr target,
-		    if (last->next != NULL)
-			last = last->next;
+		        if (last->next != NULL)
+			    last = last->next;
+		    }
@@ -2277 +2285,2 @@ xmlXIncludeIncludeNode(xmlXIncludeCtxtPtr ctxt, int nr) {
-	xmlFreeNode(cur);
+	/* Defer freeing cur node until after all processing is complete */
+	/* xmlFreeNode(cur); - Moved to after processing */
@@ -2314,0 +2324,4 @@ xmlXIncludeIncludeNode(xmlXIncludeCtxtPtr ctxt, int nr) {
+    /* Safely free the node after all processing is complete */
+    if ((ctxt->parseFlags & XML_PARSE_NOXINCNODE) && (cur != NULL)) {
+        xmlFreeNode(cur);
+    }
