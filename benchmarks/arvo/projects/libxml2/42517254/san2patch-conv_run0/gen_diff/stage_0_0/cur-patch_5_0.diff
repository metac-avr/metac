diff --git a/xinclude.c b/xinclude.c
index e14176c6..e85c675a 100644
--- a/xinclude.c
+++ b/xinclude.c
@@ -1498 +1498,2 @@ xmlXIncludeLoadDoc(xmlXIncludeCtxtPtr ctxt, const xmlChar *url, int nr) {
