diff --git a/tree.c b/tree.c
index 6a42f118..4f75c0fb 100644
--- a/tree.c
+++ b/tree.c
@@ -3875,12 +3875,24 @@ xmlFreeNode(xmlNodePtr cur) {
-    if ((cur->name != NULL) &&
-        (cur->type != XML_TEXT_NODE) &&
-        (cur->type != XML_COMMENT_NODE))
-	DICT_FREE(cur->name)
-
-    xmlFree(cur);
-}
-
-/**
- * xmlUnlinkNode:
- * @cur:  the node
- *
+void xmlUnlinkNode(xmlNodePtr cur) {
+    if (cur == NULL) return;
+    
+    /* Remove from parent's children list */
+    if (cur->parent != NULL) {
+        if (cur->parent->children == cur) {
+            cur->parent->children = cur->next;
+        }
+        if (cur->parent->last == cur) {
+            cur->parent->last = cur->prev;
+        }
+    }
+    
+    /* Remove from siblings chain */
+    if (cur->next != NULL)
+        cur->next->prev = cur->prev;
+    if (cur->prev != NULL)
+        cur->prev->next = cur->next;
+    
+    /* Clear node links */
+    cur->parent = NULL;
+    cur->next = NULL;
+    cur->prev = NULL;
+} *
