diff --git a/tree.c b/tree.c
index a8869fd9..455dad04 100644
--- a/tree.c
+++ b/tree.c
@@ -3638 +3638,10 @@ xmlFreeNodeList(xmlNodePtr cur) {
-	    xmlFree(cur);
+	    
+	    /* Clear pointers to prevent use-after-free */
+	    xmlNodePtr temp = cur;
+	    cur = cur->next;
+	    temp->next = NULL;
+	    temp->prev = NULL;
+	    temp->parent = NULL;
+	    temp->children = NULL;
+	    
+	    xmlFree(temp);
@@ -6857,2 +6866,9 @@ xmlSetProp(xmlNodePtr node, const xmlChar *name, const xmlChar *value) {
-        if (ns != NULL)
-            return(xmlSetNsProp(node, ns, localname, value));
+        if (ns != NULL) {
+            xmlAttrPtr result = xmlSetNsProp(node, ns, localname, value);
+            if (result == NULL && node != NULL) {
+                /* Safety check to prevent use-after-free: ensure node is still valid */
+                if (node->type != XML_ELEMENT_NODE)
+                    return(NULL);
+            }
+            return(result);
+        }
@@ -6861 +6877,7 @@ xmlSetProp(xmlNodePtr node, const xmlChar *name, const xmlChar *value) {
-    return(xmlSetNsProp(node, NULL, name, value));
+    xmlAttrPtr result = xmlSetNsProp(node, NULL, name, value);
+    if (result == NULL && node != NULL) {
+        /* Safety check to prevent use-after-free: ensure node is still valid */
+        if (node->type != XML_ELEMENT_NODE)
+            return(NULL);
+    }
+    return(result);
