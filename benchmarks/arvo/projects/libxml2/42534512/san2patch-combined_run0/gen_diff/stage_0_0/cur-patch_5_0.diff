diff --git a/tree.c b/tree.c
index a8869fd9..247a3a06 100644
--- a/tree.c
+++ b/tree.c
@@ -3637,0 +3638,6 @@ xmlFreeNodeList(xmlNodePtr cur) {
+	    
+	    /* Nullify parent reference to prevent use-after-free in nodeGetTree */
+	    if (cur->parent != NULL && cur->parent->children == cur) {
+	        cur->parent->children = cur->next;
+	    }
+	    
@@ -6857,2 +6863,8 @@ xmlSetProp(xmlNodePtr node, const xmlChar *name, const xmlChar *value) {
-        if (ns != NULL)
-            return(xmlSetNsProp(node, ns, localname, value));
+        if (ns != NULL) {
+            xmlAttrPtr prop_result = xmlSetNsProp(node, ns, localname, value);
+            /* Prevent use-after-free by validating node pointer */
+            if (node != NULL && node->type == XML_ELEMENT_NODE)
+                return(prop_result);
+            else
+                return(NULL);
+        }
@@ -6861 +6873,6 @@ xmlSetProp(xmlNodePtr node, const xmlChar *name, const xmlChar *value) {
-    return(xmlSetNsProp(node, NULL, name, value));
+    xmlAttrPtr prop_result = xmlSetNsProp(node, NULL, name, value);
+    /* Prevent use-after-free by validating node pointer */
+    if (node != NULL && node->type == XML_ELEMENT_NODE)
+        return(prop_result);
+    else
+        return(NULL);
