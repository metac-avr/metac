diff --git a/tree.c b/tree.c
index a8869fd9..b173a867 100644
--- a/tree.c
+++ b/tree.c
@@ -6857,2 +6857,16 @@ xmlSetProp(xmlNodePtr node, const xmlChar *name, const xmlChar *value) {
-        if (ns != NULL)
