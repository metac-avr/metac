diff --git a/tree.c b/tree.c
index a8869fd9..f0799615 100644
--- a/tree.c
+++ b/tree.c
@@ -6857,2 +6857,12 @@ xmlSetProp(xmlNodePtr node, const xmlChar *name, const xmlChar *value) {
-        if (ns != NULL)
-            return(xmlSetNsProp(node, ns, localname, value));
+        if (ns != NULL) {
+            xmlAttrPtr ret = xmlSetNsProp(node, ns, localname, value);
