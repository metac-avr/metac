+    /* Validate returned attribute pointer */
+    if (ret != NULL) {
+        /* Clear any potentially stale references */
+        if (ret->children != NULL && ret->children->type == XML_TEXT_NODE) {
+            /* Force revalidation of text content */
+            xmlNodeGetContent(ret->children);
+        }
+    }
+    return(ret);
@@ -6904 +6923 @@ xmlSetNsProp(xmlNodePtr node, xmlNsPtr ns, const xmlChar *name,
