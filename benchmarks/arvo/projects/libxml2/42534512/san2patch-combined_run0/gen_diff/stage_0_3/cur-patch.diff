diff --git a/tree.c b/tree.c
index a8869fd9..8c9317f8 100644
--- a/tree.c
+++ b/tree.c
@@ -6857,2 +6857,18 @@ xmlSetProp(xmlNodePtr node, const xmlChar *name, const xmlChar *value) {
-        if (ns != NULL)
-            return(xmlSetNsProp(node, ns, localname, value));
+        if (ns != NULL) {
+            xmlAttrPtr result = xmlSetNsProp(node, ns, localname, value);
+            /* Prevent dangling pointer by validating result */
+            if (result != NULL && result->children != NULL) {
+                xmlNodePtr child = result->children;
+                /* Check each child node for validity */
+                while (child != NULL) {
+                    if (child->_private != NULL || child->doc != NULL) {
+                        /* Node appears valid, continue */
+                        child = child->next;
+                    } else {
+                        /* Potentially invalid node, stop traversal */
+                        break;
+                    }
+                }
+            }
+            return(result);
+        }
@@ -6861 +6877,16 @@ xmlSetProp(xmlNodePtr node, const xmlChar *name, const xmlChar *value) {
-    return(xmlSetNsProp(node, NULL, name, value));
+    xmlAttrPtr result = xmlSetNsProp(node, NULL, name, value);
+    /* Prevent dangling pointer by validating result */
+    if (result != NULL && result->children != NULL) {
+        xmlNodePtr child = result->children;
+        /* Check each child node for validity */
+        while (child != NULL) {
+            if (child->_private != NULL || child->doc != NULL) {
+                /* Node appears valid, continue */
+                child = child->next;
+            } else {
+                /* Potentially invalid node, stop traversal */
+                break;
+            }
+        }
+    }
+    return(result);
@@ -6904 +6935 @@ xmlSetNsProp(xmlNodePtr node, xmlNsPtr ns, const xmlChar *name,
-	if (prop->children != NULL)
+	if (prop->children != NULL) {
@@ -6906,2 +6937,3 @@ xmlSetNsProp(xmlNodePtr node, xmlNsPtr ns, const xmlChar *name,
-	prop->children = NULL;
-	prop->last = NULL;
+	    prop->children = NULL;
+	    prop->last = NULL; /* Also reset last to avoid dangling references */
+	}
