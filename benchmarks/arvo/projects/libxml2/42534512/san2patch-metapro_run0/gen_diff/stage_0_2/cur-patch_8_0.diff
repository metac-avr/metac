diff --git a/tree.c b/tree.c
index a8869fd9..b861d3d9 100644
--- a/tree.c
+++ b/tree.c
@@ -2281,0 +2282 @@ xmlNewText(const xmlChar *content) {
+    cur->content = NULL;
@@ -2293 +2294,3 @@ xmlNewText(const xmlChar *content) {
-    xmlFreeNode(cur);
+    if (cur != NULL) {
+        xmlFree(cur);
+    }
@@ -3613,2 +3616,5 @@ xmlFreeNodeList(xmlNodePtr cur) {
