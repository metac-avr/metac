diff --git a/tree.c b/tree.c
index a8869fd9..b1b77316 100644
--- a/tree.c
+++ b/tree.c
@@ -3609,0 +3610,12 @@ xmlFreeNodeList(xmlNodePtr cur) {
+	    /* Detach node from parent and siblings before freeing */
+	    if (cur->parent != NULL) {
+	        if (cur->parent->children == cur)
+	            cur->parent->children = cur->next;
+	        if (cur->parent->last == cur)
+	            cur->parent->last = cur->prev;
+	    }
+	    if (cur->next != NULL)
+	        cur->next->prev = cur->prev;
+	    if (cur->prev != NULL)
+	        cur->prev->next = cur->next;
+
@@ -6849 +6861,3 @@ xmlSetProp(xmlNodePtr node, const xmlChar *name, const xmlChar *value) {
-    if (localname == NULL)
+    if (localname == NULL) {
+        if (prefix != NULL)
+            xmlFree(prefix);
@@ -6850,0 +6865 @@ xmlSetProp(xmlNodePtr node, const xmlChar *name, const xmlChar *value) {
+    }
