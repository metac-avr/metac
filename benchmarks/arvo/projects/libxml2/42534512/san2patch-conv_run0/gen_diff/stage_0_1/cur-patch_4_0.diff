@@ -3609,0 +3610,15 @@ xmlFreeNodeList(xmlNodePtr cur) {
+	    /* Ensure node is properly detached before freeing to prevent use-after-free */
+	    if (cur->parent != NULL) {
+	        if (cur->parent->children == cur)
+	            cur->parent->children = cur->next;
+	        else if (cur->parent->last == cur)
+	            cur->parent->last = cur->prev;
+	    }
+	    if (cur->prev != NULL)
+	        cur->prev->next = cur->next;
+	    if (cur->next != NULL)
+	        cur->next->prev = cur->prev;
+	    cur->parent = NULL;
+	    cur->next = NULL;
+	    cur->prev = NULL;
+
