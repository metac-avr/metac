diff --git a/tree.c b/tree.c
index a8869fd9..3eb9d85e 100644
--- a/tree.c
+++ b/tree.c
@@ -6857,2 +6857,8 @@ xmlSetProp(xmlNodePtr node, const xmlChar *name, const xmlChar *value) {
-        if (ns != NULL)
-            return(xmlSetNsProp(node, ns, localname, value));
+        if (ns != NULL) {
+            xmlAttrPtr prop = xmlSetNsProp(node, ns, localname, value);
+            if (prop != NULL && prop->children != NULL) {
+                xmlUnlinkNode(prop->children);
+                prop->children = NULL;
+            }
+            return(prop);
+        }
@@ -6861 +6867,6 @@ xmlSetProp(xmlNodePtr node, const xmlChar *name, const xmlChar *value) {
-    return(xmlSetNsProp(node, NULL, name, value));
+    xmlAttrPtr prop = xmlSetNsProp(node, NULL, name, value);
+    if (prop != NULL && prop->children != NULL) {
+        xmlUnlinkNode(prop->children);
+        prop->children = NULL;
+    }
+    return(prop);
@@ -6904 +6915,9 @@ xmlSetNsProp(xmlNodePtr node, xmlNsPtr ns, const xmlChar *name,
-	if (prop->children != NULL)
+	if (prop->children != NULL) {
+	    /* Ensure children are properly unlinked before freeing */
+	    xmlNodePtr cur = prop->children;
+	    while (cur != NULL) {
+	        cur->parent = NULL;
+	        cur->next = NULL;
+	        cur->prev = NULL;
+	        cur = cur->next;
+	    }
@@ -6905,0 +6925 @@ xmlSetNsProp(xmlNodePtr node, xmlNsPtr ns, const xmlChar *name,
+	}
