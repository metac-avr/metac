diff --git a/tree.c b/tree.c
index e2357131..32f0ec6d 100644
--- a/tree.c
+++ b/tree.c
@@ -5596 +5596 @@ xmlGetNsList(const xmlDoc *doc, const xmlNode *node)
-    xmlNsPtr *ret;
+     xmlNsPtr *ret = NULL;
@@ -5598 +5598,12 @@ xmlGetNsList(const xmlDoc *doc, const xmlNode *node)
-    xmlGetNsListSafe(doc, node, &ret);
+    /* Check for valid input parameters to prevent dereferencing invalid pointers */
+    if ((doc == NULL) || (node == NULL)) {
+        return NULL;
+    }
+    
+    /* Call the safe version and check return value */
+    int result = xmlGetNsListSafe(doc, node, &ret);
+    if (result < 0 && ret != NULL) {
+        /* Clean up allocated memory on error */
+        xmlFree(ret);
+        ret = NULL;
+    }
