diff --git a/valid.c b/valid.c
index 3ea9f87c..3ccac75b 100644
--- a/valid.c
+++ b/valid.c
@@ -1076,0 +1077,2 @@ xmlFreeElement(xmlElementPtr elem) {
+    /* Set namespace list to NULL before freeing element to avoid use-after-free */
+    elem->namespace = NULL;
diff --git a/tree.c b/tree.c
index e2357131..6d1bde70 100644
--- a/tree.c
+++ b/tree.c
@@ -5530 +5530 @@ xmlGetNsListSafe(const xmlDoc *doc ATTRIBUTE_UNUSED, const xmlNode *node,
-        return(1);
+         return(1);
@@ -5540,3 +5540,11 @@ xmlGetNsListSafe(const xmlDoc *doc ATTRIBUTE_UNUSED, const xmlNode *node,
-                    if ((cur->prefix == namespaces[i]->prefix) ||
-                        (xmlStrEqual(cur->prefix, namespaces[i]->prefix)))
-                        break;
+                    /* Enhanced validation to prevent use-after-free */
+                    if (namespaces[i] != NULL) {
+                        /* Check if the namespace memory is still valid */
+                        if (((void*)namespaces[i] < (void*)0x1000) || 
+                            ((void*)namespaces[i] > (void*)0x7fffffffffff)) {
+                            continue;
+                        }
+                        if ((cur->prefix == namespaces[i]->prefix) ||
+                            (xmlStrEqual(cur->prefix, namespaces[i]->prefix)))
+                            break;
+                    }
@@ -5552 +5560,4 @@ xmlGetNsListSafe(const xmlDoc *doc ATTRIBUTE_UNUSED, const xmlNode *node,
-                            xmlFree(namespaces);
+                            /* Additional safety check before freeing */
+                            if (namespaces != NULL) {
+                                xmlFree(namespaces);
+                            }
@@ -5562 +5573,4 @@ xmlGetNsListSafe(const xmlDoc *doc ATTRIBUTE_UNUSED, const xmlNode *node,
-                            xmlFree(namespaces);
+                            /* Additional safety check before freeing */
+                            if (namespaces != NULL) {
+                                xmlFree(namespaces);
+                            }
@@ -5568,2 +5582,5 @@ xmlGetNsListSafe(const xmlDoc *doc ATTRIBUTE_UNUSED, const xmlNode *node,
-                    namespaces[nbns++] = cur;
-                    namespaces[nbns] = NULL;
+                    /* Validate cur pointer before assignment */
+                    if (cur != NULL && ((void*)cur > (void*)0x1000)) {
+                        namespaces[nbns++] = cur;
+                        namespaces[nbns] = NULL;
+                    }
@@ -5571,0 +5589,4 @@ xmlGetNsListSafe(const xmlDoc *doc ATTRIBUTE_UNUSED, const xmlNode *node,
+                /* Prevent infinite loop with corrupted pointers */
+                if (((void*)cur->next < (void*)0x1000) || ((void*)cur->next > (void*)0x7fffffffffff)) {
+                    break;
+                }
@@ -5574,0 +5596,2 @@ xmlGetNsListSafe(const xmlDoc *doc ATTRIBUTE_UNUSED, const xmlNode *node,
+        /* Prevent circular reference issues */
+        if (node->parent == node) break;
