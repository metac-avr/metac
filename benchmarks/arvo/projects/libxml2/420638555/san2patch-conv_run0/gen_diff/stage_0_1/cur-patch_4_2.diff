-                        break;
-                }
-                if (i >= nbns) {
-                    if (nbns >= maxns) {
-                        xmlNsPtr *tmp;
-                        int newSize;
-
-                        newSize = xmlGrowCapacity(maxns, sizeof(tmp[0]),
-                                                  10, XML_MAX_ITEMS);
-                        if (newSize < 0) {
-                            xmlFree(namespaces);
-                            return(-1);
-                        }
-#ifdef FUZZING_BUILD_MODE_UNSAFE_FOR_PRODUCTION
-                        if (newSize < 2)
