@@ -5519,39 +5519,12 @@ xmlTextMerge(xmlNode *first, xmlNode *second) {
-int
-xmlGetNsListSafe(const xmlDoc *doc ATTRIBUTE_UNUSED, const xmlNode *node,
-                 xmlNs ***out)
-{
-    xmlNsPtr cur;
-    xmlNsPtr *namespaces = NULL;
-    int nbns = 0;
-    int maxns = 0;
-    int i;
-
-    if (out == NULL)
-        return(1);
-    *out = NULL;
-    if ((node == NULL) || (node->type == XML_NAMESPACE_DECL))
-        return(1);
-
-    while (node != NULL) {
-        if (node->type == XML_ELEMENT_NODE) {
-            cur = node->nsDef;
-            while (cur != NULL) {
-                for (i = 0; i < nbns; i++) {
-                    if ((cur->prefix == namespaces[i]->prefix) ||
