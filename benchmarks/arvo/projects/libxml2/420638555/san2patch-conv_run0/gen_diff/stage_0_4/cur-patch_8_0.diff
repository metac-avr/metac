@@ -5535,0 +5536,13 @@ xmlGetNsListSafe(const xmlDoc *doc ATTRIBUTE_UNUSED, const xmlNode *node,
+        /* Validate node pointer and check for expired/deallocated memory */
+        if (node->type != XML_ELEMENT_NODE) {
+            node = node->parent;
