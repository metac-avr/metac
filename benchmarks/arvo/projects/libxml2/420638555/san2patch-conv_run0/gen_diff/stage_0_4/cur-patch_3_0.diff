--- a/tree.c
+++ b/tree.c
@@ -5530 +5530 @@ xmlGetNsListSafe(const xmlDoc *doc ATTRIBUTE_UNUSED, const xmlNode *node,
-        return(1);
+         return(1);
@@ -5534,0 +5535,8 @@ xmlGetNsListSafe(const xmlDoc *doc ATTRIBUTE_UNUSED, const xmlNode *node,
+    /* Validate node pointer before use to prevent use-after-free */
+    if (node->type != XML_ELEMENT_NODE && node->type != XML_DOCUMENT_NODE && 
+        node->type != XML_HTML_DOCUMENT_NODE && node->type != XML_ATTRIBUTE_NODE) {
+        /* Check if node appears to be freed by validating its type */
+        if (node->type == 0 || node->type > XML_ENTITY_DECL) 
+            return(1);
+    }
