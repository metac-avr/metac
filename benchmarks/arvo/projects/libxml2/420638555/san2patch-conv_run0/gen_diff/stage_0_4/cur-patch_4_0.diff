@@ -5534,0 +5535,12 @@ xmlGetNsListSafe(const xmlDoc *doc ATTRIBUTE_UNUSED, const xmlNode *node,
+    /* Add validation to check if node pointer is valid before dereferencing */
+    if (node != NULL) {
+        /* Basic sanity check on node structure to detect freed memory */
+        volatile int node_type = node->type;
+        if (node_type <= 0 || node_type > XML_ENTITY_DECL) {
+            /* Node appears to be pointing to freed memory */
+            return(1);
+        }
+    } else {
+        return(1);
+    }
