--- a/tree.c
+++ b/tree.c
@@ -5530 +5530 @@ xmlGetNsListSafe(const xmlDoc *doc ATTRIBUTE_UNUSED, const xmlNode *node,
-        return(1);
+         return(1);
@@ -5539,16 +5539,19 @@ xmlGetNsListSafe(const xmlDoc *doc ATTRIBUTE_UNUSED, const xmlNode *node,
-                for (i = 0; i < nbns; i++) {
-                    if ((cur->prefix == namespaces[i]->prefix) ||
-                        (xmlStrEqual(cur->prefix, namespaces[i]->prefix)))
-                        break;
-                }
-                if (i >= nbns) {
-                    if (nbns >= maxns) {
-                        xmlNsPtr *tmp;
-                        int newSize;
-
-                        newSize = xmlGrowCapacity(maxns, sizeof(tmp[0]),
-                                                  10, XML_MAX_ITEMS);
-                        if (newSize < 0) {
-                            xmlFree(namespaces);
-                            return(-1);
-                        }
+                /* Validate namespace pointer before use */
+                if (cur != NULL && (uintptr_t)cur > 0x1000) {
+                    for (i = 0; i < nbns; i++) {
+                        /* Check if namespace array entry is valid before accessing */
+                        if (namespaces[i] != NULL && ((cur->prefix == namespaces[i]->prefix) ||
+                            (xmlStrEqual(cur->prefix, namespaces[i]->prefix))))
+                            break;
+                    }
+                    if (i >= nbns) {
+                        if (nbns >= maxns) {
+                            xmlNsPtr *tmp;
+                            int newSize;
+
+                            newSize = xmlGrowCapacity(maxns, sizeof(tmp[0]),
+                                                      10, XML_MAX_ITEMS);
+                            if (newSize < 0) {
+                                xmlFree(namespaces);
+                                return(-1);
+                            }
@@ -5556,2 +5559,2 @@ xmlGetNsListSafe(const xmlDoc *doc ATTRIBUTE_UNUSED, const xmlNode *node,
-                        if (newSize < 2)
-                            newSize = 2;
+                            if (newSize < 2)
+                                newSize = 2;
@@ -5559,5 +5562,8 @@ xmlGetNsListSafe(const xmlDoc *doc ATTRIBUTE_UNUSED, const xmlNode *node,
