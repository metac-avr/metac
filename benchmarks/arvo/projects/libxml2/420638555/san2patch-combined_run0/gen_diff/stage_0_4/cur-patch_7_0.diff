-                            xmlFree(namespaces);
-                            return(-1);
+                            tmp = xmlRealloc(namespaces,
+                                             (newSize + 1) * sizeof(tmp[0]));
+                            if (tmp == NULL) {
+                                xmlFree(namespaces);
+                                return(-1);
+                            }
+                            namespaces = tmp;
+                            maxns = newSize;
@@ -5565,2 +5571,2 @@ xmlGetNsListSafe(const xmlDoc *doc ATTRIBUTE_UNUSED, const xmlNode *node,
-                        namespaces = tmp;
-                        maxns = newSize;
+                        namespaces[nbns++] = cur;
+                        namespaces[nbns] = NULL;
@@ -5568,2 +5573,0 @@ xmlGetNsListSafe(const xmlDoc *doc ATTRIBUTE_UNUSED, const xmlNode *node,
-                    namespaces[nbns++] = cur;
-                    namespaces[nbns] = NULL;
