diff --git a/tree.c b/tree.c
index e4425f10..1d2133be 100644
--- a/tree.c
+++ b/tree.c
@@ -3802,0 +3803 @@ xmlFreeNode(xmlNodePtr cur) {
+// FIXME: Crash CWE-763: Release of Invalid Pointer or Reference
@@ -3804,2 +3805,9 @@ xmlFreeNode(xmlNodePtr cur) {
-	(cur->type != XML_ENTITY_REF_NODE))
-	xmlFreeNodeList(cur->children);
+	(cur->type != XML_ENTITY_REF_NODE)) {
+        xmlNodePtr child = cur->children;
+        // Clear the parent reference to avoid issues during freeing
+        while (child != NULL) {
+            child->parent = NULL;
+            child = child->next;
+        }
+        xmlFreeNodeList(cur->children);
+    }
