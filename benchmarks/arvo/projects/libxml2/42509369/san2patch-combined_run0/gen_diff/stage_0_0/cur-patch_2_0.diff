diff --git a/parser.c b/parser.c
index c3068cad..e0001084 100644
--- a/parser.c
+++ b/parser.c
@@ -9911 +9910,0 @@ xmlParseContentInternal(xmlParserCtxtPtr ctxt) {
-
@@ -9913 +9912,6 @@ xmlParseContentInternal(xmlParserCtxtPtr ctxt) {
-	    xmlParseReference(ctxt);
+	    /* Check if reference parsing would cause invalid pointer issues */
+	    if (ctxt->input->cur + 1 < ctxt->input->end) {
+	        xmlParseReference(ctxt);
+	    } else {
+	        ctxt->input->cur++;
+	    }
diff --git a/tree.c b/tree.c
index e4425f10..a384ea05 100644
--- a/tree.c
+++ b/tree.c
@@ -3749,2 +3749,8 @@ xmlFreeNodeList(xmlNodePtr cur) {
-		(cur->type != XML_COMMENT_NODE))
-		DICT_FREE(cur->name)
+		(cur->type != XML_COMMENT_NODE)) {
+		if (cur->doc && cur->doc->dict) {
+		    if (xmlDictOwns(cur->doc->dict, cur->name) == 0)
+		        DICT_FREE(cur->name)
+		} else if (cur->name != xmlStringText && cur->name != xmlStringComment) {
+		    DICT_FREE(cur->name)
+		}
+	    }
