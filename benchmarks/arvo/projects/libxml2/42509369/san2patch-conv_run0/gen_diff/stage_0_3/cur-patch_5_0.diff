diff --git a/tree.c b/tree.c
index e4425f10..e51b9d6d 100644
--- a/tree.c
+++ b/tree.c
@@ -3803,3 +3803,15 @@ xmlFreeNode(xmlNodePtr cur) {
-    if ((cur->children != NULL) &&
-	(cur->type != XML_ENTITY_REF_NODE))
-	xmlFreeNodeList(cur->children);
+// FIXME: Crash CWE-763: Release of Invalid Pointer or Reference
+     if ((cur->children != NULL) &&
+	(cur->type != XML_ENTITY_REF_NODE)) {
+        xmlNodePtr child = cur->children;
+        while (child != NULL) {
+            xmlNodePtr next = child->next;
+            /* Check if child content is dictionary-owned before freeing */
+            if ((dict != NULL) && (child->content != NULL) && 
+                (xmlDictOwns(dict, child->content))) {
+                child->content = NULL; /* Avoid freeing dictionary content */
+            }
+            xmlFreeNode(child);
+            child = next;
+        }
+    }
diff --git a/parser.c b/parser.c
index c3068cad..97cec3b2 100644
--- a/parser.c
+++ b/parser.c
@@ -7195,0 +7196,7 @@ xmlParseReference(xmlParserCtxtPtr ctxt) {
+	/* Fix: Properly handle memory management to prevent invalid pointer release */
+	if (ret != XML_ERR_OK && list != NULL) {
+	    /* Clean up partially parsed content on error to prevent memory corruption */
+	    xmlFreeNodeList(list);
+	    list = NULL;
+	}
+
