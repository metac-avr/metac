diff --git a/tree.c b/tree.c
index e4425f10..784ec1bb 100644
--- a/tree.c
+++ b/tree.c
@@ -3733 +3733,3 @@ xmlFreeNodeList(xmlNodePtr cur) {
-		DICT_FREE(cur->content)
+		if ((cur->content != NULL) && (cur->doc != NULL) && 
+		    (cur->doc->dict != NULL))
+		    DICT_FREE(cur->content)
diff --git a/parser.c b/parser.c
index c3068cad..d033bcfd 100644
--- a/parser.c
+++ b/parser.c
@@ -7188 +7188 @@ xmlParseReference(xmlParserCtxtPtr ctxt) {
-					   ent->ExternalID, &list);
+				   ent->ExternalID, &list);
@@ -7195,0 +7196,14 @@ xmlParseReference(xmlParserCtxtPtr ctxt) {
+	/* Protect against freeing dictionary-managed memory */
+	if ((list != NULL) && (ctxt != NULL) && (ctxt->dict != NULL)) {
+	    xmlNodePtr node_ptr = list;
+	    while (node_ptr != NULL) {
+	        if ((node_ptr->type == XML_TEXT_NODE) && 
+	            (node_ptr->content != NULL) && 
+	            xmlDictOwns(ctxt->dict, node_ptr->content)) {
+	            /* Nullify content to avoid freeing dictionary strings */
+	            node_ptr->content = NULL;
+	        }
+	        node_ptr = node_ptr->next;
+	    }
+	}
+
