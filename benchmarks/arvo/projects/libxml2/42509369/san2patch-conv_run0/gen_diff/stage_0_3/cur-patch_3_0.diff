diff --git a/tree.c b/tree.c
index e4425f10..914ae6ee 100644
--- a/tree.c
+++ b/tree.c
@@ -3803,3 +3803,14 @@ xmlFreeNode(xmlNodePtr cur) {
-    if ((cur->children != NULL) &&
-	(cur->type != XML_ENTITY_REF_NODE))
-	xmlFreeNodeList(cur->children);
+// FIXME: Crash CWE-763: Release of Invalid Pointer or Reference
+     if ((cur->children != NULL) &&
+	(cur->type != XML_ENTITY_REF_NODE)) {
+        xmlNodePtr next;
+        xmlNodePtr child = cur->children;
+        while (child != NULL) {
+            next = child->next;
+            if ((dict != NULL) && (xmlDictOwns(dict, child->content))) {
+                child->content = NULL;
+            }
+            xmlFreeNode(child);
+            child = next;
+        }
+    }
diff --git a/parser.c b/parser.c
