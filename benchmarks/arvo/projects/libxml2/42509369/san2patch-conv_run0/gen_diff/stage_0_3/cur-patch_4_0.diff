diff --git a/tree.c b/tree.c
index e4425f10..b8ec4143 100644
--- a/tree.c
+++ b/tree.c
@@ -3803,3 +3803,12 @@ xmlFreeNode(xmlNodePtr cur) {
-    if ((cur->children != NULL) &&
-	(cur->type != XML_ENTITY_REF_NODE))
-	xmlFreeNodeList(cur->children);
+// FIXME: Crash CWE-763: Release of Invalid Pointer or Reference
+     if ((cur->children != NULL) &&
+	(cur->type != XML_ENTITY_REF_NODE)) {
+        xmlNodePtr child, next;
+        for (child = cur->children; child != NULL; child = next) {
+            next = child->next;
+            if ((dict != NULL) && (xmlDictOwns(dict, child->content))) {
+                child->content = NULL;  /* Prevent double-free */
+            }
+            xmlFreeNode(child);
+        }
+    }
diff --git a/parser.c b/parser.c
index c3068cad..82a4fc9a 100644
--- a/parser.c
+++ b/parser.c
@@ -7195,0 +7196,12 @@ xmlParseReference(xmlParserCtxtPtr ctxt) {
+	/* Fix: Validate node list before processing to prevent dictionary memory corruption */
+	if (list != NULL && ctxt->dict != NULL) {
+	    /* Ensure nodes don't contain dictionary-managed strings that could cause bad-free */
+	    xmlNodePtr cur = list;
+	    while (cur != NULL) {
+	        if (cur->content != NULL && xmlDictOwns(ctxt->dict, cur->content)) {
+	            cur->content = NULL;  /* Don't free dictionary-managed content */
+	        }
+	        cur = cur->next;
+	    }
+	}
+
