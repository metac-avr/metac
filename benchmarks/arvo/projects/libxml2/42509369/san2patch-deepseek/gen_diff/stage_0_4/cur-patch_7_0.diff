diff --git a/parser.c b/parser.c
index c3068cad..44edbf70 100644
--- a/parser.c
+++ b/parser.c
@@ -10826,0 +10827,12 @@ xmlParseDocument(xmlParserCtxtPtr ctxt) {
+	if (ctxt->myDoc != NULL && ctxt->myDoc->dict != NULL) {
+	    xmlNodePtr cur;
+	    for (cur = ctxt->myDoc->children; cur != NULL; cur = cur->next) {
+	        if (cur->name != NULL && xmlDictOwns(ctxt->myDoc->dict, cur->name)) {
+	            const xmlChar *name = cur->name;
+	            cur->name = xmlStrdup(name);
+	            if (cur->name == NULL) {
+	                cur->name = name;
+	            }
+	        }
+	    }
+	}
