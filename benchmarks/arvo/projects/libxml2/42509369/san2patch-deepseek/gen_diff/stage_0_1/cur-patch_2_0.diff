diff --git a/tree.c b/tree.c
index e4425f10..4d0cf5ec 100644
--- a/tree.c
+++ b/tree.c
@@ -3733 +3733,4 @@ xmlFreeNodeList(xmlNodePtr cur) {
-		DICT_FREE(cur->content)
+		if ((cur->content != NULL) &&
+		    ((cur->doc == NULL) || (cur->doc->dict == NULL) ||
+		     !xmlDictOwns(cur->doc->dict, cur->content)))
+		    DICT_FREE(cur->content)
@@ -3749,2 +3752,5 @@ xmlFreeNodeList(xmlNodePtr cur) {
-		(cur->type != XML_COMMENT_NODE))
-		DICT_FREE(cur->name)
+		(cur->type != XML_COMMENT_NODE)) {
+		if ((cur->doc == NULL) || (cur->doc->dict == NULL) ||
+		    !xmlDictOwns(cur->doc->dict, cur->name))
+		    DICT_FREE(cur->name)
+	    }
diff --git a/parser.c b/parser.c
index c3068cad..57b95633 100644
--- a/parser.c
+++ b/parser.c
@@ -13433 +13433,11 @@ xmlParseBalancedChunkMemoryInternal(xmlParserCtxtPtr oldctxt,
-    }
+// FIXME: Crash CWE-763: Release of Invalid Pointer or Reference
+	while (content != NULL) {
+	    if ((content->name != NULL) &&
+	        (xmlDictOwns(ctxt->dict, content->name)))
+	        content->name = xmlStrdup(content->name);
+	    if ((content->content != NULL) &&
+	        (xmlDictOwns(ctxt->dict, content->content)))
+	        content->content = xmlStrdup(content->content);
+	    content = content->next;
+	}
+     }
@@ -13434,0 +13445,12 @@ xmlParseBalancedChunkMemoryInternal(xmlParserCtxtPtr oldctxt,
+    if (ctxt->myDoc->children != NULL) {
+        xmlNodePtr n = ctxt->myDoc->children;
+        while (n != NULL) {
+            if ((n->name != NULL) &&
+                (xmlDictOwns(ctxt->dict, n->name)))
+                n->name = NULL;
+            if ((n->content != NULL) &&
+                (xmlDictOwns(ctxt->dict, n->content)))
+                n->content = NULL;
+            n = n->next;
+        }
+    }
