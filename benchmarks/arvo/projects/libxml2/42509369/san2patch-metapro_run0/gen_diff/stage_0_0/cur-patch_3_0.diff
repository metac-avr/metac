diff --git a/parser.c b/parser.c
index c3068cad..7c16c47e 100644
--- a/parser.c
+++ b/parser.c
@@ -9911 +9911 @@ xmlParseContentInternal(xmlParserCtxtPtr ctxt) {
-
+ 
@@ -9912,0 +9913,4 @@ xmlParseContentInternal(xmlParserCtxtPtr ctxt) {
+	    xmlNodePtr old_lastchild = NULL;
+	    if (ctxt->node != NULL) {
+	        old_lastchild = ctxt->node->last;
+	    }
@@ -9913,0 +9918,5 @@ xmlParseContentInternal(xmlParserCtxtPtr ctxt) {
+	    /* Validate that reference parsing didn't corrupt node structure */
+	    if ((ctxt->node != NULL) && (ctxt->node->last != old_lastchild) && 
+	        (ctxt->node->last != NULL) && (ctxt->node->last->doc == NULL)) {
+	        ctxt->node->last->doc = ctxt->myDoc;
+	    }
diff --git a/xmlschemas.c b/xmlschemas.c
index 7b44bf60..b1d26eff 100644
--- a/xmlschemas.c
+++ b/xmlschemas.c
@@ -21453,5 +21453,5 @@ xmlSchemaParse(xmlSchemaParserCtxtPtr ctxt)
-	ctxt->constructor = xmlSchemaConstructionCtxtCreate(ctxt->dict);
-	if (ctxt->constructor == NULL)
-	    return(NULL);
-	/* Take ownership of the constructor to be able to free it. */
-	ctxt->ownsConstructor = 1;
+    ctxt->constructor = xmlSchemaConstructionCtxtCreate(ctxt->dict);
+    if (ctxt->constructor == NULL)
+	return(NULL);
+    /* Take ownership of the constructor to be able to free it. */
+    ctxt->ownsConstructor = 1;
@@ -21461,2 +21461,13 @@ xmlSchemaParse(xmlSchemaParserCtxtPtr ctxt)
-    * Locate and add the schema document.
-    */
+     * Locate and add the schema document.
+     * Validate node pointers before processing to prevent invalid pointer freeing.
+     */
+    if (ctxt->doc != NULL && ctxt->doc->children != NULL) {
+        xmlNodePtr cur = ctxt->doc->children;
+        while (cur != NULL) {
+            if (cur->type != XML_ELEMENT_NODE && cur->type != XML_TEXT_NODE && 
+                cur->type != XML_COMMENT_NODE && cur->type != XML_PI_NODE) {
+                goto exit_failure;
+            }
+            cur = cur->next;
+        }
+    }
