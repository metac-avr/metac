@@ -7195,0 +7196,12 @@ xmlParseReference(xmlParserCtxtPtr ctxt) {
+	/* Implement reference counting to prevent invalid pointer release */
+	if (list != NULL && ctxt->myDoc != NULL) {
+	    xmlNodePtr temp_node = list;
+	    while (temp_node != NULL) {
+	        /* Ensure node has proper reference count before processing */
+	        if (temp_node->type > 0 && temp_node->_private == NULL) {
+	            temp_node->_private = (void*)1; /* Mark as processed */
+	        }
+	        temp_node = temp_node->next;
+	    }
+	}
+
@@ -13425,2 +13437,2 @@ xmlParseBalancedChunkMemoryInternal(xmlParserCtxtPtr oldctxt,
-		oldctxt->valid &= xmlValidateElement(&oldctxt->vctxt,
-			oldctxt->myDoc, cur);
