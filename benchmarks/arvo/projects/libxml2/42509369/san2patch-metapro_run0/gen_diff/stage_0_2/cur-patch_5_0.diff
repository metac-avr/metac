+		oldctxt->myDoc, cur);
@@ -13433 +13445,2 @@ xmlParseBalancedChunkMemoryInternal(xmlParserCtxtPtr oldctxt,
-    }
+// FIXME: Crash CWE-763: Release of Invalid Pointer or Reference
+     }
@@ -13435 +13448,3 @@ xmlParseBalancedChunkMemoryInternal(xmlParserCtxtPtr oldctxt,
