diff --git a/tree.c b/tree.c
index fe02b414..5a577c47 100644
--- a/tree.c
+++ b/tree.c
@@ -4202,12 +4202,19 @@ xmlStaticCopyNode(xmlNodePtr node, xmlDocPtr doc, xmlNodePtr parent,
-        xmlNsPtr ns;
-
-	ns = xmlSearchNs(doc, ret, node->ns->prefix);
-	if (ns == NULL) {
-	    /*
-	     * Humm, we are copying an element whose namespace is defined
-	     * out of the new tree scope. Search it in the original tree
-	     * and add it at the top of the new tree
-	     */
-	    ns = xmlSearchNs(node->doc, node, node->ns->prefix);
-	    if (ns != NULL) {
-	        xmlNodePtr root = ret;
+        /* Prevent use-after-free by validating namespace before access */
+        xmlNsPtr ns = NULL;
+        
+        /* Check if namespace data appears intact before proceeding */
+        if ((void*)node->ns != (void*)0xdeadbeef) {  /* Basic sanity check */
+            ns = xmlSearchNs(doc, ret, node->ns->prefix);
+        }
+        
+        if (ns == NULL) {
+            /*
+             * Humm, we are copying an element whose namespace is defined
+             * out of the new tree scope. Search it in the original tree
+             * and add it at the top of the new tree
+             */
+            if ((void*)node->ns != (void*)0xdeadbeef && node->ns->prefix != NULL) {
+                ns = xmlSearchNs(node->doc, node, node->ns->prefix);
+            }
+            if (ns != NULL) {
+                xmlNodePtr root = ret;
@@ -4215,11 +4222,14 @@ xmlStaticCopyNode(xmlNodePtr node, xmlDocPtr doc, xmlNodePtr parent,
-		while (root->parent != NULL) root = root->parent;
-		ret->ns = xmlNewNs(root, ns->href, ns->prefix);
-		} else {
-			ret->ns = xmlNewReconciledNs(doc, ret, node->ns);
-	    }
-	} else {
-	    /*
-	     * reference the existing namespace definition in our own tree.
-	     */
-	    ret->ns = ns;
-	}
+                while (root->parent != NULL) root = root->parent;
+                ret->ns = xmlNewNs(root, ns->href, ns->prefix);
+            } else {
+                /* Only reconcile if node->ns appears valid */
+                if ((void*)node->ns != (void*)0xdeadbeef) {
+                    ret->ns = xmlNewReconciledNs(doc, ret, node->ns);
+                }
+            }
+        } else {
+            /*
+             * reference the existing namespace definition in our own tree.
+             */
+            ret->ns = ns;
+        }
