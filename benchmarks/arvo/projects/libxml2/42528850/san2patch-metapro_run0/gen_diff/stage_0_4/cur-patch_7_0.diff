diff --git a/tree.c b/tree.c
index fe02b414..67f730ea 100644
--- a/tree.c
+++ b/tree.c
@@ -4202,12 +4202,20 @@ xmlStaticCopyNode(xmlNodePtr node, xmlDocPtr doc, xmlNodePtr parent,
-        xmlNsPtr ns;
-
-	ns = xmlSearchNs(doc, ret, node->ns->prefix);
-	if (ns == NULL) {
-	    /*
-	     * Humm, we are copying an element whose namespace is defined
-	     * out of the new tree scope. Search it in the original tree
-	     * and add it at the top of the new tree
-	     */
-	    ns = xmlSearchNs(node->doc, node, node->ns->prefix);
-	    if (ns != NULL) {
-	        xmlNodePtr root = ret;
+        /* Validate namespace pointer before use to prevent use-after-free */
+        xmlNsPtr ns = NULL;
+        
+        /* Only proceed if prefix is accessible (indicates valid memory) */
+        if (node->ns->prefix != NULL) {
+            ns = xmlSearchNs(doc, ret, node->ns->prefix);
+        } else if (node->ns->href != NULL) {
+            /* Fallback: search by href if prefix is not available */
+            ns = xmlSearchNsByHref(doc, ret, node->ns->href);
+        }
+        
+        if (ns == NULL && (node->ns->prefix != NULL || node->ns->href != NULL)) {
+            /*
+             * Humm, we are copying an element whose namespace is defined
+             * out of the new tree scope. Search it in the original tree
+             * and add it at the top of the new tree
+             */
+            ns = xmlSearchNs(node->doc, node, node->ns->prefix);
+            if (ns != NULL) {
+                xmlNodePtr root = ret;
@@ -4215,11 +4223,11 @@ xmlStaticCopyNode(xmlNodePtr node, xmlDocPtr doc, xmlNodePtr parent,
-		while (root->parent != NULL) root = root->parent;
-		ret->ns = xmlNewNs(root, ns->href, ns->prefix);
-		} else {
-			ret->ns = xmlNewReconciledNs(doc, ret, node->ns);
-	    }
-	} else {
-	    /*
-	     * reference the existing namespace definition in our own tree.
-	     */
-	    ret->ns = ns;
-	}
+                while (root->parent != NULL) root = root->parent;
+                ret->ns = xmlNewNs(root, ns->href, ns->prefix);
+            } else {
+                ret->ns = xmlNewReconciledNs(doc, ret, node->ns);
+            }
+        } else if (ns != NULL) {
+            /*
+             * reference the existing namespace definition in our own tree.
+             */
+            ret->ns = ns;
+        }
