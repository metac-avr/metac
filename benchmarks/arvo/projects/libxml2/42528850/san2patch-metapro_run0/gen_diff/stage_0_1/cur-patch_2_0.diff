diff --git a/tree.c b/tree.c
index fe02b414..3e8032b6 100644
--- a/tree.c
+++ b/tree.c
@@ -4202,24 +4202,29 @@ xmlStaticCopyNode(xmlNodePtr node, xmlDocPtr doc, xmlNodePtr parent,
-        xmlNsPtr ns;
-
-	ns = xmlSearchNs(doc, ret, node->ns->prefix);
-	if (ns == NULL) {
-	    /*
-	     * Humm, we are copying an element whose namespace is defined
-	     * out of the new tree scope. Search it in the original tree
-	     * and add it at the top of the new tree
-	     */
-	    ns = xmlSearchNs(node->doc, node, node->ns->prefix);
-	    if (ns != NULL) {
-	        xmlNodePtr root = ret;
-
-		while (root->parent != NULL) root = root->parent;
-		ret->ns = xmlNewNs(root, ns->href, ns->prefix);
-		} else {
-			ret->ns = xmlNewReconciledNs(doc, ret, node->ns);
-	    }
-	} else {
-	    /*
-	     * reference the existing namespace definition in our own tree.
-	     */
-	    ret->ns = ns;
-	}
+         xmlNsPtr ns;
+
+	 /* Add defensive check for expired pointer */
+	 if (node->ns->prefix != NULL || node->ns->href != NULL) {
+	     ns = xmlSearchNs(doc, ret, node->ns->prefix);
+	     if (ns == NULL) {
+	         /*
+	          * Humm, we are copying an element whose namespace is defined
+	          * out of the new tree scope. Search it in the original tree
+	          * and add it at the top of the new tree
+	          */
+	         ns = xmlSearchNs(node->doc, node, node->ns->prefix);
+	         if (ns != NULL) {
+	             xmlNodePtr root = ret;
+
+	             while (root->parent != NULL) root = root->parent;
+	             ret->ns = xmlNewNs(root, ns->href, ns->prefix);
+	         } else {
+		             ret->ns = xmlNewReconciledNs(doc, ret, node->ns);
+	         }
+	     } else {
+	         /*
+	          * reference the existing namespace definition in our own tree.
+	          */
+	         ret->ns = ns;
+	     }
+	 } else {
+	     ret->ns = NULL;
+	 }
@@ -4367 +4372 @@ xmlCopyNode(xmlNodePtr node, int extended) {
- *		if 2 copy properties and namespaces (when applicable)
+ *              if 2 copy properties and namespaces (when applicable)
@@ -4375 +4380 @@ xmlDocCopyNode(xmlNodePtr node, xmlDocPtr doc, int extended) {
-    xmlNodePtr ret;
+     xmlNodePtr ret;
@@ -4376,0 +4382,15 @@ xmlDocCopyNode(xmlNodePtr node, xmlDocPtr doc, int extended) {
+    /* Prevent expired pointer dereference by checking node validity */
+    if (node == NULL)
+        return(NULL);
+        
+    /* Additional safety check for namespace validity before copying */
+    if (extended != 0 && node->type == XML_ELEMENT_NODE) {
+        xmlNsPtr ns = node->nsDef;
+        while (ns != NULL) {
+            /* Check if namespace appears to be valid */
+            if (((char*)ns) < ((char*)0x1000))
+                return(NULL); /* Likely dangling pointer */
+            ns = ns->next;
+        }
+    }
+    
