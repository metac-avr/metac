diff --git a/tree.c b/tree.c
index fe02b414..5079360a 100644
--- a/tree.c
+++ b/tree.c
@@ -4202,24 +4202,28 @@ xmlStaticCopyNode(xmlNodePtr node, xmlDocPtr doc, xmlNodePtr parent,
-        xmlNsPtr ns;
-
-	ns = xmlSearchNs(doc, ret, node->ns->prefix);
-	if (ns == NULL) {
-	    /*
-	     * Humm, we are copying an element whose namespace is defined
-	     * out of the new tree scope. Search it in the original tree
-	     * and add it at the top of the new tree
-	     */
-	    ns = xmlSearchNs(node->doc, node, node->ns->prefix);
-	    if (ns != NULL) {
-	        xmlNodePtr root = ret;
-
-		while (root->parent != NULL) root = root->parent;
-		ret->ns = xmlNewNs(root, ns->href, ns->prefix);
-		} else {
-			ret->ns = xmlNewReconciledNs(doc, ret, node->ns);
-	    }
-	} else {
-	    /*
-	     * reference the existing namespace definition in our own tree.
-	     */
-	    ret->ns = ns;
-	}
+// Prevent expired pointer dereference by checking node validity
+         xmlNsPtr ns;
+
+	 /* Ensure the node and its namespace are still valid before proceeding */
+	 if (node->doc != NULL && node->ns != NULL) {
+	     ns = xmlSearchNs(doc, ret, node->ns->prefix);
+	     if (ns == NULL) {
+	         /*
+	          * Humm, we are copying an element whose namespace is defined
+	          * out of the new tree scope. Search it in the original tree
+	          * and add it at the top of the new tree
+	          */
+	         ns = xmlSearchNs(node->doc, node, node->ns->prefix);
+	         if (ns != NULL) {
+	             xmlNodePtr root = ret;
+
+		     while (root->parent != NULL) root = root->parent;
+		     ret->ns = xmlNewNs(root, ns->href, ns->prefix);
+		 } else {
+			 ret->ns = xmlNewReconciledNs(doc, ret, node->ns);
+	         }
+	     } else {
+	         /*
+	          * reference the existing namespace definition in our own tree.
+	          */
+	         ret->ns = ns;
+	     }
+	 }
diff --git a/xmlreader.c b/xmlreader.c
index c04cb113..0905a261 100644
--- a/xmlreader.c
+++ b/xmlreader.c
@@ -1280 +1280 @@ xmlTextReaderRead(xmlTextReaderPtr reader) {
-        if ((reader->preserves > 0) &&
+	if ((reader->preserves > 0) &&
@@ -1299,3 +1299,21 @@ xmlTextReaderRead(xmlTextReaderPtr reader) {
-                    oldnode = NULL;
-		xmlUnlinkNode(tmp);
-		xmlTextReaderFreeNode(reader, tmp);
+                     oldnode = NULL;
+		/* Prevent freeing nodes with active namespace references */
+		int has_active_refs = 0;
+		if (tmp->properties != NULL) {
+		    xmlAttrPtr prop = tmp->properties;
+		    while (prop != NULL) {
+		        if (prop->ns != NULL && (prop->extra & PROP_NS_FREED) == 0) {
+			    has_active_refs = 1;
+			    break;
+		        }
+		        prop = prop->next;
+		    }
+		}
+		if (!has_active_refs && (tmp->extra & NODE_NS_CHECKED) == 0) {
+		    tmp->extra |= NODE_NS_CHECKED;
+		    xmlUnlinkNode(tmp);
+		    xmlTextReaderFreeNode(reader, tmp);
+		} else if (!has_active_refs) {
+		    xmlUnlinkNode(tmp);
+		    xmlTextReaderFreeNode(reader, tmp);
+		}
