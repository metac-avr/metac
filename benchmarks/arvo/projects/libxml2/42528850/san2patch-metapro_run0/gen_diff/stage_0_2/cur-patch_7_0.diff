diff --git a/tree.c b/tree.c
index fe02b414..e72090aa 100644
--- a/tree.c
+++ b/tree.c
@@ -4202,17 +4202,25 @@ xmlStaticCopyNode(xmlNodePtr node, xmlDocPtr doc, xmlNodePtr parent,
-        xmlNsPtr ns;
-
-	ns = xmlSearchNs(doc, ret, node->ns->prefix);
-	if (ns == NULL) {
-	    /*
-	     * Humm, we are copying an element whose namespace is defined
-	     * out of the new tree scope. Search it in the original tree
-	     * and add it at the top of the new tree
-	     */
-	    ns = xmlSearchNs(node->doc, node, node->ns->prefix);
-	    if (ns != NULL) {
-	        xmlNodePtr root = ret;
-
-		while (root->parent != NULL) root = root->parent;
-		ret->ns = xmlNewNs(root, ns->href, ns->prefix);
-		} else {
-			ret->ns = xmlNewReconciledNs(doc, ret, node->ns);
+         xmlNsPtr ns;
+
+	/* Check if namespace is still accessible to prevent use-after-free */
+	if ((char*)node->ns >= (char*)0x1000) {  /* Basic sanity check for valid pointer */
+	    ns = xmlSearchNs(doc, ret, node->ns->prefix);
+	    if (ns == NULL) {
+	        /*
+	         * Humm, we are copying an element whose namespace is defined
+	         * out of the new tree scope. Search it in the original tree
+	         * and add it at the top of the new tree
+	         */
+	        ns = xmlSearchNs(node->doc, node, node->ns->prefix);
+	        if (ns != NULL) {
+	            xmlNodePtr root = ret;
+
+	            while (root->parent != NULL) root = root->parent;
+	            ret->ns = xmlNewNs(root, ns->href, ns->prefix);
+	        } else {
+	            ret->ns = xmlNewReconciledNs(doc, ret, node->ns);
+	        }
+	    } else {
+	        /*
+	         * reference the existing namespace definition in our own tree.
+	         */
+	        ret->ns = ns;
@@ -4221,4 +4229,2 @@ xmlStaticCopyNode(xmlNodePtr node, xmlDocPtr doc, xmlNodePtr parent,
-	    /*
-	     * reference the existing namespace definition in our own tree.
-	     */
-	    ret->ns = ns;
+	    /* Handle case where namespace pointer appears to be freed/invalid */
+	    ret->ns = NULL;
diff --git a/parser.c b/parser.c
index 11bb5199..b601e944 100644
--- a/parser.c
+++ b/parser.c
@@ -7502 +7502,15 @@ xmlParseReference(xmlParserCtxtPtr ctxt) {
-		    nw = xmlDocCopyNode(cur, ctxt->myDoc, 1);
+		    /* Validate namespace before copying to prevent use-after-free */
+		    xmlNodePtr safe_cur = cur;
+		    if (cur->ns != NULL) {
+		        /* Create a temporary copy of namespace data to avoid dangling pointers */
+		        xmlNsPtr temp_ns = xmlNewNs(NULL, cur->ns->href, cur->ns->prefix);
+		        if (temp_ns == NULL) {
+		            cur = cur->next;
+		            continue;
+		        }
+		        safe_cur = xmlCopyNode(cur, 1);
+		        if (safe_cur != NULL) {
+		            safe_cur->ns = temp_ns;
+		        }
+		    }
+		    nw = xmlDocCopyNode(safe_cur, ctxt->myDoc, 1);
