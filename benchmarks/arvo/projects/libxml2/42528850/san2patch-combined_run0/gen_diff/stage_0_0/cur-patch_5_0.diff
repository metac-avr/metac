@@ -4367 +4367 @@ xmlCopyNode(xmlNodePtr node, int extended) {
- *		if 2 copy properties and namespaces (when applicable)
+ *              if 2 copy properties and namespaces (when applicable)
@@ -4375 +4375 @@ xmlDocCopyNode(xmlNodePtr node, xmlDocPtr doc, int extended) {
-    xmlNodePtr ret;
+     xmlNodePtr ret;
@@ -4377,0 +4378,12 @@ xmlDocCopyNode(xmlNodePtr node, xmlDocPtr doc, int extended) {
+    /* Fix for CVE-XXXX: Check for and handle namespace copying to prevent use-after-free */
+    if (ret != NULL && extended == 2 && node->nsDef != NULL) {
+        /* Create a fresh copy of namespaces to avoid referencing freed memory */
+        xmlNsPtr newNsDef = xmlCopyNamespaceList(node->nsDef);
+        if (newNsDef == NULL) {
+            xmlFreeNode(ret);
+            return NULL;
+        }
+        /* Replace potentially dangling namespace references */
+        xmlFreeNsList(ret->nsDef);
+        ret->nsDef = newNsDef;
+    }
