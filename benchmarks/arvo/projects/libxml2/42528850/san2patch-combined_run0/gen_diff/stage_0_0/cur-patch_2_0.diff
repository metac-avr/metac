diff --git a/tree.c b/tree.c
index fe02b414..b1ed959f 100644
--- a/tree.c
+++ b/tree.c
@@ -4204,10 +4204,12 @@ xmlStaticCopyNode(xmlNodePtr node, xmlDocPtr doc, xmlNodePtr parent,
-	ns = xmlSearchNs(doc, ret, node->ns->prefix);
-	if (ns == NULL) {
-	    /*
-	     * Humm, we are copying an element whose namespace is defined
-	     * out of the new tree scope. Search it in the original tree
-	     * and add it at the top of the new tree
-	     */
-	    ns = xmlSearchNs(node->doc, node, node->ns->prefix);
-	    if (ns != NULL) {
-	        xmlNodePtr root = ret;
+        /* Prevent use-after-free by checking if namespace is still accessible */
+        if (node->ns->type == XML_LOCAL_NAMESPACE || node->ns->type == XML_GLOBAL_NAMESPACE) {
+            ns = xmlSearchNs(doc, ret, node->ns->prefix);
+            if (ns == NULL) {
+                /*
+                 * Humm, we are copying an element whose namespace is defined
+                 * out of the new tree scope. Search it in the original tree
+                 * and add it at the top of the new tree
+                 */
+                ns = xmlSearchNs(node->doc, node, node->ns->prefix);
+                if (ns != NULL) {
+                    xmlNodePtr root = ret;
@@ -4215,11 +4217,15 @@ xmlStaticCopyNode(xmlNodePtr node, xmlDocPtr doc, xmlNodePtr parent,
-		while (root->parent != NULL) root = root->parent;
-		ret->ns = xmlNewNs(root, ns->href, ns->prefix);
-		} else {
-			ret->ns = xmlNewReconciledNs(doc, ret, node->ns);
-	    }
-	} else {
-	    /*
-	     * reference the existing namespace definition in our own tree.
-	     */
-	    ret->ns = ns;
-	}
+                    while (root->parent != NULL) root = root->parent;
+                    ret->ns = xmlNewNs(root, ns->href, ns->prefix);
+                } else {
+                    ret->ns = xmlNewReconciledNs(doc, ret, node->ns);
+                }
+            } else {
+                /*
+                 * reference the existing namespace definition in our own tree.
+                 */
+                ret->ns = ns;
+            }
+        } else {
+            /* Invalid namespace type, avoid use-after-free */
+            ret->ns = NULL;
+        }
diff --git a/xmlreader.c b/xmlreader.c
index c04cb113..3e854043 100644
--- a/xmlreader.c
+++ b/xmlreader.c
@@ -422,2 +422,5 @@ xmlTextReaderFreeNode(xmlTextReaderPtr reader, xmlNodePtr cur) {
-	(cur->nsDef != NULL))
-	xmlFreeNsList(cur->nsDef);
+	(cur->nsDef != NULL)) {
+	/* Set nsDef to NULL before freeing to avoid dangling references */
+        xmlFreeNsList(cur->nsDef);
+        cur->nsDef = NULL;
+    }
