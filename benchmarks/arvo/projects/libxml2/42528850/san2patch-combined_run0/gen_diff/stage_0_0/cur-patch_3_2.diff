+        /* Ensure namespace references are properly copied to avoid use-after-free */
+        xmlNodePtr cur = ret;
+        while (cur != NULL) {
+            if (cur->nsDef != NULL) {
+                xmlNsPtr nsDef = cur->nsDef;
+                cur->nsDef = NULL;
+                cur->nsDef = xmlCopyNamespaceList(nsDef);
