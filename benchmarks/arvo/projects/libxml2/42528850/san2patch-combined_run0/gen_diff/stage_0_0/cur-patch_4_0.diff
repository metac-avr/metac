diff --git a/tree.c b/tree.c
index fe02b414..2fad020b 100644
--- a/tree.c
+++ b/tree.c
@@ -4367 +4367 @@ xmlCopyNode(xmlNodePtr node, int extended) {
- *		if 2 copy properties and namespaces (when applicable)
+ *              if 2 copy properties and namespaces (when applicable)
@@ -4375,3 +4375,17 @@ xmlDocCopyNode(xmlNodePtr node, xmlDocPtr doc, int extended) {
-    xmlNodePtr ret;
-
-    ret = xmlStaticCopyNode(node, doc, NULL, extended);
+     xmlNodePtr ret;
+
+    /* Prevent use-after-free by ensuring deep copy of namespaces */
+    if (extended == 2) {
+        ret = xmlStaticCopyNode(node, doc, NULL, 1); /* Force shallow copy first */
+        if (ret != NULL) {
+            /* Then explicitly copy namespaces to avoid dangling pointers */
+            xmlNodePtr temp = xmlStaticCopyNode(node, doc, NULL, 2);
+            if (temp != NULL) {
+                ret->nsDef = temp->nsDef;
+                temp->nsDef = NULL; /* Transfer ownership */
+                xmlFreeNode(temp);
+            }
+        }
+    } else {
+        ret = xmlStaticCopyNode(node, doc, NULL, extended);
+    }
@@ -4387,2 +4401 @@ xmlDocCopyNode(xmlNodePtr node, xmlDocPtr doc, int extended) {
- *
- * Returns: a new #xmlNodePtr, or NULL in case of error.
+ * * Returns: a new #xmlNodePtr, or NULL in case of error.
diff --git a/xmlreader.c b/xmlreader.c
index c04cb113..388b792f 100644
--- a/xmlreader.c
+++ b/xmlreader.c
@@ -422,2 +422,5 @@ xmlTextReaderFreeNode(xmlTextReaderPtr reader, xmlNodePtr cur) {
-	(cur->nsDef != NULL))
-	xmlFreeNsList(cur->nsDef);
+	(cur->nsDef != NULL)) {
+        /* Free namespace definitions immediately to avoid dangling pointers */
+        xmlFreeNsList(cur->nsDef);
+        cur->nsDef = NULL;
+    }
