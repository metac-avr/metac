diff --git a/tree.c b/tree.c
index fe02b414..c8979f05 100644
--- a/tree.c
+++ b/tree.c
@@ -4202,12 +4202,15 @@ xmlStaticCopyNode(xmlNodePtr node, xmlDocPtr doc, xmlNodePtr parent,
-        xmlNsPtr ns;
-
-	ns = xmlSearchNs(doc, ret, node->ns->prefix);
-	if (ns == NULL) {
-	    /*
-	     * Humm, we are copying an element whose namespace is defined
-	     * out of the new tree scope. Search it in the original tree
-	     * and add it at the top of the new tree
-	     */
-	    ns = xmlSearchNs(node->doc, node, node->ns->prefix);
-	    if (ns != NULL) {
-	        xmlNodePtr root = ret;
+	/* Fixed CWE-416: Add null check and validation before namespace access */
+        xmlNsPtr ns = NULL;
+        
+        /* Check if the namespace pointer is accessible and not freed */
+        if (node->ns != NULL && (uintptr_t)node->ns != 0x1) {  /* 0x1 is often used as marker for freed nodes */
+            ns = xmlSearchNs(doc, ret, node->ns->prefix);
+            if (ns == NULL) {
+                /*
+                 * Humm, we are copying an element whose namespace is defined
+                 * out of the new tree scope. Search it in the original tree
+                 * and add it at the top of the new tree
+                 */
+                ns = xmlSearchNs(node->doc, node, node->ns->prefix);
+                if (ns != NULL) {
+                    xmlNodePtr root = ret;
@@ -4215,11 +4218,12 @@ xmlStaticCopyNode(xmlNodePtr node, xmlDocPtr doc, xmlNodePtr parent,
-		while (root->parent != NULL) root = root->parent;
-		ret->ns = xmlNewNs(root, ns->href, ns->prefix);
-		} else {
-			ret->ns = xmlNewReconciledNs(doc, ret, node->ns);
-	    }
-	} else {
-	    /*
-	     * reference the existing namespace definition in our own tree.
-	     */
-	    ret->ns = ns;
-	}
+                    while (root->parent != NULL) root = root->parent;
+                    ret->ns = xmlNewNs(root, ns->href, ns->prefix);
+                } else {
+                    ret->ns = xmlNewReconciledNs(doc, ret, node->ns);
+                }
+            } else {
+                /*
+                 * reference the existing namespace definition in our own tree.
+                 */
+                ret->ns = ns;
+            }
+        }
diff --git a/xmlreader.c b/xmlreader.c
index c04cb113..457f3c58 100644
--- a/xmlreader.c
+++ b/xmlreader.c
@@ -1299,3 +1299,22 @@ xmlTextReaderRead(xmlTextReaderPtr reader) {
-                    oldnode = NULL;
-		xmlUnlinkNode(tmp);
-		xmlTextReaderFreeNode(reader, tmp);
+                     oldnode = NULL;
+		/* Validate node and namespace pointers before unlinking */
+		int can_free = 1;
+		if (tmp->type == XML_ELEMENT_NODE && tmp->nsDef != NULL) {
+		    xmlNsPtr ns = tmp->nsDef;
+		    while (ns != NULL) {
+		        if (ns->href == NULL) {
+			    can_free = 0; /* Skip freeing nodes with invalid namespaces */
+			    break;
+		        }
+		        ns = ns->next;
+		    }
+		}
+		if (can_free) {
+		    xmlUnlinkNode(tmp);
+		    xmlTextReaderFreeNode(reader, tmp);
+		} else {
+		    xmlUnlinkNode(tmp);
+		    /* Clear namespace references to prevent UAF */
+		    tmp->nsDef = NULL;
+		    xmlTextReaderFreeNode(reader, tmp);
+		}
