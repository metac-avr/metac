--- a/xmlreader.c
+++ b/xmlreader.c
@@ -1280 +1280 @@ xmlTextReaderRead(xmlTextReaderPtr reader) {
-        if ((reader->preserves > 0) &&
+	if ((reader->preserves > 0) &&
@@ -1299,3 +1299,8 @@ xmlTextReaderRead(xmlTextReaderPtr reader) {
-                    oldnode = NULL;
-		xmlUnlinkNode(tmp);
-		xmlTextReaderFreeNode(reader, tmp);
+                     oldnode = NULL;
+		/* Check if tmp is a valid pointer before unlinking */
+		if (tmp != NULL && tmp->type != XML_NAMESPACE_DECL) {
+		    xmlUnlinkNode(tmp);
+		    xmlTextReaderFreeNode(reader, tmp);
+		} else if (tmp != NULL) {
+		    xmlTextReaderFreeNode(reader, tmp);
+		}
