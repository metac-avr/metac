diff --git a/tree.c b/tree.c
index fe02b414..e1c4fd5f 100644
--- a/tree.c
+++ b/tree.c
@@ -819,2 +819,9 @@ xmlFreeNs(xmlNsPtr cur) {
-    if (cur->href != NULL) xmlFree((char *) cur->href);
-    if (cur->prefix != NULL) xmlFree((char *) cur->prefix);
+    /* Clear pointers before freeing to prevent use-after-free */
+    if (cur->href != NULL) {
+        xmlFree((char *) cur->href);
+        cur->href = NULL;
+    }
+    if (cur->prefix != NULL) {
+        xmlFree((char *) cur->prefix);
+        cur->prefix = NULL;
+    }
@@ -831,2 +838 @@ void
-xmlFreeNsList(xmlNsPtr cur) {
-    xmlNsPtr next;
+xmlFreeNsList(xmlNsPtr cur) {    xmlNsPtr next;
@@ -4202,18 +4208,3 @@ xmlStaticCopyNode(xmlNodePtr node, xmlDocPtr doc, xmlNodePtr parent,
-        xmlNsPtr ns;
-
-	ns = xmlSearchNs(doc, ret, node->ns->prefix);
-	if (ns == NULL) {
-	    /*
-	     * Humm, we are copying an element whose namespace is defined
-	     * out of the new tree scope. Search it in the original tree
-	     * and add it at the top of the new tree
-	     */
-	    ns = xmlSearchNs(node->doc, node, node->ns->prefix);
-	    if (ns != NULL) {
-	        xmlNodePtr root = ret;
-
-		while (root->parent != NULL) root = root->parent;
-		ret->ns = xmlNewNs(root, ns->href, ns->prefix);
-		} else {
-			ret->ns = xmlNewReconciledNs(doc, ret, node->ns);
-	    }
+	// Fixed CWE-416: Use After Free by checking if node->doc is valid
+	if (node->doc == NULL) {
+	    ret->ns = NULL;
@@ -4221,4 +4212,24 @@ xmlStaticCopyNode(xmlNodePtr node, xmlDocPtr doc, xmlNodePtr parent,
-	    /*
-	     * reference the existing namespace definition in our own tree.
-	     */
-	    ret->ns = ns;
+	    xmlNsPtr ns;
+
+	    ns = xmlSearchNs(doc, ret, node->ns->prefix);
+	    if (ns == NULL) {
+	        /*
+	         * Humm, we are copying an element whose namespace is defined
+	         * out of the new tree scope. Search it in the original tree
+	         * and add it at the top of the new tree
+	         */
+	        ns = xmlSearchNs(node->doc, node, node->ns->prefix);
+	        if (ns != NULL) {
+	            xmlNodePtr root = ret;
+
+	            while (root->parent != NULL) root = root->parent;
+	            ret->ns = xmlNewNs(root, ns->href, ns->prefix);
+	        } else {
+	            ret->ns = xmlNewReconciledNs(doc, ret, node->ns);
+	        }
+	    } else {
+	        /*
+	         * reference the existing namespace definition in our own tree.
+	         */
+	        ret->ns = ns;
+	    }
