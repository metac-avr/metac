+                     oldnode = NULL;
@@ -1300,0 +1301,9 @@ xmlTextReaderRead(xmlTextReaderPtr reader) {
+		/* Clear namespace references before freeing to prevent use-after-free */
+		if (tmp->nsDef != NULL) {
