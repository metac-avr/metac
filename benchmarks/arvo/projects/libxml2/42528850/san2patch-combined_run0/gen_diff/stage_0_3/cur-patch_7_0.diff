diff --git a/tree.c b/tree.c
index fe02b414..e0e8d71f 100644
--- a/tree.c
+++ b/tree.c
@@ -818,0 +819 @@ xmlFreeNs(xmlNsPtr cur) {
+    /* Zero out the entire structure before freeing to prevent dangling pointers */
@@ -820,0 +822 @@ xmlFreeNs(xmlNsPtr cur) {
+    memset(cur, 0, sizeof(xmlNs));
@@ -831,2 +833 @@ void
-xmlFreeNsList(xmlNsPtr cur) {
-    xmlNsPtr next;
+xmlFreeNsList(xmlNsPtr cur) {    xmlNsPtr next;
@@ -4202,18 +4203,3 @@ xmlStaticCopyNode(xmlNodePtr node, xmlDocPtr doc, xmlNodePtr parent,
-        xmlNsPtr ns;
-
-	ns = xmlSearchNs(doc, ret, node->ns->prefix);
-	if (ns == NULL) {
-	    /*
-	     * Humm, we are copying an element whose namespace is defined
-	     * out of the new tree scope. Search it in the original tree
-	     * and add it at the top of the new tree
-	     */
-	    ns = xmlSearchNs(node->doc, node, node->ns->prefix);
-	    if (ns != NULL) {
-	        xmlNodePtr root = ret;
-
-		while (root->parent != NULL) root = root->parent;
-		ret->ns = xmlNewNs(root, ns->href, ns->prefix);
-		} else {
-			ret->ns = xmlNewReconciledNs(doc, ret, node->ns);
-	    }
+	// Fixed CWE-416: Use After Free by validating node before accessing
+	if (node == NULL) {
+	    ret->ns = NULL;
@@ -4221,4 +4207,26 @@ xmlStaticCopyNode(xmlNodePtr node, xmlDocPtr doc, xmlNodePtr parent,
-	    /*
-	     * reference the existing namespace definition in our own tree.
-	     */
-	    ret->ns = ns;
+	    xmlNsPtr ns;
+
+	    ns = xmlSearchNs(doc, ret, node->ns->prefix);
+	    if (ns == NULL) {
+	        /*
+	         * Humm, we are copying an element whose namespace is defined
+	         * out of the new tree scope. Search it in the original tree
+	         * and add it at the top of the new tree
+	         */
+	        if (node->doc != NULL) {
+	            ns = xmlSearchNs(node->doc, node, node->ns->prefix);
+	        }
+	        if (ns != NULL) {
+	            xmlNodePtr root = ret;
+
+	            while (root->parent != NULL) root = root->parent;
+	            ret->ns = xmlNewNs(root, ns->href, ns->prefix);
+	        } else {
+	            ret->ns = xmlNewReconciledNs(doc, ret, node->ns);
+	        }
+	    } else {
+	        /*
+	         * reference the existing namespace definition in our own tree.
+	         */
+	        ret->ns = ns;
+	    }
