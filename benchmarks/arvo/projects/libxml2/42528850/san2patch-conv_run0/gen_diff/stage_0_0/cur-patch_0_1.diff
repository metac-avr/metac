+    xmlNewNs(xmlNodePtr node, const xmlChar *href, const xmlChar *prefix) {
+    xmlNsPtr cur;
+
+    if ((node != NULL) && (node->type != XML_ELEMENT_NODE))
+	return(NULL);
+
+    if ((prefix != NULL) && (xmlStrEqual(prefix, BAD_CAST "xml"))) {
+        /* xml namespace is predefined, no need to add it */
+        if (xmlStrEqual(href, XML_XML_NAMESPACE))
+            return(NULL);
+
+        /*
+         * Problem, this is an attempt to bind xml prefix to a wrong
+         * namespace, which breaks
+         * Namespace constraint: Reserved Prefixes and Namespace Names
+         * from XML namespace. But documents authors may not care in
+         * their context so let's proceed.
+         */
+    }
@@ -1286,16 +1283,48 @@ xmlTextReaderRead(xmlTextReaderPtr reader) {
-	/*
-	 * Cleanup of the old node
-	 */
-	if ((reader->preserves == 0) &&
-#ifdef LIBXML_XINCLUDE_ENABLED
-	    (reader->in_xinclude == 0) &&
-#endif
-	    (reader->entNr == 0) &&
-	    (reader->node->prev != NULL) &&
-            (reader->node->prev->type != XML_DTD_NODE)) {
-	    xmlNodePtr tmp = reader->node->prev;
-	    if ((tmp->extra & NODE_IS_PRESERVED) == 0) {
-                if (oldnode == tmp)
-                    oldnode = NULL;
-		xmlUnlinkNode(tmp);
-		xmlTextReaderFreeNode(reader, tmp);
+    /*
+     * Allocate a new Namespace and fill the fields.
+     */
+    cur = (xmlNsPtr) xmlMalloc(sizeof(xmlNs));
+    if (cur == NULL) {
+	xmlTreeErrMemory("building namespace");
+	return(NULL);
+    }
+    memset(cur, 0, sizeof(xmlNs));
+    cur->type = XML_LOCAL_NAMESPACE;
+
+    if (href != NULL)
+	cur->href = xmlStrdup(href);
+    if (prefix != NULL)
+	cur->prefix = xmlStrdup(prefix);
+
+    /*
+     * Add it at the end to preserve parsing order ...
+     * and checks for existing use of the prefix
+     */
+    if (node != NULL) {
+	if (node->nsDef == NULL) {
+	    node->nsDef = cur;
+	} else {
+	    xmlNsPtr prev = node->nsDef;
+
+	    if (((prev->prefix == NULL) && (cur->prefix == NULL)) ||
+		(xmlStrEqual(prev->prefix, cur->prefix))) {
+		/* Free the allocated memory before returning */
+		if (cur->href != NULL)
+		    xmlFree((xmlChar *)cur->href);
+		if (cur->prefix != NULL)
+		    xmlFree((xmlChar *)cur->prefix);
+		xmlFree(cur);
+		return(NULL);
+	    }
+	    while (prev->next != NULL) {
+	        prev = prev->next;
+		if (((prev->prefix == NULL) && (cur->prefix == NULL)) ||
+		    (xmlStrEqual(prev->prefix, cur->prefix))) {
+		    /* Free the allocated memory before returning */
+		    if (cur->href != NULL)
+		        xmlFree((xmlChar *)cur->href);
+		    if (cur->prefix != NULL)
+		        xmlFree((xmlChar *)cur->prefix);
+		    xmlFree(cur);
+		    return(NULL);
+		}
@@ -1302,0 +1332 @@ xmlTextReaderRead(xmlTextReaderPtr reader) {
+	    prev->next = cur;
@@ -1304,2 +1333,0 @@ xmlTextReaderRead(xmlTextReaderPtr reader) {
-
-	goto node_found;
@@ -1306,0 +1335,2 @@ xmlTextReaderRead(xmlTextReaderPtr reader) {
+    return(cur);
+}
