diff --git a/xmlreader.c b/xmlreader.c
index c04cb113..ea51486e 100644
--- a/xmlreader.c
+++ b/xmlreader.c
@@ -1299 +1299 @@ xmlTextReaderRead(xmlTextReaderPtr reader) {
-                    oldnode = NULL;
+                     oldnode = NULL;
@@ -1300,0 +1301,12 @@ xmlTextReaderRead(xmlTextReaderPtr reader) {
+		/* Check if node has namespace references before freeing */
+		if (tmp->nsDef != NULL || tmp->ns != NULL) {
+		    /* Mark namespace as expired but don't free immediately */
+		    xmlNsPtr ns = tmp->nsDef;
+		    while (ns != NULL) {
+		        ns->href = NULL; /* Mark as expired */
+		        ns = ns->next;
+		    }
+		    if (tmp->ns != NULL) {
+		        tmp->ns->href = NULL; /* Mark as expired */
+		    }
+		}
