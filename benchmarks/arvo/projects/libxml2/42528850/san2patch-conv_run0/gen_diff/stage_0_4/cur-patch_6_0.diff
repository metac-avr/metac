diff --git a/tree.c b/tree.c
index fe02b414..a8e65228 100644
--- a/tree.c
+++ b/tree.c
@@ -4202 +4202 @@ xmlStaticCopyNode(xmlNodePtr node, xmlDocPtr doc, xmlNodePtr parent,
-        xmlNsPtr ns;
+         xmlNsPtr ns;
diff --git a/xmlreader.c b/xmlreader.c
index c04cb113..b6c04c58 100644
--- a/xmlreader.c
+++ b/xmlreader.c
@@ -421,3 +421,17 @@ xmlTextReaderFreeNode(xmlTextReaderPtr reader, xmlNodePtr cur) {
-	 (cur->type == XML_XINCLUDE_END)) &&
-	(cur->nsDef != NULL))
-	xmlFreeNsList(cur->nsDef);
+// FIXME: Crash CWE-825: Expired Pointer Dereference
+ 	 (cur->type == XML_XINCLUDE_END)) &&
+	(cur->nsDef != NULL)) {
+        /* Clear namespace references before freeing to prevent use-after-free */
+        xmlNodePtr node;
+        xmlNsPtr ns;
+        
+        /* Clear any references to these namespaces in the document */
+        for (node = cur; node != NULL; node = node->parent) {
+            for (ns = cur->nsDef; ns != NULL; ns = ns->next) {
+                if (node->ns == ns)
+                    node->ns = NULL;
+            }
+        }
+        xmlFreeNsList(cur->nsDef);
+        cur->nsDef = NULL;
+    }
