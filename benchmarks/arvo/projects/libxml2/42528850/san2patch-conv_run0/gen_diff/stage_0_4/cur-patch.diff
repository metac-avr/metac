diff --git a/xmlreader.c b/xmlreader.c
index c04cb113..171f8fd4 100644
--- a/xmlreader.c
+++ b/xmlreader.c
@@ -421,3 +421,23 @@ xmlTextReaderFreeNode(xmlTextReaderPtr reader, xmlNodePtr cur) {
-	 (cur->type == XML_XINCLUDE_END)) &&
-	(cur->nsDef != NULL))
-	xmlFreeNsList(cur->nsDef);
+// FIXME: Crash CWE-825: Expired Pointer Dereference
+ 	 (cur->type == XML_XINCLUDE_END)) &&
+	(cur->nsDef != NULL)) {
+        /* Fix for CWE-825: Expired Pointer Dereference */
+        /* Clear all references to namespace definitions before freeing them */
+        xmlNodePtr temp_node;
+        xmlNsPtr temp_ns;
+        
+        /* Iterate through the namespace list and clear references */
+        for (temp_ns = cur->nsDef; temp_ns != NULL; temp_ns = temp_ns->next) {
+            /* Clear references in current node */
+            if (cur->ns == temp_ns)
+                cur->ns = NULL;
+            
+            /* Clear references in parent chain */
+            for (temp_node = cur->parent; temp_node != NULL; temp_node = temp_node->parent) {
+                if (temp_node->ns == temp_ns)
+                    temp_node->ns = NULL;
+            }
+        }
+        xmlFreeNsList(cur->nsDef);
+        cur->nsDef = NULL;
+    }
