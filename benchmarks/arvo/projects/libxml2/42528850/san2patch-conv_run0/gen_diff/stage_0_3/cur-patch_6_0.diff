diff --git a/xmlreader.c b/xmlreader.c
index c04cb113..63349cd3 100644
--- a/xmlreader.c
+++ b/xmlreader.c
@@ -422,2 +422,17 @@ xmlTextReaderFreeNode(xmlTextReaderPtr reader, xmlNodePtr cur) {
-	(cur->nsDef != NULL))
-	xmlFreeNsList(cur->nsDef);
+	(cur->nsDef != NULL)) {
+        /* Check if namespace is still referenced before freeing */
+        xmlNodePtr tmp;
+        int ns_referenced = 0;
+        
+        /* Scan for any remaining references to this namespace */
+        for (tmp = cur->parent; tmp != NULL; tmp = tmp->parent) {
+            if (tmp->nsDef == cur->nsDef) {
+                ns_referenced = 1;
+                break;
+            }
+        }
+        
+        if (!ns_referenced) {
+            xmlFreeNsList(cur->nsDef);
+        }
+    }
