diff --git a/parser.c b/parser.c
index 11bb5199..32cbbde0 100644
--- a/parser.c
+++ b/parser.c
@@ -7501,0 +7502,14 @@ xmlParseReference(xmlParserCtxtPtr ctxt) {
+		    if (cur->type == XML_ELEMENT_NODE || cur->type == XML_ATTRIBUTE_NODE) {
+		        xmlNsPtr ns = cur->nsDef;
+		        while (ns != NULL) {
+		            if (ns->type != XML_LOCAL_NAMESPACE && ns->type != XML_GLOBAL_NAMESPACE) {
+		                ns = NULL;
+		                break;
+		            }
+		            ns = ns->next;
+		        }
+		        if (ns == NULL && cur->nsDef != NULL) {
+		            cur = cur->next;
+		            continue;
+		        }
+		    }
