diff --git a/tree.c b/tree.c
index fe02b414..2392d94f 100644
--- a/tree.c
+++ b/tree.c
@@ -811,3 +810,0 @@ xmlSetNs(xmlNodePtr node, xmlNsPtr ns) {
- *
- * Free up the structures associated to a namespace
- */
@@ -822,11 +819 @@ xmlFreeNs(xmlNsPtr cur) {
-}
-
-/**
- * xmlFreeNsList:
- * @cur:  the first namespace pointer
- *
- * Free up all the structures associated to the chained namespaces.
- */
-void
-xmlFreeNsList(xmlNsPtr cur) {
-    xmlNsPtr next;
+}    xmlNsPtr next;
diff --git a/parser.c b/parser.c
index 11bb5199..6a402afa 100644
--- a/parser.c
+++ b/parser.c
@@ -11778,4 +11778,23 @@ xmlParseTryOrFinish(xmlParserCtxtPtr ctxt, int terminate) {
-		} else if (cur == '&') {
-		    if ((!terminate) && (!xmlParseLookupChar(ctxt, ';')))
-			goto done;
-		    xmlParseReference(ctxt);
+		} else         if (cur == '&') {
+// Add safety check for namespace validity before parsing references
+                    int safe_to_parse = 1;
+                    if (ctxt->node && ctxt->node->nsDef) {
+                        // Perform basic sanity check on namespace chain
+                        xmlNsPtr current_ns = ctxt->node->nsDef;
+                        int ns_count = 0;
+                        while (current_ns != NULL && ns_count < 1000) {  // Prevent infinite loop
+                            // Basic pointer validity check using size_t instead of uintptr_t
+                            if ((size_t)current_ns < 4096 || (size_t)current_ns > (size_t)0x7fffffffffffLL) {
+                                safe_to_parse = 0;
+                                break;
+                            }
+                            current_ns = current_ns->next;
+                            ns_count++;
+                        }
+                        if (ns_count >= 1000) safe_to_parse = 0;  // Likely corruption
+                    }
+                    if (safe_to_parse) {
+	        if ((!terminate) && (!xmlParseLookupChar(ctxt, ';')))
+		    goto done;
+	        xmlParseReference(ctxt);
+                    }
