diff --git a/tree.c b/tree.c
index fe02b414..f43b2eb5 100644
--- a/tree.c
+++ b/tree.c
@@ -819,2 +819,12 @@ xmlFreeNs(xmlNsPtr cur) {
-    if (cur->href != NULL) xmlFree((char *) cur->href);
-    if (cur->prefix != NULL) xmlFree((char *) cur->prefix);
+    
+    /* Defensive nulling of pointers to prevent dangling references */
+    if (cur->href != NULL) {
+        xmlFree((char *) cur->href);
+    }
+    if (cur->prefix != NULL) {
+        xmlFree((char *) cur->prefix);
+    }
+    
+    /* Clear all pointers to prevent use-after-free */
+    cur->href = NULL;
+    cur->prefix = NULL;
diff --git a/parser.c b/parser.c
index 11bb5199..c6f9fd10 100644
--- a/parser.c
+++ b/parser.c
@@ -7501,0 +7502,13 @@ xmlParseReference(xmlParserCtxtPtr ctxt) {
+		    xmlNodePtr temp_node = NULL;
+		    
+		    if (cur->nsDef != NULL) {
+		        xmlNsPtr temp_ns = xmlCopyNamespaceList(cur->nsDef);
+		        if (temp_ns == NULL) {
+		            xmlFreeNsList(cur->nsDef);
+		            cur->nsDef = NULL;
+		        } else {
+		            xmlFreeNsList(cur->nsDef);
+		            cur->nsDef = temp_ns;
+		        }
+		    }
+		    
