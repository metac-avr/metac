diff --git a/tree.c b/tree.c
index fe02b414..3ec3ee25 100644
--- a/tree.c
+++ b/tree.c
@@ -819,2 +819,9 @@ xmlFreeNs(xmlNsPtr cur) {
-    if (cur->href != NULL) xmlFree((char *) cur->href);
-    if (cur->prefix != NULL) xmlFree((char *) cur->prefix);
+    
+    /* Set pointers to NULL before freeing to avoid use-after-free */
+    char *href_temp = (char *) cur->href;
+    char *prefix_temp = (char *) cur->prefix;
+    cur->href = NULL;
+    cur->prefix = NULL;
+    
+    if (href_temp != NULL) xmlFree(href_temp);
+    if (prefix_temp != NULL) xmlFree(prefix_temp);
