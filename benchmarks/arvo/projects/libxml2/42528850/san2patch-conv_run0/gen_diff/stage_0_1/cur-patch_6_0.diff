diff --git a/tree.c b/tree.c
index fe02b414..fd9cfec5 100644
--- a/tree.c
+++ b/tree.c
@@ -819,2 +819,10 @@ xmlFreeNs(xmlNsPtr cur) {
-    if (cur->href != NULL) xmlFree((char *) cur->href);
-    if (cur->prefix != NULL) xmlFree((char *) cur->prefix);
+    
+    /* Clear pointers before freeing to prevent use-after-free */
+    if (cur->href != NULL) {
+        xmlFree((char *) cur->href);
+        cur->href = NULL;  /* Prevent dangling pointer */
+    }
+    if (cur->prefix != NULL) {
+        xmlFree((char *) cur->prefix);
+        cur->prefix = NULL;  /* Prevent dangling pointer */
+    }
diff --git a/parser.c b/parser.c
index 11bb5199..97a5c986 100644
--- a/parser.c
+++ b/parser.c
@@ -7501,0 +7502,9 @@ xmlParseReference(xmlParserCtxtPtr ctxt) {
+		    if (cur->nsDef != NULL) {
+		        xmlNsPtr nsCopy = xmlCopyNamespace(cur->nsDef);
+		        if (nsCopy == NULL) {
+		            xmlGenericError(xmlGenericErrorContext, "Failed to copy namespace\n");
+		            return;
+		        }
+		        xmlFreeNsList(cur->nsDef);
+		        cur->nsDef = nsCopy;
+		    }
