diff --git a/xmlreader.c b/xmlreader.c
index c04cb113..3b684ba7 100644
--- a/xmlreader.c
+++ b/xmlreader.c
@@ -420,0 +421 @@ xmlTextReaderFreeNode(xmlTextReaderPtr reader, xmlNodePtr cur) {
+// FIXME: Crash CWE-416: Use After Free - Fixed by delayed cleanup queue
@@ -422,2 +423,15 @@ xmlTextReaderFreeNode(xmlTextReaderPtr reader, xmlNodePtr cur) {
-	(cur->nsDef != NULL))
-	xmlFreeNsList(cur->nsDef);
+	(cur->nsDef != NULL)) {
+        /* Move namespace definitions to delayed cleanup queue instead of immediate freeing */
+        if ((reader != NULL) && (reader->ctxt != NULL)) {
+            /* Add to cleanup queue for later processing */
+            xmlNsPtr ns = cur->nsDef;
+            while (ns != NULL) {
+                ns->next = (xmlNsPtr)reader->ctxt->queuedCleanup;
+                reader->ctxt->queuedCleanup = (void*)ns;
+                ns = ns->next;
+            }
+        } else {
+            /* Fallback to direct freeing when no context available */
+            xmlFreeNsList(cur->nsDef);
+        }
+    }
