diff --git a/tree.c b/tree.c
index fe02b414..88ecd421 100644
--- a/tree.c
+++ b/tree.c
@@ -4202,16 +4202,19 @@ xmlStaticCopyNode(xmlNodePtr node, xmlDocPtr doc, xmlNodePtr parent,
-        xmlNsPtr ns;
-
-	ns = xmlSearchNs(doc, ret, node->ns->prefix);
-	if (ns == NULL) {
-	    /*
-	     * Humm, we are copying an element whose namespace is defined
-	     * out of the new tree scope. Search it in the original tree
-	     * and add it at the top of the new tree
-	     */
-	    ns = xmlSearchNs(node->doc, node, node->ns->prefix);
-	    if (ns != NULL) {
-	        xmlNodePtr root = ret;
-
-		while (root->parent != NULL) root = root->parent;
-		ret->ns = xmlNewNs(root, ns->href, ns->prefix);
-		} else {
+        /* Add safety check to prevent accessing freed namespace */
+        xmlNsPtr ns = NULL;
+        
+        /* Only proceed if node->ns appears to be valid */
+        if (node->ns->href != NULL || node->ns->prefix != NULL) {
+	    ns = xmlSearchNs(doc, ret, node->ns->prefix);
+	    if (ns == NULL) {
+	        /*
+	         * Humm, we are copying an element whose namespace is defined
+	         * out of the new tree scope. Search it in the original tree
+	         * and add it at the top of the new tree
+	         */
+	        ns = xmlSearchNs(node->doc, node, node->ns->prefix);
+	        if (ns != NULL) {
+	            xmlNodePtr root = ret;
+
+		    while (root->parent != NULL) root = root->parent;
+		    ret->ns = xmlNewNs(root, ns->href, ns->prefix);
+		    } else {
@@ -4218,0 +4222,6 @@ xmlStaticCopyNode(xmlNodePtr node, xmlDocPtr doc, xmlNodePtr parent,
+	        }
+	    } else {
+	        /*
+	         * reference the existing namespace definition in our own tree.
+	         */
+	        ret->ns = ns;
@@ -4220,6 +4229,4 @@ xmlStaticCopyNode(xmlNodePtr node, xmlDocPtr doc, xmlNodePtr parent,
-	} else {
-	    /*
-	     * reference the existing namespace definition in our own tree.
-	     */
-	    ret->ns = ns;
-	}
+        } else {
+            /* Namespace appears corrupted/invalid, skip setting it */
+            ret->ns = NULL;
+        }
diff --git a/xmlreader.c b/xmlreader.c
index c04cb113..c777a98e 100644
--- a/xmlreader.c
+++ b/xmlreader.c
@@ -422,2 +422,6 @@ xmlTextReaderFreeNode(xmlTextReaderPtr reader, xmlNodePtr cur) {
-	(cur->nsDef != NULL))
-	xmlFreeNsList(cur->nsDef);
+	(cur->nsDef != NULL)) {
+        /* Clear the nsDef pointer before freeing to prevent UAF */
+        xmlNsPtr temp_nsDef = cur->nsDef;
+        cur->nsDef = NULL;
+        xmlFreeNsList(temp_nsDef);
+    }
