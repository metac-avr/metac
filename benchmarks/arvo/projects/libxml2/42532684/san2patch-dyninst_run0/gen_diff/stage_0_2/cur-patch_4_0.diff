+         return(-1);
@@ -2745,2 +2750,5 @@ xmlRemoveID(xmlDocPtr doc, xmlAttrPtr attr) {
-    if (xmlHashRemoveEntry(table, attr->id->value, xmlFreeIDTableEntry) < 0)
-        return(-1);
+    /* Check if the ID entry is still valid before accessing */
+    if (attr->id != NULL && attr->id->value != NULL) {
+        if (xmlHashRemoveEntry(table, attr->id->value, xmlFreeIDTableEntry) < 0)
+            return(-1);
+    }
