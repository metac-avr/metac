+    /* Nullify pointers before freeing to avoid dangling references */
+    if (id->value != NULL) {
+	DICT_FREE(id->value);
+        id->value = NULL;
+    }
+    if (id->name != NULL) {
+	DICT_FREE(id->name);
+        id->name = NULL;
+    }
@@ -2743 +2748 @@ xmlRemoveID(xmlDocPtr doc, xmlAttrPtr attr) {
