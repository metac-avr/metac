diff --git a/valid.c b/valid.c
index 1ecc762c..fc5a7160 100644
--- a/valid.c
+++ b/valid.c
@@ -2499,4 +2499,9 @@ xmlFreeID(xmlIDPtr id) {
-    if (id->value != NULL)
-	DICT_FREE(id->value)
-    if (id->name != NULL)
