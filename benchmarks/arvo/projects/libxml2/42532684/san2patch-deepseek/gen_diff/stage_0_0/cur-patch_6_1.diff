@@ -2636,8 +2635,0 @@ xmlAddID(xmlValidCtxtPtr ctxt, xmlDocPtr doc, const xmlChar *value,
-                            "ID %s already defined\n", value, NULL, NULL);
-        }
-    }
-#endif /* LIBXML_VALID_ENABLED */
-
-    return(id);
-}
-
@@ -2646,2 +2638 @@ xmlFreeIDTableEntry(void *id, const xmlChar *name ATTRIBUTE_UNUSED) {
-    xmlFreeID((xmlIDPtr) id);
-}
+    xmlIDPtr idPtr = (xmlIDPtr) id;
@@ -2649,9 +2640,11 @@ xmlFreeIDTableEntry(void *id, const xmlChar *name ATTRIBUTE_UNUSED) {
-/**
- * xmlFreeIDTable:
- * @table:  An id table
- *
- * Deallocate the memory used by an ID hash table.
- */
-void
-xmlFreeIDTable(xmlIDTablePtr table) {
-    xmlHashFree(table, xmlFreeIDTableEntry);
+    if (idPtr == NULL)
+        return;
+
+    /*
+     * Don't try to manipulate the document or hash table here.
