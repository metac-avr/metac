diff --git a/parser.c b/parser.c
index cae2b7fd..7b2ec2b0 100644
--- a/parser.c
+++ b/parser.c
@@ -11625,0 +11626 @@ xmlParseTryOrFinish(xmlParserCtxtPtr ctxt, int terminate) {
+// FIXME: Crash CWE-416: Use After Free
@@ -11628 +11629,11 @@ xmlParseTryOrFinish(xmlParserCtxtPtr ctxt, int terminate) {
-		    xmlParseReference(ctxt);
+		    /* Prevent use-after-free by checking node and namespace validity */
+		    if (ctxt->node && ctxt->node->doc) {
+		        /* Verify that we're not working with freed nodes */
+		        if (((char*)ctxt->node > (char*)0x1000) && 
+		            (ctxt->node->type >= XML_ELEMENT_NODE) && 
+		            (ctxt->node->type <= XML_DTD_NODE)) {
+		            xmlParseReference(ctxt);
+		        }
+		    } else {
+		        xmlParseReference(ctxt);
+		    }
