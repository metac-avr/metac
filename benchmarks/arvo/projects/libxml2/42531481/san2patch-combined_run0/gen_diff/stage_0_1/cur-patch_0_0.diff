diff --git a/tree.c b/tree.c
index 314cf5d5..b192da3a 100644
--- a/tree.c
+++ b/tree.c
@@ -4270,15 +4270,18 @@ xmlStaticCopyNode(xmlNodePtr node, xmlDocPtr doc, xmlNodePtr parent,
-        xmlNsPtr ns;
-
-	ns = xmlSearchNs(doc, ret, node->ns->prefix);
-	if (ns == NULL) {
-	    /*
-	     * Humm, we are copying an element whose namespace is defined
-	     * out of the new tree scope. Search it in the original tree
-	     * and add it at the top of the new tree.
-             *
-             * TODO: Searching the original tree seems unnecessary. We
-             * already have a namespace URI.
-	     */
-	    ns = xmlSearchNs(node->doc, node, node->ns->prefix);
-	    if (ns != NULL) {
-	        xmlNodePtr root = ret;
+        /* Validate namespace pointer before use to prevent UAF */
+        xmlNsPtr ns = NULL;
+        
+        /* Check if the namespace pointer is valid before accessing */
+        if (node->ns != NULL) {
+            ns = xmlSearchNs(doc, ret, node->ns->prefix);
+            if (ns == NULL) {
+                /*
+                 * Humm, we are copying an element whose namespace is defined
+                 * out of the new tree scope. Search it in the original tree
+                 * and add it at the top of the new tree.
+                 *
+                 * TODO: Searching the original tree seems unnecessary. We
+                 * already have a namespace URI.
+                 */
+                ns = xmlSearchNs(node->doc, node, node->ns->prefix);
+                if (ns != NULL) {
+                    xmlNodePtr root = ret;
@@ -4286,2 +4289,7 @@ xmlStaticCopyNode(xmlNodePtr node, xmlDocPtr doc, xmlNodePtr parent,
-		while (root->parent != NULL) root = root->parent;
-		ret->ns = xmlNewNs(root, ns->href, ns->prefix);
+                    while (root->parent != NULL) root = root->parent;
+                    ret->ns = xmlNewNs(root, ns->href, ns->prefix);
+                } else {
+                    ret->ns = xmlNewReconciledNs(doc, ret, node->ns);
+                }
+                if (ret->ns == NULL)
+                    goto error;
@@ -4289,10 +4297,6 @@ xmlStaticCopyNode(xmlNodePtr node, xmlDocPtr doc, xmlNodePtr parent,
-                ret->ns = xmlNewReconciledNs(doc, ret, node->ns);
-	    }
-            if (ret->ns == NULL)
-                goto error;
-	} else {
-	    /*
-	     * reference the existing namespace definition in our own tree.
-	     */
-	    ret->ns = ns;
-	}
+                /*
+                 * reference the existing namespace definition in our own tree.
+                 */
+                ret->ns = ns;
+            }
+        }
diff --git a/xmlreader.c b/xmlreader.c
index d96a2ebc..49eb7d89 100644
--- a/xmlreader.c
+++ b/xmlreader.c
@@ -1346 +1346,13 @@ xmlTextReaderRead(xmlTextReaderPtr reader) {
-                    oldnode = NULL;
+                     oldnode = NULL;
+		/* Validate namespace before unlinking */
+		if (tmp->nsDef != NULL) {
+		    xmlNsPtr ns = tmp->nsDef;
+		    while (ns != NULL) {
+		        if (ns->href == NULL && ns->prefix == NULL) {
+		            /* Skip invalid namespace */
+		            ns = ns->next;
+		            continue;
+		        }
+		        ns = ns->next;
+		    }
+		}
