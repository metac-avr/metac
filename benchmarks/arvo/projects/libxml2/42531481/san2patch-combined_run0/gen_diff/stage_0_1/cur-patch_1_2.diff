diff --git a/tree.c b/tree.c
index 314cf5d5..1d555400 100644
--- a/tree.c
+++ b/tree.c
@@ -4270 +4270,2 @@ xmlStaticCopyNode(xmlNodePtr node, xmlDocPtr doc, xmlNodePtr parent,
-        xmlNsPtr ns;
+        /* Add null check for node->ns to prevent UAF vulnerability */
+        xmlNsPtr ns = NULL;
@@ -4272,13 +4273,15 @@ xmlStaticCopyNode(xmlNodePtr node, xmlDocPtr doc, xmlNodePtr parent,
-	ns = xmlSearchNs(doc, ret, node->ns->prefix);
-	if (ns == NULL) {
-	    /*
-	     * Humm, we are copying an element whose namespace is defined
-	     * out of the new tree scope. Search it in the original tree
-	     * and add it at the top of the new tree.
-             *
-             * TODO: Searching the original tree seems unnecessary. We
-             * already have a namespace URI.
-	     */
-	    ns = xmlSearchNs(node->doc, node, node->ns->prefix);
-	    if (ns != NULL) {
-	        xmlNodePtr root = ret;
+        /* Ensure node->ns is not a dangling pointer before use */
+        if (node->ns != NULL) {
+            ns = xmlSearchNs(doc, ret, node->ns->prefix);
+            if (ns == NULL) {
+                /*
+                 * Humm, we are copying an element whose namespace is defined
+                 * out of the new tree scope. Search it in the original tree
+                 * and add it at the top of the new tree.
+                 *
+                 * TODO: Searching the original tree seems unnecessary. We
+                 * already have a namespace URI.
+                 */
+                ns = xmlSearchNs(node->doc, node, node->ns->prefix);
+                if (ns != NULL) {
+                    xmlNodePtr root = ret;
@@ -4286,2 +4289,7 @@ xmlStaticCopyNode(xmlNodePtr node, xmlDocPtr doc, xmlNodePtr parent,
-		while (root->parent != NULL) root = root->parent;
-		ret->ns = xmlNewNs(root, ns->href, ns->prefix);
+                    while (root->parent != NULL) root = root->parent;
+                    ret->ns = xmlNewNs(root, ns->href, ns->prefix);
+                } else {
+                    ret->ns = xmlNewReconciledNs(doc, ret, node->ns);
+                }
+                if (ret->ns == NULL)
+                    goto error;
@@ -4289,10 +4297,9 @@ xmlStaticCopyNode(xmlNodePtr node, xmlDocPtr doc, xmlNodePtr parent,
-                ret->ns = xmlNewReconciledNs(doc, ret, node->ns);
-	    }
-            if (ret->ns == NULL)
-                goto error;
-	} else {
-	    /*
-	     * reference the existing namespace definition in our own tree.
-	     */
-	    ret->ns = ns;
-	}
+                /*
+                 * reference the existing namespace definition in our own tree.
+                 */
+                ret->ns = ns;
+            }
+        } else {
+            /* Handle case where node->ns is invalid/dangling */
+            ret->ns = NULL;
+        }
