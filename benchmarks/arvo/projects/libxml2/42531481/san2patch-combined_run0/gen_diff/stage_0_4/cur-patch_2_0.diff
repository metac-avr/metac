diff --git a/xmlreader.c b/xmlreader.c
index d96a2ebc..9d1fbb95 100644
--- a/xmlreader.c
+++ b/xmlreader.c
@@ -403,2 +403,15 @@ xmlTextReaderFreeNode(xmlTextReaderPtr reader, xmlNodePtr cur) {
-	(cur->nsDef != NULL))
-	xmlFreeNsList(cur->nsDef);
+	(cur->nsDef != NULL)) {
+        /* Validate namespace references before freeing to prevent expired pointer dereference */
+        xmlNsPtr ns = cur->nsDef;
+        int can_free = 1;
+        
+        /* Simple check: if this is an entity reference, defer freeing */
+        if (cur->type == XML_ENTITY_REF_NODE) {
+            can_free = 0;
+        }
+        
+        if (can_free) {
+            xmlFreeNsList(cur->nsDef);
+        }
+        cur->nsDef = NULL;
+    }
