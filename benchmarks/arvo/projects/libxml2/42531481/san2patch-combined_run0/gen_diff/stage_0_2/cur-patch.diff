-                ret->ns = xmlNewReconciledNs(doc, ret, node->ns);
+// Fixed CWE-416: Use After Free - Validate namespace before use
+         xmlNsPtr ns = NULL;
+
+	if (node->ns != NULL) {
+	    ns = xmlSearchNs(doc, ret, node->ns->prefix);
+	    if (ns == NULL) {
+	        /*
+	         * Humm, we are copying an element whose namespace is defined
+	         * out of the new tree scope. Search it in the original tree
+	         * and add it at the top of the new tree.
+                 *
+                 * TODO: Searching the original tree seems unnecessary. We
+                 * already have a namespace URI.
+	         */
+	        if (node->doc != NULL && node->ns->prefix != NULL) {
+	            ns = xmlSearchNs(node->doc, node, node->ns->prefix);
+	        }
+	        if (ns != NULL) {
+	            xmlNodePtr root = ret;
+
+		    while (root->parent != NULL) root = root->parent;
+		    ret->ns = xmlNewNs(root, ns->href, ns->prefix);
+                } else {
+                    ret->ns = xmlNewReconciledNs(doc, ret, node->ns);
+	        }
+                if (ret->ns == NULL)
+                    goto error;
+	    } else {
+	        /*
+	         * reference the existing namespace definition in our own tree.
+	         */
+	        ret->ns = ns;
@@ -4291,7 +4302,0 @@ xmlStaticCopyNode(xmlNodePtr node, xmlDocPtr doc, xmlNodePtr parent,
-            if (ret->ns == NULL)
-                goto error;
-	} else {
-	    /*
-	     * reference the existing namespace definition in our own tree.
-	     */
-	    ret->ns = ns;
diff --git a/xmlreader.c b/xmlreader.c
index d96a2ebc..a67f62fb 100644
--- a/xmlreader.c
+++ b/xmlreader.c
@@ -1346 +1346,15 @@ xmlTextReaderRead(xmlTextReaderPtr reader) {
-                    oldnode = NULL;
+                     oldnode = NULL;
+		/* Break circular references and nullify namespace pointers */
+		if (tmp->nsDef != NULL) {
+		    xmlNsPtr ns = tmp->nsDef;
+		    while (ns != NULL) {
+		        xmlNsPtr next_ns = ns->next;
+		        ns->next = NULL;
+		        ns->context = NULL;
+		        ns->href = NULL;
+		        ns->prefix = NULL;
+		        ns = next_ns;
+		    }
+		}
+		tmp->nsDef = NULL;
+		tmp->ns = NULL;
