diff --git a/tree.c b/tree.c
index 314cf5d5..63f0c1e2 100644
--- a/tree.c
+++ b/tree.c
@@ -4452,6 +4451,0 @@ xmlCopyNode(xmlNodePtr node, int extended) {
- *		if 2 copy properties and namespaces (when applicable)
- *
- * Do a copy of the node to a given document.
- *
- * Returns: a new #xmlNodePtr, or NULL in case of error.
- */
@@ -4462,0 +4457,9 @@ xmlDocCopyNode(xmlNodePtr node, xmlDocPtr doc, int extended) {
+    if (ret != NULL) {
+        ret->ns = NULL;
+        if (node->ns != NULL)
+            ret->ns = xmlCopyNamespaceList(node->ns);
+        if ((node->ns != NULL) && (ret->ns == NULL)) {
+            xmlFreeNode(ret);
+            return(NULL);
+        }
+    }
@@ -4466,8 +4469,40 @@ xmlDocCopyNode(xmlNodePtr node, xmlDocPtr doc, int extended) {
-/**
- * xmlDocCopyNodeList:
- * @doc: the target document
- * @node:  the first node in the list.
- *
- * Do a recursive copy of the node list.
- *
- * Returns: a new #xmlNodePtr, or NULL in case of error.
+xmlNodePtr
+xmlDocCopyNodeList(xmlDocPtr doc, xmlNodePtr node) {
+    xmlNodePtr ret = NULL;
+    xmlNodePtr cur = NULL;
+
+    if (node == NULL)
+        return(NULL);
+
+    if ((node->type == XML_DOCUMENT_NODE) ||
+        (node->type == XML_HTML_DOCUMENT_NODE))
+        return(NULL);
+
+    cur = node;
+    while (cur != NULL) {
+        xmlNodePtr copy = xmlDocCopyNode(cur, doc, 1);
+        if (copy == NULL) {
+            xmlFreeNodeList(ret);
+            return(NULL);
+        }
+
+        if (ret == NULL)
+            ret = copy;
+        else
+            xmlAddSibling(ret, copy);
+
+        if (cur->children != NULL) {
+            xmlNodePtr subret = xmlDocCopyNodeList(doc, cur->children);
+            if (subret == NULL) {
+                xmlFreeNodeList(ret);
+                return(NULL);
+            }
+            copy->children = subret;
+            subret->parent = copy;
+        }
+
+        cur = cur->next;
+    }
+
+    return(ret);
+} * Returns: a new #xmlNodePtr, or NULL in case of error.
