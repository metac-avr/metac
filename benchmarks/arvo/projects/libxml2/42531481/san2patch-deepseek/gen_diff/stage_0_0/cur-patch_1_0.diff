-	xmlFreeNsList(cur->nsDef);
+ 	 (cur->type == XML_XINCLUDE_END)) &&
+	(cur->nsDef != NULL)) {
+	xmlNsPtr tmp = cur->nsDef;
+	cur->nsDef = NULL;
+	xmlFreeNsList(tmp);
+    }
