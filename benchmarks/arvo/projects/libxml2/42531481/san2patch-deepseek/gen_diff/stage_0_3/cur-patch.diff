diff --git a/xmlreader.c b/xmlreader.c
index d96a2ebc..70c9d5fb 100644
--- a/xmlreader.c
+++ b/xmlreader.c
@@ -1346,3 +1346,8 @@ xmlTextReaderRead(xmlTextReaderPtr reader) {
-                    oldnode = NULL;
-		xmlUnlinkNode(tmp);
-		xmlTextReaderFreeNode(reader, tmp);
+                     oldnode = NULL;
+		if (tmp->ns != NULL && tmp->doc != NULL && tmp->doc->oldNs != NULL) {
+		    xmlUnlinkNode(tmp);
+		    xmlTextReaderFreeNode(reader, tmp);
+		} else if (tmp->ns == NULL) {
+		    xmlUnlinkNode(tmp);
+		    xmlTextReaderFreeNode(reader, tmp);
+		}
