diff --git a/xmlreader.c b/xmlreader.c
index d96a2ebc..712c8306 100644
--- a/xmlreader.c
+++ b/xmlreader.c
@@ -403,2 +403,13 @@ xmlTextReaderFreeNode(xmlTextReaderPtr reader, xmlNodePtr cur) {
-	(cur->nsDef != NULL))
-	xmlFreeNsList(cur->nsDef);
+	(cur->nsDef != NULL)) {
+	/*
+	 * Do not free namespace definitions here. Namespace nodes may still be
+	 * referenced from nodes copied during entity/reference expansion.
+	 * Ownership of the namespace list is transferred to the reader context,
+	 * which lives longer than the transient reader node.
+	 */
+	if ((reader != NULL) && (reader->ctxt != NULL)) {
+	    cur->nsDef->next = reader->ctxt->nodeInfo[0].nsDef;
+	    reader->ctxt->nodeInfo[0].nsDef = cur->nsDef;
+	    cur->nsDef = NULL;
+	}
+    }
