@@ -4461,0 +4456,18 @@ xmlDocCopyNode(xmlNodePtr node, xmlDocPtr doc, int extended) {
+    if (node == NULL)
+        return(NULL);
+
+    if ((node->type == XML_ELEMENT_NODE) && (node->nsDef != NULL)) {
+        if (node->nsDef == (xmlNsPtr) -1) {
+            memset(&node->nsDef, 0, sizeof(xmlNsPtr));
+        }
+        else {
+            xmlNsPtr ns = node->nsDef;
+            while (ns != NULL) {
+                if (ns->next == NULL) {
+                    ns->next = NULL;
+                }
+                ns = ns->next;
+            }
+        }
+    }
