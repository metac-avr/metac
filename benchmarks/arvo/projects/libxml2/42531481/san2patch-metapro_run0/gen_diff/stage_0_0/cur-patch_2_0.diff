diff --git a/tree.c b/tree.c
index 314cf5d5..4870ea58 100644
--- a/tree.c
+++ b/tree.c
@@ -4270 +4270 @@ xmlStaticCopyNode(xmlNodePtr node, xmlDocPtr doc, xmlNodePtr parent,
-        xmlNsPtr ns;
+         xmlNsPtr ns;
@@ -4299,0 +4300,8 @@ xmlStaticCopyNode(xmlNodePtr node, xmlDocPtr doc, xmlNodePtr parent,
+    
+    /* Additional safety check to prevent use-after-free */
+    if ((node->type == XML_ELEMENT_NODE) && (ret->ns != NULL)) {
+        /* Verify namespace pointer is valid before proceeding */
+        if (ret->ns->type != XML_LOCAL_NAMESPACE && ret->ns->type != XML_GLOBAL_NAMESPACE) {
+            ret->ns = NULL;
+        }
+    }
diff --git a/xmlreader.c b/xmlreader.c
index d96a2ebc..06a5780f 100644
--- a/xmlreader.c
+++ b/xmlreader.c
@@ -401,0 +402 @@ xmlTextReaderFreeNode(xmlTextReaderPtr reader, xmlNodePtr cur) {
+// FIXME: Crash CWE-416: Use After Free - Fixed by clearing reference before free
@@ -403,2 +404,4 @@ xmlTextReaderFreeNode(xmlTextReaderPtr reader, xmlNodePtr cur) {
-	(cur->nsDef != NULL))
-	xmlFreeNsList(cur->nsDef);
+	(cur->nsDef != NULL)) {
+        cur->nsDef = NULL; /* Prevent dangling pointer by clearing reference */
+        xmlFreeNsList(cur->nsDef);
+    }
