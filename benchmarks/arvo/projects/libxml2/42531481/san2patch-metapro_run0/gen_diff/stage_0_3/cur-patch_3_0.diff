diff --git a/parser.c b/parser.c
index cae2b7fd..27ef73c8 100644
--- a/parser.c
+++ b/parser.c
@@ -7372,0 +7373,12 @@ xmlParseReference(xmlParserCtxtPtr ctxt) {
+		    /* Check if current node's namespace is valid before copying */
+		    if (cur->nsDef != NULL) {
+		        xmlNsPtr ns = cur->nsDef;
+		        while (ns != NULL) {
+		            if (ns->_private == NULL) {
+		                /* Skip nodes with invalid/deallocated namespaces */
+		                cur = cur->next;
+		                continue;
+		            }
+		            ns = ns->next;
+		        }
+		    }
