diff --git a/xmlreader.c b/xmlreader.c
index d96a2ebc..d9f65046 100644
--- a/xmlreader.c
+++ b/xmlreader.c
@@ -1346 +1346,13 @@ xmlTextReaderRead(xmlTextReaderPtr reader) {
-                    oldnode = NULL;
+                     oldnode = NULL;
+	        /* Clear namespace references before freeing */
+                if (tmp->nsDef != NULL) {
+                    xmlNsPtr ns, next;
+                    for (ns = tmp->nsDef; ns != NULL; ns = next) {
+                        next = ns->next;
+                        ns->next = NULL;
+                    }
+                    tmp->nsDef = NULL;
+                }
+                if (tmp->ns != NULL) {
+                    tmp->ns = NULL;
+                }
