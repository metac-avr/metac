diff --git a/tree.c b/tree.c
index 314cf5d5..2a342a11 100644
--- a/tree.c
+++ b/tree.c
@@ -4270,20 +4270,31 @@ xmlStaticCopyNode(xmlNodePtr node, xmlDocPtr doc, xmlNodePtr parent,
-        xmlNsPtr ns;
-
-	ns = xmlSearchNs(doc, ret, node->ns->prefix);
-	if (ns == NULL) {
-	    /*
-	     * Humm, we are copying an element whose namespace is defined
-	     * out of the new tree scope. Search it in the original tree
-	     * and add it at the top of the new tree.
-             *
-             * TODO: Searching the original tree seems unnecessary. We
-             * already have a namespace URI.
-	     */
-	    ns = xmlSearchNs(node->doc, node, node->ns->prefix);
-	    if (ns != NULL) {
-	        xmlNodePtr root = ret;
-
-		while (root->parent != NULL) root = root->parent;
-		ret->ns = xmlNewNs(root, ns->href, ns->prefix);
-            } else {
-                ret->ns = xmlNewReconciledNs(doc, ret, node->ns);
+// FIXME: Crash CWE-825: Expired Pointer Dereference
+         xmlNsPtr ns;
+
+	/* Check if namespace pointer is valid before dereferencing */
+	if ((node->ns->prefix != NULL) && (node->ns->href != NULL)) {
+	    ns = xmlSearchNs(doc, ret, node->ns->prefix);
+	    if (ns == NULL) {
+	        /*
+	         * Humm, we are copying an element whose namespace is defined
+	         * out of the new tree scope. Search it in the original tree
+	         * and add it at the top of the new tree.
+                 *
+                 * TODO: Searching the original tree seems unnecessary. We
+                 * already have a namespace URI.
+	         */
+	        ns = xmlSearchNs(node->doc, node, node->ns->prefix);
+	        if (ns != NULL) {
+	            xmlNodePtr root = ret;
+
+		    while (root->parent != NULL) root = root->parent;
+		    ret->ns = xmlNewNs(root, ns->href, ns->prefix);
+                } else {
+                    ret->ns = xmlNewReconciledNs(doc, ret, node->ns);
+	        }
+                if (ret->ns == NULL)
+                    goto error;
+	    } else {
+	        /*
+	         * reference the existing namespace definition in our own tree.
+	         */
+	        ret->ns = ns;
@@ -4291,2 +4301,0 @@ xmlStaticCopyNode(xmlNodePtr node, xmlDocPtr doc, xmlNodePtr parent,
-            if (ret->ns == NULL)
-                goto error;
@@ -4294,4 +4303,2 @@ xmlStaticCopyNode(xmlNodePtr node, xmlDocPtr doc, xmlNodePtr parent,
-	    /*
-	     * reference the existing namespace definition in our own tree.
-	     */
-	    ret->ns = ns;
+	    /* Invalid namespace, set to NULL to avoid use-after-free */
+	    ret->ns = NULL;
diff --git a/xmlreader.c b/xmlreader.c
index d96a2ebc..1a530a7e 100644
--- a/xmlreader.c
+++ b/xmlreader.c
@@ -1346 +1346,13 @@ xmlTextReaderRead(xmlTextReaderPtr reader) {
-                    oldnode = NULL;
+                     oldnode = NULL;
+		/* Clear namespace references before freeing */
+		if (tmp->nsDef != NULL) {
+		    xmlNsPtr ns = tmp->nsDef;
+		    while (ns != NULL) {
+		        ns->next = NULL;
+		        ns = ns->next;
+		    }
+		    tmp->nsDef = NULL;
+		}
+		if (tmp->ns != NULL) {
+		    tmp->ns = NULL;
+		}
