diff --git a/tree.c b/tree.c
index 314cf5d5..85bb7e05 100644
--- a/tree.c
+++ b/tree.c
@@ -4270 +4270,2 @@ xmlStaticCopyNode(xmlNodePtr node, xmlDocPtr doc, xmlNodePtr parent,
-        xmlNsPtr ns;
+// FIXME: Crash CWE-825: Expired Pointer Dereference
+         xmlNsPtr ns;
@@ -4272,21 +4273,4 @@ xmlStaticCopyNode(xmlNodePtr node, xmlDocPtr doc, xmlNodePtr parent,
-	ns = xmlSearchNs(doc, ret, node->ns->prefix);
-	if (ns == NULL) {
-	    /*
-	     * Humm, we are copying an element whose namespace is defined
-	     * out of the new tree scope. Search it in the original tree
-	     * and add it at the top of the new tree.
-             *
-             * TODO: Searching the original tree seems unnecessary. We
-             * already have a namespace URI.
-	     */
-	    ns = xmlSearchNs(node->doc, node, node->ns->prefix);
-	    if (ns != NULL) {
-	        xmlNodePtr root = ret;
-
-		while (root->parent != NULL) root = root->parent;
-		ret->ns = xmlNewNs(root, ns->href, ns->prefix);
-            } else {
-                ret->ns = xmlNewReconciledNs(doc, ret, node->ns);
-	    }
-            if (ret->ns == NULL)
-                goto error;
+	/* Validate that the namespace pointer is still valid before accessing */
+	if (xmlIsDeadNs(node->doc, node->ns) || xmlIsDeadNs(doc, node->ns)) {
+	    /* Namespace is invalid/expired, skip namespace processing */
+	    ret->ns = NULL;
@@ -4294,4 +4278,27 @@ xmlStaticCopyNode(xmlNodePtr node, xmlDocPtr doc, xmlNodePtr parent,
-	    /*
-	     * reference the existing namespace definition in our own tree.
-	     */
-	    ret->ns = ns;
+	    ns = xmlSearchNs(doc, ret, node->ns->prefix);
+	    if (ns == NULL) {
+	        /*
+	         * Humm, we are copying an element whose namespace is defined
+	         * out of the new tree scope. Search it in the original tree
+	         * and add it at the top of the new tree.
+                 *
+                 * TODO: Searching the original tree seems unnecessary. We
+                 * already have a namespace URI.
+	         */
+	        ns = xmlSearchNs(node->doc, node, node->ns->prefix);
+	        if (ns != NULL) {
+	            xmlNodePtr root = ret;
+
+		    while (root->parent != NULL) root = root->parent;
+		    ret->ns = xmlNewNs(root, ns->href, ns->prefix);
+                } else {
+                    ret->ns = xmlNewReconciledNs(doc, ret, node->ns);
+	        }
+                if (ret->ns == NULL)
+                    goto error;
+	    } else {
+	        /*
+	         * reference the existing namespace definition in our own tree.
+	         */
+	        ret->ns = ns;
+	    }
