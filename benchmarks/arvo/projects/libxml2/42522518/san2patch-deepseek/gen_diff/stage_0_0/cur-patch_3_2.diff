@@ -5360,7 +5360,7 @@ xmlParseEntityDecl(xmlParserCtxtPtr ctxt) {
-	int inputid = ctxt->input->id;
-	SHRINK;
-	SKIP(6);
-	if (SKIP_BLANKS == 0) {
-	    xmlFatalErrMsg(ctxt, XML_ERR_SPACE_REQUIRED,
