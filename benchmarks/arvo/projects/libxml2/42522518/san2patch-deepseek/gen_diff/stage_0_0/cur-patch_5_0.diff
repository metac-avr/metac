diff --git a/parser.c b/parser.c
index f69231d5..6319d1bb 100644
--- a/parser.c
+++ b/parser.c
@@ -5373,0 +5374,13 @@ xmlParseEntityDecl(xmlParserCtxtPtr ctxt) {
+	}
+	/*
+	 * Ensure that the current input remains valid and that the next
+	 * character is not the end of the buffer.  Advancing past an empty
+	 * entity name would read globals out of bounds, so stop here with
+	 * a fatal error for a missing name.
+	 */
+	if ((ctxt->input->id == inputid) &&
+	    (ctxt->input->cur >= ctxt->input->end)) {
+	    xmlFatalErr(ctxt, XML_ERR_NAME_REQUIRED, NULL);
+	    return;
+	}
+	    }
