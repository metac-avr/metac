diff --git a/tree.c b/tree.c
index 7ffdebf2..9049a0f8 100644
--- a/tree.c
+++ b/tree.c
@@ -3635,0 +3636,3 @@ xmlFreeNodeList(xmlNodePtr cur) {
+	    
+	    /* Set sentinel value to detect use-after-free */
+	    cur->doc = (xmlDocPtr) 0xdeadbeef;
@@ -6882,4 +6885,8 @@ xmlSetNsProp(xmlNodePtr node, xmlNsPtr ns, const xmlChar *name,
-	if (prop->children != NULL)
-	    xmlFreeNodeList(prop->children);
-	prop->children = NULL;
-	prop->last = NULL;
+	/* Set children pointers to NULL before freeing to prevent dangling references */
+	{
+	    xmlNodePtr old_children = prop->children;
+	    prop->children = NULL;
+	    prop->last = NULL;
+	    if (old_children != NULL)
+	        xmlFreeNodeList(old_children);
+	}
