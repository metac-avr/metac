diff --git a/tree.c b/tree.c
index 7ffdebf2..0f158f81 100644
--- a/tree.c
+++ b/tree.c
@@ -3635,0 +3636,3 @@ xmlFreeNodeList(xmlNodePtr cur) {
+	    
+	    /* Prevent use-after-free by clearing all node references */
+	    cur->parent = NULL; cur->children = NULL; cur->next = NULL; cur->prev = NULL;
@@ -6835,2 +6838,11 @@ xmlSetProp(xmlNodePtr node, const xmlChar *name, const xmlChar *value) {
-        if (ns != NULL)
-            return(xmlSetNsProp(node, ns, localname, value));
+        if (ns != NULL) {
+            xmlAttrPtr result = xmlSetNsProp(node, ns, localname, value);
+            if (result != NULL && result->children) {
+                xmlNodePtr child = result->children;
+                while (child) {
+                    child->parent = result;
+                    child = child->next;
+                }
+            }
+            return(result);
+        }
@@ -6839 +6851,9 @@ xmlSetProp(xmlNodePtr node, const xmlChar *name, const xmlChar *value) {
-    return(xmlSetNsProp(node, NULL, name, value));
+    xmlAttrPtr result = xmlSetNsProp(node, NULL, name, value);
+    if (result != NULL && result->children) {
+        xmlNodePtr child = result->children;
+        while (child) {
+            child->parent = result;
+            child = child->next;
+        }
+    }
+    return(result);
