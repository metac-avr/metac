diff --git a/tree.c b/tree.c
index 7ffdebf2..2398e8e4 100644
--- a/tree.c
+++ b/tree.c
@@ -3635,0 +3636,7 @@ xmlFreeNodeList(xmlNodePtr cur) {
+	    
+	    /* Clear references to prevent use-after-free */
+	    cur->parent = NULL;
+	    cur->children = NULL;
+	    cur->next = NULL;
+	    cur->prev = NULL;
+	    
@@ -6835,2 +6842,9 @@ xmlSetProp(xmlNodePtr node, const xmlChar *name, const xmlChar *value) {
-        if (ns != NULL)
-            return(xmlSetNsProp(node, ns, localname, value));
+        if (ns != NULL) {
+            xmlAttrPtr ret = xmlSetNsProp(node, ns, localname, value);
+            if (ret != NULL && ret->children != NULL) {
+                ret->children->parent = NULL;
+                ret->children->next = NULL;
+                ret->children->prev = NULL;
+            }
+            return(ret);
+        }
@@ -6839 +6853,7 @@ xmlSetProp(xmlNodePtr node, const xmlChar *name, const xmlChar *value) {
-    return(xmlSetNsProp(node, NULL, name, value));
+    xmlAttrPtr ret = xmlSetNsProp(node, NULL, name, value);
+    if (ret != NULL && ret->children != NULL) {
+        ret->children->parent = NULL;
+        ret->children->next = NULL;
+        ret->children->prev = NULL;
+    }
+    return(ret);
