diff --git a/tree.c b/tree.c
index 7ffdebf2..f39ffe7f 100644
--- a/tree.c
+++ b/tree.c
@@ -6818,0 +6819 @@ xmlSetProp(xmlNodePtr node, const xmlChar *name, const xmlChar *value) {
+    xmlAttrPtr prop;
@@ -6835,2 +6836,15 @@ xmlSetProp(xmlNodePtr node, const xmlChar *name, const xmlChar *value) {
-        if (ns != NULL)
-            return(xmlSetNsProp(node, ns, localname, value));
+        if (ns != NULL) {
+            prop = xmlSetNsProp(node, ns, localname, value);
+            if (prop != NULL) {
+                xmlAttrPtr old = node->properties;
+                while (old != NULL) {
+                    if ((old->ns == ns) && (xmlStrEqual(old->name, localname))) {
+                        xmlUnlinkNode((xmlNodePtr) old);
+                        xmlFreeProp(old);
+                        break;
+                    }
+                    old = old->next;
+                }
+            }
+            return(prop);
+        }
