diff --git a/tree.c b/tree.c
index 7ffdebf2..30a8a3d9 100644
--- a/tree.c
+++ b/tree.c
@@ -6835,2 +6835,15 @@ xmlSetProp(xmlNodePtr node, const xmlChar *name, const xmlChar *value) {
-        if (ns != NULL)
-            return(xmlSetNsProp(node, ns, localname, value));
+        if (ns != NULL) {
+	    xmlAttrPtr result = xmlSetNsProp(node, ns, localname, value);
