@@ -6835,2 +6835,21 @@ xmlSetProp(xmlNodePtr node, const xmlChar *name, const xmlChar *value) {
-        if (ns != NULL)
-            return(xmlSetNsProp(node, ns, localname, value));
+        if (ns != NULL) {
+	    xmlAttrPtr result = xmlSetNsProp(node, ns, localname, value);
