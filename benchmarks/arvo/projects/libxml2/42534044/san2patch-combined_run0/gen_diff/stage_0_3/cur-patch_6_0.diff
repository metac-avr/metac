diff --git a/tree.c b/tree.c
index 7ffdebf2..a8d336fa 100644
--- a/tree.c
+++ b/tree.c
@@ -3635,0 +3636,7 @@ xmlFreeNodeList(xmlNodePtr cur) {
+	    
+	    /* Clear pointers to prevent use-after-free */
+	    cur->properties = NULL;
+	    cur->nsDef = NULL;
+	    cur->content = NULL;
+	    cur->name = NULL;
+	    
@@ -6835,2 +6842,14 @@ xmlSetProp(xmlNodePtr node, const xmlChar *name, const xmlChar *value) {
-        if (ns != NULL)
-            return(xmlSetNsProp(node, ns, localname, value));
+        if (ns != NULL) {
+            xmlAttrPtr ret = xmlSetNsProp(node, ns, localname, value);
+            /* Clear any potentially dangling references */
+            if (node->properties != NULL && node->properties->children != NULL) {
+                xmlNodePtr child = node->properties->children;
+                while (child != NULL) {
+                    if (child->type == XML_TEXT_NODE && child->content == NULL) {
+                        child->content = (xmlChar*)"";
+                    }
+                    child = child->next;
+                }
+            }
+            return(ret);
+        }
@@ -6839 +6858,12 @@ xmlSetProp(xmlNodePtr node, const xmlChar *name, const xmlChar *value) {
-    return(xmlSetNsProp(node, NULL, name, value));
+    xmlAttrPtr ret = xmlSetNsProp(node, NULL, name, value);
+    /* Clear any potentially dangling references */
+    if (node->properties != NULL && node->properties->children != NULL) {
+        xmlNodePtr child = node->properties->children;
+        while (child != NULL) {
+            if (child->type == XML_TEXT_NODE && child->content == NULL) {
+                child->content = (xmlChar*)"";
+            }
+            child = child->next;
+        }
+    }
+    return(ret);
