diff --git a/tree.c b/tree.c
index 7ffdebf2..2d77d549 100644
--- a/tree.c
+++ b/tree.c
@@ -3607,0 +3608,3 @@ xmlFreeNodeList(xmlNodePtr cur) {
+	    /* Store parent reference before freeing children */
+	    xmlNodePtr parent = cur->parent;
+	    
@@ -3635,0 +3639,8 @@ xmlFreeNodeList(xmlNodePtr cur) {
+	    
+	    /* Clean up node relationships to prevent dangling pointers */
+	    if (parent != NULL && parent->children == cur) {
+	        parent->children = cur->next;
+	    }
+	    if (cur->next) cur->next->prev = cur->prev;
+	    if (cur->prev) cur->prev->next = cur->next;
+	    
@@ -6835,2 +6846,6 @@ xmlSetProp(xmlNodePtr node, const xmlChar *name, const xmlChar *value) {
-        if (ns != NULL)
-            return(xmlSetNsProp(node, ns, localname, value));
+        if (ns != NULL) {
+            xmlAttrPtr prop_result = xmlSetNsProp(node, ns, localname, value);
+            /* Sanitize node references to prevent use-after-free */
+            if (node->psvi != NULL) node->psvi = NULL;
+            return(prop_result);
+        }
@@ -6839 +6854,4 @@ xmlSetProp(xmlNodePtr node, const xmlChar *name, const xmlChar *value) {
-    return(xmlSetNsProp(node, NULL, name, value));
+    xmlAttrPtr prop_result = xmlSetNsProp(node, NULL, name, value);
+    /* Sanitize node references to prevent use-after-free */
+    if (node->psvi != NULL) node->psvi = NULL;
+    return(prop_result);
