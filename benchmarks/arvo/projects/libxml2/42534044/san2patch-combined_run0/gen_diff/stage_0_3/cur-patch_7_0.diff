diff --git a/tree.c b/tree.c
index 7ffdebf2..914e3676 100644
--- a/tree.c
+++ b/tree.c
@@ -3607,0 +3608,2 @@ xmlFreeNodeList(xmlNodePtr cur) {
+	    xmlNodePtr next_sibling = cur->next;
+	    
@@ -3635,0 +3638,6 @@ xmlFreeNodeList(xmlNodePtr cur) {
+	    
+	    /* Nullify current node pointers before freeing */
+	    cur->next = NULL;
+	    cur->prev = NULL;
+	    cur->parent = NULL;
+	    
@@ -3636,0 +3645,5 @@ xmlFreeNodeList(xmlNodePtr cur) {
+	    
