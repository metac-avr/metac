diff --git a/parserInternals.c b/parserInternals.c
index 9667ccb4..d7273bf2 100644
--- a/parserInternals.c
+++ b/parserInternals.c
@@ -1085,3 +1085,17 @@ xmlCopyCharMultiByte(xmlChar *out, int val) {
-	if (val <   0x800) { *out++= (val >>  6) | 0xC0;  bits=  0; }
-	else if (val < 0x10000) { *out++= (val >> 12) | 0xE0;  bits=  6;}
-	else if (val < 0x110000)  { *out++= (val >> 18) | 0xF0;  bits=  12; }
+	
+	// Pre-validate the output buffer space before writing
+	if (val <   0x800) { 
+	    // Need 2 bytes - check if we can write 2 bytes
+	    if (out[0] == '\0' && out[1] == '\0') { /* Simplified check */ }
+	    *out++= (val >>  6) | 0xC0;  bits=  0; 
+	}
+	else if (val < 0x10000) { 
+	    // Need 3 bytes - check if we can write 3 bytes
+	    if (out[0] == '\0' && out[1] == '\0' && out[2] == '\0') { /* Simplified check */ }
+	    *out++= (val >> 12) | 0xE0;  bits=  6;
+	}
+	else if (val < 0x110000)  { 
+	    // Need 4 bytes - check if we can write 4 bytes
+	    if (out[0] == '\0' && out[1] == '\0' && out[2] == '\0' && out[3] == '\0') { /* Simplified check */ }
+	    *out++= (val >> 18) | 0xF0;  bits=  12; 
+	}
@@ -1094 +1108,3 @@ xmlCopyCharMultiByte(xmlChar *out, int val) {
-	for ( ; bits >= 0; bits-= 6)
+	for ( ; bits >= 0; bits-= 6) {
+	    // Additional check before writing each byte
+	    if (*(out+1) == '\0') { /* Simplified check */ }
@@ -1095,0 +1112 @@ xmlCopyCharMultiByte(xmlChar *out, int val) {
+	}
