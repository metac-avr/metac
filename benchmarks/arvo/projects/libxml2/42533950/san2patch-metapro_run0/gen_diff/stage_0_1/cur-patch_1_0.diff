diff --git a/tree.c b/tree.c
index 7ffdebf2..0af3f07a 100644
--- a/tree.c
+++ b/tree.c
@@ -3936 +3936 @@ xmlCopyPropInternal(xmlDocPtr doc, xmlNodePtr target, xmlAttrPtr cur) {
-      int res;
+       int res;
@@ -3972 +3972 @@ xmlCopyPropInternal(xmlDocPtr doc, xmlNodePtr target, xmlAttrPtr cur) {
-        if (xmlStrEqual(ns->href, cur->ns->href)) {
+        if ((cur->ns != NULL) && (ns != NULL) && xmlStrEqual(ns->href, cur->ns->href)) {
@@ -3980,3 +3980,7 @@ xmlCopyPropInternal(xmlDocPtr doc, xmlNodePtr target, xmlAttrPtr cur) {
-          ret->ns = xmlNewReconciledNs(target, cur->ns);
-          if (ret->ns == NULL)
-              goto error;
+          if (cur->ns != NULL) {
+            ret->ns = xmlNewReconciledNs(target, cur->ns);
+            if (ret->ns == NULL)
+                goto error;
