+        /* Check if namespace is still valid before copying properties */
+        xmlAttrPtr prop = node->properties;
+        int valid_ns = 1;
+        while (prop != NULL) {
+            if (prop->ns != NULL && prop->ns->href == NULL) {
+                valid_ns = 0;
+                break;
+            }
+            prop = prop->next;
+        }
+        if (valid_ns) {
+            ret->properties = xmlCopyPropList(ret, node->properties);
+            if (ret->properties == NULL)
+                goto error;
+        }
