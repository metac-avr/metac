diff --git a/tree.c b/tree.c
index 7ffdebf2..338e3043 100644
--- a/tree.c
+++ b/tree.c
@@ -4415,6 +4414,0 @@ xmlStaticCopyNodeList(xmlNodePtr node, xmlDocPtr doc, xmlNodePtr parent) {
- *		if 2 copy properties and namespaces (when applicable)
- *
- * Do a copy of the node.
- *
- * Returns: a new #xmlNodePtr, or NULL in case of error.
- */
@@ -4423,0 +4418,17 @@ xmlCopyNode(xmlNodePtr node, int extended) {
+    xmlAttrPtr prop;
+    xmlNsPtr ns;
+
+    if (node == NULL)
+        return(NULL);
+
+    prop = node->properties;
+    while (prop != NULL) {
+        if (prop->ns != NULL) {
+            ns = node->nsDef;
+            while ((ns != NULL) && (ns != prop->ns))
+                ns = ns->next;
+            if (ns == NULL)
+                prop->ns = NULL;
+        }
+        prop = prop->next;
+    }
@@ -4427,10 +4438 @@ xmlCopyNode(xmlNodePtr node, int extended) {
-}
-
-/**
- * xmlDocCopyNode:
- * @node:  the node
- * @doc:  the document
- * @extended:   if 1 do a recursive copy (properties, namespaces and children
- *			when applicable)
- *		if 2 copy properties and namespaces (when applicable)
- *
+} *
