diff --git a/tree.c b/tree.c
index 7ffdebf2..bbfd49c4 100644
--- a/tree.c
+++ b/tree.c
@@ -3934 +3934 @@ xmlCopyPropInternal(xmlDocPtr doc, xmlNodePtr target, xmlAttrPtr cur) {
-    if ((cur->ns != NULL) && (target != NULL)) {
+    if ((cur->ns != NULL) && (target != NULL) && (cur->ns->href != NULL) && (cur->ns->prefix != NULL)) {
@@ -3936 +3936 @@ xmlCopyPropInternal(xmlDocPtr doc, xmlNodePtr target, xmlAttrPtr cur) {
-      int res;
+       int res;
@@ -4040,8 +4039,0 @@ xmlCopyPropInternal(xmlDocPtr doc, xmlNodePtr target, xmlAttrPtr cur) {
- * Create a copy of the attribute. This function sets the parent
- * pointer of the copy to @target but doesn't set the attribute on
- * the target element. Users should consider to set the attribute
- * by calling xmlAddChild afterwards or reset the parent pointer to
- * NULL.
- *
- * Returns: a new #xmlAttrPtr, or NULL in case of error.
- */
@@ -4049,0 +4042,7 @@ xmlCopyProp(xmlNodePtr target, xmlAttrPtr cur) {
+	if ((cur == NULL) || (cur->ns == NULL))
+		return xmlCopyPropInternal(NULL, target, cur);
+	/* Avoid dereferencing a possibly stale namespace pointer after a node
+	 * has been freed. If the namespace is no longer owned by a valid
+	 * document, treat the property as not having a namespace. */
+	if ((cur->ns->href == NULL) || (cur->ns->prefix == NULL))
+		cur->ns = NULL;
@@ -4051,11 +4050 @@ xmlCopyProp(xmlNodePtr target, xmlAttrPtr cur) {
-}
-
-/**
- * xmlCopyPropList:
- * @target:  the element where the attributes will be grafted
- * @cur:  the first attribute
- *
- * Create a copy of an attribute list. This function sets the
- * parent pointers of the copied attributes to @target but doesn't
- * set the attributes on the target element.
- *
+} *
