-           */
-          ret->ns = xmlNewReconciledNs(target, cur->ns);
-          if (ret->ns == NULL)
-              goto error;
-        }
-      }
+    xmlAttrPtr
+xmlCopyPropList(xmlNodePtr target, xmlAttrPtr cur) {
+	xmlAttrPtr ret = NULL;
+	xmlAttrPtr p = NULL,q;
+
+	if ((target != NULL) && (target->type != XML_ELEMENT_NODE))
+		target = NULL;
+
+	while (cur != NULL) {
+	    q = xmlCopyProp(target, cur);
+	    if (q == NULL)
+		goto cleanup;
+	    if (p == NULL) {
+	        ret = p = q;
+	    } else {
+	        p->next = q;
+	        q->prev = p;
+	        p = q;
+	    }
+	    cur = cur->next;
+	}
@@ -3986,2 +3956,5 @@ xmlCopyPropInternal(xmlDocPtr doc, xmlNodePtr target, xmlAttrPtr cur) {
-    } else
-        ret->ns = NULL;
+cleanup:
+	if (p != NULL)
+	    p->next = NULL;
+	return(ret);
+}
@@ -4040,8 +4012,0 @@ xmlCopyPropInternal(xmlDocPtr doc, xmlNodePtr target, xmlAttrPtr cur) {
- * Create a copy of the attribute. This function sets the parent
- * pointer of the copy to @target but doesn't set the attribute on
- * the target element. Users should consider to set the attribute
