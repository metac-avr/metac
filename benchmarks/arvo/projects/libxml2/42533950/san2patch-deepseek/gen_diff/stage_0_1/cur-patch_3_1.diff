diff --git a/tree.c b/tree.c
index 7ffdebf2..e2f16934 100644
--- a/tree.c
+++ b/tree.c
@@ -809 +809 @@ xmlFreeNsList(xmlNsPtr cur) {
-    while (cur != NULL) {
+     while (cur != NULL) {
@@ -810,0 +811,5 @@ xmlFreeNsList(xmlNsPtr cur) {
+        if (cur->_private != NULL) {
+            xmlAttrPtr prop = (xmlAttrPtr) cur->_private;
+            if (prop->ns == cur)
+                prop->ns = NULL;
+        }
@@ -3937,0 +3943,16 @@ xmlCopyPropInternal(xmlDocPtr doc, xmlNodePtr target, xmlAttrPtr cur) {
+      if ((cur->parent != NULL) && (cur->parent->nsDef != NULL)) {
+          xmlNsPtr nsDef = cur->parent->nsDef;
+          while (nsDef != NULL) {
+              if (nsDef == cur->ns)
+                  break;
+              nsDef = nsDef->next;
+          }
+          if (nsDef == NULL)
+              cur->ns = NULL;
+      } else {
+          cur->ns = NULL;
+      }
+
+      if (cur->ns == NULL)
+          goto ns_cleared;
+
@@ -3985,0 +4007,3 @@ xmlCopyPropInternal(xmlDocPtr doc, xmlNodePtr target, xmlAttrPtr cur) {
+ns_cleared:
+      ;
+
