diff --git a/valid.c b/valid.c
index 3ea9f87c..5e6cbb61 100644
--- a/valid.c
+++ b/valid.c
@@ -1066,0 +1067,9 @@ xmlFreeElement(xmlElementPtr elem) {
+    /* Add reference counting check to prevent premature deallocation */
+    if (elem->doc && elem->doc->_private) {
+        /* Check if element is still referenced elsewhere */
+        xmlRefTablePtr refs = (xmlRefTablePtr) elem->doc->_private;
+        if (refs->nb_refs > 0) {
+            /* Delay freeing until all references are released */
+            return;
+        }
+    }
@@ -1144,0 +1154,2 @@ xmlAddElementDecl(xmlValidCtxt *ctxt,
+	    ret = NULL;
+	    return NULL;  /* Early return to avoid further access */
