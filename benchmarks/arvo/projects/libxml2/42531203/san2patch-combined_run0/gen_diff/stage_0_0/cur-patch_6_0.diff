diff --git a/HTMLparser.c b/HTMLparser.c
index 840e6ebf..2d302457 100644
--- a/HTMLparser.c
+++ b/HTMLparser.c
@@ -4877,0 +4878,10 @@ htmlParseDocument(htmlParserCtxtPtr ctxt) {
+    /*
+     * Refresh context pointers after potential buffer reallocation
