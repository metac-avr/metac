diff --git a/buf.c b/buf.c
index 9dc9400f..31671e7e 100644
--- a/buf.c
+++ b/buf.c
@@ -410 +410,4 @@ xmlBufGrowInternal(xmlBufPtr buf, size_t len) {
-	buf->content = newbuf + start_buf;
+        // Invalidate old content pointer immediately
+        if (buf->content != (newbuf + start_buf)) {
+            buf->content = newbuf + start_buf;
+        }
@@ -417 +420,4 @@ xmlBufGrowInternal(xmlBufPtr buf, size_t len) {
-	buf->content = newbuf;
+        // Invalidate old content pointer immediately
+        if (buf->content != newbuf) {
+            buf->content = newbuf;
+        }
diff --git a/HTMLparser.c b/HTMLparser.c
index 840e6ebf..03851eda 100644
--- a/HTMLparser.c
+++ b/HTMLparser.c
@@ -4877,0 +4878,12 @@ htmlParseDocument(htmlParserCtxtPtr ctxt) {
+    /*
+     * Validate buffer pointers before parsing to prevent use-after-free
+     */
+    if (ctxt->input != NULL && ctxt->input->buf != NULL) {
+        xmlBufPtr buffer = ctxt->input->buf->buffer;
+        if (buffer->content != NULL) {
+            ctxt->input->cur = buffer->content + 
+                              (ctxt->input->cur - ctxt->input->buf->buffer->content);
+            ctxt->input->end = buffer->content + buffer->use;
+        }
+    }
+    
