+static int
+htmlParseExternalID(htmlParserCtxtPtr ctxt, xmlChar **publicID) {
+    xmlChar *URI = NULL;
+
+    if ((UPPER == 'S') && (UPPER1 == 'Y') &&
+        (UPPER2 == 'S') && (UPPER3 == 'T') &&
+        (UPPER4 == 'E') && (UPPER5 == 'M')) {
+        SKIP(6);
+        if (!IS_BLANK_CH(CUR)) {
+            htmlParseErr(ctxt, XML_ERR_SPACE_REQUIRED,
