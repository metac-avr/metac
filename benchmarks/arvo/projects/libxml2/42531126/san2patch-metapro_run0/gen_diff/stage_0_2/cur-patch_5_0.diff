diff --git a/HTMLparser.c b/HTMLparser.c
index 840e6ebf..62339804 100644
--- a/HTMLparser.c
+++ b/HTMLparser.c
@@ -425,0 +426,4 @@ htmlCurrentChar(xmlParserCtxtPtr ctxt, int *len) {
+    if (ctxt == NULL || ctxt->input == NULL) {
+        *len = 0;
+        return(0);
+    }
@@ -426,0 +431,4 @@ htmlCurrentChar(xmlParserCtxtPtr ctxt, int *len) {
+    if (cur == NULL || ctxt->input->end == NULL) {
