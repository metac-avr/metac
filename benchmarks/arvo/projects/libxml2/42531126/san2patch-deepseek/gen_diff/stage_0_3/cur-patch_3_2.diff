+/*
+ * htmlCheckEncoding:
+ * @ctxt: the parser context
+ * @attvalue: the attribute value
+ *
+ * Checks an attribute value for correct encoding.
+ */
+int
+htmlCheckEncoding(htmlParserCtxtPtr ctxt, const xmlChar *attvalue) {
+    const unsigned char *cur;
+
+    if (attvalue == NULL)
+        return(0);
+
+    cur = attvalue;
+    while (*cur != 0) {
+        if ((*cur >= 0x20) && (*cur <= 0x7F)) {
+            cur++;
+            continue;
+        }
+        if ((*cur == 0x9) || (*cur == 0xA) || (*cur == 0xD)) {
+            cur++;
+            continue;
+        }
+        return(0);
+    }
+    return(1);
