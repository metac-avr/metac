diff --git a/HTMLparser.c b/HTMLparser.c
index 840e6ebf..30b20fed 100644
--- a/HTMLparser.c
+++ b/HTMLparser.c
@@ -377,0 +378,2 @@ htmlCurrentChar(xmlParserCtxtPtr ctxt, int *len) {
+    cur = ctxt->input->cur;
+
@@ -386 +388 @@ htmlCurrentChar(xmlParserCtxtPtr ctxt, int *len) {
-        if (*ctxt->input->cur < 0x80) {
+        if (*cur < 0x80) {
@@ -417,9 +419,5 @@ htmlCurrentChar(xmlParserCtxtPtr ctxt, int *len) {
-     * From rfc2044: encoding of the Unicode values on UTF-8:
-     *
-     * UCS-4 range (hex.)           UTF-8 octet sequence (binary)
-     * 0000 0000-0000 007F   0xxxxxxx
-     * 0000 0080-0000 07FF   110xxxxx 10xxxxxx
-     * 0000 0800-0000 FFFF   1110xxxx 10xxxxxx 10xxxxxx
-     *
-     * Check for the 0x110000 limit too
-     */
+      */
+    if ((ctxt->input->end - ctxt->input->cur) < 4) {
+        if (xmlParserGrow(ctxt) < 0)
+            return(0);
+    }
