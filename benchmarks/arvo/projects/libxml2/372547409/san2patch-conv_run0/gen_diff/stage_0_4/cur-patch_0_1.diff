+static void
+xmlFreeAttribute(xmlAttributePtr attr) {
+    xmlDictPtr dict;
@@ -5999,5 +5987,31 @@ xmlValidateOneElement(xmlValidCtxtPtr ctxt, xmlDocPtr doc,
-		ns = elem->nsDef;
-		while (ns != NULL) {
