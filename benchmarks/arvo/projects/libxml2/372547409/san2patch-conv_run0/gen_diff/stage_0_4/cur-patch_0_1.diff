@@ -5982,16 +5983,3 @@ xmlValidateOneElement(xmlValidCtxtPtr ctxt, xmlDocPtr doc,
-	    tmp = xmlValidateElementContent(ctxt, child, elemDecl, 1, elem);
-	    if (tmp <= 0)
