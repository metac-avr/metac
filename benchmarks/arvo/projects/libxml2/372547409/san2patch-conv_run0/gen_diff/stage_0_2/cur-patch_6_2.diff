+        attr = elemDecl->attributes;
+        while (attr != NULL) {
+            if (attr->def == XML_ATTRIBUTE_REQUIRED) {
+                int qualified = -1;
+
+                if ((attr->prefix == NULL) &&
+                    (xmlStrEqual(attr->name, BAD_CAST "xmlns"))) {
