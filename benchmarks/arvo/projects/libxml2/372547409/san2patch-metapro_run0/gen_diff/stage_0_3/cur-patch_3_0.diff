-    }
-    } /* not continuous */
-
@@ -5990 +5973,6 @@ xmlValidateOneElement(xmlValidCtxtPtr ctxt, xmlDocPtr doc,
-    attr = elemDecl->attributes;
+// Fixed CWE-416: Use After Free - Added null check before accessing attr
+     if (elemDecl != NULL) {
+	attr = elemDecl->attributes;
