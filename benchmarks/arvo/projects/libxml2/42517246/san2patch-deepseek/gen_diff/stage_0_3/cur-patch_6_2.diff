diff --git a/tree.c b/tree.c
index 6a42f118..a080d5f6 100644
--- a/tree.c
+++ b/tree.c
@@ -4519,6 +4518,0 @@ xmlCopyNode(xmlNodePtr node, int extended) {
- *		if 2 copy properties and namespaces (when applicable)
- *
- * Do a copy of the node to a given document.
- *
- * Returns: a new #xmlNodePtr, or NULL in case of error.
- */
@@ -4541,0 +4536,26 @@ xmlDocCopyNode(xmlNodePtr node, xmlDocPtr doc, int extended) {
+xmlNodePtr
+xmlDocCopyNodeList(xmlDocPtr doc, xmlNodePtr node) {
+    xmlNodePtr ret = NULL;
+    xmlNodePtr cur = NULL;
+    xmlNodePtr p = NULL;
+
+    if (doc == NULL) return(NULL);
+    if (node == NULL) return(NULL);
+
+    cur = node;
+    while (cur != NULL) {
+        p = xmlStaticCopyNode(cur, doc, NULL, 0);
+        if (p == NULL) {
+            xmlFreeNodeList(ret);
+            return(NULL);
+        }
+        if (ret == NULL) {
+            ret = p;
+        } else {
+            xmlAddSibling(ret, p);
+        }
+        cur = cur->next;
+    }
+    return(ret);
+} * Returns: a new #xmlNodePtr, or NULL in case of error.
+ */
