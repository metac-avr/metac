diff --git a/xinclude.c b/xinclude.c
index e14176c6..7f741538 100644
--- a/xinclude.c
+++ b/xinclude.c
@@ -839,0 +840,2 @@ xmlXIncludeCopyNode(xmlXIncludeCtxtPtr ctxt, xmlDocPtr target,
+    xmlNodePtr cur;
+    xmlAttrPtr attr;
@@ -848 +850 @@ xmlXIncludeCopyNode(xmlXIncludeCtxtPtr ctxt, xmlDocPtr target,
-    else
+    else {
@@ -849,0 +852,27 @@ xmlXIncludeCopyNode(xmlXIncludeCtxtPtr ctxt, xmlDocPtr target,
+        if ((result != NULL) && (source->dict != NULL) && (target->dict != NULL)) {
+            for (cur = result; cur != NULL; cur = cur->next) {
+                if (cur->name != NULL) {
+                    xmlChar *name = (xmlChar *)xmlDictLookup(target->dict, cur->name, -1);
+                    if (name != NULL)
+                        cur->name = name;
+                }
+                if (cur->content != NULL) {
+                    xmlChar *content = (xmlChar *)xmlDictLookup(target->dict, cur->content, -1);
+                    if (content != NULL)
+                        cur->content = content;
+                }
+                for (attr = cur->properties; attr != NULL; attr = attr->next) {
+                    if (attr->name != NULL) {
+                        xmlChar *name = (xmlChar *)xmlDictLookup(target->dict, attr->name, -1);
+                        if (name != NULL)
+                            attr->name = name;
+                    }
+                    if (attr->children != NULL && attr->children->content != NULL) {
+                        xmlChar *content = (xmlChar *)xmlDictLookup(target->dict, attr->children->content, -1);
+                        if (content != NULL)
+                            attr->children->content = content;
+                    }
+                }
+            }
+        }
+    }
