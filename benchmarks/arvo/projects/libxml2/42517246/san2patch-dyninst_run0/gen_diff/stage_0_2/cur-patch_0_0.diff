diff --git a/xinclude.c b/xinclude.c
index e14176c6..6cbb5a17 100644
--- a/xinclude.c
+++ b/xinclude.c
@@ -2230,5 +2230,12 @@ xmlXIncludeIncludeNode(xmlXIncludeCtxtPtr ctxt, int nr) {
-	ctxt->incTab[nr]->inc =
-	    xmlXIncludeCopyXPointer(ctxt, ctxt->doc, ctxt->doc,
-		                    ctxt->incTab[nr]->xptr);
-	xmlXPathFreeObject(ctxt->incTab[nr]->xptr);
-	ctxt->incTab[nr]->xptr = NULL;
+        /* Validate xptr before use to prevent expired pointer dereference */
+        if (ctxt->incTab[nr]->xptr->type != XPATH_UNDEFINED) {
+	    ctxt->incTab[nr]->inc =
+	        xmlXIncludeCopyXPointer(ctxt, ctxt->doc, ctxt->doc,
+	                        ctxt->incTab[nr]->xptr);
+	    xmlXPathFreeObject(ctxt->incTab[nr]->xptr);
+	    ctxt->incTab[nr]->xptr = NULL;
+        } else {
+            /* Handle expired/invalid xptr gracefully */
+            ctxt->incTab[nr]->xptr = NULL;
+            return(-1);
+        }
