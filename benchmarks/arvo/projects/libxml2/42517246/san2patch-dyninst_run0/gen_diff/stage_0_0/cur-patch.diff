diff --git a/xinclude.c b/xinclude.c
index e14176c6..956deeab 100644
--- a/xinclude.c
+++ b/xinclude.c
@@ -2230,3 +2230,11 @@ xmlXIncludeIncludeNode(xmlXIncludeCtxtPtr ctxt, int nr) {
-	ctxt->incTab[nr]->inc =
-	    xmlXIncludeCopyXPointer(ctxt, ctxt->doc, ctxt->doc,
-		                    ctxt->incTab[nr]->xptr);
+        /* Validate xptr object before use to prevent expired pointer dereference */
+        if (ctxt->incTab[nr]->xptr->type == XPATH_NODESET && 
+            ctxt->incTab[nr]->xptr->nodesetval != NULL &&
+            ctxt->incTab[nr]->xptr->nodesetval->nodeNr > 0) {
+	    ctxt->incTab[nr]->inc =
+	        xmlXIncludeCopyXPointer(ctxt, ctxt->doc, ctxt->doc,
+	                            ctxt->incTab[nr]->xptr);
+        } else {
+            /* Handle invalid xptr gracefully */
+            ctxt->incTab[nr]->inc = NULL;
+        }
