+// FIXME: Crash CWE-825: Expired Pointer Dereference
+     else if (node->name != NULL) {
+        if ((doc != NULL) && (doc->dict != NULL)) {
+            /* Validate node->name pointer before using it in dictionary lookup */
+            const xmlChar* name_copy = xmlStrdup(node->name);
+            if (name_copy != NULL) {
+                ret->name = xmlDictLookup(doc->dict, name_copy, -1);
+                xmlFree((xmlChar*)name_copy);
+            } else {
+                ret->name = NULL;
+            }
+        }
