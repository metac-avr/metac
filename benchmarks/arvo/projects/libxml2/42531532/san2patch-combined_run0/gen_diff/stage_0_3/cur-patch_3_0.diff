diff --git a/valid.c b/valid.c
index 1ecc762c..8c834e5a 100644
--- a/valid.c
+++ b/valid.c
@@ -2736,0 +2737 @@ xmlRemoveID(xmlDocPtr doc, xmlAttrPtr attr) {
