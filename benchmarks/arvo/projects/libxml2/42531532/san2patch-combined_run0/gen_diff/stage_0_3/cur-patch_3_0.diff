diff --git a/hash.c b/hash.c
index 33e8581e..b07d2dd4 100644
--- a/hash.c
+++ b/hash.c
@@ -1274,3 +1274,7 @@ xmlHashRemoveEntry3(xmlHashTablePtr hash, const xmlChar *key,
