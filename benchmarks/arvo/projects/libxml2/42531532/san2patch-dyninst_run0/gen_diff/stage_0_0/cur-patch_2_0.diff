+// FIXME: Crash CWE-416: Use After Free
+ static void
+xmlFreeIDTableEntry(void *id, const xmlChar *name ATTRIBUTE_UNUSED) {
+    xmlIDPtr idPtr = (xmlIDPtr) id;
+    
+    if (idPtr != NULL) {
+        /* Remove from document ID table before freeing to prevent dangling references */
+        if (idPtr->doc != NULL) {
+            xmlXPathReleaseObject(idPtr->doc->_private, (xmlXPathObjectPtr)idPtr);
@@ -2637,0 +2646 @@ xmlAddID(xmlValidCtxtPtr ctxt, xmlDocPtr doc, const xmlChar *value,
+        xmlFreeID(idPtr);
