+    if (idPtr != NULL) {
+        /* Clear the node reference to prevent use-after-free */
+        if (idPtr->attr != NULL && idPtr->attr->doc != NULL) {
+            xmlRemoveID(idPtr->attr->doc, idPtr->attr);
@@ -2637,0 +2646,2 @@ xmlAddID(xmlValidCtxtPtr ctxt, xmlDocPtr doc, const xmlChar *value,
+        /* Now safely free the ID structure */
+        xmlFreeID(idPtr);
