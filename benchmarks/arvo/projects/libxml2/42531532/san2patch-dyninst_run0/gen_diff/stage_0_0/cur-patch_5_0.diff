diff --git a/xinclude.c b/xinclude.c
index 72a88c99..c979e1dd 100644
--- a/xinclude.c
+++ b/xinclude.c
@@ -1980 +1980,9 @@ xmlXIncludeIncludeNode(xmlXIncludeCtxtPtr ctxt, xmlXIncludeRefPtr ref) {
-            next = child->next;
+             next = child->next;
+            /* Remove ID from document's ID table before freeing the node to prevent use-after-free */
+            if ((child->type == XML_ELEMENT_NODE) && (child->doc != NULL)) {
+                xmlChar *id_value = xmlGetProp(child, BAD_CAST "id");
+                if (id_value != NULL) {
+                    xmlRemoveID(child->doc, child);
+                    xmlFree(id_value);
+                }
+            }
diff --git a/valid.c b/valid.c
index 1ecc762c..ac3eecbb 100644
--- a/valid.c
+++ b/valid.c
@@ -2560 +2560,7 @@ xmlAddIDSafe(xmlDocPtr doc, const xmlChar *value, xmlAttrPtr attr,
-    }
+        /* 
+         * Prevent use-after-free by ensuring clean state
+         */
+        if (xmlHashLookup(table, value) != NULL) {
+            xmlHashRemoveEntry(table, value, NULL);
+        }
+     }
