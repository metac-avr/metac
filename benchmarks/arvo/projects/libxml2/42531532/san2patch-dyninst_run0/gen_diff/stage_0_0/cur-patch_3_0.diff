diff --git a/xinclude.c b/xinclude.c
index 72a88c99..752a8629 100644
--- a/xinclude.c
+++ b/xinclude.c
@@ -1980 +1980,16 @@ xmlXIncludeIncludeNode(xmlXIncludeCtxtPtr ctxt, xmlXIncludeRefPtr ref) {
-            next = child->next;
+             next = child->next;
+            /* Check if child has an ID attribute and remove it from ID table before freeing */
+            if ((child->type == XML_ELEMENT_NODE) && (child->properties != NULL)) {
+                xmlAttrPtr prop = child->properties;
+                while (prop != NULL) {
+                    if ((prop->name != NULL) && (xmlStrEqual(prop->name, BAD_CAST "id"))) {
+                        xmlChar *id_val = xmlNodeListGetString(child->doc, prop->children, 1);
+                        if (id_val != NULL) {
+                            xmlRemoveID(child->doc, child);
+                            xmlFree(id_val);
+                        }
+                        break;
+                    }
+                    prop = prop->next;
+                }
+            }
