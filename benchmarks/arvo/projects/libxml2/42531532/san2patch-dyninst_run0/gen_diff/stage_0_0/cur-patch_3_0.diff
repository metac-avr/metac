@@ -2560 +2560,5 @@ xmlAddIDSafe(xmlDocPtr doc, const xmlChar *value, xmlAttrPtr attr,
-    }
+        /* 
+         * Clear any dangling references before proceeding
+         */
+        xmlHashRemoveEntry(table, value, NULL);
+     }
