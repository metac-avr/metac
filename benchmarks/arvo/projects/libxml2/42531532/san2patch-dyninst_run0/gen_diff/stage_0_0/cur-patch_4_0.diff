diff --git a/xinclude.c b/xinclude.c
index 72a88c99..5a2ab1d7 100644
--- a/xinclude.c
+++ b/xinclude.c
@@ -1980 +1980,8 @@ xmlXIncludeIncludeNode(xmlXIncludeCtxtPtr ctxt, xmlXIncludeRefPtr ref) {
-            next = child->next;
+             next = child->next;
+            /* Ensure ID is removed from document's ID table before node is freed */
+            if ((child->type == XML_ELEMENT_NODE) && (child->doc != NULL)) {
+                xmlAttrPtr id_attr = xmlGetID(child->doc, child->name);
+                if (id_attr != NULL && id_attr->parent == child) {
+                    xmlRemoveID(child->doc, child);
+                }
+            }
diff --git a/valid.c b/valid.c
index 1ecc762c..a0b82d9e 100644
--- a/valid.c
+++ b/valid.c
@@ -2560 +2560,8 @@ xmlAddIDSafe(xmlDocPtr doc, const xmlChar *value, xmlAttrPtr attr,
-    }
+        /* 
+         * Check for and remove any stale ID entries to prevent UAF
+         */
+        xmlIDPtr old_id = xmlHashLookup(table, value);
+        if (old_id != NULL) {
+            xmlHashRemoveEntry(table, value, NULL);
+        }
+     }
