diff --git a/valid.c b/valid.c
index 1ecc762c..593c0104 100644
--- a/valid.c
+++ b/valid.c
@@ -2743,4 +2743,11 @@ xmlRemoveID(xmlDocPtr doc, xmlAttrPtr attr) {
-        return(-1);
-
-    if (xmlHashRemoveEntry(table, attr->id->value, xmlFreeIDTableEntry) < 0)
-        return(-1);
+         return(-1);
+
+    /* Safely remove ID entry by checking if it's still valid */
+    xmlIDPtr current_id = attr->id;
+    if (current_id != NULL) {
+        xmlIDPtr table_id = xmlHashLookup(table, current_id->value);
+        if (table_id == current_id) {
+            if (xmlHashRemoveEntry(table, current_id->value, xmlFreeIDTableEntry) < 0)
+                return(-1);
+        }
+    }
