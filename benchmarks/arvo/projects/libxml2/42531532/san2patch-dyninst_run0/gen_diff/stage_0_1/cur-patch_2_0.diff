diff --git a/xinclude.c b/xinclude.c
index 72a88c99..3028c9e2 100644
--- a/xinclude.c
+++ b/xinclude.c
@@ -1980 +1980,12 @@ xmlXIncludeIncludeNode(xmlXIncludeCtxtPtr ctxt, xmlXIncludeRefPtr ref) {
-            next = child->next;
+             next = child->next;
+            /* Ensure ID entries are removed from document hash table before freeing nodes */
+            if (child->type == XML_ELEMENT_NODE) {
+                xmlChar* idValue = xmlGetProp(child, BAD_CAST "id");
+                if (idValue != NULL) {
+                    xmlAttrPtr idAttr = xmlHasProp(child, BAD_CAST "id");
+                    if (idAttr != NULL && child->doc != NULL) {
+                        xmlRemoveID(child->doc, idAttr);
+                    }
+                    xmlFree(idValue);
+                }
