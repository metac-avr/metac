diff --git a/xinclude.c b/xinclude.c
index 72a88c99..a2da8750 100644
--- a/xinclude.c
+++ b/xinclude.c
@@ -1980 +1980,12 @@ xmlXIncludeIncludeNode(xmlXIncludeCtxtPtr ctxt, xmlXIncludeRefPtr ref) {
-            next = child->next;
+             next = child->next;
+            /* Remove ID attributes before freeing the node to prevent use-after-free */
+            if (child->type == XML_ELEMENT_NODE && child->properties != NULL) {
+                xmlAttrPtr prop = child->properties;
+                while (prop != NULL) {
+                    xmlAttrPtr next_prop = prop->next;
+                    if (prop->name != NULL && xmlStrEqual(prop->name, BAD_CAST "id")) {
+                        xmlRemoveID(child->doc, prop);
+                    }
+                    prop = next_prop;
+                }
+            }
