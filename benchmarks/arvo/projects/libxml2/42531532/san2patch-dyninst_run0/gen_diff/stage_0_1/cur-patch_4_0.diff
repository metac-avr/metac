diff --git a/valid.c b/valid.c
index 1ecc762c..5080558b 100644
--- a/valid.c
+++ b/valid.c
@@ -2743 +2743 @@ xmlRemoveID(xmlDocPtr doc, xmlAttrPtr attr) {
-        return(-1);
+         return(-1);
@@ -2745,2 +2745,8 @@ xmlRemoveID(xmlDocPtr doc, xmlAttrPtr attr) {
-    if (xmlHashRemoveEntry(table, attr->id->value, xmlFreeIDTableEntry) < 0)
-        return(-1);
+    /* Validate that the ID entry points to valid memory before removal */
+    if (attr->id != NULL) {
+        xmlIDPtr id_entry = xmlHashLookup(table, attr->id->value);
+        if (id_entry == attr->id) {
+            if (xmlHashRemoveEntry(table, attr->id->value, xmlFreeIDTableEntry) < 0)
+                return(-1);
+        }
+    }
diff --git a/xinclude.c b/xinclude.c
index 72a88c99..2953acb5 100644
--- a/xinclude.c
+++ b/xinclude.c
@@ -1980 +1980,5 @@ xmlXIncludeIncludeNode(xmlXIncludeCtxtPtr ctxt, xmlXIncludeRefPtr ref) {
-            next = child->next;
+             next = child->next;
+            /* Ensure ID table entries are removed before freeing nodes */
+            if ((child->type == XML_ELEMENT_NODE) && (child->doc != NULL)) {
+                xmlUnsetNsProp(child, NULL, BAD_CAST "id");
+            }
