diff --git a/xinclude.c b/xinclude.c
index 72a88c99..104246ed 100644
--- a/xinclude.c
+++ b/xinclude.c
@@ -2399,0 +2400 @@ xmlXIncludeProcessNode(xmlXIncludeCtxtPtr ctxt, xmlNodePtr node) {
+    xmlNodePtr cur;
@@ -2402 +2403 @@ xmlXIncludeProcessNode(xmlXIncludeCtxtPtr ctxt, xmlNodePtr node) {
-        (node->doc == NULL) || (ctxt == NULL))
+         (node->doc == NULL) || (ctxt == NULL))
@@ -2403,0 +2405,18 @@ xmlXIncludeProcessNode(xmlXIncludeCtxtPtr ctxt, xmlNodePtr node) {
+    
+    /* Remove ID references before processing to prevent use-after-free */
+    for (cur = node; cur != NULL; cur = cur->next) {
+        if (cur->type == XML_ELEMENT_NODE) {
+            xmlAttrPtr attr = cur->properties;
+            while (attr != NULL) {
+                if (attr->atype == XML_ATTRIBUTE_ID) {
+                    xmlChar *id_val = xmlNodeListGetString(cur->doc, attr->children, 1);
+                    if (id_val != NULL) {
+                        xmlRemoveID(cur->doc, attr);
+                        xmlFree(id_val);
+                    }
+                }
+                attr = attr->next;
+            }
+        }
+    }
+    
