diff --git a/valid.c b/valid.c
index 1ecc762c..b86454c0 100644
--- a/valid.c
+++ b/valid.c
@@ -2747,2 +2747 @@ xmlRemoveID(xmlDocPtr doc, xmlAttrPtr attr) {
-
-    attr->atype = 0;
+attr->atype = 0;
@@ -2755 +2754,2 @@ xmlRemoveID(xmlDocPtr doc, xmlAttrPtr attr) {
- * xmlGetID:
+// FIXME: Use-after-free in xmlRemoveID
+  * xmlGetID:
@@ -2767,0 +2768,48 @@ xmlGetID(xmlDocPtr doc, const xmlChar *ID) {
+    if (doc == NULL || ID == NULL)
+        return(NULL);
+
+    table = (xmlIDTablePtr) doc->ids;
+    if (table == NULL)
+        return(NULL);
+
+    id = (xmlIDPtr) xmlHashLookup(table, ID);
+    if (id == NULL)
+        return(NULL);
+
+    return(id->attr);
+}
+
+/**
+ * xmlRemoveID:
+ * @doc:  pointer to the document
+ * @attr:  pointer to the attribute
+ *
+ * Remove an ID from the document ID table.
+ *
+ * Returns 0 on success, -1 on failure.
+ */
+int
+xmlRemoveID(xmlDocPtr doc, xmlAttrPtr attr) {
+    xmlIDTablePtr table;
+    xmlIDPtr id;
+    xmlAttrPtr saved_attr;
+
+    if (doc == NULL || attr == NULL)
+        return(-1);
+
+    table = (xmlIDTablePtr) doc->ids;
+    if (table == NULL)
+        return(-1);
+
+    if (attr->id == NULL)
+        return(-1);
+
+    id = (xmlIDPtr) attr->id;
+    saved_attr = id->attr;
+    if (saved_attr == attr) {
+        attr->id = NULL;
+        xmlHashRemove(table, id->name, xmlFreeIDTableEntry);
+        return(0);
+    }
+    return(-1);
+}
