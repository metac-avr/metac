diff --git a/valid.c b/valid.c
index 1ecc762c..03743b74 100644
--- a/valid.c
+++ b/valid.c
@@ -2747,2 +2747 @@ xmlRemoveID(xmlDocPtr doc, xmlAttrPtr attr) {
-
-    attr->atype = 0;
+attr->atype = 0;
@@ -2755 +2754,2 @@ xmlRemoveID(xmlDocPtr doc, xmlAttrPtr attr) {
- * xmlGetID:
+// FIXME: pointer to freed memory issue
+  * xmlGetID:
@@ -2767,0 +2768,46 @@ xmlGetID(xmlDocPtr doc, const xmlChar *ID) {
+    if (doc == NULL || ID == NULL)
+        return(NULL);
+
+    table = (xmlIDTablePtr) doc->ids;
+    if (table == NULL)
+        return(NULL);
+
+    id = (xmlIDPtr) xmlHashLookup(table, ID);
+    if (id == NULL)
+        return(NULL);
+
+    return(id->attr);
+}
+
+/**
+ * xmlRemoveID:
+ * @doc:  pointer to the document
+ * @attr:  pointer to the attribute
+ *
+ * Remove the given attribute from the ID table maintained internally.
+ *
+ * Returns 0 on success, -1 on failure.
+ */
+int
+xmlRemoveID(xmlDocPtr doc, xmlAttrPtr attr) {
+    xmlIDTablePtr table;
+    xmlIDPtr id;
+
+    if (doc == NULL || attr == NULL)
+        return(-1);
+
+    table = (xmlIDTablePtr) doc->ids;
+    if (table == NULL)
+        return(-1);
+
+    if (attr->id == NULL)
+        return(-1);
+
+    id = (xmlIDPtr) attr->id;
+    if (id->attr == attr) {
+        attr->id = NULL;
+        xmlHashRemoveEntry(table, id->value, xmlFreeIDTableEntry);
+        return(0);
+    }
+    return(-1);
+}
