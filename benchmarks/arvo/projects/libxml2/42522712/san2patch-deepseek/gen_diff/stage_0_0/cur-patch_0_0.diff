diff --git a/HTMLparser.c b/HTMLparser.c
index b8b6bd23..fcb168dc 100644
--- a/HTMLparser.c
+++ b/HTMLparser.c
@@ -3703,0 +3704,19 @@ htmlParseDocTypeDecl(htmlParserCtxtPtr ctxt) {
+    if ((ctxt->input != NULL) && (ctxt->input->cur != NULL) &&
+        (ExternalID != NULL)) {
+        const xmlChar *end = ctxt->input->end;
+        const xmlChar *base = ctxt->input->cur;
+        size_t len = xmlStrlen(ExternalID);
+        if ((ExternalID < base) || (ExternalID > end) ||
+            (len > (size_t)(end - ExternalID))) {
+            htmlParseErr(ctxt, XML_ERR_INTERNAL_ERROR,
+                         "htmlParseDocTypeDecl : ExternalID out of bounds\n",
+                         NULL, NULL);
+            xmlFree(ExternalID);
+            ExternalID = NULL;
+            if (URI != NULL) {
+                xmlFree(URI);
+                URI = NULL;
+            }
+            return;
+        }
+    }
