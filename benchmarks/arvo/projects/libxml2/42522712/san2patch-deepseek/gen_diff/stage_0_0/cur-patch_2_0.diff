diff --git a/HTMLparser.c b/HTMLparser.c
index b8b6bd23..f4610f2b 100644
--- a/HTMLparser.c
+++ b/HTMLparser.c
@@ -3676,0 +3677,2 @@ htmlParseDocTypeDecl(htmlParserCtxtPtr ctxt) {
+    const xmlChar *start = NULL;
+    const xmlChar *end = NULL;
@@ -3702,0 +3705,4 @@ htmlParseDocTypeDecl(htmlParserCtxtPtr ctxt) {
+    if (ctxt->input != NULL) {
+        start = ctxt->input->cur;
+        end = ctxt->input->end;
+    }
@@ -3703,0 +3710,30 @@ htmlParseDocTypeDecl(htmlParserCtxtPtr ctxt) {
+    if (ExternalID != NULL) {
+        if ((start == NULL) || (end == NULL) ||
+            (ExternalID < start) || (ExternalID > end)) {
+            htmlParseErr(ctxt, XML_ERR_INTERNAL_ERROR,
+                         "htmlParseDocTypeDecl : ExternalID out of bounds\n",
+                         NULL, NULL);
+            xmlFree(ExternalID);
+            ExternalID = NULL;
+            if (URI != NULL) {
+                xmlFree(URI);
+                URI = NULL;
+            }
+            return;
+        }
+        {
+            size_t len = xmlStrlen(ExternalID);
+            if (len > (size_t)(end - ExternalID)) {
+                htmlParseErr(ctxt, XML_ERR_INTERNAL_ERROR,
+                             "htmlParseDocTypeDecl : ExternalID length out of bounds\n",
+                             NULL, NULL);
+                xmlFree(ExternalID);
+                ExternalID = NULL;
+                if (URI != NULL) {
+                    xmlFree(URI);
+                    URI = NULL;
+                }
+                return;
+            }
+        }
+    }
