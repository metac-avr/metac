diff --git a/encoding.c b/encoding.c
index 3d336fb1..2b0e8889 100644
--- a/encoding.c
+++ b/encoding.c
@@ -1923,4 +1923,6 @@ xmlCharEncCloseFunc(xmlCharEncodingHandler *handler) {
-    xmlFree(handler->name);
-    if (handler->ctxtDtor != NULL) {
-        handler->ctxtDtor(handler->inputCtxt);
-        handler->ctxtDtor(handler->outputCtxt);
+    /* Set handler pointer to NULL after freeing to prevent use-after-free */
