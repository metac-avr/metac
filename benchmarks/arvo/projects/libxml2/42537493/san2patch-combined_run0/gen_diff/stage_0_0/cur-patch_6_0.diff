+    xmlFree(temp_handler->name);
+    if (temp_handler->ctxtDtor != NULL) {
+        temp_handler->ctxtDtor(temp_handler->inputCtxt);
+        temp_handler->ctxtDtor(temp_handler->outputCtxt);
@@ -1928 +1930 @@ xmlCharEncCloseFunc(xmlCharEncodingHandler *handler) {
-    xmlFree(handler);
+    xmlFree(temp_handler);
