diff --git a/tree.c b/tree.c
index 7ffdebf2..01b0ba65 100644
--- a/tree.c
+++ b/tree.c
@@ -792,2 +792,9 @@ xmlFreeNs(xmlNsPtr cur) {
-    if (cur->href != NULL) xmlFree((char *) cur->href);
-    if (cur->prefix != NULL) xmlFree((char *) cur->prefix);
+    // Use-after-free prevention: set pointers to NULL after freeing
+    if (cur->href != NULL) {
+        xmlFree((char *) cur->href);
+    }
+    cur->href = NULL;
+    if (cur->prefix != NULL) {
+        xmlFree((char *) cur->prefix);
+    }
+    cur->prefix = NULL;
@@ -804,2 +811 @@ void
-xmlFreeNsList(xmlNsPtr cur) {
-    xmlNsPtr next;
+xmlFreeNsList(xmlNsPtr cur) {    xmlNsPtr next;
@@ -3698,2 +3704,5 @@ xmlFreeNode(xmlNodePtr cur) {
-            xmlFreePropList(cur->properties);
-        if (cur->nsDef != NULL)
+// FIXME: Crash CWE-416: Use After Free
+             xmlFreePropList(cur->properties);
+        if (cur->nsDef != NULL) {
+            /* Set current node's namespace reference to NULL before freeing namespace list */
+            cur->ns = NULL;
@@ -3700,0 +3710 @@ xmlFreeNode(xmlNodePtr cur) {
+        }
