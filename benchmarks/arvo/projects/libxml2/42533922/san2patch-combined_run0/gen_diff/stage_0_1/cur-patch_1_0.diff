diff --git a/tree.c b/tree.c
index 7ffdebf2..4f0d16c7 100644
--- a/tree.c
+++ b/tree.c
@@ -792,2 +792,9 @@ xmlFreeNs(xmlNsPtr cur) {
-    if (cur->href != NULL) xmlFree((char *) cur->href);
-    if (cur->prefix != NULL) xmlFree((char *) cur->prefix);
+    /* CWE-416: Use After Free - Clear pointers after freeing to prevent dangling references */
+    if (cur->href != NULL) {
+        xmlFree((char *) cur->href);
+        cur->href = NULL;  /* Prevent future use of freed memory */
+    }
+    if (cur->prefix != NULL) {
+        xmlFree((char *) cur->prefix);
+        cur->prefix = NULL;  /* Prevent future use of freed memory */
+    }
