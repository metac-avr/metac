+     * Handle XML namespace.
@@ -8460,0 +8468,3 @@ xmlDOMWrapNSNormAcquireNormalizedNs(xmlDocPtr doc,
+	/* Additional safety check to ensure the namespace is valid */
+	if (*retNs && (*retNs)->href == NULL && (*retNs)->prefix == NULL)
+	    return (-1);
@@ -8464,2 +8474 @@ xmlDOMWrapNSNormAcquireNormalizedNs(xmlDocPtr doc,
