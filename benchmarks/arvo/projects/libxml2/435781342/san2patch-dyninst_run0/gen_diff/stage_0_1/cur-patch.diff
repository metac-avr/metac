diff --git a/tree.c b/tree.c
index a93f2e31..cf84050a 100644
--- a/tree.c
+++ b/tree.c
@@ -599,2 +599,9 @@ xmlFreeNs(xmlNs *cur) {
-    if (cur->href != NULL) xmlFree((char *) cur->href);
-    if (cur->prefix != NULL) xmlFree((char *) cur->prefix);
+    // Clear content before freeing to prevent use-after-free
+    if (cur->href != NULL) {
+        xmlFree((char *) cur->href);
+        cur->href = NULL;
+    }
+    if (cur->prefix != NULL) {
+        xmlFree((char *) cur->prefix);
+        cur->prefix = NULL;
+    }
