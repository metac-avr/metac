diff --git a/tree.c b/tree.c
index a93f2e31..9d2d53ae 100644
--- a/tree.c
+++ b/tree.c
@@ -599,3 +599,8 @@ xmlFreeNs(xmlNs *cur) {
-    if (cur->href != NULL) xmlFree((char *) cur->href);
-    if (cur->prefix != NULL) xmlFree((char *) cur->prefix);
-    xmlFree(cur);
+// FIXME: Crash CWE-416: Use After Free
+    /* Implement safe freeing with validation context check */
+    if (cur->next != (xmlNsPtr)(-1)) {  /* Check if already freed marker */
+        if (cur->href != NULL) xmlFree((char *) cur->href);
+        if (cur->prefix != NULL) xmlFree((char *) cur->prefix);
+        cur->next = (xmlNsPtr)(-1);  /* Mark as freed */
+        xmlFree(cur);
+    }
