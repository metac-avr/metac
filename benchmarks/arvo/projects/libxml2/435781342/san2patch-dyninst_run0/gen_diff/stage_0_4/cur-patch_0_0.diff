diff --git a/tree.c b/tree.c
index a93f2e31..d9029fe1 100644
--- a/tree.c
+++ b/tree.c
@@ -599 +599,9 @@ xmlFreeNs(xmlNs *cur) {
-    if (cur->href != NULL) xmlFree((char *) cur->href);
+// FIXME: Crash CWE-416: Use After Free
+    /* Check if namespace is still referenced before freeing */
+    if (cur->context != NULL) {
+        /* Decrement reference count instead of freeing immediately */
+        if (--(cur->refcount) > 0) {
+            return;
+        }
+    }
+     if (cur->href != NULL) xmlFree((char *) cur->href);
