diff --git a/tree.c b/tree.c
index a93f2e31..fa089c00 100644
--- a/tree.c
+++ b/tree.c
@@ -599 +599,10 @@ xmlFreeNs(xmlNs *cur) {
-    if (cur->href != NULL) xmlFree((char *) cur->href);
+// FIXME: Crash CWE-416: Use After Free
+    /* Add reference counting to prevent use-after-free */
+    if (cur->_private != NULL) {
+        int *refcount = (int*)cur->_private;
+        if ((*refcount)-- > 0) {
+            return;
+        }
+        xmlFree(refcount);
+    }
+     if (cur->href != NULL) xmlFree((char *) cur->href);
