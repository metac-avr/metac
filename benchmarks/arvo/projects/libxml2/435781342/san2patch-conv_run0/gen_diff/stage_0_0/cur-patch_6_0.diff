diff --git a/SAX2.c b/SAX2.c
index 8e6ba6c7..2316b328 100644
--- a/SAX2.c
+++ b/SAX2.c
@@ -2226 +2226,2 @@ xmlSAX2StartElementNs(void *ctx,
-        pref = namespaces[i++];
+// FIXME: Crash CWE-416: Use After Free
+	 pref = namespaces[i++];
@@ -2248,2 +2249,5 @@ xmlSAX2StartElementNs(void *ctx,
-	    ctxt->valid &= xmlValidateOneNamespace(&ctxt->vctxt, ctxt->myDoc,
-	                                           ret, prefix, ns, uri);
