+	    }
diff --git a/tree.c b/tree.c
index a93f2e31..07a905ce 100644
--- a/tree.c
+++ b/tree.c
@@ -599,2 +599,7 @@ xmlFreeNs(xmlNs *cur) {
-    if (cur->href != NULL) xmlFree((char *) cur->href);
-    if (cur->prefix != NULL) xmlFree((char *) cur->prefix);
+    // Clear pointers before freeing to prevent use-after-free
+    xmlChar *href = (xmlChar *) cur->href;
+    xmlChar *prefix = (xmlChar *) cur->prefix;
+    cur->href = NULL;
+    cur->prefix = NULL;
+    if (href != NULL) xmlFree((char *) href);
+    if (prefix != NULL) xmlFree((char *) prefix);
