diff --git a/libavcodec/simple_idct_template.c b/libavcodec/simple_idct_template.c
index 5ddd0b45a2..d640785cff 100644
--- a/libavcodec/simple_idct_template.c
+++ b/libavcodec/simple_idct_template.c
@@ -148 +148 @@ static inline void FUNC6(idctRowCondDC)(idctin *row, int extra_shift)
-        }
+         }
@@ -150,4 +150,8 @@ static inline void FUNC6(idctRowCondDC)(idctin *row, int extra_shift)
-        AV_WN32A(row, temp);
-        AV_WN32A(row+2, temp);
-        AV_WN32A(row+4, temp);
-        AV_WN32A(row+6, temp);
+        
+        // Bounds check to prevent out-of-bounds write
+        if ((uintptr_t)(row + 7) <= (uintptr_t)((char*)row + 2048 - sizeof(uint32_t))) {
