-            return ret;
+        if (dest_y + 8 * linesize_y + 8 < frame->data[0] + frame->linesize[0] * frame->height) {
+            if ((ret = decode_dct_block(s, gb, last_dc, 0, dest_y, linesize_y)) < 0)
+                return ret;
+            if ((ret = decode_dct_block(s, gb, last_dc, 0, dest_y + 8, linesize_y)) < 0)
+                return ret;
+            if ((ret = decode_dct_block(s, gb, last_dc, 0, dest_y + 8 * linesize_y, linesize_y)) < 0)
+                return ret;
+            if ((ret = decode_dct_block(s, gb, last_dc, 0, dest_y + 8 * linesize_y + 8, linesize_y)) < 0)
+                return ret;
+        }
@@ -326,4 +328,8 @@ static int decode_speedhq_border(const SHQContext *s, GetBitContext *gb, AVFrame
-            if ((ret = decode_dct_block(s, gb, last_dc, 1, dest_cb + 8 * linesize_cb, linesize_cb)) < 0)
-                return ret;
-            if ((ret = decode_dct_block(s, gb, last_dc, 2, dest_cr + 8 * linesize_cr, linesize_cr)) < 0)
-                return ret;
+            if (dest_cb + 8 * linesize_cb < frame->data[1] + frame->linesize[1] * (frame->height / (s->subsampling == SHQ_SUBSAMPLING_420 ? 2 : 1))) {
+                if ((ret = decode_dct_block(s, gb, last_dc, 1, dest_cb + 8 * linesize_cb, linesize_cb)) < 0)
+                    return ret;
+            }
+            if (dest_cr + 8 * linesize_cr < frame->data[2] + frame->linesize[2] * (frame->height / (s->subsampling == SHQ_SUBSAMPLING_420 ? 2 : 1))) {
+                if ((ret = decode_dct_block(s, gb, last_dc, 2, dest_cr + 8 * linesize_cr, linesize_cr)) < 0)
+                    return ret;
+            }
@@ -336,2 +342,4 @@ static int decode_speedhq_border(const SHQContext *s, GetBitContext *gb, AVFrame
-            if ((ret = decode_alpha_block(s, gb, last_alpha, dest_a + 8 * linesize_a, linesize_a)) < 0)
-                return ret;
+            if (dest_a + 8 * linesize_a < frame->data[3] + frame->linesize[3] * frame->height) {
+                if ((ret = decode_alpha_block(s, gb, last_alpha, dest_a + 8 * linesize_a, linesize_a)) < 0)
+                    return ret;
+            }
@@ -342,6 +350,10 @@ static int decode_speedhq_border(const SHQContext *s, GetBitContext *gb, AVFrame
-            if ((ret = decode_dct_block(s, gb, last_dc, 3, dest_a + 8, linesize_a)) < 0)
-                return ret;
-            if ((ret = decode_dct_block(s, gb, last_dc, 3, dest_a + 8 * linesize_a, linesize_a)) < 0)
-                return ret;
-            if ((ret = decode_dct_block(s, gb, last_dc, 3, dest_a + 8 * linesize_a + 8, linesize_a)) < 0)
-                return ret;
+            if (dest_a + 8 < frame->data[3] + frame->linesize[3] * frame->width) {
+                if ((ret = decode_dct_block(s, gb, last_dc, 3, dest_a + 8, linesize_a)) < 0)
+                    return ret;
+            }
+            if (dest_a + 8 * linesize_a < frame->data[3] + frame->linesize[3] * frame->height) {
+                if ((ret = decode_dct_block(s, gb, last_dc, 3, dest_a + 8 * linesize_a, linesize_a)) < 0)
+                    return ret;
+                if ((ret = decode_dct_block(s, gb, last_dc, 3, dest_a + 8 * linesize_a + 8, linesize_a)) < 0)
+                    return ret;
+            }
