diff --git a/libavformat/iamf_parse.c b/libavformat/iamf_parse.c
index feb670180e..2c4c9dd111 100644
--- a/libavformat/iamf_parse.c
+++ b/libavformat/iamf_parse.c
@@ -1080 +1080,2 @@ int ff_iamfdec_read_descriptors(IAMFContext *c, AVIOContext *pb,
-            break;
+// FIXME: Crash CWE-125: Out-of-bounds Read
+             break;
@@ -1082 +1083,13 @@ int ff_iamfdec_read_descriptors(IAMFContext *c, AVIOContext *pb,
-            ret = mix_presentation_obu(log_ctx, c, pb, obu_size);
+            // Add bounds checking before processing mix presentation OBU
+            if (obu_size > 0) {
+                int64_t pos_before = avio_tell(pb);
+                ret = mix_presentation_obu(log_ctx, c, pb, obu_size);
+                // Verify that the function didn't read beyond expected bounds
+                int64_t pos_after = avio_tell(pb);
+                if (pos_after - pos_before > obu_size) {
+                    av_log(log_ctx, AV_LOG_ERROR, "Buffer overflow detected in mix presentation OBU\n");
+                    ret = AVERROR_INVALIDDATA;
+                }
+            } else {
+                ret = AVERROR_INVALIDDATA;
+            }
