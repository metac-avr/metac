-                if (s->bits & 7)
-                    shift_output(s, ptr, linesize);
+                // Check buffer bounds before IDCT operation
+                if (ptr + (bytes_per_pixel*8 >> s->avctx->lowres) <= data + (linesize * mb_height)) {
+                    s->idsp.idct_put(ptr, linesize, *block);
+                    if (s->bits & 7)
+                        shift_output(s, ptr, linesize);
+                }
