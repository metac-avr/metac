diff --git a/libavcodec/faanidct.c b/libavcodec/faanidct.c
index 3921f82dae..4e4324473c 100644
--- a/libavcodec/faanidct.c
+++ b/libavcodec/faanidct.c
@@ -165 +165,2 @@ void ff_faanidct_put(uint8_t *dest, ptrdiff_t line_size, int16_t block[64])
