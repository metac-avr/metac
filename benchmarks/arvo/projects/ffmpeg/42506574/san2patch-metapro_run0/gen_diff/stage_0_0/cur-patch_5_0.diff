diff --git a/libavcodec/jrevdct.c b/libavcodec/jrevdct.c
index a1a0f571ad..ac90b1932f 100644
--- a/libavcodec/jrevdct.c
+++ b/libavcodec/jrevdct.c
@@ -1163 +1163,12 @@ void ff_jref_idct_put(uint8_t *dest, ptrdiff_t line_size, int16_t *block)
-    ff_put_pixels_clamped_c(block, dest, line_size);
+    
+    /* Add safety checks for buffer overflow prevention */
+    if (dest && block && line_size > 0) {
+        /* Ensure we don't write beyond buffer boundaries */
+        uint8_t *safe_dest = dest;
+        ptrdiff_t safe_line_size = line_size;
+        
+        /* Validate parameters */
+        if (safe_line_size >= 8) {  /* Minimum line size for 8x8 block */
+            ff_put_pixels_clamped_c(block, safe_dest, safe_line_size);
+        }
+    }
@@ -1170 +1181 @@ void ff_jref_idct_add(uint8_t *dest, ptrdiff_t line_size, int16_t *block)
-}
+}
\ No newline at end of file
