diff --git a/libavcodec/mjpegdec.c b/libavcodec/mjpegdec.c
index 0dbbc14bae..2e6239bbce 100644
--- a/libavcodec/mjpegdec.c
+++ b/libavcodec/mjpegdec.c
@@ -2561,3 +2561,6 @@ int ff_mjpeg_receive_frame(AVCodecContext *avctx, AVFrame *frame)
-            if (!avctx->hwaccel && avctx->skip_frame != AVDISCARD_ALL &&
-                s->progressive && s->cur_scan && s->got_picture)
-                mjpeg_idct_scan_progressive_ac(s);
+// FIXME: Crash CWE-787: Out-of-bounds Write
+             if (!avctx->hwaccel && avctx->skip_frame != AVDISCARD_ALL &&
+                s->progressive && s->cur_scan && s->got_picture) {
+                if (s->mb_x < s->mb_width && s->mb_y < s->mb_height)  // Check current macroblock position
+                    mjpeg_idct_scan_progressive_ac(s);
+            }
diff --git a/libavcodec/tiff.c b/libavcodec/tiff.c
index 60773d59ed..17b99ae604 100644
--- a/libavcodec/tiff.c
+++ b/libavcodec/tiff.c
@@ -656 +656 @@ static int dng_decode_jpeg(AVCodecContext *avctx, AVFrame *frame,
-    }
+     }
@@ -704,0 +705,14 @@ static int dng_decode_jpeg(AVCodecContext *avctx, AVFrame *frame,
+    /* Prevent out-of-bounds write by validating destination coordinates */
+    if (w <= 0 || h <= 0 || dst_x < 0 || dst_y < 0) {
+        av_log(avctx, AV_LOG_ERROR, "Invalid tile dimensions or coordinates\n");
+        av_frame_unref(s->jpgframe);
+        return AVERROR_INVALIDDATA;
+    }
+    
+    if ((uint64_t)dst_x + w > (uint64_t)frame->width || 
+        (uint64_t)dst_y + h > (uint64_t)frame->height) {
+        av_log(avctx, AV_LOG_ERROR, "Tile exceeds frame boundaries\n");
+        av_frame_unref(s->jpgframe);
+        return AVERROR_INVALIDDATA;
+    }
+
