diff --git a/libavcodec/mjpegdec.c b/libavcodec/mjpegdec.c
index 0dbbc14bae..ad853d84d4 100644
--- a/libavcodec/mjpegdec.c
+++ b/libavcodec/mjpegdec.c
@@ -1622 +1622,2 @@ static void mjpeg_idct_scan_progressive_ac(MJpegDecodeContext *s)
-            int16_t (*block)[64] = &s->blocks[c][block_idx];
+// FIXME: Crash CWE-787: Out-of-bounds Write
+             int16_t (*block)[64] = &s->blocks[c][block_idx];
@@ -1624,3 +1625,6 @@ static void mjpeg_idct_scan_progressive_ac(MJpegDecodeContext *s)
-                s->idsp.idct_put(ptr, linesize, *block);
-                if (s->bits & 7)
-                    shift_output(s, ptr, linesize);
+                // Check bounds before IDCT operation to prevent buffer overflow
+                if (ptr >= data && ptr < data + (s->height * linesize >> s->avctx->lowres)) {
+                    s->idsp.idct_put(ptr, linesize, *block);
+                    if (s->bits & 7)
+                        shift_output(s, ptr, linesize);
+                }
@@ -2561,3 +2565,6 @@ int ff_mjpeg_receive_frame(AVCodecContext *avctx, AVFrame *frame)
-            if (!avctx->hwaccel && avctx->skip_frame != AVDISCARD_ALL &&
-                s->progressive && s->cur_scan && s->got_picture)
-                mjpeg_idct_scan_progressive_ac(s);
+// FIXME: Crash CWE-787: Out-of-bounds Write
+             if (!avctx->hwaccel && avctx->skip_frame != AVDISCARD_ALL &&
+                s->progressive && s->cur_scan && s->got_picture) {
+                if (s->mb_width > 0 && s->mb_height > 0)
+                    mjpeg_idct_scan_progressive_ac(s);
+            }
@@ -2573,2 +2580 @@ int ff_mjpeg_receive_frame(AVCodecContext *avctx, AVFrame *frame)
-                if (s->bottom_field == !s->interlace_polarity)
-                    break;
+                if (s->bottom_field == !s->interlace_polarity)                    break;
