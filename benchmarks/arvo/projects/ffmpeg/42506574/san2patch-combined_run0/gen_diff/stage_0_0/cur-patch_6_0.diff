diff --git a/libavcodec/mjpegdec.c b/libavcodec/mjpegdec.c
index 0dbbc14bae..1b67cf5629 100644
--- a/libavcodec/mjpegdec.c
+++ b/libavcodec/mjpegdec.c
@@ -1622 +1622,2 @@ static void mjpeg_idct_scan_progressive_ac(MJpegDecodeContext *s)
-            int16_t (*block)[64] = &s->blocks[c][block_idx];
+// FIXME: Crash CWE-787: Out-of-bounds Write
+             int16_t (*block)[64] = &s->blocks[c][block_idx];
@@ -1624,4 +1625,10 @@ static void mjpeg_idct_scan_progressive_ac(MJpegDecodeContext *s)
-                s->idsp.idct_put(ptr, linesize, *block);
-                if (s->bits & 7)
-                    shift_output(s, ptr, linesize);
-                ptr += bytes_per_pixel*8 >> s->avctx->lowres;
+                // Check if we have enough space in the buffer before writing
+                if (ptr + (bytes_per_pixel*8 >> s->avctx->lowres) <= data + (mb_height * linesize * 8 >> s->avctx->lowres)) {
+                    s->idsp.idct_put(ptr, linesize, *block);
+                    if (s->bits & 7)
+                        shift_output(s, ptr, linesize);
+                    ptr += bytes_per_pixel*8 >> s->avctx->lowres;
+                } else {
+                    // Break if there's not enough space to avoid buffer overflow
+                    break;
+                }
