@@ -735 +735 @@ int ff_mjpeg_decode_sof(MJpegDecodeContext *s)
-        if (s->avctx->pix_fmt == AV_PIX_FMT_PAL8)
+        if (s->avctx->pix_fmt == AV_PIX_FMT_PAL8) {
@@ -736,0 +737,11 @@ int ff_mjpeg_decode_sof(MJpegDecodeContext *s)
+        }
+
+        // Validate buffer dimensions to prevent out-of-bounds writes
+        if (s->picture_ptr->data[0] && s->picture_ptr->linesize[0] > 0) {
+            // Ensure buffer is properly allocated for IDCT operations
+            int min_required_size = s->mb_width * s->mb_height * 64;
+            if (s->picture_ptr->linesize[0] * s->picture_ptr->height < min_required_size) {
+                av_log(s->avctx, AV_LOG_ERROR, "Buffer size insufficient for IDCT operations\n");
+                return AVERROR_BUFFER_TOO_SMALL;
+            }
+        }
@@ -738,2 +749 @@ int ff_mjpeg_decode_sof(MJpegDecodeContext *s)
