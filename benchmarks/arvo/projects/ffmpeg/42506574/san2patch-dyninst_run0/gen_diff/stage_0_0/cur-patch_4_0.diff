diff --git a/libavcodec/tiff.c b/libavcodec/tiff.c
index 60773d59ed..cb5aa6c104 100644
--- a/libavcodec/tiff.c
+++ b/libavcodec/tiff.c
@@ -656 +656 @@ static int dng_decode_jpeg(AVCodecContext *avctx, AVFrame *frame,
-    }
+     }
@@ -708,0 +709,6 @@ static int dng_decode_jpeg(AVCodecContext *avctx, AVFrame *frame,
+    /* Bounds checking to prevent out-of-bounds writes */
+    if ((int64_t)dst_x + w > (int64_t)frame->width ||
+        (int64_t)dst_y + h > (int64_t)frame->height ||
+        dst_offset * pixel_size > frame->linesize[0] * frame->height)
+        return AVERROR_INVALIDDATA;
