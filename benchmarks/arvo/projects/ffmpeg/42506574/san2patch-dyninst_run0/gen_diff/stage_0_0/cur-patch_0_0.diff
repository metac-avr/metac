diff --git a/libavcodec/idctdsp.c b/libavcodec/idctdsp.c
index 846ed0b0f8..cbf71f559d 100644
--- a/libavcodec/idctdsp.c
+++ b/libavcodec/idctdsp.c
@@ -90,8 +90,10 @@ void ff_put_pixels_clamped_c(const int16_t *block, uint8_t *av_restrict pixels,
-        pixels[0] = av_clip_uint8(block[0]);
-        pixels[1] = av_clip_uint8(block[1]);
-        pixels[2] = av_clip_uint8(block[2]);
-        pixels[3] = av_clip_uint8(block[3]);
-        pixels[4] = av_clip_uint8(block[4]);
-        pixels[5] = av_clip_uint8(block[5]);
-        pixels[6] = av_clip_uint8(block[6]);
-        pixels[7] = av_clip_uint8(block[7]);
+        if (line_size >= 8) {  // Prevent out-of-bounds write by checking line_size
+            pixels[0] = av_clip_uint8(block[0]);
+            pixels[1] = av_clip_uint8(block[1]);
+            pixels[2] = av_clip_uint8(block[2]);
+            pixels[3] = av_clip_uint8(block[3]);
+            pixels[4] = av_clip_uint8(block[4]);
+            pixels[5] = av_clip_uint8(block[5]);
+            pixels[6] = av_clip_uint8(block[6]);
+            pixels[7] = av_clip_uint8(block[7]);
+        }
diff --git a/libavcodec/mjpegdec.c b/libavcodec/mjpegdec.c
index 0dbbc14bae..a73dd36bef 100644
--- a/libavcodec/mjpegdec.c
+++ b/libavcodec/mjpegdec.c
@@ -1622 +1622,2 @@ static void mjpeg_idct_scan_progressive_ac(MJpegDecodeContext *s)
-            int16_t (*block)[64] = &s->blocks[c][block_idx];
+// FIXME: Crash CWE-787: Out-of-bounds Write
+             int16_t (*block)[64] = &s->blocks[c][block_idx];
@@ -1624,3 +1625,6 @@ static void mjpeg_idct_scan_progressive_ac(MJpegDecodeContext *s)
-                s->idsp.idct_put(ptr, linesize, *block);
-                if (s->bits & 7)
-                    shift_output(s, ptr, linesize);
+                // Check bounds before writing pixels
+                if (ptr >= data && ptr < data + (s->height * linesize >> s->avctx->lowres)) {
+                    s->idsp.idct_put(ptr, linesize, *block);
+                    if (s->bits & 7)
+                        shift_output(s, ptr, linesize);
+                }
