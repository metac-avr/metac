diff --git a/libavcodec/flashsv.c b/libavcodec/flashsv.c
index 00f77f4902..a23cce1af9 100644
--- a/libavcodec/flashsv.c
+++ b/libavcodec/flashsv.c
@@ -152,0 +153,18 @@ static int flashsv2_prime(FlashSVContext *s, uint8_t *src, int size)
+    // Check if tmpblock needs reallocation and handle potential realloc failure
+    if (s->block_size * 3 > s->tmpblock_size) {
+        uint8_t *new_tmpblock = av_realloc(s->tmpblock, s->block_size * 3);
+        if (!new_tmpblock)
+            return AVERROR(ENOMEM);
+        s->tmpblock = new_tmpblock;
+        s->tmpblock_size = s->block_size * 3;
+    }
+    
+    // Check if deflate_block needs reallocation and handle potential realloc failure
+    if (s->block_size * 3 > s->deflate_block_size) {
+        uint8_t *new_deflate_block = av_realloc(s->deflate_block, s->block_size * 3);
+        if (!new_deflate_block)
+            return AVERROR(ENOMEM);
+        s->deflate_block = new_deflate_block;
+        s->deflate_block_size = s->block_size * 3;
+    }
+
