-        return AVERROR_INVALIDDATA;
-    }
-
@@ -357 +364,2 @@ static int flashsv_decode_frame(AVCodecContext *avctx, void *data,
-    if (s->is_keyframe) {
+// FIXME: Crash CWE-416: Use After Free
+     if (s->is_keyframe) {
@@ -358,0 +367,8 @@ static int flashsv_decode_frame(AVCodecContext *avctx, void *data,
+        void *old_data = s->keyframedata;
+        size_t old_size = avpkt->size;
+        
+        // Validate input before reallocation
+        if (!avpkt->data || avpkt->size == 0) {
+            return AVERROR_INVALIDDATA;
+        }
+        
@@ -361 +377,8 @@ static int flashsv_decode_frame(AVCodecContext *avctx, void *data,
-        memcpy(s->keyframedata, avpkt->data, avpkt->size);
+            
+        // Check if reallocation succeeded and pointer is valid
