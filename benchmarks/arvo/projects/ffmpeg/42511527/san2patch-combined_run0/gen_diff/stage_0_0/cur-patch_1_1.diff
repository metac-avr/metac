index 00f77f4902..6389a07125 100644
--- a/libavcodec/flashsv.c
+++ b/libavcodec/flashsv.c
@@ -187 +187 @@ static int flashsv_decode_block(AVCodecContext *avctx, const AVPacket *avpkt,
-    struct FlashSVContext *s = avctx->priv_data;
+    FlashSVContext *s = avctx->priv_data;
@@ -195 +195 @@ static int flashsv_decode_block(AVCodecContext *avctx, const AVPacket *avpkt,
-    if (s->zlibprime_curr || s->zlibprime_prev) {
+    if ((s->zlibprime_curr || s->zlibprime_prev) && s->keyframedata) {
@@ -217 +217 @@ static int flashsv_decode_block(AVCodecContext *avctx, const AVPacket *avpkt,
-    if (s->is_keyframe) {
+    if (s->is_keyframe && s->keyframedata) {
@@ -348,0 +349,207 @@ static int flashsv_decode_frame(AVCodecContext *avctx, void *data,
+#include "libavutil/imgutils.h"
+#include "libavutil/internal.h"
+#include "libavutil/intfloat.h"
+
+#include "avcodec.h"
+#include "internal.h"
+#include "get_bits.h"
+
+#if HAVE_ZLIB
+#include <zlib.h>
+
+/* 
+ * Flash Screen Video decoder
+ * Copyright (c) 2007-2008 Alec Voropay <al.voropay@gmail.com>
+ */
+
+typedef struct FlashSVContext {
+    AVFrame *frame;
+    int image_width, image_height;
+    int block_width, block_height;
+    int use_custom_palette;
+    int palette[256];
+    int map_mask_bits;
+    int is_keyframe;
+    int ver;
+    int rows, cols;
+    int block_size;
+    int diff_start, diff_height;
+    int color_depth;
+    uint8_t *keyframedata;
+    int keyframe_size;
+    z_stream zstream;
+    int zlibprime_prev, zlibprime_curr;
+    int blocks_size;
+    struct Block {
+        uint8_t *pos;
+        int size;
+    } *blocks;
+    uint8_t tmpblock[64*64*3];
+    uint32_t pal[256];
+} FlashSVContext;
+
+static av_cold int flashsv_decode_init(AVCodecContext *avctx)
+{
+    FlashSVContext *s = avctx->priv_data;
+
+    avctx->pix_fmt = AV_PIX_FMT_BGR24;
+
+    s->zstream.zalloc = Z_NULL;
+    s->zstream.zfree = Z_NULL;
+    s->zstream.opaque = Z_NULL;
+    if (inflateInit(&s->zstream) != Z_OK) {
+        av_log(avctx, AV_LOG_ERROR, "Inflate init error\n");
+        return AVERROR_UNKNOWN;
+    }
+
+    return 0;
+}
+
+static av_cold int flashsv_decode_end(AVCodecContext *avctx)
+{
+    FlashSVContext *s = avctx->priv_data;
+
+    inflateEnd(&s->zstream);
+    av_freep(&s->keyframedata);
+    av_freep(&s->blocks);
+
+    return 0;
+}
+
+static int flashsv2_prime(FlashSVContext *s, uint8_t *src, int src_len)
+{
+    int ret;
+
+    ret = inflateReset(&s->zstream);
+    if (ret != Z_OK) {
+        return AVERROR_UNKNOWN;
+    }
+
+    s->zstream.next_in = src;
+    s->zstream.avail_in = src_len;
+    s->zstream.next_out = NULL;
+    s->zstream.avail_out = 0;
+
+    ret = inflate(&s->zstream, Z_SYNC_FLUSH);
+    if (ret != Z_OK && ret != Z_STREAM_END) {
+        return AVERROR_UNKNOWN;
+    }
+
+    return 0;
+}
+
+static int decode_hybrid(uint8_t *in_buf, uint8_t *out_buf,
+                         uint8_t *dst, int dst_row, int dst_col, int height,
+                         int width, int stride, uint32_t *pal)
+{
+    int i, j;
+    uint8_t *row;
+
+    for (i = 0; i < height; i++) {
+        row = dst + (dst_row + i) * stride + dst_col * 3;
+        for (j = 0; j < width; j++) {
+            uint8_t idx = *in_buf++;
+            uint32_t rgb = pal[idx];
+            *row++ = rgb & 0xFF;
+            *row++ = (rgb >> 8) & 0xFF;
+            *row++ = (rgb >> 16) & 0xFF;
+        }
+    }
+
+    return 0;
+}
+
+static int flashsv_decode_block(AVCodecContext *avctx, const AVPacket *avpkt,
+                                GetBitContext *gb, int block_size,
+                                int width, int height, int x_pos, int y_pos,
+                                int blk_idx)
+{
+    FlashSVContext *s = avctx->priv_data;
+    uint8_t *line = s->tmpblock;
+    int k;
+    int ret = inflateReset(&s->zstream);
+    if (ret != Z_OK) {
+        av_log(avctx, AV_LOG_ERROR, "Inflate reset error: %d\n", ret);
+        return AVERROR_UNKNOWN;
+    }
+    if ((s->zlibprime_curr || s->zlibprime_prev) && s->keyframedata) {
+        ret = flashsv2_prime(s,
+                             s->blocks[blk_idx].pos,
+                             s->blocks[blk_idx].size);
+        if (ret < 0)
+            return ret;
+    }
+    s->zstream.next_in   = avpkt->data + get_bits_count(gb) / 8;
+    s->zstream.avail_in  = block_size;
+    s->zstream.next_out  = s->tmpblock;
+    s->zstream.avail_out = s->block_size * 3;
+    ret = inflate(&s->zstream, Z_FINISH);
+    if (ret == Z_DATA_ERROR) {
+        av_log(avctx, AV_LOG_ERROR, "Zlib resync occurred\n");
+        inflateSync(&s->zstream);
+        ret = inflate(&s->zstream, Z_FINISH);
+    }
+
+    if (ret != Z_OK && ret != Z_STREAM_END) {
+        //return -1;
+    }
+
+    if (s->is_keyframe && s->keyframedata) {
+        s->blocks[blk_idx].pos  = s->keyframedata + (get_bits_count(gb) / 8);
+        s->blocks[blk_idx].size = block_size;
+    }
+
+    y_pos += s->diff_start;
+
+    if (!s->color_depth) {
+        /* Flash Screen Video stores the image upside down, so copy
+         * lines to destination in reverse order. */
+        for (k = 1; k <= s->diff_height; k++) {
+            memcpy(s->frame->data[0] + x_pos * 3 +
+                   (s->image_height - y_pos - k) * s->frame->linesize[0],
+                   line, width * 3);
+            /* advance source pointer to next line */
+            line += width * 3;
+        }
+    } else {
+        /* hybrid 15-bit/palette mode */
+        ret = decode_hybrid(s->tmpblock, s->zstream.next_out,
+                      s->frame->data[0],
+                      s->image_height - (y_pos + 1 + s->diff_height),
+                      x_pos, s->diff_height, width,
+                      s->frame->linesize[0], s->pal);
+        if (ret < 0) {
+            av_log(avctx, AV_LOG_ERROR, "decode_hybrid failed\n");
+            return ret;
+        }
+    }
+    skip_bits_long(gb, 8 * block_size); /* skip the consumed bits */
+    return 0;
+}
+
+static int flashsv_decode_frame(AVCodecContext *avctx, void *data,
+                               int *got_frame, AVPacket *avpkt)
+{
+    FlashSVContext *s = avctx->priv_data;
+    GetBitContext gb;
+    int h_blocks, v_blocks, h_part, v_part;
+    int i, j, ret;
+
+    if (avpkt->size < 3) {
+        av_log(avctx, AV_LOG_ERROR, "Packet is too small\n");
+        return AVERROR_INVALIDDATA;
+    }
+
+    if ((ret = ff_reget_buffer(avctx, s->frame, 0)) < 0)
+        return ret;
+
+    /* init bit reader */
+    init_get_bits(&gb, avpkt->data, avpkt->size * 8);
+
+    s->block_width  = get_bits(&gb, 8);
+    s->block_height = get_bits(&gb, 8);
+    s->image_width  = get_bits(&gb, 16);
+    s->image_height = get_bits(&gb, 16);
+
+    if (s->image_width != avctx->width || s->image_height != avctx->height) {
+        av_log(avctx, AV_LOG_ERROR,
@@ -361 +568,3 @@ static int flashsv_decode_frame(AVCodecContext *avctx, void *data,
-        memcpy(s->keyframedata, avpkt->data, avpkt->size);
+        if (s->keyframedata) {
+            memcpy(s->keyframedata, avpkt->data, avpkt->size);
+        }
@@ -370,0 +580,34 @@ static int flashsv_decode_frame(AVCodecContext *avctx, void *data,
+    *got_frame = 1;
+    if ((ret = av_frame_ref(data, s->frame)) < 0)
+        return ret;
+
+    return avpkt->size;
+}
+
+#if CONFIG_FLASHSV_DECODER
+AVCodec ff_flashsv_decoder = {
+    .name           = "flashsv",
+    .long_name      = NULL_IF_CONFIG_SMALL("Flash Screen Video v1"),
+    .type           = AVMEDIA_TYPE_VIDEO,
+    .id             = AV_CODEC_ID_FLASHSV,
+    .priv_data_size = sizeof(FlashSVContext),
+    .init           = flashsv_decode_init,
+    .close          = flashsv_decode_end,
+    .decode         = flashsv_decode_frame,
+    .capabilities   = AV_CODEC_CAP_DR1,
+};
+#endif
+
+#if CONFIG_FLASHSV2_DECODER
+AVCodec ff_flashsv2_decoder = {
+    .name           = "flashsv2",
+    .long_name      = NULL_IF_CONFIG_SMALL("Flash Screen Video v2"),
+    .type           = AVMEDIA_TYPE_VIDEO,
+    .id             = AV_CODEC_ID_FLASHSV2,
+    .priv_data_size = sizeof(FlashSVContext),
+    .init           = flashsv_decode_init,
+    .close          = flashsv_decode_end,
+    .decode         = flashsv_decode_frame,
+    .capabilities   = AV_CODEC_CAP_DR1,
+};
+#endif
