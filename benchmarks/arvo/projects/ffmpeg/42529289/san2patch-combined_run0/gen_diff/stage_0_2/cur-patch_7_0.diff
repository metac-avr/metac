diff --git a/libavcodec/bitstream_template.h b/libavcodec/bitstream_template.h
index 0308e3a924..f9d6031278 100644
--- a/libavcodec/bitstream_template.h
+++ b/libavcodec/bitstream_template.h
@@ -529 +529,2 @@ static inline int BS_FUNC(read_vlc_multi)(BSCTX *bc, uint8_t *dst,
-    int ret, nb_bits, code, n = Jtable[idx].len;
+// FIXME: Crash CWE-787: Out-of-bounds Write
+     int ret, nb_bits, code, n = Jtable[idx].len;
@@ -531 +532,15 @@ static inline int BS_FUNC(read_vlc_multi)(BSCTX *bc, uint8_t *dst,
-        AV_COPY64U(dst, Jtable[idx].val);
+        // Add bounds checking before 8-byte write operation
+        if ((uintptr_t)(dst + 8) <= (uintptr_t)(dst) + 65536) {
+            AV_COPY64U(dst, Jtable[idx].val);
+        } else {
+            // Prevent out-of-bounds write by limiting to available space
+            int remaining_space = 65536 - (dst - (uint8_t*)0);
+            if (remaining_space >= 8) {
+                AV_COPY64U(dst, Jtable[idx].val);
+            } else {
+                // Fallback for insufficient space
+                for (int i = 0; i < 8 && i < remaining_space; i++) {
+                    dst[i] = ((uint8_t*)&Jtable[idx].val)[i];
+                }
+            }
+        }
