diff --git a/libavcodec/bitstream_template.h b/libavcodec/bitstream_template.h
index 0308e3a924..829b31c79b 100644
--- a/libavcodec/bitstream_template.h
+++ b/libavcodec/bitstream_template.h
@@ -529 +529,2 @@ static inline int BS_FUNC(read_vlc_multi)(BSCTX *bc, uint8_t *dst,
-    int ret, nb_bits, code, n = Jtable[idx].len;
+// FIXME: Crash CWE-787: Out-of-bounds Write
+     int ret, nb_bits, code, n = Jtable[idx].len;
@@ -530,0 +532,4 @@ static inline int BS_FUNC(read_vlc_multi)(BSCTX *bc, uint8_t *dst,
+        /* Check for sufficient buffer space before writing 8 bytes */
+        if ((uintptr_t)(dst + 8) > (uintptr_t)bc->buffer_end) {
+            return AVERROR_INVALIDDATA; /* Prevent out-of-bounds write */
+        }
@@ -543,0 +549,4 @@ static inline int BS_FUNC(read_vlc_multi)(BSCTX *bc, uint8_t *dst,
+        /* Check for sufficient buffer space before writing 2 bytes */
+        if ((uintptr_t)(dst + 2) > (uintptr_t)bc->buffer_end) {
+            return AVERROR_INVALIDDATA; /* Prevent out-of-bounds write */
+        }
