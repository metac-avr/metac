diff --git a/libavcodec/bitstream_template.h b/libavcodec/bitstream_template.h
index 0308e3a924..a11b3e9c7a 100644
--- a/libavcodec/bitstream_template.h
+++ b/libavcodec/bitstream_template.h
@@ -529 +529,2 @@ static inline int BS_FUNC(read_vlc_multi)(BSCTX *bc, uint8_t *dst,
-    int ret, nb_bits, code, n = Jtable[idx].len;
+// FIXME: Crash CWE-787: Out-of-bounds Write
+     int ret, nb_bits, code, n = Jtable[idx].len;
@@ -530,0 +532,5 @@ static inline int BS_FUNC(read_vlc_multi)(BSCTX *bc, uint8_t *dst,
+        /* Boundary check for 8-byte write operation */
+        if (dst + 8 > bc->buffer_end) {
+            av_log(NULL, AV_LOG_ERROR, "Buffer overflow detected in read_vlc_multi\n");
+            return AVERROR_PATCHWELCOME; /* Return error instead of crashing */
+        }
@@ -543,0 +550,5 @@ static inline int BS_FUNC(read_vlc_multi)(BSCTX *bc, uint8_t *dst,
+        /* Boundary check for 2-byte write operation */
+        if (dst + 2 > bc->buffer_end) {
+            av_log(NULL, AV_LOG_ERROR, "Buffer overflow detected in read_vlc_multi\n");
+            return AVERROR_PATCHWELCOME; /* Return error instead of crashing */
+        }
