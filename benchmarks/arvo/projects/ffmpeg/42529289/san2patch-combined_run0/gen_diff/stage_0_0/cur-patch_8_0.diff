diff --git a/libavcodec/bitstream_template.h b/libavcodec/bitstream_template.h
index 0308e3a924..6c695b0185 100644
--- a/libavcodec/bitstream_template.h
+++ b/libavcodec/bitstream_template.h
@@ -114,0 +115,8 @@ static inline int BS_FUNC(init)(BSCTX *bc, const uint8_t *buffer,
+    // Validate buffer size to prevent heap overflow
+    if (buffer_size > (65536 - 8)) {  // Reserve 8 bytes for safety margin
+        bc->buffer     = NULL;
+        bc->ptr        = NULL;
+        bc->bits_valid = 0;
+        return AVERROR_INVALIDDATA;
+    }
+
