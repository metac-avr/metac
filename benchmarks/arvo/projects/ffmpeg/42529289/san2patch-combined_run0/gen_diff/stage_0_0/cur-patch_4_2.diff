diff --git a/libavcodec/bitstream_template.h b/libavcodec/bitstream_template.h
index 0308e3a924..f081bcf0c3 100644
--- a/libavcodec/bitstream_template.h
+++ b/libavcodec/bitstream_template.h
@@ -121,0 +122,11 @@ static inline int BS_FUNC(init)(BSCTX *bc, const uint8_t *buffer,
+    /* Validate buffer has sufficient space before refill */
+    if (buffer_size < 8) {
+        /* Not enough bytes to fill 64 bits, adjust accordingly */
+        if (buffer_size == 0) {
+            bc->buffer     = NULL;
+            bc->ptr        = NULL;
+            bc->bits_valid = 0;
+            return AVERROR_INVALIDDATA;
+        }
+    }
