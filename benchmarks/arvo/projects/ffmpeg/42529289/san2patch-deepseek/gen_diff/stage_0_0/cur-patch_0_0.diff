diff --git a/libavcodec/magicyuv.c b/libavcodec/magicyuv.c
index bbaf14d0e0..a378a3fa85 100644
--- a/libavcodec/magicyuv.c
+++ b/libavcodec/magicyuv.c
@@ -642 +642,2 @@ static int magy_decode_frame(AVCodecContext *avctx, AVFrame *p,
-    p->flags |= AV_FRAME_FLAG_KEY;
+// FIXME: Crash CWE-787: Out-of-bounds Write
+     p->flags |= AV_FRAME_FLAG_KEY;
@@ -646,0 +648,13 @@ static int magy_decode_frame(AVCodecContext *avctx, AVFrame *p,
+    {
+        int plane;
+        for (plane = 0; plane < av_pix_fmt_desc_get(avctx->pix_fmt)->nb_components; plane++) {
+            int width  = AV_CEIL_RSHIFT(avctx->width,  plane ? av_pix_fmt_desc_get(avctx->pix_fmt)->log2_chroma_w : 0);
+            int height = AV_CEIL_RSHIFT(avctx->height, plane ? av_pix_fmt_desc_get(avctx->pix_fmt)->log2_chroma_h : 0);
+            if ((uint64_t)width * height > p->linesize[plane] * (uint64_t)height ||
+                p->linesize[plane] * (uint64_t)height > (uint64_t)INT_MAX) {
+                av_log(avctx, AV_LOG_ERROR, "Plane %d dimensions exceed allocated buffer\n", plane);
+                return AVERROR_INVALIDDATA;
+            }
+        }
+    }
+
