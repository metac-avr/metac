diff --git a/libavcodec/magicyuv.c b/libavcodec/magicyuv.c
index bbaf14d0e0..07bad01c4d 100644
--- a/libavcodec/magicyuv.c
+++ b/libavcodec/magicyuv.c
@@ -642 +642,2 @@ static int magy_decode_frame(AVCodecContext *avctx, AVFrame *p,
-    p->flags |= AV_FRAME_FLAG_KEY;
+// FIXME: Crash CWE-787: Out-of-bounds Write
+     p->flags |= AV_FRAME_FLAG_KEY;
@@ -646,0 +648,13 @@ static int magy_decode_frame(AVCodecContext *avctx, AVFrame *p,
+    {
+        int plane;
+        const AVPixFmtDescriptor *desc = av_pix_fmt_desc_get(avctx->pix_fmt);
+        for (plane = 0; plane < desc->nb_components; plane++) {
+            int plane_width  = AV_CEIL_RSHIFT(avctx->width,  plane ? desc->log2_chroma_w : 0);
+            int plane_height = AV_CEIL_RSHIFT(avctx->height, plane ? desc->log2_chroma_h : 0);
+            if (plane_height > 0 && (uint64_t)plane_width * plane_height > (uint64_t)p->linesize[plane] * plane_height) {
+                av_log(avctx, AV_LOG_ERROR, "Plane %d size exceeds buffer\n", plane);
+                return AVERROR_INVALIDDATA;
+            }
+        }
+    }
+
