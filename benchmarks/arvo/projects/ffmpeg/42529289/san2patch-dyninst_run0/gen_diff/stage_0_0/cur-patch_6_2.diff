diff --git a/libavcodec/bitstream_template.h b/libavcodec/bitstream_template.h
index 0308e3a924..b0c0fa3f2c 100644
--- a/libavcodec/bitstream_template.h
+++ b/libavcodec/bitstream_template.h
@@ -529 +529 @@ static inline int BS_FUNC(read_vlc_multi)(BSCTX *bc, uint8_t *dst,
-    int ret, nb_bits, code, n = Jtable[idx].len;
+     int ret, nb_bits, code, n = Jtable[idx].len;
@@ -531 +531,8 @@ static inline int BS_FUNC(read_vlc_multi)(BSCTX *bc, uint8_t *dst,
-        AV_COPY64U(dst, Jtable[idx].val);
+        // Check bounds before copying 8 bytes
+        if (dst + 8 <= bc->buffer_end) {
+            AV_COPY64U(dst, Jtable[idx].val);
+        } else {
+            // Handle case where we can't copy full 8 bytes
+            *(uint32_t*)dst = *(uint32_t*)&Jtable[idx].val;
+            *(uint32_t*)(dst + 4) = *(uint32_t*)(((uint8_t*)&Jtable[idx].val) + 4);
+        }
@@ -544 +551,4 @@ static inline int BS_FUNC(read_vlc_multi)(BSCTX *bc, uint8_t *dst,
-        AV_WN16(dst, code);
+        // Add bounds check before writing 2 bytes
+        if (dst + 2 <= bc->buffer_end) {
+            AV_WN16(dst, code);
+        }
