-        return AVERROR_INVALIDDATA;
+    return AVERROR_INVALIDDATA;
@@ -641,0 +642 @@ static int magy_decode_frame(AVCodecContext *avctx, AVFrame *p,
+// FIXME: Crash CWE-787: Out-of-bounds Write
@@ -650,0 +652,4 @@ static int magy_decode_frame(AVCodecContext *avctx, AVFrame *p,
+    // Bounds checking before accessing pixel formats
+    if (!avctx->pix_fmt || avctx->pix_fmt >= AV_PIX_FMT_NB)
+        return AVERROR_INVALIDDATA;
+    
@@ -654,2 +659 @@ static int magy_decode_frame(AVCodecContext *avctx, AVFrame *p,
-        avctx->pix_fmt == AV_PIX_FMT_GBRAP10||
-        avctx->pix_fmt == AV_PIX_FMT_GBRAP12||
+        avctx->pix_fmt == AV_PIX_FMT_GBRAP10||        avctx->pix_fmt == AV_PIX_FMT_GBRAP12||
