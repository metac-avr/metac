diff --git a/libavcodec/bitstream_template.h b/libavcodec/bitstream_template.h
index 0308e3a924..142de6f9d4 100644
--- a/libavcodec/bitstream_template.h
+++ b/libavcodec/bitstream_template.h
@@ -529 +529 @@ static inline int BS_FUNC(read_vlc_multi)(BSCTX *bc, uint8_t *dst,
-    int ret, nb_bits, code, n = Jtable[idx].len;
+     int ret, nb_bits, code, n = Jtable[idx].len;
@@ -531 +531,10 @@ static inline int BS_FUNC(read_vlc_multi)(BSCTX *bc, uint8_t *dst,
-        AV_COPY64U(dst, Jtable[idx].val);
+        // Bounds check for 8-byte copy operation
+        if (dst + 8 <= bc->buffer_end) {
+            AV_COPY64U(dst, Jtable[idx].val);
+        } else if (dst + 4 <= bc->buffer_end) {
+            // Copy only 4 bytes if 8 won't fit
+            *(uint32_t*)dst = *(uint32_t*)&Jtable[idx].val;
+        } else if (dst + 2 <= bc->buffer_end) {
+            // Copy only 2 bytes if 4 won't fit
+            AV_WN16(dst, *(uint16_t*)&Jtable[idx].val);
+        }
@@ -544 +553,4 @@ static inline int BS_FUNC(read_vlc_multi)(BSCTX *bc, uint8_t *dst,
-        AV_WN16(dst, code);
+        // Bounds check for 2-byte write operation
+        if (dst + 2 <= bc->buffer_end) {
+            AV_WN16(dst, code);
+        }
