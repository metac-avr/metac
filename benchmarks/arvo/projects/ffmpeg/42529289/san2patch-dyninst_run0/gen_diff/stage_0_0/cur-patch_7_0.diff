-    avctx->execute2(avctx, s->magy_decode_slice, NULL, NULL, s->nb_slices);
+    if (s->nb_slices > 0 && s->nb_slices < 1000)  // Validate slice count
+        avctx->execute2(avctx, s->magy_decode_slice, NULL, NULL, s->nb_slices);
@@ -654,2 +656 @@ static int magy_decode_frame(AVCodecContext *avctx, AVFrame *p,
-        avctx->pix_fmt == AV_PIX_FMT_GBRAP10||
