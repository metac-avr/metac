diff --git a/libavutil/aes.c b/libavutil/aes.c
index 029d738f87..443962dba7 100644
--- a/libavutil/aes.c
+++ b/libavutil/aes.c
@@ -234,0 +235,4 @@ int av_aes_init(AVAES *a, const uint8_t *key, int key_bits, int decrypt)
+    // Add bounds checking for KC
+    if (KC < 4 || KC > 8) 
+        return AVERROR(EINVAL);
+
@@ -241,3 +245,15 @@ int av_aes_init(AVAES *a, const uint8_t *key, int key_bits, int decrypt)
-        for (i = 0; i < 4; i++)
-            tk[0][i] ^= sbox[tk[KC - 1][(i + 1) & 3]];
-        tk[0][0] ^= rcon[rconpointer++];
+        for (i = 0; i < 4; i++) {
+            // Ensure array bounds are not exceeded
+            int idx1 = KC - 1;
+            int idx2 = (i + 1) & 3;
+            if (idx1 >= 0 && idx1 < 8 && idx2 >= 0 && idx2 < 4) {
+                tk[0][i] ^= sbox[tk[idx1][idx2]];
+            } else {
+                return AVERROR(EINVAL);
+            }
+        }
+        if (rconpointer >= 0 && rconpointer < sizeof(rcon)/sizeof(rcon[0])) {
+            tk[0][0] ^= rcon[rconpointer++];
+        } else {
+            return AVERROR(EINVAL);
+        }
@@ -252 +268 @@ int av_aes_init(AVAES *a, const uint8_t *key, int key_bits, int decrypt)
-        }
+         }
@@ -254 +270,6 @@ int av_aes_init(AVAES *a, const uint8_t *key, int key_bits, int decrypt)
-        memcpy(a->round_key[0].u8 + t, tk, KC * 4);
+        // Validate destination buffer bounds
+        if (t >= 0 && t + KC * 4 <= sizeof(a->round_key[0].u8)) {
+            memcpy(a->round_key[0].u8 + t, tk, KC * 4);
+        } else {
+            return AVERROR(EINVAL);
+        }
