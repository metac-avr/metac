diff --git a/libavcodec/cbs.c b/libavcodec/cbs.c
index daf7f66427..62d1072960 100644
--- a/libavcodec/cbs.c
+++ b/libavcodec/cbs.c
@@ -395,0 +396,6 @@ static int cbs_write_unit_data(CodedBitstreamContext *ctx,
+    // Fix: Check for negative size before memcpy
+    if (unit->data_size < 0) {
+        av_log(ctx->log_ctx, AV_LOG_ERROR, "Invalid negative data size detected: %d\n", unit->data_size);
+        return AVERROR(EINVAL);
+    }
