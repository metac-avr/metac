diff --git a/libavcodec/cbs_h2645.c b/libavcodec/cbs_h2645.c
index 0a1c8ea426..7a235f06fc 100644
--- a/libavcodec/cbs_h2645.c
+++ b/libavcodec/cbs_h2645.c
@@ -1214,4 +1214,9 @@ static int cbs_h2645_write_slice_data(CodedBitstreamContext *ctx,
