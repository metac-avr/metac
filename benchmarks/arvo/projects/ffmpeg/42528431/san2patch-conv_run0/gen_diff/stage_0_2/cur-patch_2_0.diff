diff --git a/libavcodec/cbs_h2645.c b/libavcodec/cbs_h2645.c
index 0a1c8ea426..404b17e37c 100644
--- a/libavcodec/cbs_h2645.c
+++ b/libavcodec/cbs_h2645.c
@@ -706,13 +706,4 @@ static int cbs_h2645_split_fragment(CodedBitstreamContext *ctx,
-        // Annex B, or later MP4 with already-known parameters.
-
-        err = ff_h2645_packet_split(&priv->read_packet,
-                                    frag->data, frag->data_size,
-                                    ctx->log_ctx,
-                                    priv->mp4, priv->nal_length_size,
-                                    codec_id, 1, 1);
-        if (err < 0)
-            return err;
-
-        err = cbs_h2645_fragment_add_nals(ctx, frag, &priv->read_packet);
-        if (err < 0)
-            return err;
+    // Fixed: Validate input parameters before processing to prevent integer overflow
+    if (!frag->data || frag->data_size <= 0) {
+        av_log(ctx->log_ctx, AV_LOG_ERROR, "Invalid fragment data or size\n");
+        return AVERROR_INVALIDDATA;
@@ -719,0 +711,13 @@ static int cbs_h2645_split_fragment(CodedBitstreamContext *ctx,
+    
+    err = ff_h2645_packet_split(&priv->read_packet,
+                                frag->data, frag->data_size,
+                                ctx->log_ctx,
+                                priv->mp4, priv->nal_length_size,
+                                codec_id, 1, 1);
+    if (err < 0)
+        return err;
+
+    err = cbs_h2645_fragment_add_nals(ctx, frag, &priv->read_packet);
+    if (err < 0)
+        return err;
+}
@@ -1214 +1218,2 @@ static int cbs_h2645_write_slice_data(CodedBitstreamContext *ctx,
-        // This happens normally for CABAC.
+// FIXME: Crash CWE-787: Out-of-bounds Write
+         // This happens normally for CABAC.
@@ -1216,2 +1221,4 @@ static int cbs_h2645_write_slice_data(CodedBitstreamContext *ctx,
-        memcpy(put_bits_ptr(pbc), pos, rest);
-        skip_put_bytes(pbc, rest);
+        if (rest > 0 && pos + rest <= data + data_size) {
+            memcpy(put_bits_ptr(pbc), pos, rest);
+            skip_put_bytes(pbc, rest);
+        }
