@@ -471,0 +473,9 @@ int ff_h2645_packet_split(H2645Packet *pkt, const uint8_t *buf, int length,
+    // Prevent integer overflow by using 64-bit arithmetic and bounds checking
+    if (length < 0) {
+        return AVERROR_INVALIDDATA;
