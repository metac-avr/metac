diff --git a/libavcodec/cbs_h2645.c b/libavcodec/cbs_h2645.c
index 0a1c8ea426..0233fe93e8 100644
--- a/libavcodec/cbs_h2645.c
+++ b/libavcodec/cbs_h2645.c
@@ -1214,4 +1214,7 @@ static int cbs_h2645_write_slice_data(CodedBitstreamContext *ctx,
-        // This happens normally for CABAC.
-        flush_put_bits(pbc);
-        memcpy(put_bits_ptr(pbc), pos, rest);
-        skip_put_bytes(pbc, rest);
+// FIXME: Crash CWE-190: Integer Overflow or Wraparound
+         // This happens normally for CABAC.
+        if (rest > 0 && pos + rest >= pos) {  // Check for integer overflow in address calculation
+            flush_put_bits(pbc);
+            memcpy(put_bits_ptr(pbc), pos, rest);
+            skip_put_bytes(pbc, rest);
+        }
