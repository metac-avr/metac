diff --git a/libavformat/demux.c b/libavformat/demux.c
index 2e1d0ed66d..b132e60742 100644
--- a/libavformat/demux.c
+++ b/libavformat/demux.c
@@ -314,0 +315,15 @@ int avformat_open_input(AVFormatContext **ps, const char *filename,
+    // Validate stream parameters to prevent buffer overflow in channel layout handling
+    if (s->nb_streams > 0 && s->streams) {
+        for (unsigned int i = 0; i < s->nb_streams; i++) {
+            if (s->streams[i] && s->streams[i]->codecpar) {
+                AVCodecParameters *par = s->streams[i]->codecpar;
+                if (par->ch_layout.order == AV_CHANNEL_ORDER_CUSTOM && 
+                    par->ch_layout.nb_channels > 32) {
+                    av_log(s, AV_LOG_ERROR, "Channel layout size exceeds maximum allowed\n");
+                    ret = AVERROR_INVALIDDATA;
+                    goto fail;
+                }
+            }
+        }
+    }
+ 
