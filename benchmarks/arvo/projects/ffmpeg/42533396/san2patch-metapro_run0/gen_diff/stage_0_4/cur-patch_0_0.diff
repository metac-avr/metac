diff --git a/libavformat/mov_chan.c b/libavformat/mov_chan.c
index 3e186b0837..1276bf464f 100644
--- a/libavformat/mov_chan.c
+++ b/libavformat/mov_chan.c
@@ -524,0 +525,6 @@ int ff_mov_read_chan(AVFormatContext *s, AVIOContext *pb, AVStream *st,
+        // Validate size parameter to prevent buffer overflow
+        if (size > 1024 || size < 0) {
+            av_log(s, AV_LOG_ERROR, "invalid channel layout size: %"PRId64"\n", size);
+            return AVERROR_INVALIDDATA;
+        }
+
@@ -542,0 +549,4 @@ int ff_mov_read_chan(AVFormatContext *s, AVIOContext *pb, AVStream *st,
+            if (size < 0) {
+                av_log(s, AV_LOG_ERROR, "channel layout data too short\n");
+                return AVERROR_INVALIDDATA;
+            }
