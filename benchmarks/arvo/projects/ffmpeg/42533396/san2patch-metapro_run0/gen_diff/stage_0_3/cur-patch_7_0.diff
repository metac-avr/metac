diff --git a/libavcodec/codec_par.c b/libavcodec/codec_par.c
index abaac63841..804b341c93 100644
--- a/libavcodec/codec_par.c
+++ b/libavcodec/codec_par.c
@@ -271 +271 @@ FF_ENABLE_DEPRECATION_WARNINGS
-        } else {
+         } else {
@@ -273 +273,15 @@ FF_ENABLE_DEPRECATION_WARNINGS
-        ret = av_channel_layout_copy(&codec->ch_layout, &par->ch_layout);
+        // Validate channel layout data size before copy to prevent out-of-bounds access
+        if (par->ch_layout.order == AV_CHANNEL_ORDER_CUSTOM) {
+            size_t expected_size = par->ch_layout.nb_channels * sizeof(AVChannelCustom);
+            if (expected_size > 0 && expected_size <= 32) {
+                ret = av_channel_layout_copy(&codec->ch_layout, &par->ch_layout);
+            } else {
+                // Handle invalid custom channel layout sizes safely
+                av_channel_layout_uninit(&codec->ch_layout);
+                codec->ch_layout.order = AV_CHANNEL_ORDER_UNSPEC;
+                codec->ch_layout.nb_channels = par->ch_layout.nb_channels;
+                ret = 0;
+            }
+        } else {
+            ret = av_channel_layout_copy(&codec->ch_layout, &par->ch_layout);
+        }
