--- a/libavformat/mov_chan.c
+++ b/libavformat/mov_chan.c
@@ -524 +524 @@ int ff_mov_read_chan(AVFormatContext *s, AVIOContext *pb, AVStream *st,
-
+ 
@@ -526 +526,7 @@ int ff_mov_read_chan(AVFormatContext *s, AVIOContext *pb, AVStream *st,
