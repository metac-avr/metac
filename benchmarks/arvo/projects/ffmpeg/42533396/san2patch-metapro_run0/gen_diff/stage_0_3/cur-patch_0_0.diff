diff --git a/libavcodec/codec_par.c b/libavcodec/codec_par.c
index abaac63841..e5467596da 100644
--- a/libavcodec/codec_par.c
+++ b/libavcodec/codec_par.c
@@ -271 +271 @@ FF_ENABLE_DEPRECATION_WARNINGS
-        } else {
+         } else {
@@ -273,3 +273,19 @@ FF_ENABLE_DEPRECATION_WARNINGS
-        ret = av_channel_layout_copy(&codec->ch_layout, &par->ch_layout);
-        if (ret < 0)
-            return ret;
+        if (par->ch_layout.order == AV_CHANNEL_ORDER_CUSTOM && par->ch_layout.u.map && par->ch_layout.nb_channels > 0) {
+            AVChannelLayout tmp_layout = {0};
+            ret = av_channel_layout_custom_init(&tmp_layout, par->ch_layout.nb_channels);
+            if (ret < 0)
+                return ret;
+            if (par->ch_layout.u.map_sz <= tmp_layout.u.map_sz) {
+                memcpy(tmp_layout.u.map, par->ch_layout.u.map, par->ch_layout.u.map_sz);
+                tmp_layout.u.map_sz = par->ch_layout.u.map_sz;
+                av_channel_layout_uninit(&codec->ch_layout);
+                codec->ch_layout = tmp_layout;
+            } else {
+                av_channel_layout_uninit(&tmp_layout);
+                return AVERROR(EINVAL);
+            }
+        } else {
+            ret = av_channel_layout_copy(&codec->ch_layout, &par->ch_layout);
+            if (ret < 0)
+                return ret;
+        }
