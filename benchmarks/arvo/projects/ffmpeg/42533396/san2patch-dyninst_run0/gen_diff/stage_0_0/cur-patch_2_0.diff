diff --git a/libavformat/mov_chan.c b/libavformat/mov_chan.c
index 3e186b0837..bd98814cd3 100644
--- a/libavformat/mov_chan.c
+++ b/libavformat/mov_chan.c
@@ -523,0 +524,6 @@ int ff_mov_read_chan(AVFormatContext *s, AVIOContext *pb, AVStream *st,
+ 
+        // Validate both nb_channels and num_descr to prevent out-of-bounds access
+        if ((nb_channels <= 0 || nb_channels > 64) || (num_descr < 0 || num_descr > nb_channels)) {
+            av_log(s, AV_LOG_ERROR, "invalid channel configuration: nb_channels=%d, num_descr=%d\n", nb_channels, num_descr);
+            return AVERROR_INVALIDDATA;
+        }
