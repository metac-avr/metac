diff --git a/libavformat/mov_chan.c b/libavformat/mov_chan.c
index 3e186b0837..8a3b473636 100644
--- a/libavformat/mov_chan.c
+++ b/libavformat/mov_chan.c
@@ -524,0 +525,6 @@ int ff_mov_read_chan(AVFormatContext *s, AVIOContext *pb, AVStream *st,
+        // Bounds check to prevent excessive allocation
+        if (nb_channels <= 0 || nb_channels > 256) {
+            av_log(s, AV_LOG_ERROR, "unreasonable number of channels: %d\n", nb_channels);
+            return AVERROR_INVALIDDATA;
+        }
+
@@ -529,0 +536,6 @@ int ff_mov_read_chan(AVFormatContext *s, AVIOContext *pb, AVStream *st,
+        // Ensure we don't process more descriptors than we have space for
+        if (num_descr > FFMIN(nb_channels, 64)) {
+            av_log(s, AV_LOG_WARNING, "limiting channel descriptions to prevent overflow\n");
+            num_descr = FFMIN(nb_channels, 64);
+        }
