diff --git a/libavcodec/codec_par.c b/libavcodec/codec_par.c
index abaac63841..08ccb39cfb 100644
--- a/libavcodec/codec_par.c
+++ b/libavcodec/codec_par.c
@@ -271 +271 @@ FF_ENABLE_DEPRECATION_WARNINGS
-        } else {
+         } else {
@@ -273,3 +273,10 @@ FF_ENABLE_DEPRECATION_WARNINGS
-        ret = av_channel_layout_copy(&codec->ch_layout, &par->ch_layout);
-        if (ret < 0)
-            return ret;
+        // Validate channel layout before copying to prevent buffer overflow
+        if (par->ch_layout.nb_channels > 0 && par->ch_layout.nb_channels <= INT_MAX / sizeof(AVChannelLayout)) {
+            ret = av_channel_layout_copy(&codec->ch_layout, &par->ch_layout);
+            if (ret < 0)
+                return ret;
+        } else {
+            // Handle invalid channel layout gracefully
+            codec->ch_layout.order = AV_CHANNEL_ORDER_UNSPEC;
+            codec->ch_layout.nb_channels = 0;
+        }
