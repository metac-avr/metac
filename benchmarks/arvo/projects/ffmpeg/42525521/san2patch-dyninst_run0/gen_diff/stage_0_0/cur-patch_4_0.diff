diff --git a/libavcodec/mpegvideo_dec.c b/libavcodec/mpegvideo_dec.c
index 765ccd0ba4..70d1b1471f 100644
--- a/libavcodec/mpegvideo_dec.c
+++ b/libavcodec/mpegvideo_dec.c
@@ -1022,0 +1023,6 @@ void ff_mpv_reconstruct_mb(MpegEncContext *s, int16_t block[12][64])
+    // Validate macroblock position before reconstruction
+    if (s->mb_x < 0 || s->mb_y < 0 || s->mb_x >= s->mb_width || s->mb_y >= s->mb_height) {
+        av_log(s->avctx, AV_LOG_WARNING, "Invalid macroblock position (%d,%d)\n", s->mb_x, s->mb_y);
+        return;
+    }
+
