diff --git a/libavcodec/mpeg4videodec.c b/libavcodec/mpeg4videodec.c
index d456e5dd11..3c20971c82 100644
--- a/libavcodec/mpeg4videodec.c
+++ b/libavcodec/mpeg4videodec.c
@@ -280,0 +281 @@ void ff_mpeg4_decode_studio(MpegEncContext *s, uint8_t *dest_y, uint8_t *dest_cb
+            int width_limit = linesize[i] / 2;
@@ -282,2 +283,4 @@ void ff_mpeg4_decode_studio(MpegEncContext *s, uint8_t *dest_y, uint8_t *dest_cb
-                for (int w = 0, idx = 0; w < (16 >> (hsub + lowres)); w++, idx += step)
-                    dest_pcm[i][w] = src[idx];
+                for (int w = 0, idx = 0; w < (16 >> (hsub + lowres)); w++, idx += step) {
+                    if (dest_pcm[i] + w < (uint16_t*)((uint8_t*)dest_pcm[i] + width_limit * sizeof(uint16_t)))
+                        dest_pcm[i][w] = src[idx];
+                }
@@ -297,0 +301 @@ void ff_mpeg4_decode_studio(MpegEncContext *s, uint8_t *dest_y, uint8_t *dest_cb
+            int width_limit = linesize[i] / 2;
