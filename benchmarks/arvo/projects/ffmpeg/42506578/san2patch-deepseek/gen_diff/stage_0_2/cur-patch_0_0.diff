@@ -708,0 +710,17 @@ static int dng_decode_jpeg(AVCodecContext *avctx, AVFrame *frame,
+    if (s->jpgframe->buf[0]) {
+        AVBufferRef *ref = av_buffer_ref(s->jpgframe->buf[0]);
+        if (!ref) {
