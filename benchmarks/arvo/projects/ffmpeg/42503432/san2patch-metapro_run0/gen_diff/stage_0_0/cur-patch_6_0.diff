diff --git a/libavcodec/flac_parser.c b/libavcodec/flac_parser.c
index 2c550507fc..eed04117fd 100644
--- a/libavcodec/flac_parser.c
+++ b/libavcodec/flac_parser.c
@@ -109,0 +110,4 @@ static int frame_header_is_valid(AVCodecContext *avctx, const uint8_t *buf,
+    // Check if we have enough bits left before reading
+    if (get_bits_left(&gb) < 6) {
+        return 0;
+    }
@@ -116 +120,2 @@ static int frame_header_is_valid(AVCodecContext *avctx, const uint8_t *buf,
-    // 01xxxx : reserved
+// FIXME: Crash CWE-125: Out-of-bounds Read
+     // 01xxxx : reserved
diff --git a/libavcodec/get_bits.h b/libavcodec/get_bits.h
index d4e9276da1..51bb9889a9 100644
--- a/libavcodec/get_bits.h
+++ b/libavcodec/get_bits.h
@@ -402,6 +402,11 @@ static inline unsigned int get_bits(GetBitContext *s, int n)
-    OPEN_READER(re, s);
-    av_assert2(n>0 && n<=25);
-    UPDATE_CACHE(re, s);
-    tmp = SHOW_UBITS(re, s, n);
-    LAST_SKIP_BITS(re, s, n);
-    CLOSE_READER(re, s);
+    // Check bounds before reading to prevent out-of-bounds access
+    if (n > 0 && get_bits_count(s) + n <= s->buffer_end - s->buffer) {
+        OPEN_READER(re, s);
+        av_assert2(n>0 && n<=25);
+        UPDATE_CACHE(re, s);
+        tmp = SHOW_UBITS(re, s, n);
+        LAST_SKIP_BITS(re, s, n);
+        CLOSE_READER(re, s);
+    } else {
+        tmp = 0; // Return safe default value when out of bounds
+    }
