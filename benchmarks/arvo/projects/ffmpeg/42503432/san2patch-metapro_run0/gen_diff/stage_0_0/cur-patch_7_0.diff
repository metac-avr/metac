diff --git a/libavcodec/flac_parser.c b/libavcodec/flac_parser.c
index 2c550507fc..7be0e0ca5d 100644
--- a/libavcodec/flac_parser.c
+++ b/libavcodec/flac_parser.c
@@ -109,0 +110,4 @@ static int frame_header_is_valid(AVCodecContext *avctx, const uint8_t *buf,
+    // Validate buffer bounds before reading subframe type
+    if (get_bits_count(&gb) > MAX_FRAME_HEADER_SIZE * 8 + 8 - 6) {
+        return 0;
+    }
@@ -116 +120,2 @@ static int frame_header_is_valid(AVCodecContext *avctx, const uint8_t *buf,
-    // 01xxxx : reserved
+// FIXME: Crash CWE-125: Out-of-bounds Read
+     // 01xxxx : reserved
diff --git a/libavcodec/get_bits.h b/libavcodec/get_bits.h
index d4e9276da1..3bb3b4c6ef 100644
--- a/libavcodec/get_bits.h
+++ b/libavcodec/get_bits.h
@@ -402,6 +402,12 @@ static inline unsigned int get_bits(GetBitContext *s, int n)
-    OPEN_READER(re, s);
-    av_assert2(n>0 && n<=25);
-    UPDATE_CACHE(re, s);
-    tmp = SHOW_UBITS(re, s, n);
-    LAST_SKIP_BITS(re, s, n);
-    CLOSE_READER(re, s);
+// Ensure buffer has enough bits to read to prevent heap overflow
+    if (get_bits_count(s) + n <= (s->buffer_end - s->buffer) * 8) {
+        OPEN_READER(re, s);
+        av_assert2(n>0 && n<=25);
+        UPDATE_CACHE(re, s);
+        tmp = SHOW_UBITS(re, s, n);
+        LAST_SKIP_BITS(re, s, n);
+        CLOSE_READER(re, s);
+    } else {
+        // Return zero when attempting to read beyond buffer bounds
+        tmp = 0;
+    }
