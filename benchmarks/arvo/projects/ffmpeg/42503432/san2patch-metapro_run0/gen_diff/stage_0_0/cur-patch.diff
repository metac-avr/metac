diff --git a/libavcodec/flac_parser.c b/libavcodec/flac_parser.c
index 2c550507fc..f8875a5525 100644
--- a/libavcodec/flac_parser.c
+++ b/libavcodec/flac_parser.c
@@ -109,0 +110,5 @@ static int frame_header_is_valid(AVCodecContext *avctx, const uint8_t *buf,
+    // Ensure sufficient bits remain for subframe type read
+    if (get_bits_left(&gb) < 6) {
+        av_log(avctx, AV_LOG_ERROR, "Insufficient bits for subframe type\n");
+        return 0;
+    }
@@ -116 +121,2 @@ static int frame_header_is_valid(AVCodecContext *avctx, const uint8_t *buf,
-    // 01xxxx : reserved
+// FIXME: Crash CWE-125: Out-of-bounds Read
+     // 01xxxx : reserved
diff --git a/libavcodec/get_bits.h b/libavcodec/get_bits.h
index d4e9276da1..4621147573 100644
--- a/libavcodec/get_bits.h
+++ b/libavcodec/get_bits.h
@@ -402,6 +402,12 @@ static inline unsigned int get_bits(GetBitContext *s, int n)
-    OPEN_READER(re, s);
-    av_assert2(n>0 && n<=25);
-    UPDATE_CACHE(re, s);
-    tmp = SHOW_UBITS(re, s, n);
-    LAST_SKIP_BITS(re, s, n);
-    CLOSE_READER(re, s);
+    // Bounds check to prevent reading past buffer end
+    long bits_available = (s->buffer_end - s->buffer) * 8 - get_bits_count(s);
+    if (n > 0 && n <= bits_available) {
+        OPEN_READER(re, s);
+        av_assert2(n>0 && n<=25);
+        UPDATE_CACHE(re, s);
+        tmp = SHOW_UBITS(re, s, n);
+        LAST_SKIP_BITS(re, s, n);
+        CLOSE_READER(re, s);
+    } else {
+        tmp = 0; // Safe fallback for out-of-bounds reads
+    }
