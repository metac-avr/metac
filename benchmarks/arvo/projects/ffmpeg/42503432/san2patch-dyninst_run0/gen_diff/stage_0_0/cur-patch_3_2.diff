+     // 01xxxx : reserved
diff --git a/libavcodec/get_bits.h b/libavcodec/get_bits.h
index d4e9276da1..5386a0bf16 100644
--- a/libavcodec/get_bits.h
+++ b/libavcodec/get_bits.h
@@ -401,0 +402,4 @@ static inline unsigned int get_bits(GetBitContext *s, int n)
+    // Add bounds checking to prevent out-of-bounds read
+    if (n <= 0 || n > 25) {
+        return 0;  // Return safe default value for invalid bit counts
+    }
@@ -404,0 +409,5 @@ static inline unsigned int get_bits(GetBitContext *s, int n)
+    // Check if we have enough bits available before reading
+    if (get_bits_count(s) + n > s->size_in_bits) {
+        CLOSE_READER(re, s);
+        return 0;  // Return safe default instead of reading out of bounds
+    }
