diff --git a/libavcodec/get_bits.h b/libavcodec/get_bits.h
index d4e9276da1..867bf2906f 100644
--- a/libavcodec/get_bits.h
+++ b/libavcodec/get_bits.h
@@ -402 +402,2 @@ static inline unsigned int get_bits(GetBitContext *s, int n)
-    OPEN_READER(re, s);
+// FIXME: Crash CWE-125: Out-of-bounds Read
+     OPEN_READER(re, s);
@@ -404,4 +405,8 @@ static inline unsigned int get_bits(GetBitContext *s, int n)
-    UPDATE_CACHE(re, s);
-    tmp = SHOW_UBITS(re, s, n);
-    LAST_SKIP_BITS(re, s, n);
-    CLOSE_READER(re, s);
+    if (s->buffer_end - s->buffer >= 4) {
+        UPDATE_CACHE(re, s);
+        tmp = SHOW_UBITS(re, s, n);
+        LAST_SKIP_BITS(re, s, n);
+        CLOSE_READER(re, s);
+    } else {
+        tmp = 0;
+    }
