diff --git a/libavcodec/get_bits.h b/libavcodec/get_bits.h
index d4e9276da1..fb96b5195b 100644
--- a/libavcodec/get_bits.h
+++ b/libavcodec/get_bits.h
@@ -401,0 +402,4 @@ static inline unsigned int get_bits(GetBitContext *s, int n)
+    // Validate buffer bounds before bitstream operations
+    if (get_bits_count(s) + n > 8 * (s->buffer_end - s->buffer)) {
+        return 0xFFFFFFFFU; // Return error value for out-of-bounds access
+    }
