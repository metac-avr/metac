diff --git a/libavcodec/flac_parser.c b/libavcodec/flac_parser.c
index 2c550507fc..0d67484662 100644
--- a/libavcodec/flac_parser.c
+++ b/libavcodec/flac_parser.c
@@ -265,0 +266,3 @@ static int find_new_headers(FLACParseContext *fpc, int search_start)
+    if (search_end < search_start)
+        goto exit_no_headers;
+// FIXME: Crash CWE-125: Out-of-bounds Read
@@ -266,0 +270,2 @@ static int find_new_headers(FLACParseContext *fpc, int search_start)
+    if (read_len <= 0)
+        goto exit_no_headers;
@@ -267,0 +273,2 @@ static int find_new_headers(FLACParseContext *fpc, int search_start)
+    if (!buf)
+        goto exit_no_headers;
@@ -275,10 +282,15 @@ static int find_new_headers(FLACParseContext *fpc, int search_start)
