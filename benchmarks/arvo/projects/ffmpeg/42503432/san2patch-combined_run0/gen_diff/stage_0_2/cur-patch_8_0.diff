+        if (read_len > 0) {
+            wrap[0]  = buf[read_len - 1];
+            /* search_start + 1 is the post-wrap offset in the fifo. */
+            read_len = search_end - (search_start + 1) + 1;
+            if (read_len > 0) {
+                buf      = flac_fifo_read(fpc, search_start + 1, &read_len);
+                if (buf) {
+                    wrap[1]  = buf[0];
+
+                    if ((AV_RB16(wrap) & 0xFFFE) == 0xFFF8) {
+                        temp = find_headers_search_validate(fpc, search_start);
+                        size = FFMAX(size, temp);
+                    }
+                }
+            }
@@ -289,3 +301,5 @@ static int find_new_headers(FLACParseContext *fpc, int search_start)
-        temp     = find_headers_search(fpc, buf, read_len, search_start);
-        size     = FFMAX(size, temp);
-        search_start += read_len - 1;
+        if (read_len > 0 && buf) {
+            temp     = find_headers_search(fpc, buf, read_len, search_start);
+            size     = FFMAX(size, temp);
+            search_start += read_len - 1;
+        }
@@ -293,0 +308 @@ static int find_new_headers(FLACParseContext *fpc, int search_start)
+exit_no_headers:
@@ -655,2 +670,11 @@ static int flac_parse(AVCodecParserContext *s, AVCodecContext *avctx,
-            av_fifo_generic_write(fpc->fifo_buf, (void*) read_start,
-                                  read_end - read_start, NULL);
+            /* Validate buffer bounds before copying */
+            if (read_start >= buf && read_end <= buf + buf_size) {
+                av_fifo_generic_write(fpc->fifo_buf, (void*) read_start,
+                                      read_end - read_start, NULL);
+            } else if (read_start >= buf) {
+                ptrdiff_t remaining = (buf + buf_size) - read_start;
+                if (remaining > 0) {
+                    av_fifo_generic_write(fpc->fifo_buf, (void*) read_start,
+                                          remaining, NULL);
+                }
+            }
@@ -664 +688,2 @@ static int flac_parse(AVCodecParserContext *s, AVCodecContext *avctx,
-                       ((read_end - read_start) + (MAX_FRAME_HEADER_SIZE - 1));
+// FIXME: Crash CWE-125: Out-of-bounds Read
+                        ((read_end - read_start) + (MAX_FRAME_HEADER_SIZE - 1));
@@ -692,6 +717,8 @@ static int flac_parse(AVCodecParserContext *s, AVCodecContext *avctx,
-            /* HACK: drain the tail of the fifo */
-            fpc->fifo_buf->wptr -= MAX_FRAME_HEADER_SIZE;
-            fpc->fifo_buf->wndx -= MAX_FRAME_HEADER_SIZE;
-            if (warp) {
-                fpc->fifo_buf->wptr += fpc->fifo_buf->end -
-                    fpc->fifo_buf->buffer;
+            /* Add safety check for buffer pointer arithmetic */
+            if (fpc->fifo_buf->wptr - fpc->fifo_buf->buffer >= MAX_FRAME_HEADER_SIZE) {
+                fpc->fifo_buf->wptr -= MAX_FRAME_HEADER_SIZE;
+                fpc->fifo_buf->wndx -= MAX_FRAME_HEADER_SIZE;
+                if (warp) {
+                    fpc->fifo_buf->wptr += fpc->fifo_buf->end -
+                        fpc->fifo_buf->buffer;
+                }
