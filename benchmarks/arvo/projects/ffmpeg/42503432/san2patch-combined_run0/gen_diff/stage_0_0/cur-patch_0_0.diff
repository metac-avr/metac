diff --git a/libavcodec/get_bits.h b/libavcodec/get_bits.h
index d4e9276da1..f922fd49d7 100644
--- a/libavcodec/get_bits.h
+++ b/libavcodec/get_bits.h
@@ -401,0 +402,5 @@ static inline unsigned int get_bits(GetBitContext *s, int n)
+    // Add bounds check to prevent out-of-bounds read
+    if (s->index + n > s->buffer_end) {
+        av_log(NULL, AV_LOG_ERROR, "get_bits: bitstream overflow\n");
+        return 0;
+    }
