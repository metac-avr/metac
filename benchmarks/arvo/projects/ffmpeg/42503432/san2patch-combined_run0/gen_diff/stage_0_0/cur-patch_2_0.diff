diff --git a/libavcodec/get_bits.h b/libavcodec/get_bits.h
index d4e9276da1..2c3f8c7c93 100644
--- a/libavcodec/get_bits.h
+++ b/libavcodec/get_bits.h
@@ -404,0 +405,5 @@ static inline unsigned int get_bits(GetBitContext *s, int n)
+    // Validate sufficient bits available before reading to prevent out-of-bounds access
+    if (re.index + ((n + re.bits_left) >> 3) > s->buffer_end) {
+        av_log(NULL, AV_LOG_ERROR, "get_bits: insufficient bits available\n");
+        return 0;
+    }
diff --git a/libavcodec/flac_parser.c b/libavcodec/flac_parser.c
index 2c550507fc..26e1ce642b 100644
--- a/libavcodec/flac_parser.c
+++ b/libavcodec/flac_parser.c
@@ -107 +107 @@ static int frame_header_is_valid(AVCodecContext *avctx, const uint8_t *buf,
-    if (get_bits1(&gb) != 0) {
+    if (get_bits(&gb, 1) != 0) {
@@ -116 +116,2 @@ static int frame_header_is_valid(AVCodecContext *avctx, const uint8_t *buf,
-    // 01xxxx : reserved
+// FIXME: Crash CWE-125: Out-of-bounds Read
+     // 01xxxx : reserved
@@ -117,0 +119,7 @@ static int frame_header_is_valid(AVCodecContext *avctx, const uint8_t *buf,
+    if (get_bits_left(&gb) < 6) {
+        return 0;
+    }
+    skip_bits(&gb, -1); // Rewind 1 bit
+    if (get_bits1(&gb) != 0) {
+        return 0;
+    }
