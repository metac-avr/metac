diff --git a/libavcodec/flac_parser.c b/libavcodec/flac_parser.c
index 2c550507fc..1aa362c0ff 100644
--- a/libavcodec/flac_parser.c
+++ b/libavcodec/flac_parser.c
@@ -622,0 +623 @@ static int flac_parse(AVCodecParserContext *s, AVCodecContext *avctx,
+        size_t avail_bytes;
@@ -661,0 +663,11 @@ static int flac_parse(AVCodecParserContext *s, AVCodecContext *avctx,
+        /* Ensure enough bytes are buffered for a FLAC frame header before
+         * attempting to parse it, preventing an out-of-bounds read. */
+        avail_bytes = av_fifo_size(fpc->fifo_buf);
+        if (avail_bytes < FLAC_MAX_FRAME_HEADER_SIZE_MIN_BYTES) {
+            if (buf_size && read_end < buf + buf_size) {
+                read_start = read_end;
+                continue;
+            }
+            goto handle_error;
+        }
+
@@ -664 +676 @@ static int flac_parse(AVCodecParserContext *s, AVCodecContext *avctx,
-                       ((read_end - read_start) + (MAX_FRAME_HEADER_SIZE - 1));
+                        ((read_end - read_start) + (MAX_FRAME_HEADER_SIZE - 1));
