-
+    int x_copy;
+    
+    if (planar) {
+        x_copy = 0;
+    } else {
+        int cpy = FFMIN(s->avctx->width - (int)(dst - picture->data[0]) / pixel_size, cblk->w);
+        memcpy(dst, i_datap, pixel_size * cpy);
+        i_datap += cpy;
+        dst += pixel_size * cpy;
+        x_copy = cpy;
+    }
+
+    // Fixed: Bounds validation added to prevent out-of-bounds write
+    if (planar && x_copy < cblk->w) {
