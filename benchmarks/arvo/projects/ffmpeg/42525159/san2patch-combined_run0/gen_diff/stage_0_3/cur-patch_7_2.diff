-                                                                                                  \
+#define WRITE_FRAME(bits, PIXEL)                                                         \
+    static void write_frame_##bits##_##PIXEL(Jpeg2000DecoderContext *s, AVFrame *picture,   \
+                                             int tile_index, int compno,                   \
+                                             PIXEL *i_datap, int stepx, int stepy,         \
+                                             int pixelsize, uint8_t *qp_buffer)            \
+    {                                                                                         \
+        Jpeg2000Tile *tile = s->tile + tile_index;                                           \
+        PIXEL *line, *dst;                                                                   \
+        int x, y, *src;                                                                       \
+        int cw, ch, tasksize;                                                                 \
+        uint8_t *end_of_buffer = qp_buffer + (FFABS(picture->linesize[compno]) *           \
+                                              picture->height) - 1;                          \
+        tasksize = av_rescale(stepy, picture->height, tile->ch[compno].ch_off +            \
+                              tile->ch[compno].ih);                                          \
+        for (y = 0; y < tile->ch[compno].ih; y += stepy) {                                    \
+            line = (PIXEL *)(picture->data[compno] +                                         \
+                            (tile->ch[compno].y_offset + y) * picture->linesize[compno]);    \
+            src = tile->comp[compno].data + y * tile->ch[compno].cw;                         \
+            for (cw = 0; cw < tile->ch[compno].cw; cw++) {                                   \
+                dst = line + tile->ch[compno].x_offset + cw * stepx;                         \
+                for (ch = 0; ch < tasksize; ch++) {                                          \
+                    if ((uint8_t*)dst >= end_of_buffer)                                     \
+                        break;                                                               \
+                    for (x = 0; x < stepx; x++) {                                            \
+                        if ((uint8_t*)(dst + x) >= end_of_buffer)                           \
+                            break;                                                           \
+                        dst[x] = *i_datap;                                                   \
+                        i_datap++;                                                           \
+                    }                                                                        \
+                    dst += picture->linesize[compno] / sizeof(PIXEL);                        \
+                }                                                                            \
+            }                                                                                \
+        }                                                                                    \
