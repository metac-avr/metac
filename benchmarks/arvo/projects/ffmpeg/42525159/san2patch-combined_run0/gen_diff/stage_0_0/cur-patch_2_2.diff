-                                                                                                  \
+#define WRITE_FRAME(display_bits, PIXEL)                                                     \
+    static void write_frame_ ## display_bits (AVFrame *picture, int plane, int component,    \
+                                              int32_t *src, int x, int y, int w, int h)       \
+    {                                                                                         \
+        const int pixelsize = sizeof(PIXEL);                                                  \
+        const int step_x = 1 << (w - 1);                                                      \
+        const int step_y = 1 << (h - 1);                                                      \
+        int i, j;                                                                             \
+        PIXEL *line = (PIXEL*)(picture->data[plane]) + y * (picture->linesize[plane] / sizeof(PIXEL)) + x; \
+        int32_t *i_datap = src;                                                               \
+        for (j = 0; j < step_y; j++) {                                                        \
+            PIXEL *dst = line;                                                                \
+            for (i = 0; i < step_x; i++) {                                                    \
+                if (y + j < picture->height && x + i < picture->width) {                      \
+                    *dst = *i_datap;                                                          \
+                }                                                                             \
+                i_datap++;                                                                    \
+                dst += pixelsize;                                                             \
+            }                                                                                 \
+            line += picture->linesize[plane] / sizeof(PIXEL);                                 \
+        }                                                                                     \
@@ -2026,13 +2038,0 @@ static inline void tile_codeblocks(const Jpeg2000DecoderContext *s, Jpeg2000Tile
