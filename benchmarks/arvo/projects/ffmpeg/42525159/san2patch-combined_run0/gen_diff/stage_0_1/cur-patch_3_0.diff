+                } else {                                                                  \
+                    i_datap++;                                                            \
+                    dst += pixelsize;                                                     \
+                }                                                                         \
+            }                                                                             \
+            line += comp->stride;                                                         \
+        }                                                                                 \
+    }                                                                                     \
