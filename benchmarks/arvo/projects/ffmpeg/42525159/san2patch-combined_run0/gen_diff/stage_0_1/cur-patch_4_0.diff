+                                         picture->linesize[compno] * picture->height)) {  \
+                    *(dst + x * pixelsize) = *(i_datap + x);                              \
+                }                                                                         \
+            }                                                                             \
+            dst += picture->linesize[compno] / sizeof(PIXEL);                              \
+            line += comp->stride;                                                         \
+        }                                                                                 \
+    }                                                                                     \
+                                                                                          \
