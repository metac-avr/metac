+#define WRITE_FRAME(DIRECTORY, PIXEL)                                       \
+    static void write_frame_ ## DIRECTORY (Jpeg2000DecoderContext *s, AVFrame *picture,   \
+                                           int tile_index, int compno,                   \
+                                           int dest_x, int dest_y,                       \
+                                           int src_x, int src_y,                         \
+                                           int w, int h)                                 \
+    {                                                                                     \
+        Jpeg2000Tile *tile = s->tile + tile_index;                                        \
+        Jpeg2000Component *comp = tile->comp + compno;                                     \
+        PIXEL *line = (PIXEL *)comp->data + src_y * comp->stride + src_x;                \
+        PIXEL *dst;                                                                       \
+        int x, y, pixelsize = picture->linesize[compno] / sizeof(PIXEL);                 \
