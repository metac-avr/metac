index 0e95cca64e..7422d923f2 100644
--- a/libavcodec/jpeg2000dec.c
+++ b/libavcodec/jpeg2000dec.c
@@ -2017,3 +2017,16 @@ static inline void tile_codeblocks(const Jpeg2000DecoderContext *s, Jpeg2000Tile
-                        i_datap++;                                                                \
-                        dst += pixelsize;                                                         \
-                    }                                                                             \
+#define WRITE_FRAME(bits, PIXEL)                                                            \
+    static void write_frame_##bits(AVCodecContext *avctx, AVFrame *picture,                      \
+                                   uint8_t *buf, int cbps, int plane, int pixelsize)             \
+    {                                                                                             \
+        int x, y, dimx, dimy;                                                                     \
+        PIXEL *line, *dst, *i_datap;                                                              \
+        i_datap = (PIXEL *) buf;                                                                  \
+        dimx = cbps ? avctx->width  : picture->width;                                            \
+        dimy = cbps ? avctx->height : picture->height;                                            \
+        for (y = 0; y < dimy; y++) {                                                              \
+            line = (PIXEL *)(picture->data[plane] + y * picture->linesize[plane]);                \
+            for (x = 0; x < dimx; x += pixelsize) {                                              \
+                dst = line + x;                                                                   \
+                /* Fixed CWE-787: Out-of-bounds Write - Added bounds checking before write operation */ \
+                if ((uint8_t*)dst < ((uint8_t*)picture->data[plane] + picture->linesize[plane] * picture->height)) { \
+                    *dst = *i_datap;                                                              \
@@ -2021 +2034,2 @@ static inline void tile_codeblocks(const Jpeg2000DecoderContext *s, Jpeg2000Tile
-                line += picture->linesize[plane] / sizeof(PIXEL);                                 \
+                i_datap++;                                                                        \
+                dst += pixelsize;                                                                 \
@@ -2022,0 +2037 @@ static inline void tile_codeblocks(const Jpeg2000DecoderContext *s, Jpeg2000Tile
+            line += picture->linesize[plane] / sizeof(PIXEL);                                     \
@@ -2024 +2038,0 @@ static inline void tile_codeblocks(const Jpeg2000DecoderContext *s, Jpeg2000Tile
-                                                                                                  \
@@ -2026,13 +2039,0 @@ static inline void tile_codeblocks(const Jpeg2000DecoderContext *s, Jpeg2000Tile
-
-WRITE_FRAME(8, uint8_t)
-WRITE_FRAME(16, uint16_t)
-
-#undef WRITE_FRAME
