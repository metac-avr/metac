+static void write_frame_8(AVCodecContext *avctx, AVFrame *picture, Jpeg2000Tile *tile) {
+    int compno;
+    uint8_t *line;
+    uint8_t *dst;
+    uint8_t *i_datap;
+    uint8_t *end_of_buffer = tile->buf + tile->buf_size;
+    int pixelsize = 1;
+    for (compno = 0; compno < tile->numcomps; compno++) {
+        Jpeg2000Component *comp = tile->comp + compno;
+        int x, y, pixelcount = 0;
+        line = (uint8_t *)comp->data;
+        for (y = 0; y < comp->height; y++) {
+            dst = line;
+            i_datap = comp->i_data + y * comp->stride;
+            for (x = 0; x < comp->width; x++) {
+                if ((uint8_t*)dst + pixelsize <= end_of_buffer) {
+                    *dst = *i_datap;
+                    i_datap++;
+                    dst += pixelsize;
+                } else {
+                    av_log(avctx, AV_LOG_DEBUG, "Buffer boundary exceeded, stopping\n");
+                    break;
+                }
+            }
+            line += picture->linesize[compno] / sizeof(uint8_t);
+        }
@@ -2025,0 +2044 @@ static inline void tile_codeblocks(const Jpeg2000DecoderContext *s, Jpeg2000Tile
