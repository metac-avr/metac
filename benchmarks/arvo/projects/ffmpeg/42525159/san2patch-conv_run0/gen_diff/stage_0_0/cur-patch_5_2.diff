diff --git a/libavcodec/jpeg2000dec.c b/libavcodec/jpeg2000dec.c
index 0e95cca64e..f763fa1d35 100644
--- a/libavcodec/jpeg2000dec.c
+++ b/libavcodec/jpeg2000dec.c
@@ -2017,8 +2017,20 @@ static inline void tile_codeblocks(const Jpeg2000DecoderContext *s, Jpeg2000Tile
-                        i_datap++;                                                                \
-                        dst += pixelsize;                                                         \
-                    }                                                                             \
-                }                                                                                 \
-                line += picture->linesize[plane] / sizeof(PIXEL);                                 \
-            }                                                                                     \
-        }                                                                                         \
-                                                                                                  \
+static void write_frame_8(AVFrame *picture, Jpeg2000DecoderContext *s, Jpeg2000Tile *tile, int plane, uint8_t *dst, uint8_t *i_datap, uint8_t *end_of_buffer, int pixelsize)
+{
+    int x, y;
+    int *l_datap = tile->cblk[plane][0].data;
+    const int cw = tile->codsty[plane].compsizex;
+    const int ch = tile->codsty[plane].compsizey;
+    const int32_t *cblk_data = l_datap;
+    const int32_t *cblk_data_end = cblk_data + tile->cblk[plane][0].length;
+
+    for (y = 0; y < ch; y++) {
+        for (x = 0; x < cw; x++) {
+            int32_t val = *cblk_data++;
+            if (cblk_data > cblk_data_end) {
+                av_log(s->avctx, AV_LOG_ERROR, "Invalid data\n");
+                return;
+            }
+            *dst = av_clip_uint8(val);
+            dst += pixelsize;
+        }
+        dst += picture->linesize[plane] - cw * pixelsize;
@@ -2025,0 +2038 @@ static inline void tile_codeblocks(const Jpeg2000DecoderContext *s, Jpeg2000Tile
+}
@@ -2027,7 +2040 @@ static inline void tile_codeblocks(const Jpeg2000DecoderContext *s, Jpeg2000Tile
-WRITE_FRAME(8, uint8_t)
-WRITE_FRAME(16, uint16_t)
-
-#undef WRITE_FRAME
-
-static int jpeg2000_decode_tile(AVCodecContext *avctx, void *td,
-                                int jobnr, int threadnr)
+static void write_frame_16(AVFrame *picture, Jpeg2000DecoderContext *s, Jpeg2000Tile *tile, int plane, uint16_t *dst, uint16_t *i_datap, uint16_t *end_of_buffer, int pixelsize)
@@ -2035,4 +2042,20 @@ static int jpeg2000_decode_tile(AVCodecContext *avctx, void *td,
-    const Jpeg2000DecoderContext *s = avctx->priv_data;
-    AVFrame *picture = td;
-    Jpeg2000Tile *tile = s->tile + jobnr;
-
+    int x, y;
+    int *l_datap = tile->cblk[plane][0].data;
+    const int cw = tile->codsty[plane].compsizex;
+    const int ch = tile->codsty[plane].compsizey;
+    const int32_t *cblk_data = l_datap;
+    const int32_t *cblk_data_end = cblk_data + tile->cblk[plane][0].length;
+
+    for (y = 0; y < ch; y++) {
+        for (x = 0; x < cw; x++) {
+            int32_t val = *cblk_data++;
+            if (cblk_data > cblk_data_end) {
+                av_log(s->avctx, AV_LOG_ERROR, "Invalid data\n");
+                return;
+            }
+            *dst = av_clip_uint16(val);
+            dst += pixelsize;
+        }
+        dst += picture->linesize[plane] / sizeof(uint16_t) - cw * pixelsize;
+    }
+}
