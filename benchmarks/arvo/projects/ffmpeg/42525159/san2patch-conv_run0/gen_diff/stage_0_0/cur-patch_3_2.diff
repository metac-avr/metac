--- a/libavcodec/jpeg2000dec.c
+++ b/libavcodec/jpeg2000dec.c
@@ -2017,8 +2017,23 @@ static inline void tile_codeblocks(const Jpeg2000DecoderContext *s, Jpeg2000Tile
-                        i_datap++;                                                                \
-                        dst += pixelsize;                                                         \
-                    }                                                                             \
-                }                                                                                 \
-                line += picture->linesize[plane] / sizeof(PIXEL);                                 \
-            }                                                                                     \
-        }                                                                                         \
-                                                                                                  \
+#define WRITE_FRAME(DIRECT, PIXEL)                                                     \
+    static void jpc_write_##DIRECT##_data(Jpeg2000DecoderContext *s, AVFrame *picture,     \
+                                         int tile_row, int plane,                           \
+                                         int *l_mirror_x, int *l_mirror_y,                  \
+                                         int x, int y, int w, int h,                        \
+                                         PIXEL *i_datap, int pixelsize,                     \
+                                         PIXEL *end_of_buffer)                             \
+    {                                                                                      \
+        int i, j;                                                                          \
+        PIXEL *line = (PIXEL*)picture->data[plane] +                                        \
+                      (y + tile_row * s->ct_y) * picture->linesize[plane] / sizeof(PIXEL); \
+        for (j = 0; j < h; j++) {                                                          \
+            PIXEL *dst = line + x;                                                         \
+            for (i = 0; i < w; i++) {                                                      \
+                /* Fixed CWE-787: Out-of-bounds Write by adding boundary check */          \
+                if (dst < end_of_buffer) {                                                 \
+                    *dst = *i_datap;                                                       \
+                }                                                                          \
+                i_datap++;                                                                 \
+                dst += pixelsize;                                                          \
+            }                                                                              \
+            line += picture->linesize[plane] / sizeof(PIXEL);                              \
+        }                                                                                  \
@@ -2026,13 +2040,0 @@ static inline void tile_codeblocks(const Jpeg2000DecoderContext *s, Jpeg2000Tile
-
-WRITE_FRAME(8, uint8_t)
-WRITE_FRAME(16, uint16_t)
