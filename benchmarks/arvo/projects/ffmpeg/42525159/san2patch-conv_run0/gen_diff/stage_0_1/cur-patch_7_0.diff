diff --git a/libavcodec/jpeg2000dec.c b/libavcodec/jpeg2000dec.c
index 0e95cca64e..cf4c51ab0f 100644
--- a/libavcodec/jpeg2000dec.c
+++ b/libavcodec/jpeg2000dec.c
@@ -2025 +2025,7 @@ static inline void tile_codeblocks(const Jpeg2000DecoderContext *s, Jpeg2000Tile
-    }
+// Fixed CWE-787: Out-of-bounds Write - Added boundary validation before memory write
+        size_t buffer_size = picture->linesize[plane] * picture->height;                          \
+        size_t offset = (uint8_t*)dst - (uint8_t*)picture->data[plane];                          \
+        if (offset < buffer_size) {                                                              \
+            *(PIXEL*)dst = *i_datap;                                                              \
+        }                                                                                         \
+     }
@@ -2500,0 +2507,8 @@ static int jpeg2000_decode_frame(AVCodecContext *avctx, AVFrame *picture,
+    // Validate tile dimensions before processing to prevent buffer overflow
+    if (s->numXtiles < 0 || s->numYtiles < 0 || 
+        (s->numXtiles > 0 && s->numYtiles > INT_MAX / s->numXtiles)) {
+        av_log(avctx, AV_LOG_ERROR, "Invalid or excessive tile dimensions\n");
+        ret = AVERROR_INVALIDDATA;
+        goto end;
+    }
