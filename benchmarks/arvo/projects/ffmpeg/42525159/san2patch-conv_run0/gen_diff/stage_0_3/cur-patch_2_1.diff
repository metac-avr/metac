-static int jpeg2000_decode_tile(AVCodecContext *avctx, void *td,
-                                int jobnr, int threadnr)
+static void WRITE_FRAME(const char *frame_name, PIXEL *dst, const uint8_t *src, int linesize, int height, int pixel_size, int plane, AVFrame *picture)
@@ -2035,4 +2019,21 @@ static int jpeg2000_decode_tile(AVCodecContext *avctx, void *td,
