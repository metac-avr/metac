@@ -2017,13 +2017,29 @@ static inline void tile_codeblocks(const Jpeg2000DecoderContext *s, Jpeg2000Tile
-                        i_datap++;                                                                \
-                        dst += pixelsize;                                                         \
-                    }                                                                             \
-                }                                                                                 \
-                line += picture->linesize[plane] / sizeof(PIXEL);                                 \
-            }                                                                                     \
-        }                                                                                         \
-                                                                                                  \
-    }
-
-WRITE_FRAME(8, uint8_t)
-WRITE_FRAME(16, uint16_t)
-
+#define WRITE_FRAME(DIRECTORY, PIXEL) \
+    static void j2k_write_##DIRECTORY##_frame(Jpeg2000DecoderContext *s, AVFrame *picture, \
+                                              int tile_index, int compno, int plane, \
+                                              PIXEL *i_datap, int pixelsize) \
+    { \
+        Jpeg2000Tile *tile = s->tile + tile_index; \
+        int x, y, line; \
+        PIXEL *linep, *dst; \
+        \
+        for (y = tile->comp[compno].y0; y < tile->comp[compno].y1; y++) { \
+            line = y * (picture->linesize[plane] / sizeof(PIXEL)); \
+            linep = (PIXEL *)(picture->data[plane] + line); \
+            for (x = tile->comp[compno].x0; x < tile->comp[compno].x1; x++) { \
+                dst = linep + x; \
+                /* Fixed CWE-787: Out-of-bounds Write - Validate write position before operation */ \
+                size_t offset = (uint8_t*)dst - (uint8_t*)linep; \
+                if (offset + sizeof(PIXEL) <= (size_t)picture->linesize[plane]) { \
+                    *(PIXEL*)dst = *i_datap; \
+                } \
+                i_datap++; \
+                dst += pixelsize; \
+            } \
+            line += picture->linesize[plane] / sizeof(PIXEL); \
+        } \
+    }\
+\
+WRITE_FRAME(8, uint8_t)\
+WRITE_FRAME(16, uint16_t)\
+\
@@ -2031,8 +2046,0 @@ WRITE_FRAME(16, uint16_t)
