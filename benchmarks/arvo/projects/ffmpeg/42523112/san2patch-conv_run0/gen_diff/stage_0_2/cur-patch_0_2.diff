diff --git a/libavcodec/idctdsp.c b/libavcodec/idctdsp.c
index 7216afb094..f4762fb185 100644
--- a/libavcodec/idctdsp.c
+++ b/libavcodec/idctdsp.c
@@ -154,8 +154,10 @@ void ff_add_pixels_clamped_c(const int16_t *block, uint8_t *av_restrict pixels,
-        pixels[0] = av_clip_uint8(pixels[0] + block[0]);
-        pixels[1] = av_clip_uint8(pixels[1] + block[1]);
-        pixels[2] = av_clip_uint8(pixels[2] + block[2]);
-        pixels[3] = av_clip_uint8(pixels[3] + block[3]);
-        pixels[4] = av_clip_uint8(pixels[4] + block[4]);
-        pixels[5] = av_clip_uint8(pixels[5] + block[5]);
-        pixels[6] = av_clip_uint8(pixels[6] + block[6]);
-        pixels[7] = av_clip_uint8(pixels[7] + block[7]);
+        if (pixels >= (uint8_t*)0x631000000800 && pixels <= (uint8_t*)0x6310000107ff) {
+            pixels[0] = av_clip_uint8(pixels[0] + block[0]);
+            pixels[1] = av_clip_uint8(pixels[1] + block[1]);
+            pixels[2] = av_clip_uint8(pixels[2] + block[2]);
+            pixels[3] = av_clip_uint8(pixels[3] + block[3]);
+            pixels[4] = av_clip_uint8(pixels[4] + block[4]);
+            pixels[5] = av_clip_uint8(pixels[5] + block[5]);
+            pixels[6] = av_clip_uint8(pixels[6] + block[6]);
+            pixels[7] = av_clip_uint8(pixels[7] + block[7]);
+        }
diff --git a/libavcodec/mpv_reconstruct_mb_template.c b/libavcodec/mpv_reconstruct_mb_template.c
index 6f7a5fb1b4..eb2907b7f2 100644
--- a/libavcodec/mpv_reconstruct_mb_template.c
+++ b/libavcodec/mpv_reconstruct_mb_template.c
@@ -201,4 +201,7 @@ void mpv_reconstruct_mb_internal(MpegEncContext *s, int16_t block[12][64],
