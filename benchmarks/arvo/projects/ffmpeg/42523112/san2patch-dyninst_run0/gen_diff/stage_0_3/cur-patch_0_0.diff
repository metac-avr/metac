diff --git a/libavcodec/mpv_reconstruct_mb_template.c b/libavcodec/mpv_reconstruct_mb_template.c
index 6f7a5fb1b4..2aed303eb0 100644
--- a/libavcodec/mpv_reconstruct_mb_template.c
+++ b/libavcodec/mpv_reconstruct_mb_template.c
@@ -201,4 +201,5 @@ void mpv_reconstruct_mb_internal(MpegEncContext *s, int16_t block[12][64],
-                add_dct(s, block[0], 0, dest_y                          , dct_linesize);
-                add_dct(s, block[1], 1, dest_y              + block_size, dct_linesize);
-                add_dct(s, block[2], 2, dest_y + dct_offset             , dct_linesize);
-                add_dct(s, block[3], 3, dest_y + dct_offset + block_size, dct_linesize);
+// FIXME: Crash CWE-125: Out-of-bounds Read
+                 if (dest_y != NULL) add_dct(s, block[0], 0, dest_y                          , dct_linesize);
+                if (dest_y + block_size != NULL) add_dct(s, block[1], 1, dest_y              + block_size, dct_linesize);
+                if (dest_y + dct_offset != NULL) add_dct(s, block[2], 2, dest_y + dct_offset             , dct_linesize);
+                if (dest_y + dct_offset + block_size != NULL) add_dct(s, block[3], 3, dest_y + dct_offset + block_size, dct_linesize);
@@ -208,2 +209,2 @@ void mpv_reconstruct_mb_internal(MpegEncContext *s, int16_t block[12][64],
-                        add_dct(s, block[4], 4, dest_cb, uvlinesize);
-                        add_dct(s, block[5], 5, dest_cr, uvlinesize);
+                        if (dest_cb != NULL) add_dct(s, block[4], 4, dest_cb, uvlinesize);
+                        if (dest_cr != NULL) add_dct(s, block[5], 5, dest_cr, uvlinesize);
