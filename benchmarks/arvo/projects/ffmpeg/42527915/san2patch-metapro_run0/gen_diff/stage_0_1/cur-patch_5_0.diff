+        // Add safety checks to prevent expired pointer dereference
+        if (table && single && single->table) {
+            // Ensure we don't exceed the bounds of either table
+            if (j < nb_elems && j < (1 << VLC_MAX_BITS)) {
+                table[j].len = single->table[j].len;
+                table[j].num = single->table[j].len > 0 ? 1 : 0;
+                AV_WN16(table[j].val, single->table[j].sym);
+            }
+        } else {
+            // Log error and return if invalid pointers are detected
+            av_log(logctx, AV_LOG_ERROR, "Invalid pointer in vlc_multi_gen\n");
+            return AVERROR(EINVAL);
+        }
