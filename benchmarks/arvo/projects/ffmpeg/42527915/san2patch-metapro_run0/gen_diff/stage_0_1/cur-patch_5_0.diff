diff --git a/libavcodec/vlc.c b/libavcodec/vlc.c
index 9656a9472c..0463d3abb4 100644
--- a/libavcodec/vlc.c
+++ b/libavcodec/vlc.c
@@ -239 +239 @@ static int vlc_common_end(VLC *vlc, int nb_bits, int nb_codes, VLCcode *codes,
-    } else {
+     } else {
@@ -245,0 +246,6 @@ static int vlc_common_end(VLC *vlc, int nb_bits, int nb_codes, VLCcode *codes,
+        // Validate pointer before returning to prevent expired pointer dereference
+        if (!vlc->table && ret >= 0) {
+            // Table was freed, ensure we don't use stale pointer
+            vlc->bits = 0;
+            vlc->table_allocated = 0;
+        }
@@ -439,3 +445,13 @@ static int vlc_multi_gen(VLC_MULTI_ELEM *table, const VLC *single,
