diff --git a/libavcodec/vlc.c b/libavcodec/vlc.c
index 9656a9472c..10d2184874 100644
--- a/libavcodec/vlc.c
+++ b/libavcodec/vlc.c
@@ -428,0 +429,5 @@ static int vlc_multi_gen(VLC_MULTI_ELEM *table, const VLC *single,
+    // Defensive check for null pointers to prevent expired pointer dereference
+    if (!table || !single) {
+        return AVERROR(EINVAL);
+    }
+
@@ -438,4 +443,13 @@ static int vlc_multi_gen(VLC_MULTI_ELEM *table, const VLC *single,
