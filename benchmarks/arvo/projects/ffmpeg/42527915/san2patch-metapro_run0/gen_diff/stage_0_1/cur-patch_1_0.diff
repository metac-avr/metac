-        table[j].len = single->table[j].len;
-        table[j].num = single->table[j].len > 0 ? 1 : 0;
-        AV_WN16(table[j].val, single->table[j].sym);
+    // Initialize table safely with bounds checking
+    for (int j = 0; j < (1<<numbits); j++) {
+        // Verify that we don't access beyond allocated memory
+        if (single && single->table) {
+            table[j].len = single->table[j].len;
+            table[j].num = single->table[j].len > 0 ? 1 : 0;
+            AV_WN16(table[j].val, single->table[j].sym);
+        } else {
+            // Clear the entry if source is invalid
+            table[j].len = 0;
+            table[j].num = 0;
+            AV_WN16(table[j].val, 0);
+        }
