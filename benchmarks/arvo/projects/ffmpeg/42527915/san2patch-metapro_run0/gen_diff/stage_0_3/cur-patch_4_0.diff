diff --git a/libavcodec/vlc.c b/libavcodec/vlc.c
index 9656a9472c..950bf83294 100644
--- a/libavcodec/vlc.c
+++ b/libavcodec/vlc.c
@@ -428,0 +429,4 @@ static int vlc_multi_gen(VLC_MULTI_ELEM *table, const VLC *single,
+    // Check for potential use-after-free conditions before proceeding
+    if (nb_elems <= 0 || nb_codes <= 0 || numbits <= 0)
+        return AVERROR(EINVAL);
+
@@ -439,3 +443,10 @@ static int vlc_multi_gen(VLC_MULTI_ELEM *table, const VLC *single,
-        table[j].len = single->table[j].len;
-        table[j].num = single->table[j].len > 0 ? 1 : 0;
-        AV_WN16(table[j].val, single->table[j].sym);
+        // Validate single table access before copying
+        if (single->table) {
+            table[j].len = single->table[j].len;
+            table[j].num = single->table[j].len > 0 ? 1 : 0;
+            AV_WN16(table[j].val, single->table[j].sym);
+        } else {
+            table[j].len = 0;
+            table[j].num = 0;
+            AV_WN16(table[j].val, 0);
+        }
@@ -495 +506 @@ int ff_init_vlc_multi_from_lengths(VLC *vlc, VLC_MULTI *multi, int nb_bits, int
-        }
+         }
@@ -503,0 +515,4 @@ int ff_init_vlc_multi_from_lengths(VLC *vlc, VLC_MULTI *multi, int nb_bits, int
+    if (multi->table) {
+        av_free(multi->table);
+        multi->table = NULL;
+    }
