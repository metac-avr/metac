diff --git a/libavcodec/vlc.c b/libavcodec/vlc.c
index 9656a9472c..84464c172e 100644
--- a/libavcodec/vlc.c
+++ b/libavcodec/vlc.c
@@ -239 +239 @@ static int vlc_common_end(VLC *vlc, int nb_bits, int nb_codes, VLCcode *codes,
-    } else {
+     } else {
@@ -245,0 +246,4 @@ static int vlc_common_end(VLC *vlc, int nb_bits, int nb_codes, VLCcode *codes,
+        // Validate that table was properly allocated
+        if (!vlc->table && vlc->table_size > 0) {
+            return AVERROR(EINVAL);
+        }
@@ -427 +431,7 @@ static int vlc_multi_gen(VLC_MULTI_ELEM *table, const VLC *single,
-    VLC_MULTI_ELEM info = { { 0, }, 0, };
+// FIXME: Crash CWE-416: Use After Free
+     VLC_MULTI_ELEM info = { { 0, }, 0, };
+
+    // Validate inputs to prevent use-after-free
+    if (!nb_codes || !numbits) {
+        return AVERROR(EINVAL);
+    }
@@ -439,3 +449,8 @@ static int vlc_multi_gen(VLC_MULTI_ELEM *table, const VLC *single,
-        table[j].len = single->table[j].len;
-        table[j].num = single->table[j].len > 0 ? 1 : 0;
