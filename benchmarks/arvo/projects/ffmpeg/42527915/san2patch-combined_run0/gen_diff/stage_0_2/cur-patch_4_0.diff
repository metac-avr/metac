diff --git a/libavcodec/vlc.c b/libavcodec/vlc.c
index 9656a9472c..6f39728e85 100644
--- a/libavcodec/vlc.c
+++ b/libavcodec/vlc.c
@@ -427 +427,2 @@ static int vlc_multi_gen(VLC_MULTI_ELEM *table, const VLC *single,
-    VLC_MULTI_ELEM info = { { 0, }, 0, };
