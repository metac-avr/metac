diff --git a/libavcodec/vlc.c b/libavcodec/vlc.c
index 9656a9472c..f834c0f348 100644
--- a/libavcodec/vlc.c
+++ b/libavcodec/vlc.c
@@ -437,0 +438,11 @@ static int vlc_multi_gen(VLC_MULTI_ELEM *table, const VLC *single,
+    // Validate single pointer and its table before use
+    if (!single) {
+        av_log(logctx, AV_LOG_ERROR, "NULL VLC pointer\n");
+        return AVERROR(EINVAL);
+    }
+    
+    if (!single->table) {
+        av_log(logctx, AV_LOG_ERROR, "Dangling VLC table reference\n");
+        return AVERROR(EINVAL);
+    }
+
@@ -495 +506 @@ int ff_init_vlc_multi_from_lengths(VLC *vlc, VLC_MULTI *multi, int nb_bits, int
-        }
+         }
@@ -497 +508,3 @@ int ff_init_vlc_multi_from_lengths(VLC *vlc, VLC_MULTI *multi, int nb_bits, int
-    ret = vlc_common_end(vlc, nb_bits, j, buf, flags, localbuf);
+    // Defer freeing until after vlc_multi_gen completes
+    int defer_free = 1;
+    ret = vlc_common_end(vlc, nb_bits, j, buf, flags, localbuf, defer_free);
@@ -500 +513,5 @@ int ff_init_vlc_multi_from_lengths(VLC *vlc, VLC_MULTI *multi, int nb_bits, int
-    return vlc_multi_gen(multi->table, vlc, nb_elems, j, nb_bits, buf, logctx);
+    ret = vlc_multi_gen(multi->table, vlc, nb_elems, j, nb_bits, buf, logctx);
+    // Now free the buffer since we're done with it
+    if (buf != localbuf)
+        av_free(buf);
+    return ret;
