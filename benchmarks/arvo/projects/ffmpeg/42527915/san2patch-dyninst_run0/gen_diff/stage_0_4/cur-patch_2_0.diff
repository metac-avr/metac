diff --git a/libavcodec/vlc.c b/libavcodec/vlc.c
index 9656a9472c..3de1fdc2aa 100644
--- a/libavcodec/vlc.c
+++ b/libavcodec/vlc.c
@@ -437,0 +438,6 @@ static int vlc_multi_gen(VLC_MULTI_ELEM *table, const VLC *single,
+    // Validate buffer bounds before table access to prevent use-after-free
+    if (nb_codes <= 0 || numbits <= 0) {
+        av_log(logctx, AV_LOG_ERROR, "Invalid parameters in vlc_multi_gen\n");
+        return AVERROR(EINVAL);
+    }
+
@@ -439,3 +445,6 @@ static int vlc_multi_gen(VLC_MULTI_ELEM *table, const VLC *single,
-        table[j].len = single->table[j].len;
-        table[j].num = single->table[j].len > 0 ? 1 : 0;
-        AV_WN16(table[j].val, single->table[j].sym);
+        // Bounds checking to prevent access to potentially freed memory
+        if (j < (1<<numbits) && single->table) {
+            table[j].len = single->table[j].len;
+            table[j].num = single->table[j].len > 0 ? 1 : 0;
+            AV_WN16(table[j].val, single->table[j].sym);
+        }
@@ -460,0 +470 @@ int ff_init_vlc_multi_from_lengths(VLC *vlc, VLC_MULTI *multi, int nb_bits, int
+    int cleanup_done = 0; // Track cleanup status
@@ -495 +505 @@ int ff_init_vlc_multi_from_lengths(VLC *vlc, VLC_MULTI *multi, int nb_bits, int
-        }
+         }
@@ -498 +508,2 @@ int ff_init_vlc_multi_from_lengths(VLC *vlc, VLC_MULTI *multi, int nb_bits, int
-    if (ret < 0)
+    if (ret < 0) {
+        cleanup_done = 1; // Mark cleanup as done
@@ -499,0 +511,8 @@ int ff_init_vlc_multi_from_lengths(VLC *vlc, VLC_MULTI *multi, int nb_bits, int
+    }
+    
+    // Prevent access after cleanup
+    if (cleanup_done) {
+        av_log(logctx, AV_LOG_ERROR, "Attempt to access cleaned up memory\n");
+        return AVERROR_INVALIDDATA;
+    }
+    
@@ -502 +521 @@ int ff_init_vlc_multi_from_lengths(VLC *vlc, VLC_MULTI *multi, int nb_bits, int
-    if (buf != localbuf)
+    if (!cleanup_done && buf != localbuf)
