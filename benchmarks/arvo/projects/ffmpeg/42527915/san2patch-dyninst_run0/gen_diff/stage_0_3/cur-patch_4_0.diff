diff --git a/libavcodec/vlc.c b/libavcodec/vlc.c
index 9656a9472c..4cd0642d4d 100644
--- a/libavcodec/vlc.c
+++ b/libavcodec/vlc.c
@@ -427 +427,2 @@ static int vlc_multi_gen(VLC_MULTI_ELEM *table, const VLC *single,
-    VLC_MULTI_ELEM info = { { 0, }, 0, };
+// FIXME: Crash CWE-416: Use After Free
+     VLC_MULTI_ELEM info = { { 0, }, 0, };
@@ -429,2 +430,7 @@ static int vlc_multi_gen(VLC_MULTI_ELEM *table, const VLC *single,
-    minbits = buf[nb_codes-1].bits;
-    maxbits = FFMIN(buf[0].bits, numbits);
+    minbits = buf ? buf[nb_codes-1].bits : 0;
+    maxbits = buf ? FFMIN(buf[0].bits, numbits) : 0;
+
+    if (!buf) {
+        av_log(logctx, AV_LOG_WARNING, "Buffer is NULL, skipping processing\n");
+        return 0;
+    }
@@ -495 +501 @@ int ff_init_vlc_multi_from_lengths(VLC *vlc, VLC_MULTI *multi, int nb_bits, int
-        }
+         }
@@ -497 +503 @@ int ff_init_vlc_multi_from_lengths(VLC *vlc, VLC_MULTI *multi, int nb_bits, int
-    ret = vlc_common_end(vlc, nb_bits, j, buf, flags, localbuf);
+    ret = vlc_common_end(vlc, nb_bits, j, &buf, flags, localbuf);
@@ -500 +506,5 @@ int ff_init_vlc_multi_from_lengths(VLC *vlc, VLC_MULTI *multi, int nb_bits, int
-    return vlc_multi_gen(multi->table, vlc, nb_elems, j, nb_bits, buf, logctx);
+    if (buf) {
+        return vlc_multi_gen(multi->table, vlc, nb_elems, j, nb_bits, buf, logctx);
+    } else {
+        return AVERROR(ENOMEM);
+    }
