-			 &packet->payload[s_offset], 2 /* 16 bit */ * sa_size);
-		}
-#endif
+static void ndpi_int_tls_dissect_certificate_signature_algorithms(struct ndpi_detection_module_struct *ndpi_struct, struct ndpi_flow_struct *flow, u_int16_t certificate_len) {
+  struct ndpi_packet_struct *packet = &ndpi_struct->packet;
+  u_int16_t d;
@@ -2385 +2385,2 @@ int processClientServerHello(struct ndpi_detection_module_struct *ndpi_struct,
-		ja.client.num_signature_algorithms = ndpi_min(sa_size, MAX_NUM_JA);
+  if((packet->payload_packet_len < certificate_len) || (packet->payload_packet_len < 8))
