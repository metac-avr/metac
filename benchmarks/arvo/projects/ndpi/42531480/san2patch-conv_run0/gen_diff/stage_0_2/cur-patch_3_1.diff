-		    duplicate_found = 1;
+    if((d + 2 >= packet->payload_packet_len) || (d + 2 >= certificate_len))
+      return;
+
+    if((packet->payload[d] == 0x06 /* OID */)
+       && (packet->payload[d+1] == 0x09 /* len */)
+       && (packet->payload[d+2] == 0x2a /* 1.2.840.113549.1.1.11 SHA256 with RSA */)) {
+      NDPI_LOG_INFO(ndpi_struct, "found SHA256 with RSA signature\n");
+      flow->protos.tls_quic.sha256_with_rsa = 1;
+    }
+  }
+}
