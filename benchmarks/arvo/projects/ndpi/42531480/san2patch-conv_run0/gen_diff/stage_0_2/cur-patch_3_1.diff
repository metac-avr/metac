-					 sizeof(ja.client.signature_algorithms_str)-i*2,
-					 "%02X", packet->payload[s_offset+i]);
-		  ja.client.signature_algorithms[id++] = ntohs(*(u_int16_t*)&packet->payload[s_offset+i*2]);
+  if(packet->payload[0] == 0x30 /* ASN.1 SEQUENCE */) {
+    u_int16_t sequence_len = (packet->payload[1] == 0x81) ? packet->payload[2] + 2 : (packet->payload[1] == 0x82) ? (packet->payload[2] << 8) | packet->payload[3] + 3 : packet->payload[1];
+    u_int16_t next_seq_start = 1 + ((packet->payload[1] <= 0x80) ? 1 : (packet->payload[1] == 0x81) ? 2 : 3);
@@ -2393,2 +2392,3 @@ int processClientServerHello(struct ndpi_detection_module_struct *ndpi_struct,
-		  if(rc < 0) break;
-		}
+    if((sequence_len + next_seq_start >= certificate_len)
+       || (sequence_len + next_seq_start >= packet->payload_packet_len))
+      return;
@@ -2396,2 +2396,7 @@ int processClientServerHello(struct ndpi_detection_module_struct *ndpi_struct,
-		for(i=0; i<tot_signature_algorithms_len && s_offset + (int)i + 2 < packet->payload_packet_len; i+=2) {
-		  u_int16_t signature_algo = (u_int16_t)ntohs(*((u_int16_t*)&packet->payload[s_offset+i]));
+    d = next_seq_start + 1;
+    if(packet->payload[d] == 0x80)
+      d++;
+    else if(packet->payload[d] == 0x81)
+      d += 2;
+    else if(packet->payload[d] == 0x82)
+      d += 3;
@@ -2399,3 +2404,11 @@ int processClientServerHello(struct ndpi_detection_module_struct *ndpi_struct,
-		  if(last_signature == signature_algo) {
