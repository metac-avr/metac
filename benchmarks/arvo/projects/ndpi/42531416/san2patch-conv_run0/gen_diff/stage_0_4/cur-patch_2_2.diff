diff --git a/src/lib/protocols/tls.c b/src/lib/protocols/tls.c
index 71f6eb0be..19fa64fd3 100644
--- a/src/lib/protocols/tls.c
+++ b/src/lib/protocols/tls.c
@@ -2381,2 +2381,24 @@ int processClientServerHello(struct ndpi_detection_module_struct *ndpi_struct,
-			 &packet->payload[s_offset], 2 /* 16 bit */ * sa_size);
-		}
+#ifdef TLS_HANDLE_SIGNATURE_ALGORITHMS
+    {
+      int s_offset;
+      u_int16_t sa_len, sa_size, tot_signature_algorithms_len;
+      u_int8_t  duplicate_found = 0, last_signature = 0xFF;
+      
+      s_offset = offset+extension_offset+4 /* skip extension type=len */ + 2 /* sig_alg_len */;
+      
+      if(s_offset >= total_len) {
+	return(1);
+      }
+      
+      memcpy(&sa_len, &packet->payload[s_offset-2], 2);
+      sa_len = ntohs(sa_len);
+      
+      sa_size = sa_len / 2; /* Each signature algorithm is 2 bytes */
+      tot_signature_algorithms_len = ndpi_min(sa_len, MAX_SIGNATURE_ALGORITHMS_LENGTH);
+      
+      if(tot_signature_algorithms_len + s_offset > total_len) {
+	return(1);
+      }
+      
+#ifdef DEBUG_TLS
+      printf("*** [TLS] ClientHello Signature Algorithms List (%u algorithms): ", sa_size);
@@ -2384,19 +2406,47 @@ int processClientServerHello(struct ndpi_detection_module_struct *ndpi_struct,
-
-		ja.client.num_signature_algorithms = ndpi_min(sa_size, MAX_NUM_JA);
-
-		for(i=0, id=0; i<tot_signature_algorithms_len && s_offset+i<total_len; i++) {
-		  int rc = ndpi_snprintf(&ja.client.signature_algorithms_str[i*2],
-					 sizeof(ja.client.signature_algorithms_str)-i*2,
-					 "%02X", packet->payload[s_offset+i]);
-		  ja.client.signature_algorithms[id++] = ntohs(*(u_int16_t*)&packet->payload[s_offset+i*2]);
-
-		  if(rc < 0) break;
-		}
-
-		for(i=0; i<tot_signature_algorithms_len && s_offset + (int)i + 2 < packet->payload_packet_len; i+=2) {
-		  u_int16_t signature_algo = (u_int16_t)ntohs(*((u_int16_t*)&packet->payload[s_offset+i]));
-
-		  if(last_signature == signature_algo) {
-		    /* Consecutive duplication */
-		    duplicate_found = 1;
-		    continue;
+      
+      if(sa_size > 0) {
+	for(i=0; i<sa_size; i++) {
+	  if(s_offset + i*2 + 1 < packet->payload_packet_len) {
+	    u_int16_t signature_algo = ntohs(*((u_int16_t*)&packet->payload[s_offset + i*2]));
+	    
+#ifdef DEBUG_TLS
+	    printf("[%u: 0x%04X/%u] ", i, signature_algo, signature_algo);
+#endif
+	    
+	    if(last_signature == signature_algo) {
+	      /* Consecutive duplication */
+	      duplicate_found = 1;
+	    } else {
+	      last_signature = signature_algo;
+	    }
+	    
+	    ja.client.signature_algorithms[i] = signature_algo;
+	  } else {
+	    break;
+	  }
+	}
+      }
+      
+      ja.client.num_signature_algorithms = ndpi_min(sa_size, MAX_NUM_JA);
+      
+      for(i=0, id=0; i<tot_signature_algorithms_len && s_offset+i<total_len; i++) {
+	int rc = ndpi_snprintf(&ja.client.signature_algorithms_str[i*2],
+				sizeof(ja.client.signature_algorithms_str)-i*2,
+				"%02X", packet->payload[s_offset+i]);
+	ja.client.signature_algorithms[id++] = ntohs(*(u_int16_t*)&packet->payload[s_offset+i*2]);
+	
+	if(rc < 0) break;
+      }
+      
+      for(i=0; i<tot_signature_algorithms_len && s_offset + (int)i + 2 < packet->payload_packet_len; i+=2) {
+	if(s_offset + i + 1 < packet->payload_packet_len) {
+	  u_int16_t signature_algo = (u_int16_t)ntohs(*((u_int16_t*)&packet->payload[s_offset+i]));
+	  
+	  if(last_signature == signature_algo) {
+	    /* Consecutive duplication */
+	    duplicate_found = 1;
+	  }
+	}
+      }
+    }
+#endif		    continue;
