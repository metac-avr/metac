diff --git a/example/reader_util.c b/example/reader_util.c
index 498c834f8..a0e5669bd 100644
--- a/example/reader_util.c
+++ b/example/reader_util.c
@@ -1630 +1630,2 @@ static struct ndpi_proto packet_processing(struct ndpi_workflow * workflow,
-    input_info.in_pkt_dir = NDPI_IN_PKT_DIR_UNKNOWN;
+// FIXME: Crash CWE-125: Out-of-bounds Read
+     input_info.in_pkt_dir = NDPI_IN_PKT_DIR_UNKNOWN;
@@ -1632,3 +1633,12 @@ static struct ndpi_proto packet_processing(struct ndpi_workflow * workflow,
-    flow->detected_protocol = ndpi_detection_process_packet(workflow->ndpi_struct, ndpi_flow,
-							    iph ? (uint8_t *)iph : (uint8_t *)iph6,
-							    ipsize, time_ms, &input_info);
+    
+    /* Input validation to prevent out-of-bounds access */
+    if((iph || iph6) && ipsize > 0) {
+      /* Limit ipsize to prevent buffer overflows */
+      u_int16_t validated_ipsize = (ipsize < 65535) ? ipsize : 65535;
+      flow->detected_protocol = ndpi_detection_process_packet(workflow->ndpi_struct, ndpi_flow,
+						iph ? (uint8_t *)iph : (uint8_t *)iph6,
+						validated_ipsize, time_ms, &input_info);
+    } else {
+      /* Initialize with safe defaults when input is invalid */
+      flow->detected_protocol.app_protocol = NDPI_PROTOCOL_UNKNOWN;
+    }
@@ -1655 +1665 @@ static struct ndpi_proto packet_processing(struct ndpi_workflow * workflow,
-							  enable_protocol_guess, &proto_guessed);
+						  enable_protocol_guess, &proto_guessed);
