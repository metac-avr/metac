+++ b/src/lib/ndpi_memory.c
@@ -76,0 +77,8 @@ void ndpi_free(void *ptr) {
+  // Validate pointer before attempting to free
+  if (!ptr) return;
+  
+  // Additional validation to prevent freeing invalid pointers
+  if ((uintptr_t)ptr < 0x1000 || (uintptr_t)ptr == 0x001ffffffff0) {
+    return;  // Reject obviously invalid pointers
+  }
+  
@@ -78,5 +86,3 @@ void ndpi_free(void *ptr) {
-    if(ptr)
-      _ndpi_free(ptr);
-  } else {
-    if(ptr)
-      free(ptr);
+    _ndpi_free(ptr);
+   } else {
+    free(ptr);
