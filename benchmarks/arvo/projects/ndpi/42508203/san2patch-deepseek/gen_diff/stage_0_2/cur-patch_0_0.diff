diff --git a/src/lib/protocols/http.c b/src/lib/protocols/http.c
index cf1e6282b..7a8ec8b93 100644
--- a/src/lib/protocols/http.c
+++ b/src/lib/protocols/http.c
@@ -1289,0 +1290,10 @@ static void ndpi_search_http_tcp(struct ndpi_detection_module_struct *ndpi_struc
+
+  /* Validate packet buffer bounds before HTTP content-type parsing to avoid
+     passing an overlong length to ndpi_strncasestr from
+     check_content_type_and_change_protocol. */
+  if(flow->packet.payload == NULL || flow->packet.payload_packet_len == 0)
+    return;
+
+  if(flow->packet.payload_packet_len > flow->packet.size)
+    return;
