diff --git a/src/lib/protocols/zoom.c b/src/lib/protocols/zoom.c
index 4ffad391a..a86a3b7be 100644
--- a/src/lib/protocols/zoom.c
+++ b/src/lib/protocols/zoom.c
@@ -205,10 +205,20 @@ static void ndpi_search_zoom(struct ndpi_detection_module_struct *ndpi_struct,
-    ip_len = ntohl(*(u_int32_t *)&packet->payload[24]);
-
-    if(24 + 4 + ip_len + 4 < packet->payload_packet_len) {
-      uuid_len = ntohl(*(u_int32_t *)&packet->payload[24 + 4 + ip_len]);
-
-      if(packet->payload_packet_len == 24 + 4 + ip_len + 4 + uuid_len + 4) {
-        NDPI_LOG_DBG(ndpi_struct, "found P2P Zoom\n");
-        flow->l4.udp.zoom_p2p = 1;
-        ndpi_int_zoom_add_connection(ndpi_struct, flow, NDPI_PROTOCOL_UNKNOWN);
-        return;
+    // Validate that we have enough data to read ip_len
+    if(packet->payload_packet_len >= 28) {
+      ip_len = ntohl(*(u_int32_t *)&packet->payload[24]);
+      
+      // Additional safety check for ip_len value to prevent integer overflow
+      if(ip_len > 0 && ip_len < packet->payload_packet_len) {
+        if(24 + 4 + ip_len + 4 < packet->payload_packet_len) {
+          // Validate we can safely read uuid_len
+          if((24 + 4 + ip_len + 4) <= (packet->payload_packet_len - 4)) {
+            uuid_len = ntohl(*(u_int32_t *)&packet->payload[24 + 4 + ip_len]);
+            
+            // Final validation check
+            if(packet->payload_packet_len == 24 + 4 + ip_len + 4 + uuid_len + 4) {
+              NDPI_LOG_DBG(ndpi_struct, "found P2P Zoom\n");
+              flow->l4.udp.zoom_p2p = 1;
+              ndpi_int_zoom_add_connection(ndpi_struct, flow, NDPI_PROTOCOL_UNKNOWN);
+              return;
+            }
+          }
+        }
