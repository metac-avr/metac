diff --git a/src/lib/protocols/zoom.c b/src/lib/protocols/zoom.c
index 4ffad391a..f33db07bc 100644
--- a/src/lib/protocols/zoom.c
+++ b/src/lib/protocols/zoom.c
@@ -205,10 +205,19 @@ static void ndpi_search_zoom(struct ndpi_detection_module_struct *ndpi_struct,
-    ip_len = ntohl(*(u_int32_t *)&packet->payload[24]);
-
-    if(24 + 4 + ip_len + 4 < packet->payload_packet_len) {
-      uuid_len = ntohl(*(u_int32_t *)&packet->payload[24 + 4 + ip_len]);
-
-      if(packet->payload_packet_len == 24 + 4 + ip_len + 4 + uuid_len + 4) {
-        NDPI_LOG_DBG(ndpi_struct, "found P2P Zoom\n");
