+    // Bounds checking added before each memory access
+    if ((packet->payload_packet_len > 27) && (packet->payload_packet_len >= 28)) { // Verify we can read at offset 24 for ip_len
+      ip_len = ntohl(*(u_int32_t *)&packet->payload[24]);
+      
+      // Validate intermediate calculation won't overflow and stays within bounds
+      if ((ip_len <= (packet->payload_packet_len - 28)) && (24 + 4 + ip_len + 4 < packet->payload_packet_len)) {
+        size_t uuid_offset = 24 + 4 + ip_len;
+        // Ensure uuid_len can be read safely
+        if ((uuid_offset + 4) <= packet->payload_packet_len) {
+          uuid_len = ntohl(*(u_int32_t *)&packet->payload[uuid_offset]);
