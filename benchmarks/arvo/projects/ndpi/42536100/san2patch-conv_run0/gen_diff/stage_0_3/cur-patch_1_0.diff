diff --git a/src/lib/protocols/zoom.c b/src/lib/protocols/zoom.c
index 4ffad391a..a571a91c3 100644
--- a/src/lib/protocols/zoom.c
+++ b/src/lib/protocols/zoom.c
@@ -205,10 +205,21 @@ static void ndpi_search_zoom(struct ndpi_detection_module_struct *ndpi_struct,
-    ip_len = ntohl(*(u_int32_t *)&packet->payload[24]);
-
-    if(24 + 4 + ip_len + 4 < packet->payload_packet_len) {
-      uuid_len = ntohl(*(u_int32_t *)&packet->payload[24 + 4 + ip_len]);
-
-      if(packet->payload_packet_len == 24 + 4 + ip_len + 4 + uuid_len + 4) {
-        NDPI_LOG_DBG(ndpi_struct, "found P2P Zoom\n");
-        flow->l4.udp.zoom_p2p = 1;
-        ndpi_int_zoom_add_connection(ndpi_struct, flow, NDPI_PROTOCOL_UNKNOWN);
-        return;
+    if(packet->payload_packet_len >= 28) { // Validate minimum packet size before accessing ip_len
+      ip_len = ntohl(*(u_int32_t *)&packet->payload[24]);
+      
+      // Validate ip_len to prevent integer overflow and out-of-bounds access
+      if(ip_len > 0 && ip_len < packet->payload_packet_len - 28) {
+        if(24 + 4 + ip_len + 4 < packet->payload_packet_len) {
+          // Validate minimum remaining packet size before accessing uuid_len
+          if(packet->payload_packet_len >= 24 + 4 + ip_len + 4) {
+            uuid_len = ntohl(*(u_int32_t *)&packet->payload[24 + 4 + ip_len]);
+
+            // Validate uuid_len to prevent integer overflow
+            if(uuid_len > 0 && uuid_len < packet->payload_packet_len - (24 + 4 + ip_len + 4)) {
+              if(packet->payload_packet_len == 24 + 4 + ip_len + 4 + uuid_len + 4) {
+                NDPI_LOG_DBG(ndpi_struct, "found P2P Zoom\n");
+                flow->l4.udp.zoom_p2p = 1;
+                ndpi_int_zoom_add_connection(ndpi_struct, flow, NDPI_PROTOCOL_UNKNOWN);
+                return;
+              }
+            }
+          }
+        }
