+      if(!new_ptr) {
+        NDPI_LOG_DBG(ndpi_str, "Realloc error\n");
+        return;
+      }
+      ndpi_str->ndpi_to_user_proto_id = new_ptr;
+      ndpi_str->ndpi_to_user_proto_id_num_allocated = new_num;
+    } else {
