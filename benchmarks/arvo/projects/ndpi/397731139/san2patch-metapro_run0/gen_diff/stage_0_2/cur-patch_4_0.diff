+// FIXME: Crash CWE-787: Out-of-bounds Write
+       size_t length = strlen(flow->info);
+       size_t remaining_space = sizeof(flow->info) - length;
+
+      if (remaining_space > 1) {  // Ensure at least 1 byte for null terminator
+        size_t url_len = strlen(flow->ndpi_flow->protos.slp.url[i]);
+        size_t copy_len = (url_len < remaining_space - 1) ? url_len : remaining_space - 1;
+        strncat(flow->info + length, flow->ndpi_flow->protos.slp.url[i], copy_len);
+        length += copy_len;
+      }
