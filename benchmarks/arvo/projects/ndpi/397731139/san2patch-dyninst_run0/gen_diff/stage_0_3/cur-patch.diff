+// FIXME: Crash CWE-125: Out-of-bounds Read
+       size_t info_len = strlen(flow->info);
+       size_t url_len = strlen(flow->ndpi_flow->protos.slp.url[i]);
+       
+       // Check if there's enough space for URL and potential comma separator
+       if ((info_len + url_len + ((i < (size_t)flow->ndpi_flow->protos.slp.url_count - 1) ? 2 : 0)) < sizeof(flow->info)) {
+         strncat(flow->info + info_len, flow->ndpi_flow->protos.slp.url[i],
+                 sizeof(flow->info) - info_len - 1);
+         info_len += url_len;
+
+         if (i < (size_t)flow->ndpi_flow->protos.slp.url_count - 1)
+           strncat(flow->info + info_len, ", ", sizeof(flow->info) - info_len - 1);
