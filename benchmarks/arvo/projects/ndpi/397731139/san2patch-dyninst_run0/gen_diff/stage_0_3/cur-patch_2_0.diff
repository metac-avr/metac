diff --git a/example/reader_util.c b/example/reader_util.c
index 6656143f6..c906e5ebc 100644
--- a/example/reader_util.c
+++ b/example/reader_util.c
@@ -1377,8 +1377,22 @@ void process_ndpi_collected_info(struct ndpi_workflow * workflow, struct ndpi_fl
-      size_t length = strlen(flow->info);
-
-      strncat(flow->info + length, flow->ndpi_flow->protos.slp.url[i],
-              sizeof(flow->info) - length);
-      length = strlen(flow->info);
-
-      if (i < (size_t)flow->ndpi_flow->protos.slp.url_count - 1)
-        strncat(flow->info + length, ", ", sizeof(flow->info) - length);
+// FIXME: Crash CWE-125: Out-of-bounds Read
+       size_t length = strlen(flow->info);
+       
+       // Pre-calculate the maximum characters we can safely copy
+       size_t max_copy = sizeof(flow->info) - length - 1; // Reserve 1 for null terminator
+       
+       if (max_copy > 0) { // Only proceed if there's space
+         size_t url_len = strlen(flow->ndpi_flow->protos.slp.url[i]);
+         
+         // Limit the copy to available space
+         size_t copy_len = (url_len < max_copy) ? url_len : max_copy;
+         strncat(flow->info + length, flow->ndpi_flow->protos.slp.url[i], copy_len);
+         
+         length = strlen(flow->info);
+         
+         // Add separator only if there's space and it's not the last item
+         if (i < (size_t)flow->ndpi_flow->protos.slp.url_count - 1) {
+           if (length + 2 < sizeof(flow->info)) { // Need space for ", " and null terminator
+             strncat(flow->info + length, ", ", sizeof(flow->info) - length - 1);
+           }
+         }
+       }
