+        freed_ptrs[freed_count++] = ptr;
+      }
+    }
+   } else {
+    if(ptr) {
+      // Same double-free protection for system free
+      static void *freed_ptrs[1024];
+      static int freed_count = 0;
+      int i;
+      
+      // Check if already freed
+      for(i = 0; i < freed_count && i < 1024; i++) {
