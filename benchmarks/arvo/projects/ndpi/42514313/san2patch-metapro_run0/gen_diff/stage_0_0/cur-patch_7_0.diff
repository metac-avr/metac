diff --git a/src/lib/ndpi_main.c b/src/lib/ndpi_main.c
index 0f59ca608..cde9e67ed 100644
--- a/src/lib/ndpi_main.c
+++ b/src/lib/ndpi_main.c
@@ -238,6 +238,10 @@ void ndpi_free(void *ptr) {
-  if(_ndpi_free) {
-    if(ptr)
-      _ndpi_free(ptr);
-  } else {
-    if(ptr)
-      free(ptr);
+  // Additional safety check for invalid pointer dereference
+  if(ptr) {
+    volatile void* temp_ptr = ptr;  // Prevent compiler optimization
