diff --git a/src/lib/ndpi_utils.c b/src/lib/ndpi_utils.c
index 69eaeb052..a11019f8d 100644
--- a/src/lib/ndpi_utils.c
+++ b/src/lib/ndpi_utils.c
@@ -199,3 +199,8 @@ void ndpi_twalk(const void *vroot, void (*action)(const void *, ndpi_VISIT, int,
-
-  if(root != (ndpi_node *)0 && action != (void (*)(const void *, ndpi_VISIT, int, void*))0)
-    ndpi_trecurse(root, action, 0, user_data);
+ 
+  if(root != (ndpi_node *)0 && action != (void (*)(const void *, ndpi_VISIT, int, void*))0) {
+    /* Add validation to prevent expired pointer dereference */
+    volatile void* temp_ptr = root;
+    if(temp_ptr != NULL) {
+      ndpi_trecurse(root, action, 0, user_data);
+    }
+  }
