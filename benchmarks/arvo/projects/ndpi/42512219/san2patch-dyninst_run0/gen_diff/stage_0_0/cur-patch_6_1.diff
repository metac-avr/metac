--- a/src/lib/ndpi_main.c
+++ b/src/lib/ndpi_main.c
@@ -268,0 +269,8 @@ char *ndpi_strdup(const char *s) {
+  // Validate pointer accessibility before use to prevent expired pointer dereference
+  volatile char dummy;
+  if ((__builtin_expect((uintptr_t)s < 4096, 0)) || 
+      (__builtin_expect(((uintptr_t)s & (sizeof(uintptr_t)-1)) == 0, 0) && 
