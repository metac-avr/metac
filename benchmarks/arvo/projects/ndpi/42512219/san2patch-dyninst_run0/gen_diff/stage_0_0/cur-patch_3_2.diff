diff --git a/src/lib/ndpi_main.c b/src/lib/ndpi_main.c
index 88730350a..817240a84 100644
--- a/src/lib/ndpi_main.c
+++ b/src/lib/ndpi_main.c
@@ -268,0 +269,12 @@ char *ndpi_strdup(const char *s) {
+  // Validate pointer before use - Check if memory is accessible
+  volatile char *test_ptr = s;
+  char test_val;
+  
+  // Simple validity check to prevent expired pointer dereference
+  if(s != NULL) {
+    // Attempt to access the first byte to validate pointer
+    test_val = *test_ptr;
+    // Compiler barrier to prevent optimization
+    __asm__ __volatile__("" : : "r"(test_val) : "memory");
+  }
+  
