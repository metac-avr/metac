diff --git a/src/lib/ndpi_main.c b/src/lib/ndpi_main.c
index 88730350a..afcd4b06f 100644
--- a/src/lib/ndpi_main.c
+++ b/src/lib/ndpi_main.c
@@ -269,2 +269,26 @@ char *ndpi_strdup(const char *s) {
-  int len = strlen(s);
-  char *m = ndpi_malloc(len + 1);
+  // Use a safer approach to determine string length
+  // Check for basic pointer validity before calling strlen
+  
+  // First verify the pointer is reasonably aligned
+  if((((uintptr_t)s) % sizeof(char)) != 0) {
+    return NULL; // Misaligned pointer likely indicates corruption
+  }
+  
+  // Perform a bounded scan instead of direct strlen call
+  const char *p = s;
+  size_t count = 0;
+  const size_t max_scan = 8192; // Safety limit for scanning
+  
+  while(count < max_scan) {
+    if(*p == '\0') break;
+    p++;
+    count++;
+  }
+  
+  // If we hit the scan limit, the string is likely corrupted
+  if(count >= max_scan) {
+    return NULL;
+  }
+  
+  // Now it's safer to proceed with normal duplication
+  char *m = ndpi_malloc(count + 1);
@@ -273,2 +297,2 @@ char *ndpi_strdup(const char *s) {
-    memcpy(m, s, len);
-    m[len] = '\0';
+    memcpy(m, s, count);
+    m[count] = '\0';
