--- a/example/reader_util.c
+++ b/example/reader_util.c
@@ -2100,10 +2100 @@ struct ndpi_proto ndpi_workflow_process_packet(struct ndpi_workflow * workflow,
-	      tunnel_type = ndpi_capwap_tunnel;
-	      goto iph_check;
-	    }
-	  }
-	}
-      }
-    }
-  }
-
-  /* process the packet */
+/* process the packet */
@@ -2120,0 +2112,50 @@ static uint32_t crc32_for_byte(uint32_t r) {
+  for(int j = 0; j < 8; ++j)
+    r = ((r & 1) ? 0 : (uint32_t)0xEDB88320L) ^ r >> 1;
+  return r ^ (uint32_t)0xFF000000L;
+}
+
+static void init_tables(uint32_t* table, uint32_t* wtable) {
+  for(uint32_t i = 0; i < 256; ++i)
+    table[i] = crc32_for_byte(i);
+  for(uint32_t k = 0; k < 4; ++k)
+    for(uint32_t w, i = 0; i < 256; ++i) {
+      w = table[i] >> 24;
+      wtable[i * 4 + k] = table[(i + w) & 0xFF] ^ (w << 8);
+    }
+}
+
+static void __crc32(const void* data, size_t n_bytes, uint32_t* crc) {
+  static uint32_t table[256], wtable[1024];
+  static int tables_initialized = 0;
+
+  if(!tables_initialized) {
+    init_tables(table, wtable);
+    tables_initialized = 1;
+  }
+
+  const uint8_t* current = (const uint8_t*) data;
+  uint32_t c = *crc;
+
+  while(n_bytes >= 4) {
+    uint32_t d = (uint32_t) current[0] | ((uint32_t) current[1] << 8) |
+		 ((uint32_t) current[2] << 16) | ((uint32_t) current[3] << 24);
+    c ^= d;
+    c = wtable[(c & 0xFF) * 4 + 3] ^
+	wtable[((c >> 8) & 0xFF) * 4 + 2] ^
+	wtable[((c >> 16) & 0xFF) * 4 + 1] ^
+	wtable[(c >> 24) * 4];
+    current += 4;
+    n_bytes -= 4;
+  }
+
+  while(n_bytes--)
+    c = table[(c ^ *current++) & 0xFF] ^ (c >> 8);
+
+  *crc = c;
+}
+
+u_int32_t ethernet_crc32(const void* data, size_t n_bytes) {
+  uint32_t crc = 0xFFFFFFFF;
+  __crc32(data, n_bytes, &crc);
+  return crc;
+}
