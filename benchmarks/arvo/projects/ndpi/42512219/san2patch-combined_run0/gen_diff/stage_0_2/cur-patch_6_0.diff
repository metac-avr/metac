diff --git a/src/lib/ndpi_main.c b/src/lib/ndpi_main.c
index 88730350a..858614bac 100644
--- a/src/lib/ndpi_main.c
+++ b/src/lib/ndpi_main.c
@@ -269 +269,20 @@ char *ndpi_strdup(const char *s) {
-  int len = strlen(s);
+  // Add signal handler to catch SIGSEGV during strlen operation
+  volatile int segv_caught = 0;
+  void (*old_handler)(int) = signal(SIGSEGV, [](int sig) { 
+    segv_caught = 1; 
+    signal(SIGSEGV, old_handler);
+    longjmp(env, 1);
+  });
+  jmp_buf env;
+  if(setjmp(env) != 0) {
+    signal(SIGSEGV, old_handler);
+    return NULL;
+  }
+  
+  int len;
+  if(segv_caught || (len = strlen(s)) < 0) {
+    signal(SIGSEGV, old_handler);
+    return NULL;
+  }
+  signal(SIGSEGV, old_handler);
+  
