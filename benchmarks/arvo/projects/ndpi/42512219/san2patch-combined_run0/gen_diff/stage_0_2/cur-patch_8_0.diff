--- a/src/lib/ndpi_main.c
+++ b/src/lib/ndpi_main.c
@@ -269 +269,8 @@ char *ndpi_strdup(const char *s) {
-  int len = strlen(s);
+  // Use safer approach with bounded string copy
+  char temp_buffer[4096];  // Reasonable buffer size
+  if(strncpy(temp_buffer, s, sizeof(temp_buffer)-1) == NULL) {
+    return NULL;
+  }
+  temp_buffer[sizeof(temp_buffer)-1] = '\0';  // Ensure null termination
+  
+  int len = strlen(temp_buffer);
@@ -273 +280 @@ char *ndpi_strdup(const char *s) {
-    memcpy(m, s, len);
+    memcpy(m, temp_buffer, len);
