diff --git a/src/lib/ndpi_utils.c b/src/lib/ndpi_utils.c
index 25d7e2cc6..ef9a5f5e8 100644
--- a/src/lib/ndpi_utils.c
+++ b/src/lib/ndpi_utils.c
@@ -2801 +2801,19 @@ int ndpi_vsnprintf(char * str, size_t size, char const * format, va_list va_args
-  return vsnprintf(str, size, format, va_args);
+  if((str == NULL) || (format == NULL)) {
+    return -1;
+  }
+  
+  if(size == 0) {
+    return 0;
+  }
+  
+  int ret = vsnprintf(str, size, format, va_args);
+  
+  /* Prevent buffer overflow by checking bounds */
+  if(ret < 0 || ret >= (int)size) {
+    if(size > 0) {
+      str[size-1] = '\0';
+    }
+    return -1;
+  }
+  
+  return ret;
diff --git a/src/lib/ndpi_serializer.c b/src/lib/ndpi_serializer.c
index 9a27add4d..f0885c8e7 100644
--- a/src/lib/ndpi_serializer.c
+++ b/src/lib/ndpi_serializer.c
@@ -278 +278,8 @@ static inline int ndpi_extend_serializer_buffer(ndpi_private_serializer_buffer *
-  new_size = ((new_size / 4) + 1) * 4; /* required by zmq encryption */
+  /* Calculate aligned size ensuring it's larger than current buffer size */
+  u_int32_t aligned_size = ((new_size / 4) + 1) * 4; /* required by zmq encryption */
+  
+  /* Validate that aligned size is sufficient */
+  if(aligned_size <= buffer->size)
+    return(-1);
+    
+  new_size = aligned_size;
