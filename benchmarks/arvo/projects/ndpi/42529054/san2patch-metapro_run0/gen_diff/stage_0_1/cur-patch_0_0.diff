diff --git a/src/lib/ndpi_utils.c b/src/lib/ndpi_utils.c
index 25d7e2cc6..fdeb61c9b 100644
--- a/src/lib/ndpi_utils.c
+++ b/src/lib/ndpi_utils.c
@@ -2801 +2801,14 @@ int ndpi_vsnprintf(char * str, size_t size, char const * format, va_list va_args
-  return vsnprintf(str, size, format, va_args);
+  if((str == NULL) || (size == 0) || (format == NULL)) {
+    return -1;
+  }
+  
+  int ret = vsnprintf(str, size, format, va_args);
+  
+  /* Check for buffer overflow */
+  if(ret >= (int)size && size > 0) {
+    /* Ensure null termination */
+    str[size-1] = '\0';
+    return -1;
+  }
+  
+  return ret;
diff --git a/src/lib/ndpi_serializer.c b/src/lib/ndpi_serializer.c
index 9a27add4d..68532293e 100644
--- a/src/lib/ndpi_serializer.c
+++ b/src/lib/ndpi_serializer.c
@@ -278,0 +279,4 @@ static inline int ndpi_extend_serializer_buffer(ndpi_private_serializer_buffer *
+  
+  /* Ensure new_size is actually larger than current size to prevent underflow */
+  if(new_size <= buffer->size)
+    return(-1);
