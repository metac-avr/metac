diff --git a/src/lib/ndpi_utils.c b/src/lib/ndpi_utils.c
index 25d7e2cc6..2b96d625f 100644
--- a/src/lib/ndpi_utils.c
+++ b/src/lib/ndpi_utils.c
@@ -2800,0 +2801,24 @@ int ndpi_vsnprintf(char * str, size_t size, char const * format, va_list va_args
+  /* Enhanced buffer overflow protection */
+  if(str == NULL || format == NULL) {
+    return -1;
+  }
+  
+  if(size == 0) {
+    return 0;
+  }
+  
+  /* Use a temporary buffer to check size requirements */
+  int needed_size = vsnprintf(NULL, 0, format, va_args);
+  if(needed_size < 0) {
+    return -1;
+  }
+  
+  if((size_t)needed_size >= size) {
+    /* Not enough space, but still try to write what we can */
+    int ret = vsnprintf(str, size, format, va_args);
+    if(size > 0) {
+      str[size-1] = '\0';
+    }
+    return -1;
+  }
+  
