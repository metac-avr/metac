diff --git a/src/lib/ndpi_utils.c b/src/lib/ndpi_utils.c
index 25d7e2cc6..3c6664064 100644
--- a/src/lib/ndpi_utils.c
+++ b/src/lib/ndpi_utils.c
@@ -2801 +2801,14 @@ int ndpi_vsnprintf(char * str, size_t size, char const * format, va_list va_args
-  return vsnprintf(str, size, format, va_args);
+  if((str == NULL) || (size == 0) || (format == NULL)) {
+    return -1;
+  }
+  
+  int ret = vsnprintf(str, size, format, va_args);
+  
+  if(ret < 0 || (size_t)ret >= size) {
+    if(size > 0) {
+      str[0] = '\0';
+    }
+    return -1;
+  }
+  
+  return ret;
