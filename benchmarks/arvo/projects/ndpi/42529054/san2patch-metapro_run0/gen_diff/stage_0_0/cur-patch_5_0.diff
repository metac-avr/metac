diff --git a/src/lib/ndpi_utils.c b/src/lib/ndpi_utils.c
index 25d7e2cc6..ddf1a814c 100644
--- a/src/lib/ndpi_utils.c
+++ b/src/lib/ndpi_utils.c
@@ -2801 +2801,10 @@ int ndpi_vsnprintf(char * str, size_t size, char const * format, va_list va_args
-  return vsnprintf(str, size, format, va_args);
+  if(str == NULL || format == NULL || size == 0) {
+    return -1;
+  }
+  
+  int written = vsnprintf(str, size, format, va_args);
+  if(written >= (int)size) {
+    str[size-1] = '\0';
+    return -1;
+  }
+  return written;
@@ -2822,6 +2831,8 @@ int ndpi_snprintf(char * str, size_t size, char const * format, ...) {
-
-  va_start(va_args, format);
-  int ret = ndpi_vsnprintf(str, size, format, va_args);
-  va_end(va_args);
-
-  return ret;
+  
+  if (size > 0 && str != NULL) {
+    va_start(va_args, format);
+    int ret = ndpi_vsnprintf(str, size, format, va_args);
+    va_end(va_args);
+    return ret;
+  }
+  return -1;
