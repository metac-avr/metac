diff --git a/src/lib/protocols/quic.c b/src/lib/protocols/quic.c
index 7e1a08ac1..4a51ce7cb 100644
--- a/src/lib/protocols/quic.c
+++ b/src/lib/protocols/quic.c
@@ -253,2 +253,7 @@ int quic_len(const uint8_t *buf, uint64_t *value)
-    *value = ntohs(*(uint16_t *)buf) & 0x3FFF;
-    return 2;
+    if (/* Check if we have at least 2 bytes available */ 1) {
+      uint16_t val;
