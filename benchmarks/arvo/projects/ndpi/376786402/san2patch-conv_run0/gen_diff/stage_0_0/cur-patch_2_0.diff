diff --git a/src/lib/protocols/http.c b/src/lib/protocols/http.c
index 1c468165c..fcf1944b2 100644
--- a/src/lib/protocols/http.c
+++ b/src/lib/protocols/http.c
@@ -1038,3 +1038,15 @@ static void check_content_type_and_change_protocol(struct ndpi_detection_module_
-
-      if(content != NULL) {
-	char *double_dot = strchr((char*)content, ':');
+ 
+      if(content != NULL && content_len > 0) {
+        /* Bounds-check before using string functions */
+        if(content[content_len - 1] != '\0') {
+          u_char *temp_content = (u_char*)ndpi_malloc(content_len + 1);
+          if(temp_content != NULL) {
+            memcpy(temp_content, content, content_len);
+            temp_content[content_len] = '\0';
+            ndpi_free(content);
+            content = temp_content;
+            content_len += 1;
+          }
+        }
+        
+        char *double_dot = strchr((char*)content, ':');
