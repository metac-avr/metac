@@ -992,0 +993,12 @@ u_char* ndpi_base64_decode(const u_char *src, size_t len, size_t *out_len) {
+  
+  // Add null terminator safety check
+  if(*out_len > 0 && out[*out_len - 1] != '\0') {
+    u_char* new_out = ndpi_realloc(out, *out_len, *out_len + 1);
+    if(new_out == NULL) {
+      ndpi_free(out);
+      return NULL;
+    }
+    new_out[*out_len] = '\0';
+    (*out_len)++;
+    out = new_out;
