diff --git a/src/lib/protocols/http.c b/src/lib/protocols/http.c
index 1c468165c..d6fe647c7 100644
--- a/src/lib/protocols/http.c
+++ b/src/lib/protocols/http.c
@@ -1034 +1034,2 @@ static void check_content_type_and_change_protocol(struct ndpi_detection_module_
-      size_t content_len;
+// FIXME: Crash CWE-125: Out-of-bounds Read
+       size_t content_len;
@@ -1037 +1038 @@ static void check_content_type_and_change_protocol(struct ndpi_detection_module_
-					   packet->authorization_line.len - len, &content_len);
