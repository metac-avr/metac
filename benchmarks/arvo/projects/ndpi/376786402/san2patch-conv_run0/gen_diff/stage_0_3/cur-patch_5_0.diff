@@ -1040 +1041,10 @@ static void check_content_type_and_change_protocol(struct ndpi_detection_module_
-	char *double_dot = strchr((char*)content, ':');
+	// Use bounded string search instead of strchr
+	char *double_dot = NULL;
+	if(content_len > 0) {
