@@ -956,0 +957,13 @@ static uint8_t *decrypt_initial_packet(struct ndpi_detection_module_struct *ndpi
+  
+  /* Bounds checking before first quic_len call */
+  if(pn_offset >= packet->payload_packet_len || &packet->payload[pn_offset] == NULL) {
+    quic_ciphers_reset(&ciphers);
+    return NULL;
+  }
+  
+  size_t remaining_len = packet->payload_packet_len - pn_offset;
+  if(remaining_len < 8) {  /* quic_len needs at least 8 bytes */
+    quic_ciphers_reset(&ciphers);
+    return NULL;
+  }
+  
@@ -963,0 +977,13 @@ static uint8_t *decrypt_initial_packet(struct ndpi_detection_module_struct *ndpi
+  
+  /* Bounds checking before second quic_len call */
+  if(pn_offset >= packet->payload_packet_len || &packet->payload[pn_offset] == NULL) {
+    quic_ciphers_reset(&ciphers);
+    return NULL;
+  }
+  
+  remaining_len = packet->payload_packet_len - pn_offset;
+  if(remaining_len < 8) {  /* quic_len needs at least 8 bytes */
+    quic_ciphers_reset(&ciphers);
+    return NULL;
+  }
