+    if(source_conn_id_offset >= packet->payload_len) {
+        NDPI_LOG_DBG(ndpi_struct, "Invalid QUIC packet offset: %u\n", source_conn_id_offset);
+        return NULL;
+    }
+    source_conn_id_len = packet->payload[source_conn_id_offset];
