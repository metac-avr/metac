+  
+  /* Additional bounds check before second quic_len call */
+  if(pn_offset + 8 >= packet->payload_packet_len) {
+    quic_ciphers_reset(&ciphers);
+    return NULL;
+  }
+  
+  payload_ptr = &packet->payload[pn_offset];
+  if(payload_ptr == NULL) {
