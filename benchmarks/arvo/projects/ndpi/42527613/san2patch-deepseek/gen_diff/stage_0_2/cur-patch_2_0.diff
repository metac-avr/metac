+  char *dot, *end;
@@ -394,2 +394,12 @@ u_int16_t ndpi_domain_classify_contains(ndpi_domain_classify *_s,
-  if((len = strlen(domain)) == 0)                         return(0);
-  if((dot = strrchr(domain, '.')) == NULL)                return(0);
