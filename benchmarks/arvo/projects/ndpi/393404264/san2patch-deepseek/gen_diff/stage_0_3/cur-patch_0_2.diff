diff --git a/src/lib/ndpi_serializer.c b/src/lib/ndpi_serializer.c
index 3cda728bd..49ca7461b 100644
--- a/src/lib/ndpi_serializer.c
+++ b/src/lib/ndpi_serializer.c
@@ -2113 +2113,67 @@ int ndpi_serialize_string_string_len(ndpi_serializer *_serializer,
-				      value, value_len));
+}
+
+static int ndpi_serialize_binary_raw(ndpi_serializer *_serializer,
+					 const char *key, u_int16_t key_len,
+					 const char *value, u_int16_t value_len,
+					 u_int8_t escape) {
+  ndpi_private_serializer *serializer = (ndpi_private_serializer *)_serializer;
+  char *buf;
+  u_int16_t buf_len;
+
+  if (!serializer)
+    return -1;
+
+  if (key == NULL || key_len == 0)
+    return -1;
+
+  if (serializer->status.flags & NDPI_SERIALIZER_STATUS_JSON_COMMA_REQUIRED) {
+    if (ndpi_serialize_raw_record(serializer, ",", 1) < 0)
+      return -1;
+  }
+
+  buf_len = key_len + value_len + 16;
+  buf = (char *)ndpi_serializer_malloc(serializer, buf_len);
+  if (buf == NULL)
+    return -1;
+
+  if (ndpi_serialize_raw_record(serializer, "\"", 1) < 0) {
+    ndpi_serializer_free(serializer, buf, buf_len);
+    return -1;
+  }
+
+  if (ndpi_serialize_escape_string(serializer, key, key_len, &buf, &buf_len) < 0) {
+    ndpi_serializer_free(serializer, buf, buf_len);
+    return -1;
+  }
+
+  if (ndpi_serialize_raw_record(serializer, "\":", 2) < 0) {
+    ndpi_serializer_free(serializer, buf, buf_len);
+    return -1;
+  }
+
+  if (escape) {
+    if (ndpi_serialize_raw_record(serializer, "\"", 1) < 0) {
+      ndpi_serializer_free(serializer, buf, buf_len);
+      return -1;
+    }
+
+    if (ndpi_serialize_escape_string(serializer, value, value_len, &buf, &buf_len) < 0) {
+      ndpi_serializer_free(serializer, buf, buf_len);
+      return -1;
+    }
+
+    if (ndpi_serialize_raw_record(serializer, "\"", 1) < 0) {
+      ndpi_serializer_free(serializer, buf, buf_len);
+      return -1;
+    }
+  } else {
+    if (ndpi_serialize_raw_record(serializer, value, value_len) < 0) {
+      ndpi_serializer_free(serializer, buf, buf_len);
+      return -1;
+    }
+  }
+
+  ndpi_serializer_free(serializer, buf, buf_len);
+  serializer->status.flags |= NDPI_SERIALIZER_STATUS_JSON_COMMA_REQUIRED;
+
+  return 0;
@@ -2132,3 +2198 @@ int ndpi_serialize_string_raw(ndpi_serializer *_serializer,
-}
-
-/* ********************************** */
+}/* ********************************** */
