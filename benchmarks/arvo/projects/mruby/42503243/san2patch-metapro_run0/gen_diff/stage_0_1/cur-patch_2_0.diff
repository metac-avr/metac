diff --git a/src/vm.c b/src/vm.c
index 1c59d4406..753773791 100644
--- a/src/vm.c
+++ b/src/vm.c
@@ -515,2 +515,7 @@ mrb_funcall_with_block(mrb_state *mrb, mrb_value self, mrb_sym mid, mrb_int argc
