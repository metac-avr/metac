diff --git a/src/vm.c b/src/vm.c
index 1c59d4406..f92edb81a 100644
--- a/src/vm.c
+++ b/src/vm.c
@@ -515,2 +515,7 @@ mrb_funcall_with_block(mrb_state *mrb, mrb_value self, mrb_sym mid, mrb_int argc
-      if (argc > 0)
-        stack_copy(ci->stack+1, argv, argc);
+      if (argc > 0) {
+        if (argc + 1 < MRB_VM_STACK_MAX) {
+          stack_copy(ci->stack+1, argv, argc);
+        } else {
+          mrb_raise(mrb, E_RUNTIME_ERROR, "stack overflow in funcall");
+        }
+      }
