diff --git a/src/vm.c b/src/vm.c
index 1c59d4406..cd240d5c9 100644
--- a/src/vm.c
+++ b/src/vm.c
@@ -517 +517,8 @@ mrb_funcall_with_block(mrb_state *mrb, mrb_value self, mrb_sym mid, mrb_int argc
