diff --git a/src/array.c b/src/array.c
index fc3b0a087..a3b3fde91 100644
--- a/src/array.c
+++ b/src/array.c
@@ -147,2 +147,2 @@ ary_modify(mrb_state *mrb, struct RArray *a)
