--- a/src/numeric.c
+++ b/src/numeric.c
@@ -1807,4 +1806,0 @@ mrb_integer_to_str(mrb_state *mrb, mrb_value x, mrb_int base)
- *     12345.to_s(16)   #=> "3039"
- *     12345.to_s(36)   #=> "9ix"
- *
