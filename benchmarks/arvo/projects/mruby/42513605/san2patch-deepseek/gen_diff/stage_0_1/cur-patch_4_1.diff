diff --git a/src/numeric.c b/src/numeric.c
index 239492add..2a236772c 100644
--- a/src/numeric.c
+++ b/src/numeric.c
@@ -1807,4 +1806,0 @@ mrb_integer_to_str(mrb_state *mrb, mrb_value x, mrb_int base)
- *     12345.to_s(16)   #=> "3039"
- *     12345.to_s(36)   #=> "9ix"
- *
- */
@@ -1816,0 +1813,8 @@ int_to_s(mrb_state *mrb, mrb_value self)
+#ifdef MRB_USE_BIGINT
+  if (mrb_bigint_p(self)) {
+    size_t size;
+    if (mrb_bint_len(mrb, self, &size) != 0 || size > MRB_INT_MAX) {
+      mrb_raise(mrb, E_RANGE_ERROR, "integer too big to convert to string");
+    }
+  }
+#endif
@@ -1828,0 +1833,12 @@ cmpnum(mrb_state *mrb, mrb_value v1, mrb_value v2)
+  if (mrb_float_p(v1) || mrb_float_p(v2)) {
+    return mrb_float_cmp(mrb, v1, v2);
+  }
+  if (mrb_fixnum_p(v1) && mrb_fixnum_p(v2)) {
+    mrb_int i1 = mrb_fixnum(v1);
+    mrb_int i2 = mrb_fixnum(v2);
+    if (i1 < i2) return -1;
+    if (i1 > i2) return 1;
+    return 0;
+  }
+  return -2;
+}#endif
