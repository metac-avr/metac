diff --git a/mrbgems/mruby-bigint/core/bigint.c b/mrbgems/mruby-bigint/core/bigint.c
index 21d1008e3..98095bbdc 100644
--- a/mrbgems/mruby-bigint/core/bigint.c
+++ b/mrbgems/mruby-bigint/core/bigint.c
@@ -83,6 +82,0 @@ mpz_clear(mrb_state *mrb, mpz_t *s)
-    mrb_free(mrb, s->p);
-  s->p=NULL;
-  s->sn=0;
-  s->sz=0;
-}
-
@@ -93,3 +87,6 @@ digits(mpz_t *x)
-  for (i = (x->sz) - 1; (x->p)[i] == 0 ; i--)
-    if (i == 0) break;
-  return i+1;
+  if (x == NULL || x->sz == 0) return 0;
+  i = x->sz;
+  while (i > 0 && (x->p)[i - 1] == 0) {
+    i--;
+  }
+  return i;
@@ -104 +101,8 @@ mpz_set(mrb_state *mrb, mpz_t *y, mpz_t *x)
-  mpz_realloc(mrb, y, (size_t)k);
+  for (i=0;i < k; i++)
+    (y->p)[i] = (x->p)[i];
+
+  for (;i<y->sz;i++)
+    (y->p)[i] = 0;
+
+  y->sn = x->sn;
+}  mpz_realloc(mrb, y, (size_t)k);
