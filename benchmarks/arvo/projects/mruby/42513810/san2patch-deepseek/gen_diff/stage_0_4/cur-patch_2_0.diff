diff --git a/mrbgems/mruby-bigint/core/bigint.c b/mrbgems/mruby-bigint/core/bigint.c
index dc3022c89..4acd6bb97 100644
--- a/mrbgems/mruby-bigint/core/bigint.c
+++ b/mrbgems/mruby-bigint/core/bigint.c
@@ -187,2 +187,20 @@ ucmp(mpz_t *y, mpz_t *x)
-  if (y->sz < x->sz) return -1;
-  if (y->sz > x->sz) return 1;
+  if (y->sz < x->sz) {
+    size_t n = y->sz;
+    for (size_t i=n; i-- > 0;) {
+      mp_limb a = y->p[i];
+      mp_limb b = x->p[i];
+      if (a > b) return 1;
+      if (a < b) return -1;
+    }
+    return -1;
+  }
+  if (y->sz > x->sz) {
+    size_t n = x->sz;
+    for (size_t i=n; i-- > 0;) {
+      mp_limb a = y->p[i];
+      mp_limb b = x->p[i];
+      if (a > b) return 1;
+      if (a < b) return -1;
+    }
+    return 1;
+  }
