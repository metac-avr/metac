diff --git a/mrbgems/mruby-bigint/core/bigint.c b/mrbgems/mruby-bigint/core/bigint.c
index dc3022c89..9b1cfc1ee 100644
--- a/mrbgems/mruby-bigint/core/bigint.c
+++ b/mrbgems/mruby-bigint/core/bigint.c
@@ -1097,0 +1098,8 @@ mrb_bint_sub(mrb_state *mrb, mrb_value x, mrb_value y)
+  if (mrb_nil_p(x) || mrb_nil_p(y)) {
+    mrb_raise(mrb, E_ARGUMENT_ERROR, "invalid BigInt operand");
+  }
+  struct RBigint *b = RBIGINT(x);
+  struct RBigint *b2 = RBIGINT(y);
+  if (!b || !b2) {
+    mrb_raise(mrb, E_ARGUMENT_ERROR, "invalid BigInt operand");
+  }
@@ -1106,2 +1114,4 @@ mrb_bint_sub(mrb_state *mrb, mrb_value x, mrb_value y)
-  struct RBigint *b = RBIGINT(x);
-  struct RBigint *b2 = RBIGINT(y);
+  b2 = RBIGINT(y);
+  if (!b2) {
+    mrb_raise(mrb, E_ARGUMENT_ERROR, "invalid BigInt operand");
+  }
