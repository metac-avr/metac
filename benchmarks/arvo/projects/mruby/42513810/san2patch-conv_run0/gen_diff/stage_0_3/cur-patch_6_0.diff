diff --git a/mrbgems/mruby-bigint/core/bigint.c b/mrbgems/mruby-bigint/core/bigint.c
index dc3022c89..fe385d8f9 100644
--- a/mrbgems/mruby-bigint/core/bigint.c
+++ b/mrbgems/mruby-bigint/core/bigint.c
@@ -188,0 +189 @@ ucmp(mpz_t *y, mpz_t *x)
+  if (y->sz == 0) return 0;  /* Handle empty arrays */
@@ -189,0 +191 @@ ucmp(mpz_t *y, mpz_t *x)
+    if (i >= y->sz || i >= x->sz) break;  /* Bounds check */
@@ -1109,2 +1111,6 @@ mrb_bint_sub(mrb_state *mrb, mrb_value x, mrb_value y)
-  mpz_sub(mrb, &b3->mp, &b->mp, &b2->mp);
-  return bint_norm(mrb, b3);
+  if (b && b2 && b3) {
+    mpz_sub(mrb, &b3->mp, &b->mp, &b2->mp);
+    return bint_norm(mrb, b3);
+  }
+  mrb_raise(mrb, E_RUNTIME_ERROR, "Invalid big integer operation");
+  return mrb_nil_value();
