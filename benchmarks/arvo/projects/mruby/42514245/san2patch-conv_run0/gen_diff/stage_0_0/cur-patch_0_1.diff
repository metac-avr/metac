+{
+  /* simple cases */
+  int cmp = ucmp(xx, yy);
+  if (cmp == 0) {
+    mpz_set_int(mrb, qq, 1);
+    zero(rr);
+    return;
+  }
+  else if (cmp < 0) {
+    zero(qq);
+    mpz_set(mrb, rr, yy);
+    return;
+  }
+
+  mpz_t q, x, y;
+  size_t i;
+
