--- a/src/vm.c
+++ b/src/vm.c
@@ -334,15 +334,16 @@ mrb_vm_ci_env_clear(mrb_state *mrb, mrb_callinfo *ci)
-static inline mrb_callinfo*
-cipush(mrb_state *mrb, mrb_int push_stacks, uint8_t cci, struct RClass *target_class,
-       const struct RProc *proc, struct RProc *blk, mrb_sym mid, uint16_t argc)
-{
-  struct mrb_context *c = mrb->c;
-  mrb_callinfo *ci = c->ci + 1;
-
-  if (ci < c->ciend) {
-    c->ci = ci;
-  }
-  else {
-    ptrdiff_t size = ci - c->cibase;
-
-    if (size >= MRB_CALL_LEVEL_MAX) {
-      mrb_exc_raise(mrb, mrb_obj_value(mrb->stack_err));
+        if (MRB_PROC_NOARG_P(p) && (ci->n > 0 || ci->nk > 0)) {
+          check_method_noarg(mrb, ci);
+        }
+        recv = MRB_PROC_CFUNC(p)(mrb, recv);
+      }
+    }
+    else {
+      if (MRB_METHOD_NOARG_P(m) && (ci->n > 0 || ci->nk > 0)) {
+        /* Validate callinfo pointer after potential realloc */
+        struct mrb_context *ctx = mrb->c;
+        if (ci < ctx->cibase || ci >= ctx->ciend) {
+          mrb_raise(mrb, E_RUNTIME_ERROR, "invalid callinfo after realloc");
+        }
+        check_method_noarg(mrb, ci);
+      }
+      recv = MRB_METHOD_FUNC(m)(mrb, recv);
@@ -350,12 +350,0 @@ cipush(mrb_state *mrb, mrb_int push_stacks, uint8_t cci, struct RClass *target_c
-    c->cibase = (mrb_callinfo*)mrb_realloc(mrb, c->cibase, sizeof(mrb_callinfo)*size*2);
-    c->ci = ci = c->cibase + size;
-    c->ciend = c->cibase + size * 2;
-  }
-  ci->mid = mid;
-  CI_PROC_SET(ci, proc);
-  ci->blk = blk;
-  ci->stack = ci[-1].stack + push_stacks;
-  ci->n = argc & 0xf;
-  ci->nk = (argc>>4) & 0xf;
-  ci->cci = cci;
-  ci->u.target_class = target_class;
@@ -363,2 +352,8 @@ cipush(mrb_state *mrb, mrb_int push_stacks, uint8_t cci, struct RClass *target_c
-  return ci;
-}
+    /* cfunc epilogue */
+    mrb_gc_arena_shrink(mrb, ai);
+    if (mrb->exc) goto L_RAISE;
+    ci = mrb->c->ci;
+    if (!ci->u.keep_context) { /* return from context modifying method (resume/yield) */
+      if (ci->cci == CINFO_RESUMED) {
+        mrb->jmp = prev_jmp;
+        return recv;
@@ -1951,12 +1946,6 @@ mrb_vm_exec(mrb_state *mrb, const struct RProc *begin_proc, const mrb_code *iseq
-          if (MRB_PROC_NOARG_P(p) && (ci->n > 0 || ci->nk > 0)) {
-            check_method_noarg(mrb, ci);
-          }
-          recv = MRB_PROC_CFUNC(p)(mrb, recv);
-        }
-      }
-      else {
-        if (MRB_METHOD_NOARG_P(m) && (ci->n > 0 || ci->nk > 0)) {
-          check_method_noarg(mrb, ci);
-        }
-        recv = MRB_METHOD_FUNC(m)(mrb, recv);
-      }
+static inline mrb_callinfo*
+cipush(mrb_state *mrb, mrb_int push_stacks, uint8_t cci, struct RClass *target_class,
+       const struct RProc *proc, struct RProc *blk, mrb_sym mid, uint16_t argc)
+{
+  struct mrb_context *c = mrb->c;
+  mrb_callinfo *ci = c->ci + 1;
@@ -1964,9 +1953,29 @@ mrb_vm_exec(mrb_state *mrb, const struct RProc *begin_proc, const mrb_code *iseq
-      /* cfunc epilogue */
-      mrb_gc_arena_shrink(mrb, ai);
-      if (mrb->exc) goto L_RAISE;
-      ci = mrb->c->ci;
-      if (!ci->u.keep_context) { /* return from context modifying method (resume/yield) */
-        if (ci->cci == CINFO_RESUMED) {
-          mrb->jmp = prev_jmp;
-          return recv;
-        }
+  if (ci < c->ciend) {
+    c->ci = ci;
+  }
+  else {
+    ptrdiff_t size = ci - c->cibase;
+
+    if (size >= MRB_CALL_LEVEL_MAX) {
+      mrb_exc_raise(mrb, mrb_obj_value(mrb->stack_err));
+    }
+    mrb_callinfo *old_cibase = c->cibase;
+    c->cibase = (mrb_callinfo*)mrb_realloc(mrb, c->cibase, sizeof(mrb_callinfo)*size*2);
+    if (c->cibase != old_cibase) {
+      ptrdiff_t ci_offset = ci - old_cibase;
+      ci = c->cibase + ci_offset;
+    }
+    c->ci = ci;
+    c->ciend = c->cibase + size * 2;
+  }
+  ci->mid = mid;
+  CI_PROC_SET(ci, proc);
+  ci->blk = blk;
+  ci->stack = ci[-1].stack + push_stacks;
+  ci->n = argc & 0xf;
+  ci->nk = (argc>>4) & 0xf;
+  ci->cci = cci;
+  ci->u.target_class = target_class;
+
+  return ci;
+}        }
