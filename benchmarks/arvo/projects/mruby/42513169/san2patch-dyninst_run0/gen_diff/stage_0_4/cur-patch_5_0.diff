diff --git a/src/numeric.c b/src/numeric.c
index 27a7cb8c3..a65d2da65 100644
--- a/src/numeric.c
+++ b/src/numeric.c
@@ -1802,0 +1803 @@ cmpnum(mrb_state *mrb, mrb_value v1, mrb_value v2)
+  // Prevent expired pointer dereference by checking object validity
@@ -1804,0 +1806,7 @@ cmpnum(mrb_state *mrb, mrb_value v1, mrb_value v2)
+    // Defensive check: validate big integer objects before comparison
+    if (mrb_type(v1) != MRB_TT_BIGINT && mrb_type(v2) != MRB_TT_BIGINT) {
+      // If neither operand is actually a big int, fall through to regular comparison
+    } else if (!mrb_obj_is_valid(v1) || !mrb_obj_is_valid(v2)) {
+      // Check if objects are valid/allocated
+      return -2;
+    }
@@ -1908,0 +1917,6 @@ num_gt(mrb_state *mrb, mrb_value self)
+  /* Validate pointers before dereferencing in cmpnum */
+  if (mrb_type(self) != MRB_TT_BIGINT || mrb_type(other) != MRB_TT_BIGINT) {
+    cmperr(mrb, self, other);
+    return mrb_false_value();
+  }
+  
