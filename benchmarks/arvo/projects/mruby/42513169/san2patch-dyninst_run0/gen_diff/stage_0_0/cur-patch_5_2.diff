diff --git a/mrbgems/mruby-bigint/core/bigint.c b/mrbgems/mruby-bigint/core/bigint.c
index d51efdf6f..efe70346a 100644
--- a/mrbgems/mruby-bigint/core/bigint.c
+++ b/mrbgems/mruby-bigint/core/bigint.c
@@ -1300 +1300,7 @@ mrb_bint_cmp(mrb_state *mrb, mrb_value x, mrb_value y)
-  return mpz_cmp(mrb, &b->mp, &b2->mp);
+  
+  /* Validate big integer data structures before dereferencing */
+  if (b != NULL && b2 != NULL && 
+      b->mp.nalloc > 0 && b2->mp.nalloc > 0) {
+    return mpz_cmp(mrb, &b->mp, &b2->mp);
+  }
+  return -2; /* Invalid or uninitialized big integer objects */
