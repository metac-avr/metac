diff --git a/src/vm.c b/src/vm.c
index d933be05e..7243ccf21 100644
--- a/src/vm.c
+++ b/src/vm.c
@@ -2154,13 +2154,16 @@ mrb_vm_exec(mrb_state *mrb, const struct RProc *proc, const mrb_code *pc)
-        if (!mrb_nil_p(kdict) && mrb_hash_size(mrb, kdict) > 0) {
-          if (argc < 14) {
-            ci->n++;
-            argc++;    /* include kdict in normal arguments */
-          }
-          else if (argc == 14) {
-            /* pack arguments and kdict */
-            regs[1] = ary_new_from_regs(mrb, argc+1, 1);
-            argc = ci->n = 15;
-          }
-          else {/* argc == 15 */
-            /* push kdict to packed arguments */
-            mrb_ary_push(mrb, regs[1], kdict);
+        if (!mrb_nil_p(kdict)) {
+          mrb_value kd_sz = mrb_hash_size(mrb, kdict);
+          if (mrb_fixnum(kd_sz) && mrb_fixnum(kd_sz) > 0) {
+            if (argc < 14) {
+              ci->n++;
+              argc++;    /* include kdict in normal arguments */
+            }
+            else if (argc == 14) {
+              /* pack arguments and kdict */
+              regs[1] = ary_new_from_regs(mrb, argc+1, 1);
+              argc = ci->n = 15;
+            }
+            else {/* argc == 15 */
+              /* push kdict to packed arguments */
+              mrb_ary_push(mrb, regs[1], kdict);
+            }
