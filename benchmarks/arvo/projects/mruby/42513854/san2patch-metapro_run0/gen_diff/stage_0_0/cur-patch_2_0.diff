diff --git a/src/numeric.c b/src/numeric.c
index 239492add..dea0e41c2 100644
--- a/src/numeric.c
+++ b/src/numeric.c
@@ -1889,2 +1889,6 @@ num_cmp(mrb_state *mrb, mrb_value self)
-  n = cmpnum(mrb, self, other);
-  if (n == -2) return mrb_nil_value();
+  if (mrb_immediate_p(self) && mrb_immediate_p(other)) {
+    n = cmpnum(mrb, self, other);
+    if (n == -2) return mrb_nil_value();
+  } else {
+    return mrb_nil_value();
+  }
diff --git a/src/range.c b/src/range.c
