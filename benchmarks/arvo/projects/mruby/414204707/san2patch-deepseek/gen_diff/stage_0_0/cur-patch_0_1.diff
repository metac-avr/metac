diff --git a/src/gc.c b/src/gc.c
index f1b50ad78..d6bf73e66 100644
--- a/src/gc.c
+++ b/src/gc.c
@@ -779 +779,81 @@ gc_mark_children(mrb_state *mrb, mrb_gc *gc, struct RBasic *obj)
-
+static void
+obj_free(mrb_state *mrb, struct RBasic *obj, int end)
+{
+  DEBUG(fprintf(stderr, "obj_free(%p,tt=%d)\n",obj,obj->tt));
+  switch (obj->tt) {
+  case MRB_TT_OBJECT:
+    mrb_gc_free_gv(mrb, (struct RObject*)obj);
+    break;
+  case MRB_TT_EXCEPTION:
+    mrb_gc_free_exc(mrb, (struct RException*)obj);
+    break;
+  case MRB_TT_CLASS:
+    mrb_gc_free_class(mrb, (struct RClass*)obj);
+    break;
+  case MRB_TT_MODULE:
+    mrb_gc_free_module(mrb, (struct RClass*)obj);
+    break;
+  case MRB_TT_ICLASS:
+    /* no destructor */
+    break;
+  case MRB_TT_SCLASS:
+    break;
+  case MRB_TT_ENV:
+    mrb_gc_free_env(mrb, (struct REnv*)obj);
+    break;
+  case MRB_TT_CDATA:
+    mrb_gc_free_cdata(mrb, (struct RCData*)obj);
+    break;
+  case MRB_TT_PROC:
+    mrb_gc_free_proc(mrb, (struct RProc*)obj);
+    break;
+  case MRB_TT_FIBER:
+    {
+      struct RFiber *f = (struct RFiber*)obj;
+      if (!end && f->cxt) {
+        mrb_gc_free_fiber(mrb, f);
+      }
+      else {
+        if (f->cxt) mrb_gc_free_fiber(mrb, f);
+      }
+    }
+    break;
+  case MRB_TT_ARRAY:
+    if (end) {
+      mrb_gc_free_array(mrb, (struct RArray*)obj);
+    }
+    else {
+      mrb_gc_mark_children(mrb, (struct RBasic*)obj);
+    }
+    break;
+  case MRB_TT_HASH:
+    if (end) {
+      mrb_gc_free_hash(mrb, (struct RHash*)obj);
+    }
+    else {
+      mrb_gc_mark_children(mrb, (struct RBasic*)obj);
+    }
+    break;
+  case MRB_TT_STRING:
+    if (end) {
+      mrb_gc_free_str(mrb, (struct RString*)obj);
+    }
+    else {
+      mrb_gc_mark_children(mrb, (struct RBasic*)obj);
+    }
+    break;
+  case MRB_TT_RANGE:
+    if (end) {
+      mrb_gc_free_range(mrb, (struct RRange*)obj);
+    }
+    else {
+      mrb_gc_mark_children(mrb, (struct RBasic*)obj);
+    }
+    break;
+  case MRB_TT_FALSE:
+  case MRB_TT_TRUE:
+  case MRB_TT_FIXNUM:
+  case MRB_TT_SYMBOL:
+  case MRB_TT_UNDEF:
+  case MRB_TT_FREE:
+    break;
@@ -793,8 +873 @@ mrb_gc_mark(mrb_state *mrb, struct RBasic *obj)
-}
