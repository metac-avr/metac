diff --git a/src/numeric.c b/src/numeric.c
index 27a7cb8c3..ae45ce73f 100644
--- a/src/numeric.c
+++ b/src/numeric.c
@@ -1793 +1793,11 @@ int_to_s(mrb_state *mrb, mrb_value self)
-    return mrb_bint_to_s(mrb, self, base);
+    mrb_value result = mrb_bint_to_s(mrb, self, base);
+    /* Ensure null termination and bounds checking */
+    if (mrb_string_p(result)) {
+      mrb_int len = RSTRING_LEN(result);
+      char* str = RSTRING_PTR(result);
+      if (len > 0 && str[len] != '\0') {
+        /* Force null termination if missing */
+        mrb_str_cat_lit(mrb, result, "\0");
+      }
+    }
+    return result;
