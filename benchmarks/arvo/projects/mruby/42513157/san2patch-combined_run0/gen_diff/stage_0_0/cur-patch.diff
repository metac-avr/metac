diff --git a/mrbgems/mruby-bigint/core/bigint.c b/mrbgems/mruby-bigint/core/bigint.c
index d51efdf6f..53e7b6424 100644
--- a/mrbgems/mruby-bigint/core/bigint.c
+++ b/mrbgems/mruby-bigint/core/bigint.c
@@ -500,4 +500,16 @@ udiv(mrb_state *mrb, mpz_t *qq, mpz_t *rr, mpz_t *xx, mpz_t *yy)
-    if (j%2)
-      q.p[j/2] |= qhat << HALFDIGITBITS;
-    else
-      q.p[j/2] |= qhat;
+    if (j%2) {
+      // Prevent integer overflow by checking bounds
+      mpz_uint addend = qhat << HALFDIGITBITS;
+      if (addend <= (MPZ_UINT_MAX - q.p[j/2])) {
+        q.p[j/2] |= addend;
+      } else {
+        q.p[j/2] = MPZ_UINT_MAX; // Set to maximum on overflow
+      }
+    } else {
+      // Prevent integer overflow by checking bounds
+      if (qhat <= (MPZ_UINT_MAX - q.p[j/2])) {
+        q.p[j/2] |= qhat;
+      } else {
+        q.p[j/2] = MPZ_UINT_MAX; // Set to maximum on overflow
+      }
+    }
