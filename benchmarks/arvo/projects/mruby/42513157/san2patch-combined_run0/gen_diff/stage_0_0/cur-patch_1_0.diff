+    if (j%2) {
+      // Use safe arithmetic to prevent overflow
+      mpz_uint new_val = q.p[j/2];
+      if (!__builtin_add_overflow(new_val, (qhat << HALFDIGITBITS), &new_val)) {
+        q.p[j/2] = new_val;
+      } else {
+        q.p[j/2] = MPZ_UINT_MAX; // Clamp to max value on overflow
+      }
+    } else {
+      // Use safe arithmetic to prevent overflow
+      mpz_uint new_val = q.p[j/2];
+      if (!__builtin_add_overflow(new_val, qhat, &new_val)) {
+        q.p[j/2] = new_val;
+      } else {
+        q.p[j/2] = MPZ_UINT_MAX; // Clamp to max value on overflow
+      }
+    }
