diff --git a/mrbgems/mruby-bigint/core/bigint.c b/mrbgems/mruby-bigint/core/bigint.c
index d51efdf6f..1ee717d80 100644
--- a/mrbgems/mruby-bigint/core/bigint.c
+++ b/mrbgems/mruby-bigint/core/bigint.c
@@ -500,4 +500,17 @@ udiv(mrb_state *mrb, mpz_t *qq, mpz_t *rr, mpz_t *xx, mpz_t *yy)
-    if (j%2)
-      q.p[j/2] |= qhat << HALFDIGITBITS;
-    else
-      q.p[j/2] |= qhat;
+    if (j%2) {
+      // Check for potential overflow before assignment
+      if (q.p[j/2] > (MPZ_UINT_MAX - (qhat << HALFDIGITBITS))) {
+        // Handle overflow condition appropriately
+        q.p[j/2] = MPZ_UINT_MAX;
+      } else {
+        q.p[j/2] |= qhat << HALFDIGITBITS;
+      }
+    } else {
+      // Check for potential overflow before assignment
+      if (q.p[j/2] > (MPZ_UINT_MAX - qhat)) {
+        // Handle overflow condition appropriately
+        q.p[j/2] = MPZ_UINT_MAX;
+      } else {
+        q.p[j/2] |= qhat;
+      }
+    }
