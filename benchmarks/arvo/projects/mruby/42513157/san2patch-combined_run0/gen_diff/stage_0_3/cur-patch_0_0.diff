diff --git a/mrbgems/mruby-bigint/core/bigint.c b/mrbgems/mruby-bigint/core/bigint.c
index d51efdf6f..833c92886 100644
--- a/mrbgems/mruby-bigint/core/bigint.c
+++ b/mrbgems/mruby-bigint/core/bigint.c
@@ -500,4 +500,17 @@ udiv(mrb_state *mrb, mpz_t *qq, mpz_t *rr, mpz_t *xx, mpz_t *yy)
-    if (j%2)
-      q.p[j/2] |= qhat << HALFDIGITBITS;
-    else
-      q.p[j/2] |= qhat;
+    if (j%2) {
+// FIXME: Crash CWE-190: Integer Overflow or Wraparound
+      /* Cast to larger type to prevent overflow, then check bounds */
+      uint64_t temp = (uint64_t)q.p[j/2] + (uint64_t)(qhat << HALFDIGITBITS);
+      if (temp <= UINT32_MAX) {
+        q.p[j/2] = (uint32_t)temp;
+      } else {
+        q.p[j/2] = UINT32_MAX; /* or handle overflow appropriately */
+      }
+    } else {
+      uint64_t temp = (uint64_t)q.p[j/2] + (uint64_t)qhat;
+      if (temp <= UINT32_MAX) {
+        q.p[j/2] = (uint32_t)temp;
+      } else {
+        q.p[j/2] = UINT32_MAX; /* or handle overflow appropriately */
+      }
+    }
