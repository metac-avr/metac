diff --git a/mrbgems/mruby-bigint/core/bigint.c b/mrbgems/mruby-bigint/core/bigint.c
index d51efdf6f..7a7bb0781 100644
--- a/mrbgems/mruby-bigint/core/bigint.c
+++ b/mrbgems/mruby-bigint/core/bigint.c
@@ -500,4 +500,15 @@ udiv(mrb_state *mrb, mpz_t *qq, mpz_t *rr, mpz_t *xx, mpz_t *yy)
-    if (j%2)
-      q.p[j/2] |= qhat << HALFDIGITBITS;
-    else
-      q.p[j/2] |= qhat;
+    if (j%2) {
+// FIXME: Crash CWE-190: Integer Overflow or Wraparound
+      /* Use saturated arithmetic to prevent overflow */
+      if (q.p[j/2] > UINT32_MAX - (qhat << HALFDIGITBITS)) {
+        q.p[j/2] = UINT32_MAX; /* Saturate on overflow */
+      } else {
+        q.p[j/2] |= qhat << HALFDIGITBITS;
+      }
+    } else {
+      if (q.p[j/2] > UINT32_MAX - qhat) {
+        q.p[j/2] = UINT32_MAX; /* Saturate on overflow */
+      } else {
+        q.p[j/2] |= qhat;
+      }
+    }
