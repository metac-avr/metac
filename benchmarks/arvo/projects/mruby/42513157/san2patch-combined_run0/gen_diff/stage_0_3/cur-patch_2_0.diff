+    if (j%2) {
+// FIXME: Crash CWE-190: Integer Overflow or Wraparound
+      /* Check for potential overflow before performing operation */
+      if (__builtin_add_overflow(q.p[j/2], qhat << HALFDIGITBITS, &q.p[j/2])) {
+        /* Handle overflow - set to maximum value or return error */
+        q.p[j/2] = UINT32_MAX;
+      }
+    } else {
+      if (__builtin_add_overflow(q.p[j/2], qhat, &q.p[j/2])) {
