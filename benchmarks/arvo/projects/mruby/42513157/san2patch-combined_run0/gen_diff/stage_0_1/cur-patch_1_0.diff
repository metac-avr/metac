diff --git a/mrbgems/mruby-bigint/core/bigint.c b/mrbgems/mruby-bigint/core/bigint.c
index d51efdf6f..40b714b89 100644
--- a/mrbgems/mruby-bigint/core/bigint.c
+++ b/mrbgems/mruby-bigint/core/bigint.c
@@ -500,4 +500,22 @@ udiv(mrb_state *mrb, mpz_t *qq, mpz_t *rr, mpz_t *xx, mpz_t *yy)
-    if (j%2)
-      q.p[j/2] |= qhat << HALFDIGITBITS;
-    else
-      q.p[j/2] |= qhat;
+    if (j%2) {
+      // Use wider integer type to prevent overflow
+      uint64_t temp_q = (uint64_t)q.p[j/2];
+      uint64_t temp_qhat = (uint64_t)qhat;
+      uint64_t result = temp_q | (temp_qhat << HALFDIGITBITS);
+      
+      // Check if result fits within target type
+      if (result <= MPZ_DIGITMAX) {
+        q.p[j/2] = (mpz_digit_t)result;
+      } else {
+        // Handle overflow by masking to fit within bounds
+        q.p[j/2] |= (qhat & ((MPZ_DIGITMAX >> HALFDIGITBITS))) << HALFDIGITBITS;
+      }
+    } else {
+      // Check for addition overflow
+      if (qhat <= (MPZ_DIGITMAX - q.p[j/2])) {
+        q.p[j/2] |= qhat;
+      } else {
+        // Handle overflow by limiting result
+        q.p[j/2] = MPZ_DIGITMAX;
+      }
+    }
