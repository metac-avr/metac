diff --git a/mrbgems/mruby-bigint/core/bigint.c b/mrbgems/mruby-bigint/core/bigint.c
index d51efdf6f..16fca8a93 100644
--- a/mrbgems/mruby-bigint/core/bigint.c
+++ b/mrbgems/mruby-bigint/core/bigint.c
@@ -500,4 +500,17 @@ udiv(mrb_state *mrb, mpz_t *qq, mpz_t *rr, mpz_t *xx, mpz_t *yy)
-    if (j%2)
-      q.p[j/2] |= qhat << HALFDIGITBITS;
-    else
-      q.p[j/2] |= qhat;
+    if (j%2) {
+      // Check for potential overflow before shifting and OR operation
+      if (q.p[j/2] > (MPZ_DIGITMAX >> HALFDIGITBITS) || qhat > (MPZ_DIGITMAX >> HALFDIGITBITS)) {
+        // Handle overflow case - prevent wraparound
+        q.p[j/2] |= (qhat & ((MPZ_DIGITMAX >> HALFDIGITBITS))) << HALFDIGITBITS;
+      } else {
+        q.p[j/2] |= qhat << HALFDIGITBITS;
+      }
+    } else {
+      // Check for potential overflow in direct assignment
+      if (q.p[j/2] <= (MPZ_DIGITMAX - qhat)) {
+        q.p[j/2] |= qhat;
+      } else {
+        // Handle overflow by limiting to maximum value
+        q.p[j/2] |= (qhat & (MPZ_DIGITMAX - q.p[j/2]));
+      }
+    }
