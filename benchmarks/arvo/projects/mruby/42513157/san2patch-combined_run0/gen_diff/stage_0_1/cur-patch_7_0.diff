diff --git a/mrbgems/mruby-bigint/core/bigint.c b/mrbgems/mruby-bigint/core/bigint.c
index d51efdf6f..4969b1b4b 100644
--- a/mrbgems/mruby-bigint/core/bigint.c
+++ b/mrbgems/mruby-bigint/core/bigint.c
@@ -521 +521,9 @@ mpz_mdiv(mrb_state *mrb, mpz_t *q, mpz_t *x, mpz_t *y)
-  udiv(mrb,q,&r,x,y);
+  
+  /* Validate inputs to prevent integer overflow in udiv */
+  if (x != NULL && y != NULL && x->sn != 0 && y->sn != 0) {
+    udiv(mrb,q,&r,x,y);
+  } else {
+    /* Initialize q to zero if inputs are invalid */
+    mpz_set_int(mrb, q, 0);
+  }
+  
