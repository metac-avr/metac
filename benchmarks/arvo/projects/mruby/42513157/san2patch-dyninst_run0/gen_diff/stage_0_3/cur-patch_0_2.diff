diff --git a/src/numeric.c b/src/numeric.c
index 27a7cb8c3..ba5f3fb9f 100644
--- a/src/numeric.c
+++ b/src/numeric.c
@@ -162 +162,2 @@ int_div(mrb_state *mrb, mrb_value x)
-#ifdef MRB_USE_BIGINT
+// FIXME: Crash CWE-190: Integer Overflow or Wraparound
+ #ifdef MRB_USE_BIGINT
@@ -164 +165,10 @@ int_div(mrb_state *mrb, mrb_value x)
-    return mrb_bint_div(mrb, mrb_bint_new_int(mrb, a), y);
+    {
+      mrb_value tmp = mrb_bint_new_int(mrb, a);
+      if (mrb_bigint_p(tmp) && mrb_bigint_p(y)) {
+        /* Check for potential overflow in division */
+        if (mrb_bint_cmp(mrb, y, mrb_fixnum_value(0)) == 0) {
+          mrb_raise(mrb, E_ZERO_DIV_ERROR, "divided by 0");
+        }
+      }
+      return mrb_bint_div(mrb, tmp, y);
+    }
