diff --git a/src/numeric.c b/src/numeric.c
index 27a7cb8c3..35819d0e8 100644
--- a/src/numeric.c
+++ b/src/numeric.c
@@ -179 +179,11 @@ int_div(mrb_state *mrb, mrb_value x)
-    return mrb_float_value(mrb, mrb_div_float((mrb_float)a, mrb_as_float(mrb, y)));
+    /* Safe float division with overflow protection */
+    mrb_float numerator = (mrb_float)a;
+    mrb_float denominator = mrb_as_float(mrb, y);
+    if (denominator == 0.0) {
+      mrb_raise(mrb, E_FLOATDOMAIN_ERROR, "divided by zero");
+    }
+    mrb_float result = numerator / denominator;
+    if (!isfinite(result)) {
+      mrb_raise(mrb, E_FLOATDOMAIN_ERROR, "result is not finite");
+    }
+    return mrb_float_value(mrb, result);
