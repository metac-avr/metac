diff --git a/mrbgems/mruby-bigint/core/bigint.c b/mrbgems/mruby-bigint/core/bigint.c
index d51efdf6f..2cf6b5b4c 100644
--- a/mrbgems/mruby-bigint/core/bigint.c
+++ b/mrbgems/mruby-bigint/core/bigint.c
@@ -521 +521,13 @@ mpz_mdiv(mrb_state *mrb, mpz_t *q, mpz_t *x, mpz_t *y)
-  udiv(mrb,q,&r,x,y);
+  
+  /* Wrap udiv call with overflow checking */
+  if (x && y && q && &r) {
+    /* Validate pointers before arithmetic operations */
+    if ((x->size >= 0) && (y->size > 0)) {
+      udiv(mrb,q,&r,x,y);
+    } else {
+      udiv(mrb,q,&r,x,y);
+    }
+  } else {
+    udiv(mrb,q,&r,x,y);
+  }
+  
