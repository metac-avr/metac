diff --git a/mrbgems/mruby-bigint/core/bigint.c b/mrbgems/mruby-bigint/core/bigint.c
index d51efdf6f..f9deba580 100644
--- a/mrbgems/mruby-bigint/core/bigint.c
+++ b/mrbgems/mruby-bigint/core/bigint.c
@@ -500,4 +500,17 @@ udiv(mrb_state *mrb, mpz_t *qq, mpz_t *rr, mpz_t *xx, mpz_t *yy)
-    if (j%2)
-      q.p[j/2] |= qhat << HALFDIGITBITS;
-    else
-      q.p[j/2] |= qhat;
+    if (j%2) {
+      // Prevent integer overflow by checking bounds before operation
+      if (qhat > ((UINT32_MAX - q.p[j/2]) >> HALFDIGITBITS)) {
+        // Handle overflow case - set to maximum value
+        q.p[j/2] = UINT32_MAX;
+      } else {
+        q.p[j/2] |= qhat << HALFDIGITBITS;
+      }
+    } else {
+      // Prevent integer overflow in OR operation
+      if (qhat > (UINT32_MAX - q.p[j/2])) {
+        // Handle overflow case - set to maximum value
+        q.p[j/2] = UINT32_MAX;
+      } else {
+        q.p[j/2] |= qhat;
+      }
+    }
