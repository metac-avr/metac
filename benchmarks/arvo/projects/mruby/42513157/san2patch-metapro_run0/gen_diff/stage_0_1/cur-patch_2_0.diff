diff --git a/mrbgems/mruby-bigint/core/bigint.c b/mrbgems/mruby-bigint/core/bigint.c
index d51efdf6f..73e80a816 100644
--- a/mrbgems/mruby-bigint/core/bigint.c
+++ b/mrbgems/mruby-bigint/core/bigint.c
@@ -500,3 +500,15 @@ udiv(mrb_state *mrb, mpz_t *qq, mpz_t *rr, mpz_t *xx, mpz_t *yy)
-    if (j%2)
-      q.p[j/2] |= qhat << HALFDIGITBITS;
-    else
+    if (j%2) {
+      // Safe integer operation with overflow detection
+      uint32_t shifted_qhat = qhat << HALFDIGITBITS;
+      if (shifted_qhat < qhat) {  // Overflow check for left shift
+        mrb_raise(mrb, E_RANGE_ERROR, "shift overflow in udiv");
+      }
+      if (q.p[j/2] > UINT32_MAX - shifted_qhat) {  // Overflow check for OR
+        mrb_raise(mrb, E_RANGE_ERROR, "arithmetic overflow in udiv");
+      }
+      q.p[j/2] |= shifted_qhat;
+    } else {
+      // Safe integer operation for direct OR
+      if (q.p[j/2] > UINT32_MAX - qhat) {  // Overflow check
+        mrb_raise(mrb, E_RANGE_ERROR, "arithmetic overflow in udiv");
+      }
@@ -503,0 +516 @@ udiv(mrb_state *mrb, mpz_t *qq, mpz_t *rr, mpz_t *xx, mpz_t *yy)
+    }
