diff --git a/mrbgems/mruby-bigint/core/bigint.c b/mrbgems/mruby-bigint/core/bigint.c
index d51efdf6f..00075e113 100644
--- a/mrbgems/mruby-bigint/core/bigint.c
+++ b/mrbgems/mruby-bigint/core/bigint.c
@@ -500,4 +500,16 @@ udiv(mrb_state *mrb, mpz_t *qq, mpz_t *rr, mpz_t *xx, mpz_t *yy)
-    if (j%2)
-      q.p[j/2] |= qhat << HALFDIGITBITS;
-    else
-      q.p[j/2] |= qhat;
+    if (j%2) {
+      // Prevent integer overflow by checking bounds before operation
+      if (qhat <= (UINT32_MAX >> HALFDIGITBITS) && 
+          q.p[j/2] <= (UINT32_MAX - (qhat << HALFDIGITBITS))) {
+        q.p[j/2] |= qhat << HALFDIGITBITS;
+      } else {
+        mrb_raise(mrb, E_RANGE_ERROR, "arithmetic overflow in bigint operation");
+      }
+    } else {
+      // Prevent integer overflow in direct assignment
+      if (qhat <= (UINT32_MAX - q.p[j/2])) {
+        q.p[j/2] |= qhat;
+      } else {
+        mrb_raise(mrb, E_RANGE_ERROR, "arithmetic overflow in bigint operation");
+      }
+    }
