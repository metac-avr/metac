diff --git a/mrbgems/mruby-bigint/core/bigint.c b/mrbgems/mruby-bigint/core/bigint.c
index d51efdf6f..17e9065a0 100644
--- a/mrbgems/mruby-bigint/core/bigint.c
+++ b/mrbgems/mruby-bigint/core/bigint.c
@@ -519,0 +520,10 @@ mpz_mdiv(mrb_state *mrb, mpz_t *q, mpz_t *x, mpz_t *y)
+  
+  // Add overflow protection for sign calculation
+  if ((sn1 > 0 && sn2 > 0) || (sn1 < 0 && sn2 < 0)) {
+    qsign = 1;  // Positive result
+  } else if (sn1 == 0 || sn2 == 0) {
+    qsign = 0;  // Zero result
+  } else {
+    qsign = -1; // Negative result
+  }
+  
@@ -522 +532,3 @@ mpz_mdiv(mrb_state *mrb, mpz_t *q, mpz_t *x, mpz_t *y)
-  qsign = q->sn = sn1*sn2;
+  
+  // Apply sign after division to avoid intermediate overflow
+  q->sn = qsign;
