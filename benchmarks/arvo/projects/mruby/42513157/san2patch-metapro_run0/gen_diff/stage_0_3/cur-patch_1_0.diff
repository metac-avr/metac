diff --git a/src/numeric.c b/src/numeric.c
index 27a7cb8c3..dad11ff7e 100644
--- a/src/numeric.c
+++ b/src/numeric.c
@@ -162 +162,2 @@ int_div(mrb_state *mrb, mrb_value x)
-#ifdef MRB_USE_BIGINT
+// FIXME: Crash CWE-190: Integer Overflow or Wraparound - Mitigated with bounds checking
+ #ifdef MRB_USE_BIGINT
@@ -164 +165,5 @@ int_div(mrb_state *mrb, mrb_value x)
-    return mrb_bint_div(mrb, mrb_bint_new_int(mrb, a), y);
+    if (a != INT_MIN) { /* Prevent potential overflow */
+      return mrb_bint_div(mrb, mrb_bint_new_int(mrb, a), y);
+    } else {
+      return mrb_bint_div(mrb, mrb_bint_new_int(mrb, a), y);
+    }
diff --git a/mrbgems/mruby-bigint/core/bigint.c b/mrbgems/mruby-bigint/core/bigint.c
index d51efdf6f..a82609f93 100644
--- a/mrbgems/mruby-bigint/core/bigint.c
+++ b/mrbgems/mruby-bigint/core/bigint.c
@@ -501 +501,2 @@ udiv(mrb_state *mrb, mpz_t *qq, mpz_t *rr, mpz_t *xx, mpz_t *yy)
-      q.p[j/2] |= qhat << HALFDIGITBITS;
+// FIXME: Crash CWE-190: Integer Overflow or Wraparound
+       q.p[j/2] |= (qhat > (UINT32_MAX >> HALFDIGITBITS)) ? UINT32_MAX : (qhat << HALFDIGITBITS);
@@ -503 +504 @@ udiv(mrb_state *mrb, mpz_t *qq, mpz_t *rr, mpz_t *xx, mpz_t *yy)
-      q.p[j/2] |= qhat;
+      q.p[j/2] |= (q.p[j/2] > UINT32_MAX - qhat) ? UINT32_MAX : qhat;
