diff --git a/src/numeric.c b/src/numeric.c
index 27a7cb8c3..9b9496b85 100644
--- a/src/numeric.c
+++ b/src/numeric.c
@@ -162 +162,2 @@ int_div(mrb_state *mrb, mrb_value x)
-#ifdef MRB_USE_BIGINT
+// FIXME: Crash CWE-190: Integer Overflow or Wraparound - Fixed by adding overflow check
+ #ifdef MRB_USE_BIGINT
@@ -164 +165,5 @@ int_div(mrb_state *mrb, mrb_value x)
-    return mrb_bint_div(mrb, mrb_bint_new_int(mrb, a), y);
+    if (a > 0) {
+      return mrb_bint_div(mrb, mrb_bint_new_int(mrb, a), y);
+    } else {
+      mrb_raise(mrb, E_RANGE_ERROR, "integer overflow in division");
+    }
diff --git a/mrbgems/mruby-bigint/core/bigint.c b/mrbgems/mruby-bigint/core/bigint.c
index d51efdf6f..5947a96ba 100644
--- a/mrbgems/mruby-bigint/core/bigint.c
+++ b/mrbgems/mruby-bigint/core/bigint.c
@@ -500,4 +500,17 @@ udiv(mrb_state *mrb, mpz_t *qq, mpz_t *rr, mpz_t *xx, mpz_t *yy)
-    if (j%2)
-      q.p[j/2] |= qhat << HALFDIGITBITS;
-    else
-      q.p[j/2] |= qhat;
+    if (j%2) {
+      // Check for potential overflow before shift operation
+      if (qhat > (UINT32_MAX >> HALFDIGITBITS)) {
+        // Handle overflow case - saturate to maximum value
+        q.p[j/2] |= UINT32_MAX;
+      } else {
+        q.p[j/2] |= qhat << HALFDIGITBITS;
+      }
+    } else {
+      // Check for potential overflow in direct assignment
+      if (q.p[j/2] > UINT32_MAX - qhat) {
+        // Handle overflow case - saturate to maximum value
+        q.p[j/2] = UINT32_MAX;
+      } else {
+        q.p[j/2] |= qhat;
+      }
+    }
