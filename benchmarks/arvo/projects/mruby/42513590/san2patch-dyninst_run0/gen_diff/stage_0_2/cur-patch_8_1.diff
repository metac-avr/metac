diff --git a/mrbgems/mruby-bigint/core/bigint.c b/mrbgems/mruby-bigint/core/bigint.c
index 21d1008e3..e847ca619 100644
--- a/mrbgems/mruby-bigint/core/bigint.c
+++ b/mrbgems/mruby-bigint/core/bigint.c
@@ -860,0 +861,4 @@ mpz_xor(mrb_state *mrb, mpz_t *z, mpz_t *x, mpz_t *y)  /* not the most efficient
+  /* Input validation */
+  if (!x || !y || !z) return;
+  /* Prevent integer overflow in size calculation */
+  if (x->sz > SIZE_MAX/2 || y->sz > SIZE_MAX/2) return;
@@ -862,3 +866,11 @@ mpz_xor(mrb_state *mrb, mpz_t *z, mpz_t *x, mpz_t *y)  /* not the most efficient
-  mpz_realloc(mrb,z,(size_t)sz);
-  for (i=0; i < sz; i++)
-    (z->p)[i] = dg(x,i) ^ dg(y,i);
+  /* Ensure sz is valid */
+  if (sz > 0) {
+    mpz_realloc(mrb,z,(size_t)sz);
+    /* Safe iteration with bounds checking */
+    for (i=0; i < sz && (i < x->sz || i < y->sz); i++) {
+      mpfr_uint dx = (i < x->sz && x->p) ? x->p[i] : 0;
+      mpfr_uint dy = (i < y->sz && y->p) ? y->p[i] : 0;
+      if (i < z->sz) /* Additional bounds check for z */
+        (z->p)[i] = dx ^ dy;
+    }
+  }
@@ -1425 +1437,3 @@ mrb_bint_xor(mrb_state *mrb, mrb_value x, mrb_value y)
-    mpz_xor(mrb, &b3->mp, &b1->mp, &z);
+    if (b1->mp.size > 0 && b1->mp.data != NULL) {
+      mpz_xor(mrb, &b3->mp, &b1->mp, &z);
+    }
@@ -1432 +1446,3 @@ mrb_bint_xor(mrb_state *mrb, mrb_value x, mrb_value y)
-  mpz_xor(mrb, &b3->mp, &b1->mp, &b2->mp);
+  if (b1->mp.size > 0 && b2->mp.size > 0 && b1->mp.data != NULL && b2->mp.data != NULL) {
+    mpz_xor(mrb, &b3->mp, &b1->mp, &b2->mp);
+  }
