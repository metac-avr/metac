diff --git a/mrbgems/mruby-bigint/core/bigint.c b/mrbgems/mruby-bigint/core/bigint.c
index 21d1008e3..629fd2bc1 100644
--- a/mrbgems/mruby-bigint/core/bigint.c
+++ b/mrbgems/mruby-bigint/core/bigint.c
@@ -860,0 +861 @@ mpz_xor(mrb_state *mrb, mpz_t *z, mpz_t *x, mpz_t *y)  /* not the most efficient
+  if (!x || !y || !z) return; /* Add null pointer check */
@@ -861,0 +863,5 @@ mpz_xor(mrb_state *mrb, mpz_t *z, mpz_t *x, mpz_t *y)  /* not the most efficient
+  if (sz == 0) { /* Add bounds check for zero size */
+    z->sz = 0;
+    z->sn = 0;
+    return;
+  }
@@ -863 +869 @@ mpz_xor(mrb_state *mrb, mpz_t *z, mpz_t *x, mpz_t *y)  /* not the most efficient
-  for (i=0; i < sz; i++)
+  for (i=0; i < sz && i < x->sz && i < y->sz; i++) /* Add bounds checking in loop */
@@ -864,0 +871,6 @@ mpz_xor(mrb_state *mrb, mpz_t *z, mpz_t *x, mpz_t *y)  /* not the most efficient
+  /* Handle remaining digits if sizes differ */
+  for (; i < sz; i++) {
+    mpfr_uint dx = (i < x->sz) ? dg(x,i) : 0;
+    mpfr_uint dy = (i < y->sz) ? dg(y,i) : 0;
+    (z->p)[i] = dx ^ dy;
+  }
@@ -1425 +1437,4 @@ mrb_bint_xor(mrb_state *mrb, mrb_value x, mrb_value y)
-    mpz_xor(mrb, &b3->mp, &b1->mp, &z);
+    
+    if (b1->mp.size > 0) {
+      mpz_xor(mrb, &b3->mp, &b1->mp, &z);
+    }
@@ -1432 +1447,4 @@ mrb_bint_xor(mrb_state *mrb, mrb_value x, mrb_value y)
-  mpz_xor(mrb, &b3->mp, &b1->mp, &b2->mp);
+  
+  if (b1->mp.size > 0 && b2->mp.size > 0) {
+    mpz_xor(mrb, &b3->mp, &b1->mp, &b2->mp);
+  }
