@@ -524,0 +525,3 @@ unpack_float(mrb_state *mrb, const unsigned char * src, int srclen, mrb_value ar
+  // Check bounds before accessing memory to prevent buffer overflow
+  if (srclen < 4) return 0;
+
@@ -1560 +1563,2 @@ pack_unpack(mrb_state *mrb, mrb_value str, int single)
