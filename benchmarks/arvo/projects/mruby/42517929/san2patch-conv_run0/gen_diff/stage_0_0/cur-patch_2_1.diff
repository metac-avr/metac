diff --git a/mrbgems/mruby-pack/src/pack.c b/mrbgems/mruby-pack/src/pack.c
index 08c22b5eb..e04abfdbb 100644
--- a/mrbgems/mruby-pack/src/pack.c
+++ b/mrbgems/mruby-pack/src/pack.c
@@ -1543,0 +1544,44 @@ pack_unpack(mrb_state *mrb, mrb_value str, int single)
+      static mrb_value
+pack_unpack(mrb_state *mrb, mrb_value str, int single)
+{
+  mrb_int srclen;
+  const char *sptr;
+  mrb_int srcidx;
+  struct tmpl tmpl;
+  mrb_value result;
+  mrb_int result_len;
+  int dir, flags;
+
+  sptr = mrb_string_value(mrb, &str, &srclen);
+  srcidx = 0;
+  init_tmpl(&tmpl);
+  result = mrb_ary_new(mrb);
+  result_len = 0;
+
+  while (has_tmpl(&tmpl)) {
+    dir = next_tmpl(&tmpl, &flags);
+    if (dir == PACK_DIR_NONE)
+      continue;
+    if (dir == PACK_DIR_REPEAT) {
+      if (tmpl.idx == 0) {
+        if (flags & PACK_FLAG_STAR) {
+          tmpl.repeat = srclen - srcidx;
+        }
+        else if (flags & PACK_FLAG_LSB) {
+          tmpl.repeat = (srclen - srcidx) * 8;
+        }
+        else {
+          tmpl.repeat = (srclen - srcidx) / 8;
+        }
+      }
+      continue;
+    }
+    if ((flags & PACK_FLAG_COUNTMASK) == 0) {
+      flags |= 1;
+    }
+
+    do {
+      if (single && RARRAY_LEN(result) > 0) {
+        return mrb_ary_entry(result, 0);
+      }
+
@@ -1562 +1606,4 @@ pack_unpack(mrb_state *mrb, mrb_value str, int single)
-        srcidx += unpack_float(mrb, sptr, srclen - srcidx, result, flags);
+        if (srclen - srcidx >= 4)
+          srcidx += unpack_float(mrb, sptr, srclen - srcidx, result, flags);
+        else
+          return mrb_nil_value();
@@ -1565 +1612,4 @@ pack_unpack(mrb_state *mrb, mrb_value str, int single)
-        srcidx += unpack_double(mrb, sptr, srclen - srcidx, result, flags);
+        if (srclen - srcidx >= 8)
+          srcidx += unpack_double(mrb, sptr, srclen - srcidx, result, flags);
+        else
+          return mrb_nil_value();
@@ -1573,0 +1624,4 @@ pack_unpack(mrb_state *mrb, mrb_value str, int single)
+    } while (0);
+  }
+  return result;
+}
@@ -1581,7 +1634,0 @@ pack_unpack(mrb_state *mrb, mrb_value str, int single)
-      }
-      return mrb_nil_value();
-    }
-  }
-  return result;
-}
-
@@ -1592,11 +1639 @@ mrb_pack_unpack(mrb_state *mrb, mrb_value str)
-}
-
-static mrb_value
-mrb_pack_unpack1(mrb_state *mrb, mrb_value str)
-{
-  return pack_unpack(mrb, str, 1);
-}
-
-void
-mrb_mruby_pack_gem_init(mrb_state *mrb)
-{
+}{
