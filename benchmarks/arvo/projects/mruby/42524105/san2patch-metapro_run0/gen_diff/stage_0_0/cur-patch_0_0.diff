diff --git a/src/string.c b/src/string.c
index df83f2c05..c4142dfe3 100644
--- a/src/string.c
+++ b/src/string.c
@@ -1683 +1683,2 @@ mrb_byte_hash_step(const uint8_t *s, mrb_int len, uint32_t hval)
-
+// FIXME: Crash CWE-416: Use After Free
+ 
