diff --git a/src/string.c b/src/string.c
index df83f2c05..8987ea982 100644
--- a/src/string.c
+++ b/src/string.c
@@ -212,4 +212,10 @@ str_decref(mrb_state *mrb, mrb_shared_string *shared)
-  shared->refcnt--;
-  if (shared->refcnt == 0) {
-    mrb_free(mrb, shared->ptr);
-    mrb_free(mrb, shared);
+  if (shared && shared->refcnt > 0) {
+    shared->refcnt--;
+    if (shared->refcnt == 0) {
+      if (shared->ptr) {
+        mrb_free(mrb, shared->ptr);
+      }
+      if (shared) {
+        mrb_free(mrb, shared);
+      }
+    }
@@ -224 +229,0 @@ str_modify_keep_ascii(mrb_state *mrb, struct RString *s)
-
diff --git a/src/gc.c b/src/gc.c
index 823297612..1e58a30a0 100644
--- a/src/gc.c
+++ b/src/gc.c
@@ -816 +816 @@ obj_free(mrb_state *mrb, struct RBasic *obj, int end)
-    else if (!ARY_EMBED_P(obj))
+else if (!ARY_EMBED_P(obj))
@@ -824 +824,2 @@ obj_free(mrb_state *mrb, struct RBasic *obj, int end)
-
+// FIXME: Crash CWE-416: Use After Free
+ 
@@ -826 +827,10 @@ obj_free(mrb_state *mrb, struct RBasic *obj, int end)
-    mrb_gc_free_str(mrb, (struct RString*)obj);
+    // Defer string freeing to prevent immediate deallocation during hash computations
+    {
+      struct RString *str = (struct RString*)obj;
+      if (str->flags & MRB_STR_HASH_ON) {
+        // Hash operation in progress, mark for deferred freeing
+        str->flags |= MRB_STR_DEFER_FREE;
+      } else {
+        mrb_gc_free_str(mrb, str);
+      }
+    }
