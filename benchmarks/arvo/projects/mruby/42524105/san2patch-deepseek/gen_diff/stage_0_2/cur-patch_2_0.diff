diff --git a/src/string.c b/src/string.c
index df83f2c05..9e71df7c9 100644
--- a/src/string.c
+++ b/src/string.c
@@ -1692,6 +1691,0 @@ mrb_byte_hash_step(const uint8_t *s, mrb_int len, uint32_t hval)
-uint32_t
-mrb_byte_hash(const uint8_t *s, mrb_int len)
-{
-  return mrb_byte_hash_step(s, len, FNV1_32_INIT);
-}
-
@@ -1700,14 +1694,9 @@ mrb_str_hash(mrb_state *mrb, mrb_value str)
-{
-  struct RString *s = mrb_str_ptr(str);
-  return mrb_byte_hash((uint8_t*)RSTR_PTR(s), RSTR_LEN(s));
-}
-
-/* 15.2.10.5.20 */
-/*
- * call-seq:
- *    str.hash   => int
- *
- * Return a hash based on the string's length and content.
- */
-static mrb_value
-mrb_str_hash_m(mrb_state *mrb, mrb_value self)
+// FIXME: CWE-416: Use After Free
+ {
+  struct RString *s;
+  uint32_t hash;
+  mrb_gc_protect(mrb, str);
+  s = mrb_str_ptr(str);
+  hash = mrb_byte_hash((uint8_t*)RSTR_PTR(s), RSTR_LEN(s));
+  return hash;
+}mrb_str_hash_m(mrb_state *mrb, mrb_value self)
