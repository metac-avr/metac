diff --git a/src/string.c b/src/string.c
index df83f2c05..986bb6971 100644
--- a/src/string.c
+++ b/src/string.c
@@ -1725,0 +1726,17 @@ mrb_str_hash_m(mrb_state *mrb, mrb_value self)
+ *  character.
+ */
+static mrb_value
+mrb_str_include_m(mrb_state *mrb, mrb_value self)
+{
+  mrb_int argc;
+  mrb_value *argv;
+  mrb_get_args(mrb, "*", &argv, &argc);
+  if (argc == 1 && mrb_type(argv[0]) == MRB_TT_STRING) {
+    return mrb_bool_value(mrb_str_str(mrb, self, argv[0]) >= 0);
+  }
+  if (argc == 1 && mrb_type(argv[0]) == MRB_TT_FIXNUM) {
+    return mrb_bool_value(mrb_str_chr(mrb, self, mrb_fixnum(argv[0])) >= 0);
+  }
+  mrb_raise(mrb, E_ARGUMENT_ERROR, "wrong number of arguments");
+  return mrb_nil_value();
+}
