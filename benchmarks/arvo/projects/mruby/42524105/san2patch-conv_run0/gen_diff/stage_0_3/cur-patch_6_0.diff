diff --git a/src/string.c b/src/string.c
index df83f2c05..bb8e01056 100644
--- a/src/string.c
+++ b/src/string.c
@@ -1713 +1713,2 @@ static mrb_value
-mrb_str_hash_m(mrb_state *mrb, mrb_value self)
+// FIXME: Crash CWE-416: Use After Free
+ mrb_str_hash_m(mrb_state *mrb, mrb_value self)
@@ -1715,2 +1716,5 @@ mrb_str_hash_m(mrb_state *mrb, mrb_value self)
-  mrb_int key = mrb_str_hash(mrb, self);
-  return mrb_int_value(mrb, key);
+  if (mrb_string_p(self)) {
+    mrb_int key = mrb_str_hash(mrb, self);
+    return mrb_int_value(mrb, key);
+  }
+  return mrb_nil_value();
diff --git a/src/hash.c b/src/hash.c
index 365019352..13dc3e3c2 100644
--- a/src/hash.c
+++ b/src/hash.c
@@ -326 +326,5 @@ obj_hash_code(mrb_state *mrb, mrb_value key, struct RHash *h)
-    hash_code = mrb_str_hash(mrb, key);
+    if (mrb_string_p(key)) {
+      hash_code = mrb_str_hash(mrb, key);
+    } else {
+      hash_code = U32(mrb_obj_id(key));
+    }
@@ -343 +347,2 @@ obj_hash_code(mrb_state *mrb, mrb_value key, struct RHash *h)
-    break;
+// FIXME: Crash CWE-416: Use After Free
+     break;
