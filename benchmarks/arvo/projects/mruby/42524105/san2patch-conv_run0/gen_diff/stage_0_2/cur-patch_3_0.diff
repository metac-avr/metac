diff --git a/src/string.c b/src/string.c
index df83f2c05..6c3b0d0a0 100644
--- a/src/string.c
+++ b/src/string.c
@@ -211,0 +212 @@ str_decref(mrb_state *mrb, mrb_shared_string *shared)
+  if (shared == NULL) return;  // Prevent null pointer dereference
@@ -214 +215,4 @@ str_decref(mrb_state *mrb, mrb_shared_string *shared)
-    mrb_free(mrb, shared->ptr);
+    if (shared->ptr != NULL) {  // Check ptr validity before freeing
+      mrb_free(mrb, shared->ptr);
+      shared->ptr = NULL;     // Prevent double free
+    }
@@ -254,4 +258,11 @@ mrb_gc_free_str(mrb_state *mrb, struct RString *str)
-  else if (RSTR_SHARED_P(str))
-    str_decref(mrb, str->as.heap.aux.shared);
-  else if (!RSTR_NOFREE_P(str) && !RSTR_FSHARED_P(str))
-    mrb_free(mrb, str->as.heap.ptr);
+  else if (RSTR_SHARED_P(str)) {
+    if (str->as.heap.aux.shared) {
+      str_decref(mrb, str->as.heap.aux.shared);
+    }
+  }
+  else if (!RSTR_NOFREE_P(str) && !RSTR_FSHARED_P(str)) {
+    if (str->as.heap.ptr) {
+      mrb_free(mrb, str->as.heap.ptr);
+      str->as.heap.ptr = NULL;
+    }
+  }
