diff --git a/src/numeric.c b/src/numeric.c
index 239492add..3e54596b8 100644
--- a/src/numeric.c
+++ b/src/numeric.c
@@ -1670 +1670,6 @@ int_add(mrb_state *mrb, mrb_value self)
-    return mrb_bint_add(mrb, self, other);
+    /* Validate that other is also a valid bigint before proceeding */
+    if (mrb_bigint_p(other)) {
+      return mrb_bint_add(mrb, self, other);
+    }
+    /* Fall back to regular integer addition if other isn't a bigint */
+    return mrb_int_add(mrb, self, other);
diff --git a/mrbgems/mruby-bigint/core/bigint.c b/mrbgems/mruby-bigint/core/bigint.c
index dc3022c89..db0ab4839 100644
--- a/mrbgems/mruby-bigint/core/bigint.c
+++ b/mrbgems/mruby-bigint/core/bigint.c
@@ -188,0 +189 @@ ucmp(mpz_t *y, mpz_t *x)
+  if (y->sz == 0 || x->sz == 0) return 0;
@@ -189,0 +191 @@ ucmp(mpz_t *y, mpz_t *x)
+    if (i >= y->sz) return 0;
@@ -190,0 +193 @@ ucmp(mpz_t *y, mpz_t *x)
+    if (i >= x->sz) return 0;
