diff --git a/mrbgems/mruby-bigint/core/bigint.c b/mrbgems/mruby-bigint/core/bigint.c
index dc3022c89..e1b1856e5 100644
--- a/mrbgems/mruby-bigint/core/bigint.c
+++ b/mrbgems/mruby-bigint/core/bigint.c
@@ -188,0 +189 @@ ucmp(mpz_t *y, mpz_t *x)
+  if (y->sz == 0) return 0;
@@ -189,0 +191 @@ ucmp(mpz_t *y, mpz_t *x)
+    if (i >= y->sz) return 0;
@@ -1091 +1093,10 @@ mrb_bint_add(mrb_state *mrb, mrb_value x, mrb_value y)
-  mpz_add(mrb, &b3->mp, &b->mp, &b2->mp);
+  
+  if (b3 == NULL) {
+    mrb_raise(mrb, E_RUNTIME_ERROR, "failed to allocate big integer");
+  }
+  
+  if (b && b2 && b3) {
+    mpz_add(mrb, &b3->mp, &b->mp, &b2->mp);
+  } else {
+    mrb_raise(mrb, E_ARGUMENT_ERROR, "null pointer in big integer operation");
+  }
