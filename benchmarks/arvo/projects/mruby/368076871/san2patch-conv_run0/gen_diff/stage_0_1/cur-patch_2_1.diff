diff --git a/src/numeric.c b/src/numeric.c
index bfa8465f3..452c45cbf 100644
--- a/src/numeric.c
+++ b/src/numeric.c
@@ -1109,0 +1110,4 @@ int_mod(mrb_state *mrb, mrb_value x)
+  /* Early check for zero divisor to prevent divide-by-zero */
+  if (mrb_immediate_p(y) && mrb_integer_p(y) && mrb_integer(y) == 0) {
+    mrb_int_zerodiv(mrb);
+  }
diff --git a/mrbgems/mruby-bigint/core/bigint.c b/mrbgems/mruby-bigint/core/bigint.c
