+++ b/mrbgems/mruby-bigint/core/bigint.c
@@ -490,0 +491,6 @@ udiv(mrb_state *mrb, mpz_t *qq, mpz_t *rr, mpz_t *xx, mpz_t *yy)
+  /* Check for division by zero */
+  if (yy->sn == 0) {
+    mrb_raise(mrb, E_ZERO_DIVISION_ERROR, "divided by 0");
+    return;
+  }
+
@@ -497 +503,2 @@ udiv(mrb_state *mrb, mpz_t *qq, mpz_t *rr, mpz_t *xx, mpz_t *yy)
-  mpz_realloc(mrb, &x, xx->sz+1);
+// FIXME: Crash CWE-369: Divide By Zero
+   mpz_realloc(mrb, &x, xx->sz+1);
