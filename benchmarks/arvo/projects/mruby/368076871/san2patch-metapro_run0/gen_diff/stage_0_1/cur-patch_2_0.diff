diff --git a/src/numeric.c b/src/numeric.c
index bfa8465f3..f23cbd678 100644
--- a/src/numeric.c
+++ b/src/numeric.c
@@ -1110 +1110,2 @@ int_mod(mrb_state *mrb, mrb_value x)
-#ifdef MRB_USE_BIGINT
+// FIXME: Crash CWE-369: Divide By Zero
+ #ifdef MRB_USE_BIGINT
@@ -1111,0 +1113,8 @@ int_mod(mrb_state *mrb, mrb_value x)
+    if (mrb_bigint_p(y)) {
+      // Check if bigint y is zero before proceeding
+      if (mrb_bint_cmp(mrb, y, mrb_fixnum_value(0)) == 0) {
+        mrb_int_zerodiv(mrb);
+      }
+    } else if (mrb_integer_p(y) && mrb_integer(y) == 0) {
+      mrb_int_zerodiv(mrb);
+    }
diff --git a/mrbgems/mruby-bigint/core/bigint.c b/mrbgems/mruby-bigint/core/bigint.c
index b022e49c6..57f4b2974 100644
--- a/mrbgems/mruby-bigint/core/bigint.c
+++ b/mrbgems/mruby-bigint/core/bigint.c
@@ -490,0 +491,6 @@ udiv(mrb_state *mrb, mpz_t *qq, mpz_t *rr, mpz_t *xx, mpz_t *yy)
+  /* Check for division by zero before proceeding */
+  if (yy->sn == 0) {
+    mrb_raise(mrb, E_ARGUMENT_ERROR, "division by zero");
+    return;
+  }
+
@@ -497 +503,2 @@ udiv(mrb_state *mrb, mpz_t *qq, mpz_t *rr, mpz_t *xx, mpz_t *yy)
-  mpz_realloc(mrb, &x, xx->sz+1);
+// FIXME: Crash CWE-369: Divide By Zero
+   mpz_realloc(mrb, &x, xx->sz+1);
