+  } else {
+    /* handle invalid yd case */
+    zero(qq);
+    mpz_set(mrb, rr, xx);
@@ -538,6 +550,0 @@ udiv(mrb_state *mrb, mpz_t *qq, mpz_t *rr, mpz_t *xx, mpz_t *yy)
