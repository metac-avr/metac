+   mpz_realloc(mrb, &x, xx->sz+1);
@@ -499,23 +500,26 @@ udiv(mrb_state *mrb, mpz_t *qq, mpz_t *rr, mpz_t *xx, mpz_t *yy)
-  size_t ns = lzb(yy->p[yd-1]);
-  ulshift(mrb, &x, xx, ns);
-  ulshift(mrb, &y, yy, ns);
-  size_t xd = digits(&x);
-  mpz_realloc(mrb, &q, xd);
-  mp_dbl_limb z = y.p[yd-1];
-  if (xd>=yd) {
-    for (size_t j=xd-yd;; j--) {
-      mp_dbl_limb_signed b=0;
-      mp_dbl_limb qhat;
-
-      if (j+yd == xd)
-        qhat = x.p[j+yd-1] / z;
-      else
-        qhat = (((mp_dbl_limb)x.p[j+yd] << DIG_SIZE) + x.p[j+yd-1]) / z;
-      if (qhat) {
-        size_t i;
-
-        for (i=0; i<yd; i++) {
