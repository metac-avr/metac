+        for (; b!=0; qhat--) {
+          mp_dbl_limb c = 0;
+          for (size_t i=0; i<yd; i++) {
+            c += (mp_dbl_limb)x.p[i+j] + (mp_dbl_limb)y.p[i];
+            x.p[i+j] = LOW(c);
+            c = HIGH(c);
+          }
+          b += c;
@@ -532 +537,2 @@ udiv(mrb_state *mrb, mpz_t *qq, mpz_t *rr, mpz_t *xx, mpz_t *yy)
-        b += c;
+        q.p[j] = (mp_limb)qhat;
