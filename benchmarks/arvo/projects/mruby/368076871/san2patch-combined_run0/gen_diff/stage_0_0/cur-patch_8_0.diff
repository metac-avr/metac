+   mpz_realloc(mrb, &x, xx->sz+1);
@@ -498,0 +500 @@ udiv(mrb_state *mrb, mpz_t *qq, mpz_t *rr, mpz_t *xx, mpz_t *yy)
+  if (yd == 0 || !yy->p) return;  /* prevent null pointer access */
@@ -504,18 +506,21 @@ udiv(mrb_state *mrb, mpz_t *qq, mpz_t *rr, mpz_t *xx, mpz_t *yy)
-  mp_dbl_limb z = y.p[yd-1];
-  if (xd>=yd) {
-    for (size_t j=xd-yd;; j--) {
-      mp_dbl_limb_signed b=0;
-      mp_dbl_limb qhat;
-
-      if (j+yd == xd)
-        qhat = x.p[j+yd-1] / z;
-      else
-        qhat = (((mp_dbl_limb)x.p[j+yd] << DIG_SIZE) + x.p[j+yd-1]) / z;
-      if (qhat) {
-        size_t i;
-
-        for (i=0; i<yd; i++) {
-          mp_dbl_limb zz = qhat * y.p[i];
-          mp_dbl_limb_signed u = LOW(b)+x.p[i+j]-LOW(zz);
