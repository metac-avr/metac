diff --git a/src/numeric.c b/src/numeric.c
index bfa8465f3..46e047822 100644
--- a/src/numeric.c
+++ b/src/numeric.c
@@ -1110 +1110,2 @@ int_mod(mrb_state *mrb, mrb_value x)
-#ifdef MRB_USE_BIGINT
+// FIXME: Crash CWE-369: Divide By Zero
+ #ifdef MRB_USE_BIGINT
@@ -1111,0 +1113,5 @@ int_mod(mrb_state *mrb, mrb_value x)
+    // Check for zero divisor before calling mrb_bint_mod
+    if ((mrb_integer_p(y) && mrb_integer(y) == 0) || 
+        (mrb_bigint_p(y) && mrb_bint_cmp(mrb, y, mrb_fixnum_value(0)) == 0)) {
+      mrb_int_zerodiv(mrb);
+    }
diff --git a/mrbgems/mruby-bigint/core/bigint.c b/mrbgems/mruby-bigint/core/bigint.c
index b022e49c6..f7f511318 100644
--- a/mrbgems/mruby-bigint/core/bigint.c
+++ b/mrbgems/mruby-bigint/core/bigint.c
@@ -492,0 +493,6 @@ udiv(mrb_state *mrb, mpz_t *qq, mpz_t *rr, mpz_t *xx, mpz_t *yy)
+  /* Guard against division by zero */
+  if (yy->sn == 0) {
+    zero(qq);
+    zero(rr);
+    return;
+  }
@@ -497 +503,2 @@ udiv(mrb_state *mrb, mpz_t *qq, mpz_t *rr, mpz_t *xx, mpz_t *yy)
-  mpz_realloc(mrb, &x, xx->sz+1);
+// FIXME: Crash CWE-369: Divide By Zero
+   mpz_realloc(mrb, &x, xx->sz+1);
