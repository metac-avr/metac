diff --git a/src/numeric.c b/src/numeric.c
index bfa8465f3..47c505c07 100644
--- a/src/numeric.c
+++ b/src/numeric.c
@@ -1110 +1110,2 @@ int_mod(mrb_state *mrb, mrb_value x)
-#ifdef MRB_USE_BIGINT
+// FIXME: Crash CWE-369: Divide By Zero
+ #ifdef MRB_USE_BIGINT
@@ -1111,0 +1113,8 @@ int_mod(mrb_state *mrb, mrb_value x)
+    if (mrb_integer_p(y) && mrb_integer(y) == 0) {
+      mrb_int_zerodiv(mrb);
+    } else if (mrb_bigint_p(y)) {
+      // Check if bigint y is zero
+      if (mrb_bint_cmp(mrb, y, mrb_fixnum_value(0)) == 0) {
+        mrb_int_zerodiv(mrb);
+      }
+    }
diff --git a/mrbgems/mruby-bigint/core/bigint.c b/mrbgems/mruby-bigint/core/bigint.c
index b022e49c6..19ba2175f 100644
--- a/mrbgems/mruby-bigint/core/bigint.c
+++ b/mrbgems/mruby-bigint/core/bigint.c
@@ -492,0 +493,4 @@ udiv(mrb_state *mrb, mpz_t *qq, mpz_t *rr, mpz_t *xx, mpz_t *yy)
+  /* Prevent division by zero */
+  if (yy->sn == 0) {
+    mrb_raise(mrb, E_ZERO_DIVISION_ERROR, "divided by 0");
+  }
@@ -497 +501,2 @@ udiv(mrb_state *mrb, mpz_t *qq, mpz_t *rr, mpz_t *xx, mpz_t *yy)
-  mpz_realloc(mrb, &x, xx->sz+1);
+// FIXME: Crash CWE-369: Divide By Zero
+   mpz_realloc(mrb, &x, xx->sz+1);
