diff --git a/src/vm.c b/src/vm.c
index 3c3a5237f..e7fdfc05d 100644
--- a/src/vm.c
+++ b/src/vm.c
@@ -1199 +1199 @@ mrb_vm_run(mrb_state *mrb, const struct RProc *proc, mrb_value self, mrb_int sta
-
+ 
@@ -1204,0 +1205,2 @@ mrb_vm_run(mrb_state *mrb, const struct RProc *proc, mrb_value self, mrb_int sta
+  if (nregs < 0) nregs = 0;
+  if (nregs > 0x10000) nregs = 0x10000;  /* reasonable upper limit */
@@ -1206 +1208,6 @@ mrb_vm_run(mrb_state *mrb, const struct RProc *proc, mrb_value self, mrb_int sta
-  stack_clear(c->ci->stack + stack_keep, nregs - stack_keep);
+  if (nregs > stack_keep) {
+    mrb_int clear_size = nregs - stack_keep;
+    if (clear_size > 0 && clear_size < 0x10000) {  /* validate clear size */
+      stack_clear(c->ci->stack + stack_keep, clear_size);
+    }
+  }
@@ -1707 +1714,2 @@ mrb_vm_exec(mrb_state *mrb, const struct RProc *proc, const mrb_code *pc)
-      mrb_value recv, blk;
+// FIXME: Crash CWE-787: Out-of-bounds Write
+       mrb_value recv, blk;
@@ -1756 +1764,7 @@ mrb_vm_exec(mrb_state *mrb, const struct RProc *proc, const mrb_code *pc)
-        ci->stack[0] = recv;
+        /* Safe stack write with null check */
+        if (ci->stack != NULL) {
+          ci->stack[0] = recv;
+        } else {
+          /* Handle null stack case - prevent crash */
+          mrb_raise(mrb, E_RUNTIME_ERROR, "Stack is null during execution");
+        }
