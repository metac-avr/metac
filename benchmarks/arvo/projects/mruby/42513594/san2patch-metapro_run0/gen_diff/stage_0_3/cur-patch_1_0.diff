diff --git a/src/vm.c b/src/vm.c
index 3c3a5237f..e858803cc 100644
--- a/src/vm.c
+++ b/src/vm.c
@@ -115,2 +115,2 @@ stack_init(mrb_state *mrb)
-  /* mrb_assert(mrb->stack == NULL); */
-  c->stbase = (mrb_value *)mrb_calloc(mrb, STACK_INIT_SIZE, sizeof(mrb_value));
+  /* Allocate stack with safety margin to prevent boundary issues */
+  c->stbase = (mrb_value *)mrb_calloc(mrb, STACK_INIT_SIZE + 1, sizeof(mrb_value));
@@ -117,0 +118,5 @@ stack_init(mrb_state *mrb)
+  
+  /* Bounds check to prevent out-of-bounds writes */
+  if (c->stbase == NULL) {
+    mrb_raise(mrb, E_RUNTIME_ERROR, "Stack allocation failed");
+  }
@@ -119 +124 @@ stack_init(mrb_state *mrb)
-  /* mrb_assert(ci == NULL); */
+  /* Allocate call info structure */
@@ -1707 +1712,2 @@ mrb_vm_exec(mrb_state *mrb, const struct RProc *proc, const mrb_code *pc)
-      mrb_value recv, blk;
+// FIXME: Crash CWE-787: Out-of-bounds Write
+       mrb_value recv, blk;
@@ -1710,0 +1717,4 @@ mrb_vm_exec(mrb_state *mrb, const struct RProc *proc, const mrb_code *pc)
+      /* Safe register access with bounds checking */
+      if (a < 0 || a >= (mrb->c->stend - mrb->c->stbase)) {
+        mrb_raise(mrb, E_RUNTIME_ERROR, "invalid register access");
+      }
@@ -1755,0 +1766,4 @@ mrb_vm_exec(mrb_state *mrb, const struct RProc *proc, const mrb_code *pc)
+        /* Safe stack write with bounds checking */
+        if ((ci->stack - mrb->c->stbase) < 0 || (ci->stack - mrb->c->stbase + 0) >= (mrb->c->stend - mrb->c->stbase)) {
+          mrb_raise(mrb, E_RUNTIME_ERROR, "stack write out of bounds");
+        }
