diff --git a/src/vm.c b/src/vm.c
index 3c3a5237f..2e7f262e3 100644
--- a/src/vm.c
+++ b/src/vm.c
@@ -117,0 +118,7 @@ stack_init(mrb_state *mrb)
+  
+  /* Ensure proper stack allocation and bounds */
+  if (c->stbase && STACK_INIT_SIZE > 0) {
+    memset(c->stbase, 0, STACK_INIT_SIZE * sizeof(mrb_value));
+  } else {
+    mrb_raise(mrb, E_RUNTIME_ERROR, "Invalid stack allocation");
+  }
@@ -1707 +1714,2 @@ mrb_vm_exec(mrb_state *mrb, const struct RProc *proc, const mrb_code *pc)
-      mrb_value recv, blk;
+// FIXME: Crash CWE-787: Out-of-bounds Write
+       mrb_value recv, blk;
@@ -1710,0 +1719,5 @@ mrb_vm_exec(mrb_state *mrb, const struct RProc *proc, const mrb_code *pc)
+      /* Bounds checking to prevent heap buffer overflow */
+      if ((mrb_int)(regs + a - mrb->c->stbase) >= (mrb->c->stend - mrb->c->stbase) || 
+          regs + a < mrb->c->stbase) {
+        mrb_raisef(mrb, E_ARGUMENT_ERROR, "register %d out of range", a);
+      }
