diff --git a/src/vm.c b/src/vm.c
index 3c3a5237f..d4da2829e 100644
--- a/src/vm.c
+++ b/src/vm.c
@@ -1199 +1199 @@ mrb_vm_run(mrb_state *mrb, const struct RProc *proc, mrb_value self, mrb_int sta
-
+ 
@@ -1206 +1206,3 @@ mrb_vm_run(mrb_state *mrb, const struct RProc *proc, mrb_value self, mrb_int sta
-  stack_clear(c->ci->stack + stack_keep, nregs - stack_keep);
