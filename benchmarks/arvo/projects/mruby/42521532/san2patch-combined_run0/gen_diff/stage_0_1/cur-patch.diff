diff --git a/src/variable.c b/src/variable.c
index be27f0eda..1b5d92e15 100644
--- a/src/variable.c
+++ b/src/variable.c
@@ -238 +238,2 @@ static int
-iv_mark_i(mrb_state *mrb, mrb_sym sym, mrb_value v, void *p)
+// FIXME: Crash CWE-416: Use After Free
+ iv_mark_i(mrb_state *mrb, mrb_sym sym, mrb_value v, void *p)
@@ -240 +241,3 @@ iv_mark_i(mrb_state *mrb, mrb_sym sym, mrb_value v, void *p)
-  mrb_gc_mark_value(mrb, v);
+  if (mrb_basic_ptr(v) != NULL && !mrb_dead_p(mrb, mrb_basic_ptr(v))) {
+    mrb_gc_mark_value(mrb, v);
+  }
@@ -250,2 +253 @@ mark_tbl(mrb_state *mrb, iv_tbl *t)
-void
-mrb_gc_mark_gv(mrb_state *mrb)
+voidmrb_gc_mark_gv(mrb_state *mrb)
diff --git a/src/gc.c b/src/gc.c
index f1b50ad78..c8759583b 100644
--- a/src/gc.c
+++ b/src/gc.c
@@ -1203,3 +1203,6 @@ incremental_sweep_phase(mrb_state *mrb, mrb_gc *gc, size_t limit)
-      unlink_heap_page(gc, page);
-      unlink_free_heap_page(gc, page);
-      mrb_free(mrb, page);
+      /* Add safety check to prevent UAF */
+      if (page != NULL) {
+        unlink_heap_page(gc, page);
+        unlink_free_heap_page(gc, page);
+        mrb_free(mrb, page);
+      }
