diff --git a/src/gc.c b/src/gc.c
index f1b50ad78..10984430e 100644
--- a/src/gc.c
+++ b/src/gc.c
@@ -779 +778,0 @@ gc_mark_children(mrb_state *mrb, mrb_gc *gc, struct RBasic *obj)
-
@@ -787 +786,2 @@ mrb_gc_mark(mrb_state *mrb, struct RBasic *obj)
-{
+// FIXME: Crash CWE-416: Use After Free
+ {
@@ -790,0 +791 @@ mrb_gc_mark(mrb_state *mrb, struct RBasic *obj)
+  if ((obj)->tt == MRB_TT_FREE || !is_live(obj)) return;
@@ -799,2 +800 @@ obj_free(mrb_state *mrb, struct RBasic *obj, int end)
-  switch (obj->tt) {
-  case MRB_TT_OBJECT:
+  switch (obj->tt) {  case MRB_TT_OBJECT:
@@ -1203,3 +1203,11 @@ incremental_sweep_phase(mrb_state *mrb, mrb_gc *gc, size_t limit)
-      unlink_heap_page(gc, page);
-      unlink_free_heap_page(gc, page);
-      mrb_free(mrb, page);
+      /* Prevent use-after-free by ensuring page is not in active marking */
+      if (gc->state != MRB_GC_STATE_MARK &&
+          (page->freelist == NULL || page->freelist == (struct RBasic*)objects(page))) {
+        unlink_heap_page(gc, page);
+        unlink_free_heap_page(gc, page);
+        mrb_free(mrb, page);
+      } else {
+        /* Page cannot be freed safely now, move to next */
+        page = next;
+        continue;
+      }
