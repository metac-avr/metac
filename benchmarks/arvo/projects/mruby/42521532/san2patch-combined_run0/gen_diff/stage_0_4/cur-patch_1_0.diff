diff --git a/src/gc.c b/src/gc.c
index f1b50ad78..ac9311030 100644
--- a/src/gc.c
+++ b/src/gc.c
@@ -779 +778,0 @@ gc_mark_children(mrb_state *mrb, mrb_gc *gc, struct RBasic *obj)
-
@@ -787 +786,2 @@ mrb_gc_mark(mrb_state *mrb, struct RBasic *obj)
-{
+// FIXME: Crash CWE-416: Use After Free
+ {
@@ -790,0 +791 @@ mrb_gc_mark(mrb_state *mrb, struct RBasic *obj)
+  if (is_dead(&mrb->gc, obj)) return;
@@ -799,2 +800 @@ obj_free(mrb_state *mrb, struct RBasic *obj, int end)
-  switch (obj->tt) {
-  case MRB_TT_OBJECT:
+  switch (obj->tt) {  case MRB_TT_OBJECT:
@@ -1203,3 +1203,16 @@ incremental_sweep_phase(mrb_state *mrb, mrb_gc *gc, size_t limit)
-      unlink_heap_page(gc, page);
-      unlink_free_heap_page(gc, page);
-      mrb_free(mrb, page);
+      /* Add safety check to prevent use-after-free when page is accessed elsewhere */
+      mrb_bool can_free = TRUE;
+      RVALUE *check_p = objects(page);
+      RVALUE *check_e = check_p + MRB_HEAP_PAGE_SIZE;
+      while (check_p < check_e) {
+        if (check_p->as.basic.tt != MRB_TT_FREE) {
+          can_free = FALSE;
+          break;
+        }
+        check_p++;
+      }
+      if (can_free) {
+        unlink_heap_page(gc, page);
+        unlink_free_heap_page(gc, page);
+        mrb_free(mrb, page);
+      }
