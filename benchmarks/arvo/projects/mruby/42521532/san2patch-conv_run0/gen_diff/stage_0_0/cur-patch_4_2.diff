diff --git a/src/gc.c b/src/gc.c
index f1b50ad78..f2290aebe 100644
--- a/src/gc.c
+++ b/src/gc.c
@@ -1097,2 +1097,5 @@ incremental_marking_phase(mrb_state *mrb, mrb_gc *gc, size_t limit)
-    gc_mark_children(mrb, gc, obj);
-    tried_marks += gc_gray_counts(mrb, gc, obj);
+    // Validate object before marking to prevent expired pointer dereference
+    if (obj && obj->tt > MRB_TT_FREE) {
+      gc_mark_children(mrb, gc, obj);
+      tried_marks += gc_gray_counts(mrb, gc, obj);
+    }
@@ -1202,0 +1206,2 @@ incremental_sweep_phase(mrb_state *mrb, mrb_gc *gc, size_t limit)
+      /* Clear page references before freeing to prevent dangling pointers */
+      page->next = NULL;
