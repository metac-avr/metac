diff --git a/src/vm.c b/src/vm.c
index 1c59d4406..435ec9d01 100644
--- a/src/vm.c
+++ b/src/vm.c
@@ -179,0 +180,10 @@ stack_extend_alloc(mrb_state *mrb, mrb_int room)
+  /* Validate size calculation to prevent integer overflow */
+  if (size < oldsize || size < (size_t)room) {
+    mrb_exc_raise(mrb, mrb_obj_value(mrb->stack_err));
+  }
+  
+  /* Ensure size does not exceed maximum allowed stack size before allocation */
+  if (size > MRB_STACK_MAX) {
+    mrb_exc_raise(mrb, mrb_obj_value(mrb->stack_err));
+  }
