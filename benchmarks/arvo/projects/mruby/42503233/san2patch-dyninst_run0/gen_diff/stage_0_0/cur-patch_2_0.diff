diff --git a/src/vm.c b/src/vm.c
index 1c59d4406..6447ea204 100644
--- a/src/vm.c
+++ b/src/vm.c
@@ -179,0 +180,12 @@ stack_extend_alloc(mrb_state *mrb, mrb_int room)
+  /* Prevent integer overflow in size calculation */
+  if (size > MRB_STACK_MAX - room) {
+    mrb_exc_raise(mrb, mrb_obj_value(mrb->stack_err));
+  }
+
+  /* Check for multiplication overflow when doubling */
+#ifdef MRB_STACK_EXTEND_DOUBLING
+  if ((size_t)room <= size && size > SIZE_MAX / 2) {
+    mrb_exc_raise(mrb, mrb_obj_value(mrb->stack_err));
+  }
+#endif
+
