@@ -199,0 +201,3 @@ mrb_stack_extend(mrb_state *mrb, mrb_int room)
+    if (room > MRB_STACK_MAX - (mrb->c->ci->stack ? (mrb->c->stend - mrb->c->ci->stack) : 0)) {
+      mrb_exc_raise(mrb, mrb_obj_value(mrb->stack_err)); /* Prevent overflow */
+    }
@@ -478,0 +483,6 @@ mrb_funcall_with_block(mrb_state *mrb, mrb_value self, mrb_sym mid, mrb_int argc
