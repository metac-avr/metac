+      if (n > MRB_INT_MAX - 2) {
+        mrb_raise(mrb, E_ARGUMENT_ERROR, "stack extension too large");
+      }
@@ -506,0 +525,4 @@ mrb_funcall_with_block(mrb_state *mrb, mrb_value self, mrb_sym mid, mrb_int argc
+        // Validate irep nregs to prevent overflow
+        if (p->body.irep->nregs > MRB_INT_MAX - argc) {
+          mrb_raise(mrb, E_ARGUMENT_ERROR, "too many registers");
