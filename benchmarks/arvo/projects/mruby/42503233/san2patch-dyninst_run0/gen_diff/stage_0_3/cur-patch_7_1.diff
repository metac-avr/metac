+    // Validate stack extension size to prevent buffer overflow
+    if (argc > MRB_INT_MAX - 3) {
+      mrb_raise(mrb, E_ARGUMENT_ERROR, "too many arguments");
+    }
+    
@@ -482,0 +493,4 @@ mrb_funcall_with_block(mrb_state *mrb, mrb_value self, mrb_sym mid, mrb_int argc
