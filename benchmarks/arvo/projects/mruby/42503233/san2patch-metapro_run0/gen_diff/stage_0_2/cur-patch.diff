diff --git a/src/vm.c b/src/vm.c
index 1c59d4406..6a56759eb 100644
--- a/src/vm.c
+++ b/src/vm.c
@@ -178 +178,5 @@ stack_extend_alloc(mrb_state *mrb, mrb_int room)
-#endif
+  /* Limit maximum stack growth to prevent buffer overflow */
+  if (size >= MRB_STACK_MAX) {
+    mrb_exc_raise(mrb, mrb_obj_value(mrb->stack_err));
+  }
+ #endif
@@ -479 +483,2 @@ mrb_funcall_with_block(mrb_state *mrb, mrb_value self, mrb_sym mid, mrb_int argc
-    c = mrb_class(mrb, self);
+// FIXME: Crash CWE-787: Out-of-bounds Write
+     c = mrb_class(mrb, self);
@@ -481 +486,12 @@ mrb_funcall_with_block(mrb_state *mrb, mrb_value self, mrb_sym mid, mrb_int argc
-    mrb_stack_extend(mrb, argc + 3);
+    
+    // Conservative stack extension with explicit bounds checking
+    {
+      mrb_int required_stack = argc + 3;
+      if (mrb->c->stend - mrb->c->stack < required_stack) {
+        if (mrb->c->ci - mrb->c->cibase > MRB_CALL_LEVEL_MAX - 5) {
+          mrb_exc_raise(mrb, mrb_obj_value(mrb->stack_err));
+        }
+        mrb_stack_extend(mrb, required_stack);
+      }
+    }
+    
@@ -497 +513,11 @@ mrb_funcall_with_block(mrb_state *mrb, mrb_value self, mrb_sym mid, mrb_int argc
-      mrb_stack_extend(mrb, n+2);
+      
+      // Safe stack extension for method_missing case
+      {
+        mrb_int required_stack = n + 2;
+        if (mrb->c->stend - mrb->c->stack < required_stack) {
+          if (mrb->c->ci - mrb->c->cibase > MRB_CALL_LEVEL_MAX - 3) {
+            mrb_exc_raise(mrb, mrb_obj_value(mrb->stack_err));
+          }
+          mrb_stack_extend(mrb, required_stack);
+        }
+      }
@@ -507 +533,7 @@ mrb_funcall_with_block(mrb_state *mrb, mrb_value self, mrb_sym mid, mrb_int argc
-        mrb_stack_extend(mrb, p->body.irep->nregs + argc);
+        mrb_int required_regs = p->body.irep->nregs + argc;
+        if (mrb->c->stend - mrb->c->stack < required_regs) {
+          if (mrb->c->ci - mrb->c->cibase > MRB_CALL_LEVEL_MAX - 2) {
+            mrb_exc_raise(mrb, mrb_obj_value(mrb->stack_err));
+          }
+        }
+        mrb_stack_extend(mrb, required_regs);
