diff --git a/mrbgems/mruby-complex/src/complex.c b/mrbgems/mruby-complex/src/complex.c
index 66176c3c1..9ae96341f 100644
--- a/mrbgems/mruby-complex/src/complex.c
+++ b/mrbgems/mruby-complex/src/complex.c
@@ -159,0 +160,4 @@ mrb_complex_eq(mrb_state *mrb, mrb_value x, mrb_value y)
+    /* Check recursion depth to prevent stack overflow */
+    if (mrb->c->ci && mrb->c->ci->cci > 500) {
+      mrb_raise(mrb, E_RUNTIME_ERROR, "stack level too deep");
+    }
