diff --git a/src/vm.c b/src/vm.c
index 1c59d4406..2dfbbfe07 100644
--- a/src/vm.c
+++ b/src/vm.c
@@ -162 +162 @@ stack_extend_alloc(mrb_state *mrb, mrb_int room)
-  size_t off = mrb->c->ci->stack ? mrb->c->stend - mrb->c->ci->stack : 0;
+  size_t off = mrb->c->ci->stack ? mrb->c->stend - mrb->c->stack : 0;
@@ -179,0 +180,5 @@ stack_extend_alloc(mrb_state *mrb, mrb_int room)
+  /* Prevent integer overflow and check size limits before allocation */
+  if (size > MRB_STACK_MAX || size < oldsize) {
+    mrb_exc_raise(mrb, mrb_obj_value(mrb->stack_err));
+  }
+
@@ -189,2 +194 @@ stack_extend_alloc(mrb_state *mrb, mrb_int room)
-  /* Raise an exception if the new stack size will be too large,
-     to prevent infinite recursion. However, do this only after resizing the stack, so mrb_raise has stack space to work with. */
+  /* Additional safety check after allocation */
@@ -387,0 +392,6 @@ mrb_funcall_id(mrb_state *mrb, mrb_value self, mrb_sym mid, mrb_int argc, ...)
+  /* Prevent stack overflow by limiting call depth */
+  if (mrb->callinfo_depth > 1000) {
+    mrb_raise(mrb, E_SYSTEM_CALL_ERROR, "stack level too deep");
+  }
+  mrb->callinfo_depth++;
+
@@ -393 +403,3 @@ mrb_funcall_id(mrb_state *mrb, mrb_value self, mrb_sym mid, mrb_int argc, ...)
-  return mrb_funcall_argv(mrb, self, mid, argc, argv);
+  mrb_value result = mrb_funcall_argv(mrb, self, mid, argc, argv);
+  mrb->callinfo_depth--;
+  return result;
