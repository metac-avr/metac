diff --git a/src/vm.c b/src/vm.c
index 1c59d4406..58a03ea50 100644
--- a/src/vm.c
+++ b/src/vm.c
@@ -164,0 +165,6 @@ stack_extend_alloc(mrb_state *mrb, mrb_int room)
+  
+  /* Validate room parameter to prevent negative values or arithmetic overflow */
+  if (room < 0) {
+    mrb_exc_raise(mrb, mrb_obj_value(mrb->stack_err));
+  }
+  
@@ -179,0 +186,5 @@ stack_extend_alloc(mrb_state *mrb, mrb_int room)
+  /* Check for potential integer overflow before allocation */
+  if (size > MRB_STACK_MAX || size < oldsize) {
+    mrb_exc_raise(mrb, mrb_obj_value(mrb->stack_err));
+  }
+
@@ -515,2 +526,7 @@ mrb_funcall_with_block(mrb_state *mrb, mrb_value self, mrb_sym mid, mrb_int argc
-      if (argc > 0)
-        stack_copy(ci->stack+1, argv, argc);
+      if (argc > 0) {
+        if (ci->stack + 1 + argc <= mrb->c->stend) {
+          stack_copy(ci->stack+1, argv, argc);
+        } else {
+          mrb_raise(mrb, E_RUNTIME_ERROR, "stack overflow in funcall");
+        }
+      }
