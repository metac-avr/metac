diff --git a/src/vm.c b/src/vm.c
index 1c59d4406..283e2aaad 100644
--- a/src/vm.c
+++ b/src/vm.c
@@ -164,0 +165,6 @@ stack_extend_alloc(mrb_state *mrb, mrb_int room)
+  
+  /* Validate all parameters to prevent buffer overflow */
+  if (room < 0 || oldsize > SIZE_MAX / sizeof(mrb_value)) {
+    mrb_exc_raise(mrb, mrb_obj_value(mrb->stack_err));
+  }
+  
@@ -179,0 +186,5 @@ stack_extend_alloc(mrb_state *mrb, mrb_int room)
+  /* Additional check to prevent integer overflow */
+  if (size > MRB_STACK_MAX - 1) {
+    mrb_exc_raise(mrb, mrb_obj_value(mrb->stack_err));
+  }
+
@@ -515,2 +526,7 @@ mrb_funcall_with_block(mrb_state *mrb, mrb_value self, mrb_sym mid, mrb_int argc
-      if (argc > 0)
-        stack_copy(ci->stack+1, argv, argc);
+      if (argc > 0) {
+        if (argc <= MRB_ARGS_MAX_STACK) {
+          stack_copy(ci->stack+1, argv, argc);
+        } else {
+          mrb_raise(mrb, E_ARGUMENT_ERROR, "too many arguments for funcall");
+        }
+      }
