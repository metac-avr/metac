diff --git a/src/vm.c b/src/vm.c
index 1c59d4406..3b557ae87 100644
--- a/src/vm.c
+++ b/src/vm.c
@@ -198 +198,6 @@ mrb_stack_extend(mrb_state *mrb, mrb_int room)
-{
+// FIXME: Crash CWE-787: Out-of-bounds Write
+ {
+  /* Validate room parameter to prevent excessive stack extension */
+  if (room > MRB_STACK_MAX) {
+    mrb_exc_raise(mrb, mrb_obj_value(mrb->stack_err));
+  }
@@ -199,0 +205,5 @@ mrb_stack_extend(mrb_state *mrb, mrb_int room)
+    /* Additional boundary check before stack extension */
+    mrb_int current_size = mrb->c->ci->stack ? (mrb->c->ci->stack - mrb->c->stack) : 0;
+    if (current_size + room > MRB_STACK_MAX) {
+      mrb_exc_raise(mrb, mrb_obj_value(mrb->stack_err));
+    }
@@ -515,2 +525,7 @@ mrb_funcall_with_block(mrb_state *mrb, mrb_value self, mrb_sym mid, mrb_int argc
-      if (argc > 0)
-        stack_copy(ci->stack+1, argv, argc);
+      if (argc > 0) {
+        if ((size_t)argc <= (size_t)(mrb->c->stend - (ci->stack + 1))) {
+          stack_copy(ci->stack+1, argv, argc);
+        } else {
+          mrb_raisef(mrb, E_RUNTIME_ERROR, "stack copy size %d exceeds available space", argc);
+        }
+      }
