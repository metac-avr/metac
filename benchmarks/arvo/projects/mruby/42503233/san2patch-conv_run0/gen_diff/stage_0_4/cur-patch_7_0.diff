diff --git a/src/vm.c b/src/vm.c
index 1c59d4406..cd163258f 100644
--- a/src/vm.c
+++ b/src/vm.c
@@ -179,0 +180,5 @@ stack_extend_alloc(mrb_state *mrb, mrb_int room)
+  /* Validate size calculation to prevent overflow */
+  if (size > MRB_STACK_MAX || (size * sizeof(mrb_value)) / sizeof(mrb_value) != size) {
+    mrb_exc_raise(mrb, mrb_obj_value(mrb->stack_err));
+  }
+
@@ -2198,8 +2203,24 @@ mrb_vm_exec(mrb_state *mrb, const struct RProc *proc, const mrb_code *pc)
-            mrb->c = c->prev;
-            mrb->c->status = MRB_FIBER_RUNNING;
-            c->prev = NULL;
-            if (c->vmexec) {
-              mrb_gc_arena_restore(mrb, ai);
-              c->vmexec = FALSE;
-              mrb->jmp = prev_jmp;
-              return v;
+            
+            /* Add bounds check before context switch */
+            if (mrb->c != NULL && c->prev != NULL) {
+              mrb->c = c->prev;
+              mrb->c->status = MRB_FIBER_RUNNING;
+              c->prev = NULL;
+              if (c->vmexec) {
+                mrb_gc_arena_restore(mrb, ai);
+                c->vmexec = FALSE;
+                mrb->jmp = prev_jmp;
+                return v;
+              }
+              ci = mrb->c->ci;
+            } else {
+              /* Handle invalid context transition */
+              mrb->c = c;
+              c->status = MRB_FIBER_RUNNING;
+              if (c->vmexec) {
+                mrb_gc_arena_restore(mrb, ai);
+                c->vmexec = FALSE;
+                mrb->jmp = prev_jmp;
+                return v;
+              }
+              ci = mrb->c->ci;
@@ -2207 +2227,0 @@ mrb_vm_exec(mrb_state *mrb, const struct RProc *proc, const mrb_code *pc)
-            ci = mrb->c->ci;
