diff --git a/src/vm.c b/src/vm.c
index 1c59d4406..3f5430404 100644
--- a/src/vm.c
+++ b/src/vm.c
@@ -179,0 +180,6 @@ stack_extend_alloc(mrb_state *mrb, mrb_int room)
+  /* Prevent integer overflow in size calculation */
+  if (size > MRB_STACK_MAX) {
+    mrb_exc_raise(mrb, mrb_obj_value(mrb->stack_err));
+    return;
+  }
+  
@@ -2198,8 +2204,21 @@ mrb_vm_exec(mrb_state *mrb, const struct RProc *proc, const mrb_code *pc)
-            mrb->c = c->prev;
-            mrb->c->status = MRB_FIBER_RUNNING;
-            c->prev = NULL;
-            if (c->vmexec) {
-              mrb_gc_arena_restore(mrb, ai);
-              c->vmexec = FALSE;
-              mrb->jmp = prev_jmp;
-              return v;
+            
+            /* Prevent potential null dereference and buffer overflow */
+            if (c != NULL) {
+              if (c->prev != NULL) {
+                mrb->c = c->prev;
+                if (mrb->c != NULL) {
+                  mrb->c->status = MRB_FIBER_RUNNING;
+                }
+                c->prev = NULL;
+              } else {
+                mrb->c = c;
+                c->status = MRB_FIBER_RUNNING;
+              }
+              
+              if (c->vmexec) {
+                mrb_gc_arena_restore(mrb, ai);
+                c->vmexec = FALSE;
+                mrb->jmp = prev_jmp;
+                return v;
+              }
+              ci = mrb->c->ci;
@@ -2207 +2225,0 @@ mrb_vm_exec(mrb_state *mrb, const struct RProc *proc, const mrb_code *pc)
-            ci = mrb->c->ci;
