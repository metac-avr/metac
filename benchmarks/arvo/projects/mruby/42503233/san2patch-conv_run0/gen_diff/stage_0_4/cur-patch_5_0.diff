diff --git a/src/vm.c b/src/vm.c
index 1c59d4406..0c3c40ab9 100644
--- a/src/vm.c
+++ b/src/vm.c
@@ -162 +162 @@ stack_extend_alloc(mrb_state *mrb, mrb_int room)
-  size_t off = mrb->c->ci->stack ? mrb->c->stend - mrb->c->ci->stack : 0;
+  size_t off = mrb->c->ci->stack ? mrb->c->stend - mrb->c->stack : 0;
@@ -179,0 +180,5 @@ stack_extend_alloc(mrb_state *mrb, mrb_int room)
+  /* Prevent integer overflow and ensure size limits */
+  if (size > MRB_STACK_MAX || (sizeof(mrb_value) * size) / sizeof(mrb_value) != size) {
+    mrb_exc_raise(mrb, mrb_obj_value(mrb->stack_err));
+  }
+
@@ -188,6 +192,0 @@ stack_extend_alloc(mrb_state *mrb, mrb_int room)
-
-  /* Raise an exception if the new stack size will be too large,
-     to prevent infinite recursion. However, do this only after resizing the stack, so mrb_raise has stack space to work with. */
-  if (size > MRB_STACK_MAX) {
-    mrb_exc_raise(mrb, mrb_obj_value(mrb->stack_err));
-  }
@@ -515,2 +514,9 @@ mrb_funcall_with_block(mrb_state *mrb, mrb_value self, mrb_sym mid, mrb_int argc
-      if (argc > 0)
-        stack_copy(ci->stack+1, argv, argc);
+// FIXME: Crash CWE-787: Out-of-bounds Write
+       if (argc > 0) {
+        mrb_int available_space = mrb->c->stend - (ci->stack+1);
+        if (available_space >= argc) {
+          stack_copy(ci->stack+1, argv, argc);
+        } else {
+          mrb_raise(mrb, E_RUNTIME_ERROR, "Insufficient stack space for argument copy");
+        }
+      }
