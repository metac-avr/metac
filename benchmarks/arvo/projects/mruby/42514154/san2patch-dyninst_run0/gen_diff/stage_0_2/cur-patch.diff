diff --git a/mrbgems/mruby-bigint/core/bigint.c b/mrbgems/mruby-bigint/core/bigint.c
index dc3022c89..52d6a4157 100644
--- a/mrbgems/mruby-bigint/core/bigint.c
+++ b/mrbgems/mruby-bigint/core/bigint.c
@@ -389 +389,7 @@ ulshift(mrb_state *mrb, mpz_t *c1, mpz_t *a, size_t n)
-    mpz_init(mrb,&c); mpz_realloc(mrb,&c,(size_t)(a->sz + 1));
+    mpz_init(mrb,&c); 
+    if (a->sz + 1 > a->sz) { 
+      mpz_realloc(mrb,&c,(size_t)(a->sz + 1));
+    } else {
+      mpz_clear(mrb,&c);
+      return;
+    }
@@ -395 +401 @@ ulshift(mrb_state *mrb, mpz_t *c1, mpz_t *a, size_t n)
-    c.p[i] = cc;
+    if (i < c.sz) c.p[i] = cc;
@@ -432,0 +439,2 @@ udiv(mrb_state *mrb, mpz_t *qq, mpz_t *rr, mpz_t *xx, mpz_t *yy)
+    /* Early termination if indices would cause overflow */
+    if (j >= x.len || j >= q.len) return;
@@ -436,0 +445,2 @@ udiv(mrb_state *mrb, mpz_t *qq, mpz_t *rr, mpz_t *xx, mpz_t *yy)
+        /* Additional bounds checking for array accesses */
+        if (i+j >= x.len || j+yd >= x.len || j+yd-1 >= x.len) return;
@@ -441,0 +452 @@ udiv(mrb_state *mrb, mpz_t *qq, mpz_t *rr, mpz_t *xx, mpz_t *yy)
+      if (i+j >= x.len) return;
@@ -446,0 +458 @@ udiv(mrb_state *mrb, mpz_t *qq, mpz_t *rr, mpz_t *xx, mpz_t *yy)
+        if (i+j >= x.len) return;
