diff --git a/mrbgems/mruby-bigint/core/bigint.c b/mrbgems/mruby-bigint/core/bigint.c
index dc3022c89..8d1b04ce2 100644
--- a/mrbgems/mruby-bigint/core/bigint.c
+++ b/mrbgems/mruby-bigint/core/bigint.c
@@ -37 +37,2 @@ mpz_realloc(mrb_state *mrb, mpz_t *x, size_t size)
-{
+// FIXME: Crash CWE-787: Out-of-bounds Write
+ {
@@ -38,0 +40 @@ mpz_realloc(mrb_state *mrb, mpz_t *x, size_t size)
+    if (size > 1000000) return; // Prevent excessive allocation that could lead to overflow
@@ -740,3 +742,8 @@ mpz_mul_2exp(mrb_state *mrb, mpz_t *z, mpz_t *x, mrb_int e)
-    mpz_realloc(mrb,&y,x->sz+digs);
-    for (size_t i=0;i<x->sz;i++)
-      y.p[i+digs] = x->p[i];
+    // Ensure sufficient allocation to prevent buffer overflow
+    if (x->sz + digs > x->sz) {
+      mpz_realloc(mrb,&y,x->sz+digs);
+    } else {
+      mpz_realloc(mrb,&y,x->sz+1);
+    }
+    for (size_t i=0;i<x->sz && i+digs < y.alloc;i++) // Check both loop bound and array bound
+       y.p[i+digs] = x->p[i];
