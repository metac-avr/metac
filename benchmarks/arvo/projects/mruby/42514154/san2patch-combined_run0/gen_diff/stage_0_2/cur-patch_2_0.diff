diff --git a/mrbgems/mruby-bigint/core/bigint.c b/mrbgems/mruby-bigint/core/bigint.c
index dc3022c89..be4a8640c 100644
--- a/mrbgems/mruby-bigint/core/bigint.c
+++ b/mrbgems/mruby-bigint/core/bigint.c
@@ -37 +37,2 @@ mpz_realloc(mrb_state *mrb, mpz_t *x, size_t size)
-{
+// FIXME: Crash CWE-416: Use After Free
+ {
@@ -39,2 +40,4 @@ mpz_realloc(mrb_state *mrb, mpz_t *x, size_t size)
-    x->p=(mp_limb*)mrb_realloc(mrb,x->p,size*sizeof(mp_limb));
-    for (size_t i=x->sz; i<size; i++)
+    void* temp = mrb_realloc(mrb, x->p, size * sizeof(mp_limb));
