diff --git a/src/gc.c b/src/gc.c
index e5488dfcc..aa78fd91d 100644
--- a/src/gc.c
+++ b/src/gc.c
@@ -1049,3 +1049,8 @@ incremental_marking_phase(mrb_state *mrb, mrb_gc *gc, size_t limit)
-    gc->gray_list = obj->gcnext;
-    gc_mark_children(mrb, gc, obj);
-    tried_marks += gc_gray_counts(mrb, gc, obj);
+    if (obj != NULL && !is_object_freed(obj)) {  // Ensure object is valid before processing
+      gc->gray_list = obj->gcnext;
+      gc_mark_children(mrb, gc, obj);
+      tried_marks += gc_gray_counts(mrb, gc, obj);
+    } else {
+      if (obj != NULL) gc->gray_list = obj->gcnext;
+      tried_marks++;
+    }
