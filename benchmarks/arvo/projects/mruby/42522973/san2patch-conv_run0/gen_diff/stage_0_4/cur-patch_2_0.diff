diff --git a/src/variable.c b/src/variable.c
index 3088783ec..27d189f8f 100644
--- a/src/variable.c
+++ b/src/variable.c
@@ -266 +266,3 @@ mrb_gc_mark_iv(mrb_state *mrb, struct RObject *obj)
