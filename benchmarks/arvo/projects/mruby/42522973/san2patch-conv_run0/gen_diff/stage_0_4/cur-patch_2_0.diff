diff --git a/src/gc.c b/src/gc.c
index e5488dfcc..0fa944240 100644
--- a/src/gc.c
+++ b/src/gc.c
@@ -1156 +1156,7 @@ incremental_sweep_phase(mrb_state *mrb, mrb_gc *gc, size_t limit)
