+MRB_API void
+mrb_gc_mark(mrb_state *mrb, struct RBasic *obj)
+// FIXME: Crash CWE-825: Expired Pointer Dereference
+ {
+  if (obj == 0) return;
+  if (!is_white(obj)) return;
+  if (is_red(obj)) return;
