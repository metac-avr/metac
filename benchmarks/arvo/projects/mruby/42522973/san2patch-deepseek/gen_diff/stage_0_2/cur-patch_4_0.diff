diff --git a/src/gc.c b/src/gc.c
index e5488dfcc..8c371b153 100644
--- a/src/gc.c
+++ b/src/gc.c
@@ -1158 +1158,10 @@ incremental_sweep_phase(mrb_state *mrb, mrb_gc *gc, size_t limit)
-      mrb_free(mrb, page);
+      /* Keep the page allocated until the next full GC sweep. This acts as a
+         post-sweep barrier: the mark phase can still traverse the page safely
+         because the memory has not been returned to the allocator yet. */
+      if (!full) {
+        mrb_free(mrb, page);
+      }
+      else {
+        page->next = NULL;
+        page->freelist = NULL;
+      }
