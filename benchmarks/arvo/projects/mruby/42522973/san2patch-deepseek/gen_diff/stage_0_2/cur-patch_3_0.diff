diff --git a/src/gc.c b/src/gc.c
index e5488dfcc..0b8843742 100644
--- a/src/gc.c
+++ b/src/gc.c
@@ -1158 +1158,7 @@ incremental_sweep_phase(mrb_state *mrb, mrb_gc *gc, size_t limit)
-      mrb_free(mrb, page);
+      /* Defer actual reclamation when a full GC is in progress. The page is
+         unlinked from all GC lists so it cannot be reached by future sweeps,
+         but its memory is kept alive until the next full GC sweep. This
+         prevents the mark phase from dereferencing a freed heap region. */
+      if (!full) {
+        mrb_free(mrb, page);
+      }
