diff --git a/src/gc.c b/src/gc.c
index e5488dfcc..81cd44198 100644
--- a/src/gc.c
+++ b/src/gc.c
@@ -643 +643 @@ gc_mark_children(mrb_state *mrb, mrb_gc *gc, struct RBasic *obj)
-    {
+{
@@ -646,2 +646,6 @@ gc_mark_children(mrb_state *mrb, mrb_gc *gc, struct RBasic *obj)
-      mrb_gc_mark_mt(mrb, c);
-      mrb_gc_mark(mrb, (struct RBasic*)c->super);
+      if (is_alive(gc, (struct RBasic*)c)) {
+        mrb_gc_mark_mt(mrb, c);
+        if (c->super && is_alive(gc, (struct RBasic*)c->super)) {
+          mrb_gc_mark(mrb, (struct RBasic*)c->super);
+        }
+      }
@@ -653 +657,3 @@ gc_mark_children(mrb_state *mrb, mrb_gc *gc, struct RBasic *obj)
-    mrb_gc_mark_iv(mrb, (struct RObject*)obj);
+    if (is_alive(gc, obj)) {
+      mrb_gc_mark_iv(mrb, (struct RObject*)obj);
+    }
@@ -660,2 +666,8 @@ gc_mark_children(mrb_state *mrb, mrb_gc *gc, struct RBasic *obj)
-      mrb_gc_mark(mrb, (struct RBasic*)p->upper);
-      mrb_gc_mark(mrb, (struct RBasic*)p->e.env);
+      if (is_alive(gc, (struct RBasic*)p)) {
+        if (p->upper && is_alive(gc, (struct RBasic*)p->upper)) {
+          mrb_gc_mark(mrb, (struct RBasic*)p->upper);
+        }
+        if (p->e.env && is_alive(gc, (struct RBasic*)p->e.env)) {
+          mrb_gc_mark(mrb, (struct RBasic*)p->e.env);
+        }
+      }
@@ -1049,3 +1061,7 @@ incremental_marking_phase(mrb_state *mrb, mrb_gc *gc, size_t limit)
-    gc->gray_list = obj->gcnext;
-    gc_mark_children(mrb, gc, obj);
-    tried_marks += gc_gray_counts(mrb, gc, obj);
+    if (obj->tt != MRB_TT_FREE) {  // Check if object is not freed
+      gc->gray_list = obj->gcnext;
+      gc_mark_children(mrb, gc, obj);
+      tried_marks += gc_gray_counts(mrb, gc, obj);
+    } else {
+      gc->gray_list = obj->gcnext;  // Skip freed objects
+    }
