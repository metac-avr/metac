diff --git a/src/gc.c b/src/gc.c
index e5488dfcc..ce490dd96 100644
--- a/src/gc.c
+++ b/src/gc.c
@@ -1205 +1205 @@ incremental_gc(mrb_state *mrb, mrb_gc *gc, size_t limit)
-    /* unknown state */
+/* unknown state */
@@ -1214,3 +1214,8 @@ incremental_gc_finish(mrb_state *mrb, mrb_gc *gc)
-  do {
-    incremental_gc(mrb, gc, SIZE_MAX);
-  } while (gc->state != MRB_GC_STATE_ROOT);
+  while (gc->state != MRB_GC_STATE_ROOT) {
+    if (gc->state == MRB_GC_STATE_SWEEP) {
+      size_t swept = incremental_sweep_phase(mrb, gc, SIZE_MAX);
+      if (swept == 0) break;
+    } else {
+      incremental_gc(mrb, gc, SIZE_MAX);
+    }
+  }
