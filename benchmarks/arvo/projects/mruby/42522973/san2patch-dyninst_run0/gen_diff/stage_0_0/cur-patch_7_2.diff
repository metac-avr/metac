diff --git a/src/gc.c b/src/gc.c
index e5488dfcc..e3b7d9f0e 100644
--- a/src/gc.c
+++ b/src/gc.c
@@ -1158 +1158,3 @@ incremental_sweep_phase(mrb_state *mrb, mrb_gc *gc, size_t limit)
-      mrb_free(mrb, page);
