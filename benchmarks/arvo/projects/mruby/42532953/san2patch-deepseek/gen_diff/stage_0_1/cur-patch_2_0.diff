diff --git a/src/string.c b/src/string.c
index e214ad4c2..5e0c01c7a 100644
--- a/src/string.c
+++ b/src/string.c
@@ -670,0 +671,14 @@ mrb_memsearch(const char *x, mrb_int m, const char *y, mrb_int n)
+  if (m == 2 || m == 3) {
+    const char *p = y;
+    const char *end = y + n - m + 1;
+    while (p < end) {
+      if (m == 2) {
+        if (p[0] == x[0] && p[1] == x[1]) return (mrb_int)(p - y);
+      }
+      else {
+        if (p[0] == x[0] && p[1] == x[1] && p[2] == x[2]) return (mrb_int)(p - y);
+      }
+      p++;
+    }
+    return -1;
+  }
