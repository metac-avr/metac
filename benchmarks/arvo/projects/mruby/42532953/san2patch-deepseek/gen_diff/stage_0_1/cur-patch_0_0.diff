diff --git a/src/string.c b/src/string.c
index e214ad4c2..92e9a4a54 100644
--- a/src/string.c
+++ b/src/string.c
@@ -670,0 +671,18 @@ mrb_memsearch(const char *x, mrb_int m, const char *y, mrb_int n)
+  if (m == 2) {
+    const char *p = y;
+    const char *end = y + n - 1;
+    while (p < end) {
+      if (p[0] == x[0] && p[1] == x[1]) return (mrb_int)(p - y);
+      p++;
+    }
+    return -1;
+  }
+  if (m == 3) {
+    const char *p = y;
+    const char *end = y + n - 2;
+    while (p < end) {
+      if (p[0] == x[0] && p[1] == x[1] && p[2] == x[2]) return (mrb_int)(p - y);
+      p++;
+    }
+    return -1;
+  }
