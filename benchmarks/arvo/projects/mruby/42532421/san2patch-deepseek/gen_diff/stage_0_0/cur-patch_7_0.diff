diff --git a/src/string.c b/src/string.c
index 3642dfbe6..6ad5e48de 100644
--- a/src/string.c
+++ b/src/string.c
@@ -773,0 +774,3 @@ str_index_str(mrb_state *mrb, mrb_value str, mrb_value str2, mrb_int offset)
+  mrb_int hlen;
+  const char *haystack;
+  mrb_int i;
@@ -776,0 +780,16 @@ str_index_str(mrb_state *mrb, mrb_value str, mrb_value str2, mrb_int offset)
+  haystack = RSTRING_PTR(str);
+  hlen = RSTRING_LEN(str);
+
+  if (offset < 0) {
+    offset += hlen;
+    if (offset < 0) offset = 0;
+  }
+  if (len == 0) return offset <= hlen ? offset : -1;
+  if (offset + len > hlen) return -1;
+
+  if (len < (mrb_int)sizeof(uint64_t) || hlen - offset - len + 1 < (mrb_int)sizeof(uint64_t)) {
+    for (i = offset; i <= hlen - len; i++) {
+      if (memcmp(haystack + i, ptr, len) == 0) return i;
+    }
+    return -1;
+  }
