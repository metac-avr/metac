diff --git a/src/string.c b/src/string.c
index 3642dfbe6..aa1f64865 100644
--- a/src/string.c
+++ b/src/string.c
@@ -70 +70 @@ str_init_normal(mrb_state *mrb, struct RString *s, const char *p, mrb_int len)
