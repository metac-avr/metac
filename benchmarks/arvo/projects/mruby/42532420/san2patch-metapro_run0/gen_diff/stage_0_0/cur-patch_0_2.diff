--- a/src/string.c
+++ b/src/string.c
@@ -661,0 +662,11 @@ mrb_memsearch(const char *x0, mrb_int m, const char *y0, mrb_int n)
+  /* Add boundary check before calling mrb_memsearch_ss */
+  if (n < 8 || m < 8) {
+    /* Fall back to byte-by-byte comparison for small buffers */
+    mrb_int i;
+    for (i = 0; i <= n - m; i++) {
+      if (memcmp(y0 + i, x0, m) == 0) {
+        return i;
+      }
+    }
+    return -1;
+  }
