diff --git a/src/string.c b/src/string.c
index 3642dfbe6..b1aa1aea5 100644
--- a/src/string.c
+++ b/src/string.c
@@ -662 +662,10 @@ mrb_memsearch(const char *x0, mrb_int m, const char *y0, mrb_int n)
-  return mrb_memsearch_ss((const unsigned char*)x0, m, (const unsigned char*)y0, n);
+  // Validate buffer boundaries before 8-byte operations
+  if (n >= m + 7) {
+    return mrb_memsearch_ss((const unsigned char*)x0, m, (const unsigned char*)y0, n);
+  } else {
+    // Use safe byte-by-byte search for boundary cases
+    for (mrb_int i = 0; i <= n - m; i++) {
+      if (memcmp(y0 + i, x0, m) == 0) return i;
+    }
+    return -1;
+  }
