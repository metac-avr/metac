-        end = mrb_memsearch(RSTRING_PTR(spat), pat_len, RSTRING_PTR(str)+idx, str_len - idx);
-        if (end < 0) break;
+  if (argc == 2) {
+    lim_p = TRUE;
+    lim = mrb_integer(mrb_to_integer(mrb, argv[1]));
+    if (lim < 0) {
+      lim = 0;
+    }
+  }
+  if (argc == 0 || mrb_nil_p(spat)) {
+    type = split_type_default;
+  }
+  else if (mrb_string_p(spat) && RSTRING_LEN(spat) == 0) {
+    type = split_type_chars;
+  }
+  else {
+    type = split_type_string;
+    spat = mrb_to_str(mrb, spat);
+  }
+
+  switch (type) {
+    case split_type_default:
+      {
+        mrb_int idx = 0;
+        mrb_int str_len = RSTRING_LEN(str);
+        int ai = mrb_gc_arena_save(mrb);
+
+        while (idx < str_len) {
+          mrb_int tmp;
+          char *ptr = RSTRING_PTR(str);
+
+          while (idx < str_len && ISSPACE(ptr[idx])) idx++;
+          if (idx == str_len) break;
+          beg = idx;
+          while (idx < str_len && !ISSPACE(ptr[idx])) idx++;
+          end = idx;
+          mrb_ary_push(mrb, result, mrb_str_byte_subseq(mrb, str, beg, end-beg));
+          mrb_gc_arena_restore(mrb, ai);
+          if (lim_p && lim <= ++i) break;
+        }
@@ -2358,2 +2403,15 @@ mrb_str_split_m(mrb_state *mrb, mrb_value str)
-      else {
-        end = chars2bytes(str, idx, 1);
+      break;
+
+    case split_type_chars:
+      {
+        mrb_int idx = 0;
+        mrb_int str_len = RSTRING_LEN(str);
+        int ai = mrb_gc_arena_save(mrb);
+
+        while (idx < str_len) {
+          mrb_int clen = chars2bytes(str, idx, 1);
+          mrb_ary_push(mrb, result, mrb_str_byte_subseq(mrb, str, idx, clen));
+          mrb_gc_arena_restore(mrb, ai);
+          idx += clen;
+          if (lim_p && lim <= ++i) break;
+        }
@@ -2361,6 +2419,26 @@ mrb_str_split_m(mrb_state *mrb, mrb_value str)
-      mrb_ary_push(mrb, result, mrb_str_byte_subseq(mrb, str, idx, end));
-      mrb_gc_arena_restore(mrb, ai);
