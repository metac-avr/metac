+          return STR_OUT_OF_RANGE;
+        default:
+          break;
+      }
@@ -1228,0 +1231,2 @@ str_convert_range(mrb_state *mrb, mrb_value str, mrb_value indx, mrb_value alen,
+  return STR_OUT_OF_RANGE;
+}
@@ -2347,5 +2351,12 @@ mrb_str_split_m(mrb_state *mrb, mrb_value str)
-  else {                        /* split_type == string */
-    mrb_int str_len = RSTRING_LEN(str);
-    mrb_int pat_len = RSTRING_LEN(spat);
-    mrb_int idx = 0;
-    int ai = mrb_gc_arena_save(mrb);
+  static mrb_value
+mrb_str_split_m(mrb_state *mrb, mrb_value str)
+{
+  mrb_value spat = mrb_nil_value();
+  mrb_int argc = mrb_get_args(mrb, "|o", &spat);
+  mrb_value result = mrb_ary_new(mrb);
+  mrb_int i = 0;
+  mrb_int beg = 0;
+  mrb_int end = 0;
+  mrb_int lim = 0;
+  mrb_bool lim_p = FALSE;
+  enum split_type type = split_type_normal;
@@ -2353,4 +2364,38 @@ mrb_str_split_m(mrb_state *mrb, mrb_value str)
-    while (idx < str_len) {
