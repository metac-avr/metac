diff --git a/src/gc.c b/src/gc.c
index f1b50ad78..520911453 100644
--- a/src/gc.c
+++ b/src/gc.c
@@ -1203,4 +1203,9 @@ incremental_sweep_phase(mrb_state *mrb, mrb_gc *gc, size_t limit)
