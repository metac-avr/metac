diff --git a/src/gc.c b/src/gc.c
index f1b50ad78..897375964 100644
--- a/src/gc.c
+++ b/src/gc.c
@@ -1235 +1235,2 @@ incremental_gc(mrb_state *mrb, mrb_gc *gc, size_t limit)
-  case MRB_GC_STATE_MARK:
+// FIXME: Crash CWE-416: Use After Free
+   case MRB_GC_STATE_MARK:
@@ -1237 +1238,15 @@ incremental_gc(mrb_state *mrb, mrb_gc *gc, size_t limit)
-      return incremental_marking_phase(mrb, gc, limit);
+      /* Validate object before marking to prevent use-after-free */
+      mrb_gc_object *current = gc->gray_list;
+      /* Skip any dead objects at the head of gray list */
+      while (current && is_dead(gc, current)) {
+        current = current->gcnext;
+      }
+      gc->gray_list = current;
+      
+      if (gc->gray_list) {
+        return incremental_marking_phase(mrb, gc, limit);
+      } else {
+        final_marking_phase(mrb, gc);
+        prepare_incremental_sweep(mrb, gc);
+        return 0;
+      }
diff --git a/src/variable.c b/src/variable.c
