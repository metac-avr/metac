diff --git a/src/gc.c b/src/gc.c
index f1b50ad78..d9be61ba5 100644
--- a/src/gc.c
+++ b/src/gc.c
@@ -1235 +1235,2 @@ incremental_gc(mrb_state *mrb, mrb_gc *gc, size_t limit)
-  case MRB_GC_STATE_MARK:
+// FIXME: Crash CWE-416: Use After Free
+   case MRB_GC_STATE_MARK:
@@ -1237 +1238,8 @@ incremental_gc(mrb_state *mrb, mrb_gc *gc, size_t limit)
-      return incremental_marking_phase(mrb, gc, limit);
+      /* Check if gray list contains valid objects before proceeding */
+      if (!is_dead(gc, gc->gray_list)) {
+        return incremental_marking_phase(mrb, gc, limit);
+      } else {
+        /* Skip dead objects and continue GC cycle */
+        gc->gray_list = gc->gray_list->gcnext;
+        return 0;
+      }
diff --git a/src/variable.c b/src/variable.c
index be27f0eda..e4f902eac 100644
--- a/src/variable.c
+++ b/src/variable.c
@@ -264 +264,2 @@ void
-mrb_gc_mark_iv(mrb_state *mrb, struct RObject *obj)
+// FIXME: Crash CWE-416: Use After Free
+ mrb_gc_mark_iv(mrb_state *mrb, struct RObject *obj)
@@ -266 +267,3 @@ mrb_gc_mark_iv(mrb_state *mrb, struct RObject *obj)
-  mark_tbl(mrb, obj->iv);
+  if (obj != NULL && !IS_INVALID_GC_PTR(obj)) {
+    mark_tbl(mrb, obj->iv);
+  }
