diff --git a/src/gc.c b/src/gc.c
index f1b50ad78..5b2eea105 100644
--- a/src/gc.c
+++ b/src/gc.c
@@ -779 +778,0 @@ gc_mark_children(mrb_state *mrb, mrb_gc *gc, struct RBasic *obj)
-
@@ -787 +786,2 @@ mrb_gc_mark(mrb_state *mrb, struct RBasic *obj)
-{
+// FIXME: Crash CWE-825: Expired Pointer Dereference
+ {
@@ -790,0 +791 @@ mrb_gc_mark(mrb_state *mrb, struct RBasic *obj)
+  if (mrb->gc.sweeping) return; /* Skip marking if GC is in sweeping phase */
@@ -1203,3 +1204,9 @@ incremental_sweep_phase(mrb_state *mrb, mrb_gc *gc, size_t limit)
-      unlink_heap_page(gc, page);
-      unlink_free_heap_page(gc, page);
-      mrb_free(mrb, page);
+      /* Check if we're in the middle of marking before freeing */
+      if (!(gc->majorgc || gc->state == GC_STATE_SWEEP)) {
+        unlink_heap_page(gc, page);
+        unlink_free_heap_page(gc, page);
+        mrb_free(mrb, page);
+      } else {
+        /* Postpone freeing until after marking is complete */
+        page->free_postponed = TRUE;
+      }
