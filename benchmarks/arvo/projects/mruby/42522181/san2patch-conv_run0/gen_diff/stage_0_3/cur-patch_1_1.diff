diff --git a/src/gc.c b/src/gc.c
index f1b50ad78..4e75df7aa 100644
--- a/src/gc.c
+++ b/src/gc.c
@@ -1097,2 +1097,4 @@ incremental_marking_phase(mrb_state *mrb, mrb_gc *gc, size_t limit)
-    gc_mark_children(mrb, gc, obj);
-    tried_marks += gc_gray_counts(mrb, gc, obj);
+    if (!is_dead(gc, obj)) {  // Add validation check before marking
+      gc_mark_children(mrb, gc, obj);
+      tried_marks += gc_gray_counts(mrb, gc, obj);
+    }
@@ -1203,3 +1205,6 @@ incremental_sweep_phase(mrb_state *mrb, mrb_gc *gc, size_t limit)
-      unlink_heap_page(gc, page);
-      unlink_free_heap_page(gc, page);
-      mrb_free(mrb, page);
+      /* Prevent premature deallocation during concurrent marking */
+      if (gc->state != MRB_GC_STATE_MARK) {
+        unlink_heap_page(gc, page);
+        unlink_free_heap_page(gc, page);
+        mrb_free(mrb, page);
+      }
