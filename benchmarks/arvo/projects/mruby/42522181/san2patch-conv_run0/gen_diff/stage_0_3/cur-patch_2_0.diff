diff --git a/src/gc.c b/src/gc.c
index f1b50ad78..b2d81e70e 100644
--- a/src/gc.c
+++ b/src/gc.c
@@ -1096,3 +1096,8 @@ incremental_marking_phase(mrb_state *mrb, mrb_gc *gc, size_t limit)
-    gc->gray_list = obj->gcnext;
-    gc_mark_children(mrb, gc, obj);
-    tried_marks += gc_gray_counts(mrb, gc, obj);
+    // Validate object before accessing it
+    if (obj && !is_object_freed(obj)) {
+      gc->gray_list = obj->gcnext;
+      gc_mark_children(mrb, gc, obj);
+      tried_marks += gc_gray_counts(mrb, gc, obj);
+    } else {
+      gc->gray_list = obj ? obj->gcnext : NULL;  // Safely advance the list
+    }
@@ -1203,3 +1208,6 @@ incremental_sweep_phase(mrb_state *mrb, mrb_gc *gc, size_t limit)
-      unlink_heap_page(gc, page);
-      unlink_free_heap_page(gc, page);
-      mrb_free(mrb, page);
+      /* Synchronize with marking phase to avoid use-after-free */
+      if (!gc->mark_func_active) {
+        unlink_heap_page(gc, page);
+        unlink_free_heap_page(gc, page);
+        mrb_free(mrb, page);
+      }
