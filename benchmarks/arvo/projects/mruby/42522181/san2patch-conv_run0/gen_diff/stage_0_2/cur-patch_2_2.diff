+  static void
+obj_free(mrb_state *mrb, struct RBasic *obj, int end)
+{
+  DEBUG(fprintf(stderr, "obj_free(%p,tt=%d)\n",obj,obj->tt));
+  switch (obj->tt) {
+
+  case MRB_TT_OBJECT:
+    if (!end) mrb_obj_iv_tbl_free(mrb, (struct RObject*)obj);
+    break;
+
+  case MRB_TT_CLASS:
+  case MRB_TT_MODULE:
+  case MRB_TT_ICLASS:
+  case MRB_TT_SCLASS:
+    if (!end) mrb_gc_free_mt(mrb, (struct RClass*)obj);
+    if (!end) mrb_obj_iv_tbl_free(mrb, (struct RObject*)obj);
+    if (((struct RClass*)obj)->super != NULL) {
+      ((struct RClass*)obj)->super = NULL;
@@ -1177,18 +1171,8 @@ incremental_sweep_phase(mrb_state *mrb, mrb_gc *gc, size_t limit)
-    while (p<e) {
-      if (is_dead(gc, &p->as.basic)) {
