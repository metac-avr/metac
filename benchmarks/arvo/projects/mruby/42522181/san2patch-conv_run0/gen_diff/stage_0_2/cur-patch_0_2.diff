diff --git a/src/gc.c b/src/gc.c
index f1b50ad78..74bd33da1 100644
--- a/src/gc.c
+++ b/src/gc.c
@@ -779,16 +778,0 @@ gc_mark_children(mrb_state *mrb, mrb_gc *gc, struct RBasic *obj)
-
-  default:
-    break;
-  }
-}
-
-MRB_API void
-mrb_gc_mark(mrb_state *mrb, struct RBasic *obj)
-{
-  if (obj == 0) return;
-  if (!is_white(obj)) return;
-  if (is_red(obj)) return;
-  mrb_assert((obj)->tt != MRB_TT_FREE);
-  add_gray_list(mrb, &mrb->gc, obj);
-}
-
@@ -799,0 +784 @@ obj_free(mrb_state *mrb, struct RBasic *obj, int end)
+
@@ -803,0 +789,72 @@ obj_free(mrb_state *mrb, struct RBasic *obj, int end)
+  case MRB_TT_CLASS:
+  case MRB_TT_MODULE:
+  case MRB_TT_SCLASS:
+    mrb_gc_free_mt(mrb, (struct RClass*)obj);
+    mrb_gc_free_iv(mrb, (struct RObject*)obj);
+    if (!end && MRB_FL_TEST(obj, MRB_FL_CLASS_IS_INHERITED)) {
+      MRB_SET_ENV_FLAG(mrb->global_constants, MRB_GC_RED);
+    }
+    break;
+
+  case MRB_TT_ICLASS:
+    /* no freeing resource */
+    break;
+
+  case MRB_TT_ENV:
+    mrb_gc_free_env(mrb, (struct REnv*)obj);
+    break;
+
+  case MRB_TT_FIBER: {
+    struct mrb_context *c = ((struct RFiber*)obj)->cxt;
+    if (c && c->status != MRB_FIBER_TERMINATED) {
+      mrb_callinfo *ci = c->ci;
+      mrb_callinfo *ce = c->cibase;
+
+      while (ci >= ce) {
+        mrb_gc_free_callinfo(mrb, ci);
+        ci--;
+      }
+    }
+    if (!end && c->status != MRB_FIBER_TERMINATED) {
+      MRB_SET_ENV_FLAG(mrb->global_constants, MRB_GC_RED);
+    }
+    mrb_free(mrb, c);
+    }
+    break;
+
+  case MRB_TT_PROC:
+    mrb_gc_free_iv(mrb, (struct RProc*)obj);
+    break;
+
+  case MRB_TT_ARRAY:
+    if (ARY_SHARED_P(obj))
+      mrb_ary_decref(mrb, ((struct RArray*)obj)->aux.shared);
+    break;
+
+  case MRB_TT_HASH:
+    mrb_gc_free_hash(mrb, (struct RHash*)obj);
+    break;
+
+  case MRB_TT_STRING:
+    mrb_gc_free_str(mrb, (struct RString*)obj);
+    break;
+
+  case MRB_TT_RANGE:
+    mrb_gc_free_range(mrb, (struct RRange*)obj);
+    break;
+
+  case MRB_TT_EXCEPTION:
+    mrb_gc_free_iv(mrb, (struct RException*)obj);
+    break;
+
+  case MRB_TT_CDATA:
+    mrb_gc_free_iv(mrb, (struct RData*)obj);
+    break;
+
+  default:
+    break;
+  }
+}  case MRB_TT_OBJECT:
+    mrb_gc_free_iv(mrb, (struct RObject*)obj);
+    break;
+
@@ -1165,34 +1221,0 @@ incremental_sweep_phase(mrb_state *mrb, mrb_gc *gc, size_t limit)
-  while (page && (tried_sweep < limit)) {
-    RVALUE *p = objects(page);
-    RVALUE *e = p + MRB_HEAP_PAGE_SIZE;
-    size_t freed = 0;
-    mrb_bool dead_slot = TRUE;
-    mrb_bool full = (page->freelist == NULL);
-
-    if (is_minor_gc(gc) && page->old) {
-      /* skip a slot which doesn't contain any young object */
-      p = e;
-      dead_slot = FALSE;
-    }
-    while (p<e) {
-      if (is_dead(gc, &p->as.basic)) {
-        if (p->as.basic.tt != MRB_TT_FREE) {
-          obj_free(mrb, &p->as.basic, FALSE);
-          if (p->as.basic.tt == MRB_TT_FREE) {
-            p->as.free.next = page->freelist;
-            page->freelist = (struct RBasic*)p;
-            freed++;
-          }
-          else {
-            dead_slot = FALSE;
-          }
-        }
-      }
-      else {
-        if (!is_generational(gc))
-          paint_partial_white(gc, &p->as.basic); /* next gc target */
-        dead_slot = FALSE;
-      }
-      p++;
-    }
-
@@ -1200,2 +1223,2 @@ incremental_sweep_phase(mrb_state *mrb, mrb_gc *gc, size_t limit)
-    if (dead_slot && freed < MRB_HEAP_PAGE_SIZE) {
-      mrb_heap_page *next = page->next;
+  if (dead_slot && freed < MRB_HEAP_PAGE_SIZE) {
+    mrb_heap_page *next = page->next;
@@ -1203,18 +1226,4 @@ incremental_sweep_phase(mrb_state *mrb, mrb_gc *gc, size_t limit)
-      unlink_heap_page(gc, page);
-      unlink_free_heap_page(gc, page);
-      mrb_free(mrb, page);
-      page = next;
-    }
-    else {
-      if (full && freed > 0) {
-        link_free_heap_page(gc, page);
-      }
-      if (page->freelist == NULL && is_minor_gc(gc))
-        page->old = TRUE;
-      else
-        page->old = FALSE;
-      page = page->next;
-    }
-    tried_sweep += MRB_HEAP_PAGE_SIZE;
-    gc->live -= freed;
-    gc->live_after_mark -= freed;
+    unlink_heap_page(gc, page);
+    unlink_free_heap_page(gc, page);
+    mrb_free(mrb, page);
+    page = next;
