+  if (!mrb_nil_p(v) && mrb_immediate_p(v) == 0) {
+    struct RBasic *obj = (struct RBasic*)mrb_ptr(v);
+    if (!(obj->tt == MRB_TT_FREE)) {
+      mrb_gc_mark_value(mrb, v);
@@ -1244,11 +1237,2 @@ incremental_gc(mrb_state *mrb, mrb_gc *gc, size_t limit)
