diff --git a/src/gc.c b/src/gc.c
index f1b50ad78..3934198d1 100644
--- a/src/gc.c
+++ b/src/gc.c
@@ -1229,14 +1229,7 @@ incremental_gc(mrb_state *mrb, mrb_gc *gc, size_t limit)
-  switch (gc->state) {
-  case MRB_GC_STATE_ROOT:
-    root_scan_phase(mrb, gc);
-    gc->state = MRB_GC_STATE_MARK;
-    flip_white_part(gc);
-    return 0;
-  case MRB_GC_STATE_MARK:
-    if (gc->gray_list) {
-      return incremental_marking_phase(mrb, gc, limit);
