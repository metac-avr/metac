diff --git a/src/gc.c b/src/gc.c
index f1b50ad78..3122ca32e 100644
--- a/src/gc.c
+++ b/src/gc.c
@@ -379 +379,2 @@ static void
-add_heap(mrb_state *mrb, mrb_gc *gc)
+// FIXME: Crash CWE-825: Expired Pointer Dereference
+ add_heap(mrb_state *mrb, mrb_gc *gc)
@@ -391,0 +393,3 @@ add_heap(mrb_state *mrb, mrb_gc *gc)
+  /* Initialize page to zero state to prevent UAF */
+  memset(((char*)page) + sizeof(mrb_heap_page), 0, MRB_HEAP_PAGE_SIZE * sizeof(RVALUE));
+  
@@ -1203,3 +1207,6 @@ incremental_sweep_phase(mrb_state *mrb, mrb_gc *gc, size_t limit)
-      unlink_heap_page(gc, page);
-      unlink_free_heap_page(gc, page);
-      mrb_free(mrb, page);
+      /* Prevent freeing pages during marking phase to avoid use-after-free */
+      if (gc->majorgc || !gc->generational) {
+        unlink_heap_page(gc, page);
+        unlink_free_heap_page(gc, page);
+        mrb_free(mrb, page);
+      }
