diff --git a/src/gc.c b/src/gc.c
index f1b50ad78..0ef9e1607 100644
--- a/src/gc.c
+++ b/src/gc.c
@@ -1245,5 +1245,9 @@ incremental_gc(mrb_state *mrb, mrb_gc *gc, size_t limit)
-     size_t tried_sweep = 0;
-     tried_sweep = incremental_sweep_phase(mrb, gc, limit);
-     if (tried_sweep == 0)
-       gc->state = MRB_GC_STATE_ROOT;
-     return tried_sweep;
+    size_t tried_sweep = 0;
+    /* Ensure no marking occurs during sweep phase to prevent use-after-free */
+    if (gc->marking) {
+      gc->marking = 0;
+    }
+    tried_sweep = incremental_sweep_phase(mrb, gc, limit);
+    if (tried_sweep == 0)
+      gc->state = MRB_GC_STATE_ROOT;
+    return tried_sweep;
