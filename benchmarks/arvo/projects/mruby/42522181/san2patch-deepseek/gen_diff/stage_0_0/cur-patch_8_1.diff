diff --git a/src/gc.c b/src/gc.c
index f1b50ad78..396568a62 100644
--- a/src/gc.c
+++ b/src/gc.c
@@ -778,0 +779,95 @@ gc_mark_children(mrb_state *mrb, mrb_gc *gc, struct RBasic *obj)
+static void
+obj_free(mrb_state *mrb, struct RBasic *obj, int end)
+{
+  DEBUG(fprintf(stderr, "obj_free(%p,tt=%d)\n",obj,obj->tt));
+  switch (obj->tt) {
+  case MRB_TT_FALSE:
+  case MRB_TT_TRUE:
+  case MRB_TT_FIXNUM:
+  case MRB_TT_SYMBOL:
+  case MRB_TT_UNDEF:
+    break;
+
+  case MRB_TT_FLOAT:
+    break;
+
+  case MRB_TT_OBJECT:
+    mrb_gc_free_gv(mrb, (struct RObject*)obj);
+    break;
+  case MRB_TT_EXCEPTION:
+    mrb_gc_free_exc(mrb, (struct RException*)obj);
+    break;
+
+  case MRB_TT_CLASS:
+    mrb_gc_free_mt(mrb, (struct RClass*)obj);
+    break;
+  case MRB_TT_MODULE:
+  case MRB_TT_SCLASS:
+  case MRB_TT_ICLASS:
+    if (MRB_FLAG_TEST((struct RClass*)obj, MRB_FLAG_IS_ORIGIN)) {
+      mrb_gc_free_mt(mrb, (struct RClass*)obj);
+    }
+    break;
+
+  case MRB_TT_ENV:
+    {
+      mrb_env *e = (mrb_env *)obj;
+      if (e->cxt) {
+        if (!end)
+          e->cxt = NULL;
+        else
+          mrb_env_unshare(mrb, e);
+      }
+    }
+    break;
+
+  case MRB_TT_FIBER:
+    {
+      struct mrb_context *c = ((struct RFiber*)obj)->cxt;
+      if (c) {
+        if (!end && c->status != MRB_FIBER_TERMINATED) {
+          mrb_raise(mrb, E_FIBER_ERROR, "tried to dispose fiber");
+        }
+        if (end) {
+          c->status = MRB_FIBER_TERMINATED;
+        }
+      }
+    }
+    break;
+
+  case MRB_TT_ARRAY:
+    if (end) {
+      mrb_gc_free_ary(mrb, (struct RArray*)obj);
+    }
+    break;
+
+  case MRB_TT_HASH:
+    if (end) {
+      mrb_gc_free_hash(mrb, (struct RHash*)obj);
+    }
+    break;
+
+  case MRB_TT_STRING:
+    if (end) {
+      mrb_gc_free_str(mrb, (struct RString*)obj);
+    }
+    break;
+
+  case MRB_TT_RANGE:
+    if (end) {
+      mrb_gc_free_range(mrb, (struct RRange*)obj);
+    }
+    break;
+
+  case MRB_TT_CDATA:
+    mrb_gc_free_cdata(mrb, (struct RCdata*)obj);
+    break;
+
+  case MRB_TT_PROC:
+    {
+      struct RProc *p = (struct RProc*)obj;
+      if (end) {
+        mrb_gc_free_proc(mrb, p);
+      }
+    }
+    break;
@@ -791,0 +887 @@ mrb_gc_mark(mrb_state *mrb, struct RBasic *obj)
+  if (obj->tt == MRB_TT_FREE) return;
@@ -793,8 +889 @@ mrb_gc_mark(mrb_state *mrb, struct RBasic *obj)
-}
-
-static void
-obj_free(mrb_state *mrb, struct RBasic *obj, int end)
-{
-  DEBUG(fprintf(stderr, "obj_free(%p,tt=%d)\n",obj,obj->tt));
-  switch (obj->tt) {
-  case MRB_TT_OBJECT:
+}  case MRB_TT_OBJECT:
