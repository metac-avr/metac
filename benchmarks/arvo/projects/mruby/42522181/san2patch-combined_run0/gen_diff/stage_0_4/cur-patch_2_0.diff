diff --git a/src/gc.c b/src/gc.c
index f1b50ad78..65d863e18 100644
--- a/src/gc.c
+++ b/src/gc.c
@@ -693,2 +693,6 @@ gc_mark_children(mrb_state *mrb, mrb_gc *gc, struct RBasic *obj)
-      mrb_gc_mark_mt(mrb, c);
-      mrb_gc_mark(mrb, (struct RBasic*)c->super);
+      if (mrb && gc && obj && c) {
+        mrb_gc_mark_mt(mrb, c);
+        if (c->super) {
+          mrb_gc_mark(mrb, (struct RBasic*)c->super);
+        }
+      }
@@ -698 +702,2 @@ gc_mark_children(mrb_state *mrb, mrb_gc *gc, struct RBasic *obj)
-  case MRB_TT_OBJECT:
+// FIXME: Crash CWE-416: Use After Free
+   case MRB_TT_OBJECT:
@@ -700 +705,3 @@ gc_mark_children(mrb_state *mrb, mrb_gc *gc, struct RBasic *obj)
-    mrb_gc_mark_iv(mrb, (struct RObject*)obj);
+    if (mrb && obj) {
+      mrb_gc_mark_iv(mrb, (struct RObject*)obj);
+    }
@@ -707,2 +714,8 @@ gc_mark_children(mrb_state *mrb, mrb_gc *gc, struct RBasic *obj)
-      mrb_gc_mark(mrb, (struct RBasic*)p->upper);
-      mrb_gc_mark(mrb, (struct RBasic*)p->e.env);
+      if (mrb && obj && p) {
+        if (p->upper) {
+          mrb_gc_mark(mrb, (struct RBasic*)p->upper);
+        }
+        if (p->e.env) {
+          mrb_gc_mark(mrb, (struct RBasic*)p->e.env);
+        }
+      }
@@ -1203,3 +1216,6 @@ incremental_sweep_phase(mrb_state *mrb, mrb_gc *gc, size_t limit)
-      unlink_heap_page(gc, page);
-      unlink_free_heap_page(gc, page);
-      mrb_free(mrb, page);
+      /* Synchronize with marking phase to prevent use-after-free */
+      if (!gc->marking) {
+        unlink_heap_page(gc, page);
+        unlink_free_heap_page(gc, page);
+        mrb_free(mrb, page);
+      }
