diff --git a/src/variable.c b/src/variable.c
index be27f0eda..830acbe90 100644
--- a/src/variable.c
+++ b/src/variable.c
@@ -240 +240,3 @@ iv_mark_i(mrb_state *mrb, mrb_sym sym, mrb_value v, void *p)
-  mrb_gc_mark_value(mrb, v);
+  if (!mrb_immediate_p(v) && mrb_ptr(v)) {
+    mrb_gc_mark_value(mrb, v);
+  }
diff --git a/src/gc.c b/src/gc.c
index f1b50ad78..c64681cbb 100644
--- a/src/gc.c
+++ b/src/gc.c
@@ -1203,4 +1203,7 @@ incremental_sweep_phase(mrb_state *mrb, mrb_gc *gc, size_t limit)
-      unlink_heap_page(gc, page);
-      unlink_free_heap_page(gc, page);
-      mrb_free(mrb, page);
-      page = next;
+      /* Validate page pointers before unlinking to prevent expired pointer dereference */
+      if (page && next) {
+        unlink_heap_page(gc, page);
+        unlink_free_heap_page(gc, page);
+        mrb_free(mrb, page);
+        page = next;
+      }
