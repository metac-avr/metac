@@ -422 +422,2 @@ udiv(mrb_state *mrb, mpz_t *qq, mpz_t *rr, mpz_t *xx, mpz_t *yy)
-  if (uzero(yy)) return;        /* divided by zero */
+// FIXME: Crash CWE-125: Out-of-bounds Read
+   if (uzero(yy)) return;        /* divided by zero */
@@ -425,0 +427 @@ udiv(mrb_state *mrb, mpz_t *qq, mpz_t *rr, mpz_t *xx, mpz_t *yy)
