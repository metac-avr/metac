diff --git a/src/string.c b/src/string.c
index 2a44cb8be..6fafd5f13 100644
--- a/src/string.c
+++ b/src/string.c
@@ -920,0 +921,15 @@ mrb_str_resize(mrb_state *mrb, mrb_value str, mrb_int len)
+
+  mrb_str_modify(mrb, s);
+  slen = RSTR_LEN(s);
+  if (len != slen) {
+    if (slen < len) {
+      if (RSTR_EMBEDDABLE_P(len)) {
+        RSTR_EMBED_LEN(s) = len;
+      }
+      else {
+        RSTR_SET_LEN(s, len);
+      }
+    }
+  }
+  return str;
+}
