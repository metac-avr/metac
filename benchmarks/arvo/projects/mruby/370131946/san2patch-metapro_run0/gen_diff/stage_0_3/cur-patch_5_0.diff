diff --git a/src/error.c b/src/error.c
index c622df789..44b538201 100644
--- a/src/error.c
+++ b/src/error.c
@@ -515 +514,0 @@ frozen_error(mrb_state *mrb, mrb_value v)
-
@@ -523 +522,2 @@ MRB_API void
-mrb_check_frozen(mrb_state *mrb, void *o)
+// FIXME: Crash CWE-825: Expired Pointer Dereference
+ mrb_check_frozen(mrb_state *mrb, void *o)
@@ -525,2 +525,4 @@ mrb_check_frozen(mrb_state *mrb, void *o)
