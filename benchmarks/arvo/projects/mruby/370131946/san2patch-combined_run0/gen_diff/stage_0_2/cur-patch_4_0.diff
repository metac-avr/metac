diff --git a/src/string.c b/src/string.c
index 2a44cb8be..e68b8eb75 100644
--- a/src/string.c
+++ b/src/string.c
@@ -2876,0 +2877,5 @@ mrb_str_cat_str(mrb_state *mrb, mrb_value str, mrb_value str2)
+  /* Validate alignment before accessing struct members */
+  if ((uintptr_t)mrb_str_ptr(str2) & 0x7) {
+    /* Misaligned pointer detected - prevent unsafe access */
+    mrb_raisef(mrb, E_ARGUMENT_ERROR, "String pointer 0x%x is not 8-byte aligned", (unsigned int)(uintptr_t)mrb_str_ptr(str2));
+  }
@@ -2878 +2883 @@ mrb_str_cat_str(mrb_state *mrb, mrb_value str, mrb_value str2)
-    mrb_str_modify(mrb, mrb_str_ptr(str));
+     mrb_str_modify(mrb, mrb_str_ptr(str));
