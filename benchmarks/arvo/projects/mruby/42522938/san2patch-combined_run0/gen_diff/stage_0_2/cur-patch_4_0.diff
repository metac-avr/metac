+     break;
diff --git a/src/string.c b/src/string.c
index df83f2c05..ae4abef0b 100644
--- a/src/string.c
+++ b/src/string.c
@@ -212,4 +212,7 @@ str_decref(mrb_state *mrb, mrb_shared_string *shared)
-  shared->refcnt--;
-  if (shared->refcnt == 0) {
-    mrb_free(mrb, shared->ptr);
-    mrb_free(mrb, shared);
+  if (!shared) return;  // Defensive check for null pointer
+  if (shared->refcnt > 0) {  // Validate reference count before decrementing
+    shared->refcnt--;
+    if (shared->refcnt == 0) {
+      mrb_free(mrb, shared->ptr);
+      mrb_free(mrb, shared);
+    }
