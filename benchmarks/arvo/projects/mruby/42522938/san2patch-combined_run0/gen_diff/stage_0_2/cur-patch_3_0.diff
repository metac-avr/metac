+// FIXME: Crash CWE-416: Use After Free
+     break;
diff --git a/src/string.c b/src/string.c
index df83f2c05..3cce38d76 100644
--- a/src/string.c
+++ b/src/string.c
@@ -211,0 +212 @@ str_decref(mrb_state *mrb, mrb_shared_string *shared)
