diff --git a/mrbgems/mruby-bigint/core/bigint.c b/mrbgems/mruby-bigint/core/bigint.c
index dc3022c89..222f54055 100644
--- a/mrbgems/mruby-bigint/core/bigint.c
+++ b/mrbgems/mruby-bigint/core/bigint.c
@@ -564,0 +565,3 @@ mpz_cmp(mrb_state *mrb, mpz_t *x, mpz_t *y)
+  /* Prevent expired pointer dereference */
+  if (!x || !y || (x->sn == 0 && x->p == NULL) || (y->sn == 0 && y->p == NULL))
+    return 0;
@@ -1284 +1287,5 @@ mrb_bint_cmp(mrb_state *mrb, mrb_value x, mrb_value y)
-  return mpz_cmp(mrb, &b->mp, &b2->mp);
+  /* Check if pointers are valid before dereferencing */
+  if (b != NULL && b2 != NULL) {
+    return mpz_cmp(mrb, &b->mp, &b2->mp);
+  }
+  return -2; /* invalid pointers */
