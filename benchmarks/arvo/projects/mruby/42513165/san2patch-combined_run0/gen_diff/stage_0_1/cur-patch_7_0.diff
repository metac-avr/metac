diff --git a/mrbgems/mruby-bigint/core/bigint.c b/mrbgems/mruby-bigint/core/bigint.c
index d51efdf6f..d1f46f778 100644
--- a/mrbgems/mruby-bigint/core/bigint.c
+++ b/mrbgems/mruby-bigint/core/bigint.c
@@ -656,0 +657,5 @@ mpz_init_set_str(mrb_state *mrb, mpz_t *x, const char *s, mrb_int len, mrb_int b
+    /* Prevent resource exhaustion by limiting string length */
+    if (len > 8192) {
+      retval = (-1);
+      break;
+    }
@@ -987,0 +993,7 @@ mrb_bint_new_str(mrb_state *mrb, const char *x, mrb_int len, mrb_int base)
+  // Validate input parameters before allocation
+  if (len < 0 || len > 100000) {  // Reasonable limit for bigint string representation
+    mrb_raise(mrb, E_ARGUMENT_ERROR, "invalid string length");
+  }
+  if (base < 2 || base > 36) {    // Validate base range
+    mrb_raise(mrb, E_ARGUMENT_ERROR, "invalid base");
+  }
