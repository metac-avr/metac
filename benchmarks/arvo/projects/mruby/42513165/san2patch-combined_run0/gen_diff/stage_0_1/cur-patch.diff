diff --git a/mrbgems/mruby-bigint/core/bigint.c b/mrbgems/mruby-bigint/core/bigint.c
index d51efdf6f..324b90a7e 100644
--- a/mrbgems/mruby-bigint/core/bigint.c
+++ b/mrbgems/mruby-bigint/core/bigint.c
@@ -656,0 +657,5 @@ mpz_init_set_str(mrb_state *mrb, mpz_t *x, const char *s, mrb_int len, mrb_int b
+    /* Add bounds checking to prevent excessive memory allocation */
+    if (len > 1024) {
+      retval = (-2);  /* Different error code for size limit exceeded */
+      break;
+    }
@@ -987,0 +993,12 @@ mrb_bint_new_str(mrb_state *mrb, const char *x, mrb_int len, mrb_int base)
+  // Add resource throttling - limit string length and validate inputs
+  const mrb_int MAX_BIGINT_STR_LEN = 100000;  // Maximum allowed string length
+  
+  if (len > MAX_BIGINT_STR_LEN || len <= 0) {
+    mrb_raise(mrb, E_ARGUMENT_ERROR, "bigint string length out of range");
+  }
+  
+  // Additional input validation
+  if (x == NULL) {
+    mrb_raise(mrb, E_ARGUMENT_ERROR, "null string input");
