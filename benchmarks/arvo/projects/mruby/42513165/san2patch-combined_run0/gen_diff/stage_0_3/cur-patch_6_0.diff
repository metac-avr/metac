diff --git a/mrbgems/mruby-bigint/core/bigint.c b/mrbgems/mruby-bigint/core/bigint.c
index d51efdf6f..f242ee2bb 100644
--- a/mrbgems/mruby-bigint/core/bigint.c
+++ b/mrbgems/mruby-bigint/core/bigint.c
@@ -987,0 +988,12 @@ mrb_bint_new_str(mrb_state *mrb, const char *x, mrb_int len, mrb_int base)
+  // Validate input parameters to prevent out-of-bounds read
+  if (x == NULL || len <= 0 || len > 1000000) {  // Reasonable length limit
+    mrb_raise(mrb, E_ARGUMENT_ERROR, "invalid string length");
+    return mrb_nil_value();
+  }
+  
+  // Validate base range
+  if (iabs(base) < 2 || iabs(base) > 36) {
+    mrb_raise(mrb, E_ARGUMENT_ERROR, "invalid base");
+    return mrb_nil_value();
+  }
+  
