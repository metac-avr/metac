diff --git a/mrbgems/mruby-bigint/core/bigint.c b/mrbgems/mruby-bigint/core/bigint.c
index d51efdf6f..868261695 100644
--- a/mrbgems/mruby-bigint/core/bigint.c
+++ b/mrbgems/mruby-bigint/core/bigint.c
@@ -987,0 +988,18 @@ mrb_bint_new_str(mrb_state *mrb, const char *x, mrb_int len, mrb_int base)
+  // Add input validation to prevent out-of-bounds read
+  if (x == NULL) {
+    mrb_raise(mrb, E_ARGUMENT_ERROR, "NULL string input");
+    return mrb_nil_value();
+  }
+  
+  // Check for reasonable string length bounds
+  if (len < 0 || len > 10000000) {  // Prevent extreme lengths
+    mrb_raise(mrb, E_ARGUMENT_ERROR, "string length out of bounds");
+    return mrb_nil_value();
+  }
+  
+  // Ensure base is within valid range before assertion
+  if (iabs(base) < 2 || iabs(base) > 36) {
+    mrb_raise(mrb, E_ARGUMENT_ERROR, "base out of range");
+    return mrb_nil_value();
+  }
+  
