diff --git a/mrbgems/mruby-bigint/core/bigint.c b/mrbgems/mruby-bigint/core/bigint.c
index d51efdf6f..72576a8e0 100644
--- a/mrbgems/mruby-bigint/core/bigint.c
+++ b/mrbgems/mruby-bigint/core/bigint.c
@@ -987,0 +988,14 @@ mrb_bint_new_str(mrb_state *mrb, const char *x, mrb_int len, mrb_int base)
+  // Check for null pointer or invalid length
+  if (x == NULL || len < 0) {
+    struct RBigint *b = MRB_OBJ_ALLOC(mrb, MRB_TT_BIGINT, mrb->integer_class);
+    mpz_init_set_str(mrb, &b->mp, "0", 1, 10);
+    return mrb_obj_value(b);
+  }
+  
+  // Check for empty string
+  if (len == 0) {
+    struct RBigint *b = MRB_OBJ_ALLOC(mrb, MRB_TT_BIGINT, mrb->integer_class);
+    mpz_init_set_str(mrb, &b->mp, "0", 1, 10);
+    return mrb_obj_value(b);
+  }
+  
