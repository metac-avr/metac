diff --git a/src/vm.c b/src/vm.c
index 3c3a5237f..bdb04d3c6 100644
--- a/src/vm.c
+++ b/src/vm.c
@@ -1358 +1358 @@ mrb_vm_exec(mrb_state *mrb, const struct RProc *proc, const mrb_code *pc)
-        {
+         {
@@ -1360 +1360,8 @@ mrb_vm_exec(mrb_state *mrb, const struct RProc *proc, const mrb_code *pc)
-          regs[a] = mrb_bint_new_str(mrb, s+2, (mrb_int)s[0], (mrb_int)s[1]);
+          /* Fix: Add comprehensive validation to prevent integer overflow in memory calculations */
+          mrb_int len1 = (mrb_int)s[0];
+          mrb_int len2 = (mrb_int)s[1];
+          if (len1 > 0 && len2 > 0 && len1 < 65536 && len2 < 65536 && len1 + len2 < 131072) {
+            regs[a] = mrb_bint_new_str(mrb, s+2, len1, len2);
+          } else {
+            goto L_INT_OVERFLOW;
+          }
diff --git a/mrbgems/mruby-bigint/core/bigint.c b/mrbgems/mruby-bigint/core/bigint.c
