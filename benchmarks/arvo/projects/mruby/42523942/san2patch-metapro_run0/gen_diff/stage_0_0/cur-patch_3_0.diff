diff --git a/src/gc.c b/src/gc.c
index 443b778d9..1d979587e 100644
--- a/src/gc.c
+++ b/src/gc.c
@@ -1096,3 +1096,7 @@ incremental_marking_phase(mrb_state *mrb, mrb_gc *gc, size_t limit)
-    gc->gray_list = obj->gcnext;
-    gc_mark_children(mrb, gc, obj);
-    tried_marks += gc_gray_counts(mrb, gc, obj);
+    if (obj->tt != MRB_TT_FREE) {
+      gc->gray_list = obj->gcnext;
+      gc_mark_children(mrb, gc, obj);
