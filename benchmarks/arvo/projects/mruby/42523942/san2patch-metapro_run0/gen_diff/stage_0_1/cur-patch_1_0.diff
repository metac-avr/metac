diff --git a/src/gc.c b/src/gc.c
index 443b778d9..18a7b3d5a 100644
--- a/src/gc.c
+++ b/src/gc.c
@@ -779 +778,0 @@ gc_mark_children(mrb_state *mrb, mrb_gc *gc, struct RBasic *obj)
-
@@ -787 +786,2 @@ mrb_gc_mark(mrb_state *mrb, struct RBasic *obj)
-{
+// FIXME: Crash CWE-825: Expired Pointer Dereference
+ {
@@ -791,0 +792,2 @@ mrb_gc_mark(mrb_state *mrb, struct RBasic *obj)
+  /* Validate object before adding to gray list to prevent use-after-free */
+  if (obj->tt >= MRB_TT_MAX || obj->tt < 0) return;
@@ -799,2 +801 @@ obj_free(mrb_state *mrb, struct RBasic *obj, int end)
-  switch (obj->tt) {
-  case MRB_TT_OBJECT:
+  switch (obj->tt) {  case MRB_TT_OBJECT:
@@ -1203,3 +1204,13 @@ incremental_sweep_phase(mrb_state *mrb, mrb_gc *gc, size_t limit)
-      unlink_heap_page(gc, page);
-      unlink_free_heap_page(gc, page);
-      mrb_free(mrb, page);
+      /* Add safety check to prevent use-after-free during marking */
+      if (!gc->marking) {
+        unlink_heap_page(gc, page);
+        unlink_free_heap_page(gc, page);
+        mrb_free(mrb, page);
+      } else {
+        /* Skip freeing during marking phase to prevent expired pointer dereference */
+        page = next;
+        tried_sweep += MRB_HEAP_PAGE_SIZE;
+        gc->live -= freed;
+        gc->live_after_mark -= freed;
+        continue;
+      }
