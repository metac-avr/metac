@@ -1202,0 +1204,19 @@ incremental_sweep_phase(mrb_state *mrb, mrb_gc *gc, size_t limit)
+      /* Process all objects in page to remove from marking structures */
+      for (int i = 0; i < MRB_HEAP_PAGE_SIZE; i++) {
+        RVALUE *obj = &objects(page)[i];
+        if (obj->as.basic.tt != MRB_TT_FREE) {
+          /* Ensure object is not in gray list */
+          struct RBasic *current = gc->gray_list;
+          struct RBasic **prev = &gc->gray_list;
+          while (current) {
+            if (current == &obj->as.basic) {
+              *prev = current->gcnext;
+              current->gcnext = NULL;
+              break;
+            }
+            prev = &current->gcnext;
+            current = current->gcnext;
+          }
