diff --git a/src/gc.c b/src/gc.c
index 443b778d9..f8a444a9c 100644
--- a/src/gc.c
+++ b/src/gc.c
@@ -779 +778,0 @@ gc_mark_children(mrb_state *mrb, mrb_gc *gc, struct RBasic *obj)
-
@@ -787 +786 @@ mrb_gc_mark(mrb_state *mrb, struct RBasic *obj)
-{
+ {
@@ -791,0 +791,3 @@ mrb_gc_mark(mrb_state *mrb, struct RBasic *obj)
+  
+  // Check if object is already freed to prevent use-after-free
+  if (obj->tt == MRB_TT_FREE) return;
@@ -799,2 +801 @@ obj_free(mrb_state *mrb, struct RBasic *obj, int end)
-  switch (obj->tt) {
-  case MRB_TT_OBJECT:
+  switch (obj->tt) {  case MRB_TT_OBJECT:
@@ -1202,0 +1204,23 @@ incremental_sweep_phase(mrb_state *mrb, mrb_gc *gc, size_t limit)
+      /* Clear references from GC marking queue before freeing */
+      RVALUE *obj = objects(page);
+      RVALUE *end = obj + MRB_HEAP_PAGE_SIZE;
+      while (obj < end) {
+        if (obj->as.basic.tt != MRB_TT_FREE) {
+          /* Remove object from gray list if present */
+          if (gc->gray_list) {
+            struct RBasic **prev = &gc->gray_list;
+            struct RBasic *current = gc->gray_list;
+            while (current) {
+              if (current == &obj->as.basic) {
+                *prev = current->gcnext;
+                current->gcnext = NULL;
+                break;
+              }
+              prev = &current->gcnext;
+              current = current->gcnext;
+            }
+          }
+        }
+        obj++;
+      }
+
