diff --git a/src/gc.c b/src/gc.c
index 443b778d9..209472216 100644
--- a/src/gc.c
+++ b/src/gc.c
@@ -779 +778,0 @@ gc_mark_children(mrb_state *mrb, mrb_gc *gc, struct RBasic *obj)
-
@@ -790,0 +790 @@ mrb_gc_mark(mrb_state *mrb, struct RBasic *obj)
+  if (mrb->gc.state == GC_STATE_SWEEP) return;
@@ -799,2 +799 @@ obj_free(mrb_state *mrb, struct RBasic *obj, int end)
-  switch (obj->tt) {
-  case MRB_TT_OBJECT:
+  switch (obj->tt) {  case MRB_TT_OBJECT:
@@ -1244 +1243,2 @@ incremental_gc(mrb_state *mrb, mrb_gc *gc, size_t limit)
-  case MRB_GC_STATE_SWEEP: {
+// FIXME: Crash CWE-825: Expired Pointer Dereference
+   case MRB_GC_STATE_SWEEP: {
@@ -1246 +1246,7 @@ incremental_gc(mrb_state *mrb, mrb_gc *gc, size_t limit)
-     tried_sweep = incremental_sweep_phase(mrb, gc, limit);
+     /* Process any remaining marks before sweeping to avoid dangling pointers */
+     while (gc->gray_list && tried_sweep < limit/2) {
+       mrb_gc_mark(mrb, (struct RBasic*)gc->gray_list->data);
+       gc->gray_list = gc->gray_list->next;
+       tried_sweep++;
+     }
+     tried_sweep += incremental_sweep_phase(mrb, gc, limit - tried_sweep);
