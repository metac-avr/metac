diff --git a/mrbgems/mruby-bigint/core/bigint.c b/mrbgems/mruby-bigint/core/bigint.c
index d51efdf6f..ce9e05d23 100644
--- a/mrbgems/mruby-bigint/core/bigint.c
+++ b/mrbgems/mruby-bigint/core/bigint.c
@@ -500,4 +500,22 @@ udiv(mrb_state *mrb, mpz_t *qq, mpz_t *rr, mpz_t *xx, mpz_t *yy)
-    if (j%2)
-      q.p[j/2] |= qhat << HALFDIGITBITS;
-    else
-      q.p[j/2] |= qhat;
+    if (j%2) {
+      // Add overflow protection for shift operation
+      uint32_t shifted_qhat = 0;
+      if (qhat <= (UINT32_MAX >> HALFDIGITBITS)) {
+        shifted_qhat = qhat << HALFDIGITBITS;
+      } else {
+        // Truncate overflow instead of wrapping
+        shifted_qhat = (qhat & ((1U << HALFDIGITBITS) - 1)) << HALFDIGITBITS;
+      }
+      if (q.p && j/2 < q.sz) {
+        if (q.p[j/2] <= UINT32_MAX - shifted_qhat) {
+          q.p[j/2] |= shifted_qhat;
+        }
+      }
+    } else {
+      // Add overflow protection for direct operation
+      if (q.p && j/2 < q.sz) {
+        if (qhat <= UINT32_MAX - q.p[j/2]) {
+          q.p[j/2] |= qhat;
+        }
+      }
+    }
