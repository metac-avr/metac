diff --git a/mrbgems/mruby-bigint/core/bigint.c b/mrbgems/mruby-bigint/core/bigint.c
index d51efdf6f..92ff76664 100644
--- a/mrbgems/mruby-bigint/core/bigint.c
+++ b/mrbgems/mruby-bigint/core/bigint.c
@@ -498,7 +497,0 @@ udiv(mrb_state *mrb, mpz_t *qq, mpz_t *rr, mpz_t *xx, mpz_t *yy)
-      }
-    }
-    if (j%2)
-      q.p[j/2] |= qhat << HALFDIGITBITS;
-    else
-      q.p[j/2] |= qhat;
-    if (j == 0) break;
@@ -506,3 +499,17 @@ udiv(mrb_state *mrb, mpz_t *qq, mpz_t *rr, mpz_t *xx, mpz_t *yy)
-  mpz_realloc(mrb,&r,(size_t)(yy->sz));
-  zero(&r);
-  urshift(mrb,&r,&x,ns);
+  }
+  if (j%2)
+// FIXME: Crash CWE-190: Integer Overflow or Wraparound
+    // Prevent integer overflow by checking bounds before shift operation
+    if (HALFDIGITBITS < sizeof(qhat) * 8 && 
+        qhat > (UINT32_MAX >> HALFDIGITBITS)) {
+      q.p[j/2] = UINT32_MAX;  // Cap at maximum value
+    } else {
+      q.p[j/2] |= qhat << HALFDIGITBITS;
+    }
+  else
+    q.p[j/2] |= qhat;
+  if (j == 0) break;
+}
+mpz_realloc(mrb,&r,(size_t)(yy->sz));
+zero(&r);
+urshift(mrb,&r,&x,ns);
