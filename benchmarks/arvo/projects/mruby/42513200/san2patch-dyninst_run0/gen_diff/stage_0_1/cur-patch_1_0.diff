diff --git a/mrbgems/mruby-bigint/core/bigint.c b/mrbgems/mruby-bigint/core/bigint.c
index d51efdf6f..21084a848 100644
--- a/mrbgems/mruby-bigint/core/bigint.c
+++ b/mrbgems/mruby-bigint/core/bigint.c
@@ -498,7 +497,0 @@ udiv(mrb_state *mrb, mpz_t *qq, mpz_t *rr, mpz_t *xx, mpz_t *yy)
-      }
-    }
-    if (j%2)
-      q.p[j/2] |= qhat << HALFDIGITBITS;
-    else
-      q.p[j/2] |= qhat;
-    if (j == 0) break;
@@ -506,3 +499,15 @@ udiv(mrb_state *mrb, mpz_t *qq, mpz_t *rr, mpz_t *xx, mpz_t *yy)
-  mpz_realloc(mrb,&r,(size_t)(yy->sz));
-  zero(&r);
-  urshift(mrb,&r,&x,ns);
+  }
+  if (j%2)
+// FIXME: Crash CWE-190: Integer Overflow or Wraparound
+    // Use safe arithmetic to prevent overflow
+    if (__builtin_add_overflow(q.p[j/2], (qhat << HALFDIGITBITS), &q.p[j/2])) {
+      // Handle overflow by capping at maximum value
+      q.p[j/2] = UINT32_MAX;
+    }
+  else
+    q.p[j/2] |= qhat;
+  if (j == 0) break;
+}
+mpz_realloc(mrb,&r,(size_t)(yy->sz));
+zero(&r);
+urshift(mrb,&r,&x,ns);
