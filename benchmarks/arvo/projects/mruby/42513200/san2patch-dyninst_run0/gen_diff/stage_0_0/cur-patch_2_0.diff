diff --git a/mrbgems/mruby-bigint/core/bigint.c b/mrbgems/mruby-bigint/core/bigint.c
index d51efdf6f..2a518c8c6 100644
--- a/mrbgems/mruby-bigint/core/bigint.c
+++ b/mrbgems/mruby-bigint/core/bigint.c
@@ -501 +501,5 @@ udiv(mrb_state *mrb, mpz_t *qq, mpz_t *rr, mpz_t *xx, mpz_t *yy)
-      q.p[j/2] |= qhat << HALFDIGITBITS;
+// Guard against integer overflow in shift operation
+      if (HALFDIGITBITS < 32 && qhat <= (UINT32_MAX >> HALFDIGITBITS))
+        q.p[j/2] |= qhat << HALFDIGITBITS;
+      else
+        q.p[j/2] |= (UINT32_MAX >> HALFDIGITBITS) << HALFDIGITBITS;
@@ -503 +507,2 @@ udiv(mrb_state *mrb, mpz_t *qq, mpz_t *rr, mpz_t *xx, mpz_t *yy)
-      q.p[j/2] |= qhat;
+// Guard against direct assignment overflow
+      q.p[j/2] |= (qhat <= UINT32_MAX ? qhat : UINT32_MAX);
