diff --git a/mrbgems/mruby-bigint/core/bigint.c b/mrbgems/mruby-bigint/core/bigint.c
index d51efdf6f..9e8cfab71 100644
--- a/mrbgems/mruby-bigint/core/bigint.c
+++ b/mrbgems/mruby-bigint/core/bigint.c
@@ -501 +501,2 @@ udiv(mrb_state *mrb, mpz_t *qq, mpz_t *rr, mpz_t *xx, mpz_t *yy)
-      q.p[j/2] |= qhat << HALFDIGITBITS;
+// Prevent integer overflow by checking bounds before operation
+      q.p[j/2] |= (qhat > (UINT32_MAX >> HALFDIGITBITS) ? (UINT32_MAX >> HALFDIGITBITS) : qhat) << HALFDIGITBITS;
@@ -503 +504 @@ udiv(mrb_state *mrb, mpz_t *qq, mpz_t *rr, mpz_t *xx, mpz_t *yy)
-      q.p[j/2] |= qhat;
+      q.p[j/2] |= (qhat > UINT32_MAX ? UINT32_MAX : qhat);
