+    if (j%2) {
+      uint32_t temp = qhat << HALFDIGITBITS;
+      if (temp >= qhat && q.p[j/2] <= UINT32_MAX - temp) {
+        q.p[j/2] |= temp;
+      } else {
+        // Handle overflow
+        return;
+      }
+    } else {
+      if (q.p[j/2] <= UINT32_MAX - qhat) {
