diff --git a/mrbgems/mruby-bigint/core/bigint.c b/mrbgems/mruby-bigint/core/bigint.c
index d51efdf6f..bcf77650e 100644
--- a/mrbgems/mruby-bigint/core/bigint.c
+++ b/mrbgems/mruby-bigint/core/bigint.c
@@ -500,2 +500,10 @@ udiv(mrb_state *mrb, mpz_t *qq, mpz_t *rr, mpz_t *xx, mpz_t *yy)
-    if (j%2)
-      q.p[j/2] |= qhat << HALFDIGITBITS;
+    if (j%2) {
+// Guard against integer overflow in shift operation
+      uint32_t shifted_value;
+      if (__builtin_mul_overflow(qhat, (1U << HALFDIGITBITS), &shifted_value)) {
+        // Overflow occurred, clamp to maximum value
+        q.p[j/2] |= UINT32_MAX;
+      } else {
+        q.p[j/2] |= shifted_value;
+      }
+    }
