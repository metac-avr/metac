diff --git a/mrbgems/mruby-bigint/core/bigint.c b/mrbgems/mruby-bigint/core/bigint.c
index d51efdf6f..083f95b9c 100644
--- a/mrbgems/mruby-bigint/core/bigint.c
+++ b/mrbgems/mruby-bigint/core/bigint.c
@@ -500,2 +500,9 @@ udiv(mrb_state *mrb, mpz_t *qq, mpz_t *rr, mpz_t *xx, mpz_t *yy)
-    if (j%2)
-      q.p[j/2] |= qhat << HALFDIGITBITS;
+    if (j%2) {
+      // Prevent integer overflow by checking bounds before shift
+      if (qhat <= (UINT32_MAX >> HALFDIGITBITS)) {
+        q.p[j/2] |= qhat << HALFDIGITBITS;
+      } else {
+        // Clamp to maximum representable value to prevent overflow
+        q.p[j/2] |= UINT32_MAX;
+      }
+    }
