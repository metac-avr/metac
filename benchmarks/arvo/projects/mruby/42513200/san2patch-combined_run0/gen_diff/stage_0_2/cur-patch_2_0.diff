diff --git a/mrbgems/mruby-bigint/core/bigint.c b/mrbgems/mruby-bigint/core/bigint.c
index d51efdf6f..f5e30d751 100644
--- a/mrbgems/mruby-bigint/core/bigint.c
+++ b/mrbgems/mruby-bigint/core/bigint.c
@@ -500,2 +500,10 @@ udiv(mrb_state *mrb, mpz_t *qq, mpz_t *rr, mpz_t *xx, mpz_t *yy)
-    if (j%2)
-      q.p[j/2] |= qhat << HALFDIGITBITS;
+    if (j%2) {
+      // Add overflow protection for the shift operation
+      uint32_t shifted_qhat;
+      if (__builtin_mul_overflow(qhat, (1U << HALFDIGITBITS), &shifted_qhat)) {
+        // Overflow detected, use maximum safe value
+        q.p[j/2] |= UINT32_MAX;
+      } else {
+        q.p[j/2] |= shifted_qhat;
+      }
+    }
