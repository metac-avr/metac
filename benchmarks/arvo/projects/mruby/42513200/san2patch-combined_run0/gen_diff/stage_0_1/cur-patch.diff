diff --git a/src/numeric.c b/src/numeric.c
index 27a7cb8c3..88a7ee78e 100644
--- a/src/numeric.c
+++ b/src/numeric.c
@@ -1198,0 +1199,2 @@ int_mod(mrb_state *mrb, mrb_value x)
+    
+    // Handle edge case that causes overflow
@@ -1199,0 +1202,2 @@ int_mod(mrb_state *mrb, mrb_value x)
+    
+    // Add overflow protection for modulus result adjustment
@@ -1202 +1206,6 @@ int_mod(mrb_state *mrb, mrb_value x)
