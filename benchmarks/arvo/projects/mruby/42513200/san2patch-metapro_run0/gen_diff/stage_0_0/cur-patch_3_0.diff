diff --git a/src/numeric.c b/src/numeric.c
index 27a7cb8c3..3a6d5ec65 100644
--- a/src/numeric.c
+++ b/src/numeric.c
@@ -1199,0 +1200,9 @@ int_mod(mrb_state *mrb, mrb_value x)
+    
+    // Check for potential overflow in modulo operation
+    if (b > 0 && a < 0) {
+      // Prevent overflow by checking bounds before calculation
+      if (a < (MRB_INT_MIN + b) && a != 0) {
+        mrb_raise(mrb, E_RANGE_ERROR, "integer overflow in modulo");
+      }
+    }
+    
@@ -1201,0 +1211,6 @@ int_mod(mrb_state *mrb, mrb_value x)
+      // Check for overflow before addition
+      if (b > 0 && mod > (MRB_INT_MAX - b)) {
+        mrb_raise(mrb, E_RANGE_ERROR, "integer overflow in modulo adjustment");
+      } else if (b < 0 && mod < (MRB_INT_MIN - b)) {
+        mrb_raise(mrb, E_RANGE_ERROR, "integer overflow in modulo adjustment");
+      }
