+    }
+    }
+    if (j%2) {
+      // Prevent integer overflow by checking bounds before assignment
+      mpz_long overflow_check = qhat << HALFDIGITBITS;
+      if (overflow_check < qhat) {  // Check if left shift caused overflow
+        q.p[j/2] = MPZ_LONG_MAX;
+      } else if (q.p[j/2] > (MPZ_LONG_MAX - overflow_check)) {
+        q.p[j/2] = MPZ_LONG_MAX;
+      } else {
+        q.p[j/2] |= overflow_check;
+      }
+    } else {
+      if (q.p[j/2] > (MPZ_LONG_MAX - qhat)) {
+        q.p[j/2] = MPZ_LONG_MAX;
+      } else {
