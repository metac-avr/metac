@@ -565,0 +551,13 @@ mrb_funcall_with_block(mrb_state *mrb, mrb_value self, mrb_sym mid, mrb_int argc
+static inline struct REnv*
+uvenv(mrb_state *mrb, mrb_int up)
+{
+  const struct RProc *proc = mrb->c->ci->proc;
+  struct REnv *e;
+
+  while (up--) {
+    if (e) return e;              /* proc has enclosed env */
+    else {
+      if (!proc) return NULL;
+      e = MRB_PROC_ENV(proc);
+      if (!e) return NULL;
+      proc = e->cxt ? e->cxt->proc : NULL;
@@ -568,9 +566 @@ mrb_funcall_with_block(mrb_state *mrb, mrb_value self, mrb_sym mid, mrb_int argc
-  mrb_gc_arena_restore(mrb, ai);
