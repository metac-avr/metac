diff --git a/src/vm.c b/src/vm.c
index bff02877a..5847128dd 100644
--- a/src/vm.c
+++ b/src/vm.c
@@ -1121 +1121 @@ mrb_vm_run(mrb_state *mrb, const struct RProc *proc, mrb_value self, mrb_int sta
-
+ 
@@ -1126,0 +1127,3 @@ mrb_vm_run(mrb_state *mrb, const struct RProc *proc, mrb_value self, mrb_int sta
+    
+  // Store current stack base before extension
+  mrb_value *old_stack = c->stbase;
@@ -1127,0 +1131,10 @@ mrb_vm_run(mrb_state *mrb, const struct RProc *proc, mrb_value self, mrb_int sta
+  
+  // Check if stack was reallocated
+  if (old_stack != NULL && c->stbase != old_stack && c->ci->stack != NULL) {
+    // Adjust ci->stack pointer if it was pointing to old stack
+    if (c->ci->stack >= old_stack && c->ci->stack < (old_stack + (c->stend - c->stbase))) {
+      ptrdiff_t offset = c->ci->stack - old_stack;
+      c->ci->stack = c->stbase + offset;
+    }
+  }
