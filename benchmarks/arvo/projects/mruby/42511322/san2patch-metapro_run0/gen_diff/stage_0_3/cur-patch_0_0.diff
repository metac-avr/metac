@@ -189,0 +201,7 @@ stack_extend_alloc(mrb_state *mrb, mrb_int room)
+  /* Restore stack pointers after realloc */
+  for (i = 0; cibase + i <= ci; i++) {
+    if ((cibase + i)->stack) {
+      (cibase + i)->stack = newstack + offsets[i];
+    }
+  }
