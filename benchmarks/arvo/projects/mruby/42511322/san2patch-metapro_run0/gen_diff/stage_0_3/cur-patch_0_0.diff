+  mrb_callinfo *ci = mrb->c->ci;
+  mrb_callinfo *cibase = mrb->c->cibase;
+  ptrdiff_t *offsets = (ptrdiff_t*)alloca((ci - cibase + 1) * sizeof(ptrdiff_t));
+  ptrdiff_t i;
+  for (i = 0; cibase + i <= ci; i++) {
+    if ((cibase + i)->stack) {
+      offsets[i] = (cibase + i)->stack - oldbase;
