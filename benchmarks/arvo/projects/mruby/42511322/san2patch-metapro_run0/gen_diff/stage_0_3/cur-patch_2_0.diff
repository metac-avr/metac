+  struct mrb_context *c = mrb->c;
+  mrb_int ci_count = c->ci - c->cibase + 1;
+  mrb_int *stack_offsets = (mrb_int*)alloca(sizeof(mrb_int) * ci_count);
+  mrb_int j;
+  for (j = 0; j < ci_count; j++) {
+    if ((c->cibase + j)->stack) {
+      stack_offsets[j] = (c->cibase + j)->stack - oldbase;
+    } else {
+      stack_offsets[j] = -1;
+    }
+  }
