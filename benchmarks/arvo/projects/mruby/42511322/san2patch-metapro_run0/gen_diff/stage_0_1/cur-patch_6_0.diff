diff --git a/src/vm.c b/src/vm.c
index bff02877a..80f942909 100644
--- a/src/vm.c
+++ b/src/vm.c
@@ -108,2 +108,2 @@ stack_init(mrb_state *mrb)
-
-  /* mrb_assert(mrb->stack == NULL); */
+ 
+  /* Initialize stack with proper tracking to prevent expired pointer dereference */
@@ -113 +113 @@ stack_init(mrb_state *mrb)
-  /* mrb_assert(ci == NULL); */
+  /* Initialize callinfo with proper stack pointer tracking */
@@ -118 +118 @@ stack_init(mrb_state *mrb)
-  c->ci->stack = c->stbase;
+  c->ci->stack = c->stbase; /* Set initial stack pointer */
@@ -1121 +1121,2 @@ mrb_vm_run(mrb_state *mrb, const struct RProc *proc, mrb_value self, mrb_int sta
-
+  mrb_value *old_stbase = c->stbase;  /* Save old stack base */
+ 
@@ -1127,0 +1129,12 @@ mrb_vm_run(mrb_state *mrb, const struct RProc *proc, mrb_value self, mrb_int sta
+  /* Check if stack was reallocated and update pointers if needed */
+  if (old_stbase && old_stbase != c->stbase) {
+    /* Update callinfo stack pointers after reallocation */
+    struct mrb_callinfo *ci = c->cibase;
+    while (ci <= c->ci) {
+      if (ci->stack >= old_stbase && ci->stack < old_stbase + (c->stend - c->stbase)) {
+        ptrdiff_t offset = ci->stack - old_stbase;
+        ci->stack = c->stbase + offset;
+      }
+      ci++;
+    }
+  }
