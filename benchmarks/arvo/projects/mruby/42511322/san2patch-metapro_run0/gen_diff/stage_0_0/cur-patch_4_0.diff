diff --git a/src/vm.c b/src/vm.c
index bff02877a..d26527472 100644
--- a/src/vm.c
+++ b/src/vm.c
@@ -99 +99,2 @@ static inline void
-stack_copy(mrb_value *dst, const mrb_value *src, size_t size)
+// FIXME: Crash CWE-416: Use After Free
+ stack_copy(mrb_value *dst, const mrb_value *src, size_t size)
@@ -101 +102,3 @@ stack_copy(mrb_value *dst, const mrb_value *src, size_t size)
-  memcpy(dst, src, sizeof(mrb_value)*size);
