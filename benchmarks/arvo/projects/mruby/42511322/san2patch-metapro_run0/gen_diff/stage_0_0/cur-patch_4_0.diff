+    memcpy(dst, src, sizeof(mrb_value)*size);
+  }
@@ -180,0 +184,4 @@ stack_extend_alloc(mrb_state *mrb, mrb_int room)
+  /* Calculate stack offsets before reallocation to prevent use-after-free */
+  ptrdiff_t stack_off = mrb->c->ci->stack ? mrb->c->ci->stack - mrb->c->stbase : 0;
+  mrb_bool has_stack = mrb->c->ci->stack != NULL;
+  
@@ -188,0 +196,5 @@ stack_extend_alloc(mrb_state *mrb, mrb_int room)
+  
+  /* Restore stack pointer using calculated offset */
+  if (has_stack) {
+    mrb->c->ci->stack = mrb->c->stbase + stack_off;
+  }
