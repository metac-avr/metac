diff --git a/src/vm.c b/src/vm.c
index 1c59d4406..d6a508170 100644
--- a/src/vm.c
+++ b/src/vm.c
@@ -515,2 +515,10 @@ mrb_funcall_with_block(mrb_state *mrb, mrb_value self, mrb_sym mid, mrb_int argc
-      if (argc > 0)
-        stack_copy(ci->stack+1, argv, argc);
+       if (argc > 0) {
+         // Validate stack space before copy operation
+         if ((ci->stack + 1 + argc) <= mrb->c->stend) {
+           stack_copy(ci->stack+1, argv, argc);
+         } else {
+           // Truncate argc to fit available stack space
+           argc = mrb->c->stend - (ci->stack + 1);
+           if (argc > 0) stack_copy(ci->stack+1, argv, argc);
+         }
+       }
