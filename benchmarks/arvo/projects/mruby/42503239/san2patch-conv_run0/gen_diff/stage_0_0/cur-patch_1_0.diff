diff --git a/src/vm.c b/src/vm.c
index 1c59d4406..bc5790366 100644
--- a/src/vm.c
+++ b/src/vm.c
@@ -515,2 +515,8 @@ mrb_funcall_with_block(mrb_state *mrb, mrb_value self, mrb_sym mid, mrb_int argc
-      if (argc > 0)
-        stack_copy(ci->stack+1, argv, argc);
+      if (argc > 0) {
+        mrb_int stack_available = mrb->c->stend - (ci->stack + 1);
+        if (stack_available >= argc) {
+          stack_copy(ci->stack+1, argv, argc);
+        } else {
+          mrb_raise(mrb, E_RUNTIME_ERROR, "insufficient stack space");
+        }
+      }
@@ -1068 +1074,3 @@ mrb_vm_run(mrb_state *mrb, const struct RProc *proc, mrb_value self, mrb_int sta
-  stack_clear(c->ci->stack + stack_keep, nregs - stack_keep);
+  if (nregs - stack_keep > 0) {
+    stack_clear(c->ci->stack + stack_keep, nregs - stack_keep);
+  }
