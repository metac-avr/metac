diff --git a/src/vm.c b/src/vm.c
index 1c59d4406..63e696b45 100644
--- a/src/vm.c
+++ b/src/vm.c
@@ -107,2 +107,2 @@ stack_init(mrb_state *mrb)
-
-  /* mrb_assert(mrb->stack == NULL); */
+ 
+  /* Allocate extra buffer space to prevent boundary writes */
@@ -110 +110 @@ stack_init(mrb_state *mrb)
-  c->stend = c->stbase + STACK_INIT_SIZE;
+  c->stend = c->stbase + STACK_INIT_SIZE - 1; /* Reserve one slot */
@@ -112 +112 @@ stack_init(mrb_state *mrb)
-  /* mrb_assert(ci == NULL); */
+  /* Allocate extra callinfo space */
@@ -114 +114 @@ stack_init(mrb_state *mrb)
-  c->ciend = c->cibase + CALLINFO_INIT_SIZE;
+  c->ciend = c->cibase + CALLINFO_INIT_SIZE - 1; /* Reserve one slot */
@@ -1611 +1611 @@ mrb_vm_exec(mrb_state *mrb, const struct RProc *proc, const mrb_code *pc)
-        }
+         }
@@ -1637 +1637,7 @@ mrb_vm_exec(mrb_state *mrb, const struct RProc *proc, const mrb_code *pc)
-        ci->stack[0] = recv;
+        
+        /* Validate stack pointer before assignment */
+        if ((ci->stack + 1) <= mrb->c->stend) {
+          ci->stack[0] = recv;
+        } else {
+          goto L_RAISE;
+        }
