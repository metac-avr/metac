diff --git a/src/vm.c b/src/vm.c
index 1c59d4406..b0a1d00d5 100644
--- a/src/vm.c
+++ b/src/vm.c
@@ -107,3 +107,3 @@ stack_init(mrb_state *mrb)
-
-  /* mrb_assert(mrb->stack == NULL); */
-  c->stbase = (mrb_value *)mrb_calloc(mrb, STACK_INIT_SIZE, sizeof(mrb_value));
+ 
+  /* Initialize stack with safety margin to prevent overflow */
+  c->stbase = (mrb_value *)mrb_calloc(mrb, STACK_INIT_SIZE + 1, sizeof(mrb_value));
@@ -112,2 +112,2 @@ stack_init(mrb_state *mrb)
-  /* mrb_assert(ci == NULL); */
-  c->cibase = (mrb_callinfo *)mrb_calloc(mrb, CALLINFO_INIT_SIZE, sizeof(mrb_callinfo));
+  /* Initialize callinfo with safety margin */
+  c->cibase = (mrb_callinfo *)mrb_calloc(mrb, CALLINFO_INIT_SIZE + 1, sizeof(mrb_callinfo));
@@ -1611 +1611 @@ mrb_vm_exec(mrb_state *mrb, const struct RProc *proc, const mrb_code *pc)
-        }
+         }
@@ -1637 +1637,8 @@ mrb_vm_exec(mrb_state *mrb, const struct RProc *proc, const mrb_code *pc)
-        ci->stack[0] = recv;
+        
+        /* Check stack bounds before writing */
+        if (ci->stack < mrb->c->stend - 1) {
+          ci->stack[0] = recv;
+        } else {
+          mrb_raise(mrb, E_RUNTIME_ERROR, "stack overflow");
+          goto L_RAISE;
+        }
