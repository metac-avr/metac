diff --git a/src/isomedia/box_funcs.c b/src/isomedia/box_funcs.c
index 84310399e..005c3222e 100644
--- a/src/isomedia/box_funcs.c
+++ b/src/isomedia/box_funcs.c
@@ -1801 +1801,12 @@ void gf_isom_box_del(GF_Box *a)
-	if (!a) return;
+ 	if (!a) return;
+
+	if (a->parent) {
+		GF_Box *parent = a->parent;
+		if (parent->child_boxes) {
+			u32 i = 0;
+			while ((i = gf_list_find(parent->child_boxes, a)) >= 0) {
+				gf_list_rem(parent->child_boxes, i);
+			}
+		}
+		a->parent = NULL;
+	}
