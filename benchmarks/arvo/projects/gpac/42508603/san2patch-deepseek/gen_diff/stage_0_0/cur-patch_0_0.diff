diff --git a/src/isomedia/box_funcs.c b/src/isomedia/box_funcs.c
index 84310399e..112595b29 100644
--- a/src/isomedia/box_funcs.c
+++ b/src/isomedia/box_funcs.c
@@ -1801 +1801,15 @@ void gf_isom_box_del(GF_Box *a)
-	if (!a) return;
+ 	if (!a) return;
+
+	if (a->parent) {
+		GF_List *parent_child_boxes = a->parent->child_boxes;
+		if (parent_child_boxes) {
+			u32 i, count = gf_list_count(parent_child_boxes);
+			for (i = 0; i < count; i++) {
+				if (gf_list_get(parent_child_boxes, i) == a) {
+					gf_list_rem(parent_child_boxes, i);
+					break;
+				}
+			}
+		}
+		a->parent = NULL;
+	}
