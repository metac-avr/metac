diff --git a/src/isomedia/box_funcs.c b/src/isomedia/box_funcs.c
index 84310399e..61fa33a70 100644
--- a/src/isomedia/box_funcs.c
+++ b/src/isomedia/box_funcs.c
@@ -1801 +1801,12 @@ void gf_isom_box_del(GF_Box *a)
-	if (!a) return;
+ 	if (!a) return;
+
+	if (a->parent && a->parent->child_boxes) {
+		u32 i, count = gf_list_count(a->parent->child_boxes);
+		for (i = 0; i < count; i++) {
+			if (gf_list_get(a->parent->child_boxes, i) == a) {
+				gf_list_rem(a->parent->child_boxes, i);
+				break;
+			}
+		}
+		a->parent = NULL;
+	}
