diff --git a/src/isomedia/box_funcs.c b/src/isomedia/box_funcs.c
index 84310399e..74e31b60c 100644
--- a/src/isomedia/box_funcs.c
+++ b/src/isomedia/box_funcs.c
@@ -1803 +1803 @@ void gf_isom_box_del(GF_Box *a)
-	child_boxes	= a->child_boxes;
+	child_boxes = a->child_boxes;
@@ -1805,0 +1806,12 @@ void gf_isom_box_del(GF_Box *a)
+	// Clear child references before deletion to prevent use-after-free
+	if (child_boxes) {
+		u32 i, count = gf_list_count(child_boxes);
+		for (i = 0; i < count; i++) {
+			GF_Box *child = (GF_Box *)gf_list_get(child_boxes, i);
+			if (child && child == a) {
+				gf_list_rem(child_boxes, i);
+				break;
+			}
+		}
+	}
+
diff --git a/src/isomedia/box_code_base.c b/src/isomedia/box_code_base.c
