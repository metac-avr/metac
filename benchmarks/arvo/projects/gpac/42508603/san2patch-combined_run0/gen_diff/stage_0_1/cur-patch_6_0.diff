+++ b/src/isomedia/box_code_base.c
@@ -3994 +3994 @@ GF_Err audio_sample_entry_box_read(GF_Box *s, GF_BitStream *bs)
- 	if (gf_bs_get_cookie(bs) & GF_ISOM_BS_COOKIE_QT_CONV) {
+  	if (gf_bs_get_cookie(bs) & GF_ISOM_BS_COOKIE_QT_CONV) {
@@ -3996 +3996,2 @@ GF_Err audio_sample_entry_box_read(GF_Box *s, GF_BitStream *bs)
- 	}
+// FIXME: Crash CWE-825: Expired Pointer Dereference
+   	}
@@ -4030 +4031,7 @@ GF_Err audio_sample_entry_box_read(GF_Box *s, GF_BitStream *bs)
-			if (ptr->esd) gf_isom_box_del_parent(&ptr->child_boxes, (GF_Box *)ptr->esd);
+			if (ptr->esd) {
+				// Clear the pointer from child_boxes before freeing to prevent use-after-free
+				if (ptr->child_boxes) {
+					gf_list_del_item(ptr->child_boxes, ptr->esd);
+				}
+				gf_isom_box_del_parent(&ptr->child_boxes, (GF_Box *)ptr->esd);
+			}
