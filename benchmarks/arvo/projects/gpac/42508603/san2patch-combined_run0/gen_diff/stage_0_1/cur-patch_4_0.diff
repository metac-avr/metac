@@ -1800,0 +1804,13 @@ GF_Err hmhd_box_read(GF_Box *s,GF_BitStream *bs)
+	// Validate pointer before use to prevent expired pointer dereference
+	if (!ptr) return GF_BAD_PARAM;
+	// Additional safety check for parent box integrity
+	if (((GF_Box*)ptr)->parent && ((GF_Box*)ptr)->parent->child_boxes) {
+		u32 i;
+		for (i=0; i<((GF_Box*)ptr)->parent->child_boxes_count; i++) {
+			if (((GF_Box*)ptr)->parent->child_boxes[i] && 
