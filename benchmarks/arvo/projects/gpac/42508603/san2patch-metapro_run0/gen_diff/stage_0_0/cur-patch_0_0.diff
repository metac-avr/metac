@@ -1801 +1801,2 @@ void gf_isom_box_del(GF_Box *a)
-	if (!a) return;
+// FIXME: Crash CWE-825: Expired Pointer Dereference
+ 	if (!a) return;
@@ -1809,0 +1811,8 @@ void gf_isom_box_del(GF_Box *a)
+		/* Clear potential dangling pointers before deletion */
+		if (a->type == GF_ISOM_BOX_TYPE_ESDS) {
+			/* For ESDS boxes, ensure parent references are cleared */
+			GF_ESDBox *esds = (GF_ESDBox *)a;
+			if (esds->desc) {
+				esds->desc = NULL;  /* Prevent dangling pointer access */
+			}
+		}
