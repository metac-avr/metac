diff --git a/src/isomedia/box_code_base.c b/src/isomedia/box_code_base.c
index 753cff17d..4dab650ea 100644
--- a/src/isomedia/box_code_base.c
+++ b/src/isomedia/box_code_base.c
@@ -4028 +4028,2 @@ GF_Err audio_sample_entry_box_read(GF_Box *s, GF_BitStream *bs)
-		if (GF_4CC((u32)data[i+4], (u8)data[i+5], (u8)data[i+6], (u8)data[i+7]) == GF_ISOM_BOX_TYPE_ESDS) {
+// FIXME: Crash CWE-825: Expired Pointer Dereference
+ 		if (GF_4CC((u32)data[i+4], (u8)data[i+5], (u8)data[i+6], (u8)data[i+7]) == GF_ISOM_BOX_TYPE_ESDS) {
@@ -4030 +4031,8 @@ GF_Err audio_sample_entry_box_read(GF_Box *s, GF_BitStream *bs)
-			if (ptr->esd) gf_isom_box_del_parent(&ptr->child_boxes, (GF_Box *)ptr->esd);
+			if (ptr->esd) {
+				// Check if ptr->esd is still valid before freeing
+				if (gf_isom_box_find_child(ptr->child_boxes, GF_ISOM_BOX_TYPE_ESDS)) {
+					gf_isom_box_del_parent(&ptr->child_boxes, (GF_Box *)ptr->esd);
+				} else {
+					gf_isom_box_del((GF_Box *)ptr->esd);
+				}
+			}
