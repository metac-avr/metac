diff --git a/src/isomedia/box_code_base.c b/src/isomedia/box_code_base.c
index 753cff17d..e2ab7d138 100644
--- a/src/isomedia/box_code_base.c
+++ b/src/isomedia/box_code_base.c
@@ -1253,2 +1253,6 @@ void esds_box_del(GF_Box *s)
-	if (ptr == NULL)	return;
-	if (ptr->desc) gf_odf_desc_del((GF_Descriptor *)ptr->desc);
+	// FIXME: Crash CWE-825: Expired Pointer Dereference
+	if (ptr == NULL) return;
