diff --git a/src/isomedia/box_funcs.c b/src/isomedia/box_funcs.c
index 84310399e..8351147b3 100644
--- a/src/isomedia/box_funcs.c
+++ b/src/isomedia/box_funcs.c
@@ -1801 +1801,2 @@ void gf_isom_box_del(GF_Box *a)
-	if (!a) return;
+// FIXME: Crash CWE-825: Expired Pointer Dereference
+ 	if (!a) return;
@@ -1814 +1815,4 @@ void gf_isom_box_del(GF_Box *a)
-		gf_isom_box_array_del(child_boxes);
+		// Validate child_boxes before deletion to prevent use-after-free
+		if (gf_list_get_count(child_boxes) >= 0 && child_boxes != (GF_List *)0xdeadbeef) {
+			gf_isom_box_array_del(child_boxes);
+		}
diff --git a/src/isomedia/box_code_base.c b/src/isomedia/box_code_base.c
index 753cff17d..0fd705642 100644
--- a/src/isomedia/box_code_base.c
+++ b/src/isomedia/box_code_base.c
@@ -1253,2 +1253,8 @@ void esds_box_del(GF_Box *s)
-	if (ptr == NULL)	return;
-	if (ptr->desc) gf_odf_desc_del((GF_Descriptor *)ptr->desc);
+	// FIXME: Crash CWE-825: Expired Pointer Dereference
+	if (ptr == NULL) return;
+	// Add validation to prevent expired pointer dereference
+	if (ptr->desc) {
+		gf_odf_desc_del((GF_Descriptor *)ptr->desc);
+		// Zero out the pointer after freeing to prevent reuse
+		memset(&ptr->desc, 0, sizeof(ptr->desc));
+	}
