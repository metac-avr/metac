diff --git a/src/isomedia/box_code_base.c b/src/isomedia/box_code_base.c
index 753cff17d..750748d20 100644
--- a/src/isomedia/box_code_base.c
+++ b/src/isomedia/box_code_base.c
@@ -1253,2 +1253,5 @@ void esds_box_del(GF_Box *s)
-	if (ptr == NULL)	return;
-	if (ptr->desc) gf_odf_desc_del((GF_Descriptor *)ptr->desc);
+	if (ptr == NULL) return;
+	if (ptr->desc) {
+		gf_odf_desc_del((GF_Descriptor *)ptr->desc);
+		ptr->desc = NULL;  // Prevent use-after-free by clearing reference
+	}
diff --git a/src/isomedia/box_funcs.c b/src/isomedia/box_funcs.c
index 84310399e..bc3502e20 100644
--- a/src/isomedia/box_funcs.c
+++ b/src/isomedia/box_funcs.c
@@ -1808 +1808,2 @@ void gf_isom_box_del(GF_Box *a)
-		GF_LOG(GF_LOG_ERROR, GF_LOG_CONTAINER, ("[iso file] Delete invalid box type %s without registry\n", gf_4cc_to_str(a->type) ));
+// FIXME: Crash CWE-416: Use After Free
+ 		GF_LOG(GF_LOG_ERROR, GF_LOG_CONTAINER, ("[iso file] Delete invalid box type %s without registry\n", gf_4cc_to_str(a->type) ));
@@ -1810 +1811,7 @@ void gf_isom_box_del(GF_Box *a)
-		a_box_registry->del_fn(a);
+		if (a_box_registry->del_fn && a_box_registry->del_fn != (void (*)(GF_Box *))0x1) {
+			a_box_registry->del_fn(a);
+		} else if (a_box_registry->del_fn == (void (*)(GF_Box *))0x1) {
+			// Box already deleted, skip
+		} else {
+			gf_free(a);
+		}
