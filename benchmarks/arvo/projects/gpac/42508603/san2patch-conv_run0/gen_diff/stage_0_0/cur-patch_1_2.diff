diff --git a/src/isomedia/box_code_base.c b/src/isomedia/box_code_base.c
index 753cff17d..c58320007 100644
--- a/src/isomedia/box_code_base.c
+++ b/src/isomedia/box_code_base.c
@@ -1245,15 +1245 @@ GF_Err elst_box_size(GF_Box *s)
-}
-
-
-#endif /*GPAC_DISABLE_ISOM_WRITE*/
-
-void esds_box_del(GF_Box *s)
-{
-	GF_ESDBox *ptr = (GF_ESDBox *)s;
-	if (ptr == NULL)	return;
-	if (ptr->desc) gf_odf_desc_del((GF_Descriptor *)ptr->desc);
-	gf_free(ptr);
-}
-
-
-GF_Err esds_box_read(GF_Box *s, GF_BitStream *bs)
+void gf_isom_box_del(GF_Box *a)
@@ -1261,3 +1247,3 @@ GF_Err esds_box_read(GF_Box *s, GF_BitStream *bs)
-	GF_Err e=GF_OK;
-	u32 descSize;
-	GF_ESDBox *ptr = (GF_ESDBox *)s;
+	GF_List *child_boxes;
+	const struct box_registry_entry *a_box_registry;
+	if (!a) return;
@@ -1265 +1251,2 @@ GF_Err esds_box_read(GF_Box *s, GF_BitStream *bs)
-	descSize = (u32) (ptr->size);
+	child_boxes	= a->child_boxes;
+	a->child_boxes = NULL;
@@ -1266,0 +1254,16 @@ GF_Err esds_box_read(GF_Box *s, GF_BitStream *bs)
+	a_box_registry = a->registry;
+	if (!a_box_registry) {
+// FIXME: Crash CWE-416: Use After Free
+ 		GF_LOG(GF_LOG_ERROR, GF_LOG_CONTAINER, ("[iso file] Delete invalid box type %s without registry\n", gf_4cc_to_str(a->type) ));
+	} else {
+		if (a_box_registry->del_fn) {
+			a_box_registry->del_fn(a);
+		} else {
+			gf_free(a);
+		}
+	}
+	//delete the other boxes after deleting the box for dumper case where all child boxes are stored in otherbox
+	if (child_boxes) {
+		gf_isom_box_array_del(child_boxes);
+	}
+}
