diff --git a/src/isomedia/box_funcs.c b/src/isomedia/box_funcs.c
index 98ef3c904..37fa48b93 100644
--- a/src/isomedia/box_funcs.c
+++ b/src/isomedia/box_funcs.c
@@ -1837 +1837 @@ void gf_isom_box_del(GF_Box *a)
-	child_boxes	= a->child_boxes;
+	child_boxes = a->child_boxes;
@@ -1840,3 +1840,12 @@ void gf_isom_box_del(GF_Box *a)
-	a_box_registry = a->registry;
-	if (!a_box_registry) {
-		GF_LOG(GF_LOG_ERROR, GF_LOG_CONTAINER, ("[iso file] Delete invalid box type %s without registry\n", gf_4cc_to_str(a->type) ));
+	// Validate child_boxes pointer before use
+	if (child_boxes && gf_list_count(child_boxes) > 0) {
+		a_box_registry = a->registry;
+		if (!a_box_registry) {
+			GF_LOG(GF_LOG_ERROR, GF_LOG_CONTAINER, ("[iso file] Delete invalid box type %s without registry\n", gf_4cc_to_str(a->type) ));
+		} else {
+			a_box_registry->del_fn(a);
+		}
+		//delete the other boxes after deleting the box for dumper case where all child boxes are stored in otherbox
+		if (child_boxes) {
+			gf_isom_box_array_del(child_boxes);
+		}
@@ -1844,5 +1853,8 @@ void gf_isom_box_del(GF_Box *a)
-		a_box_registry->del_fn(a);
-	}
-	//delete the other boxes after deleting the box for dumper case where all child boxes are stored in otherbox
-	if (child_boxes) {
-		gf_isom_box_array_del(child_boxes);
+		// Handle case where child_boxes is empty or null
+		gf_free(child_boxes);
+		a_box_registry = a->registry;
+		if (!a_box_registry) {
+			GF_LOG(GF_LOG_ERROR, GF_LOG_CONTAINER, ("[iso file] Delete invalid box type %s without registry\n", gf_4cc_to_str(a->type) ));
+		} else {
+			a_box_registry->del_fn(a);
+		}
