+			}
+		}
+		if (vtt_settings && strlen(vtt_settings) > 2047) {
+			safe_vtt_settings = gf_malloc(2048);
+			if (safe_vtt_settings) {
+				strncpy(safe_vtt_settings, vtt_settings, 2047);
+				safe_vtt_settings[2047] = '\0';
+				vtt_settings = safe_vtt_settings;
+			}
+		}
