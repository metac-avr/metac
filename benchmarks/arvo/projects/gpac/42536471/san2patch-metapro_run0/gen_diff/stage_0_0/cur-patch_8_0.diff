+			task->thid = 0;
+			requeue = task->requeue_request;
+
+			task_time = gf_sys_clock_high_res() - task_time;
+		} else {
+			requeue = GF_FALSE;
+		}
+			safe_int_dec(& fsess->tasks_in_process );
