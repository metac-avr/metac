+					if (ogg_stream_pagein(&os, &oggpage) >= 0 ) {
+						ogg_packet another_temp_packet;
+						if (ogg_stream_packetpeek(&os, &another_temp_packet) == 1) {
+							oggdmx_get_stream_info(&another_temp_packet, &info);
