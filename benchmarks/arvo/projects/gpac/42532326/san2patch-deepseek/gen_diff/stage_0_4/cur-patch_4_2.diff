diff --git a/src/filters/dmx_ogg.c b/src/filters/dmx_ogg.c
index 8b648f32f..6f9af5317 100644
--- a/src/filters/dmx_ogg.c
+++ b/src/filters/dmx_ogg.c
@@ -801,4 +801,9 @@ GF_Err oggdmx_process(GF_Filter *filter)
-				case GF_CODECID_THEORA:
-					add_page = GF_TRUE;
-					break;
-				}
+static GF_Err oggdmx_process(GF_Filter *filter)
+{
+	GF_OGGDmxCtx *ctx = gf_filter_get_udta(filter);
+	ogg_packet oggpacket;
+	ogg_stream_state *os;
+	GF_OGGStream *st;
+	Bool add_page;
+	u64 granulepos_init;
+	u32 i, count;
@@ -806,4 +811,32 @@ GF_Err oggdmx_process(GF_Filter *filter)
-				if (add_page) {
-					if (!st->dsi_bs) st->dsi_bs = gf_bs_new(NULL, 0, GF_BITSTREAM_WRITE);
-					gf_bs_write_u16(st->dsi_bs, oggpacket.bytes);
-					gf_bs_write_data(st->dsi_bs, (char *) oggpacket.packet, oggpacket.bytes);
+	while (ogg_sync_pageout(&ctx->oy, &ctx->og) == 1) {
+		st = NULL;
+		os = NULL;
+		add_page = GF_FALSE;
+		granulepos_init = 0;
+
+		count = ogg_page_serialno(&ctx->og);
+		st = gf_list_find(ctx->streams, gf_ogg_find_stream, &count);
+		if (!st) {
+			st = gf_malloc(sizeof(GF_OGGStream));
+			if (!st) return GF_OUT_OF_MEM;
+			memset(st, 0, sizeof(GF_OGGStream));
+			st->serialno = count;
+			gf_list_add(ctx->streams, st);
+		}
+		os = &st->os;
+		ogg_stream_pagein(os, &ctx->og);
+
+		while (ogg_stream_packetout(os, &oggpacket) > 0) {
+			if (!st->got_headers) {
+				if (st->parse_headers) {
+					if (st->codecid == GF_CODECID_VORBIS) {
+						if (oggpacket.packet[0] == 1) add_page = GF_TRUE;
+					} else if (st->codecid == GF_CODECID_THEORA) {
+						if (oggpacket.packet[0] == 0x80) add_page = GF_TRUE;
+					}
+
+					if (add_page) {
+						if (!st->dsi_bs) st->dsi_bs = gf_bs_new(NULL, 0, GF_BITSTREAM_WRITE);
+						gf_bs_write_u16(st->dsi_bs, oggpacket.bytes);
+						gf_bs_write_data(st->dsi_bs, (char *) oggpacket.packet, oggpacket.bytes);
+					}
@@ -811 +843,0 @@ GF_Err oggdmx_process(GF_Filter *filter)
-				
@@ -822 +854,46 @@ GF_Err oggdmx_process(GF_Filter *filter)
-				GF_LOG(GF_LOG_ERROR, GF_LOG_CONTAINER, ("[OGG] Channel %d packet before configure done - discarding\n", st->serial_no));
+				continue;
+			} else {
+				GF_FilterPacket *dst_pck;
+				if (st->codecid == GF_CODEC_ID_VORBIS) {
+					if (oggpacket.granulepos == -1) continue;
+				} else if (st->codecid == GF_CODEC_ID_THEORA) {
+					if (oggpacket.e_o_s) continue;
+				}
+
+				dst_pck = gf_filter_pck_new_alloc(filter, st->opid, oggpacket.bytes);
+				if (!dst_pck) return GF_OUT_OF_MEM;
+				gf_filter_pck_set_cts(dst_pck, oggpacket.granulepose);
+				gf_filter_pck_set_dts(dst_pck, oggpacket.granulepose - 1);
+				gf_filter_pck_copy_properties(dst_pck, st->src_pck);
+				gf_filter_pck_write_data(dst_pck, (char *) oggpacket.packet, oggpacket.bytes);
+
+				st->recomputed_ts += block_size;
+				gf_filter_pck_send(dst_pck);
+			}
+		}
+		if (st && gf_ogg_stream_has_pending_packets(st)) {
+			oggdmx_check_pending_packets(filter, st);
+		}
+	}
+	return GF_OK;
+}
+
+static GF_Err oggdmx_initialize(GF_Filter *filter)
+{
+	GF_OGGDmxCtx *ctx = gf_filter_get_udta(filter);
+	ctx->streams = gf_list_new();
+	ogg_sync_init(&ctx->oy);
+	return GF_OK;
+}
+
+static void oggdmx_finalize(GF_Filter *filter)
+{
+	GF_OGGDmxCtx *ctx = gf_filter_get_udta(filter);
+	while (gf_list_count(ctx->streams)) {
+		GF_OGGStream *st = gf_list_pop_back(ctx->streams);
+		if (st->dsi_bs) gf_bs_del(st->dsi_bs);
+		gf_free(st);
+	}
+	gf_list_del(ctx->streams);
+	ogg_sync_clear(&ctx->oy);
+}				GF_LOG(GF_LOG_ERROR, GF_LOG_CONTAINER, ("[OGG] Channel %d packet before configure done - discarding\n", st->serial_no));
