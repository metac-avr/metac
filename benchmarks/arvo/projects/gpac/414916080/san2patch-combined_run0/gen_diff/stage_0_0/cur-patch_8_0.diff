diff --git a/src/filter_core/filter_props.c b/src/filter_core/filter_props.c
index f507546bf..fb2c5775f 100644
--- a/src/filter_core/filter_props.c
+++ b/src/filter_core/filter_props.c
@@ -1101 +1101,12 @@ GF_Err gf_props_insert_property(GF_PropertyMap *map, u32 hash, u32 p4cc, const c
-	e = gf_props_assign_value(prop, value, GF_FALSE);
+	if (value) {
+		if ((value->type == GF_PROP_DATA || value->type == GF_PROP_DATA_NO_COPY) && 
+		    value->value.data.ptr && value->value.data.size > 0) {
+			e = gf_props_assign_value(prop, value, GF_FALSE);
+		} else if (!(value->type == GF_PROP_DATA || value->type == GF_PROP_DATA_NO_COPY)) {
+			e = gf_props_assign_value(prop, value, GF_FALSE);
+		} else {
+			e = GF_BAD_PARAM;
+		}
+	} else {
+		e = GF_BAD_PARAM;
+	}
