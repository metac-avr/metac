diff --git a/src/media_tools/mpegts.c b/src/media_tools/mpegts.c
index 38d2d9e2e..0175764ba 100644
--- a/src/media_tools/mpegts.c
+++ b/src/media_tools/mpegts.c
@@ -1802,2 +1802,12 @@ static void gf_m2ts_process_pmt(GF_M2TS_Demuxer *ts, GF_M2TS_SECTION_ES *pmt, GF
-		evt_type = (status&GF_M2TS_TABLE_FOUND) ? GF_M2TS_EVT_PMT_FOUND : GF_M2TS_EVT_PMT_UPDATE;
-		if (ts->on_event) ts->on_event(ts, evt_type, pmt->program);
+		// Validate PMT data before processing to prevent out-of-bounds reads
+		if (pmt && pmt->program && pmt->program->streams) {
+			u32 stream_count = gf_list_count(pmt->program->streams);
+			if (stream_count > 0 && stream_count <= 0xFFFF) { // Reasonable bounds check
+				evt_type = (status&GF_M2TS_TABLE_FOUND) ? GF_M2TS_EVT_PMT_FOUND : GF_M2TS_EVT_PMT_UPDATE;
+				if (ts->on_event) ts->on_event(ts, evt_type, pmt->program);
+			} else {
+				GF_LOG(GF_LOG_ERROR, GF_LOG_CONTAINER, ("[M2TS] Invalid stream count in PMT processing\n"));
+			}
+		} else {
+			GF_LOG(GF_LOG_ERROR, GF_LOG_CONTAINER, ("[M2TS] Invalid PMT data in processing\n"));
+		}
diff --git a/src/filter_core/filter_props.c b/src/filter_core/filter_props.c
index f507546bf..7f4c7bfee 100644
--- a/src/filter_core/filter_props.c
+++ b/src/filter_core/filter_props.c
@@ -1015 +1015,5 @@ static GF_Err gf_props_assign_value(GF_PropertyEntry *prop, const GF_PropertyVal
-			assert(prop->alloc_size);
+// FIXME: Crash CWE-125: Out-of-bounds Read
+ 			assert(prop->alloc_size);
+		}
+		if (value->value.data.size > 0 && value->value.data.ptr != NULL) {
+			memcpy(prop->prop.value.data.ptr, value->value.data.ptr, value->value.data.size);
@@ -1017 +1020,0 @@ static GF_Err gf_props_assign_value(GF_PropertyEntry *prop, const GF_PropertyVal
-		memcpy(prop->prop.value.data.ptr, value->value.data.ptr, value->value.data.size);
@@ -1030,3 +1033,7 @@ static GF_Err gf_props_assign_value(GF_PropertyEntry *prop, const GF_PropertyVal
-		prop->prop.value.uint_list.vals = gf_malloc(it_size * value->value.uint_list.nb_items);
-		if (!value->value.uint_list.nb_items) return GF_OUT_OF_MEM;
-		memcpy(prop->prop.value.uint_list.vals, value->value.uint_list.vals, it_size * value->value.uint_list.nb_items);
+		if (it_size > 0 && value->value.uint_list.nb_items > 0) {
+			prop->prop.value.uint_list.vals = gf_malloc(it_size * value->value.uint_list.nb_items);
+			if (!prop->prop.value.uint_list.vals) return GF_OUT_OF_MEM;
+			memcpy(prop->prop.value.uint_list.vals, value->value.uint_list.vals, it_size * value->value.uint_list.nb_items);
+		} else {
+			prop->prop.value.uint_list.vals = NULL;
+		}
