diff --git a/src/utils/error.c b/src/utils/error.c
index 23c5105d6..b8d33f7e8 100644
--- a/src/utils/error.c
+++ b/src/utils/error.c
@@ -2172,5 +2172,12 @@ GF_Err gf_dynstrcat(char **str, const char *to_append, const char *sep)
-	if (l1) (*str) = gf_realloc((*str), sizeof(char)*(l1+l2+lsep+1));
-	else (*str) = gf_realloc((*str), sizeof(char)*(l2+lsep+1));
-
-	if (! (*str) )
-		return GF_OUT_OF_MEM;
+	
+	// Validate reallocation success before proceeding
+	if (l1) {
+		char *temp = gf_realloc((*str), sizeof(char)*(l1+l2+lsep+1));
+		if (!temp) return GF_OUT_OF_MEM;
+		(*str) = temp;
+	} else {
+		char *temp = gf_realloc(NULL, sizeof(char)*(l2+lsep+1));
+		if (!temp) return GF_OUT_OF_MEM;
+		(*str) = temp;
+		l1 = 0;
+	}
