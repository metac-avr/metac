-	else (*str) = gf_realloc((*str), sizeof(char)*(l2+lsep+1));
-
-	if (! (*str) )
-		return GF_OUT_OF_MEM;
+	
+	if (l1) {
+		new_str = gf_realloc((*str), sizeof(char)*(l1+l2+lsep+1));
+		if (!new_str) return GF_OUT_OF_MEM;
+		(*str) = new_str;
+	} else {
+		new_str = gf_realloc((*str), sizeof(char)*(l2+lsep+1));
+		if (!new_str) return GF_OUT_OF_MEM;
+		(*str) = new_str;
+	}
