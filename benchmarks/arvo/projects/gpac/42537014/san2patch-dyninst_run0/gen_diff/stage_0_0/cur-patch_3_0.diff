diff --git a/src/utils/error.c b/src/utils/error.c
index 23c5105d6..3626fc2b8 100644
--- a/src/utils/error.c
+++ b/src/utils/error.c
@@ -2166,0 +2167 @@ GF_Err gf_dynstrcat(char **str, const char *to_append, const char *sep)
