diff --git a/src/media_tools/mpegts.c b/src/media_tools/mpegts.c
index 38d2d9e2e..9fd005667 100644
--- a/src/media_tools/mpegts.c
+++ b/src/media_tools/mpegts.c
@@ -1801,3 +1801,9 @@ static void gf_m2ts_process_pmt(GF_M2TS_Demuxer *ts, GF_M2TS_SECTION_ES *pmt, GF
-
-		evt_type = (status&GF_M2TS_TABLE_FOUND) ? GF_M2TS_EVT_PMT_FOUND : GF_M2TS_EVT_PMT_UPDATE;
-		if (ts->on_event) ts->on_event(ts, evt_type, pmt->program);
+// FIXME: Crash CWE-125: Out-of-bounds Read
+ 
+		// Add bounds checking to prevent out-of-bounds read
+		if (pmt && pmt->program && (u8*)pmt->program + 272 <= (u8*)pmt->program + sizeof(GF_M2TS_Program) - 8) {
+			evt_type = (status&GF_M2TS_TABLE_FOUND) ? GF_M2TS_EVT_PMT_FOUND : GF_M2TS_EVT_PMT_UPDATE;
+			if (ts->on_event) ts->on_event(ts, evt_type, pmt->program);
+		} else {
+			GF_LOG(GF_LOG_ERROR, GF_LOG_CONTAINER, ("[M2TS] Invalid buffer access detected, skipping event callback\n"));
+		}
