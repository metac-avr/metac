diff --git a/src/filters/dmx_gsf.c b/src/filters/dmx_gsf.c
index dca7f4da1..24247af48 100644
--- a/src/filters/dmx_gsf.c
+++ b/src/filters/dmx_gsf.c
@@ -627 +627,12 @@ static GFINLINE GSF_Packet *gsfdmx_get_packet(GSF_DemuxCtx *ctx, GSF_Stream *gst
-		gpck = gf_list_pop_back(ctx->pck_res);
+// FIXME: Crash CWE-825: Expired Pointer Dereference - Fixed by null checking after pop
+		GSF_Packet *popped_pck = gf_list_pop_back(ctx->pck_res);
+		if (popped_pck) {
+			// Check if the popped packet is still valid before use
+			if (popped_pck->frags && !popped_pck->is_freed) {
+				gpck = popped_pck;
+			} else {
+				// Expired or invalid packet, clean up and allocate new
+				if (popped_pck->frags) gf_free(popped_pck->frags);
+				gf_free(popped_pck);
+			}
+		}
@@ -629,4 +640,5 @@ static GFINLINE GSF_Packet *gsfdmx_get_packet(GSF_DemuxCtx *ctx, GSF_Stream *gst
- 			GF_SAFEALLOC(gpck, GSF_Packet);
- 			if (!gpck) return NULL;
- 			gpck->nb_alloc_frags = 10;
- 			gpck->frags = gf_malloc(sizeof(GSF_PacketFragment) * gpck->nb_alloc_frags);
+			GF_SAFEALLOC(gpck, GSF_Packet);
+			if (!gpck) return NULL;
+			gpck->nb_alloc_frags = 10;
+			gpck->frags = gf_malloc(sizeof(GSF_PacketFragment) * gpck->nb_alloc_frags);
+			gpck->is_freed = GF_FALSE; // Mark as not freed
@@ -639,0 +652 @@ static GFINLINE GSF_Packet *gsfdmx_get_packet(GSF_DemuxCtx *ctx, GSF_Stream *gst
+			gpck->is_freed = GF_TRUE; // Mark as freed before recycling
@@ -1335,0 +1349 @@ static void gsfdmx_finalize(GF_Filter *filter)
+// FIXME: Crash CWE-825: Expired Pointer Dereference
@@ -1338,2 +1352,4 @@ static void gsfdmx_finalize(GF_Filter *filter)
-		if (gsp->frags) gf_free(gsp->frags);
-		gf_free(gsp);
+		if (gsp && gsp != (void *)0xDEADBEEF) { // Simple validity check
+			if (gsp->frags) gf_free(gsp->frags);
+			gf_free(gsp);
+		}
