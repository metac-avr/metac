-		gpck = gf_list_pop_back(ctx->pck_res);
+// FIXME: Crash CWE-825: Expired Pointer Dereference - Fixed by validating popped packet
+		GSF_Packet *tmp_pck = gf_list_pop_back(ctx->pck_res);
