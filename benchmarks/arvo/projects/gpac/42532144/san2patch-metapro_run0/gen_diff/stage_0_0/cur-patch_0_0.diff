diff --git a/src/filters/reframe_mp3.c b/src/filters/reframe_mp3.c
index f5a852d4d..c23c9f639 100644
--- a/src/filters/reframe_mp3.c
+++ b/src/filters/reframe_mp3.c
@@ -267 +267,7 @@ void id3dmx_flush(GF_Filter *filter, u8 *id3_buf, u32 id3_buf_size, GF_FilterPid
-
+		
+		// Check for potential integer overflow before buffer allocation
+		if (fsize > GF_UINT_MAX - 4) {
+			GF_LOG(GF_LOG_ERROR, GF_LOG_MEDIA, ("[MP3Dmx] Invalid ID3 frame size %d\n", fsize));
+			break;
+		}
+ 
@@ -304,0 +311,6 @@ void id3dmx_flush(GF_Filter *filter, u8 *id3_buf, u32 id3_buf_size, GF_FilterPid
+				// Validate pic_size to prevent out-of-bounds read
+				if (pic_size > fsize) {
+					GF_LOG(GF_LOG_ERROR, GF_LOG_MEDIA, ("[MP3Dmx] Invalid picture size %d exceeds frame size %d\n", pic_size, fsize));
+					break;
+				}
+
