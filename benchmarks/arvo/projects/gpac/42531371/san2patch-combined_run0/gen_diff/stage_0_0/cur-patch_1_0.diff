diff --git a/src/filters/in_rtp_sdp.c b/src/filters/in_rtp_sdp.c
index 43507f077..84939f4fd 100644
--- a/src/filters/in_rtp_sdp.c
+++ b/src/filters/in_rtp_sdp.c
@@ -325,0 +326,26 @@ void rtpin_load_sdp(GF_RTPIn *rtp, char *sdp_text, u32 sdp_len, GF_RTPInStream *
+// FIXME: Crash CWE-787: Out-of-bounds Write
+  	// Validate input to prevent buffer overflow in gf_sdp_info_parse
+	if (sdp_text == NULL) {
+		return;
+	}
+	
+	// Pre-process SDP text to ensure no line exceeds buffer limit (3000 bytes)
+	u32 line_length = 0;
+	u32 pos = 0;
+	char *current = sdp_text;
+	
+	while (pos < sdp_len && *current != '\0') {
+		if (*current == '\n' || *current == '\r') {
+			line_length = 0;
+		} else {
+			line_length++;
+			// If line exceeds safe limit, reject the input
+			if (line_length >= 2999) { // Leave margin for null terminator and safety
+				GF_LOG(GF_LOG_ERROR, GF_LOG_RTP, ("[RTPIn] SDP input contains line too long for buffer\n"));
+				return;
+			}
+		}
+		current++;
+		pos++;
+	}
+	
