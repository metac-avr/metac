diff --git a/src/utils/xml_parser.c b/src/utils/xml_parser.c
index 30f4e3e69..ce9052361 100644
--- a/src/utils/xml_parser.c
+++ b/src/utils/xml_parser.c
@@ -1885 +1885,10 @@ GF_Err gf_xml_dom_parse_string(GF_DOMParser *dom, char *string)
-	dom->stack = gf_list_new();
+	if (!string) return GF_BAD_PARAM;
+	// Add bounds checking to prevent buffer overflow
+	size_t string_len = 0;
+	char *temp_ptr = string;
+	while (string_len < 5001 && *temp_ptr) {
+		string_len++;
+		temp_ptr++;
+	}
+	if (string_len >= 5001) return GF_CORRUPTED_DATA;
+ 	dom->stack = gf_list_new();
