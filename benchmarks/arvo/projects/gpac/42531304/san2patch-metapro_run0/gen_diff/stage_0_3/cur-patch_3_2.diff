diff --git a/src/utils/xml_parser.c b/src/utils/xml_parser.c
index 30f4e3e69..b5ee3db02 100644
--- a/src/utils/xml_parser.c
+++ b/src/utils/xml_parser.c
@@ -975 +975 @@ static GF_Err xml_sax_append_string(GF_SAXParser *parser, char *string)
-{
+ {
@@ -977 +977,13 @@ static GF_Err xml_sax_append_string(GF_SAXParser *parser, char *string)
-	u32 nl_size = string ? (u32) strlen(string) : 0;
+	u32 nl_size = 0;
+	
+	if (string) {
+		char *end = strchr(string, '\0');
+		if (end) {
+			nl_size = (u32)(end - string);
+		} else {
+			// If no null terminator found, use a safe maximum length
+			// This prevents reading beyond allocated memory
+			nl_size = 0;
+			while (string[nl_size] != '\0' && nl_size < 5001) nl_size++;
+		}
+	}
