diff --git a/src/utils/xml_parser.c b/src/utils/xml_parser.c
index 30f4e3e69..53a6212a9 100644
--- a/src/utils/xml_parser.c
+++ b/src/utils/xml_parser.c
@@ -1098,0 +1099,10 @@ static GF_Err gf_xml_sax_parse_intern(GF_SAXParser *parser, char *current)
+	if (current[strlen(current) - 1] != '\0') {
+		size_t len = strlen(current);
+		char *terminated = (char *)gf_malloc(len + 1);
+		if (!terminated) return GF_OUT_OF_MEM;
+		memcpy(terminated, current, len);
+		terminated[len] = '\0';
+		xml_sax_append_string(parser, terminated);
+		gf_free(terminated);
+		return xml_sax_parse(parser, GF_FALSE);
+	}
