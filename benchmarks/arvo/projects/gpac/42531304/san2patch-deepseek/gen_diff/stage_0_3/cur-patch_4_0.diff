diff --git a/src/utils/xml_parser.c b/src/utils/xml_parser.c
index 30f4e3e69..8e91a8bb1 100644
--- a/src/utils/xml_parser.c
+++ b/src/utils/xml_parser.c
@@ -1099 +1099,9 @@ static GF_Err gf_xml_sax_parse_intern(GF_SAXParser *parser, char *current)
-	xml_sax_append_string(parser, current);
+	{
+		size_t len = strlen(current);
+		char *safe_str = (char *)gf_malloc(len + 1);
+		if (!safe_str) return GF_OUT_OF_MEM;
+		memcpy(safe_str, current, len);
+		safe_str[len] = '\0';
+		xml_sax_append_string(parser, safe_str);
+		gf_free(safe_str);
+	}
