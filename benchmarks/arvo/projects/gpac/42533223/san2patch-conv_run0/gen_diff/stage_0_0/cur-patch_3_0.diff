diff --git a/src/filters/inspect.c b/src/filters/inspect.c
index 3f87796a5..29ad06bee 100644
--- a/src/filters/inspect.c
+++ b/src/filters/inspect.c
@@ -3216,0 +3217,4 @@ static void inspect_dump_packet(GF_InspectCtx *ctx, FILE *dump, GF_FilterPacket
+			if (size < pctx->nalu_size_length) {
+				inspect_printf(dump, "   <!-- Insufficient data for NALU size field -->\n");
+				break;
+			}
@@ -4460 +4464 @@ static GF_Err inspect_process(GF_Filter *filter)
