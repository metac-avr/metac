@@ -4502 +4506,12 @@ static GF_Err inspect_process(GF_Filter *filter)
-					inspect_dump_packet(ctx, pctx->tmp, pck, pctx->idx, pctx->pck_num, pctx);
+					// Add bounds checking before calling inspect_dump_packet to prevent out-of-bounds read
