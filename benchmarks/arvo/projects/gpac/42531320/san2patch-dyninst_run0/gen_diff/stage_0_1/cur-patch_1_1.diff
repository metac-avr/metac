diff --git a/src/filters/inspect.c b/src/filters/inspect.c
index 3f87796a5..c9a77727a 100644
--- a/src/filters/inspect.c
+++ b/src/filters/inspect.c
@@ -480,0 +481,2 @@ static void dump_mdcv(FILE *dump, GF_BitStream *bs, Bool isMPEG)
+	
+	// Validate available bits before reading each 16-bit value
@@ -481,0 +484,4 @@ static void dump_mdcv(FILE *dump, GF_BitStream *bs, Bool isMPEG)
+		if (gf_bs_bits_available(bs) < 32) { // Need 32 bits (2*16) per iteration
+			inspect_printf(dump, " Insufficient data for mdcv");
+			return;
+		}
@@ -484,0 +491,6 @@ static void dump_mdcv(FILE *dump, GF_BitStream *bs, Bool isMPEG)
+	
+	if (gf_bs_bits_available(bs) < 128) { // Need 128 bits (2*16 + 2*32) for remaining data
+		inspect_printf(dump, " Insufficient data for mdcv");
+		return;
+	}
+	
