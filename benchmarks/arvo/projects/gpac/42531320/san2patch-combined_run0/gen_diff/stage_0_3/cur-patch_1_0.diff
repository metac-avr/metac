diff --git a/src/filters/inspect.c b/src/filters/inspect.c
index 3f87796a5..2325eacdb 100644
--- a/src/filters/inspect.c
+++ b/src/filters/inspect.c
@@ -480,0 +481,4 @@ static void dump_mdcv(FILE *dump, GF_BitStream *bs, Bool isMPEG)
+	
+	// Validate bitstream has enough data before reading
+	if (gf_bs_available(bs) < 28) return; // Minimum 28 bytes needed for all reads
+	
diff --git a/src/utils/bitstream.c b/src/utils/bitstream.c
index 0697e490a..8fa7eb6cb 100644
--- a/src/utils/bitstream.c
+++ b/src/utils/bitstream.c
@@ -567,0 +568,7 @@ u32 gf_bs_read_int(GF_BitStream *bs, u32 nBits)
+	// Add bounds checking to prevent out-of-bounds read
+	if (bs && nBits > 0) {
+		u32 remaining_bits = (bs->size - bs->position) * 8 + (8 - bs->nbBits);
+		if (nBits > remaining_bits) {
+			nBits = remaining_bits;
+		}
+	}
