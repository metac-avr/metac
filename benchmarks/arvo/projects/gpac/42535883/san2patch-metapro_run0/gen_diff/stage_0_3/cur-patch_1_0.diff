diff --git a/src/odf/descriptors.c b/src/odf/descriptors.c
index d5db4e0cd..1f53341d1 100644
--- a/src/odf/descriptors.c
+++ b/src/odf/descriptors.c
@@ -1220,2 +1220,12 @@ GF_Err gf_odf_vvc_cfg_write_bs(GF_VVCConfig *cfg, GF_BitStream *bs)
-				gf_bs_write_data(bs, cfg->general_constraint_info, cfg->num_constraint_info - 1);
-				gf_bs_write_int(bs, cfg->general_constraint_info[cfg->num_constraint_info - 1], 6);
+				// Validate array access to prevent out-of-bounds read
+				if (cfg->num_constraint_info > 0 && cfg->general_constraint_info != NULL) {
+					gf_bs_write_data(bs, cfg->general_constraint_info, cfg->num_constraint_info - 1);
+					// Safe access with bounds check
+					if ((cfg->num_constraint_info - 1) < cfg->num_constraint_info) {
+						gf_bs_write_int(bs, cfg->general_constraint_info[cfg->num_constraint_info - 1], 6);
+					} else {
+						gf_bs_write_int(bs, 0, 6);
+					}
+				} else {
+					gf_bs_write_int(bs, 0, 6);
+				}
