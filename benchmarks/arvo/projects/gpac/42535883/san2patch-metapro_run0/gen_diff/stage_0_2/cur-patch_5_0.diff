diff --git a/src/odf/descriptors.c b/src/odf/descriptors.c
index d5db4e0cd..11a1a83c9 100644
--- a/src/odf/descriptors.c
+++ b/src/odf/descriptors.c
@@ -1187 +1187,2 @@ GF_Err gf_odf_vvc_cfg_write_bs(GF_VVCConfig *cfg, GF_BitStream *bs)
-	u32 i, count;
+// FIXME: Crash CWE-125: Out-of-bounds Read
+ 	u32 i, count;
@@ -1220,2 +1221,13 @@ GF_Err gf_odf_vvc_cfg_write_bs(GF_VVCConfig *cfg, GF_BitStream *bs)
-				gf_bs_write_data(bs, cfg->general_constraint_info, cfg->num_constraint_info - 1);
-				gf_bs_write_int(bs, cfg->general_constraint_info[cfg->num_constraint_info - 1], 6);
+				// Bounds check to prevent out-of-bounds read
+				if (cfg->num_constraint_info <= 64) { // Max safe buffer size check
+					if (cfg->num_constraint_info > 1) {
+						gf_bs_write_data(bs, cfg->general_constraint_info, cfg->num_constraint_info - 1);
+					}
+					if (cfg->num_constraint_info > 0) {
+						gf_bs_write_int(bs, cfg->general_constraint_info[cfg->num_constraint_info - 1], 6);
+					}
+				} else {
+					// Truncate to safe size if exceeded
+					gf_bs_write_data(bs, cfg->general_constraint_info, 63);
+					gf_bs_write_int(bs, cfg->general_constraint_info[63], 6);
+				}
