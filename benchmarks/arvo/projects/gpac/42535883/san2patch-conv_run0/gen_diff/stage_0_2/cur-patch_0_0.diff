diff --git a/src/odf/descriptors.c b/src/odf/descriptors.c
index d5db4e0cd..665bef25c 100644
--- a/src/odf/descriptors.c
+++ b/src/odf/descriptors.c
@@ -1186,0 +1187 @@ GF_Err gf_odf_vvc_cfg_write_bs(GF_VVCConfig *cfg, GF_BitStream *bs)
+  	// Fixed CWE-125: Out-of-bounds Read by adding bounds checking
@@ -1220,2 +1221,7 @@ GF_Err gf_odf_vvc_cfg_write_bs(GF_VVCConfig *cfg, GF_BitStream *bs)
-				gf_bs_write_data(bs, cfg->general_constraint_info, cfg->num_constraint_info - 1);
-				gf_bs_write_int(bs, cfg->general_constraint_info[cfg->num_constraint_info - 1], 6);
+				// Add bounds check before accessing general_constraint_info
+				if (cfg->num_constraint_info > 0) {
+					gf_bs_write_data(bs, cfg->general_constraint_info, cfg->num_constraint_info - 1);
+					gf_bs_write_int(bs, cfg->general_constraint_info[cfg->num_constraint_info - 1], 6);
+				} else {
+					gf_bs_write_int(bs, 0, 6);
+				}
@@ -1234,2 +1240,5 @@ GF_Err gf_odf_vvc_cfg_write_bs(GF_VVCConfig *cfg, GF_BitStream *bs)
-				if (cfg->ptl_sublayer_present_mask & (1<<idx))
-					gf_bs_write_u8(bs, cfg->sublayer_level_idc[idx]);
+				if (cfg->ptl_sublayer_present_mask & (1<<idx)) {
+					// Add bounds check for sublayer_level_idc access
+					if (idx < 8) // Assuming max 8 temporal layers
+						gf_bs_write_u8(bs, cfg->sublayer_level_idc[idx]);
+				}
@@ -1240 +1249,3 @@ GF_Err gf_odf_vvc_cfg_write_bs(GF_VVCConfig *cfg, GF_BitStream *bs)
-				gf_bs_write_u32(bs, cfg->sub_profiles_idc[idx]);
+				// Add bounds check for sub_profiles_idc access
+				if (idx < cfg->num_sub_profiles)
+					gf_bs_write_u32(bs, cfg->sub_profiles_idc[idx]);
@@ -1254,0 +1266,3 @@ GF_Err gf_odf_vvc_cfg_write_bs(GF_VVCConfig *cfg, GF_BitStream *bs)
+		// Add null check for ar
+		if (!ar) continue;
+
@@ -1268,0 +1283,3 @@ GF_Err gf_odf_vvc_cfg_write_bs(GF_VVCConfig *cfg, GF_BitStream *bs)
+			// Add null check for sl
+			if (!sl) continue;
+			
@@ -1274 +1291,4 @@ GF_Err gf_odf_vvc_cfg_write_bs(GF_VVCConfig *cfg, GF_BitStream *bs)
-			gf_bs_write_data(bs, sl->data, sl->size);
+			// Add bounds check for data access
+			if (sl->data && sl->size > 0) {
+				gf_bs_write_data(bs, sl->data, sl->size);
+			}
