diff --git a/src/odf/descriptors.c b/src/odf/descriptors.c
index e71cdca50..7439ddd7c 100644
--- a/src/odf/descriptors.c
+++ b/src/odf/descriptors.c
@@ -2411,5 +2411,7 @@ void gf_odf_ac4_cfg_clean_list(GF_AC4Config *cfg)
-	for (i = 0; i < gf_list_count(cfg->stream.presentations); i++) {
-		pres = gf_list_get(cfg->stream.presentations, i);
-		if (!pres || !pres->substream_groups) {
-			continue;
-		}
+	GF_EXPORT
+Bool gf_ac4_parser_bs(GF_BitStream *bs, GF_AC4Config *hdr, Bool full_parse)
+{
+	u32 sync_word;
+	u64 pos;
+	GF_AC4StreamInfo* stream;
+	if (!hdr || !AC4_FindSyncCodeBS(bs)) return GF_FALSE;
@@ -2417,5 +2419,2 @@ void gf_odf_ac4_cfg_clean_list(GF_AC4Config *cfg)
-		for (j = 0; pres && j < gf_list_count(pres->substream_groups); j++) {
-			group = gf_list_get(pres->substream_groups, j);
-			if (!group || !group->substreams) {
-				continue;
-			}
+	pos = gf_bs_get_position(bs);
+	stream = &(hdr->stream);
@@ -2423,5 +2422,4 @@ void gf_odf_ac4_cfg_clean_list(GF_AC4Config *cfg)
-			for (s = 0; group && s < gf_list_count(group->substreams); s++) {
-				subs = gf_list_get(group->substreams, s);
-				if (!subs) {
-					continue;
-				}
+	// Initialize the list to NULL to prevent use-after-free
+	if (full_parse) {
+		gf_odf_ac4_cfg_clean_list(hdr);
+	}
@@ -2429,7 +2427,14 @@ void gf_odf_ac4_cfg_clean_list(GF_AC4Config *cfg)
-				gf_free(subs);
-			}
-			gf_list_del(group->substreams);
-			gf_free(group);
-		}
-		gf_list_del(pres->substream_groups);
-		gf_free(pres);
+	sync_word = gf_bs_read_u16(bs);
+	if (sync_word != 0xAC40 && sync_word != 0xAC41) {
+		GF_LOG(GF_LOG_ERROR, GF_LOG_CODING, ("[AC4] Wrong sync word detected (0x%X - expecting 0xAC40 or 0xAC41).\n", sync_word));
+		return GF_FALSE;
+	}
+	hdr->header_size = 2;
+
+	gf_ac4_frame_size(bs, hdr);
+
+	if (!gf_ac4_raw_frame(bs, hdr, full_parse)) {
+		GF_LOG(GF_LOG_ERROR, GF_LOG_CODING, ("[AC4] Fail to parse raw ac4 frame\n"));
+
+		gf_bs_seek(bs, pos);
+		return GF_FALSE;
@@ -2437,0 +2443,28 @@ void gf_odf_ac4_cfg_clean_list(GF_AC4Config *cfg)
+	if (stream->bitstream_version <= 1) {
+		// bitstream_version <= 1 is not supported.
+
+		gf_bs_seek(bs, pos);
+		return GF_FALSE;
+	}
+
+	if (sync_word == 0xAC41) {
+		hdr->crc_size = 2;
+	} else {
+		hdr->crc_size = 0;
+	}
+
+	/* fill some AC4 DSI info */
+	stream->ac4_dsi_version = 1;
+	hdr->sample_rate = AC4_SAMPLING_FREQ_TABLE[stream->fs_index];
+	if (stream->fs_index == 0) {
+		hdr->sample_duration = AC4_SAMPLE_DELTA_TABLE_441[stream->frame_rate_index];
+		hdr->media_time_scale = AC4_MEDIA_TIMESCALE_441[stream->frame_rate_index];
+	} else {
+		hdr->sample_duration = AC4_SAMPLE_DELTA_TABLE_48[stream->frame_rate_index];
+		hdr->media_time_scale = AC4_MEDIA_TIMESCALE_48[stream->frame_rate_index];
+	}
+
+	gf_bs_seek(bs, pos);
+	return GF_TRUE;
+}
+
diff --git a/src/media_tools/av_parsers.c b/src/media_tools/av_parsers.c
index cdccbad35..4bdf8e1a9 100644
