-	// clean the GF_List data if exits
-	if (full_parse) {
+	// Initialize the list to NULL to prevent use-after-free
+	if (full_parse && hdr->streams) {
@@ -16011,0 +16012 @@ Bool gf_ac4_parser_bs(GF_BitStream *bs, GF_AC4Config *hdr, Bool full_parse)
+		hdr->streams = NULL; // Prevent subsequent access to freed memory
@@ -16016 +16017 @@ Bool gf_ac4_parser_bs(GF_BitStream *bs, GF_AC4Config *hdr, Bool full_parse)
-		GF_LOG(GF_LOG_ERROR, GF_LOG_CODING, ("[AC4] Wrong sync word detected (0x%X - expecting 0xAC40 or 0xAC41).\n", sync_word));
+		GF_LOG(GF_LOG_ERROR, GF_LOG_CODING, ("[AC4] Wrong sync word detected (0x%X - expecting 0xxAC40 or 0xAC41).\n", sync_word));
