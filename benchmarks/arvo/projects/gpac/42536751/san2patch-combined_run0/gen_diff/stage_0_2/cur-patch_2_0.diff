diff --git a/src/filters/inspect.c b/src/filters/inspect.c
index 2c4324f14..5ae4501b9 100644
--- a/src/filters/inspect.c
+++ b/src/filters/inspect.c
@@ -5122 +5122,13 @@ static GF_Err inspect_process(GF_Filter *filter)
-					inspect_dump_packet_fmt(filter, ctx, pctx->tmp, pck, pctx, pctx->pck_num);
+// Fixed: Added safety check for buffer bounds before accessing packet data
+ 					if (pck != NULL) {
+						u32 data_size = 0;
+						const u8 *data = gf_filter_pck_get_data(pck, &data_size);
+						if (data != NULL && data_size > 0) {
+							inspect_dump_packet_fmt(filter, ctx, pctx->tmp, pck, pctx, pctx->pck_num);
+						} else {
+							GF_LOG(GF_LOG_WARNING, GF_LOG_MEDIA, ("[Inspect] Skipping packet dump for PID %d due to invalid packet data\n", pctx->idx));
+						}
+						
+					} else {
+						GF_LOG(GF_LOG_WARNING, GF_LOG_MEDIA, ("[Inspect] Skipping packet dump for PID %d due to null packet\n", pctx->idx));
+					}
