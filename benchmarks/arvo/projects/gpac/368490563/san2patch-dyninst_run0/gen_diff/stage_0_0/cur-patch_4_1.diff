diff --git a/src/media_tools/mpegts.c b/src/media_tools/mpegts.c
index b22fdbecd..f61f143fe 100644
--- a/src/media_tools/mpegts.c
+++ b/src/media_tools/mpegts.c
@@ -506,0 +507,8 @@ static void gf_m2ts_section_complete(GF_M2TS_Demuxer *ts, GF_M2TS_SectionFilter
+			
+			// Bounds check to prevent out-of-bounds read
+			if (section_start >= sec->length) {
+				GF_LOG(GF_LOG_ERROR, GF_LOG_CONTAINER, ("[MPEG-2 TS] Section start exceeds buffer length\n"));
+				gf_free(section);
+				return;
+			}
+
@@ -507,0 +516,8 @@ static void gf_m2ts_section_complete(GF_M2TS_Demuxer *ts, GF_M2TS_SectionFilter
+			
+			// Additional bounds check
+			if (section->data_size > sec->size - section_start) {
+				GF_LOG(GF_LOG_ERROR, GF_LOG_CONTAINER, ("[MPEG-2 TS] Section data size exceeds available buffer\n"));
+				gf_free(section);
+				return;
+			}
+
@@ -508,0 +525,5 @@ static void gf_m2ts_section_complete(GF_M2TS_Demuxer *ts, GF_M2TS_SectionFilter
+			if (!section->data) {
+				GF_LOG(GF_LOG_ERROR, GF_LOG_CONTAINER, ("[MPEG-2 TS] Failed to allocate section data\n"));
+				gf_free(section);
+				return;
+			}
