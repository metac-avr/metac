diff --git a/src/media_tools/mpegts.c b/src/media_tools/mpegts.c
index b22fdbecd..e93ea7733 100644
--- a/src/media_tools/mpegts.c
+++ b/src/media_tools/mpegts.c
@@ -506,0 +507,6 @@ static void gf_m2ts_section_complete(GF_M2TS_Demuxer *ts, GF_M2TS_SectionFilter
+			// Validate that section_start does not exceed section size before calculating data_size
+			if (section_start > sec->section_size) {
+				GF_LOG(GF_LOG_ERROR, GF_LOG_CONTAINER, ("[MPEG-2 TS] Invalid section start position\n"));
+				gf_free(section);
+				return;
+			}
@@ -507,0 +514,6 @@ static void gf_m2ts_section_complete(GF_M2TS_Demuxer *ts, GF_M2TS_SectionFilter
+			// Validate that data_size is not negative and does not exceed remaining buffer
+			if (section->data_size > (sec->section_size - section_start)) {
+				GF_LOG(GF_LOG_ERROR, GF_LOG_CONTAINER, ("[MPEG-2 TS] Section data size exceeds buffer bounds\n"));
+				gf_free(section);
+				return;
+			}
