diff --git a/src/filters/isoffin_read_ch.c b/src/filters/isoffin_read_ch.c
index 225c8ef15..5f25a9e24 100644
--- a/src/filters/isoffin_read_ch.c
+++ b/src/filters/isoffin_read_ch.c
@@ -302 +302,14 @@ void isor_reader_get_sample_from_item(ISOMChannel *ch)
-	gf_isom_extract_meta_item_mem(ch->owner->mov, GF_TRUE, 0, ch->item_id, &ch->sample->data, &ch->sample->dataLength, &ch->static_sample->alloc_size, NULL, GF_FALSE);
+	
+	// Reset pointers before extraction to prevent use of expired pointers
+	ch->sample->data = NULL;
+	ch->sample->dataLength = 0;
+	
+	GF_Err err = gf_isom_extract_meta_item_mem(ch->owner->mov, GF_TRUE, 0, ch->item_id, &ch->sample->data, &ch->sample->dataLength, &ch->static_sample->alloc_size, NULL, GF_FALSE);
+	
+	// Validate results and check for null pointers
+	if (err != GF_OK || ch->sample->data == NULL || ch->sample->dataLength == 0) {
+		ch->last_state = err != GF_OK ? err : GF_BAD_PARAM;
+		ch->sample->data = NULL;
+		ch->sample->dataLength = 0;
+		return;
+	}
