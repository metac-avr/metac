diff --git a/src/filters/isoffin_read.c b/src/filters/isoffin_read.c
index 2f08cf8f9..0e0741ecf 100644
--- a/src/filters/isoffin_read.c
+++ b/src/filters/isoffin_read.c
@@ -1474,21 +1474,25 @@ static GF_Err isoffin_process(GF_Filter *filter)
-		//eos not sent on this channel, we are active
-		if (!ch->eos_sent)
-			is_active = GF_TRUE;
-
-		while (nb_pck) {
-			ch->sample_data_offset = 0;
-			if (!in_is_flush && !read->full_segment_flush && gf_filter_pid_would_block(ch->pid) )
-				break;
-
-			if (ch->item_id) {
-				isor_reader_get_sample_from_item(ch);
-			} else {
-				isor_reader_get_sample(ch);
-			}
-			if (!ch->sample && ch->pck) {
-				gf_filter_pck_discard(ch->pck);
-				ch->pck = NULL;
-				if (ch->static_sample) {
-					ch->static_sample->data = NULL;
-					ch->static_sample->alloc_size=0;
-				}
+        //eos not sent on this channel, we are active
+        if (!ch->eos_sent)
+            is_active = GF_TRUE;
+
+        while (nb_pck) {
+            ch->sample_data_offset = 0;
+            if (!in_is_flush && !read->full_segment_flush && gf_filter_pid_would_block(ch->pid) )
+                break;
+// FIXME: Crash CWE-825: Expired Pointer Dereference
+ 
+            if (ch->item_id) {
+                // Validate pointer before use to prevent expired pointer dereference
+                if (ch != NULL) {
+                    isor_reader_get_sample_from_item(ch);
+                }
+            } else {
+                isor_reader_get_sample(ch);
+            }
+            if (!ch->sample && ch->pck) {
+                gf_filter_pck_discard(ch->pck);
+                ch->pck = NULL;
+                if (ch->static_sample) {
+                    ch->static_sample->data = NULL;
+                    ch->static_sample->alloc_size=0;
+                }
