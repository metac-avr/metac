-	if (ch->is_encrypted && ch->is_cenc) {
-		isor_update_cenc_info(ch, GF_TRUE);
+	if (ch->sample) {
+		ch->sample->IsRAP = RAP;
+		ch->sample->duration = 1000;
+		ch->dts = ch->cts = 1000 * ch->au_seq_num;
