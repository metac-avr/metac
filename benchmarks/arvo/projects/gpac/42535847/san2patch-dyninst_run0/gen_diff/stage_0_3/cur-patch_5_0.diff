diff --git a/src/isomedia/meta.c b/src/isomedia/meta.c
index 65660dcba..8655a8817 100644
--- a/src/isomedia/meta.c
+++ b/src/isomedia/meta.c
@@ -372,3 +372,15 @@ static GF_Err gf_isom_extract_meta_item_intern(GF_ISOFile *file, Bool root_meta,
-					hvcc->config->write_annex_b = GF_TRUE;
-					gf_odf_hevc_cfg_write_bs(hvcc->config, item_bs);
-					hvcc->config->write_annex_b = GF_FALSE;
+					// Safe pointer access with null check and boundary validation
+					if (hvcc->config != NULL) {
+						// Verify memory hasn't been freed by checking a known field
+						if ((u8*)hvcc->config >= (u8*)0x1000) { // Basic memory range check
+							hvcc->config->write_annex_b = GF_TRUE;
+							gf_odf_hevc_cfg_write_bs(hvcc->config, item_bs);
+							hvcc->config->write_annex_b = GF_FALSE;
+						} else {
+							GF_LOG(GF_LOG_ERROR, GF_LOG_CONTAINER, ("HEVC config pointer in invalid memory range\n"));
+							return GF_BAD_PARAM;
+						}
+					} else {
+						GF_LOG(GF_LOG_ERROR, GF_LOG_CONTAINER, ("HEVC config pointer is NULL\n"));
+						return GF_BAD_PARAM;
+					}
@@ -383,3 +395,15 @@ static GF_Err gf_isom_extract_meta_item_intern(GF_ISOFile *file, Bool root_meta,
-					avcc->config->write_annex_b = GF_TRUE;
-					gf_odf_avc_cfg_write_bs(avcc->config, item_bs);
-					avcc->config->write_annex_b = GF_FALSE;
+					// Safe pointer access with null check and boundary validation
+					if (avcc->config != NULL) {
+						// Verify memory hasn't been freed by checking a known field
