+							avcc->config->write_annex_b = GF_TRUE;
+							gf_odf_avc_cfg_write_bs(avcc->config, item_bs);
+							avcc->config->write_annex_b = GF_FALSE;
+						} else {
+							GF_LOG(GF_LOG_ERROR, GF_LOG_CONTAINER, ("AVC config pointer in invalid memory range\n"));
+							return GF_BAD_PARAM;
+						}
+					} else {
+						GF_LOG(GF_LOG_ERROR, GF_LOG_CONTAINER, ("AVC config pointer is NULL\n"));
+						return GF_BAD_PARAM;
+					}
