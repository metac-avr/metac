diff --git a/src/scene_manager/swf_parse.c b/src/scene_manager/swf_parse.c
index a8448c413..7f83b85fa 100644
--- a/src/scene_manager/swf_parse.c
+++ b/src/scene_manager/swf_parse.c
@@ -2034,3 +2034,10 @@ static GF_Err swf_soundstream_block(SWFReader *read)
-		swf_read_data(read, frame, size-4);
-		if (gf_fwrite(bytes, sizeof(char)*4, read->sound_stream->output)!=4) e = GF_IO_ERR;
-		if (gf_fwrite(frame, sizeof(char)*(size-4), read->sound_stream->output) != size-4) e = GF_IO_ERR;
+		// Validate size before reading to prevent buffer overflow
+		if (size > 4 && size - 4 <= alloc_size) {
+			swf_read_data(read, frame, size-4);
+			if (gf_fwrite(bytes, sizeof(char)*4, read->sound_stream->output)!=4) e = GF_IO_ERR;
+			if (gf_fwrite(frame, sizeof(char)*(size-4), read->sound_stream->output) != size-4) e = GF_IO_ERR;
+		} else {
+			// Skip invalid frame to prevent out-of-bounds read
+			e = GF_CORRUPTED_DATA;
+			break;
+		}
