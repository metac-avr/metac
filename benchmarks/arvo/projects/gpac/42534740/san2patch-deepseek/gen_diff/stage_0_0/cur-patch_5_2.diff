diff --git a/src/filters/dmx_gsf.c b/src/filters/dmx_gsf.c
index eee917756..12fa76f26 100644
--- a/src/filters/dmx_gsf.c
+++ b/src/filters/dmx_gsf.c
@@ -343,22 +343,85 @@ static GF_Err gsfdmx_read_prop(GF_BitStream *bs, GF_PropertyValue *p)
-		break;
-
-	case GF_PROP_STRING_LIST:
-		len2 = gsfdmx_read_vlen(bs);
-		p->value.string_list.nb_items = len2;
-		p->value.string_list.vals = gf_malloc(sizeof(char*) * len2);
-		for (i=0; i<len2; i++) {
-			len = gsfdmx_read_vlen(bs);
-			char *str = gf_malloc(sizeof(char)*(len+1));
-			gf_bs_read_data(bs, str, len);
-			str[len] = 0;
-			p->value.string_list.vals[i] = str;
-		}
-		break;
-
-	case GF_PROP_UINT_LIST:
-	case GF_PROP_SINT_LIST:
-		p->value.uint_list.nb_items = len = gsfdmx_read_vlen(bs);
-		p->value.uint_list.vals = gf_malloc(sizeof(u32)*len);
-		for (i=0; i<len; i++) {
-			p->value.uint_list.vals[i] = gsfdmx_read_vlen(bs);
-		}
+        switch (p->type) {
+        case GF_PROP_STRING_LIST:
+                len2 = gsfdmx_read_vlen(bs);
+                if (len2 == 0) {
+                        p->value.string_list.nb_items = 0;
+                        p->value.string_list.vals = NULL;
+                        break;
+                }
+                p->value.string_list.nb_items = len2;
+                p->value.string_list.vals = gf_malloc(sizeof(char*) * len2);
+                if (!p->value.string_list.vals) {
+                        p->value.string_list.nb_items = 0;
+                        p->value.string_list.vals = NULL;
+                        break;
+                }
+                for (i=0; i<len2; i++) {
+                        len = gsfdmx_read_vlen(bs);
+                        if (len == (u32)-1) {
+                                p->value.string_list.nb_items = i;
+                                break;
+                        }
+                        char *str = gf_malloc(sizeof(char)*(len+1));
+                        if (!str) {
+                                p->value.string_list.nb_items = i;
+                                break;
+                        }
+                        if (gf_bs_read_data(bs, str, len) != len) {
+                                gf_free(str);
+                                p->value.string_list.nb_items = i;
+                                break;
+                        }
+                        str[len] = 0;
+                        p->value.string_list.vals[i] = str;
+                }
+                break;
+
+        case GF_PROP_UINT_LIST:
+        case GF_PROP_SINT_LIST:
+                p->value.uint_list.nb_items = len = gsfdmx_read_vlen(bs);
+                p->value.uint_list.vals = gf_malloc(sizeof(u32)*len);
+                if (!p->value.uint_list.vals && len) {
+                        p->value.uint_list.nb_items = 0;
+                        p->value.uint_list.vals = NULL;
+                        break;
+                }
+                for (i=0; i<len; i++) {
+                        p->value.uint_list.vals[i] = gsfdmx_read_vlen(bs);
+                }
+                break;
+
+        case GF_PROP_4CC_LIST:
+                len2 = gsfdmx_read_vlen(bs);
+                p->value.uint_list.nb_items = len2;
+                p->value.uint_list.vals = gf_malloc(sizeof(u32)*len2);
+                if (!p->value.uint_list.vals && len2) {
+                        p->value.uint_list.nb_items = 0;
+                        p->value.uint_list.vals = NULL;
+                        break;
+                }
+                for (i=0; i<len2; i++) {
+                        p->value.uint_list.vals[i] = gsfdmx_read_vlen(bs);
+                }
+                break;
+
+        case GF_PROP_VEC2I_LIST:
+                len2 = gsfdmx_read_vlen(bs);
+                p->value.uint_list.nb_items = len2;
+                p->value.uint_list.vals = gf_malloc(sizeof(u32)*len2);
+                if (!p->value.uint_list.vals && len2) {
+                        p->value.uint_list.nb_items = 0;
+                        p->value.uint_list.vals = NULL;
+                        break;
+                }
+                for (i=0; i<len2; i++) {
+                        p->value.uint_list.vals[i] = gsfdmx_read_vlen(bs);
+                }
+                break;
+
+        case GF_PROP_POINTER:
+        default:
+                break;
+        }
+
+        return GF_OK;
+}		}
