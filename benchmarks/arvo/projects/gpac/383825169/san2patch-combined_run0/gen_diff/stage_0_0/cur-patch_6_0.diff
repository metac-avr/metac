diff --git a/src/scene_manager/swf_parse.c b/src/scene_manager/swf_parse.c
index a8448c413..ac031127a 100644
--- a/src/scene_manager/swf_parse.c
+++ b/src/scene_manager/swf_parse.c
@@ -2033,4 +2033,12 @@ static GF_Err swf_soundstream_block(SWFReader *read)
-
-		swf_read_data(read, frame, size-4);
-		if (gf_fwrite(bytes, sizeof(char)*4, read->sound_stream->output)!=4) e = GF_IO_ERR;
-		if (gf_fwrite(frame, sizeof(char)*(size-4), read->sound_stream->output) != size-4) e = GF_IO_ERR;
+		
+		// Fixed: Add bounds check before reading data to prevent buffer overflow
+		if (size > 4 && (size - 4) <= alloc_size) {
+			swf_read_data(read, frame, size-4);
+			if (gf_fwrite(bytes, sizeof(char)*4, read->sound_stream->output)!=4) e = GF_IO_ERR;
+			if (gf_fwrite(frame, sizeof(char)*(size-4), read->sound_stream->output) != size-4) e = GF_IO_ERR;
+		} else {
+			// Handle case where size is invalid or exceeds buffer
+			swf_read_data(read, frame, alloc_size);
+			if (gf_fwrite(bytes, sizeof(char)*4, read->sound_stream->output)!=4) e = GF_IO_ERR;
+			if (gf_fwrite(frame, sizeof(char)*alloc_size, read->sound_stream->output) != alloc_size) e = GF_IO_ERR;
+		}
