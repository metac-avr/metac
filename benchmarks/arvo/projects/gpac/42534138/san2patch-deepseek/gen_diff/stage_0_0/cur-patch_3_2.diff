+static void mpgviddmx_check_dur(GF_Filter *filter, MPEGVideoDMXContext *ctx)
+{
+	u64 dur;
+	if (!ctx->fps_num || !ctx->src_dts_plus_prev_dur) return;
+	dur = ctx->src_dts_plus_prev_dur;
+	dur *= ctx->fps_den;
+	dur /= ctx->fps_num;
+	if (ctx->src_pck_dur != dur) {
+		ctx->src_pck_dur = dur;
