+
+	pck = gf_filter_pid_get_packet(ctx->ipid);
+	if (!pck) {
+		if (gf_filter_pid_is_eos(ctx->ipid)) {
+			gf_filter_pid_set_eos(ctx->opid);
+			return GF_EOS;
@@ -881,0 +959,2 @@ GF_Err mpgviddmx_process(GF_Filter *filter)
+		return GF_OK;
+	}
@@ -883,7 +962,32 @@ GF_Err mpgviddmx_process(GF_Filter *filter)
-		//parse headers
-		//we have a start code loaded, eg the data packet does not have a full start code at the beginning
-		if (sc_type_forced) {
-			gf_bs_reassign_buffer(ctx->bs, start + hdr_offset, remain - hdr_offset);
-			sc_type = forced_sc_type;
-		} else {
-			gf_bs_reassign_buffer(ctx->bs, start, remain);
+	data = gf_filter_pck_get_data(pck, &pck_size);
+	gf_filter_pck_ref_props(&ctx->pck_ref);
+	gf_filter_pck_merge_properties(pck, &ctx->pck_ref);
+
+	mpgviddmx_parse(ctx, data, pck_size);
+
+	gf_filter_pck_unref_props(&ctx->pck_ref);
+	gf_filter_pck_drop(pck);
+	return GF_OK;
+}
+
+static void mpgvdmx_probe_data(GF_FilterProbe *probe)
+{
+	GF_FilterPid *pid = gf_filter_probe_get_pid(probe);
+	gf_filter_pid_set_property(pid, GF_PROP_PID_CODECID, &PROP_UINT(GF_CODECID_MPEG1));
+}
+
+GF_FilterRegister mpgvdmx_register = {
