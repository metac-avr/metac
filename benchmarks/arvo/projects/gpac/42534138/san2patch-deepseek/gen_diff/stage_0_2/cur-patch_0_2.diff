+static void mpgviddmx_finalize(GF_Filter *filter)
+{
+	GF_MPGVidDmxCtx *ctx = gf_filter_get_udta(filter);
+	if (ctx->bs) gf_bs_del(ctx->bs);
+	if (ctx->hdr_store) gf_free(ctx->hdr_store);
+	if (ctx->strbuf) gf_free(ctx->strbuf);
+	gf_free(ctx);
+}
+
+static GF_Err mpgviddmx_initialize(GF_Filter *filter)
+{
+	GF_MPGVidDmxCtx *ctx = gf_filter_get_udta(filter);
+	ctx->opid = gf_filter_pid_new(filter);
+	if (!ctx->opid) return GF_OUT_OF_MEM;
+	gf_filter_pid_set_name(ctx->opid, "video");
+	gf_filter_pid_set_property(ctx->opid, GF_PROP_PID_CODECID, &PROP_UINT(GF_CODECID_MPEG1));
+	gf_filter_pid_set_property(ctx->opid, GF_PROP_PID_STREAM_TYPE, &PROP_UINT(GF_STREAM_VISUAL));
+	gf_filter_pid_set_property(ctx->opid, GF_PROP_PID_DECODER_CONFIG, &PROP_DATA(ctx->raw_dsi, 0));
+	ctx->bs = gf_bs_new(NULL, 0, GF_BITSTREAM_READ);
+	if (!ctx->bs) return GF_OUT_OF_MEM;
+	ctx->hdr_store = gf_malloc(sizeof(char) * 4096);
+	if (!ctx->hdr_store) return GF_OUT_OF_MEM;
+	ctx->bytes_in_header = 0;
+	ctx->trash_trailer = GF_FALSE;
+	return GF_OK;
+}
+
+static GF_Err mpgviddmx_process(GF_Filter *filter)
+{
+	GF_MPGVidDmxCtx *ctx = gf_filter_get_udta(filter);
+	GF_FilterPacket *pck;
+	u8 *data;
+	u32 pck_size;
