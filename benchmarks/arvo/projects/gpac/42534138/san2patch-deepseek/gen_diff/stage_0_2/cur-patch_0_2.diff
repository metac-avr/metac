+static void mpgviddmx_check_dur(GF_Filter *filter, GF_MPGVidDmxCtx *ctx)
+{
+	u64 pck_dur;
+	if (!ctx->frame_rate) return;
+	pck_dur = (u64)(ctx->cur_fps.den * ctx->frame_rate);
+	if (!pck_dur) return;
+	pck_dur = (u64)(ctx->cur_fps.num * 1000 * ctx->cur_fps.den / pck_dur);
+	if (ctx->pck_duration != pck_dur) {
+		ctx->pck_duration = pck_dur;
+		gf_filter_pid_set_property(ctx->opid, GF_PROP_PID_DURATION, &PROP_LONGLGT(ctx->pck_duration));
+	}
+}
+
+static void mpgviddmx_enqueue_or_dispatch(GF_MPGVidDmxCtx *ctx, GF_FilterPacket *pck, Bool dispatch, Bool flush)
+{
+	if (dispatch) {
+		gf_filter_pkt_send(pck);
+	} else {
+		gf_filter_pck_ref_props(&ctx->pck_ref);
+		gf_filter_pck_props_reset(pck);
+		gf_filter_pck_merge_properties(pck, &ctx->pck_ref);
+		gf_filter_pck_drop_properties(&ctx->pck_ref);
+		gf_filter_pck_send(pck);
+	}
+}
+
