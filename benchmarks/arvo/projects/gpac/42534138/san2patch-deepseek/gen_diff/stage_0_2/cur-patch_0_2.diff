+	.private_size = sizeof(GF_MPGVidDmxCtx),
+	.initialize = mpgviddmx_initialize,
+	.finalize = mpgviddmx_finalize,
+	.configure_pid = mpgviddmx_configure_pid,
+	.process = mpgviddmx_process,
+	.probe_data = mpgvdmx_probe_data,
+};
