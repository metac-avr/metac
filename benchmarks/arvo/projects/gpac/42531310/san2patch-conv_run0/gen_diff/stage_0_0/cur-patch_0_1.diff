-				bs->nb_zeros = 0;
-				bs->nb_removed++;
-				res = bs->original[bs->position++];
-			}
-			if (!res) bs->nb_zeros++;
-			else bs->nb_zeros = 0;
-		}
-		return res;
+	if (opt_Leb128Bytes) {
+		*opt_Leb128Bytes = Leb128Bytes;
@@ -470,0 +468,2 @@ static u8 BS_ReadByte(GF_BitStream *bs)
+	return value;
+}
