diff --git a/src/filters/reframe_av1.c b/src/filters/reframe_av1.c
index 8309f74b1..f804bb0a9 100644
--- a/src/filters/reframe_av1.c
+++ b/src/filters/reframe_av1.c
@@ -947,0 +948,5 @@ static GF_Err av1dmx_parse_flush_sample(GF_Filter *filter, GF_AV1DmxCtx *ctx)
+	// Validate that pck_size is within reasonable bounds to prevent buffer overflows
+	if (pck_size == 0 || pck_size > 1000000) {  // 1MB sanity check
+		return GF_NON_COMPLIANT_BITSTREAM;
+	}
+
@@ -957 +962,6 @@ static GF_Err av1dmx_parse_flush_sample(GF_Filter *filter, GF_AV1DmxCtx *ctx)
-	memcpy(output, ctx->state.frame_obus, pck_size);
+	// Bounds check before memcpy to prevent out-of-bounds read
+	if (ctx->state.frame_obus && output) {
+		memcpy(output, ctx->state.frame_obus, pck_size);
+	} else {
+		return GF_NON_COMPLIANT_BITSTREAM;
+	}
