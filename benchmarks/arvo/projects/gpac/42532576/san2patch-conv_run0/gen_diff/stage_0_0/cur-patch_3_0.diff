+	if (attributes->name) gf_free(attributes->name);
+	char *name_src = ret[i]+5+1;
+	u32 name_len = 0;
+	while (name_src[name_len] && name_src[name_len] != '"') name_len;
+	attributes->name = gf_malloc(name_len + 1);
+	if (attributes->name) {
+		memcpy(attributes->name, name_src, name_len);
+		attributes->name[name_len] = 0;
+	}
+} else if (safe_start_equals("DEFAULT=", ret[i])) {
