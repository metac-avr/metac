+// Fixed CWE-125: Out-of-bounds Read - Validate buffer before strdup
+        if (ret) {
+            // Validate that the extracted attributes buffer is properly bounded
+            // and null-terminated to prevent out-of-bounds reads during strdup
+            u32 idx = 0;
+            while (ret[idx] != NULL) {
+                // Check if the attribute pointer is valid and within bounds
+                if (ret[idx] != NULL) {
+                    // Ensure we don't read past allocated buffer by creating a safe copy
+                    char *safe_copy = gf_malloc(strlen(ret[idx]) + 1);
+                    if (safe_copy) {
+                        strcpy(safe_copy, ret[idx]);
+                        gf_free(ret[idx]);
+                        ret[idx] = safe_copy;
+                    }
+                }
+                idx++;
+            }
+        }
+        return ret;
+    }
+    ret = extract_attributes("#EXT-X-MEDIA:", line, 14);
+    if (ret) {
