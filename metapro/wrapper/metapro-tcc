from sys import argv
from subprocess import run
from os import environ,path
import sys
import re

if 'METAPRO_PATH' in environ and environ['METAPRO_PATH'] != '':
    specific_path=True
    runtime_include_arg = environ['METAPRO_PATH'] + "/include"
    runtime_library_path = environ['METAPRO_PATH'] + "/build"
    environ['LD_LIBRARY_PATH']=runtime_library_path+":"+environ.get('LD_LIBRARY_PATH', '')
    environ['LIBRARY_PATH']=runtime_library_path+":"+environ.get('LIBRARY_PATH', '')
    instrument_pass_path = path.join(environ['METAPRO_PATH'], 'libmetapro-instrument-pass.so')
    keep_static_plugin_path = path.join(environ['METAPRO_PATH'], 'build', 'libmetapro-keep-static.so')
else:
    specific_path=False
    runtime_include_arg = "/usr/local/include/metapro/include"
    instrument_pass_path = "/usr/local/lib/libmetapro-instrument-pass.so"
    keep_static_plugin_path = "/usr/local/lib/libmetapro-keep-static.so"

# A build tree without the plugin built in it still has the installed one
if not path.exists(keep_static_plugin_path):
    keep_static_plugin_path = "/usr/local/lib/libmetapro-keep-static.so"

if 'METAPRO_CC' not in environ:
    cc = 'clang'
else:
    cc = environ['METAPRO_CC']
    
cmd = [cc, f'-I{runtime_include_arg}']
for arg in argv[1:]:
    cmd.append(arg)

# Inject the noop instrumentation pass during any compilation phase.
if 'METAPRO_PASS' in environ and '-E' not in cmd:
    ver_out = run([cc, '--version'], capture_output=True, text=True).stdout
    m = re.search(r'clang version (\d+)', ver_out)
    clang_major = int(m.group(1)) if m else 99
    cmd.append('-g')
    if clang_major <= 12:
        cmd.extend(['-Xclang', '-load', '-Xclang', instrument_pass_path])
        pass_flags = f'-Xclang -load -Xclang {instrument_pass_path}'
    else:
        cmd.append(f'-fpass-plugin={instrument_pass_path}')
        pass_flags = f'-fpass-plugin={instrument_pass_path}'
    environ['CFLAGS'] = environ.get('CFLAGS', '') + ' ' + pass_flags
    environ['CXXFLAGS'] = environ.get('CXXFLAGS', '') + ' ' + pass_flags
    # environ['LDFLAGS'] = environ.get('LDFLAGS', '') + ' ' + pass_flags

# Keep the static functions of the program in the binary: a patch expression may call one, and one that
# its own file never calls is dropped by the compiler, header helpers (`static inline`) included. The
# plugin marks them `used` in the AST, so no source has to be rewritten for it -- see
# src/plugin/keep_static_plugin.cpp. Set METAPRO_KEEP_STATIC=0 to build without it.
compiles_source = any(arg.endswith(('.c', '.cc', '.cpp', '.cxx', '.c++', '.i', '.ii'))
                      for arg in argv[1:])
if (compiles_source and '-E' not in cmd
        and environ.get('METAPRO_KEEP_STATIC', '1') != '0'
        and path.exists(keep_static_plugin_path)):
    cmd.append(f'-fplugin={keep_static_plugin_path}')

if ('-c' not in cmd and # Compile
    '-E' not in cmd and # Preprocess
    '-S' not in cmd and # Assemble
    '-shared' not in cmd and # Shared library
    '-r' not in cmd): # Relocatable object file
    # Link with metapro runtime library when only generating executable
    if specific_path:
        cmd.append(f'-Wl,-rpath,{runtime_library_path}')
        cmd.append(f'-L{runtime_library_path}')
    # -rdynamic puts the program's own functions in .dynsym, so the runtime can resolve a callee of a
    # patch expression with dlsym() instead of the meta-program taking its address at compile time.
    cmd.append('-rdynamic')
    cmd.append('-lmetapro-runtime-c')
    cmd.append('-ltree-sitter')
    cmd.append('-ltree-sitter-cpp')
    cmd.append('-lcurl')
else:
    cmd.append('-Wno-pointer-to-int-cast')

# Append last so they override any -W[error][=...] the project's build system
# placed earlier in the command line.
cmd.append('-Wno-error')
cmd.append('-Wno-error=return-type')
cmd.append('-Wno-ignored-qualifiers')
cmd.append('-Wno-incompatible-pointer-types-discards-qualifiers')
cmd.append('-Wno-strict-prototypes')

if environ.get('METAPRO_DEBUG_CC', '0') == '1':
    # Print the command for debugging
    # Note: printing executed command sometimes break ./configure when using autoconf and libtool. Use when debugging only.
    print(f'Command: {" ".join(cmd)}', file=sys.stderr)
exit(run(cmd).returncode)
